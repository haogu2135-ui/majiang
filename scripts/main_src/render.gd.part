func draw_meld_summary_route_art(parent: Control, total_melds: int, active_seats: Array[int]) -> Control:
	# r210: GPT chrome conversion
	var art = Control.new()
	art.name = "MeldSummaryRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.285, 0.535, 0.715, 0.655))
	parent.add_child(art)
	parent.move_child(art, 0)
	var accent = Color(0.82, 0.66, 0.32)
	var jade = Color(0.42, 0.72, 0.60)
	var fill_fraction = clamp(float(total_melds) / 8.0, 0.16, 1.0)
	var spine = make_gpt_route_rail(rect_full(0.055, 0.430, 0.945, 0.565), Color(0.006, 0.014, 0.016, 0.42))
	spine.name = "MeldSummarySpine"
	art.add_child(spine)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * fill_fraction, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	fill.name = "MeldSummarySpineFill"
	spine.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.030, 0.300, 0.100, 0.700), Color(jade.r, jade.g, jade.b, 0.18))
	source.name = "MeldSummarySource"
	art.add_child(source)
	var gate = make_gpt_gate(rect_full(0.890, 0.270, 0.965, 0.730), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "MeldSummaryGate"
	art.add_child(gate)
	var glyph = make_label(gate, "%d" % min(9, total_melds), 8, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "MeldSummaryGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive = make_gpt_edge_rail(rect_full(0.735, 0.025, 0.845, 0.315), Color(accent.r, accent.g, accent.b, 0.13))
	archive.name = "MeldSummaryArchive"
	art.add_child(archive)
	var archive_glyph = make_label(archive, "副", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	archive_glyph.name = "MeldSummaryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var seat_count = min(4, active_seats.size())
	for i in range(seat_count):
		var seat = active_seats[i]
		var col = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else jade
		var left = 0.185 + float(i) * 0.170
		var branch = make_gpt_plate_rect(rect_full(left, 0.170, left + 0.120, 0.260), Color(0.006, 0.014, 0.016, 0.34), "ui_jade_reading_plate")
		branch.name = "MeldSummarySeatBranch_%d" % seat
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760, 0.750), Color(col.r, col.g, col.b, 0.20))
		branch_fill.name = "MeldSummarySeatBranchFill_%d" % seat
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(left + 0.035, 0.050, left + 0.085, 0.235), Color(col.r, col.g, col.b, 0.22))
		node.name = "MeldSummarySeatNode_%d" % seat
		art.add_child(node)
	for i in range(min(4, max(2, total_melds))):
		var left = 0.245 + float(i) * 0.105
		var tick = make_gpt_tick_strip(rect_full(left, 0.660, left + 0.018, 0.845), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		tick.name = "MeldSummaryTick_0"
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.790 + float(i) * 0.045, 0.760, 0.816 + float(i) * 0.045, 0.905), Color(jade.r, jade.g, jade.b, 0.20 - float(i) * 0.040))
		pip.name = "MeldSummaryArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.38, 0.78).from(0.86)
		tw.tween_property(fill, "modulate:a", 0.86, 0.78).from(0.38)
	return art


func seat_meld_is_vertical(seat: int) -> bool:
	# Left/right seats stack melds vertically; top/bottom seats run horizontally.
	return seat == 1 or seat == 3


func seat_meld_face_rotation(seat: int) -> float:
	# All meld faces point toward table center (same convention as table view).
	# bottom 0°, right -90°, top 180°, left +90°.
	match seat:
		0:
			return 0.0
		1:
			return -PI * 0.5
		2:
			return PI
		3:
			return PI * 0.5
		_:
			return 0.0

func meld_lane_group_footprint(seat: int, meld: Array, compact_melds: bool) -> float:
	var vertical := seat_meld_is_vertical(seat)
	var tile_width := (24.0 if vertical else 22.0) if compact_melds else (28.0 if vertical else 26.0)
	var separation := 2.0 if compact_melds else 3.0
	var padding := 6.0 if compact_melds else 8.0
	var tile_count := maxi(1, meld.size())
	return float(tile_count) * (tile_width + separation) + padding

func meld_lane_capacity_for_list(seat: int, meld_list: Array, compact_melds: bool, meld_rect: Rect2, reserve_pager: bool = false) -> int:
	if meld_list.is_empty():
		return 0
	var vertical := seat_meld_is_vertical(seat)
	var lane_extent := safe_content_pixel_size().y * float(meld_rect.size.y - meld_rect.position.y) if vertical else safe_content_pixel_size().x * float(meld_rect.size.x - meld_rect.position.x)
	var pager_reserve := 56.0 if reserve_pager else 0.0
	var edge_clearance := 6.0 if compact_melds else 8.0
	var usable_extent := maxf(1.0, lane_extent - pager_reserve - edge_clearance)
	var used_extent := 0.0
	var capacity := 0
	var group_gap := 4.0 if compact_melds else 3.0
	for meld in meld_list:
		if typeof(meld) != TYPE_ARRAY:
			continue
		var footprint := meld_lane_group_footprint(seat, meld as Array, compact_melds)
		var next_extent := used_extent + footprint + (group_gap if capacity > 0 else 0.0)
		if capacity > 0 and next_extent > usable_extent:
			break
		used_extent = next_extent
		capacity += 1
	return maxi(1, capacity)

func meld_lane_pager_rect(seat: int, meld_rect: Rect2) -> Rect2:
	var lane_left := meld_rect.position.x
	var lane_top := meld_rect.position.y
	var lane_right := meld_rect.size.x
	var lane_bottom := meld_rect.size.y
	var content_size := safe_content_pixel_size()
	var min_width_ratio := UI_MIN_TOUCH_TARGET / maxf(1.0, content_size.x)
	var min_height_ratio := UI_MIN_TOUCH_TARGET / maxf(1.0, content_size.y)
	if seat_meld_is_vertical(seat):
		var pager_height := maxf(0.095, min_height_ratio + 0.010)
		return rect_full(lane_left, lane_bottom - pager_height, lane_right, lane_bottom - 0.005)
	var pager_width := maxf(0.060, min_width_ratio)
	return rect_full(lane_right - pager_width, lane_top, lane_right - 0.005, lane_bottom)

func cycle_meld_window(seat: int, page_capacity: int) -> void:
	var meld_list := get_melds(seat)
	if page_capacity <= 0 or meld_list.size() <= page_capacity:
		return
	var latest_start := maxi(0, meld_list.size() - page_capacity)
	var current_start := clampi(int(meld_window_start_by_seat.get(seat, 0)), 0, latest_start)
	if current_start >= latest_start:
		meld_window_start_by_seat.erase(seat)
	else:
		meld_window_start_by_seat[seat] = mini(latest_start, current_start + page_capacity)
	request_game_render()

func draw_melds(parent: Control) -> void:
	var proxy_order := 1000
	var compact_melds := effective_viewport_size().y <= 560.0 or (mode == "offline" and has_pending_danger_discard())
	var danger_compact_melds := mode == "offline" and has_pending_danger_discard()
	for layout in MELD_LAYOUTS:
		var seat = int(layout[0])
		var meld_list = get_melds(seat)
		if meld_list.is_empty():
			continue
		var meld_rect: Rect2 = seat_meld_rect(seat)
		var full_capacity := meld_lane_capacity_for_list(seat, meld_list, compact_melds, meld_rect)
		var lane_capacity := full_capacity
		if meld_list.size() > full_capacity:
			lane_capacity = meld_lane_capacity_for_list(seat, meld_list, compact_melds, meld_rect, true)
		var latest_start := maxi(0, meld_list.size() - lane_capacity)
		var window_start := clampi(int(meld_window_start_by_seat.get(seat, 0)), 0, latest_start)
		if window_start >= meld_list.size():
			window_start = 0
			meld_window_start_by_seat.erase(seat)
		var visible_melds: Array = meld_list.slice(window_start, mini(meld_list.size(), window_start + lane_capacity))
		var page_count := maxi(1, int(ceil(float(meld_list.size()) / float(maxi(1, lane_capacity)))))
		# Soft seat lane; melds sit next to the player plaque.
		var lane_art := draw_meld_lane_art(parent, seat, meld_rect, meld_list.size())
		if lane_art != null and compact_melds:
			lane_art.visible = false
		var vertical: bool = seat_meld_is_vertical(seat)
		var area: Container
		if vertical:
			area = VBoxContainer.new()
		else:
			area = HBoxContainer.new()
		area.name = "MeldArea_%d" % seat
		configure_passive_container(area)
		area.z_index = 10  # r453 keep meld faces above any same-pixel river fallback
		area.add_theme_constant_override("separation", 3)
		area.set_meta("seat", seat)
		area.set_meta("orientation", "vertical" if vertical else "horizontal")
		area.set_meta("face_rotation", seat_meld_face_rotation(seat))
		area.set_meta("layout_role", "meld_lane")
		if area is BoxContainer:
			(area as BoxContainer).alignment = BoxContainer.ALIGNMENT_BEGIN
		apply_rect(area, meld_rect)
		parent.add_child(area)
		area.set_meta("group_count", meld_list.size())
		area.set_meta("visible_group_count", visible_melds.size())
		area.set_meta("window_start", window_start)
		area.set_meta("window_end", window_start + visible_melds.size())
		area.set_meta("lane_capacity", lane_capacity)
		area.set_meta("lane_edge_clearance_px", 6.0 if compact_melds else 8.0)
		area.set_meta("lane_group_gap_px", 4.0 if compact_melds else 3.0)
		area.set_meta("page_count", page_count)
		area.set_meta("layout_capacity_ok", visible_melds.size() <= lane_capacity)
		area.set_meta("compact_readability_policy", "paginate_before_below_24px")
		mark_ui_optimization(area, "F-043")
		var meld_tile_size := Vector2.ZERO
		if vertical and compact_melds:
			# Spend the side lane height across one vertical group per row. This keeps
			# every chi/peng/gang in the seat-facing lane instead of creating a second
			# column that can drift into the river.
			var lane_height_px := safe_content_pixel_size().y * float(meld_rect.size.y - meld_rect.position.y)
			var lane_width_px := safe_content_pixel_size().x * float(meld_rect.size.x - meld_rect.position.x)
			var group_rows := maxi(1, visible_melds.size())
			var row_gap_px := float(maxi(0, group_rows - 1)) * 3.0
			var group_height_px := maxf(32.0, (lane_height_px - row_gap_px) / float(group_rows))
			# Size each group from the largest tile count in the lane. A four-tile
			# kong must fit without pushing later groups into the adjacent river.
			var compact_tile_width := floorf((group_height_px - 2.0) / 3.0 - 1.0)
			for vertical_meld in visible_melds:
				if typeof(vertical_meld) == TYPE_ARRAY:
					var vertical_tile_count := maxi(1, (vertical_meld as Array).size())
					var group_tile_width := floorf((group_height_px - 2.0) / float(vertical_tile_count) - 1.0)
					compact_tile_width = minf(compact_tile_width, group_tile_width)
			# Bound the face width by the single lane itself so Container minimum
			# sizes cannot push into the adjacent HUD or river at 960px.
			var max_compact_tile_width := floorf((lane_width_px - 12.0) / HAND_TILE_ASPECT)
			max_compact_tile_width = maxf(24.0, max_compact_tile_width)
			var compact_min_tile_width := 24.0 if danger_compact_melds else 26.0
			var compact_max_tile_width := 30.0 if danger_compact_melds else 32.0
			compact_tile_width = clampf(minf(compact_tile_width, max_compact_tile_width), compact_min_tile_width, compact_max_tile_width)
			meld_tile_size = Vector2(compact_tile_width, maxf(28.0, floorf(compact_tile_width * HAND_TILE_ASPECT)))
			area.set_meta("compact_readability_width", compact_tile_width)
		elif not vertical and compact_melds:
			# Keep horizontal melds readable on 960px screens. Use the actual lane
			# width to spend space on tile faces before falling back to a smaller
			# group; the lane direction remains fixed per seat.
			var horizontal_tile_count := 0
			var horizontal_group_count := 0
			for horizontal_meld in visible_melds:
				if typeof(horizontal_meld) == TYPE_ARRAY:
					horizontal_tile_count += (horizontal_meld as Array).size()
					horizontal_group_count += 1
			if horizontal_tile_count > 0:
				var lane_width_fraction := float(meld_rect.size.x - meld_rect.position.x)
				var lane_width_px := safe_content_pixel_size().x * lane_width_fraction
				var lane_height_px := safe_content_pixel_size().y * float(meld_rect.size.y - meld_rect.position.y)
				var group_padding_px := float(horizontal_group_count) * 6.0
				var group_gap_px := float(maxi(0, horizontal_group_count - 1)) * 3.0
				# make_meld_group_view reserves one compact separator per tile. Try
				# the wider two-pixel rhythm first, then switch to one pixel when
				# several four-tile groups share the same lane.
				var compact_tile_width := floorf((lane_width_px - group_padding_px - group_gap_px - float(horizontal_tile_count) * 2.0) / float(horizontal_tile_count))
				if compact_tile_width <= 18.0:
					compact_tile_width = floorf((lane_width_px - group_padding_px - group_gap_px - float(horizontal_tile_count)) / float(horizontal_tile_count))
				# Horizontal faces keep their upright 1.5 aspect ratio after the
				# top-seat rotation. Bound width by lane height as well as lane width,
				# otherwise a short 960px lane can produce a 100px-wide face.
				var max_horizontal_tile_width := floorf(maxf(18.0, (lane_height_px - 10.0) / 1.5))
				var horizontal_min_tile_width := 20.0 if danger_compact_melds else 24.0
				var horizontal_max_tile_width := 28.0 if danger_compact_melds else 30.0
				compact_tile_width = clampf(minf(compact_tile_width, max_horizontal_tile_width), horizontal_min_tile_width, horizontal_max_tile_width)
				meld_tile_size = Vector2(compact_tile_width, maxf(28.0, floorf(compact_tile_width * 1.5)))
		elif not vertical and meld_list.size() >= 4:
			meld_tile_size = Vector2(20, 28)
		area.set_meta("tile_size", meld_tile_size if meld_tile_size != Vector2.ZERO else Vector2(26, 36) if not vertical else Vector2(28, 38))
		for meld_index in range(visible_melds.size()):
			var meld = visible_melds[meld_index]
			if typeof(meld) == TYPE_ARRAY:
				var meld_tiles := meld as Array
				# Chi/peng/gang share one lane orientation per seat — no kind-specific layout.
				var meld_group := make_meld_group_view(meld_tiles, seat, false, proxy_order, meld_tile_size)
				meld_group.name = "MeldGroup_%d_%s" % [window_start + meld_index, meld_kind_label(meld_tiles)]
				meld_group.set_meta("seat", seat)
				meld_group.set_meta("orientation", "vertical" if vertical else "horizontal")
				meld_group.set_meta("tile_count", meld_tiles.size())
				meld_group.set_meta("face_rotation", seat_meld_face_rotation(seat))
				var meld_kind := meld_kind_label(meld_tiles)
				set_ui_full_text(meld_group, "%s · 第%d组 · %d张牌" % [meld_kind, window_start + meld_index + 1, meld_tiles.size()], "副露类型：" + meld_kind)
				var meld_kind_badge_back := add_optional_gpt_illustration_texture(meld_group, "ui_hand_tray_state_chip", rect_full(0.570, 0.030, 0.955, 0.320), 0.58, false)
				if meld_kind_badge_back != null:
					meld_kind_badge_back.name = "MeldKindBadgeBack_%d_%s" % [window_start + meld_index, meld_kind]
					meld_kind_badge_back.mouse_filter = Control.MOUSE_FILTER_IGNORE
				var meld_kind_badge := make_label(meld_group, meld_kind, 11, Color(1.0, 0.94, 0.68, 1.0), true)
				meld_kind_badge.name = "MeldKindBadge_%d_%s" % [window_start + meld_index, meld_kind]
				# Keep the type token inside the group after the face rotation. A
				# small inward gutter prevents it from touching the neighboring tile.
				var badge_font_size := accessibility_font_size(10)
				var badge_budget_px := meld_tile_size.x if meld_tile_size.x > 0.0 else (24.0 if compact_melds else 30.0)
				var badge_char_width := float(badge_font_size) * 1.15
				var badge_text := meld_kind
				# A badge is metadata, not a second tile surface. Measure it against
				# the current face width and use a short token before it can cover a
				# four-tile kong or a neighboring group.
				if badge_text.length() * badge_char_width > maxf(18.0, badge_budget_px * 0.90):
					badge_text = meld_kind.left(1)
					meld_kind_badge.text = badge_text
					meld_kind_badge.tooltip_text = "副露类型：" + meld_kind
					meld_kind_badge.set_meta("badge_full_text", meld_kind)
					meld_kind_badge.set_meta("badge_shortened", true)
				var badge_rect := rect_full(0.080, 0.700, 0.920, 0.940) if vertical else rect_full(0.600, 0.060, 0.940, 0.300)
				apply_rect(meld_kind_badge, badge_rect)
				meld_kind_badge.add_theme_font_size_override("font_size", badge_font_size)
				meld_kind_badge.set_meta("badge_measured_face_width", badge_budget_px)
				meld_kind_badge.set_meta("badge_lane_policy", "face_width_measured_short_token")
				meld_kind_badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER if vertical else HORIZONTAL_ALIGNMENT_RIGHT
				meld_kind_badge.vertical_alignment = VERTICAL_ALIGNMENT_CENTER if vertical else VERTICAL_ALIGNMENT_TOP
				meld_kind_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
				meld_kind_badge.set_meta("meld_kind", meld_kind)
				meld_kind_badge.set_meta("accessible_name", "副露类型：" + meld_kind)
				meld_kind_badge.set_meta("badge_orientation_policy", "seat_facing_inner_gutter")
				mark_ui_optimization(meld_kind_badge, "F-424")
				mark_ui_optimization(meld_kind_badge, "F-042")
				meld_kind_badge.add_theme_color_override("font_outline_color", Color(0.02, 0.04, 0.03, 0.96))
				meld_kind_badge.add_theme_constant_override("outline_size", 4)
				if vertical and compact_melds:
					# The authored 2D faces remain at their minimum touch size, while
					# the lane container owns the four-row height budget.
					meld_group.size_flags_vertical = Control.SIZE_EXPAND_FILL
					meld_group.custom_minimum_size.y = 30.0
				area.add_child(meld_group)
				proxy_order += meld_tiles.size() + 1
		if page_count > 1:
			var page_button := make_action_button("%d/%d" % [int(window_start / maxi(1, lane_capacity)) + 1, page_count], Color(0.54, 0.58, 0.42), Callable(self, "cycle_meld_window").bind(seat, lane_capacity))
			page_button.name = "MeldLaneArchiveButton_%d" % seat
			page_button.custom_minimum_size = Vector2(50, UI_MIN_TOUCH_TARGET)
			page_button.add_theme_font_size_override("font_size", 11)
			page_button.tooltip_text = "副露第%d/%d页 · 显示第%d-%d组 · 点击查看下一页" % [int(window_start / maxi(1, lane_capacity)) + 1, page_count, window_start + 1, window_start + visible_melds.size()]
			set_ui_full_text(page_button, page_button.tooltip_text, "座位%d副露翻页" % seat)
			mark_ui_optimization(page_button, "F-481")
			page_button.set_meta("seat", seat)
			page_button.set_meta("window_start", window_start)
			page_button.set_meta("page_count", page_count)
			page_button.set_meta("lane_capacity", lane_capacity)
			page_button.set_meta("ui_min_touch_target", UI_MIN_TOUCH_TARGET)
			page_button.set_meta("touch_height_contract", "at_least_UI_MIN_TOUCH_TARGET")
			page_button.set_meta("applied_rect_min_height_px", UI_MIN_TOUCH_TARGET)
			page_button.set_meta("pager_rect_policy", "apply_rect_preserves_min_touch_height")
			page_button.set_meta("focus_hint", "Enter翻到下一页副露；Esc返回手牌")
			page_button.set_meta("action_role", "meld_page_next")
			mark_ui_optimization(page_button, "F-260")
			mark_ui_optimization(page_button, "F-247")
			page_button.z_index = 14
			parent.add_child(page_button)
			apply_rect(page_button, meld_lane_pager_rect(seat, meld_rect))

func make_soft_depth_panel(parent: Control, rect: Rect2, color: Color, radius: int, shadow_size: int = 0) -> Control:
	# Depth accents are authored bitmap plates. Keep this helper free of Panel and
	# StyleBox instances so shadows never become program-painted UI surfaces.
	var plate := make_gpt_plate_rect(rect, color)
	plate.set_meta("depth_radius_hint", radius)
	plate.set_meta("depth_shadow_hint", shadow_size)
	plate.set_meta("visual_asset_contract", "authored_gpt_plate_only")
	mark_ui_optimization(plate, "F-222")
	if parent != null and is_instance_valid(parent):
		parent.add_child(plate)
	return plate


func draw_menu_card_entry_art(button: Control, color: Color, icon_name: String = "") -> Control:
	# r213: GPT chrome conversion
	var has_menu_stage_overlay := optional_gpt_illustration_texture("menu_primary_3d_stage_overlay") != null
	var art = Control.new()
	art.name = "MenuCardEntryArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.modulate = Color(1, 1, 1, 0.96)
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var card_shadow_alpha := 0.10 if has_menu_stage_overlay else 0.18
	var card_depth_alpha := 0.22 if has_menu_stage_overlay else 0.32
	var card_sheen_alpha := 0.16 if has_menu_stage_overlay else 0.22
	var cast_shadow = make_soft_depth_panel(art, rect_full(0.020, 0.100, 0.990, 1.035), Color(0.0, 0.0, 0.0, card_shadow_alpha), 18)
	cast_shadow.name = "MenuCardCastShadow"
	art.move_child(cast_shadow, 0)
	var depth_edge = make_soft_depth_panel(art, rect_full(0.050, 0.825, 0.950, 0.985), Color(0.22, 0.14, 0.06, card_depth_alpha), 14)
	depth_edge.name = "MenuCardDepthEdge"
	# Menu cards share the same quiet reading material as rules/settings. The
	# authored dark-scrim center crop keeps the scene recognizable while removing
	# the repeated high-frequency jade plate behind every line of copy.
	var card_face = make_gpt_center_crop_plate_rect(rect_full(0.030, 0.045, 0.970, 0.955), Color(0.012, 0.024, 0.022, 0.82), "ui_dark_scrim", 0.22)
	card_face.name = "MenuCardGptFace"
	art.add_child(card_face)
	var surface = make_layout_host(rect_full(0.030, 0.045, 0.970, 0.955))
	surface.name = "MenuCardSurface"
	art.add_child(surface)
	var top_sheen = make_soft_depth_panel(art, rect_full(0.055, 0.060, 0.945, 0.185), Color(1.0, 0.92, 0.62, card_sheen_alpha), 12)
	top_sheen.name = "MenuCardTopSheen"
	var inner = make_layout_host(rect_full(0.060, 0.090, 0.940, 0.910))
	inner.name = "MenuCardInner"
	art.add_child(inner)
	var accent = make_gpt_route_rail(rect_full(0.075, 0.740, 0.925, 0.870), Color(color.r, color.g, color.b, 0.10))
	accent.name = "MenuCardAccent"
	art.add_child(accent)
	var icon_echo_left = 0.695 if icon_name != "" else 0.765
	var echo = make_layout_host(rect_full(icon_echo_left, 0.135, icon_echo_left + 0.220, 0.455))
	echo.name = "MenuCardIconEcho"
	art.add_child(echo)
	var focus = make_gpt_gate(rect_full(0.805, 0.720, 0.910, 0.925), Color(color.r, color.g, color.b, 0.13))
	focus.name = "MenuCardEntryFocus"
	art.add_child(focus)
	var arrow_icon = add_lucide_icon(focus, "chevron-right", rect_full(0.250, 0.250, 0.750, 0.750), Color(0.96, 0.90, 0.66, 0.86))
	if arrow_icon != null:
		arrow_icon.name = "MenuCardEntryArrow"
	else:
		var arrow = make_label(focus, ">", 11, Color(0.96, 0.90, 0.66, 0.86), true)
		arrow.name = "MenuCardEntryArrow"
		apply_rect(arrow, rect_full(0.0, 0.0, 1.0, 1.0))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(accent, "modulate:a", 0.46, 1.10).from(0.82)
		tw.tween_property(accent, "modulate:a", 0.82, 1.10).from(0.46)
		var focus_tw := create_screen_tween()
		focus_tw.set_loops(48)
		focus_tw.tween_property(focus, "modulate:a", 0.58, 0.82).from(1.0)
		focus_tw.tween_property(focus, "modulate:a", 1.0, 0.82).from(0.58)
	return art


func draw_menu_primary_3d_stage(parent: Control) -> Control:
	var has_stage_overlay := optional_gpt_illustration_texture("menu_primary_3d_stage_overlay") != null
	var stage_overlay = add_optional_gpt_illustration_texture(parent, "menu_primary_3d_stage_overlay", rect_full(0.0, 0.0, 1.0, 1.0), 0.28, false)
	if stage_overlay != null:
		stage_overlay.name = "MenuPrimary3DStageGPTOverlay"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			stage_overlay.modulate.a = 0.0
			var overlay_tw := create_screen_tween()
			overlay_tw.tween_property(stage_overlay, "modulate:a", 0.28, 0.36).from(0.0).set_delay(0.02).set_ease(Tween.EASE_OUT)
	var stage = Control.new()
	stage.name = "MenuPrimary3DStage"
	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(stage, rect_full(0.095, 0.300, 0.905, 0.795))
	parent.add_child(stage)
	var fallback_alpha := 0.16 if has_stage_overlay else 1.0
	stage.modulate.a = fallback_alpha
	var floor_shadow = make_soft_depth_panel(stage, rect_full(0.040, 0.200, 0.960, 0.940), Color(0.0, 0.0, 0.0, 0.14), 34)
	floor_shadow.name = "MenuPrimary3DFloorShadow"
	var back_rim = make_soft_depth_panel(stage, rect_full(0.165, 0.095, 0.835, 0.205), Color(0.96, 0.82, 0.48, 0.22), 999)
	back_rim.name = "MenuPrimary3DBackRim"
	var table_lip = make_soft_depth_panel(stage, rect_full(0.035, 0.660, 0.965, 0.930), Color(0.18, 0.115, 0.055, 0.34), 22)
	table_lip.name = "MenuPrimary3DTableLip"
	var table_highlight = make_soft_depth_panel(stage, rect_full(0.085, 0.615, 0.915, 0.725), Color(1.0, 0.90, 0.54, 0.18), 999)
	table_highlight.name = "MenuPrimary3DTableHighlight"
	for i in range(3):
		var left = 0.095 + float(i) * 0.325
		var shadow = make_soft_depth_panel(stage, rect_full(left, 0.250, left + 0.255, 0.790), Color(0.0, 0.0, 0.0, 0.08), 22)
		shadow.name = "MenuPrimary3DCardShadow_%d" % i
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		stage.modulate.a = 0.0
		stage.offset_top = 10.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(stage, "modulate:a", fallback_alpha, 0.34).from(0.0).set_delay(0.04).set_ease(Tween.EASE_OUT)
		tw.tween_property(stage, "offset_top", 0.0, 0.34).from(10.0).set_delay(0.04).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		if not has_stage_overlay:
			var breath := create_screen_tween()
			breath.set_loops(48)
			breath.tween_property(table_highlight, "modulate:a", 0.58, 1.6).from(0.86).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			breath.tween_property(table_highlight, "modulate:a", 0.86, 1.6).from(0.58).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	return stage

