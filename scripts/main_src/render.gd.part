		settings_scroll.resized.connect(func() -> void:
			sync_settings_large_text_scroll_status(settings_scroll, settings_large_text_status)
		)
		settings_content.resized.connect(func() -> void:
			sync_settings_large_text_scroll_status(settings_scroll, settings_large_text_status)
