	for i in range(3):
		var pip = make_gpt_gate(rect_full(0.720 + float(i) * 0.045, 0.090, 0.742 + float(i) * 0.045, 0.205), Color(0.78, 0.62, 0.36, 0.08 - float(i) * 0.016))
		pip.name = "LoadingProgressReadyPip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective():
		fill.modulate = Color(1, 1, 1, 0.86)
		var tw := art.create_tween()
		tw.set_loops(8)
		tw.tween_property(fill, "anchor_right", 0.980, 1.15).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.46, 0.56).from(0.94)
		tw.tween_property(fill, "anchor_right", clampf(progress_ratio, 0.08, 0.98), 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.94, 0.56).from(0.46)
	return art


func draw_loading_shuffle_art(parent: Control) -> Control:
	# r211: GPT chrome conversion
	var art = make_gpt_route_rail(rect_full(0.160, 0.485, 0.840, 0.605), Color(0.010, 0.022, 0.026, 0.66))
	art.name = "LoadingShuffleArt"
	parent.add_child(art)
	var rail = make_gpt_route_rail(rect_full(0.095, 0.730, 0.905, 0.840), Color(0.006, 0.016, 0.018, 0.50))
	rail.name = "LoadingShuffleRail"
	art.add_child(rail)
	var progress = make_gpt_plate_rect(rect_full(0.030, 0.260, 0.780, 0.740), Color(0.78, 0.62, 0.36, 0.32), "ui_button_face_plate")
	progress.name = "LoadingShuffleProgress"
	rail.add_child(progress)
	var glow = make_gpt_gate(rect_full(0.415, 0.040, 0.585, 0.960), Color(0.96, 0.78, 0.34, 0.08))
	glow.name = "LoadingShuffleGlow"
	art.add_child(glow)
	var seal = make_gpt_gate(rect_full(0.455, 0.155, 0.545, 0.845), Color(0.64, 0.48, 0.24, 0.34))
	seal.name = "LoadingShuffleSeal"
	art.add_child(seal)
	var seal_label = make_label(seal, "云", 13, Color(0.96, 0.86, 0.58), true)
	apply_rect(seal_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var sync_route = make_gpt_route_rail(rect_full(0.205, 0.475, 0.795, 0.555), Color(0.006, 0.016, 0.018, 0.44))
	sync_route.name = "LoadingShuffleSyncRoute"
	art.add_child(sync_route)
	var sync_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.860, 0.740), Color(0.78, 0.62, 0.36, 0.30))
	sync_fill.name = "LoadingShuffleSyncFill"
	sync_route.add_child(sync_fill)
	var sync_gate = make_gpt_gate(rect_full(0.770, 0.370, 0.830, 0.660), Color(0.92, 0.72, 0.34, 0.22))
	sync_gate.name = "LoadingShuffleSyncGate"
	art.add_child(sync_gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.350, 0.385, (0.368) + float(2) * (0.100), 0.645), Color(0.78, 0.62, 0.36, 0.24), "LoadingShuffleSyncTick_0")
	# Show authored 2D tile faces instead of five identical backs. At compact
	# resolutions the backs read like missing-glyph boxes rather than a shuffle.
	var loading_tiles := ["E", "S", "N", "R", "Z"]
	for i in range(loading_tiles.size()):
		var left = 0.145 + float(i) * 0.175
		var tile = make_tile_view(str(loading_tiles[i]), Vector2(24, 34), false, Callable())
		tile.name = "LoadingShuffleTile_%d" % i
		art.add_child(tile)
		apply_rect(tile, rect_full(left, 0.170 + float(i % 2) * 0.080, left + 0.070, 0.740 + float(i % 2) * 0.080))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		# 印章旋转出现
		var seal_tw := art.create_tween()
		seal_tw.tween_property(seal, "scale", Vector2(1.0, 1.0), 0.6).from(Vector2(0.3, 0.3)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		seal_tw.parallel().tween_property(seal, "modulate:a", 1.0, 0.5).from(0.0)
		# 牌面依次翻转级联动画 - 模拟洗牌
		for i in range(5):
			var tile_node = art.get_node_or_null("LoadingShuffleTile_%d" % i)
			if tile_node != null:
				var delay := float(i) * 0.12
				# 翻转循环
				var flip_tw := art.create_tween()
				flip_tw.set_loops(6)
				flip_tw.tween_property(tile_node, "scale:x", 0.0, 0.2).from(1.0).set_delay(delay + 1.2 + float(i) * 0.4)
				flip_tw.tween_property(tile_node, "scale:x", 1.0, 0.2).from(0.0)
	return art


