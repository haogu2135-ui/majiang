func draw_diagnostic_result_sync_art(parent: Control, lines: Array) -> Control:
	# r210: GPT chrome conversion
	var art = Control.new()
	art.name = "DiagnosticResultSyncArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.050, 0.895, 0.950, 0.982))
	parent.add_child(art)
	var ok_count := 0
	var error_count := 0
	var hint_count := 0
	for line in lines:
		var text = str(line)
		if text.begins_with("✓"):
			ok_count += 1
		elif text.begins_with("✗"):
			error_count += 1
		elif text.begins_with("•") or text.find("→") >= 0:
			hint_count += 1
	var total = max(1, ok_count + error_count + hint_count)
	var health = clamp(float(ok_count) / float(total), 0.0, 1.0)
	var accent = Color(0.42, 0.82, 0.56) if error_count == 0 else Color(0.86, 0.46, 0.34)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.235, 0.065, 0.780), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "DiagnosticResultSyncSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.065, 0.440, 0.910, 0.545), Color(0.006, 0.016, 0.018, 0.46))
	route.name = "DiagnosticResultSyncRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.900 * max(0.08, health), 0.750), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "DiagnosticResultSyncFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.885, 0.185, 0.945, 0.815), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "DiagnosticResultSyncGate"
	art.add_child(gate)
	var archive = make_gpt_edge_rail(rect_full(0.730, 0.045, 0.830, 0.380), Color(accent.r, accent.g, accent.b, 0.12))
	archive.name = "DiagnosticResultArchive"
	art.add_child(archive)
	var glyph = make_label(archive, "诊", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "DiagnosticResultGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var dismiss_bridge = make_gpt_route_rail(rect_full(0.630, 0.690, 0.910, 0.820), Color(0.006, 0.016, 0.018, 0.40))
	dismiss_bridge.name = "DiagnosticResultDismissBridge"
	art.add_child(dismiss_bridge)
	var dismiss_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(0.78, 0.70, 0.46, 0.22))
	dismiss_fill.name = "DiagnosticResultDismissFill"
	dismiss_bridge.add_child(dismiss_fill)
	var values = [ok_count, error_count, hint_count]
	for i in range(3):
		var left = 0.155 + float(i) * 0.235
		var active = int(values[i]) > 0
		var node = make_gpt_gate(rect_full(left, 0.210, left + 0.032, 0.800), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.08))
		node.name = "DiagnosticResultSyncNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.270, 0.125, (0.270) + float(3) * (0.095) + (0.014), 0.890), Color(accent.r, accent.g, accent.b, 0.23), "DiagnosticResultSyncTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.86
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "anchor_right", 0.980, 0.78).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.39).from(0.92)
		tw.tween_property(fill, "anchor_right", 0.025 + 0.900 * max(0.08, health), 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.39).from(0.48)
	return art


