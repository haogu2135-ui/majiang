	return art

func draw_diagnostic_result_sync_art(parent: Control, lines: Array) -> Control:
	# r210: GPT chrome conversion
	var art = Control.new()
	art.name = "DiagnosticResultSyncArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.050, 0.895, 0.950, 0.982))
	parent.add_child(art)
	var ok_count := 0
	var error_count := 0
	var hint_count := 0
	for line in lines:
		var text = str(line)
		if text.begins_with("✓"):
			ok_count += 1
		elif text.begins_with("✗"):
			error_count += 1
		elif text.begins_with("•") or text.find("→") >= 0:
			hint_count += 1
	var total = max(1, ok_count + error_count + hint_count)
	var health = clamp(float(ok_count) / float(total), 0.0, 1.0)
	var accent = Color(0.42, 0.82, 0.56) if error_count == 0 else Color(0.86, 0.46, 0.34)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.235, 0.065, 0.780), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "DiagnosticResultSyncSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.065, 0.440, 0.910, 0.545), Color(0.006, 0.016, 0.018, 0.46))
	route.name = "DiagnosticResultSyncRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.900 * max(0.08, health), 0.750), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "DiagnosticResultSyncFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.885, 0.185, 0.945, 0.815), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "DiagnosticResultSyncGate"
	art.add_child(gate)
	var archive = make_gpt_edge_rail(rect_full(0.730, 0.045, 0.830, 0.380), Color(accent.r, accent.g, accent.b, 0.12))
	archive.name = "DiagnosticResultArchive"
	art.add_child(archive)
	var glyph = make_label(archive, "诊", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "DiagnosticResultGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var dismiss_bridge = make_gpt_route_rail(rect_full(0.630, 0.690, 0.910, 0.820), Color(0.006, 0.016, 0.018, 0.40))
	dismiss_bridge.name = "DiagnosticResultDismissBridge"
	art.add_child(dismiss_bridge)
	var dismiss_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(0.78, 0.70, 0.46, 0.22))
	dismiss_fill.name = "DiagnosticResultDismissFill"
	dismiss_bridge.add_child(dismiss_fill)
	var values = [ok_count, error_count, hint_count]
	for i in range(3):
		var left = 0.155 + float(i) * 0.235
		var active = int(values[i]) > 0
		var node = make_gpt_gate(rect_full(left, 0.210, left + 0.032, 0.800), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.08))
		node.name = "DiagnosticResultSyncNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.270, 0.125, (0.270) + float(3) * (0.095) + (0.014), 0.890), Color(accent.r, accent.g, accent.b, 0.23), "DiagnosticResultSyncTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.86
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "anchor_right", 0.980, 0.78).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.39).from(0.92)
		tw.tween_property(fill, "anchor_right", 0.025 + 0.900 * max(0.08, health), 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.39).from(0.48)
	return art


func draw_dice_dot(parent: Control, x: float, y: float) -> void:
	# r214: bulk GPT chrome sweep
	var _gpt_panel_host = make_gpt_plate_rect(rect_full(x - CENTER_DICE_DOT_RADIUS, y - CENTER_DICE_DOT_RADIUS, x + CENTER_DICE_DOT_RADIUS, y + CENTER_DICE_DOT_RADIUS), CENTER_DICE_DOT_FILL, "ui_jade_reading_plate")
	_gpt_panel_host.name = "GptPanelHost"
	parent.add_child(_gpt_panel_host)


func draw_discard_river_archive_art(parent: Control, seat: int, accent: Color, discard_count: int, visible_start: int, visible_count: int) -> Control:
	# r211: GPT chrome conversion
	var archive = Control.new()
	archive.name = "DiscardRiverArchiveArt_%d" % seat
	archive.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(archive, rect_full(0.350, 0.745, 0.965, 0.995))
	parent.add_child(archive)
	var count_ratio = clamp(float(discard_count) / 18.0, 0.08, 1.0)
	var visible_ratio = clamp(float(max(1, visible_start + visible_count)) / float(max(1, discard_count)), 0.08, 1.0)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.210, 0.085, 0.750), Color(accent.r, accent.g, accent.b, 0.14 + count_ratio * 0.08))
	source.name = "DiscardRiverArchiveSource_%d" % seat
	archive.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.080, 0.430, 0.875, 0.575), Color(0.006, 0.016, 0.018, 0.38))
	route.name = "DiscardRiverArchiveRoute_%d" % seat
	archive.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.030 + 0.880 * visible_ratio, 0.750), Color(accent.r, accent.g, accent.b, 0.20))
	fill.name = "DiscardRiverArchiveFill_%d" % seat
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.820, 0.275, 0.910, 0.800), Color(accent.r, accent.g, accent.b, 0.12 + count_ratio * 0.07))
	gate.name = "DiscardRiverArchiveGate_%d" % seat
	archive.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.655, 0.020, 0.790, 0.350), Color(0.86, 0.70, 0.38, 0.12 + count_ratio * 0.07))
	seal.name = "DiscardRiverArchiveSeal_%d" % seat
	archive.add_child(seal)
	var glyph = make_label(seal, "河", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "DiscardRiverArchiveGlyph_%d" % seat
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var window_route = make_gpt_route_rail(rect_full(0.240, 0.710, 0.780, 0.855), Color(0.006, 0.016, 0.018, 0.30))
	window_route.name = "DiscardRiverArchiveWindowRoute_%d" % seat
	archive.add_child(window_route)
	var window_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.035 + 0.740 * count_ratio, 0.750), Color(0.86, 0.70, 0.38, 0.16))
	window_fill.name = "DiscardRiverArchiveWindowFill_%d" % seat
	window_route.add_child(window_fill)
	var window_gate = make_gpt_gate(rect_full(0.755, 0.635, 0.835, 0.910), Color(accent.r, accent.g, accent.b, 0.11 + visible_ratio * 0.05))
	window_gate.name = "DiscardRiverArchiveWindowGate_%d" % seat
	archive.add_child(window_gate)
	var tick = add_gpt_tick_strip(archive, rect_full(0.250, 0.175, (0.250) + float(2) * (0.145) + (0.020), 0.650), Color(accent.r, accent.g, accent.b, 0.18), "DiscardRiverArchiveTick_%d_0" % [seat])
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.34, 0.72).from(0.86)
		tw.parallel().tween_property(window_fill, "modulate:a", 0.30, 0.72).from(0.80)
		tw.parallel().tween_property(seal, "modulate:a", 0.56, 0.72).from(0.88)
		tw.tween_property(fill, "modulate:a", 0.86, 0.72).from(0.34)
		tw.parallel().tween_property(window_fill, "modulate:a", 0.80, 0.72).from(0.30)
		tw.parallel().tween_property(seal, "modulate:a", 0.88, 0.72).from(0.56)
	return archive


func discard_river_owner_text(seat: int) -> String:
	if seat == 0:
		return "你的牌河"
	return "%s家牌河" % seat_wind_label(seat)

func discard_river_owner_badge_rect(seat: int) -> Rect2:
	match seat:
		0:
			return rect_full(0.720, 0.805, 0.975, 0.965)
		2:
			return rect_full(0.720, 0.035, 0.975, 0.195)
		1:
			return rect_full(0.080, 0.035, 0.920, 0.225)
		3:
			return rect_full(0.080, 0.035, 0.920, 0.225)
	return rect_full(0.720, 0.805, 0.975, 0.965)

func discard_archive_button_rect(seat: int, zone_rect: Rect2 = Rect2(), columns: int = 0, rows: int = 0, reserved_start: int = -1) -> Rect2:
	if columns > 0 and rows > 0 and reserved_start >= 0 and zone_rect.size.x > zone_rect.position.x and zone_rect.size.y > zone_rect.position.y:
		var reserved_column := reserved_start % columns
		var reserved_row := reserved_start / columns
		var reserved_slots := mini(2, columns - reserved_column)
		# The button is a child of the zone overlay. Return coordinates local to
		# that overlay so the reserved cells, rather than the whole table, own the
		# hit target.
		return rect_full(
			float(reserved_column) / float(columns),
			float(reserved_row) / float(rows),
			float(reserved_column + maxi(1, reserved_slots)) / float(columns),
			float(reserved_row + 1) / float(rows)
		)
	if seat == 1 or seat == 3:
		return rect_full(0.500, 0.500, 0.990, 0.990)
	return rect_full(0.745, 0.500, 0.995, 0.995)

func discard_archive_button_text(discard_count: int, visible_start: int, visible_capacity: int) -> String:
	var latest_start := tail_window_start(discard_count, visible_capacity)
	var window_end := mini(discard_count, visible_start + visible_capacity)
	if visible_start >= latest_start:
		return "查看更早 · %d-%d/%d" % [visible_start + 1, window_end, discard_count]
	if visible_start <= 0:
		return "回到最新 · %d-%d/%d" % [visible_start + 1, window_end, discard_count]
	return "继续查看更早 · %d-%d/%d" % [visible_start + 1, window_end, discard_count]

func cycle_discard_archive_window(seat: int, visible_capacity: int) -> void:
	var discards := get_discards(seat)
	var latest_start := tail_window_start(discards.size(), visible_capacity)
	if latest_start <= 0:
		discard_window_start_by_seat.erase(seat)
		return
	var has_archived_window := discard_window_start_by_seat.has(seat)
	var current_start := clampi(int(discard_window_start_by_seat.get(seat, latest_start)), 0, latest_start)
	# Browse older pages one page at a time. Once the first page is visible, the
	# same control returns to the live tail; the owner overlay exposes the
	# off-page latest state while an old page is open.
	if not has_archived_window:
		discard_window_start_by_seat[seat] = maxi(0, current_start - visible_capacity)
	elif current_start <= 0:
		discard_window_start_by_seat.erase(seat)
	else:
		discard_window_start_by_seat[seat] = maxi(0, current_start - visible_capacity)
	request_game_render()

func draw_discard_river_owner_overlay(parent: Control, seat: int, zone_rect: Rect2, discard_count: int, visible_start: int, visible_count: int, visible_capacity: int, columns: int = 0, rows: int = 0, reserved_start: int = -1) -> Control:
	if discard_count <= 0:
		return null
	var overlay = Control.new()
	overlay.name = "DiscardRiverOwnerOverlay_%d" % seat
	# Ownership chrome is visual-only. Archive navigation is the explicit child
	# target, so the transparent parent must never win tile hit testing.
	overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(overlay, zone_rect)
	parent.add_child(overlay)
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var is_last = seat == get_last_discard_seat() and discard_count > 0
	var fill_alpha = 0.48 if is_last else 0.34
	var border_alpha = 0.28 if is_last else 0.12
	var window_end := visible_start + visible_count
	# Keep the current window and total visible in the owner badge itself. The
	# archive control is still needed for navigation, but the tail window is no
	# longer an implicit loss of history when its button is not focused.
	var latest_start := tail_window_start(discard_count, visible_capacity)
	var latest_off_page := seat == get_last_discard_seat() and visible_start < latest_start
	var owner_copy := "%s %d-%d/%d" % [discard_river_owner_text(seat), visible_start + 1, window_end, discard_count]
	var owner_display_copy := "%s · 最新在末页" % owner_copy if latest_off_page else owner_copy
	var owner = make_badge(overlay, discard_river_owner_badge_rect(seat), owner_display_copy, 10, Color(0.010, 0.024, 0.026, fill_alpha), Color(accent.r, accent.g, accent.b, border_alpha), Color(0.92, 0.88, 0.70, 0.92))
	owner.name = "DiscardRiverOwnerBadge_%d" % seat
	owner.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owner.tooltip_text = "%s · 当前 %d-%d / %d" % [discard_river_owner_text(seat), visible_start + 1, visible_start + visible_count, discard_count]
	owner.set_meta("window_start", visible_start)
	owner.set_meta("window_end", window_end)
	owner.set_meta("discard_count", discard_count)
	owner.set_meta("latest_discard_off_page", latest_off_page)
	owner.set_meta("latest_discard_page_state", "history" if latest_off_page else "latest")
	owner.set_meta("latest_page_hint", "最新弃牌在末页" if latest_off_page else "当前页包含最新弃牌")
	owner.set_meta("latest_page_action", "回到最新")
	owner.set_meta("compact_readable", effective_viewport_size().y <= 560.0)
	mark_ui_optimization(owner, "F-038")
	mark_ui_optimization(owner, "F-039")
	if latest_off_page:
		set_ui_full_text(owner, owner_display_copy, "%s；点击下方入口回到最新页" % owner_copy)
	if discard_count > visible_capacity:
		var archive_button = make_small_button(discard_archive_button_text(discard_count, visible_start, visible_capacity), Color(accent.r, accent.g, accent.b, 0.44), Callable(self, "cycle_discard_archive_window").bind(seat, visible_capacity))
		archive_button.name = "DiscardRiverArchiveButton_%d" % seat
		archive_button.z_index = 12
		archive_button.custom_minimum_size = Vector2(44, 44)
		archive_button.add_theme_font_size_override("font_size", 10)
		archive_button.focus_mode = Control.FOCUS_ALL
		for color_name in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color", "font_hover_pressed_color", "font_disabled_color"]:
			archive_button.add_theme_color_override(color_name, Color(1.0, 1.0, 1.0, 0.0))
		archive_button.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
		var page_text := "第%d-%d张 / 共%d张" % [visible_start + 1, mini(discard_count, visible_start + visible_capacity), discard_count]
		var latest_page_hint := " · 最后一张在最新页" if latest_off_page else ""
		archive_button.tooltip_text = "点击切换牌河窗口：%s%s\n完整牌河：%s" % [page_text, latest_page_hint, join_tile_labels(get_discards(seat))]
		set_ui_full_text(archive_button, archive_button.tooltip_text, "牌河窗口：" + page_text)
		archive_button.set_meta("visible_summary", "历史\n%d-%d" % [visible_start + 1, mini(discard_count, visible_start + visible_capacity)])
		archive_button.set_meta("window_label", page_text)
		archive_button.set_meta("latest_discard_page_hint", latest_page_hint != "")
		archive_button.set_meta("visual_anchor", "same_zone_local_rect")
		archive_button.set_meta("focus_visual_contract", "same_zone_local_rect")
		mark_ui_optimization(archive_button, "F-419")
		mark_ui_optimization(archive_button, "F-420")
		mark_ui_optimization(archive_button, "F-040")
		archive_button.set_meta("hidden_count", visible_start)
		archive_button.set_meta("window_start", visible_start)
		archive_button.set_meta("visible_capacity", visible_capacity)
		overlay.add_child(archive_button)
		apply_rect(archive_button, discard_archive_button_rect(seat, zone_rect, columns, rows, reserved_start))
		archive_button.set_meta("hit_rect_local_to_zone", true)
		archive_button.set_meta("reserved_start", reserved_start)
		var archive_art := draw_discard_river_archive_art(archive_button, seat, accent, discard_count, visible_start, visible_count)
		archive_art.modulate.a = 0.82
		archive_button.move_child(archive_art, 0)
		add_lucide_icon(archive_button, "book-open", rect_full(0.08, 0.07, 0.30, 0.34), Color(1.0, 0.92, 0.62, 0.92))
		# The full range remains available to focus and tooltip semantics, while the
		# painted label stays to two short lines at compact resolutions.
		var archive_label = make_label(archive_button, str(archive_button.get_meta("visible_summary", "历史")), 10, Color(1.0, 0.94, 0.66, 1.0), true)
		archive_label.name = "DiscardRiverArchiveLabel_%d" % seat
		archive_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		archive_label.tooltip_text = archive_button.tooltip_text
		archive_label.set_meta("ui_full_text", archive_button.tooltip_text)
		archive_label.set_meta("window_range_text", page_text)
		archive_label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.98))
		archive_label.add_theme_constant_override("outline_size", 3)
		archive_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		archive_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		# Leave a stable icon gutter; the label owns both the history caption and
		# window range, so it must never start beneath the book icon.
		apply_rect(archive_label, rect_full(0.34, 0.08, 0.96, 0.94))
		archive_label.set_meta("visual_hit_contract", "label_inside_archive_hit_rect")
		archive_button.focus_entered.connect(func() -> void:
			archive_art.modulate = Color(1.18, 1.10, 0.78, 1.0)
			archive_label.add_theme_color_override("font_color", Color(1.0, 1.0, 0.86, 1.0))
		)
		archive_button.focus_exited.connect(func() -> void:
			archive_art.modulate = Color(1.0, 1.0, 1.0, 0.82)
			archive_label.add_theme_color_override("font_color", Color(1.0, 0.94, 0.66, 1.0))
		)
	return overlay

func draw_discard_river_art(parent: Control, seat: int, zone_rect: Rect2, discard_count: int, visible_start: int, visible_count: int) -> Control:
	# r453: river bed = warm GPT plate only (no green wash mats under porcelain faces).
	var art = Control.new()
	art.name = "DiscardRiverArt_%d" % seat
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.z_index = 1
	apply_rect(art, zone_rect)
	parent.add_child(art)
	# r187: slightly stronger warm GPT river bed so porcelain seats read against felt.
	var wash_a := 0.070 if discard_count > 0 else 0.032
	var soft = add_optional_gpt_illustration_texture(art, "ui_title_backplate", rect_full(-0.010, -0.040, 1.010, 1.040), wash_a, false)
	if soft == null:
		soft = add_optional_gpt_illustration_texture(art, "ui_river_soft_wash", rect_full(-0.010, -0.040, 1.010, 1.040), wash_a, false)
	if soft != null:
		soft.name = "DiscardRiverWarmWash_%d" % seat
		soft.modulate = Color(1.12, 1.02, 0.88, soft.modulate.a)
	var is_last_source = seat == get_last_discard_seat() and discard_count > 0
	if is_last_source:
		var last_edge = make_gpt_plate_rect(rect_full(0.020, 0.040, 0.980, 0.085), Color(0.96, 0.80, 0.38, 0.18), "ui_soft_flash")
		last_edge.name = "DiscardRiverLastSourceEdge_%d" % seat
		art.add_child(last_edge)
	return art

func draw_discard_river_summary_art(parent: Control, total_discards: int, active_seats: Array[int]) -> Control:
	# r209: GPT chrome conversion
	var art = Control.new()
	art.name = "DiscardRiverSummaryArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.340, 0.455, 0.660, 0.565))
	parent.add_child(art)
	var gold = Color(0.86, 0.68, 0.32)
	var jade = Color(0.72, 0.56, 0.32)
	var pressure = clamp(float(total_discards) / 72.0, 0.10, 1.0)
	var spine = make_gpt_route_rail(rect_full(0.060, 0.430, 0.940, 0.570), Color(0.006, 0.014, 0.016, 0.44))
	spine.name = "DiscardRiverSummarySpine"
	art.add_child(spine)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.920 * pressure, 0.740), Color(gold.r, gold.g, gold.b, 0.24))
	fill.name = "DiscardRiverSummaryFill"
	spine.add_child(fill)
	var source = make_gpt_gate(rect_full(0.025, 0.295, 0.100, 0.705), Color(jade.r, jade.g, jade.b, 0.18))
	source.name = "DiscardRiverSummarySource"
	art.add_child(source)
	var gate = make_gpt_gate(rect_full(0.895, 0.265, 0.970, 0.735), Color(gold.r, gold.g, gold.b, 0.18 + pressure * 0.08))
	gate.name = "DiscardRiverSummaryGate"
	art.add_child(gate)
	var glyph = make_label(gate, "%d" % min(99, total_discards), 8, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "DiscardRiverSummaryGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive = make_gpt_plate_rect(rect_full(0.715, 0.025, 0.845, 0.315), Color(gold.r, gold.g, gold.b, 0.14 + pressure * 0.06), "ui_jade_reading_plate")
	archive.name = "DiscardRiverSummaryArchive"
	art.add_child(archive)
	var archive_glyph = make_label(archive, "河", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	archive_glyph.name = "DiscardRiverSummaryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var seat_count = min(4, active_seats.size())
	for i in range(seat_count):
		var seat = active_seats[i]
		var col = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else jade
		var left = 0.170 + float(i) * 0.160
		var branch = make_gpt_plate_rect(rect_full(left, 0.175, left + 0.112, 0.265), Color(0.006, 0.014, 0.016, 0.34), "ui_jade_reading_plate")
		branch.name = "DiscardRiverSummarySeatBranch_%d" % seat
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.720, 0.750), Color(col.r, col.g, col.b, 0.20))
		branch_fill.name = "DiscardRiverSummarySeatBranchFill_%d" % seat
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(left + 0.034, 0.050, left + 0.084, 0.235), Color(col.r, col.g, col.b, 0.22))
		node.name = "DiscardRiverSummarySeatNode_%d" % seat
		art.add_child(node)
	for i in range(min(4, max(2, active_seats.size()))):
		var left = 0.255 + float(i) * 0.095
		var tick = make_gpt_tick_strip(rect_full(left, 0.660, left + 0.016, 0.845), Color(gold.r, gold.g, gold.b, 0.22 - float(i) * 0.035))
		tick.name = "DiscardRiverSummaryTick_0"
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.790 + float(i) * 0.045, 0.760, 0.816 + float(i) * 0.045, 0.905), Color(jade.r, jade.g, jade.b, 0.20 - float(i) * 0.040))
		pip.name = "DiscardRiverSummaryArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.38, 0.78).from(0.86)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.78).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.86, 0.78).from(0.38)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.78).from(0.48)
	return art


func mark_table_tile_3d_proxy(proxy: Control, tile: String, seat: int, role: String, highlighted: bool, raised: bool, order: int) -> void:
	if proxy == null:
		return
	# 2D mode: keep proxy visible; metadata retained for optional tooling only.
	proxy.modulate.a = 1.0
	proxy.set_meta("is_3d_layout_proxy", false)
	proxy.set_meta("table_3d_tile", tile)
	proxy.set_meta("table_3d_seat", seat)
	proxy.set_meta("table_3d_role", role)
	proxy.set_meta("table_3d_highlighted", highlighted)
	proxy.set_meta("table_3d_raised", raised)
	proxy.set_meta("table_3d_order", order)


func table_3d_entry_from_proxy(proxy: Control, parent: Control) -> Dictionary:
	if proxy == null or parent == null or not proxy.is_inside_tree() or not parent.is_inside_tree():
		return {}
	var parent_rect := parent.get_global_rect()
	var proxy_rect := proxy.get_global_rect()
	if parent_rect.size.x <= 1.0 or parent_rect.size.y <= 1.0 or proxy_rect.size.x <= 1.0 or proxy_rect.size.y <= 1.0:
		return {}
	var tile := str(proxy.get_meta("table_3d_tile", ""))
	if tile == "":
		return {}
	var seat := int(proxy.get_meta("table_3d_seat", 0))
	var role := str(proxy.get_meta("table_3d_role", "discard"))
	var order := int(proxy.get_meta("table_3d_order", 0))
	var relative_center := proxy_rect.position + proxy_rect.size * 0.5 - parent_rect.position
	var tilt_step := 0.12 if role == "meld" else 0.28
	var deterministic_tilt := (float((order * 17 + seat * 7) % 5) - 2.0) * deg_to_rad(tilt_step)
	return {
		"texture": tile_textures.get(tile, tile_decal_textures.get(tile, null)) as Texture2D,
		"center": Vector2(relative_center.x / parent_rect.size.x, relative_center.y / parent_rect.size.y),
		"size": Vector2(proxy_rect.size.x / parent_rect.size.x, proxy_rect.size.y / parent_rect.size.y),
		"rotation": deterministic_tilt,
		"highlighted": bool(proxy.get_meta("table_3d_highlighted", false)),
		"raised": bool(proxy.get_meta("table_3d_raised", false)),
		"role": role,
		"accent": SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY,
	}


func collect_table_3d_entries_from_proxies(parent: Control) -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	var proxies: Array[Control] = []
	for node in parent.find_children("*", "Control", true, false):
		var proxy := node as Control
		if proxy != null and bool(proxy.get_meta("is_3d_layout_proxy", false)):
			proxies.append(proxy)
	proxies.sort_custom(func(a: Control, b: Control) -> bool:
		return int(a.get_meta("table_3d_order", 0)) < int(b.get_meta("table_3d_order", 0))
	)
	for proxy in proxies:
		var entry := table_3d_entry_from_proxy(proxy, parent)
		if not entry.is_empty():
			entries.append(entry)
	return entries


func queue_table_3d_stage_refresh(parent: Control) -> void:
	# 牌河和副露由 assets/tiles 的 2D TextureRect 独占；保留函数名只为兼容旧调用点。
	return


func refresh_table_3d_stage_from_proxies(parent_id: int) -> void:
	# Historical 3D proxy refresh intentionally disabled. The visible 2D tile node
	# remains the single source of truth for discard and meld faces.
	return


func make_discard_3d_entry(tile: String, seat: int, zone_rect: Rect2, columns: int, visual_index: int, tile_size: Vector2, table_render_size: Vector2, highlighted: bool) -> Dictionary:
	var safe_table_size := Vector2(maxf(1.0, table_render_size.x), maxf(1.0, table_render_size.y))
	var safe_columns := maxi(1, columns)
	var column: int = visual_index % safe_columns
	var row: int = visual_index / safe_columns
	var left := zone_rect.position.x + float(column) * (tile_size.x + float(DISCARD_GRID_SEPARATION)) / safe_table_size.x
	var top := zone_rect.position.y + float(row) * (tile_size.y + float(DISCARD_GRID_SEPARATION)) / safe_table_size.y
	var face_texture := tile_textures.get(tile, tile_decal_textures.get(tile, null)) as Texture2D
	var deterministic_tilt := (float((visual_index * 17 + seat * 7) % 5) - 2.0) * deg_to_rad(0.28)
	return {
		"texture": face_texture,
		"center": Vector2(left + tile_size.x / safe_table_size.x * 0.5, top + tile_size.y / safe_table_size.y * 0.5),
		"size": Vector2(tile_size.x / safe_table_size.x, tile_size.y / safe_table_size.y),
		"rotation": deterministic_tilt,
		"highlighted": highlighted,
		"accent": SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY,
	}


func draw_discards(parent: Control) -> void:
	var table_size: Vector2 = game_table_pixel_size()
	var table_render_size: Vector2 = parent.size if parent.size.x > 1.0 and parent.size.y > 1.0 else table_size
	var total_discards := 0
	var active_seats: Array[int] = []
	var table_tile_entries: Array[Dictionary] = []
	var foreground_overlays: Array[Control] = []
	for zone in DISCARD_ZONES:
		var seat = int(zone[0])
		var zone_rect: Rect2 = zone[1]
		var grid = GridContainer.new()
		grid.name = "DiscardGrid_%d" % seat
		configure_passive_container(grid)
		grid.columns = int(zone[2])
		grid.z_index = 8  # r449 above seat/meld chrome so river faces stay readable
		apply_rect(grid, zone_rect)
		if mode == "online_game" and online_game_disconnected():
			grid.set_meta("interaction_state", "read_only")
			grid.set_meta("disabled_reason", "牌局已断线，牌河仅供查看")
			grid.tooltip_text = "只读牌河：等待重连后才能继续牌局"
		grid.add_theme_constant_override("h_separation", DISCARD_GRID_SEPARATION)
		grid.add_theme_constant_override("v_separation", DISCARD_GRID_SEPARATION)
		parent.add_child(grid)
		var discards = get_discards(seat)
		if not discards.is_empty():
			total_discards += discards.size()
			active_seats.append(seat)
		# Prefer live table control size so river cells match the painted surface.
		var size_basis: Vector2 = table_render_size if table_render_size.x > 8.0 and table_render_size.y > 8.0 else table_size
		var visible_rows = discard_zone_visible_rows_for_table_size(zone_rect, grid.columns, size_basis)
		var tile_size = discard_zone_tile_size_for_table_size(zone_rect, grid.columns, visible_rows, size_basis)
		var raw_visible_capacity: int = int(grid.columns * visible_rows)
		var visible_capacity := raw_visible_capacity
		if discards.size() > raw_visible_capacity:
			visible_capacity = maxi(1, raw_visible_capacity - 2)
		var latest_start := tail_window_start(discards.size(), visible_capacity)
		var visible_start := clampi(int(discard_window_start_by_seat.get(seat, latest_start)), 0, latest_start)
		var visible_count = mini(visible_capacity, discards.size() - visible_start)
		var latest_page_state := "latest" if visible_start >= latest_start else "history"
		grid.set_meta("visible_capacity", visible_capacity)
		grid.set_meta("raw_visible_capacity", raw_visible_capacity)
		grid.set_meta("window_start", visible_start)
		grid.set_meta("discard_count", discards.size())
		var archive_reserved_start := visible_capacity if discards.size() > visible_capacity else -1
		grid.set_meta("archive_reserved_start", archive_reserved_start)
		grid.set_meta("final_grid_columns", grid.columns)
		grid.set_meta("final_grid_rows", int(visible_rows))
		grid.set_meta("archive_reserved_cells", 2 if archive_reserved_start >= 0 else 0)
		grid.set_meta("latest_discard_gutter_px", 6.0)
		grid.set_meta("latest_discard_page_state", latest_page_state)
		grid.set_meta("latest_discard_source_seat", get_last_discard_seat())
		grid.set_meta("river_overlay_contract", "final_grid_reserved_cell_and_latest_gutter")
		var river_art = draw_discard_river_art(parent, seat, zone_rect, discards.size(), visible_start, visible_count)
		if river_art != null:
			parent.move_child(river_art, max(0, grid.get_index()))
		for i in range(visible_count):
			var source_index = visible_start + i
			var highlighted = seat == get_last_discard_seat() and source_index == discards.size() - 1
			var tile_code := str(discards[source_index])
			# The single river focus marker owns the latest-discard frame; keep the
			# authored face clean instead of stacking a second per-tile frame.
			var tile_node = make_tile_view(tile_code, tile_size, false, Callable(), false)
			# Keep each river face at the measured authored size. The grid may add
			# empty gutter, but must not stretch one face differently from its peers.
			tile_node.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			tile_node.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			tile_node.custom_minimum_size = tile_size
			# r449: river porcelain must never keep a wall-back fallback texture.
			var face_tex := tile_node.find_child("TileFaceTexture", true, false) as TextureRect
			var norm_code := normalize_tile_code(tile_code)
			if face_tex != null and tile_back != null and (face_tex.texture == null or face_tex.texture == tile_back):
				var forced = tile_textures.get(norm_code, null)
				if forced == null or forced == tile_back:
					forced = load_tile_texture(tile_path(norm_code))
				if forced != null and forced != tile_back:
					face_tex.texture = forced
					tile_textures[norm_code] = forced
					face_tex.modulate = Color(1.0, 1.0, 1.0, 1.0)
			# Tile artwork keeps its authored RGB on every seat. River emphasis comes
			# from the existing GPT mats and focus marker, never runtime tinting.
			if face_tex != null:
				face_tex.modulate = Color(1.0, 1.0, 1.0, face_tex.modulate.a)
			tile_node.modulate = Color(1.0, 1.0, 1.0, tile_node.modulate.a)
			tile_node.set_meta("discard_source_index", source_index)
			tile_node.set_meta("discard_tile_code", tile_code)
			tile_node.tooltip_text = "%s牌河 · 第%d张 · %s" % [pending_claim_source_name(seat), source_index + 1, tile_label(tile_code)]
			tile_node.set_meta("latest_discard_gutter_px", 6.0)
			tile_node.set_meta("river_final_grid_columns", grid.columns)
			tile_node.set_meta("river_final_grid_rows", int(visible_rows))
			tile_node.set_meta("river_cell_contract", "owner_overlay_uses_same_final_grid")
			tile_node.set_meta("visual_owner", "river_face")
			tile_node.set_meta("discard_page_state", latest_page_state)
			if highlighted:
				tile_node.tooltip_text += " · 刚打出 · 当前最后一张牌"
				tile_node.set_meta("latest_discard_visual_owner", "LastDiscardFocusMarker")
			grid.add_child(tile_node)
			if highlighted:
				tile_node.name = "RecentDiscardTile_%d" % seat
				tile_node.z_index = 9
				mark_ui_optimization(tile_node, "F-259")
		var owner_overlay := draw_discard_river_owner_overlay(parent, seat, zone_rect, discards.size(), visible_start, visible_count, visible_capacity, grid.columns, int(visible_rows), archive_reserved_start)
		if owner_overlay != null:
			owner_overlay.set_meta("archive_reserved_start", archive_reserved_start)
			owner_overlay.set_meta("final_grid_contract", "columns_rows_reserved_start_from_same_grid")
			owner_overlay.set_meta("latest_discard_gutter_px", 6.0)
			owner_overlay.set_meta("latest_discard_page_state", latest_page_state)
			owner_overlay.set_meta("latest_discard_source_seat", get_last_discard_seat())
			owner_overlay.set_meta("table_3d_foreground", true)
			foreground_overlays.append(owner_overlay)
		if seat == get_last_discard_seat() and visible_start + visible_count == discards.size() and visible_count > 0:
			var focus_marker := draw_last_discard_focus_marker(parent, seat, table_size)
			if focus_marker != null:
				focus_marker.set_meta("latest_discard_page_state", latest_page_state)
				focus_marker.set_meta("latest_discard_source_index", discards.size() - 1)
				var focus_tile := focus_marker.find_child("LastDiscardFocusActualTile", true, false) as CanvasItem
				if focus_tile != null:
					# Legacy marker fixtures can still contain a face child. The river
					# tile remains the single visual owner for the latest discard.
					focus_tile.visible = false
					focus_tile.modulate.a = 0.0
	# Pure 2D river tiles: keep ownership overlays above discards without realtime 3D stage.
	for overlay in foreground_overlays:
		if overlay != null and is_instance_valid(overlay) and overlay.get_parent() == parent:
			parent.move_child(overlay, parent.get_child_count() - 1)
	# The four rivers already carry ownership and last-discard focus; a cross-table
	# summary strip made the battle page read as over-instrumented.

