		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.72).from(0.58)
	return art


func draw_rules_guide_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var guide_right := 0.700 if effective_viewport_size().x >= 1600.0 else 0.820
	var art = make_gpt_route_rail(rect_full(0.05, 0.086, guide_right, 0.146), Color(0.030, 0.050, 0.046, 0.84))
	art.name = "RulesGuideArt"
	art.set_meta("wide_layout_policy", "compact_guide_keep_body_primary")
	parent.add_child(art)
	# 国风底板插画替代原 rail/fill/gate/tick/connector/lead_glow 代码自绘装饰
	var guide_plate = add_optional_gpt_illustration_texture(art, "rules_guide_panel", rect_full(-0.02, -0.05, 1.02, 1.05), 0.20, false)
	if guide_plate != null:
		guide_plate.name = "RulesGuidePanelPlate"
		art.move_child(guide_plate, 0)
	# Keep the guide one-to-one with the six authored sections. A summary rail
	# cannot be used as a substitute for a chapter target because it leaves the
	# middle chapters unreachable by touch and keyboard.
	var steps = [
		{"label": "和牌与响应", "icon": "target", "color": Color(0.78, 0.54, 0.30)},
		{"label": "结算与支付", "icon": "coins", "color": Color(0.36, 0.66, 0.54)},
		{"label": "计番项目", "icon": "calculator", "color": Color(0.48, 0.58, 0.78)},
		{"label": "牌型介绍", "icon": "layers", "color": Color(0.54, 0.64, 0.72)},
		{"label": "特殊牌型", "icon": "sparkles", "color": Color(0.78, 0.58, 0.34)},
		{"label": "游戏操作", "icon": "mouse-pointer-2", "color": Color(0.88, 0.70, 0.34)},
	]
	var guide_step_intervals := maxi(1, steps.size() - 1)
	for i in range(steps.size()):
		var step = steps[i]
		var center_x = 0.105 + float(i) * ((guide_right - 0.105) / float(guide_step_intervals))
		var col: Color = step.get("color", Color(0.62, 0.62, 0.42))
		var node = make_gpt_gate(rect_full(center_x - 0.042, 0.155, center_x + 0.042, 0.825), Color(col.r, col.g, col.b, 0.24))
		node.name = "RulesGuideStep_%d" % i
		art.add_child(node)
		var active_plate = add_optional_gpt_illustration_texture(node, "ui_progress_signal_strip", rect_full(-0.16, -0.16, 1.16, 1.16), 0.08 if i != 0 else 0.62, false)
		if active_plate != null:
			active_plate.name = "RulesGuideStepActivePlate_%d" % i
			node.move_child(active_plate, 0)
		var icon = add_lucide_icon(node, str(step.get("icon", "circle")), rect_full(0.25, 0.16, 0.75, 0.56), col.lightened(0.36))
		if icon != null:
			icon.name = "RulesGuideStepIcon_%d" % i
		var label = make_label(node, str(step.get("label", "")), 9, Color(0.96, 0.94, 0.82), true)
		label.name = "RulesGuideStepLabel_%d" % i
		apply_rect(label, rect_full(0.06, 0.555, 0.94, 0.735))
		label.set_meta("guide_name", str(step.get("label", "")))
		label.text = str(step.get("label", ""))
		set_ui_full_text(label, str(step.get("label", "")), "规则导航步骤：" + str(step.get("label", "")))
		mark_ui_optimization(label, "F-533")
		mark_ui_optimization(label, "F-226")
		var state_label := make_label(node, "当前" if i == 0 else "待读", 9, Color(0.82, 0.90, 0.80), false)
		state_label.name = "RulesGuideStepState_%d" % i
		apply_rect(state_label, rect_full(0.12, 0.745, 0.88, 0.940))
		state_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		state_label.set_meta("rules_step_state", "current" if i == 0 else "unread")
		set_ui_full_text(state_label, state_label.text, "规则导航状态")
		mark_ui_optimization(state_label, "F-226")
		var focus_plate := add_optional_gpt_illustration_texture(node, "ui_button_face_plate", rect_full(-0.08, -0.08, 1.08, 1.08), 0.0, false)
		if focus_plate != null:
			focus_plate.name = "RulesGuideStepFocusPlate_%d" % i
			focus_plate.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return art


