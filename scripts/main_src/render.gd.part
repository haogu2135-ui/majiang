func draw_advisor_signal_strip(parent: Control, heading: String, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var strip = make_gpt_ribbon(rect_full(0.035, 0.13, 0.080, 0.88), accent.blend(Color(0.08, 0.10, 0.09, 1.0)))
	strip.name = "AdvisorSignalStrip_%s" % heading
	parent.add_child(strip)
	var pulse = make_gpt_tick_strip(rect_full(0.18, 0.07, 0.82, 0.22), accent.lightened(0.20))
	pulse.name = "AdvisorSignalPulse_%s" % heading
	strip.add_child(pulse)
	var _gpt_panel_host = make_gpt_plate_rect(rect_full(0.28, 0.36, 0.72, 0.64), accent.darkened(0.10), "ui_button_face_plate")
	_gpt_panel_host.name = "GptPanelHost"
	strip.add_child(_gpt_panel_host)
	var icon_text = advisor_signal_icon_text(heading)
	var icon = make_label(strip, icon_text, 8, Color(0.09, 0.12, 0.10), true)
	icon.name = "AdvisorSignalIcon_%s" % heading
	apply_rect(icon, rect_full(0.04, 0.72, 0.96, 0.96))
	icon.clip_text = true
	if fx_enabled_effective():
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(pulse, "modulate:a", 0.38, 0.72).from(0.92)
		tw.tween_property(pulse, "modulate:a", 0.92, 0.72)
	return strip


func draw_after_gang(seat: int) -> void:
	if wall.is_empty():
		finish_wall_draw()
		return
	var drawn = draw_turn_tile_or_finish(seat, true, "gang")
	if drawn == "":
		return
	sort_hand(players[seat]["hand"])
	offline_turn_needs_draw = false
	offline_phase = "await_discard"
	add_log("%s杠后补牌。" % players[seat]["name"])
	play_after_gang_replacement_draw_fx(seat, drawn)
	# 杠后补牌与普通摸牌共用自摸行动窗口。这里不能直接结算：玩家需要
	# 正常看到自摸操作，AI 也必须先评估是否保留更高价值的听口。
	request_game_render()

func draw_audio_test_button_art(button: Control) -> Control:
	# r208: GPT chrome conversion
	var art = Control.new()
	art.name = "AudioTestButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var audio_texture = add_illustration_texture(art, "settings_audio_wave", rect_full(-0.050, -0.160, 1.050, 1.160), 0.12, false)
	if audio_texture != null:
		audio_texture.name = "AudioTestTexture"
		art.move_child(audio_texture, 0)
	var accent = Color(0.42, 0.68, 0.86)
	var speaker = make_gpt_edge_rail(rect_full(0.070, 0.205, 0.225, 0.610), Color(accent.r, accent.g, accent.b, 0.14))
	speaker.name = "AudioTestSpeakerSeal"
	art.add_child(speaker)
	var speaker_glyph = add_lucide_icon(speaker, "volume-2", rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.92, 0.72, 0.88))
	if speaker_glyph != null:
		speaker_glyph.name = "AudioTestSpeakerGlyph"
	else:
		var glyph = make_label(speaker, "音", 9, Color(0.96, 0.92, 0.72, 0.88), true)
		glyph.name = "AudioTestSpeakerGlyph"
		apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var wave_rail = make_gpt_route_rail(rect_full(0.300, 0.150, 0.890, 0.245), Color(0.006, 0.016, 0.018, 0.40))
	wave_rail.name = "AudioTestWaveRail"
	art.add_child(wave_rail)
	var wave_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.780, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	wave_fill.name = "AudioTestWaveFill"
	wave_rail.add_child(wave_fill)
	for i in range(4):
		var bar_height = 0.045 + float(i % 2) * 0.025
		var bar_left = 0.345 + float(i) * 0.092
		var bar = make_gpt_plate_rect(rect_full(bar_left, 0.225 - bar_height, bar_left + 0.026, 0.225 + bar_height), Color(accent.r, accent.g, accent.b, 0.18 - float(i) * 0.020), "ui_jade_reading_plate")
		bar.name = "AudioTestWaveBar_%d" % i
		art.add_child(bar)
	var command_route = make_gpt_route_rail(rect_full(0.275, 0.805, 0.800, 0.875), Color(0.006, 0.016, 0.018, 0.36))
	command_route.name = "AudioTestCommandRoute"
	art.add_child(command_route)
	var command_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.740, 0.750), Color(accent.r, accent.g, accent.b, 0.22))
	command_fill.name = "AudioTestCommandFill"
	command_route.add_child(command_fill)
	var command_gate = make_gpt_gate(rect_full(0.785, 0.760, 0.850, 0.925), Color(accent.r, accent.g, accent.b, 0.16))
	command_gate.name = "AudioTestCommandGate"
	art.add_child(command_gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.505, 0.770, (0.528) + float(1) * (0.085), 0.930), Color(accent.r, accent.g, accent.b, 0.17), "AudioTestCommandTick_0")
	var playback_route = make_gpt_route_rail(rect_full(0.235, 0.110, 0.760, 0.190), Color(0.006, 0.016, 0.018, 0.32))
	playback_route.name = "AudioTestPlaybackRoute"
	art.add_child(playback_route)
	var playback_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.860, 0.750), Color(accent.r, accent.g, accent.b, 0.18))
	playback_fill.name = "AudioTestPlaybackFill"
	playback_route.add_child(playback_fill)
	var playback_gate = make_gpt_gate(rect_full(0.720, 0.085, 0.790, 0.235), Color(accent.r, accent.g, accent.b, 0.14))
	playback_gate.name = "AudioTestPlaybackGate"
	art.add_child(playback_gate)
	var tick_2 = add_gpt_tick_strip(art, rect_full(0.325, 0.075, (0.344) + float(2) * (0.105), 0.260), Color(accent.r, accent.g, accent.b, 0.16), "AudioTestPlaybackTick_0")
	return art


func draw_avatar_figure(parent: Control, seat: int, active: bool) -> void:
	# r214: bulk GPT chrome sweep
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	if active:
		var halo = make_gpt_plate_rect(rect_full(0.18, 0.24, 0.82, 0.72), Color(accent.r, accent.g, accent.b, 0.10), "ui_button_face_plate")
		halo.name = "SeatAvatarActiveHalo"
		parent.add_child(halo)
	var shoulders = make_gpt_plate_rect(rect_full(0.25, 0.52, 0.75, 0.90), Color(accent.r * 0.55, accent.g * 0.55, accent.b * 0.55, 0.56), "ui_button_face_plate")
	shoulders.name = "SeatAvatarShoulders"
	parent.add_child(shoulders)
	var head = make_gpt_plate_rect(rect_full(0.34, 0.28, 0.66, 0.58), Color(0.78, 0.68, 0.50, 0.58), "ui_jade_reading_plate")
	head.name = "SeatAvatarHead"
	parent.add_child(head)
	var seal_text = seat_wind_label(seat)
	var seal = make_seal_stamp(parent, rect_full(0.05, 0.06, 0.27, 0.30), seal_text, "round")
	seal.name = "SeatAvatarWindSeal"


