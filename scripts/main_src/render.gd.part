		art.move_child(arc_texture, 0)
	var win_burst_gpt_key := "win_celebration_gpt_burst"
	var win_burst_gpt_texture = add_optional_gpt_illustration_texture(art, win_burst_gpt_key, rect_full(0.045, 0.025, 0.955, 0.905), 0.16, false)
	if win_burst_gpt_texture != null:
