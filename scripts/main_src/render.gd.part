	return null

func draw_action_intent_dock(parent: Control, count: int, force_icon_fallback := false) -> Control:
	# r214: bulk GPT chrome sweep
	var intent = make_gpt_plate_rect(action_intent_rect_for_count(count), Color(0.020, 0.036, 0.038, 0.88), "ui_jade_reading_plate")
	intent.name = "ActionIntentDock"
	parent.add_child(intent)
	var action_texture = add_illustration_texture(intent, "action_dock_ribbon", rect_full(0.010, 0.040, 0.990, 0.960), 0.13, false)
	if action_texture != null:
		action_texture.name = "ActionDockRibbonTexture"
		intent.move_child(action_texture, 0)
	var intent_plate = add_optional_gpt_illustration_texture(intent, "intent_panel_plate", rect_full(-0.02, 0.04, 1.02, 0.96), 0.22, false)
	if intent_plate != null:
		intent_plate.name = "IntentPanelPlate"
		intent.move_child(intent_plate, min(0, intent.get_child_count() - 1))
	var color = action_intent_color()
	var rail = make_gpt_route_rail(rect_full(0.012, 0.18, 0.028, 0.82), color)
	rail.name = "ActionIntentRail"
	intent.add_child(rail)
	var icon_name = action_intent_icon_name()
	var intent_icon = null if force_icon_fallback else add_lucide_icon(intent, icon_name, rect_full(0.045, 0.18, 0.118, 0.82), color.lightened(0.22))
	if intent_icon != null:
		intent_icon.name = "ActionIntentIcon"
	else:
		var fallback = make_label(intent, action_intent_fallback_icon_text(), 12, color.lightened(0.22), true)
		fallback.name = "ActionIntentFallbackIcon"
		apply_rect(fallback, rect_full(0.045, 0.16, 0.118, 0.84))
	var text = make_label(intent, action_intent_text(count), 11, Color(0.84, 0.90, 0.84), true)
	text.name = "ActionIntentText"
	apply_rect(text, rect_full(0.130, 0.10, 0.845, 0.90))
	text.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(text)
	var count_badge = make_badge(intent, rect_full(0.858, 0.18, 0.982, 0.82), "%d项" % count, 10, color.darkened(0.20), color.lightened(0.12), Color(0.96, 0.95, 0.84))
	count_badge.name = "ActionIntentCount"
	rail.modulate = Color(1, 1, 1, 0.80)
	return intent


