	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.240, 0.840, 0.760), Color(0.78, 0.64, 0.36, 0.22))
	fill.name = "SettingsSectionRouteFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.900, 0.010, 0.950, 0.135), Color(0.78, 0.64, 0.36, 0.18))
	gate.name = "SettingsSectionRouteGate"
	art.add_child(gate)
	var branches := [
		["audio", 0.180, 0.205, Color(0.34, 0.58, 0.72)],
		["play", 0.500, 0.515, Color(0.34, 0.62, 0.46)],
		["maint", 0.820, 0.805, Color(0.70, 0.48, 0.34)],
