	rail.add_child(fill)
	var seal = make_gpt_gate(rect_full(0.035, 0.290, 0.070, 0.710), Color(accent.r, accent.g, accent.b, 0.24))
	seal.name = "MenuFooterStatusSeal_%s" % chip_id
	chip.add_child(seal)
	var edge = make_gpt_edge_rail(rect_full(0.935, 0.240, 0.950, 0.760), Color(1.0, 0.82, 0.42, 0.18))
