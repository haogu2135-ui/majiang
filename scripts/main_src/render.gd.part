	var pulse = make_gpt_tick_strip(rect_full(0.030, 0.180, 0.120, 0.620), Color(0.56, 0.18, 0.12, 0.24))
	pulse.name = "HandTrayStatePulse"
	art.add_child(pulse)
	var icon_name = hand_tray_state_icon_name(state)
	if icon_name != "":
		add_lucide_icon(art, icon_name, rect_full(0.040, 0.210, 0.105, 0.590), Color(0.96, 0.92, 0.76, 0.82))
	pulse.modulate = Color(1, 1, 1, 0.78)
	return art


func draw_hand_tray_suit_flow(parent: Control, hand: Array, force_danger_glow: bool = false) -> Control:
	# r213: GPT chrome conversion
	var flow = Control.new()
	flow.name = "HandTraySuitFlow"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(flow, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_suit_flow_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(flow, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_suit_flow_GptMeter"
	flow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(flow, rect_full(0.020, 0.855, 0.235, 0.960))
	parent.add_child(flow)
	var counts := hand_group_counts(hand)
	var max_count = 1
	for value in counts:
		max_count = max(max_count, int(value))
	var labels := ["万", "条", "筒", "字", "花"]
	var colors := [
		Color(0.74, 0.46, 0.34),
		Color(0.34, 0.62, 0.46),
		Color(0.34, 0.52, 0.72),
		Color(0.66, 0.56, 0.34),
		Color(0.70, 0.42, 0.62),
	]
	var rail = make_gpt_route_rail(rect_full(0.020, 0.440, 0.980, 0.570), Color(0.88, 0.74, 0.42, 0.10))
	rail.name = "HandTraySuitRail"
	flow.add_child(rail)
	var occupied_groups := 0
	var dominant_index := 0
	var dominant_count := -1
	for i in range(counts.size()):
		var count = int(counts[i])
		if count > 0:
			occupied_groups += 1
		if count > dominant_count:
			dominant_count = count
			dominant_index = i
	var coverage = clamp(float(occupied_groups) / 5.0, 0.08, 1.0)
	var rail_fill = make_gpt_meter_fill(rect_full(0.018, 0.260, 0.018 + 0.944 * coverage, 0.740), Color(0.88, 0.74, 0.42, 0.26))
	rail_fill.name = "HandTraySuitRailFill"
	rail.add_child(rail_fill)
	var gate_center = 0.085 + float(dominant_index) * 0.205
	var gate_color: Color = colors[clamp(dominant_index, 0, colors.size() - 1)]
	var gate = make_gpt_gate(rect_full(gate_center - 0.048, 0.205, gate_center + 0.048, 0.795), Color(gate_color.r, gate_color.g, gate_color.b, 0.18))
	gate.name = "HandTraySuitDominantGate"
	flow.add_child(gate)
	for i in range(labels.size()):
		var count = int(counts[i])
		var center = 0.085 + float(i) * 0.205
		var height = 0.22 + 0.52 * float(count) / float(max_count)
		var color: Color = colors[i]
		var node = make_gpt_gate(rect_full(center - 0.035, 0.500 - height * 0.5, center + 0.035, 0.500 + height * 0.5), Color(color.r, color.g, color.b, 0.54 if count > 0 else 0.18))
		node.name = "HandTraySuitNode_%s" % labels[i]
		flow.add_child(node)
		var label = make_label(flow, labels[i], 8, Color(0.96, 0.88, 0.62, 0.88 if count > 0 else 0.42), true)
		label.name = "HandTraySuitLabel_%s" % labels[i]
		apply_rect(label, rect_full(center - 0.055, 0.680, center + 0.055, 0.980))
		configure_clipped_label(label)
	for i in range(4):
		var left = 0.185 + float(i) * 0.205
	if force_danger_glow or has_pending_danger_discard():
		var danger = make_gpt_plate_rect(rect_full(0.000, 0.000, 1.000, 1.000), Color(0.92, 0.34, 0.24, 0.08), "ui_jade_reading_plate")
		danger.name = "HandTraySuitDangerGlow"
		flow.add_child(danger)
	return flow


func draw_hand_tutorial_discard_flow(parent: Control, accent: Color) -> Control:
	# r209: GPT chrome conversion
	var flow = Control.new()
	flow.name = "HandTrayTutorialDiscardFlow"
	flow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	flow.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(flow)
	var guide_texture = add_optional_gpt_illustration_texture(flow, "guide_pointing_finger", rect_full(0.018, 0.610, 0.155, 0.980), 0.34, true)
	if guide_texture != null:
		guide_texture.name = "HandTutorialPointingFingerTexture"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var guide_tw := create_screen_tween()
			guide_tw.set_loops(48)
			guide_tw.tween_property(guide_texture, "position", guide_texture.position + Vector2(7.0, -5.0), 0.54).from(guide_texture.position)
			guide_tw.parallel().tween_property(guide_texture, "modulate:a", 0.42, 0.54).from(0.20)
			guide_tw.tween_property(guide_texture, "position", guide_texture.position, 0.54).from(guide_texture.position + Vector2(7.0, -5.0))
			guide_tw.parallel().tween_property(guide_texture, "modulate:a", 0.20, 0.54).from(0.42)
