func draw_meld_group_art(parent: Control, kind: String, accent: Color, meld_size: int) -> Control:
	# r214: bulk GPT chrome sweep
	# r180: GPT meld pad only — no program route/fill/gate ColorRect chrome under porcelain tiles.
	var art = Control.new()
	art.name = "MeldGroupArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.clip_contents = true
	apply_rect(art, rect_full(0.000, 0.000, 1.000, 1.000))
	parent.add_child(art)
	parent.move_child(art, 0)
	var pad = add_optional_gpt_illustration_texture(art, "ui_meld_pad", rect_full(-0.040, -0.080, 1.040, 1.080), 0.34, false)  # r181 restrained meld pad
	if pad != null:
		pad.name = "MeldGroupPad"
		pad.modulate = Color(accent.r, accent.g, accent.b, 0.30)
	var seal = make_gpt_gate(rect_full(0.780, 0.080, 0.960, 0.360), Color(accent.r, accent.g, accent.b, 0.16))
	seal.name = "MeldKindSeal"
	art.add_child(seal)
	var seal_label = make_label(seal, kind, 9, Color(0.98, 0.92, 0.70, 0.88), true)
	seal_label.name = "MeldKindSealLabel"
	apply_rect(seal_label, rect_full(0.0, 0.0, 1.0, 1.0))
	return art


func draw_meld_lane_art(parent: Control, seat: int, rect: Rect2, meld_count: int) -> Control:
	# r449: no program jade rails/ticks over melds — GPT wash only under tiles.
	var art = Control.new()
