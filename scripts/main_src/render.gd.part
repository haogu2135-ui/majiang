	gate.name = "WinCelebrationResolutionGate"
	resolution.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.870, 0.050, 0.990, 0.410), Color(0.92, 0.72, 0.34, 0.18))
	seal.name = "WinCelebrationResolutionSeal"
	resolution.add_child(seal)
	var glyph_text = "役" if win_type == "special" else "摸" if win_type == "self_draw" else "分"
	var glyph = make_label(seal, glyph_text, 8, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "WinCelebrationResolutionGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var score_route = make_gpt_route_rail(rect_full(0.420, 0.650, 0.920, 0.760), Color(0.006, 0.016, 0.018, 0.40))
	score_route.name = "WinCelebrationScoreArchiveRoute"
	resolution.add_child(score_route)
	var score_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(0.92, 0.72, 0.34, 0.24))
	score_fill.name = "WinCelebrationScoreArchiveFill"
	score_route.add_child(score_fill)
	var score_gate = make_gpt_gate(rect_full(0.890, 0.555, 0.955, 0.835), Color(0.92, 0.72, 0.34, 0.18))
	score_gate.name = "WinCelebrationScoreArchiveGate"
	resolution.add_child(score_gate)
	var tick = add_gpt_tick_strip(resolution, rect_full(0.265, 0.210, (0.265) + float(2) * (0.140) + (0.028), 0.600), Color(color.r, color.g, color.b, 0.24), "WinCelebrationResolutionTick_0")
	for i in range(2):
		var left = 0.600 + float(i) * 0.085
		var pip = make_gpt_gate(rect_full(left, 0.610, left + 0.025, 0.820), Color(0.92, 0.72, 0.34, 0.22 - float(i) * 0.040))
		pip.name = "WinCelebrationScoreArchivePip_%d" % i
		resolution.add_child(pip)
	return resolution


func draw_win_detail_limit_art(parent: Control, limit_name: String, fan: int, points: int) -> Control:
	# r213: GPT chrome conversion
	var art = Control.new()
	art.name = "WinDetailLimitArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.690, 0.680, 0.970, 0.940))
	parent.add_child(art)
	var intensity = clamp(max(float(fan) / 8.0, float(points) / 16000.0), 0.25, 1.0)
	var accent = Color(0.90, 0.38, 0.28)
	if limit_name.find("役满") >= 0 or limit_name.find("封顶") >= 0:
		accent = Color(0.96, 0.66, 0.30)
	var route = make_gpt_route_rail(rect_full(0.065, 0.720, 0.935, 0.835), Color(0.006, 0.016, 0.018, 0.52))
	route.name = "WinDetailLimitRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.930 * intensity, 0.740), Color(accent.r, accent.g, accent.b, 0.44))
	fill.name = "WinDetailLimitFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.810, 0.165, 0.930, 0.665), Color(accent.r, accent.g, accent.b, 0.24))
	gate.name = "WinDetailLimitGate"
	art.add_child(gate)
	var burst = make_gpt_edge_rail(rect_full(0.020, 0.060, 0.220, 0.680), Color(accent.r, accent.g, accent.b, 0.12))
	burst.name = "WinDetailLimitBurst"
	art.add_child(burst)
	var tick = add_gpt_tick_strip(art, rect_full(0.165, 0.470, (0.165) + float(2) * (0.185) + (0.030), 0.660), Color(accent.r, accent.g, accent.b, 0.30), "WinDetailLimitTick_0")
	for i in range(4):
		var angle = float(i) * TAU / 4.0
		var cx = 0.120 + cos(angle) * 0.075
		var cy = 0.360 + sin(angle) * 0.220
		var spark = make_gpt_gate(rect_full(cx - 0.014, cy - 0.055, cx + 0.014, cy + 0.055), Color(accent.r, accent.g, accent.b, 0.28 - float(i) * 0.025))
		spark.name = "WinDetailLimitSpark_%d" % i
		art.add_child(spark)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.46, 0.68).from(1.0)
		tw.tween_property(fill, "modulate:a", 1.0, 0.68).from(0.46)
	return art


func draw_win_detail_resolution_bridge(parent: Control, fan: int, points: int, reason_count: int) -> Control:
	# r214: bulk GPT chrome sweep
	var bridge = Control.new()
	bridge.name = "WinDetailResolutionBridge"
	bridge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bridge, rect_full(0.705, 0.300, 0.965, 0.640))
	parent.add_child(bridge)
	var seal_texture = add_illustration_texture(bridge, "win_resolution_seal", rect_full(-0.180, -0.260, 1.060, 1.180), 0.16, false)
	if seal_texture != null:
		seal_texture.name = "WinDetailResolutionSeal"
	var strength = clamp(max(float(fan) / 8.0, float(points) / 12800.0), 0.12, 1.0)
	var accent = Color(0.92, 0.74, 0.34)
	var rail = make_gpt_route_rail(rect_full(0.080, 0.455, 0.920, 0.545), Color(0.006, 0.016, 0.018, 0.48))
	rail.name = "WinDetailResolutionRail"
