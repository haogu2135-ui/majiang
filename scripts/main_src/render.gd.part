	highlight.name = "ShopItemNativeCharmHighlight_%s" % item_id
	charm.add_child(highlight)
	return charm


func draw_shop_item_row_art(row: Control, item_color: Color, count: int, item_id: String = "") -> void:
	# The center crop of the authored dark-scrim bitmap is deliberately quiet:
	# product copy remains continuous while the dedicated shop art survives only
	# as a very faint edge texture.
	var readability_plate = make_gpt_center_crop_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.022, 0.034, 0.032, 0.99), "ui_dark_scrim", 0.22)
	readability_plate.name = "ShopItemRowLowFrequencyPlate"
	row.add_child(readability_plate)
	row.move_child(readability_plate, 0)
	var shop_row_plate = add_optional_gpt_illustration_texture(row, "ui_shop_row_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.040, false)
	if shop_row_plate != null:
		shop_row_plate.name = "ShopItemRowGptPlate"
		shop_row_plate.modulate = Color(1.0, 0.96, 0.90, 0.040)
		row.move_child(shop_row_plate, min(1, row.get_child_count() - 1))
	var shop_row_meter = add_optional_gpt_illustration_texture(row, "ui_meter_rail_plate", rect_full(0.08, 0.72, 0.92, 0.90), 0.48, false)
	if shop_row_meter != null:
		shop_row_meter.name = "ShopItemRowGptMeter"
	# r204 GPT row chrome
	var row_depth = make_gpt_plate_rect(rect_full(0.008, 0.180, 0.992, 0.985), Color(0.86, 0.72, 0.48, 0.11), "settings_overview_panel")
	row_depth.name = "ShopItem3DDepthEdge_%s" % (item_id if item_id != "" else "generic")
	row.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.085), Color(1.0, 0.88, 0.54, 0.12))
	row_top_rim.name = "ShopItem3DTopRim_%s" % (item_id if item_id != "" else "generic")
	row.add_child(row_top_rim)
	var charm_plinth = make_gpt_plate_rect(rect_full(0.018, 0.105, 0.145, 0.920), Color(0.82, 0.62, 0.30, 0.28), "ui_hand_tray_state_chip")
	charm_plinth.name = "ShopItem3DCharmPlinth_%s" % (item_id if item_id != "" else "generic")
	row.add_child(charm_plinth)
	var item_texture = add_illustration_texture(row, "shop_item_shelf", rect_full(0.010, 0.030, 0.790, 0.970), 0.035, false)
	if item_texture != null:
		item_texture.name = "ShopItemShelfTexture_%s" % (item_id if item_id != "" else "generic")
		row.move_child(item_texture, 0)
	var charm_key = shop_charm_gpt_key(item_id)
	var charm_texture = add_optional_gpt_illustration_texture(row, charm_key, rect_full(0.016, 0.030, 0.136, 0.970), 0.52, true) if shop_charm_texture_is_safe(item_id) else null
	if charm_texture != null:
		charm_texture.name = "ShopItemCharmTexture_%s" % (item_id if item_id != "" else "generic")
		row.move_child(charm_texture, min(1, row.get_child_count() - 1))
	var shelf = make_gpt_route_rail(rect_full(0.110, 0.820, 0.775, 0.885), Color(item_color.r, item_color.g, item_color.b, 0.18))
	shelf.name = "ShopItemShelfRail"
	row.add_child(shelf)
	var route = make_gpt_route_rail(rect_full(0.615, 0.365, 0.780, 0.455), Color(item_color.r, item_color.g, item_color.b, 0.12))
	route.name = "ShopItemRouteRail"
	row.add_child(route)
	var value_route = add_optional_gpt_illustration_texture(row, "ui_progress_signal_strip", rect_full(0.120, 0.530, 0.790, 0.620), 0.28, false)
	if value_route == null:
		# Preserve the child layout when an imported artifact is unavailable;
		# this host is invisible and never substitutes program-painted chrome.
		value_route = make_layout_host(rect_full(0.120, 0.530, 0.790, 0.620))
		row.add_child(value_route)
	value_route.name = "ShopItemValueRoute"
	var value_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.880 * clamp(float(count + 1) / 4.0, 0.18, 1.0), 0.740), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	value_fill.name = "ShopItemValueFill"
	value_route.add_child(value_fill)
	var value_gate = make_gpt_gate(rect_full(0.770, 0.505, 0.805, 0.640), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	value_gate.name = "ShopItemValueGate"
	row.add_child(value_gate)
	var energy = make_gpt_route_rail(rect_full(0.120, 0.060, 0.535, 0.105), Color(item_color.r, item_color.g, item_color.b, 0.14))
	energy.name = "ShopItemEnergyRail"
	row.add_child(energy)
	var fill_right = 0.120 + 0.415 * clamp(float(count) / 3.0, 0.08, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.120, 0.068, fill_right, 0.097), Color(item_color.r, item_color.g, item_color.b, 0.20 if count > 0 else 0.09))
	fill.name = "ShopItemEnergyFill"
	row.add_child(fill)
	var mark = make_gpt_gate(rect_full(0.772, 0.190, 0.812, 0.810), Color(item_color.r, item_color.g, item_color.b, 0.28))
	mark.name = "ShopItemTypeMark_%s" % (item_id if item_id != "" else "generic")
	row.add_child(mark)
	var mark_label = make_label(mark, item_short_mark(item_id), 13, Color(1.0, 0.96, 0.82, 1.0), true)
	mark_label.name = "ShopItemTypeGlyph"
	apply_rect(mark_label, rect_full(0.0, 0.0, 1.0, 1.0))
	mark_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	mark_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	mark_label.add_theme_color_override("font_outline_color", Color(0.05, 0.03, 0.01, 0.90))
	mark_label.add_theme_constant_override("outline_size", 4)
	var stock = Control.new()
	stock.name = "ShopItemStockPips"
	stock.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(stock, rect_full(0.620, 0.075, 0.760, 0.180))
	row.add_child(stock)
	var pip_count = min(4, max(1, count))
	for i in range(pip_count):
		var left = 0.02 + float(i) * 0.235
		var alpha = 0.58 if count > 0 else 0.16
		var pip = make_gpt_gate(rect_full(left, 0.18, left + 0.145, 0.82), Color(item_color.r, item_color.g, item_color.b, alpha))
		pip.name = "ShopItemStockPip_%d" % i
		stock.add_child(pip)
	for i in range(3):
		var left = 0.630 + float(i) * 0.050
		var lit = count > i
		var node = make_gpt_tick_strip(rect_full(left, 0.300, left + 0.024, 0.520), Color(item_color.r, item_color.g, item_color.b, 0.18 if lit else 0.07))
		node.name = "ShopItemRouteNode_%d" % i
		row.add_child(node)
	for i in range(2):
		var value_tick_left = 0.600 + float(i) * 0.058
		var value_tick = make_gpt_tick_strip(rect_full(value_tick_left, 0.493, value_tick_left + 0.016, 0.640), Color(item_color.r, item_color.g, item_color.b, 0.10 - float(i) * 0.025 if count > 0 else 0.045))
		value_tick.name = "ShopItemValueTick_0"
		row.add_child(value_tick)
	var arrow = make_gpt_ribbon(rect_full(0.742, 0.402, 0.776, 0.418), Color(item_color.r, item_color.g, item_color.b, 0.12))
	arrow.name = "ShopItemRouteArrow"
	row.add_child(arrow)
	var settlement_rail = make_gpt_route_rail(rect_full(0.340, 0.670, 0.790, 0.705), Color(0.010, 0.020, 0.022, 0.16))
	settlement_rail.name = "ShopItemSettlementRail"
	row.add_child(settlement_rail)
	var settlement_fill_right = 0.340 + 0.450 * clamp(float(count + 1) / 4.0, 0.18, 1.0)
	var settlement_fill = make_gpt_meter_fill(rect_full(0.340, 0.676, settlement_fill_right, 0.699), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.05))
	settlement_fill.name = "ShopItemSettlementFill"
	row.add_child(settlement_fill)
	var settlement_gate = make_gpt_gate(rect_full(0.775, 0.632, 0.810, 0.742), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	settlement_gate.name = "ShopItemSettlementGate"
	row.add_child(settlement_gate)
	for i in range(3):
		var tick_left = 0.430 + float(i) * 0.096
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.640, tick_left + 0.018, 0.728), Color(item_color.r, item_color.g, item_color.b, 0.095 - float(i) * 0.020 if count > 0 else 0.04))
		tick.name = "ShopItemSettlementTick_0"
		row.add_child(tick)
	var price_aura = make_gpt_plate_rect(rect_full(0.802, 0.120, 0.970, 0.880), Color(0.72, 0.62, 0.88, 0.20), "ui_button_face_plate")
	price_aura.name = "ShopItemPriceAura"
	row.add_child(price_aura)
	for i in range(2):
		var shine = make_gpt_tick_strip(rect_full(0.812 + float(i) * 0.030, 0.185, 0.832 + float(i) * 0.030, 0.315), Color(0.82, 0.70, 0.96, 0.28))
		shine.name = "ShopItemPriceSpark_%d" % i
		row.add_child(shine)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(price_aura, "modulate:a", 0.42, 0.90).from(0.88)
		tw.tween_property(price_aura, "modulate:a", 0.88, 0.90).from(0.42)
		if charm_texture != null:
			var charm_tw := create_screen_tween()
			charm_tw.set_loops(48)
			charm_tw.tween_property(charm_texture, "rotation", 0.035, 1.15).from(-0.025)
			charm_tw.parallel().tween_property(charm_texture, "modulate:a", 0.34, 1.15).from(0.18)
			charm_tw.tween_property(charm_texture, "rotation", -0.025, 1.15).from(0.035)
			charm_tw.parallel().tween_property(charm_texture, "modulate:a", 0.18, 1.15).from(0.34)

func shop_charm_gpt_key(item_id: String) -> String:
	match item_id:
		"swap_card":
			return "shop_charm_huan"
		"peek_card":
			return "shop_charm_kan"
		"lucky_charm":
			return "shop_charm_yun"
		"double_coins":
			return "shop_charm_bei"
	return "shop_charm_huan"

func draw_shop_purchase_inventory_commit_art(parent: Control, item_color: Color) -> Control:
	# r211: GPT chrome conversion
	var commit = Control.new()
	commit.name = "ShopPurchaseInventoryCommitArt"
	commit.mouse_filter = Control.MOUSE_FILTER_IGNORE
	commit.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(commit)
	var source = make_gpt_edge_rail(rect_full(0.780, 0.180, 0.830, 0.410), Color(item_color.r, item_color.g, item_color.b, 0.20))
	source.name = "ShopPurchaseInventoryCommitSource"
	commit.add_child(source)
	var archive_route = make_gpt_route_rail(rect_full(0.560, 0.225, 0.815, 0.310), Color(0.006, 0.016, 0.018, 0.46))
	archive_route.name = "ShopPurchaseInventoryArchiveRoute"
	commit.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.860, 0.740), Color(item_color.r, item_color.g, item_color.b, 0.28))
	archive_fill.name = "ShopPurchaseInventoryArchiveFill"
	archive_route.add_child(archive_fill)
	var count_route = make_gpt_route_rail(rect_full(0.560, 0.355, 0.705, 0.445), Color(0.006, 0.016, 0.018, 0.42))
	count_route.name = "ShopPurchaseInventoryCountRoute"
	commit.add_child(count_route)
	var count_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.900, 0.740), Color(item_color.r, item_color.g, item_color.b, 0.24))
	count_fill.name = "ShopPurchaseInventoryCountFill"
	count_route.add_child(count_fill)
	var archive_gate = make_gpt_gate(rect_full(0.535, 0.170, 0.590, 0.475), Color(item_color.r, item_color.g, item_color.b, 0.22))
	archive_gate.name = "ShopPurchaseInventoryArchiveGate"
	commit.add_child(archive_gate)
	var count_node = make_gpt_gate(rect_full(0.530, 0.485, 0.600, 0.745), Color(item_color.r, item_color.g, item_color.b, 0.18))
	count_node.name = "ShopPurchaseInventoryCountNode"
	commit.add_child(count_node)
	var count_glyph = make_label(count_node, "+1", 8, Color(0.98, 0.94, 0.76, 0.86), true)
	count_glyph.name = "ShopPurchaseInventoryCountGlyph"
	apply_rect(count_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tick = add_gpt_tick_strip(commit, rect_full(0.625, 0.135, (0.644) + float(2) * (0.060), 0.345), Color(item_color.r, item_color.g, item_color.b, 0.23), "ShopPurchaseInventoryCommitTick_0")
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.610 + float(i) * 0.050, 0.555, 0.630 + float(i) * 0.050, 0.705), Color(item_color.r, item_color.g, item_color.b, 0.20 - float(i) * 0.040))
		pip.name = "ShopPurchaseInventoryCommitPip_%d" % i
		commit.add_child(pip)
	archive_fill.modulate = Color(1, 1, 1, 0.84)
	count_fill.modulate = Color(1, 1, 1, 0.78)
	return commit


# ============================================================
# 房间聊天功能
# ============================================================


func draw_shop_transaction_map_art(parent: Control) -> Control:
	# r207: GPT chrome conversion
	var art = Control.new()
	art.name = "ShopTransactionMapArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.085, 0.094, 0.925, 0.124))
	parent.add_child(art)
	var gems = int(currency.get("gems", 0))
	var min_cost = 999999
	for item_id in ITEM_TYPES.keys():
		min_cost = min(min_cost, int(ITEM_TYPES[item_id].get("cost_gems", 10)))
	var affordable = gems >= min_cost
	var accent = Color(0.62, 0.52, 0.84) if affordable else Color(0.78, 0.44, 0.36)
	var source = make_gpt_edge_rail(rect_full(0.005, 0.100, 0.055, 0.900), Color(accent.r, accent.g, accent.b, 0.22))
	source.name = "ShopTransactionCurrencySource"
	art.add_child(source)
	var gem_route = make_gpt_route_rail(rect_full(0.060, 0.420, 0.405, 0.580), Color(0.006, 0.016, 0.018, 0.54))
	gem_route.name = "ShopTransactionGemRoute"
	art.add_child(gem_route)
	var gem_fill_right = 0.030 + 0.920 * (0.86 if affordable else 0.32)
	var gem_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, gem_fill_right, 0.740), Color(accent.r, accent.g, accent.b, 0.34))
	gem_fill.name = "ShopTransactionGemFill"
	gem_route.add_child(gem_fill)
	var gem_gate = make_gpt_gate(rect_full(0.390, 0.215, 0.430, 0.785), Color(accent.r, accent.g, accent.b, 0.18))
	gem_gate.name = "ShopTransactionGemGate"
	art.add_child(gem_gate)
	var affordability_seal = make_gpt_gate(rect_full(0.420, 0.050, 0.470, 0.950), Color(accent.r, accent.g, accent.b, 0.18))
	affordability_seal.name = "ShopTransactionAffordabilitySeal"
	art.add_child(affordability_seal)
	var affordability_glyph = make_label(affordability_seal, "可" if affordable else "缺", 7, Color(0.98, 0.92, 0.66, 0.78), true)
	affordability_glyph.name = "ShopTransactionAffordabilityGlyph"
	apply_rect(affordability_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var min_cost_ratio = clamp(float(min_cost) / 100.0, 0.16, 0.92)
	var min_cost_left = 0.060 + 0.345 * min_cost_ratio
	var min_cost_marker = make_gpt_gate(rect_full(min_cost_left - 0.010, 0.075, min_cost_left + 0.010, 0.925), Color(0.98, 0.82, 0.42, 0.18))
	min_cost_marker.name = "ShopTransactionMinCostMarker"
	art.add_child(min_cost_marker)
	var item_count = max(1, ITEM_TYPES.size())
	for i in range(item_count):
		var left = 0.455 + float(i) * (0.240 / float(max(1, item_count - 1)))
		var node = make_gpt_gate(rect_full(left - 0.017, 0.180, left + 0.017, 0.820), Color(accent.r, accent.g, accent.b, 0.24 if affordable else 0.12))
		node.name = "ShopTransactionItemNode_%d" % i
		art.add_child(node)
	var settlement_route = make_gpt_route_rail(rect_full(0.710, 0.420, 0.940, 0.580), Color(0.006, 0.016, 0.018, 0.54))
	settlement_route.name = "ShopTransactionSettlementRoute"
	art.add_child(settlement_route)
	var settlement_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.850 if affordable else 0.360, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	settlement_fill.name = "ShopTransactionSettlementFill"
	settlement_route.add_child(settlement_fill)
	var settlement_gate = make_gpt_gate(rect_full(0.928, 0.180, 0.970, 0.820), Color(accent.r, accent.g, accent.b, 0.18 if affordable else 0.10))
	settlement_gate.name = "ShopTransactionSettlementGate"
	art.add_child(settlement_gate)
	var reserve_route = make_gpt_route_rail(rect_full(0.505, 0.050, 0.675, 0.210), Color(0.006, 0.016, 0.018, 0.38))
	reserve_route.name = "ShopTransactionReserveRoute"
	art.add_child(reserve_route)
	var reserve_ratio = clamp(float(gems) / float(max(1, min_cost * 4)), 0.08, 1.0)
	var reserve_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * reserve_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	reserve_fill.name = "ShopTransactionReserveFill"
	reserve_route.add_child(reserve_fill)
	var reserve_gate = make_gpt_gate(rect_full(0.665, 0.010, 0.692, 0.255), Color(accent.r, accent.g, accent.b, 0.18 if affordable else 0.10))
	reserve_gate.name = "ShopTransactionReserveGate"
	art.add_child(reserve_gate)
	for i in range(2):
		var reserve_tick = make_gpt_tick_strip(rect_full(0.545 + float(i) * 0.050, 0.000, 0.557 + float(i) * 0.050, 0.255), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.040 if affordable else 0.10))
		reserve_tick.name = "ShopTransactionReserveTick_0"
		art.add_child(reserve_tick)
	for i in range(4):
		var left_tick = 0.135 + float(i) * 0.070
		var tick = make_gpt_tick_strip(rect_full(left_tick, 0.235, left_tick + 0.012, 0.765), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.030))
		tick.name = "ShopTransactionGemTick_0"
		art.add_child(tick)
	for i in range(3):
		var left_tick = 0.765 + float(i) * 0.050
		var tick_2 = make_gpt_tick_strip(rect_full(left_tick, 0.245, left_tick + 0.014, 0.755), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035 if affordable else 0.11))
		tick_2.name = "ShopTransactionSettlementTick_0"
		art.add_child(tick_2)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(gem_fill, "modulate:a", 0.38, 0.82).from(0.92)
		tw.tween_property(gem_fill, "modulate:a", 0.92, 0.82).from(0.38)
	return art


func draw_stat_row_art(parent: Control, label_text: String, value_text: String) -> Control:
	# r210: GPT chrome conversion
	var accent = stat_row_accent(label_text)
	var art = Control.new()
	art.name = "StatsRowArt_%s" % label_text
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var row_depth = make_gpt_plate_rect(rect_full(0.006, 0.220, 0.994, 0.985), Color(0.0, 0.0, 0.0, 0.34), "ui_button_face_plate")
	row_depth.name = "StatsRow3DDepthEdge_%s" % label_text
	art.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.095), Color(1.0, 0.90, 0.58, 0.040))
	row_top_rim.name = "StatsRow3DTopRim_%s" % label_text
	art.add_child(row_top_rim)
	var icon_plinth = make_gpt_edge_rail(rect_full(0.012, 0.120, 0.078, 0.880), Color(accent.r * 0.18, accent.g * 0.20, accent.b * 0.20, 0.66))
	icon_plinth.name = "StatsRow3DIconPlinth_%s" % label_text
	art.add_child(icon_plinth)
	var row_glow = make_gpt_meter_fill(rect_full(0.000, 0.000, 1.000, 1.000), Color(accent.r, accent.g, accent.b, 0.040))
	row_glow.name = "StatsRowReadabilityGlow_%s" % label_text
	art.add_child(row_glow)
	var stat_icon_card = make_gpt_edge_rail(rect_full(0.020, 0.180, 0.064, 0.820), Color(accent.r, accent.g, accent.b, 0.26))
	stat_icon_card.name = "StatsRowIconPanel_%s" % label_text
	art.add_child(stat_icon_card)
	add_lucide_icon(stat_icon_card, "trophy" if label_text.find("胜") >= 0 else "star", rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.94, 0.76, 0.92))
	var stat_divider = make_gpt_plate_rect(rect_full(0.505, 0.205, 0.510, 0.795), Color(accent.r, accent.g, accent.b, 0.22))
	stat_divider.name = "StatsRowValueDivider_%s" % label_text
	art.add_child(stat_divider)
	return art
	var marker = make_gpt_gate(rect_full(0.020, 0.260, 0.036, 0.740), Color(accent.r, accent.g, accent.b, 0.34))
	marker.name = "StatsRowMarker_%s" % label_text
	art.add_child(marker)
	var rail = make_gpt_route_rail(rect_full(0.330, 0.720, 0.915, 0.820), Color(0.006, 0.016, 0.018, 0.52))
	rail.name = "StatsRowRail_%s" % label_text
	art.add_child(rail)
	var fill_ratio = stat_row_metric_fraction(label_text, value_text)
	var fill = make_gpt_meter_fill(rect_full(0.018, 0.240, 0.018 + 0.944 * fill_ratio, 0.760), Color(accent.r, accent.g, accent.b, 0.42))
	fill.name = "StatsRowFill_%s" % label_text
	rail.add_child(fill)
	var trend_route = make_gpt_route_rail(rect_full(0.650, 0.255, 0.905, 0.335), Color(0.006, 0.016, 0.018, 0.40))
	trend_route.name = "StatsRowTrendRoute_%s" % label_text
	art.add_child(trend_route)
	var trend_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	trend_fill.name = "StatsRowTrendFill_%s" % label_text
	trend_route.add_child(trend_fill)
	var trend_gate = make_gpt_gate(rect_full(0.885, 0.185, 0.925, 0.390), Color(accent.r, accent.g, accent.b, 0.22))
	trend_gate.name = "StatsRowTrendGate_%s" % label_text
	art.add_child(trend_gate)
	var value_route = make_gpt_route_rail(rect_full(0.515, 0.470, 0.905, 0.540), Color(0.006, 0.016, 0.018, 0.36))
	value_route.name = "StatsRowValueRoute_%s" % label_text
	art.add_child(value_route)
	var value_fill = make_gpt_meter_fill(rect_full(0.000, 0.000, 0.420 + 0.520 * fill_ratio, 1.000), Color(accent.r, accent.g, accent.b, 0.20))
	value_fill.name = "StatsRowValueFill_%s" % label_text
	value_route.add_child(value_fill)
	var value_gate = make_gpt_gate(rect_full(0.890, 0.405, 0.925, 0.635), Color(accent.r, accent.g, accent.b, 0.20))
	value_gate.name = "StatsRowValueGate_%s" % label_text
	art.add_child(value_gate)
	for i in range(3):
		var left = 0.365 + float(i) * 0.075
		var lit = fill_ratio >= 0.25 + float(i) * 0.24
		var node = make_gpt_gate(rect_full(left, 0.255, left + 0.022, 0.455), Color(accent.r, accent.g, accent.b, 0.34 if lit else 0.12))
		node.name = "StatsRowNode_%s_%d" % [label_text, i]
		art.add_child(node)
	var value_tick = add_gpt_tick_strip(art, rect_full(0.565, 0.585, (0.565) + float(1) * (0.060) + (0.018), 0.705), Color(accent.r, accent.g, accent.b, 0.20), "StatsRowValueTick_%s_0" % [label_text])
	var tick = add_gpt_tick_strip(art, rect_full(0.705, 0.450, (0.705) + float(1) * (0.055) + (0.018), 0.580), Color(accent.r, accent.g, accent.b, 0.22), "StatsRowTrendTick_%s_0" % [label_text])
	var insight_bridge = make_gpt_route_rail(rect_full(0.620, 0.365, 0.805, 0.425), Color(0.006, 0.016, 0.018, 0.34))
	insight_bridge.name = "StatsRowInsightBridge_%s" % label_text
	art.add_child(insight_bridge)
	var insight_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.18))
	insight_fill.name = "StatsRowInsightFill_%s" % label_text
	insight_bridge.add_child(insight_fill)
	var insight_gate = make_gpt_gate(rect_full(0.790, 0.330, 0.824, 0.475), Color(accent.r, accent.g, accent.b, 0.18))
	insight_gate.name = "StatsRowInsightGate_%s" % label_text
	art.add_child(insight_gate)
	var insight_tick = add_gpt_tick_strip(art, rect_full(0.660, 0.325, (0.674) + float(1) * (0.060), 0.485), Color(accent.r, accent.g, accent.b, 0.18), "StatsRowInsightTick_%s_0" % label_text)
	var focus = make_gpt_gate(rect_full(0.925, 0.245, 0.962, 0.755), Color(accent.r, accent.g, accent.b, 0.12))
	focus.name = "StatsRowFocus_%s" % label_text
	art.add_child(focus)
	return art


func make_stats_summary_chip(parent: Control, chip_id: String, caption_text: String, value_text: String, rect: Rect2, accent: Color) -> Control:
	# r205: GPT-only summary chips (no program panel chrome)
	var chip = make_gpt_plate_rect(rect, Color(0.026, 0.044, 0.042, 0.86), "ui_menu_card_face")
	chip.name = "StatsSummaryChip_%s" % chip_id
	parent.add_child(chip)
	var chip_depth = make_gpt_plate_rect(rect_full(0.020, 0.600, 0.980, 0.965), Color(0.0, 0.0, 0.0, 0.34), "ui_dark_scrim")
	chip_depth.name = "StatsSummary3DDepthEdge_%s" % chip_id
	chip.add_child(chip_depth)
	var chip_top_rim = make_gpt_ribbon(rect_full(0.055, 0.045, 0.945, 0.125), Color(1.0, 0.90, 0.58, 0.08))
	chip_top_rim.name = "StatsSummary3DTopRim_%s" % chip_id
	chip.add_child(chip_top_rim)
	var value_label = make_label(chip, value_text, 20, Color(1.0, 0.93, 0.66), true)
	value_label.name = "StatsSummaryValue_%s" % chip_id
	apply_rect(value_label, rect_full(0.095, 0.100, 0.925, 0.610))
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(value_label)
	var caption_label = make_label(chip, caption_text, 11, Color(0.84, 0.94, 0.86), false)
	caption_label.name = "StatsSummaryCaption_%s" % chip_id
	apply_rect(caption_label, rect_full(0.095, 0.605, 0.925, 0.915))
	caption_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(caption_label)
	var rail = make_gpt_edge_rail(rect_full(0.045, 0.180, 0.066, 0.820), Color(accent.r, accent.g, accent.b, 0.42))
	rail.name = "StatsSummaryRail_%s" % chip_id
	chip.add_child(rail)
	return chip


func draw_stats_dashboard_art(parent: Control) -> Control:
	# r205: compact GPT-led dashboard; dead post-return chrome removed
	var dash = make_gpt_plate_rect(rect_full(0.08, 0.120, 0.92, 0.300), Color(0.014, 0.034, 0.040, 0.88), "stats_gpt_dashboard")
	dash.name = "StatsDashboardArt"
	parent.add_child(dash)
	var dashboard_depth = make_gpt_plate_rect(rect_full(0.010, 0.705, 0.990, 0.985), Color(0.0, 0.0, 0.0, 0.34), "ui_dark_scrim")
	dashboard_depth.name = "StatsDashboard3DDepthEdge"
	dash.add_child(dashboard_depth)
	var dashboard_top_rim = make_gpt_ribbon(rect_full(0.025, 0.020, 0.975, 0.065), Color(1.0, 0.88, 0.52, 0.08))
	dashboard_top_rim.name = "StatsDashboard3DTopRim"
	dash.add_child(dashboard_top_rim)
	var stats_texture = add_illustration_texture(dash, "stats_dashboard_grid", rect_full(0.010, 0.035, 0.990, 0.965), 0.12, false)
	if stats_texture != null:
		stats_texture.name = "StatsDashboardGridTexture"
		dash.move_child(stats_texture, 0)
	var winrate_texture = add_optional_gpt_illustration_texture(dash, "stats_winrate_scroll", rect_full(0.010, 0.080, 0.215, 0.920), 0.18, false)
	if winrate_texture != null:
		winrate_texture.name = "StatsWinrateScrollTexture"
		dash.move_child(winrate_texture, min(1, dash.get_child_count() - 1))
	var stats_gpt_dash = add_optional_gpt_illustration_texture(dash, "stats_gpt_dashboard", rect_full(0.0, 0.0, 1.0, 1.0), 0.22, false)
	if stats_gpt_dash != null:
		stats_gpt_dash.name = "StatsDashboardGptPlate"
		dash.move_child(stats_gpt_dash, 0)
	var stats_gpt_strip = add_optional_gpt_illustration_texture(dash, "ui_progress_signal_strip", rect_full(0.02, 0.01, 0.98, 0.10), 0.40, false)
	if stats_gpt_strip != null:
		stats_gpt_strip.name = "StatsDashboardGptStrip"
	var stats_gpt_meter = add_optional_gpt_illustration_texture(dash, "ui_meter_rail_plate", rect_full(0.24, 0.82, 0.96, 0.94), 0.36, false)
	if stats_gpt_meter != null:
		stats_gpt_meter.name = "StatsDashboardGptMeter"
	var compact_win_rate = clamp(float(game_stats.get("win_rate", 0.0)), 0.0, 1.0)
	var games_count = int(game_stats.get("games_played", 0))
	var wins_count = int(game_stats.get("games_won", 0))
	var best_score_value = int(game_stats.get("best_score", 0))
	var narrative_panel = make_gpt_plate_rect(rect_full(0.030, 0.145, 0.215, 0.800), Color(0.018, 0.038, 0.036, 0.88), "ui_jade_reading_plate")
	narrative_panel.name = "StatsSummaryNarrativePanel"
	dash.add_child(narrative_panel)
	var narrative_rail = make_gpt_edge_rail(rect_full(0.055, 0.160, 0.082, 0.835), Color(0.72, 0.56, 0.32, 0.40))
	narrative_rail.name = "StatsSummaryNarrativeRail"
	narrative_panel.add_child(narrative_rail)
	var narrative_title = make_label(narrative_panel, "战绩", 10, Color(0.84, 0.94, 0.86), false)
	narrative_title.name = "StatsSummaryNarrativeTitle"
	apply_rect(narrative_title, rect_full(0.150, 0.095, 0.900, 0.345))
	narrative_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_title)
	var narrative_body_text := "待开局"
	if games_count > 0:
		if compact_win_rate >= 0.55:
			narrative_body_text = "顺风"
		elif compact_win_rate >= 0.35:
			narrative_body_text = "稳守"
		else:
			narrative_body_text = "蓄势"
	var narrative_body = make_label(narrative_panel, narrative_body_text, 18, Color(1.0, 0.93, 0.66), true)
	narrative_body.name = "StatsSummaryNarrativeBody"
	apply_rect(narrative_body, rect_full(0.150, 0.300, 0.900, 0.660))
	narrative_body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_body)
	var narrative_meta = make_label(narrative_panel, "%d胜/%d局" % [wins_count, games_count], 9, Color(0.72, 0.84, 0.72), false)
	narrative_meta.name = "StatsSummaryNarrativeMeta"
	apply_rect(narrative_meta, rect_full(0.150, 0.655, 0.900, 0.910))
	narrative_meta.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_meta)
	make_stats_summary_chip(dash, "winrate", "胜率", "%d%%" % int(round(compact_win_rate * 100.0)), rect_full(0.235, 0.145, 0.405, 0.800), Color(0.78, 0.62, 0.36))
	make_stats_summary_chip(dash, "games", "历练", "%d局" % games_count, rect_full(0.425, 0.145, 0.595, 0.800), Color(0.58, 0.70, 0.62))
	make_stats_summary_chip(dash, "best", "单局最佳", "%s分" % compact_score_text(best_score_value), rect_full(0.615, 0.145, 0.895, 0.800), Color(0.82, 0.66, 0.32))
	var stats_hint = make_label(dash, "累计表现摘要", 13, Color(0.76, 0.88, 0.78), false)
	stats_hint.name = "StatsSummaryHint"
	apply_rect(stats_hint, rect_full(0.235, 0.805, 0.895, 0.955))
	stats_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(stats_hint)
	if games_count <= 0:
		draw_stats_empty_state_art(dash)
	return dash


