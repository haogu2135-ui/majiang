func draw_shop_transaction_map_art(parent: Control) -> Control:
	# r207: GPT chrome conversion
	var art = Control.new()
	art.name = "ShopTransactionMapArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.085, 0.094, 0.925, 0.124))
	parent.add_child(art)
	var gems = int(currency.get("gems", 0))
	var min_cost = 999999
	for item_id in ITEM_TYPES.keys():
		min_cost = min(min_cost, int(ITEM_TYPES[item_id].get("cost_gems", 10)))
	var affordable = gems >= min_cost
	var accent = Color(0.62, 0.52, 0.84) if affordable else Color(0.78, 0.44, 0.36)
	var source = make_gpt_edge_rail(rect_full(0.005, 0.100, 0.055, 0.900), Color(accent.r, accent.g, accent.b, 0.22))
	source.name = "ShopTransactionCurrencySource"
	art.add_child(source)
	var gem_route = make_gpt_route_rail(rect_full(0.060, 0.420, 0.405, 0.580), Color(0.006, 0.016, 0.018, 0.54))
	gem_route.name = "ShopTransactionGemRoute"
	art.add_child(gem_route)
	var gem_fill_right = 0.030 + 0.920 * (0.86 if affordable else 0.32)
	var gem_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, gem_fill_right, 0.740), Color(accent.r, accent.g, accent.b, 0.34))
	gem_fill.name = "ShopTransactionGemFill"
	gem_route.add_child(gem_fill)
	var gem_gate = make_gpt_gate(rect_full(0.390, 0.215, 0.430, 0.785), Color(accent.r, accent.g, accent.b, 0.18))
	gem_gate.name = "ShopTransactionGemGate"
	art.add_child(gem_gate)
	var affordability_seal = make_gpt_gate(rect_full(0.420, 0.050, 0.470, 0.950), Color(accent.r, accent.g, accent.b, 0.18))
	affordability_seal.name = "ShopTransactionAffordabilitySeal"
	art.add_child(affordability_seal)
	var affordability_glyph = make_label(affordability_seal, "可" if affordable else "缺", 7, Color(0.98, 0.92, 0.66, 0.78), true)
	affordability_glyph.name = "ShopTransactionAffordabilityGlyph"
	apply_rect(affordability_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var min_cost_ratio = clamp(float(min_cost) / 100.0, 0.16, 0.92)
	var min_cost_left = 0.060 + 0.345 * min_cost_ratio
	var min_cost_marker = make_gpt_gate(rect_full(min_cost_left - 0.010, 0.075, min_cost_left + 0.010, 0.925), Color(0.98, 0.82, 0.42, 0.18))
	min_cost_marker.name = "ShopTransactionMinCostMarker"
	art.add_child(min_cost_marker)
	var item_count = max(1, ITEM_TYPES.size())
	for i in range(item_count):
		var left = 0.455 + float(i) * (0.240 / float(max(1, item_count - 1)))
		var node = make_gpt_gate(rect_full(left - 0.017, 0.180, left + 0.017, 0.820), Color(accent.r, accent.g, accent.b, 0.24 if affordable else 0.12))
		node.name = "ShopTransactionItemNode_%d" % i
		art.add_child(node)
	var settlement_route = make_gpt_route_rail(rect_full(0.710, 0.420, 0.940, 0.580), Color(0.006, 0.016, 0.018, 0.54))
	settlement_route.name = "ShopTransactionSettlementRoute"
	art.add_child(settlement_route)
	var settlement_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.850 if affordable else 0.360, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	settlement_fill.name = "ShopTransactionSettlementFill"
	settlement_route.add_child(settlement_fill)
	var settlement_gate = make_gpt_gate(rect_full(0.928, 0.180, 0.970, 0.820), Color(accent.r, accent.g, accent.b, 0.18 if affordable else 0.10))
	settlement_gate.name = "ShopTransactionSettlementGate"
	art.add_child(settlement_gate)
	var reserve_route = make_gpt_route_rail(rect_full(0.505, 0.050, 0.675, 0.210), Color(0.006, 0.016, 0.018, 0.38))
	reserve_route.name = "ShopTransactionReserveRoute"
	art.add_child(reserve_route)
	var reserve_ratio := 0.0 if gems <= 0 else clampf(float(gems) / float(max(1, min_cost * 4)), 0.0, 1.0)
	var reserve_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * reserve_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	reserve_fill.name = "ShopTransactionReserveFill"
	reserve_route.add_child(reserve_fill)
	var reserve_gate = make_gpt_gate(rect_full(0.665, 0.010, 0.692, 0.255), Color(accent.r, accent.g, accent.b, 0.18 if affordable else 0.10))
	reserve_gate.name = "ShopTransactionReserveGate"
	art.add_child(reserve_gate)
	for i in range(2):
		var reserve_tick = make_gpt_tick_strip(rect_full(0.545 + float(i) * 0.050, 0.000, 0.557 + float(i) * 0.050, 0.255), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.040 if affordable else 0.10))
		reserve_tick.name = "ShopTransactionReserveTick_0"
		art.add_child(reserve_tick)
	for i in range(4):
		var left_tick = 0.135 + float(i) * 0.070
		var tick = make_gpt_tick_strip(rect_full(left_tick, 0.235, left_tick + 0.012, 0.765), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.030))
		tick.name = "ShopTransactionGemTick_0"
		art.add_child(tick)
	for i in range(3):
		var left_tick = 0.765 + float(i) * 0.050
		var tick_2 = make_gpt_tick_strip(rect_full(left_tick, 0.245, left_tick + 0.014, 0.755), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035 if affordable else 0.11))
		tick_2.name = "ShopTransactionSettlementTick_0"
		art.add_child(tick_2)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(gem_fill, "modulate:a", 0.38, 0.82).from(0.92)
		tw.tween_property(gem_fill, "modulate:a", 0.92, 0.82).from(0.38)
	return art


func draw_stat_row_art(parent: Control, label_text: String, value_text: String) -> Control:
	# r210: GPT chrome conversion
	var accent = stat_row_accent(label_text)
	var art = Control.new()
	art.name = "StatsRowArt_%s" % label_text
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var row_depth = make_gpt_plate_rect(rect_full(0.006, 0.220, 0.994, 0.985), Color(0.0, 0.0, 0.0, 0.34), "ui_button_face_plate")
	row_depth.name = "StatsRow3DDepthEdge_%s" % label_text
	art.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.095), Color(1.0, 0.90, 0.58, 0.040))
	row_top_rim.name = "StatsRow3DTopRim_%s" % label_text
	art.add_child(row_top_rim)
	var icon_plinth = make_gpt_edge_rail(rect_full(0.012, 0.120, 0.078, 0.880), Color(accent.r * 0.18, accent.g * 0.20, accent.b * 0.20, 0.66))
	icon_plinth.name = "StatsRow3DIconPlinth_%s" % label_text
	art.add_child(icon_plinth)
	var row_glow = make_gpt_meter_fill(rect_full(0.000, 0.000, 1.000, 1.000), Color(accent.r, accent.g, accent.b, 0.040))
	row_glow.name = "StatsRowReadabilityGlow_%s" % label_text
	art.add_child(row_glow)
	var stat_icon_card = make_gpt_edge_rail(rect_full(0.020, 0.180, 0.064, 0.820), Color(accent.r, accent.g, accent.b, 0.26))
	stat_icon_card.name = "StatsRowIconPanel_%s" % label_text
	art.add_child(stat_icon_card)
	add_lucide_icon(stat_icon_card, "trophy" if label_text.find("胜") >= 0 else "star", rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.94, 0.76, 0.92))
	var stat_divider = make_gpt_plate_rect(rect_full(0.505, 0.205, 0.510, 0.795), Color(accent.r, accent.g, accent.b, 0.22))
	stat_divider.name = "StatsRowValueDivider_%s" % label_text
	art.add_child(stat_divider)
	var marker = make_gpt_gate(rect_full(0.020, 0.260, 0.036, 0.740), Color(accent.r, accent.g, accent.b, 0.34))
	marker.name = "StatsRowMarker_%s" % label_text
	art.add_child(marker)
	var rail = make_gpt_route_rail(rect_full(0.330, 0.720, 0.915, 0.820), Color(0.006, 0.016, 0.018, 0.52))
	rail.name = "StatsRowRail_%s" % label_text
	art.add_child(rail)
	var fill_ratio = stat_row_metric_fraction(label_text, value_text)
	var fill = make_gpt_meter_fill(rect_full(0.018, 0.240, 0.018 + 0.944 * fill_ratio, 0.760), Color(accent.r, accent.g, accent.b, 0.42))
	fill.name = "StatsRowFill_%s" % label_text
	rail.add_child(fill)
	var trend_route = make_gpt_route_rail(rect_full(0.650, 0.255, 0.905, 0.335), Color(0.006, 0.016, 0.018, 0.40))
	trend_route.name = "StatsRowTrendRoute_%s" % label_text
	art.add_child(trend_route)
	var trend_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	trend_fill.name = "StatsRowTrendFill_%s" % label_text
	trend_route.add_child(trend_fill)
	var trend_gate = make_gpt_gate(rect_full(0.885, 0.185, 0.925, 0.390), Color(accent.r, accent.g, accent.b, 0.22))
	trend_gate.name = "StatsRowTrendGate_%s" % label_text
	art.add_child(trend_gate)
	var value_route = make_gpt_route_rail(rect_full(0.515, 0.470, 0.905, 0.540), Color(0.006, 0.016, 0.018, 0.36))
	value_route.name = "StatsRowValueRoute_%s" % label_text
	art.add_child(value_route)
	var value_fill = make_gpt_meter_fill(rect_full(0.000, 0.000, 0.420 + 0.520 * fill_ratio, 1.000), Color(accent.r, accent.g, accent.b, 0.20))
	value_fill.name = "StatsRowValueFill_%s" % label_text
	value_route.add_child(value_fill)
	var value_gate = make_gpt_gate(rect_full(0.890, 0.405, 0.925, 0.635), Color(accent.r, accent.g, accent.b, 0.20))
	value_gate.name = "StatsRowValueGate_%s" % label_text
	art.add_child(value_gate)
	for i in range(3):
		var left = 0.365 + float(i) * 0.075
		var lit = fill_ratio >= 0.25 + float(i) * 0.24
		var node = make_gpt_gate(rect_full(left, 0.255, left + 0.022, 0.455), Color(accent.r, accent.g, accent.b, 0.34 if lit else 0.12))
		node.name = "StatsRowNode_%s_%d" % [label_text, i]
		art.add_child(node)
	var value_tick = add_gpt_tick_strip(art, rect_full(0.565, 0.585, (0.565) + float(1) * (0.060) + (0.018), 0.705), Color(accent.r, accent.g, accent.b, 0.20), "StatsRowValueTick_%s_0" % [label_text])
	var tick = add_gpt_tick_strip(art, rect_full(0.705, 0.450, (0.705) + float(1) * (0.055) + (0.018), 0.580), Color(accent.r, accent.g, accent.b, 0.22), "StatsRowTrendTick_%s_0" % [label_text])
	var insight_bridge = make_gpt_route_rail(rect_full(0.620, 0.365, 0.805, 0.425), Color(0.006, 0.016, 0.018, 0.34))
	insight_bridge.name = "StatsRowInsightBridge_%s" % label_text
	art.add_child(insight_bridge)
	var insight_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.18))
	insight_fill.name = "StatsRowInsightFill_%s" % label_text
	insight_bridge.add_child(insight_fill)
	var insight_gate = make_gpt_gate(rect_full(0.790, 0.330, 0.824, 0.475), Color(accent.r, accent.g, accent.b, 0.18))
	insight_gate.name = "StatsRowInsightGate_%s" % label_text
	art.add_child(insight_gate)
	var insight_tick = add_gpt_tick_strip(art, rect_full(0.660, 0.325, (0.674) + float(1) * (0.060), 0.485), Color(accent.r, accent.g, accent.b, 0.18), "StatsRowInsightTick_%s_0" % label_text)
	var focus = make_gpt_gate(rect_full(0.925, 0.245, 0.962, 0.755), Color(accent.r, accent.g, accent.b, 0.12))
	focus.name = "StatsRowFocus_%s" % label_text
	art.add_child(focus)
	return art


func make_stats_summary_chip(parent: Control, chip_id: String, caption_text: String, value_text: String, rect: Rect2, accent: Color) -> Control:
	# r205: GPT-only summary chips (no program panel chrome)
	var chip = make_gpt_plate_rect(rect, Color(0.026, 0.044, 0.042, 0.86), "ui_menu_card_face")
	chip.name = "StatsSummaryChip_%s" % chip_id
	var display_value := value_text
	var unit_text := "状态"
	for suffix in ["%", "番/局", "分/局", "局", "番", "分"]:
		if display_value.ends_with(suffix):
			display_value = display_value.trim_suffix(suffix)
			unit_text = suffix
			break
	chip.set_meta("summary_caption", caption_text)
	chip.set_meta("summary_value", display_value)
	chip.set_meta("summary_unit", unit_text)
	chip.set_meta("summary_structure", "caption/value/unit")
	parent.add_child(chip)
	var chip_depth = make_gpt_plate_rect(rect_full(0.020, 0.600, 0.980, 0.965), Color(0.0, 0.0, 0.0, 0.34), "ui_dark_scrim")
	chip_depth.name = "StatsSummary3DDepthEdge_%s" % chip_id
	chip.add_child(chip_depth)
	var chip_top_rim = make_gpt_ribbon(rect_full(0.055, 0.045, 0.945, 0.125), Color(1.0, 0.90, 0.58, 0.08))
	chip_top_rim.name = "StatsSummary3DTopRim_%s" % chip_id
	chip.add_child(chip_top_rim)
	var value_label = make_label(chip, display_value, 20, Color(1.0, 0.93, 0.66), true)
	value_label.name = "StatsSummaryValue_%s" % chip_id
	apply_rect(value_label, rect_full(0.095, 0.100, 0.650, 0.610))
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(value_label)
	value_label.set_meta("summary_role", "value")
	value_label.set_meta("summary_full_value", value_text)
	fit_label_font_size(value_label, maxf(54.0, rect.size.x * effective_viewport_size().x * 0.56), 20, 12)
	var unit_label := make_label(chip, unit_text, 11, Color(0.84, 0.94, 0.86), true)
	unit_label.name = "StatsSummaryUnit_%s" % chip_id
	apply_rect(unit_label, rect_full(0.660, 0.150, 0.925, 0.470))
	unit_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	unit_label.set_meta("summary_role", "unit")
	fit_label_font_size(unit_label, maxf(34.0, rect.size.x * effective_viewport_size().x * 0.26), 11, 8)
	set_ui_full_text(unit_label, unit_text, "统计单位：" + unit_text)
	var caption_label = make_label(chip, caption_text, 11, Color(0.84, 0.94, 0.86), false)
	caption_label.name = "StatsSummaryCaption_%s" % chip_id
	apply_rect(caption_label, rect_full(0.095, 0.605, 0.925, 0.915))
	caption_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(caption_label)
	caption_label.set_meta("summary_role", "caption")
	fit_label_font_size(caption_label, maxf(64.0, rect.size.x * effective_viewport_size().x * 0.72), 11, 8)
	var rail = make_gpt_edge_rail(rect_full(0.045, 0.180, 0.066, 0.820), Color(accent.r, accent.g, accent.b, 0.42))
	rail.name = "StatsSummaryRail_%s" % chip_id
	chip.add_child(rail)
	mark_ui_optimization(chip, "F-229")
	return chip


func draw_stats_dashboard_art(parent: Control) -> Control:
	var source: Dictionary = game_stats
	if parent != null and parent.has_meta("stats_source"):
		var meta_source = parent.get_meta("stats_source", {})
		if typeof(meta_source) == TYPE_DICTIONARY:
			source = (meta_source as Dictionary).duplicate(true)
	# r205: compact GPT-led dashboard; dead post-return chrome removed
	var dash = make_gpt_plate_rect(rect_full(0.08, 0.120, 0.92, 0.300), Color(0.014, 0.034, 0.040, 0.88), "stats_gpt_dashboard")
	dash.name = "StatsDashboardArt"
	parent.add_child(dash)
	var dashboard_depth = make_gpt_plate_rect(rect_full(0.010, 0.705, 0.990, 0.985), Color(0.0, 0.0, 0.0, 0.34), "ui_dark_scrim")
	dashboard_depth.name = "StatsDashboard3DDepthEdge"
	dash.add_child(dashboard_depth)
	var dashboard_top_rim = make_gpt_ribbon(rect_full(0.025, 0.020, 0.975, 0.065), Color(1.0, 0.88, 0.52, 0.08))
	dashboard_top_rim.name = "StatsDashboard3DTopRim"
	dash.add_child(dashboard_top_rim)
	var stats_texture = add_illustration_texture(dash, "stats_dashboard_grid", rect_full(0.010, 0.035, 0.990, 0.965), 0.12, false)
	if stats_texture != null:
		stats_texture.name = "StatsDashboardGridTexture"
		dash.move_child(stats_texture, 0)
	var winrate_texture = add_optional_gpt_illustration_texture(dash, "stats_winrate_scroll", rect_full(0.010, 0.080, 0.215, 0.920), 0.18, false)
	if winrate_texture != null:
		winrate_texture.name = "StatsWinrateScrollTexture"
		dash.move_child(winrate_texture, min(1, dash.get_child_count() - 1))
	var stats_gpt_dash = add_optional_gpt_illustration_texture(dash, "stats_gpt_dashboard", rect_full(0.0, 0.0, 1.0, 1.0), 0.22, false)
	if stats_gpt_dash != null:
		stats_gpt_dash.name = "StatsDashboardGptPlate"
		dash.move_child(stats_gpt_dash, 0)
	var stats_gpt_strip = add_optional_gpt_illustration_texture(dash, "ui_progress_signal_strip", rect_full(0.02, 0.01, 0.98, 0.10), 0.40, false)
	if stats_gpt_strip != null:
		stats_gpt_strip.name = "StatsDashboardGptStrip"
	var stats_gpt_meter = add_optional_gpt_illustration_texture(dash, "ui_meter_rail_plate", rect_full(0.24, 0.82, 0.96, 0.94), 0.36, false)
	if stats_gpt_meter != null:
		stats_gpt_meter.name = "StatsDashboardGptMeter"
	var games_count = int(source.get("games", source.get("games_played", 0)))
	var wins_count = int(source.get("wins", source.get("games_won", 0)))
	var compact_win_rate := 0.0 if games_count <= 0 else clampf(float(wins_count) / float(games_count), 0.0, 1.0)
	var best_score_value = int(source.get("best_score", source.get("score", 0)))
	var total_score_value = int(source.get("score", source.get("total_score", 0)))
	var average_score_value := 0 if games_count <= 0 else int(round(float(total_score_value) / float(games_count)))
	var average_fan_value := 0 if games_count <= 0 else int(round(float(source.get("fan_total", source.get("total_fan", 0))) / float(games_count)))
	var trend_text := "待开局"
	if games_count > 0:
		trend_text = "顺风" if compact_win_rate >= 0.55 else ("稳守" if compact_win_rate >= 0.35 else "蓄势")
	var narrative_panel = make_gpt_plate_rect(rect_full(0.030, 0.145, 0.215, 0.800), Color(0.018, 0.038, 0.036, 0.88), "ui_jade_reading_plate")
	narrative_panel.name = "StatsSummaryNarrativePanel"
	dash.add_child(narrative_panel)
	var narrative_rail = make_gpt_edge_rail(rect_full(0.055, 0.160, 0.082, 0.835), Color(0.72, 0.56, 0.32, 0.40))
	narrative_rail.name = "StatsSummaryNarrativeRail"
	narrative_panel.add_child(narrative_rail)
	var narrative_title = make_label(narrative_panel, "战绩", 10, Color(0.84, 0.94, 0.86), false)
	narrative_title.name = "StatsSummaryNarrativeTitle"
	apply_rect(narrative_title, rect_full(0.150, 0.095, 0.900, 0.345))
	narrative_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_title)
	var narrative_body_text := "待开局"
	if games_count > 0:
		if compact_win_rate >= 0.55:
			narrative_body_text = "顺风"
		elif compact_win_rate >= 0.35:
			narrative_body_text = "稳守"
		else:
			narrative_body_text = "蓄势"
	var narrative_body = make_label(narrative_panel, narrative_body_text, 18, Color(1.0, 0.93, 0.66), true)
	narrative_body.name = "StatsSummaryNarrativeBody"
	apply_rect(narrative_body, rect_full(0.150, 0.300, 0.900, 0.660))
	narrative_body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_body)
	var narrative_meta_text := "暂无对局 · 胜率未计算" if games_count <= 0 else "%d胜/%d局 · 胜率%d%%" % [wins_count, games_count, int(round(compact_win_rate * 100.0))]
	var narrative_meta = make_label(narrative_panel, narrative_meta_text, 9, Color(0.72, 0.84, 0.72), false)
	narrative_meta.name = "StatsSummaryNarrativeMeta"
	apply_rect(narrative_meta, rect_full(0.150, 0.655, 0.900, 0.910))
	narrative_meta.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(narrative_meta)
	# The dashboard owns trend and per-round context; the rows below own exact
	# totals and peaks, so the first viewport does not print the same metrics twice.
	make_stats_summary_chip(dash, "winrate", "走势", trend_text, rect_full(0.235, 0.145, 0.405, 0.800), Color(0.78, 0.62, 0.36))
	make_stats_summary_chip(dash, "games", "场均番", "%d番/局" % average_fan_value, rect_full(0.425, 0.145, 0.595, 0.800), Color(0.58, 0.70, 0.62))
	make_stats_summary_chip(dash, "best", "场均净分", "%s分/局" % compact_score_text(average_score_value), rect_full(0.615, 0.145, 0.895, 0.800), Color(0.82, 0.66, 0.32))
	var stats_hint_text := "摘要等待首局 · 下方明细会显示完整数值" if games_count <= 0 else "摘要显示走势与场均 · 下方明细显示总量与峰值"
	var stats_hint = make_label(dash, stats_hint_text, 13, Color(0.76, 0.88, 0.78), false)
	stats_hint.name = "StatsSummaryHint"
	apply_rect(stats_hint, rect_full(0.235, 0.805, 0.895, 0.955))
	stats_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(stats_hint)
	stats_hint.set_meta("sample_count", games_count)
	stats_hint.set_meta("time_scope", "累计")
	stats_hint.set_meta("zero_state", games_count <= 0)
	stats_hint.set_meta("summary_reading_policy", "trend_and_per_round_context_then_exact_detail_rows")
	set_ui_full_text(stats_hint, stats_hint_text, "统计摘要说明：" + stats_hint_text)
	mark_ui_optimization(stats_hint, "F-092")
	if games_count <= 0:
		draw_stats_empty_state_art(dash)
	return dash


func draw_stats_data_scan_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "StatsDataScanArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.080, 0.112, 0.920, 0.330))
	parent.add_child(art)
	var accent = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.245, 0.070, 0.700), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "StatsDataScanSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.070, 0.440, 0.920, 0.535), Color(0.006, 0.016, 0.018, 0.44))
	route.name = "StatsDataScanRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.760, 0.740), Color(accent.r, accent.g, accent.b, 0.28))
	fill.name = "StatsDataScanFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.895, 0.320, 0.955, 0.665), Color(0.92, 0.72, 0.34, 0.20))
	gate.name = "StatsDataScanGate"
	art.add_child(gate)
	var archive = make_gpt_plate_rect(rect_full(0.790, 0.620, 0.900, 0.875), Color(0.92, 0.72, 0.34, 0.13), "ui_jade_reading_plate")
	archive.name = "StatsDataScanArchive"
	art.add_child(archive)
	var glyph = make_label(archive, "绩", 8, Color(0.98, 0.92, 0.66, 0.84), true)
	glyph.name = "StatsDataScanGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(4):
		var left = 0.165 + float(i) * 0.180
		var node = make_gpt_gate(rect_full(left, 0.315, left + 0.026, 0.645), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.028))
		node.name = "StatsDataScanNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.330, 0.205, (0.330) + float(2) * (0.135) + (0.014), 0.760), Color(accent.r, accent.g, accent.b, 0.24), "StatsDataScanTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.86
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "anchor_right", 0.980, 1.05).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.52).from(0.94)
		tw.tween_property(fill, "anchor_right", 0.760, 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.94, 0.52).from(0.48)
	return art


func draw_stats_empty_state_art(parent: Control) -> Control:
	var empty = Control.new()
	empty.name = "StatsEmptyStateArt"
	empty.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(empty, rect_full(0.212, 0.545, 0.640, 0.925))
	parent.add_child(empty)
	var empty_label = make_label(empty, "暂无对局记录", 15, Color(0.88, 0.84, 0.64, 0.82), true)
	apply_rect(empty_label, rect_full(0.050, 0.280, 0.950, 0.720))
	return empty


func draw_stats_insight_convergence_art(parent: Control) -> Control:
	# r210: GPT chrome conversion
	var source: Dictionary = game_stats
	if parent != null and parent.has_meta("stats_source"):
		var meta_source = parent.get_meta("stats_source", {})
		if typeof(meta_source) == TYPE_DICTIONARY:
			source = (meta_source as Dictionary).duplicate(true)
	var games_played := maxi(0, int(source.get("games", source.get("games_played", 0))))
	var wins_played := maxi(0, int(source.get("wins", source.get("games_won", 0))))
	var win_rate := 0.0 if games_played <= 0 else clampf(float(wins_played) / float(games_played), 0.0, 1.0)
	var best_score := maxi(0, int(source.get("best_score", source.get("score", 0))))
	var games_fill := 0.0 if games_played <= 0 else clampf(float(games_played) / 20.0, 0.0, 1.0)
	var best_score_strength := 0.0 if best_score <= 0 else clampf(float(best_score) / 12000.0, 0.0, 1.0)
	var summary_score := 0.0 if games_played <= 0 else clampf((win_rate + games_fill + best_score_strength) / 3.0, 0.0, 1.0)
	var art = Control.new()
	art.name = "StatsInsightConvergenceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.430, 0.125, 0.915, 0.318))
	parent.add_child(art)
	var gold = Color(0.88, 0.70, 0.32)
	var jade = Color(0.72, 0.56, 0.32)
	var source_node = make_gpt_edge_rail(rect_full(0.020, 0.270, 0.088, 0.700), Color(jade.r, jade.g, jade.b, 0.16 + summary_score * 0.08))
	source_node.name = "StatsInsightSource"
	art.add_child(source_node)
	var route = make_gpt_route_rail(rect_full(0.085, 0.430, 0.870, 0.550), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "StatsInsightRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * summary_score, 0.750), Color(jade.r, jade.g, jade.b, 0.24))
	fill.name = "StatsInsightFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.835, 0.280, 0.920, 0.730), Color(gold.r, gold.g, gold.b, 0.15 + summary_score * 0.10))
	gate.name = "StatsInsightGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.700, 0.065, 0.820, 0.350), Color(gold.r, gold.g, gold.b, 0.13 + summary_score * 0.08))
	seal.name = "StatsInsightSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "析", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "StatsInsightGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_gpt_route_rail(rect_full(0.230, 0.695, 0.780, 0.825), Color(0.006, 0.016, 0.018, 0.34))
	archive_route.name = "StatsInsightArchiveRoute"
	art.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.030 + 0.730 * summary_score, 0.750), Color(gold.r, gold.g, gold.b, 0.18))
	archive_fill.name = "StatsInsightArchiveFill"
	archive_route.add_child(archive_fill)
	var archive_gate = make_gpt_gate(rect_full(0.755, 0.625, 0.835, 0.905), Color(jade.r, jade.g, jade.b, 0.13 + summary_score * 0.06))
	archive_gate.name = "StatsInsightArchiveGate"
	art.add_child(archive_gate)
	var strengths = [win_rate, games_fill, best_score_strength]
	for i in range(strengths.size()):
		var strength := clampf(float(strengths[i]), 0.0, 1.0)
		var left = 0.225 + float(i) * 0.170
		var node = make_gpt_gate(rect_full(left, 0.300, left + 0.030, 0.665), Color(gold.r, gold.g, gold.b, 0.10 + strength * 0.14))
		node.name = "StatsInsightNode_%d" % i
		art.add_child(node)
		var branch = make_gpt_edge_rail(rect_full(left + 0.012, 0.120, left + 0.020, 0.315), Color(jade.r, jade.g, jade.b, 0.08 + strength * 0.10))
		branch.name = "StatsInsightBranch_%d" % i
		art.add_child(branch)
	var tick = add_gpt_tick_strip(art, rect_full(0.585, 0.180, (0.600) + float(2) * (0.060), 0.420), Color(jade.r, jade.g, jade.b, 0.22), "StatsInsightTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.36, 0.72).from(0.90)
		tw.parallel().tween_property(archive_fill, "modulate:a", 0.34, 0.72).from(0.84)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.72).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.90, 0.72).from(0.36)
		tw.parallel().tween_property(archive_fill, "modulate:a", 0.84, 0.72).from(0.34)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.72).from(0.58)
	return art


func draw_stats_mastery_route(parent: Control, win_rate: float, games_fill: float, best_score_strength: float, summary_score: float) -> Control:
	var mastery = Control.new()
	mastery.name = "StatsMasteryRoute"
	mastery.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(mastery, rect_full(0.185, 0.565, 0.665, 0.705))
	parent.add_child(mastery)
	var accent = Color(0.74, 0.64, 0.36)
	var rail = make_gpt_route_rail(rect_full(0.050, 0.435, 0.940, 0.565), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "StatsMasteryRail"
	mastery.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.920 * summary_score, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	fill.name = "StatsMasteryFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.245, 0.075, 0.755), Color(0.72, 0.56, 0.32, 0.18 + win_rate * 0.10))
	source.name = "StatsMasterySource"
	mastery.add_child(source)
	var gate = make_gpt_gate(rect_full(0.900, 0.205, 0.965, 0.795), Color(0.96, 0.82, 0.42, 0.16 + summary_score * 0.12))
	gate.name = "StatsMasteryGate"
	mastery.add_child(gate)
	var metric_strengths = [win_rate, games_fill, best_score_strength]
	for i in range(metric_strengths.size()):
		var strength := clampf(float(metric_strengths[i]), 0.0, 1.0)
		var left = 0.190 + float(i) * 0.235
		var node = make_gpt_tick_strip(rect_full(left, 0.165, left + 0.038, 0.835), Color(accent.r, accent.g, accent.b, 0.12 + strength * 0.20))
		node.name = "StatsMasteryNode_%d" % i
		mastery.add_child(node)
		var branch = make_gpt_edge_rail(rect_full(left + 0.016, 0.035, left + 0.026, 0.230), Color(0.72, 0.56, 0.32, 0.10 + strength * 0.12))
		branch.name = "StatsMasteryBranch_%d" % i
		mastery.add_child(branch)
	var tick = add_gpt_tick_strip(mastery, rect_full(0.360, 0.265, (0.360) + float(3) * (0.085) + (0.014), 0.720), Color(accent.r, accent.g, accent.b, 0.22), "StatsMasteryTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.42, 0.78).from(0.92)
		tw.parallel().tween_property(gate, "modulate:a", 0.50, 0.78).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.92, 0.78).from(0.42)
		tw.parallel().tween_property(gate, "modulate:a", 0.90, 0.78).from(0.50)
	return mastery

func draw_stats_row_summary_bus_art(parent: Control) -> Control:
	# r208: GPT chrome conversion
	var art = Control.new()
	art.name = "StatsRowSummaryBusArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.080, 0.330, 0.920, 0.930))
	parent.add_child(art)
	parent.move_child(art, max(0, art.get_index() - 1))
	var accent = Color(0.72, 0.56, 0.32)
	var gold = Color(0.86, 0.68, 0.32)
	var spine = make_gpt_edge_rail(rect_full(0.955, 0.035, 0.982, 0.900), Color(0.006, 0.016, 0.018, 0.42))
	spine.name = "StatsRowSummarySpine"
	art.add_child(spine)
	var spine_fill = make_gpt_meter_fill(rect_full(0.250, 0.025, 0.750, 0.820), Color(accent.r, accent.g, accent.b, 0.24))
	spine_fill.name = "StatsRowSummarySpineFill"
	spine.add_child(spine_fill)
	var source = make_gpt_gate(rect_full(0.925, 0.015, 0.995, 0.110), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "StatsRowSummarySource"
	art.add_child(source)
	var archive_gate = make_gpt_gate(rect_full(0.910, 0.845, 0.995, 0.955), Color(gold.r, gold.g, gold.b, 0.18))
	archive_gate.name = "StatsRowSummaryArchiveGate"
	art.add_child(archive_gate)
	var archive_glyph = make_label(archive_gate, "总", 9, Color(0.98, 0.92, 0.66, 0.86), true)
	archive_glyph.name = "StatsRowSummaryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(6):
		var top = 0.070 + float(i) * 0.147
		var branch = make_gpt_route_rail(rect_full(0.760, top + 0.032, 0.960, top + 0.062), Color(0.006, 0.016, 0.018, 0.34))
		branch.name = "StatsRowSummaryBranch_%d" % i
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.700 + float(i % 3) * 0.080, 0.750), Color(accent.r, accent.g, accent.b, 0.18))
		branch_fill.name = "StatsRowSummaryBranchFill_%d" % i
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(0.736, top, 0.780, top + 0.095), Color(gold.r, gold.g, gold.b, 0.18 + float(i % 2) * 0.035))
		node.name = "StatsRowSummaryNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.970, 0.180, 0.985, (0.180) + float(3) * (0.150) + (0.060)), Color(accent.r, accent.g, accent.b, 0.22), "StatsRowSummaryTick_0")
	var insight_route = make_gpt_route_rail(rect_full(0.525, 0.895, 0.925, 0.945), Color(0.006, 0.016, 0.018, 0.38))
	insight_route.name = "StatsRowSummaryInsightRoute"
	art.add_child(insight_route)
	var insight_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(gold.r, gold.g, gold.b, 0.20))
	insight_fill.name = "StatsRowSummaryInsightFill"
	insight_route.add_child(insight_fill)
	var insight_gate = make_gpt_gate(rect_full(0.505, 0.855, 0.555, 0.985), Color(gold.r, gold.g, gold.b, 0.16))
	insight_gate.name = "StatsRowSummaryInsightGate"
	art.add_child(insight_gate)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.820 + float(i) * 0.040, 0.946, 0.842 + float(i) * 0.040, 0.984), Color(gold.r, gold.g, gold.b, 0.20 - float(i) * 0.040))
		pip.name = "StatsRowSummaryArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(spine_fill, "modulate:a", 0.38, 0.82).from(0.86)
		tw.parallel().tween_property(insight_fill, "modulate:a", 0.34, 0.82).from(0.82)
		tw.tween_property(spine_fill, "modulate:a", 0.86, 0.82).from(0.38)
		tw.parallel().tween_property(insight_fill, "modulate:a", 0.82, 0.82).from(0.34)
	return art


func draw_summary_victory_ribbon(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var ribbon = Control.new()
	ribbon.name = "SummaryVictoryRibbon"
	ribbon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(ribbon, rect_full(0.105, 0.055, 0.305, 0.145))
	parent.add_child(ribbon)
	var ribbon_body = make_gpt_ribbon(rect_full(0.08, 0.20, 0.92, 0.80), Color(0.58, 0.12, 0.08, 0.58))
	ribbon.add_child(ribbon_body)
	# Gold foil shimmer on ribbon body
	if shader_materials.has("gold_foil_shimmer"):
		var gold_overlay = make_fullrect_overlay(Color(0.92, 0.78, 0.38, 0.35), "ui_soft_flash")
		gold_overlay.name = "SummaryRibbonGoldFoil"
		gold_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
		gold_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
		apply_gold_foil_shader(gold_overlay, 0.6, 0.5)
		ribbon_body.add_child(gold_overlay)
	var left_tail = make_gpt_plate_rect(rect_full(0.00, 0.30, 0.16, 0.70), Color(0.42, 0.08, 0.06, 0.54))
	left_tail.name = "SummaryRibbonLeftTail"
	ribbon.add_child(left_tail)
	var right_tail = make_gpt_plate_rect(rect_full(0.84, 0.30, 1.00, 0.70), Color(0.42, 0.08, 0.06, 0.54))
	right_tail.name = "SummaryRibbonRightTail"
	ribbon.add_child(right_tail)
	add_lucide_icon(ribbon, "trophy", rect_full(0.44, 0.08, 0.56, 0.92), Color(0.98, 0.86, 0.46, 0.86))
	return ribbon


func draw_table_action_readiness_convergence(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "TableActionReadinessConvergence"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var positions := [
		Vector2(0.500, 0.815),
		Vector2(0.812, 0.505),
		Vector2(0.500, 0.205),
		Vector2(0.188, 0.505),
	]
	var seat = clamp(get_current_seat(), 0, 3)
	var seat_pos: Vector2 = positions[seat]
	var center := Vector2(0.500, 0.500)
	var action_pos := Vector2(0.500, 0.930) if seat == 0 else seat_pos.lerp(center, 0.260)
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var active = can_self_discard() or (mode == "offline" and offline_phase == "pending_claim")
	var source = make_gpt_plate_rect(rect_full(seat_pos.x - 0.022, seat_pos.y - 0.038, seat_pos.x + 0.022, seat_pos.y + 0.038), Color(accent.r, accent.g, accent.b, 0.22), "ui_jade_reading_plate")
	source.name = "TableActionReadinessSource"
	art.add_child(source)
	var route = Control.new()
	route.name = "TableActionReadinessRoute"
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if abs(seat_pos.x - center.x) >= abs(seat_pos.y - center.y):
		apply_rect(route, rect_full(min(seat_pos.x, center.x), center.y - 0.005, max(seat_pos.x, center.x), center.y + 0.005))
	else:
		apply_rect(route, rect_full(center.x - 0.005, min(seat_pos.y, center.y), center.x + 0.005, max(seat_pos.y, center.y)))
	art.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.020, 0.200, 0.880 if active else 0.520, 0.800), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.13))
	route_fill.name = "TableActionReadinessFill"
	route.add_child(route_fill)
	var hub = make_gpt_gate(rect_full(0.462, 0.462, 0.538, 0.538), Color(accent.r, accent.g, accent.b, 0.12))
	hub.name = "TableActionReadinessHub"
	art.add_child(hub)
	var gate = make_gpt_gate(rect_full(action_pos.x - 0.020, action_pos.y - 0.040, action_pos.x + 0.020, action_pos.y + 0.040), Color(accent.r, accent.g, accent.b, 0.20 if active else 0.10))
	gate.name = "TableActionReadinessGate"
	art.add_child(gate)
	var action_route = Control.new()
	action_route.name = "TableActionReadinessActionRoute"
	action_route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if abs(action_pos.x - center.x) >= abs(action_pos.y - center.y):
		apply_rect(action_route, rect_full(min(action_pos.x, center.x), action_pos.y - 0.005, max(action_pos.x, center.x), action_pos.y + 0.005))
	else:
		apply_rect(action_route, rect_full(action_pos.x - 0.005, min(action_pos.y, center.y), action_pos.x + 0.005, max(action_pos.y, center.y)))
	art.add_child(action_route)
	var action_fill = make_gpt_meter_fill(rect_full(0.020, 0.200, 0.860 if active else 0.440, 0.800), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.10))
	action_fill.name = "TableActionReadinessActionFill"
	action_route.add_child(action_fill)
	var seal = make_gpt_gate(rect_full(action_pos.x - 0.046, action_pos.y - 0.018, action_pos.x + 0.046, action_pos.y + 0.055), Color(0.92, 0.72, 0.34, 0.13 if active else 0.07))
	seal.name = "TableActionReadinessSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "备" if active else "候", 8, Color(0.98, 0.92, 0.70, 0.82 if active else 0.48), true)
	glyph.name = "TableActionReadinessGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var t = 0.240 + float(i) * 0.190
		var tick_pos = seat_pos.lerp(center, t)
		var tick = make_gpt_tick_strip(rect_full(tick_pos.x - 0.007, tick_pos.y - 0.026, tick_pos.x + 0.007, tick_pos.y + 0.026), Color(accent.r, accent.g, accent.b, 0.21 - float(i) * 0.035))
		tick.name = "TableActionReadinessTick_0"
		art.add_child(tick)
	for i in range(2):
		var t = 0.360 + float(i) * 0.220
		var tick_pos = center.lerp(action_pos, t)
		var tick_2 = make_gpt_tick_strip(rect_full(tick_pos.x - 0.007, tick_pos.y - 0.026, tick_pos.x + 0.007, tick_pos.y + 0.026), Color(accent.r, accent.g, accent.b, 0.19 - float(i) * 0.040))
		tick_2.name = "TableActionReadinessActionTick_0"
		art.add_child(tick_2)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(action_pos.x + 0.024 + float(i) * 0.018, action_pos.y + 0.034, action_pos.x + 0.036 + float(i) * 0.018, action_pos.y + 0.064), Color(accent.r, accent.g, accent.b, 0.17 - float(i) * 0.035))
		pip.name = "TableActionReadinessPip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		route_fill.modulate.a = 0.78
		action_fill.modulate.a = 0.72
		hub.modulate.a = 0.68
	return art


func draw_table_atmosphere_frame(parent: Control) -> Control:
	# Keep the named atmosphere anchors for layout/smoke probes, but let the
	# single battle backdrop own the table surface instead of repainting a second
	# full-size texture stack beneath the board.
	var frame = Control.new()
	frame.name = "TableAtmosphereFrame"
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(frame)
	var inset_shadow = make_layout_host(rect_full(0.052, 0.080, 0.948, 0.920))
	inset_shadow.name = "Table3DInsetShadow"
	frame.add_child(inset_shadow)
	var felt_vignette = make_layout_host(rect_full(0.145, 0.175, 0.855, 0.805))
	felt_vignette.name = "Table3DFeltVignette"
	frame.add_child(felt_vignette)
	var near_highlight = make_layout_host(rect_full(0.145, 0.755, 0.855, 0.820))
	near_highlight.name = "Table3DNearRimHighlight"
	frame.add_child(near_highlight)
	var far_rim = make_layout_host(rect_full(0.160, 0.120, 0.840, 0.168))
	far_rim.name = "Table3DFarRimHighlight"
	frame.add_child(far_rim)
	var center_spotlight = make_layout_host(rect_full(0.300, 0.275, 0.700, 0.690))
	center_spotlight.name = "Table3DCenterSpotlight"
	frame.add_child(center_spotlight)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var glow_tw := create_screen_tween()
		glow_tw.set_loops(24)
		glow_tw.tween_property(center_spotlight, "modulate:a", 0.55, 1.8).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		glow_tw.tween_property(center_spotlight, "modulate:a", 0.82, 1.8).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	return frame

func draw_table_center_starlight(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var star = Control.new()
	star.name = "TableCenterStarlight"
	star.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(star, rect_full(0.392, 0.348, 0.608, 0.660))
	parent.add_child(star)
	var mandala = add_optional_gpt_illustration_texture(star, "center_wind_gpt_compass", rect_full(-0.180, -0.180, 1.180, 1.180), 0.12, true)
	if mandala != null:
		mandala.name = "TableCenterMandalaTexture"
		mandala.pivot_offset = Vector2(80, 80)
	# r180: GPT soft flash rings instead of program StyleBox borders.
	var glow_ring = add_optional_gpt_illustration_texture(star, "ui_soft_flash", rect_full(0.05, 0.05, 0.95, 0.95), 0.14, false)
	if glow_ring != null:
		glow_ring.name = "TableCenterGlowRing"
		glow_ring.modulate = Color(0.96, 0.82, 0.38, 0.16)
		glow_ring.pivot_offset = Vector2(60, 60)
	var inner_ring = add_optional_gpt_illustration_texture(star, "ui_soft_flash", rect_full(0.18, 0.18, 0.82, 0.82), 0.10, false)
	if inner_ring != null:
		inner_ring.name = "TableCenterInnerRing"
		inner_ring.modulate = Color(0.92, 0.76, 0.34, 0.12)
		inner_ring.pivot_offset = Vector2(40, 40)
	# 星光点 - 三层不同大小
	for i in range(8):
		var angle = float(i) * TAU / 8.0
		var radius = 0.38 if i % 3 == 0 else (0.28 if i % 3 == 1 else 0.18)
		var spark_size = 0.018 if i % 3 == 0 else (0.012 if i % 3 == 1 else 0.008)
		var center = Vector2(0.5 + cos(angle) * radius, 0.5 + sin(angle) * radius)
		var alpha = 0.32 if i % 3 == 0 else (0.22 if i % 3 == 1 else 0.16)
		var spark = make_gpt_gate(rect_full(center.x - spark_size, center.y - spark_size, center.x + spark_size, center.y + spark_size), Color(0.96, 0.78, 0.34, alpha))
		spark.name = "TableCenterStarlightSpark_%d" % i
		star.add_child(spark)
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var tw := create_screen_tween()
			tw.set_loops(48)
			var blink_dur := randf_range(0.6, 1.2)
			tw.tween_property(spark, "modulate:a", 0.12, blink_dur).from(0.92).set_delay(float(i) * 0.06)
			tw.tween_property(spark, "modulate:a", 0.92, blink_dur).from(0.12)
	# 旋转动画
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if mandala != null:
			mandala.modulate.a = 0.10
			var mandala_tw := create_screen_tween()
			mandala_tw.set_loops(48)
			mandala_tw.tween_property(mandala, "rotation", TAU, 18.0).from(0.0)
		if glow_ring != null:
			var glow_tw := create_screen_tween()
			glow_tw.set_loops(48)
			glow_tw.tween_property(glow_ring, "rotation", TAU, 12.0).from(0.0)
		if inner_ring != null:
			var inner_tw := create_screen_tween()
			inner_tw.set_loops(48)
			inner_tw.tween_property(inner_ring, "rotation", -TAU, 16.0).from(0.0)


func draw_table_corner(parent: Control, rects: Array, corner_index: int = -1) -> void:
	# r214: bulk GPT chrome sweep
	var corner_a = make_gpt_plate_rect(rects[0], TABLE_CORNER_FILL, "ui_jade_reading_plate")
	corner_a.name = "TableCornerPlateA_%d" % corner_index if corner_index >= 0 else "TableCornerPlateA"
	parent.add_child(corner_a)
	var corner_b = make_gpt_plate_rect(rects[1], TABLE_CORNER_VERTICAL_FILL, "ui_jade_reading_plate")
	corner_b.name = "TableCornerPlateB_%d" % corner_index if corner_index >= 0 else "TableCornerPlateB"
	parent.add_child(corner_b)



func draw_table_last_discard_ripple(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var seat = get_last_discard_seat()
	if seat < 0 or get_last_discard() == "":
		return
	var ripple_rect = last_discard_focus_marker_rect_for_seat(seat)
	if ripple_rect.size == Vector2.ZERO:
		return
	var ripple = Control.new()
	ripple.name = "TableLastDiscardRipple"
	ripple.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(ripple, ripple_rect)
	parent.add_child(ripple)
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	for i in range(3):
		var pad = 0.04 + float(i) * 0.12
		var ring = make_gpt_plate_rect(rect_full(-pad, -pad, 1.0 + pad, 1.0 + pad), Color(accent.r, accent.g, accent.b, 0.03), "ui_jade_reading_plate")
		ring.name = "TableLastDiscardRippleRing_%d" % i
		ripple.add_child(ring)


func draw_table_living_illustration(parent: Control) -> Control:
	var layer = Control.new()
	layer.name = "TableLivingIllustration"
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(layer)
	layer.modulate = Color(1.0, 1.0, 1.0, 0.030)
	draw_table_last_discard_ripple(layer)
	return layer

func draw_table_log(parent: Control) -> void:
	# r213: GPT chrome conversion
	var compact_log := effective_viewport_size().y <= 560.0
	# At 960x540 the response context owns the only readable left-top reserve.
	# Hide the secondary ledger for this short decision window; its complete
	# history remains available through the chat/history routes after the action.
	var hide_compact_ledger_for_pending: bool = effective_viewport_size().x <= 960.0 \
		and has_pending_claim_window() and not table_log_archive_open
	# The compact ledger sits below the side seat card, so it can grow rightward
	# without touching the side river. This gives the latest event a real reading
	# lane instead of relying on a tooltip for every long sentence.
	# Keep the ledger above the left meld lane. The history action gets its own
	# fixed-height right column so the reading surface does not cover table art.
	var ledger_right := 0.340
	var ledger_bottom := 0.235
	var ledger_rect := rect_full(0.018, 0.128, ledger_right, ledger_bottom)
	var ledger_panel = make_gpt_gate(ledger_rect, Color(0.094, 0.074, 0.048, 0.88))
	ledger_panel.name = "TableLogLedgerPanel"
	ledger_panel.visible = not hide_compact_ledger_for_pending
	parent.add_child(ledger_panel)
	var ledger_texture = add_illustration_texture(ledger_panel, "table_log_scroll", rect_full(0.010, 0.018, 0.990, 0.982), 0.075, false)
	if ledger_texture != null:
		ledger_texture.name = "TableLogLedgerTexture"
		ledger_panel.move_child(ledger_texture, 0)
		ledger_texture.modulate = Color(1, 1, 1, 0.07)
	var ledger_spine = make_gpt_edge_rail(rect_full(0.035, 0.075, 0.050, 0.915), Color(0.78, 0.56, 0.24, 0.34))
	ledger_spine.name = "TableLogLedgerSpine"
	ledger_panel.add_child(ledger_spine)
	var ledger_title = make_label(ledger_panel, "牌桌记录", 10 if compact_log else 12, Color(0.90, 0.78, 0.52), true)
	apply_rect(ledger_title, rect_full(0.085, 0.030, 0.430 if compact_log else 0.500, 0.230))
	ledger_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	set_ui_full_text(ledger_title, "牌桌记录", "当前牌桌最近事件")
	mark_ui_optimization(ledger_title, "F-517")
	var ledger_count = make_label(ledger_panel, "%d条" % table_logs.size(), 8 if compact_log else 10, Color(0.72, 0.66, 0.48), false)
	apply_rect(ledger_count, rect_full(0.455 if compact_log else 0.520, 0.040, 0.650, 0.220))
	ledger_count.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	set_ui_full_text(ledger_count, "%d 条牌桌记录" % table_logs.size(), "牌桌记录数量")
	mark_ui_optimization(ledger_count, "F-518")
	var archive_button := make_small_button("历史", Color(0.48, 0.42, 0.28), Callable(self, "toggle_table_log_archive"))
	archive_button.name = "TableLogArchiveButton"
	archive_button.custom_minimum_size = Vector2(48 if compact_log else 54, 28 if compact_log else 32)
	archive_button.custom_minimum_size.y = UI_MIN_TOUCH_TARGET
	archive_button.add_theme_font_size_override("font_size", 10 if compact_log else 11)
	archive_button.tooltip_text = "查看完整牌桌记录 · 最近记录可滚动查看"
	set_ui_full_text(archive_button, archive_button.tooltip_text, "打开牌桌历史记录")
	mark_ui_optimization(archive_button, "F-519")
	apply_rect(archive_button, rect_full(0.690, 0.0, 0.950, 0.0))
	archive_button.offset_top = 4.0
	archive_button.offset_bottom = 48.0
	ledger_panel.add_child(archive_button)
	var log_recent = table_log_tail(2)
	if log_recent.is_empty():
		var waiting = make_label(ledger_panel, "等待开局", 12, Color(0.74, 0.66, 0.44), true)
		apply_rect(waiting, rect_full(0.080, 0.330, 0.920, 0.710))
		waiting.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		set_ui_full_text(waiting, "等待开局", "牌桌记录为空")
		mark_ui_optimization(waiting, "F-520")
		return
	for log_i in range(1 if compact_log else log_recent.size()):
		var row_top = 0.300 + float(log_i) * 0.265
		var log_text = "\n".join(log_recent) if compact_log else str(log_recent[log_i])
		var row_tag = table_log_tag(str(log_recent.back()))
		var row_color = table_log_tag_color(row_tag)
		var row_bottom = 0.950 if compact_log else row_top + 0.205
		var row_panel = make_gpt_plate_rect(rect_full(0.075, row_top, 0.650, row_bottom), Color(0.052, 0.044, 0.030, 0.54), "ui_jade_reading_plate")
		row_panel.name = "TableLogLedgerRow_%d" % log_i
		ledger_panel.add_child(row_panel)
		var row_badge = make_gpt_gate(rect_full(0.025, 0.190, 0.170, 0.800), Color(row_color.r, row_color.g, row_color.b, 0.24))
		row_badge.name = "TableLogLedgerBadge_%d" % log_i
		row_panel.add_child(row_badge)
		var row_mark = make_label(row_badge, row_tag.substr(0, 1), 9, Color(0.98, 0.90, 0.66), true)
		apply_rect(row_mark, rect_full(0.0, 0.0, 1.0, 1.0))
		var row_body = make_label(row_panel, table_log_display_text(log_text), 11 if compact_log else 10, Color(0.80, 0.76, 0.60), false)
		row_body.name = "TableLogLedgerBody_%d" % log_i
		apply_rect(row_body, rect_full(0.205, 0.070, 0.955, 0.900))
		row_body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		row_body.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		row_body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		configure_clipped_label(row_body)
		row_body.tooltip_text = row_body.text
		set_ui_full_text(row_body, row_body.text, "牌桌最近事件")
		mark_ui_optimization(row_body, "F-521")
	return


func draw_table_log_archive_panel(parent: Control) -> void:
	if not table_log_archive_open or (mode != "offline" and mode != "online_game"):
		return
	var archive_bottom := 0.420 if effective_viewport_size().y <= 560.0 and has_pending_claim_window() else 0.545
	var panel = make_gpt_plate_rect(rect_full(0.230, 0.120, 0.870, archive_bottom), Color(0.014, 0.034, 0.040, 0.96), "ui_jade_reading_plate")
	panel.name = "TableLogArchivePanel"
	panel.z_index = 43
	panel.mouse_filter = Control.MOUSE_FILTER_STOP
	panel.clip_contents = true
	panel.set_meta("layout_role", "table_log_archive")
	parent.add_child(panel)
	var texture = add_illustration_texture(panel, "table_log_scroll", rect_full(0.010, 0.025, 0.990, 0.975), 0.075, false)
	if texture != null:
		texture.name = "TableLogArchiveTexture"
		panel.move_child(texture, 0)
	var title = make_label(panel, "牌桌记录·历史", 16, Color(0.90, 0.80, 0.56), true)
	title.name = "TableLogArchiveTitle"
	apply_rect(title, rect_full(0.060, 0.045, 0.650, 0.150))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	set_ui_full_text(title, "牌桌记录·历史", "完整牌桌历史记录")
	mark_ui_optimization(title, "F-522")
	var visible_log_count := mini(table_logs.size(), ONLINE_LOG_HISTORY_LIMIT)
	var count_text := "%d条" % table_logs.size()
	if table_logs.size() > ONLINE_LOG_HISTORY_LIMIT:
		count_text = "最近%d/%d条" % [visible_log_count, table_logs.size()]
	var count = make_label(panel, count_text, 11, Color(0.70, 0.76, 0.66), false)
	count.name = "TableLogArchiveCount"
	apply_rect(count, rect_full(0.680, 0.060, 0.820, 0.145))
	count.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	count.tooltip_text = "显示最近%d/%d条牌桌记录" % [visible_log_count, table_logs.size()] if table_logs.size() > ONLINE_LOG_HISTORY_LIMIT else "共%d条牌桌记录" % table_logs.size()
	set_ui_full_text(count, count.tooltip_text, "牌桌历史记录数量")
	mark_ui_optimization(count, "F-523")
	var close_button := make_icon_button("x", Color(0.92, 0.82, 0.58), 16, Callable(self, "close_table_log_archive"))
	close_button.name = "TableLogArchiveCloseButton"
	close_button.custom_minimum_size = Vector2(UI_MIN_TOUCH_TARGET, UI_MIN_TOUCH_TARGET)
	close_button.tooltip_text = "关闭牌桌记录 · Esc"
	set_ui_full_text(close_button, close_button.tooltip_text, "关闭牌桌历史记录")
	mark_ui_optimization(close_button, "F-524")
	apply_rect(close_button, rect_full(0.865, 0.005, 0.985, 0.215))
	panel.add_child(close_button)
	var route = make_gpt_route_rail(rect_full(0.060, 0.180, 0.940, 0.205), Color(0.006, 0.016, 0.018, 0.48))
	route.name = "TableLogArchiveRoute"
	panel.add_child(route)
	var scroll := ScrollContainer.new()
	scroll.name = "TableLogArchiveScroll"
	configure_scroll_container(scroll, "上下滚动查看完整牌桌记录")
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	apply_rect(scroll, rect_full(0.060, 0.300, 0.940, 0.925))
	panel.add_child(scroll)
	var list := VBoxContainer.new()
	list.name = "TableLogArchiveList"
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	list.add_theme_constant_override("separation", 6)
	scroll.add_child(list)
	if table_logs.is_empty():
		var empty = make_label(list, "暂无牌桌记录", 13, Color(0.76, 0.82, 0.72), false)
		empty.name = "TableLogArchiveEmpty"
		empty.custom_minimum_size = Vector2(0, 44)
	else:
		var start_index := maxi(0, table_logs.size() - ONLINE_LOG_HISTORY_LIMIT)
		for log_i in range(start_index, table_logs.size()):
			var full_text := table_log_display_text(str(table_logs[log_i]))
			var row := make_label(list, "%02d  %s" % [log_i + 1, full_text], 13, Color(0.84, 0.88, 0.80), false)
			row.name = "TableLogArchiveRow_%d" % log_i
			var row_width := maxf(260.0, effective_viewport_size().x * 0.820)
			var row_height := estimate_wrapped_text_height(row.text, row_width, accessibility_font_size(13), 5.0)
			row.custom_minimum_size = Vector2(0, row_height)
			row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			configure_wrapped_label(row, row_width, row_height, 5.0)
			row.tooltip_text = full_text
	if not round_history.is_empty():
		var history_title := make_label(list, "最近对局战报", 12, Color(0.90, 0.78, 0.52), true)
		history_title.name = "RoundHistoryArchiveSection"
		history_title.custom_minimum_size = Vector2(0, 32)
		var history_entries := latest_round_history(5)
		for history_index in range(history_entries.size() - 1, -1, -1):
			var entry = history_entries[history_index]
			if typeof(entry) != TYPE_DICTIONARY:
				continue
			var history_text := str((entry as Dictionary).get("summary", "已完成一局"))
			var history_row := make_label(list, "对局 %02d  ·  %s" % [int((entry as Dictionary).get("hand_number", 0)), history_text], 11, Color(0.80, 0.86, 0.76), false)
			history_row.name = "RoundHistoryArchiveRow_%d" % history_index
			history_row.custom_minimum_size = Vector2(0, estimate_wrapped_text_height(history_row.text, maxf(240.0, effective_viewport_size().x * 0.640), accessibility_font_size(11), 5.0))
			history_row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			configure_wrapped_label(history_row, maxf(240.0, effective_viewport_size().x * 0.640), history_row.custom_minimum_size.y, 5.0)
			history_row.tooltip_text = history_text
	call_deferred("scroll_table_log_archive_to_end")


func draw_table_log_archive_commit(parent: Control, tag_color: Color) -> Control:
	# r213: GPT chrome conversion
	var commit = Control.new()
	commit.name = "TableLogArchiveCommit"
	commit.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(commit, rect_full(0.515, 0.020, 0.995, 0.985))
	parent.add_child(commit)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.520, 0.090, 0.770), Color(tag_color.r, tag_color.g, tag_color.b, 0.16))
	source.name = "TableLogArchiveCommitSource"
	commit.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.610, 0.870, 0.720), Color(0.006, 0.016, 0.018, 0.40))
	route.name = "TableLogArchiveCommitRoute"
	commit.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.800, 0.750), Color(tag_color.r, tag_color.g, tag_color.b, 0.20))
	fill.name = "TableLogArchiveCommitFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.830, 0.525, 0.930, 0.815), Color(tag_color.r, tag_color.g, tag_color.b, 0.15))
	gate.name = "TableLogArchiveCommitGate"
	commit.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.635, 0.120, 0.780, 0.405), Color(0.78, 0.66, 0.34, 0.14))
	seal.name = "TableLogArchiveCommitSeal"
	commit.add_child(seal)
	var glyph = make_label(seal, "录", 8, Color(0.96, 0.92, 0.72, 0.82), true)
	glyph.name = "TableLogArchiveCommitGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tick = add_gpt_tick_strip(commit, rect_full(0.260, 0.455, (0.260) + float(2) * (0.135) + (0.030), 0.760), Color(tag_color.r, tag_color.g, tag_color.b, 0.18), "TableLogArchiveCommitTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.36, 0.66).from(0.88)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.66).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.88, 0.66).from(0.36)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.66).from(0.58)
	return commit


