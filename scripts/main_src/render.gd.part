func draw_exit_confirm_choice_commit_feedback(parent: Control, route_id: String, color: Color) -> Control:
	# r213: GPT chrome conversion
	if parent == null or not is_instance_valid(parent):
		return null
	var old_feedback = parent.find_child("ExitConfirmChoiceCommitFeedback_%s" % route_id, true, false)
	if old_feedback != null:
		old_feedback.queue_free()
	var feedback = Control.new()
	feedback.name = "ExitConfirmChoiceCommitFeedback_%s" % route_id
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(feedback, rect_full(0.120, 0.675, 0.880, 0.945))
	parent.add_child(feedback)
	var source_left = 0.070 if route_id == "keep" else 0.855
	var source = make_gpt_plate_rect(rect_full(source_left, 0.365, source_left + 0.075, 0.635), Color(color.r, color.g, color.b, 0.22), "ui_jade_reading_plate")
	source.name = "ExitConfirmChoiceCommitSource_%s" % route_id
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.115, 0.775, 0.885, 0.845), Color(0.006, 0.016, 0.018, 0.48))
	route.name = "ExitConfirmChoiceCommitRoute_%s" % route_id
	feedback.add_child(route)
	var fill_left = 0.040 if route_id == "keep" else 0.520
	var fill_right = 0.480 if route_id == "keep" else 0.960
	var fill = make_gpt_meter_fill(rect_full(fill_left, 0.260, fill_right, 0.740), Color(color.r, color.g, color.b, 0.34))
	fill.name = "ExitConfirmChoiceCommitFill_%s" % route_id
	route.add_child(fill)
	var gate_left = 0.438 if route_id == "keep" else 0.512
	var gate = make_gpt_gate(rect_full(gate_left, 0.680, gate_left + 0.065, 0.960), Color(0.96, 0.82, 0.42, 0.24))
	gate.name = "ExitConfirmChoiceCommitGate_%s" % route_id
	feedback.add_child(gate)
	var archive_left = 0.332 if route_id == "keep" else 0.600
	var archive = make_gpt_plate_rect(rect_full(archive_left, 0.170, archive_left + 0.110, 0.565), Color(color.r, color.g, color.b, 0.18), "ui_jade_reading_plate")
	archive.name = "ExitConfirmChoiceCommitArchive_%s" % route_id
	feedback.add_child(archive)
	var glyph_text = "续" if route_id == "keep" else "退"
	var glyph = make_label(archive, glyph_text, 10, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "ExitConfirmChoiceCommitGlyph_%s" % route_id
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var tick_left = (0.260 + float(i) * 0.080) if route_id == "keep" else (0.690 + float(i) * 0.080)
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.675, tick_left + 0.025, 0.930), Color(color.r, color.g, color.b, 0.24 - float(i) * 0.040))
		tick.name = "ExitConfirmChoiceCommitTick_%s_%d" % [route_id, i]
		feedback.add_child(tick)
	for i in range(3):
		var pip_left = (0.145 + float(i) * 0.050) if route_id == "keep" else (0.805 - float(i) * 0.050)
		var pip = make_gpt_gate(rect_full(pip_left, 0.420, pip_left + 0.026, 0.560), Color(color.r, color.g, color.b, 0.23 - float(i) * 0.035))
		pip.name = "ExitConfirmChoiceCommitPip_%s_%d" % [route_id, i]
		feedback.add_child(pip)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_screen_tween()
		tw.bind_node(feedback)
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.08).from(0.0)
		tw.tween_property(fill, "modulate:a", 0.78, 0.14).from(0.18)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.13).from(Vector2(0.86, 0.86)).set_ease(Tween.EASE_OUT)
		tw.tween_property(archive, "scale", Vector2(1.08, 1.08), 0.13).from(Vector2(0.88, 0.88)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.08)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.94
	return feedback


func draw_flying_tile_route_art(tile: String, from_pos: Vector2, to_pos: Vector2) -> Control:
	# r214: bulk GPT chrome sweep
	if fx_layer == null or not is_instance_valid(fx_layer):
		return null
	var art = Control.new()
	art.name = "FlyingTileRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	art.z_index = FX_LAYER_Z_INDEX + 1
	fx_layer.add_child(art)
	var accent = tile_accent(tile) if tile != "" else GOLD_PRIMARY
	var viewport_size = effective_viewport_size()
	var start = Vector2(clamp(from_pos.x / viewport_size.x, 0.0, 1.0), clamp(from_pos.y / viewport_size.y, 0.0, 1.0))
	var end = Vector2(clamp(to_pos.x / viewport_size.x, 0.0, 1.0), clamp(to_pos.y / viewport_size.y, 0.0, 1.0))
	var route_left = min(start.x, end.x)
	var route_right = max(start.x, end.x)
	var route_top = min(start.y, end.y)
	var route_bottom = max(start.y, end.y)
	var arc_texture = add_illustration_texture(art, "flying_tile_arc", rect_full(route_left - 0.070, route_top - 0.180, route_right + 0.070, route_bottom + 0.120), 0.14, false)
	if arc_texture != null:
		arc_texture.name = "FlyingTileArcTexture"
	var route = make_gpt_route_rail(rect_full(route_left, (start.y + end.y) * 0.5 - 0.004, route_right, (start.y + end.y) * 0.5 + 0.004), Color(0.006, 0.016, 0.018, 0.38))
	route.name = "FlyingTileRouteRail"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.200, 0.840, 0.800), Color(accent.r, accent.g, accent.b, 0.26))
	fill.name = "FlyingTileRouteFill"
	route.add_child(fill)
	var source = make_gpt_plate_rect(rect_full(start.x - 0.014, start.y - 0.026, start.x + 0.014, start.y + 0.026), Color(accent.r, accent.g, accent.b, 0.22), "ui_jade_reading_plate")
	source.name = "FlyingTileSourceGate"
	art.add_child(source)
	var target = make_gpt_plate_rect(rect_full(end.x - 0.018, end.y - 0.032, end.x + 0.018, end.y + 0.032), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	target.name = "FlyingTileLandingGate"
	art.add_child(target)
	for i in range(3):
		var t = 0.250 + float(i) * 0.180
		var point = start.lerp(end, t)
		var tick = make_gpt_tick_strip(rect_full(point.x - 0.005, point.y - 0.020, point.x + 0.005, point.y + 0.020), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		tick.name = "FlyingTileRouteTick_0"
		art.add_child(tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if arc_texture != null:
			var arc_tw := create_screen_tween()
			arc_tw.set_loops(4)
			arc_tw.tween_property(arc_texture, "modulate:a", 0.24, 0.18).from(0.10)
			arc_tw.parallel().tween_property(arc_texture, "rotation", 0.04, 0.18).from(-0.04)
			arc_tw.tween_property(arc_texture, "modulate:a", 0.10, 0.18).from(0.24)
			arc_tw.parallel().tween_property(arc_texture, "rotation", -0.04, 0.18).from(0.04)
		var tw := create_screen_tween()
		tw.set_loops(4)
		tw.tween_property(fill, "modulate:a", 0.36, 0.18).from(0.92)
		tw.parallel().tween_property(target, "modulate:a", 0.56, 0.18).from(0.94)
		tw.tween_property(fill, "modulate:a", 0.92, 0.18).from(0.36)
		tw.parallel().tween_property(target, "modulate:a", 0.94, 0.18).from(0.56)
	return art


func draw_game_top_hud(parent: Control) -> void:
	# Keep the generated texture as a restrained header surface; status text and
	# controls remain the primary visual signal at 960x540.
	var hud = make_gpt_plate_rect(TOP_HUD_RECT, Color(0.028, 0.036, 0.032, 0.26), "ui_dark_scrim")
	hud.name = "TopHud3DShell"
	parent.add_child(hud)
	hud.clip_contents = true
	var hud_shadow = make_soft_depth_panel(hud, rect_full(0.010, 0.220, 0.990, 1.080), Color(0.0, 0.0, 0.0, 0.36), 12)
	hud_shadow.name = "TopHud3DCastShadow"
	hud.move_child(hud_shadow, 0)
	var hud_depth = make_soft_depth_panel(hud, rect_full(0.018, 0.620, 0.982, 0.980), Color(0.14, 0.084, 0.036, 0.24), 10)
	hud_depth.name = "TopHud3DDepthEdge"
	var hud_top_rim = make_soft_depth_panel(hud, rect_full(0.030, 0.015, 0.970, 0.095), Color(1.0, 0.92, 0.58, 0.12), 999)
	hud_top_rim.name = "TopHud3DTopRim"
	var hud_jade_rail = make_soft_depth_panel(hud, rect_full(0.040, 0.860, 0.960, 0.930), Color(0.42, 0.30, 0.14, 0.08), 999)
	hud_jade_rail.name = "TopHud3DJadeRail"
	var top_hud_gpt_key := "top_hud_gpt_banner"
	var gpt_top_hud_texture = add_optional_gpt_atlas_texture(hud, top_hud_gpt_key, Rect2(0.0, 0.0, 1254.0, 260.0), rect_full(0.000, 0.000, 1.000, 0.230), 0.06, false)
	if gpt_top_hud_texture != null:
		gpt_top_hud_texture.name = "TopHudGPTBannerTexture"
		# Keep the authored header material present without competing with the
		# long AI profile/status line at compact resolutions.
		gpt_top_hud_texture.modulate = Color(1.02, 1.00, 0.96, 0.018)
		hud.move_child(gpt_top_hud_texture, min(1, hud.get_child_count() - 1))

	# 模式徽章
	var mode_text = ("单机 · " + rule_variant_short_label()) if mode == "offline" else "联机"
	var mode_badge = make_badge(hud, TOP_HUD_MODE_BADGE_RECT, mode_text, 11, Color(0.100, 0.082, 0.058, 0.78), Color(0.52, 0.42, 0.22, 0.22), Color(0.94, 0.88, 0.72))
	mode_badge.name = "TopHudModeBadge"
	mode_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	draw_top_hud_status_art(hud)

	# 标题
	var title_text = "修炼场 · 第%d局" % [offline_hand_number] if mode == "offline" else "房间 " + str(online_game.get("roomCode", selected_room))
	var title_rect := TOP_HUD_TITLE_RECT
	var status_rect := TOP_HUD_STATUS_RECT
	var wall_rect := TOP_HUD_WALL_RECT
	if mode == "offline":
		title_rect = Rect2(Vector2(0.106, 0.090), Vector2(0.260, 0.535))
		status_rect = Rect2(Vector2(0.270, 0.090), Vector2(0.610, 0.515))
		wall_rect = Rect2(Vector2(0.632, 0.140), Vector2(0.766, 0.860))
	# r202: GPT title/status chips instead of make_panel lacquer hosts
	var title_back = make_gpt_plate_rect(rect_full(title_rect.position.x - 0.008, 0.020, title_rect.size.x + 0.006, 0.685), Color(0.90, 0.72, 0.34, 0.18), "ui_dark_scrim")
	title_back.name = "TopHudTitleBack"
	hud.add_child(title_back)
	var status_back = make_gpt_plate_rect(rect_full(status_rect.position.x - 0.008, 0.020, status_rect.size.x + 0.006, 0.685), Color(0.58, 0.74, 0.64, 0.16), "ui_dark_scrim")
	status_back.name = "TopHudStatusBack"
	hud.add_child(status_back)
	var title = make_label(hud, title_text, 15 if mode == "offline" else 16, Color(0.96, 0.80, 0.48), true)
	title.name = "TopHudTitle"
	apply_rect(title, title_rect)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(title)

	# 状态
	var status = make_label(hud, top_hud_status_text(), 15 if mode == "offline" else 16, Color(0.92, 0.94, 0.86), true)
	status.name = "TopHudStatus"
	apply_rect(status, status_rect)
	configure_clipped_label(status)
	draw_top_hud_hand_progress(hud)

	# 离线战斗中分数已在四家座位卡常驻显示，顶部不再重复铺一整条分数面板。
	if mode != "offline":
		draw_score_strip(hud, TOP_HUD_SCORE_STRIP_RECT)

	# 余牌信息
	var wall_back = make_gpt_plate_rect(rect_full(wall_rect.position.x - 0.006, wall_rect.position.y - 0.010, wall_rect.size.x + 0.006, wall_rect.size.y + 0.010), Color(0.72, 0.56, 0.28, 0.10), "ui_dark_scrim")
	wall_back.name = "TopHudWallBack"
	hud.add_child(wall_back)
	draw_top_hud_wall_meter(hud, wall_rect)
	var wall = make_label(hud, top_hud_wall_text(), 11, Color(0.90, 0.88, 0.74), true)
	wall.name = "TopHudWallText"
	var empty_wall := StyleBoxEmpty.new()
	empty_wall.set_content_margin_all(4)
	wall.add_theme_stylebox_override("normal", empty_wall)
	var wall_chip = add_optional_gpt_illustration_texture(wall, "ui_dark_scrim", rect_full(-0.04, -0.08, 1.04, 1.08), 0.22, false)
	if wall_chip != null:
		wall_chip.name = "WallCountGptPlate"
		wall.move_child(wall_chip, 0)
	apply_rect(wall, rect_full(wall_rect.position.x + 0.010, wall_rect.position.y + 0.070, wall_rect.size.x - 0.010, wall_rect.position.y + 0.460))
	configure_clipped_label(wall)

	# 操作按钮组
	var settings = make_top_hud_button("设置", Color(0.45, 0.34, 0.18), func() -> void:
		toggle_settings_panel()
	)
	settings.name = "TopHudSettingsButton"
	hud.add_child(settings)
	apply_rect(settings, TOP_HUD_SETTINGS_BUTTON_RECT)

	var back = make_top_hud_button("返回", Color(0.38, 0.30, 0.18), func() -> void:
		if mode == "offline":
			show_exit_confirm()
		else:
			show_online_lobby()
	)
	back.name = "TopHudBackButton"
	hud.add_child(back)
	apply_rect(back, TOP_HUD_BACK_BUTTON_RECT)

	var update = make_top_hud_button("更新", Color(0.54, 0.36, 0.18), func() -> void:
		start_update_download()
	)
	hud.add_child(update)
	apply_rect(update, TOP_HUD_UPDATE_BUTTON_RECT)


func draw_hand(parent: Control) -> void:
	# r213: GPT chrome conversion
	# 手牌托盘 - 增强视觉效果
	var tray = make_gpt_plate_rect(HAND_TRAY_RECT, Color(0.16, 0.12, 0.08, 0.94), "ui_jade_reading_plate")
	tray.name = "HandTray"
	parent.add_child(tray)
	tray.clip_contents = true
	var tray_shadow = make_soft_depth_panel(tray, rect_full(0.010, 0.145, 0.990, 1.060), Color(0.0, 0.0, 0.0, 0.38), 18)
	tray_shadow.name = "HandTray3DCastShadow"
	tray.move_child(tray_shadow, 0)
	var tray_lip = make_soft_depth_panel(tray, rect_full(0.025, 0.025, 0.975, 0.185), Color(1.0, 0.94, 0.64, 0.28), 999)
	tray_lip.name = "HandTray3DFrontLip"
	var tray_side_bevel = make_soft_depth_panel(tray, rect_full(0.010, 0.140, 0.035, 0.900), Color(1.0, 0.94, 0.66, 0.20), 999)
	tray_side_bevel.name = "HandTray3DSideBevel"
	var hand_gpt_key := "hand_gpt_tray"
	var gpt_hand_texture = add_optional_gpt_illustration_texture(tray, hand_gpt_key, rect_full(0.000, 0.000, 1.000, 0.990), 1.0, false)
	if gpt_hand_texture != null:
		gpt_hand_texture.name = "HandGPTTrayTexture"
		# r184: full GPT face + warm lift; avoid dark stage wash burying lacquer detail.
		gpt_hand_texture.modulate = Color(1.34, 1.22, 1.08, 1.0)  # r189 warm lacquer lift
		tray.move_child(gpt_hand_texture, min(1, tray.get_child_count() - 1))
	var tile_stage = make_gpt_plate_rect(rect_full(0.010, 0.170, 0.990, 0.955), Color(0.08, 0.06, 0.04, 0.12), "ui_button_face_plate")
	tile_stage.name = "HandTrayTileStage"
	tray.add_child(tile_stage)
	var tile_ground_shadow = make_soft_depth_panel(tile_stage, rect_full(0.030, 0.575, 0.970, 1.060), Color(0.0, 0.0, 0.0, 0.40), 16)
	tile_ground_shadow.name = "HandTrayTileGroundShadow"
	var tile_back_rail = make_gpt_route_rail(rect_full(0.020, 0.055, 0.980, 0.155), Color(0.94, 0.76, 0.44, 0.16))
	tile_back_rail.name = "HandTrayTileBackRail"
	tile_stage.add_child(tile_back_rail)
	var tile_baseline = make_gpt_route_rail(rect_full(0.030, 0.805, 0.970, 0.900), Color(0.0, 0.0, 0.0, 0.42))
	tile_baseline.name = "HandTrayTileBaseline"
	tile_stage.add_child(tile_baseline)
	tray.move_child(tile_stage, min(2, tray.get_child_count() - 1))

	# 状态文本
	var tray_text = make_label(tray, hand_tray_text(), 14, Color(0.92, 0.82, 0.56), true)
	tray_text.clip_text = true
	apply_rect(tray_text, HAND_TRAY_TEXT_RECT)
	tray_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(tray_text)
	if mode == "offline" and offline_phase == "pending_claim":
		tray_text.visible = false

	# 状态徽章
	var state_chip = add_optional_gpt_illustration_texture(tray, "ui_hand_tray_state_chip", rect_full(0.783, 0.028, 0.982, 0.157), 0.55, false)
	if state_chip != null:
		state_chip.name = "HandTrayStateChip"
	var state_badge = make_badge(tray, HAND_TRAY_STATE_BADGE_RECT, hand_tray_state_text(), 12, hand_tray_state_fill(), hand_tray_state_border(), Color(0.92, 0.92, 0.84))
	state_badge.name = "HandTrayStateBadge"
	state_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if mode == "offline" and offline_phase == "pending_claim":
		state_badge.visible = false

	# 新手提示：首次出牌时显示
	if show_hand_hint and tutorial_step == 0 and can_self_discard():
		var hint_panel = make_gpt_plate_rect(rect_full(0.02, 0.50, 0.98, 0.92), Color(0.020, 0.042, 0.048, 0.94), "ui_button_face_plate")
		hint_panel.name = "HandTrayTutorialHint"
		tray.add_child(hint_panel)
		hint_panel.z_index = 8
		hint_panel.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.014, 1.0), Color(0.30, 0.62, 0.52, 0.56)))
		draw_hand_tutorial_hint_art(hint_panel)
		var hint_text = "💡 点击手牌即可打出 · 出牌后等待对手响应"
		var hint_label = make_label(hint_panel, hint_text, 14, Color(0.94, 0.96, 0.92), false)
		hint_label.name = "HandTrayTutorialHintText"
		apply_rect(hint_label, rect_full(0.190, 0.125, 0.940, 0.470))
		hint_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		# 首次出牌后关闭提示
		var close_hint = func() -> void:
			show_hand_hint = false
		if not tray.is_connected("tree_exiting", close_hint):
			tray.connect("tree_exiting", close_hint)
		# 激活交互式引导
		interactive_guide_active = true
		interactive_guide_type = "discard"

	var hand = get_self_hand()
	var suit_flow = draw_hand_tray_suit_flow(tray, hand)
	if suit_flow != null:
		suit_flow.modulate = Color(1.0, 1.0, 1.0, 0.22)
	var momentum_art = draw_hand_tray_momentum_art(tray, hand)
	if momentum_art != null:
		momentum_art.modulate = Color(1.0, 1.0, 1.0, 0.16)
	var completion_bus = draw_hand_tray_completion_bus_art(tray, hand)
	if completion_bus != null:
		completion_bus.modulate = Color(1.0, 1.0, 1.0, 0.12)
	var hand_layout = hand_layout_metrics(hand)
	var assist_enabled = player_ai_assist_enabled()
	var suggested_tile = suggest_human_discard() if assist_enabled else ""
	var hand_reports = discard_report_map_for_hand() if assist_enabled else {}
	var pending_tile = pending_danger_discard_tile if assist_enabled and has_pending_danger_discard() else ""
	var tile_width = float(hand_layout.get("tile_width", HAND_TILE_MAX_WIDTH))
	var tile_height = float(hand_layout.get("tile_height", tile_width * HAND_TILE_ASPECT))
	var group_gap_width = maxf(4.0, float(hand_layout.get("group_gap_width", 4.0)))
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	var drawn_serial = int(offline_last_draw.get("serial", -1))
	var stable_drawn_index := -1
	if mode == "offline" and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "" and hand.size() % 3 == 2:
		stable_drawn_index = hand.rfind(drawn_tile)
	var should_animate_drawn_tile = mode == "offline" and fx_enabled_effective() and bool(offline_last_draw.get("announce", false)) and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "" and drawn_serial != fx_last_animated_draw_serial
	var draw_state_assigned := false
	# Pure 2D hand: authored assets/tiles faces via make_tile_view (no realtime 3D stage).
	for i in range(hand.size()):
		var tile := str(hand[i])
		var is_drawn_tile := should_animate_drawn_tile and not draw_state_assigned and tile == drawn_tile
		if is_drawn_tile:
			draw_state_assigned = true
	if draw_state_assigned:
		fx_last_animated_draw_serial = drawn_serial

	var hand_box = HBoxContainer.new()
	hand_box.alignment = BoxContainer.ALIGNMENT_CENTER
	configure_passive_container(hand_box)
	hand_box.add_theme_constant_override("separation", maxi(0, int(hand_layout.get("separation", 4))))
	hand_box.z_index = 4
	apply_rect(hand_box, HAND_TRAY_TILES_RECT)
	tray.add_child(hand_box)

	# 手牌滑入动画
	if fx_enabled_effective():
		tray.modulate = Color(1, 1, 1, 0)
		tray.offset_top = 24.0
		var tw := create_screen_tween()
		var slide_dur := float(HAND_SLIDE_IN_DURATION_MSEC) / 1000.0
		tw.set_parallel(true)
		tw.tween_property(tray, "modulate:a", 1.0, slide_dur).from(0.0)
		tw.tween_property(tray, "offset_top", 0.0, slide_dur).from(24.0)

	for i in range(hand.size()):
		var index = i
		var tile = str(hand[i])
		if should_insert_hand_group_gap(hand, i):
			hand_box.add_child(make_hand_group_spacer(tile_height, group_gap_width, hand_group_label(tile)))
		var clickable = can_self_discard() and not is_claim_discard_banned(0, tile)
		# 新手引导高亮：可点击时添加视觉提示
		var should_highlight = clickable and ((suggested_tile != "" and tile == suggested_tile) or (pending_tile != "" and tile == pending_tile))
		var guide_highlight = interactive_guide_active and interactive_guide_type == "discard" and clickable
		var highlighted = should_highlight or guide_highlight
		var report: Dictionary = hand_reports.get(tile, {})
		var risk = str(report.get("safety_label", report.get("risk_label", ""))) if assist_enabled and clickable else ""
		var hint_badge = hand_tile_hint_badge(tile, suggested_tile, pending_tile) if assist_enabled and clickable else ""
		var callback = func() -> void:
			# 玩家执行操作时关闭引导
			if interactive_guide_active:
				interactive_guide_active = false
				interactive_guide_type = ""
			if mode == "offline":
				human_discard(index)
			else:
				send_online_action({"type": "discard", "tile": tile}, "打出%s" % tile_label(tile))
		var tile_node = make_tile_view(tile, Vector2(tile_width, tile_height), clickable, callback, highlighted, risk, hint_badge)
		tile_node.name = "HandTile_%02d_%s" % [i, tile]
		tile_node.set_meta("hand_source_index", i)
		tile_node.set_meta("hand_tile_code", tile)
		tile_node.set_meta("drawn_tile", i == stable_drawn_index)
		if i == stable_drawn_index and tile_node.get_child_count() > 0:
			var drawn_body = tile_node.get_child(0) as Control
			if drawn_body != null:
				drawn_body.offset_top -= 4.0
				drawn_body.offset_bottom -= 4.0
		hand_box.add_child(tile_node)
		if should_animate_drawn_tile and tile == drawn_tile and bool(tile_node.get_meta("drawn_anim_pending", true)):
			# one-shot draw pop for the newest self tile when available
			pass


func draw_hand_progress_wall_sync(parent: Control, accent: Color) -> Control:
	# r213: GPT chrome conversion
	var wall_ratio = clamp(float(get_wall_count()) / 144.0, 0.0, 1.0)
	var pressure = 1.0 - wall_ratio
	var color = wall_meter_color(wall_ratio)
	var sync = Control.new()
	sync.name = "HandProgressWallSyncRoute"
	sync.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(sync, rect_full(0.602, 0.075, 0.792, 0.585))
	parent.add_child(sync)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.270, 0.135, 0.730), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "HandProgressWallSyncSource"
	sync.add_child(source)
	var rail = make_gpt_route_rail(rect_full(0.095, 0.420, 0.895, 0.580), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "HandProgressWallSyncRail"
	sync.add_child(rail)
	var fill_width = 0.095 + 0.800 * clamp(0.18 + pressure * 0.82, 0.18, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.095, 0.440, fill_width, 0.560), Color(color.r, color.g, color.b, 0.28 + pressure * 0.18))
	fill.name = "HandProgressWallSyncFill"
	sync.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.860, 0.265, 0.995, 0.735), Color(color.r, color.g, color.b, 0.16 + pressure * 0.12))
	gate.name = "HandProgressWallSyncGate"
	sync.add_child(gate)
	var tick = add_gpt_tick_strip(sync, rect_full(0.245, 0.315, (0.285) + float(2) * (0.190), 0.685), Color(color.r, color.g, color.b, 0.18 + pressure * 0.10), "HandProgressWallSyncTick_0")
	if get_wall_count() <= 24:
		var warning = make_gpt_gate(rect_full(0.790, 0.020, 0.985, 0.250), Color(0.56, 0.14, 0.08, 0.30))
		warning.name = "HandProgressWallSyncLowWarning"
		sync.add_child(warning)
	fill.modulate = Color(1, 1, 1, 0.84)
	return sync


func draw_hand_tray_action_path(parent: Control, hand: Array) -> Control:
	var path = Control.new()
	path.name = "HandTrayActionPath"
	path.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(path, rect_full(0.752, 0.835, 0.985, 0.965))
	parent.add_child(path)
	var active = can_self_discard()
	var responding = mode == "offline" and offline_phase == "pending_claim"
	var accent = hand_tray_state_fill()
	var base_alpha := 0.34 if active else 0.18
	if responding:
		base_alpha = 0.30
	# r204 GPT path chrome
	var rail = make_gpt_route_rail(rect_full(0.040, 0.420, 0.920, 0.580), Color(accent.r, accent.g, accent.b, base_alpha))
	rail.name = "HandTrayActionPathRail"
	path.add_child(rail)
	var progress = clamp(float(hand.size()) / 14.0, 0.0, 1.0)
	var fill_right = 0.080 + 0.760 * progress
	var fill = make_gpt_meter_fill(rect_full(0.080, 0.465, fill_right, 0.535), Color(0.96, 0.80, 0.38, 0.34 if active else 0.16))
	fill.name = "HandTrayActionPathFill"
	path.add_child(fill)
	var stream = make_gpt_route_rail(rect_full(0.120, 0.745, 0.855, 0.835), Color(0.006, 0.016, 0.018, 0.44))
	stream.name = "HandTrayActionPathStream"
	path.add_child(stream)
	var stream_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * max(0.12, progress), 0.740), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.12))
	stream_fill.name = "HandTrayActionPathStreamFill"
	stream.add_child(stream_fill)
	for i in range(4):
		var center = 0.080 + float(i) * 0.253
		var lit = center <= fill_right or (active and i == 3)
		var node = make_gpt_gate(rect_full(center - 0.018, 0.305, center + 0.018, 0.695), Color(accent.r, accent.g, accent.b, 0.52 if lit else 0.16))
		node.name = "HandTrayActionPathNode_%d" % i
		path.add_child(node)
	for i in range(3):
		var tick_left = 0.520 + float(i) * 0.075
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.130, tick_left + 0.030, 0.255), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.035))
		tick.name = "HandTrayActionPathTick_0"
		path.add_child(tick)
	var focus_left = 0.735 if active else 0.075
	if responding:
		focus_left = 0.455
	var focus = make_gpt_gate(rect_full(focus_left, 0.135, focus_left + 0.110, 0.865), Color(accent.r, accent.g, accent.b, 0.40))
	focus.name = "HandTrayActionPathFocus"
	path.add_child(focus)
	var glyph_text = "打" if active else ("应" if responding else "候")
	var glyph = make_label(focus, glyph_text, 10, Color(0.98, 0.90, 0.64, 0.94), true)
	glyph.name = "HandTrayActionPathGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var target = make_gpt_plate_rect(rect_full(0.880, 0.230, 0.990, 0.770), Color(0.94, 0.76, 0.34, 0.42 if active else 0.22), "ui_hand_tray_state_chip")
	target.name = "HandTrayActionPathTarget"
	path.add_child(target)
	var gate = make_gpt_gate(rect_full(0.855, 0.720, 0.960, 0.930), Color(accent.r, accent.g, accent.b, 0.18 if active else 0.08))
	gate.name = "HandTrayActionPathGate"
	path.add_child(gate)
	var delivery_route = make_gpt_route_rail(rect_full(0.685, 0.600, 0.900, 0.700), Color(0.006, 0.016, 0.018, 0.44))
	delivery_route.name = "HandTrayActionDeliveryRoute"
	path.add_child(delivery_route)
	var delivery_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.820 if active else 0.420, 0.740), Color(accent.r, accent.g, accent.b, 0.28 if active else 0.12))
	delivery_fill.name = "HandTrayActionDeliveryFill"
	delivery_route.add_child(delivery_fill)
	var delivery_gate = make_gpt_gate(rect_full(0.875, 0.530, 0.925, 0.770), Color(0.94, 0.76, 0.34, 0.18 if active else 0.08))
	delivery_gate.name = "HandTrayActionDeliveryGate"
	path.add_child(delivery_gate)
	var river_drop = make_gpt_plate_rect(rect_full(0.920, 0.120, 0.985, 0.390), Color(0.94, 0.76, 0.34, 0.34 if active else 0.18), "ui_hand_tray_state_chip")
	river_drop.name = "HandTrayActionRiverDrop"
	path.add_child(river_drop)
	var river_glyph = make_label(river_drop, "河", 8, Color(0.96, 0.88, 0.58, 0.82 if active else 0.46), true)
	river_glyph.name = "HandTrayActionRiverGlyph"
	apply_rect(river_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(2):
		var tick_2 = make_gpt_tick_strip(rect_full(0.730 + float(i) * 0.060, 0.500, 0.750 + float(i) * 0.060, 0.760), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.045 if active else 0.09))
		tick_2.name = "HandTrayActionDeliveryTick_0"
		path.add_child(tick_2)
	if active:
		add_lucide_icon(path, "chevron-right", rect_full(0.820, 0.245, 0.905, 0.755), Color(0.96, 0.86, 0.54, 0.74))
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	if mode == "offline" and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "":
		var drawn = make_label(target, tile_face_main(drawn_tile), 10, tile_accent(drawn_tile), true)
		drawn.name = "HandTrayActionPathDrawn"
		apply_rect(drawn, rect_full(0.0, 0.0, 1.0, 1.0))
	focus.modulate = Color(1, 1, 1, 0.82)
	stream_fill.modulate = Color(1, 1, 1, 0.78)
	delivery_fill.modulate = Color(1, 1, 1, 0.78)
	return path

func draw_hand_tray_completion_bus_art(parent: Control, hand: Array) -> Control:
	# r209: GPT chrome conversion
	var bus = Control.new()
	bus.name = "HandTrayCompletionBusArt"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(bus, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_completion_bus_art_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(bus, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_completion_bus_art_GptMeter"
	bus.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bus, rect_full(0.275, 0.175, 0.725, 0.330))
	parent.add_child(bus)
	var accent = hand_tray_state_fill()
	var active = can_self_discard()
	var counts := hand_group_counts(hand)
	var occupied_groups := 0
	for count in counts:
		if int(count) > 0:
			occupied_groups += 1
	var hand_progress = clamp(float(hand.size()) / 14.0, 0.08, 1.0)
	var group_progress = clamp(float(occupied_groups) / 5.0, 0.08, 1.0)
	var gpt_bus_texture = add_optional_gpt_illustration_texture(bus, "hand_completion_gpt_bus", rect_full(-0.030, -0.220, 1.030, 1.220), 0.14, false)  # r221
	if gpt_bus_texture != null:
		gpt_bus_texture.name = "HandTrayCompletionGPTTexture"
		bus.move_child(gpt_bus_texture, 0)
	var spine = make_gpt_route_rail(rect_full(0.055, 0.445, 0.945, 0.585), Color(0.006, 0.016, 0.018, 0.46))
	spine.name = "HandTrayCompletionSpine"
	bus.add_child(spine)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.280, 0.025 + 0.930 * hand_progress, 0.720), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.16))
	fill.name = "HandTrayCompletionFill"
	spine.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.250, 0.095, 0.790), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "HandTrayCompletionSource"
	bus.add_child(source)
	var source_glyph = make_label(source, "手", 9, Color(0.98, 0.90, 0.64, 0.86), true)
	source_glyph.name = "HandTrayCompletionGlyph"
	apply_rect(source_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var gate_left = 0.865 if active else 0.740
	var gate = make_gpt_gate(rect_full(gate_left, 0.205, gate_left + 0.095, 0.835), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.12))
	gate.name = "HandTrayCompletionGate"
	bus.add_child(gate)
	var archive = make_gpt_edge_rail(rect_full(0.905, 0.255, 0.990, 0.785), Color(0.030, 0.044, 0.040, 0.56))
	archive.name = "HandTrayCompletionArchive"
	bus.add_child(archive)
	var archive_glyph = make_label(archive, "型", 8, Color(0.96, 0.88, 0.58, 0.80), true)
	archive_glyph.name = "HandTrayCompletionArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(4):
		var center = 0.210 + float(i) * 0.180
		var branch_height = 0.130 + 0.210 * group_progress
		var branch = make_gpt_plate_rect(rect_full(center - 0.044, 0.170, center + 0.044, 0.170 + branch_height), Color(0.006, 0.016, 0.018, 0.38), "ui_jade_reading_plate")
		branch.name = "HandTrayCompletionBranch_%d" % i
		bus.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.300, 0.080, 0.700, 0.920), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.030))
		branch_fill.name = "HandTrayCompletionBranchFill_%d" % i
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(center - 0.026, 0.385, center + 0.026, 0.655), Color(accent.r, accent.g, accent.b, 0.46 if float(i) / 4.0 <= hand_progress else 0.16))
		node.name = "HandTrayCompletionNode_%d" % i
		bus.add_child(node)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.928 + float(i) * 0.025, 0.680, 0.946 + float(i) * 0.025, 0.795), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.040))
		pip.name = "HandTrayCompletionArchivePip_%d" % i
		bus.add_child(pip)
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.78)
	return bus


func draw_hand_tray_momentum_art(parent: Control, hand: Array, force_danger_warning: bool = false) -> Control:
	# r207: GPT chrome conversion
	var art = Control.new()
	art.name = "HandTrayMomentumArt"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_momentum_art_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_momentum_art_GptMeter"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.250, 0.835, 0.745, 0.965))
	parent.add_child(art)
	var hand_texture = add_illustration_texture(art, "hand_tray_flow", rect_full(-0.025, -0.150, 1.025, 1.150), 0.13, false)
	if hand_texture != null:
		hand_texture.name = "HandTrayFlowTexture"
		hand_texture.modulate = Color(1, 1, 1, 0.09)
	var accent = hand_tray_state_fill()
	var active = can_self_discard()
	var count = max(1, hand.size())
	var visible_pips = min(6, max(3, int(ceil(float(count) / 3.0))))
	for i in range(visible_pips):
		var center = 0.090 + (0.820 * float(i) / float(max(1, visible_pips - 1)))
		var pip = make_gpt_gate(rect_full(center - 0.014, 0.305, center + 0.014, 0.695), Color(accent.r, accent.g, accent.b, 0.48 if active else 0.18))
		pip.name = "HandTrayMomentumPip_%d" % i
		art.add_child(pip)
	var focus_left = 0.790 if active else 0.060
	var focus = make_gpt_plate_rect(rect_full(focus_left, 0.145, focus_left + 0.085, 0.855), Color(accent.r, accent.g, accent.b, 0.30), "ui_jade_reading_plate")
	focus.name = "HandTrayMomentumFocus"
	art.add_child(focus)
	var readiness_bridge = make_gpt_route_rail(rect_full(0.540, 0.680, 0.850, 0.760), Color(0.006, 0.016, 0.018, 0.44))
	readiness_bridge.name = "HandTrayDecisionBridge"
	art.add_child(readiness_bridge)
	var readiness_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.860 if active else 0.360, 0.740), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.14))
	readiness_fill.name = "HandTrayDecisionBridgeFill"
	readiness_bridge.add_child(readiness_fill)
	var readiness_gate = make_gpt_gate(rect_full(0.828, 0.610, 0.884, 0.825), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.10))
	readiness_gate.name = "HandTrayDecisionBridgeGate"
	art.add_child(readiness_gate)
	var readiness_source = make_gpt_edge_rail(rect_full(0.505, 0.615, 0.558, 0.825), Color(accent.r, accent.g, accent.b, 0.18))
	readiness_source.name = "HandTrayDecisionSourceNode"
	art.add_child(readiness_source)
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	if mode == "offline" and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "":
		var decision_route = make_gpt_route_rail(rect_full(0.685, 0.735, 0.930, 0.840), Color(0.006, 0.016, 0.018, 0.44))
		decision_route.name = "HandTrayDrawDecisionRoute"
		art.add_child(decision_route)
		var decision_fill = make_gpt_meter_fill(rect_full(0.040, 0.260, 0.820, 0.740), Color(accent.r, accent.g, accent.b, 0.28))
		decision_fill.name = "HandTrayDrawDecisionFill"
		decision_route.add_child(decision_fill)
		var decision_gate = make_gpt_gate(rect_full(0.820, 0.640, 0.880, 0.930), Color(0.006, 0.014, 0.016, 0.54))
		decision_gate.name = "HandTrayDrawDecisionGate"
		art.add_child(decision_gate)
		var source_is_gang = str(offline_last_draw.get("source", "")) == "gang"
		var source_node = make_gpt_gate(rect_full(0.635, 0.625, 0.685, 0.895), Color(accent.r, accent.g, accent.b, 0.22 if source_is_gang else 0.14))
		source_node.name = "HandTrayDrawSourceNode"
		art.add_child(source_node)
		var replacement_gate = make_gpt_gate(rect_full(0.892, 0.610, 0.940, 0.950), Color(0.86, 0.68, 0.30, 0.24 if source_is_gang else 0.10))
		replacement_gate.name = "HandTrayReplacementGate"
		art.add_child(replacement_gate)
		var tick = add_gpt_tick_strip(art, rect_full(0.725, 0.585, (0.745) + float(1) * (0.055), 0.705), Color(accent.r, accent.g, accent.b, 0.23), "HandTrayDrawDecisionTick_0")
		var draw_badge = make_gpt_edge_rail(rect_full(0.865, 0.050, 0.990, 0.930), Color(0.030, 0.044, 0.040, 0.80))
		draw_badge.name = "HandTrayLastDrawBadge"
		art.add_child(draw_badge)
		var badge_label = "杠" if source_is_gang else "摸"
		var draw_label = make_label(draw_badge, badge_label, 11, Color(0.96, 0.86, 0.56, 0.92), true)
		draw_label.name = "HandTrayLastDrawLabel"
		draw_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		draw_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		apply_rect(draw_label, rect_full(0.0, 0.08, 1.0, 0.92))
		configure_clipped_label(draw_label)
	if force_danger_warning or has_pending_danger_discard():
		focus.modulate = Color(1, 1, 1, 0.78)
		readiness_fill.modulate = Color(1, 1, 1, 0.82)
	return art


func draw_hand_tray_state_art(parent: Control) -> Control:
