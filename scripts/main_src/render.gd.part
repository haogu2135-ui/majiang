func draw_hand_tutorial_hint_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "HandTrayTutorialHintArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var scroll_texture = add_illustration_texture(art, "hand_tutorial_scroll", rect_full(-0.045, -0.180, 1.045, 1.180), 0.14, false)
	if scroll_texture != null:
		scroll_texture.name = "HandTrayTutorialScrollTexture"
	var hand_tutorial_gpt_key := "hand_tutorial_gpt_hint"
	var hand_tutorial_gpt_texture = add_optional_gpt_illustration_texture(art, hand_tutorial_gpt_key, rect_full(-0.045, -0.180, 1.045, 1.180), 0.24, false)  # r221 denser tutorial
	if hand_tutorial_gpt_texture != null:
		hand_tutorial_gpt_texture.name = "HandTutorialGPTTexture"
	var guide_texture = add_optional_gpt_illustration_texture(art, "guide_pointing_finger", rect_full(0.790, 0.120, 0.970, 0.720), 0.32, true)
	if guide_texture != null:
		guide_texture.name = "HandTutorialPointingFingerTexture"
		art.move_child(hand_tutorial_gpt_texture, min(1, art.get_child_count() - 1))
	var accent = Color(0.38, 0.76, 0.60)
	var seal = make_gpt_gate(rect_full(0.036, 0.150, 0.145, 0.700), Color(accent.r, accent.g, accent.b, 0.24))
	seal.name = "HandTrayTutorialSeal"
	art.add_child(seal)
	if add_lucide_icon(seal, "mouse-pointer-click", rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.94, 0.78, 0.90)) == null:
		var fallback = make_label(seal, "点", 12, Color(0.96, 0.94, 0.78, 0.90), true)
		fallback.name = "HandTrayTutorialSealGlyph"
		apply_rect(fallback, rect_full(0.0, 0.0, 1.0, 1.0))
	var rail = make_gpt_route_rail(rect_full(0.195, 0.600, 0.880, 0.720), Color(0.010, 0.028, 0.030, 0.62))
	rail.name = "HandTrayTutorialStepRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.680, 0.740), Color(accent.r, accent.g, accent.b, 0.48))
	fill.name = "HandTrayTutorialStepFill"
	rail.add_child(fill)
	for i in range(3):
		var center = 0.230 + float(i) * 0.205
		var node = make_gpt_gate(rect_full(center - 0.018, 0.535, center + 0.018, 0.785), Color(accent.r, accent.g, accent.b, 0.50 if i == 0 else 0.24))
		node.name = "HandTrayTutorialStepNode_%d" % i
		art.add_child(node)
	var target = make_gpt_edge_rail(rect_full(0.770, 0.220, 0.900, 0.840), Color(0.018, 0.038, 0.040, 0.46))
	target.name = "HandTrayTutorialTargetTile"
	art.add_child(target)
	var target_label = make_label(target, "牌", 14, Color(0.96, 0.88, 0.58, 0.92), true)
	target_label.name = "HandTrayTutorialTargetGlyph"
	apply_rect(target_label, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var ripple = make_gpt_plate_rect(rect_full(0.740 - float(i) * 0.016, 0.160 - float(i) * 0.025, 0.930 + float(i) * 0.016, 0.900 + float(i) * 0.025), Color(accent.r, accent.g, accent.b, 0.060 - float(i) * 0.010), "ui_jade_reading_plate")
		ripple.name = "HandTrayTutorialClickRipple_%d" % i
		art.add_child(ripple)
		art.move_child(ripple, max(0, target.get_index()))
	var arrow = make_label(art, ">", 16, Color(0.96, 0.86, 0.48, 0.82), true)
	arrow.name = "HandTrayTutorialArrow"
	apply_rect(arrow, rect_full(0.680, 0.255, 0.745, 0.710))
	draw_hand_tutorial_discard_flow(art, accent)
	fill.modulate = Color(1, 1, 1, 0.82)
	arrow.modulate = Color(1, 1, 1, 0.80)
	return art


func draw_item_toast_art(toast_bg: Control, item_id: String, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var charm_texture = add_illustration_texture(toast_bg, "item_activation_charm", rect_full(0.055, 0.010, 0.940, 0.980), 0.16, false)
	if charm_texture != null:
		charm_texture.name = "ToastItemActivationTexture"
		toast_bg.move_child(charm_texture, 0)
	var badge = make_gpt_gate(rect_full(0.820, 0.185, 0.870, 0.815), Color(accent.r, accent.g, accent.b, 0.22))
	badge.name = "ToastItemBadge"
	toast_bg.add_child(badge)
	var core = make_gpt_plate_rect(rect_full(0.220, 0.220, 0.780, 0.780), Color(accent.r, accent.g, accent.b, 0.40), "ui_jade_reading_plate")
	core.name = "ToastItemCore"
	badge.add_child(core)
	var item_mark = make_label(core, item_short_mark(item_id), 10, Color(0.98, 0.94, 0.78), true)
	apply_rect(item_mark, rect_full(0.0, 0.0, 1.0, 1.0))
	var activation_route = make_gpt_route_rail(rect_full(0.690, 0.700, 0.858, 0.780), Color(0.006, 0.016, 0.018, 0.42))
	activation_route.name = "ToastItemActivationRoute"
	toast_bg.add_child(activation_route)
	var activation_fill = make_gpt_meter_fill(rect_full(0.040, 0.250, 0.780, 0.750), Color(accent.r, accent.g, accent.b, 0.30))
	activation_fill.name = "ToastItemActivationFill"
	activation_route.add_child(activation_fill)
	var gate = make_gpt_gate(rect_full(0.800, 0.255, 0.825, 0.475), Color(0.96, 0.82, 0.42, 0.28))
	gate.name = "ToastItemActivationGate"
	toast_bg.add_child(gate)
	for i in range(3):
		var top = 0.255 + float(i) * 0.165
		var pip = make_gpt_gate(rect_full(0.878, top, 0.892, top + 0.070), Color(accent.r, accent.g, accent.b, 0.44))
		pip.name = "ToastItemPip_%d" % i
		toast_bg.add_child(pip)
	var tick = add_gpt_tick_strip(toast_bg, rect_full(0.718, 0.270, (0.718) + float(1) * (0.044) + (0.014), 0.390), Color(accent.r, accent.g, accent.b, 0.28), "ToastItemActivationTick_0")
	draw_item_toast_inventory_route(toast_bg, item_id, accent)
	draw_item_toast_effect_route(toast_bg, item_id, accent)


func draw_item_toast_denied_route(toast_bg: Control, item_id: String, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var route = Control.new()
	route.name = "ToastItemDeniedRoute"
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(route, rect_full(0.505, 0.560, 0.890, 0.900))
	toast_bg.add_child(route)
	var rail = make_gpt_route_rail(rect_full(0.070, 0.500, 0.930, 0.600), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "ToastItemDeniedRail"
	route.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.470, 0.750), Color(accent.r, accent.g, accent.b, 0.20))
	fill.name = "ToastItemDeniedFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.315, 0.090, 0.790), Color(accent.r, accent.g, accent.b, 0.16))
	source.name = "ToastItemDeniedSource"
	route.add_child(source)
	var lock = make_gpt_edge_rail(rect_full(0.760, 0.150, 0.950, 0.860), Color(accent.r, accent.g, accent.b, 0.16))
	lock.name = "ToastItemDeniedLock"
	route.add_child(lock)
	var glyph = make_label(lock, item_short_mark(item_id), 9, Color(0.98, 0.90, 0.70, 0.82), true)
	glyph.name = "ToastItemDeniedGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var block = add_gpt_tick_strip(route, rect_full(0.300, 0.280, (0.300) + float(1) * (0.145) + (0.040), 0.720), Color(accent.r, accent.g, accent.b, 0.14), "ToastItemDeniedBlock_0")
	var tick = add_gpt_tick_strip(route, rect_full(0.585, 0.175, (0.600) + float(1) * (0.055), 0.440), Color(accent.r, accent.g, accent.b, 0.20), "ToastItemDeniedTick_0")
	fill.modulate = Color(1, 1, 1, 0.78)
	lock.modulate = Color(1, 1, 1, 0.82)
	return route


func draw_item_toast_effect_route(toast_bg: Control, item_id: String, accent: Color) -> Control:
	var route = Control.new()
	route.name = "ToastItemEffectRoute"
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(route, rect_full(0.595, 0.205, 0.895, 0.625))
	toast_bg.add_child(route)
	var rail = make_gpt_route_rail(rect_full(0.045, 0.475, 0.915, 0.590), Color(0.006, 0.016, 0.018, 0.40))
	rail.name = "ToastItemEffectRail"
	route.add_child(rail)
	var strength = toast_item_effect_strength(item_id)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.900 * strength, 0.740), Color(accent.r, accent.g, accent.b, 0.25))
	fill.name = "ToastItemEffectFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.320, 0.085, 0.780), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "ToastItemEffectSource"
	route.add_child(source)
	var gate = make_gpt_gate(rect_full(0.870, 0.240, 0.965, 0.840), Color(0.96, 0.82, 0.42, 0.22))
	gate.name = "ToastItemEffectGate"
	route.add_child(gate)
	var node = add_gpt_tick_strip(route, rect_full(0.230, 0.245, (0.230) + float(2) * (0.150) + (0.028), 0.750), Color(accent.r, accent.g, accent.b, 0.22), "ToastItemEffectNode_0")
	var tick = add_gpt_tick_strip(route, rect_full(0.610, 0.170, (0.624) + float(1) * (0.060), 0.430), Color(accent.r, accent.g, accent.b, 0.22), "ToastItemEffectTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.40, 0.70).from(0.92)
		tw.parallel().tween_property(gate, "modulate:a", 0.46, 0.70).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.92, 0.70).from(0.40)
		tw.parallel().tween_property(gate, "modulate:a", 0.90, 0.70).from(0.46)
	return route

func draw_item_toast_inventory_route(toast_bg: Control, item_id: String, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var route = Control.new()
	route.name = "ToastItemInventoryRoute"
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(route, rect_full(0.145, 0.180, 0.520, 0.600))
	toast_bg.add_child(route)
	var count = max(0, get_item_count(item_id))
	var stock_strength = clamp(float(count + 1) / 4.0, 0.18, 1.0)
	var rail = make_gpt_route_rail(rect_full(0.055, 0.500, 0.930, 0.590), Color(0.006, 0.016, 0.018, 0.40))
	rail.name = "ToastItemInventoryRail"
	route.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.900 * stock_strength, 0.750), Color(accent.r, accent.g, accent.b, 0.24 if count > 0 else 0.14))
	fill.name = "ToastItemInventoryFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.330, 0.085, 0.770), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "ToastItemInventorySource"
	route.add_child(source)
	var gate = make_gpt_gate(rect_full(0.870, 0.260, 0.960, 0.840), Color(0.96, 0.82, 0.42, 0.20 + 0.06 * stock_strength))
	gate.name = "ToastItemInventoryGate"
	route.add_child(gate)
	var count_node = make_gpt_gate(rect_full(0.715, 0.175, 0.850, 0.905), Color(accent.r, accent.g, accent.b, 0.18 if count > 0 else 0.10))
	count_node.name = "ToastItemInventoryCountNode"
	route.add_child(count_node)
	var count_label = make_label(count_node, str(count), 9, Color(0.98, 0.92, 0.70, 0.90 if count > 0 else 0.68), true)
	count_label.name = "ToastItemInventoryCountGlyph"
	apply_rect(count_label, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var left = 0.190 + float(i) * 0.135
		var lit = count > i
		var node = make_gpt_tick_strip(rect_full(left, 0.255, left + 0.030, 0.745), Color(accent.r, accent.g, accent.b, 0.24 if lit else 0.09))
		node.name = "ToastItemInventoryStockNode_%d" % i
		route.add_child(node)
	var tick = add_gpt_tick_strip(route, rect_full(0.535, 0.170, (0.549) + float(1) * (0.055), 0.430), Color(accent.r, accent.g, accent.b, 0.21), "ToastItemInventoryTick_0")
	if count <= 0:
		var empty_lock = make_gpt_gate(rect_full(0.680, 0.080, 0.850, 0.155), Color(0.72, 0.54, 0.36, 0.20))
		empty_lock.name = "ToastItemInventoryEmptyLock"
		route.add_child(empty_lock)
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.80)
	return route


func draw_last_discard_focus_marker(parent: Control, seat: int, table_size: Vector2 = Vector2.ZERO) -> Control:
	# r210: GPT chrome conversion
	var marker_rect = last_discard_focus_marker_rect_for_seat(seat, table_size)
	if marker_rect.size == Vector2.ZERO:
		return null
	var tile = get_last_discard()
	var marker = Control.new()
	marker.name = "LastDiscardFocusMarker"
	marker.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(marker, marker_rect)
	parent.add_child(marker)
	var aura_texture = add_illustration_texture(marker, "last_discard_aura", rect_full(-0.170, -0.220, 1.170, 1.170), 0.18, false)
	if aura_texture != null:
		aura_texture.name = "LastDiscardAuraTexture"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var aura_texture_tw := create_screen_tween()
			aura_texture_tw.set_loops(6)
			aura_texture_tw.tween_property(aura_texture, "modulate:a", 0.06, 0.42).from(0.18)
			aura_texture_tw.parallel().tween_property(aura_texture, "scale", Vector2(1.06, 1.06), 0.42).from(Vector2(0.96, 0.96))
			aura_texture_tw.tween_property(aura_texture, "modulate:a", 0.18, 0.42).from(0.06)
			aura_texture_tw.parallel().tween_property(aura_texture, "scale", Vector2(0.96, 0.96), 0.42).from(Vector2(1.06, 1.06))
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var glow = make_gpt_gate(rect_full(0.04, 0.04, 0.96, 0.96), Color(accent.r, accent.g, accent.b, 0.10))
	glow.name = "LastDiscardFocusGlow"
	marker.add_child(glow)
	var route = make_gpt_route_rail(rect_full(0.150, 0.765, 0.850, 0.875), Color(0.006, 0.016, 0.018, 0.50))
	route.name = "LastDiscardFocusRoute"
	marker.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.780, 0.740), Color(accent.r, accent.g, accent.b, 0.32))
	route_fill.name = "LastDiscardFocusRouteFill"
	route.add_child(route_fill)
	var source_dot = make_gpt_gate(rect_full(0.070, 0.690, 0.170, 0.940), Color(accent.r, accent.g, accent.b, 0.26))
	source_dot.name = "LastDiscardFocusSourceDot"
	marker.add_child(source_dot)
	var response_bridge = make_gpt_route_rail(rect_full(0.205, 0.610, 0.915, 0.705), Color(0.006, 0.016, 0.018, 0.46))
	response_bridge.name = "LastDiscardResponseBridge"
	marker.add_child(response_bridge)
	var response_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.820, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	response_fill.name = "LastDiscardResponseFill"
	response_bridge.add_child(response_fill)
	var response_gate = make_gpt_gate(rect_full(0.865, 0.545, 0.970, 0.790), Color(accent.r, accent.g, accent.b, 0.20))
	response_gate.name = "LastDiscardResponseGate"
	marker.add_child(response_gate)
	var response_source = make_gpt_plate_rect(rect_full(0.180, 0.555, 0.265, 0.765), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	response_source.name = "LastDiscardResponseSource"
	marker.add_child(response_source)
	var tick = add_gpt_tick_strip(marker, rect_full(0.360, 0.515, (0.388) + float(2) * (0.135), 0.790), Color(accent.r, accent.g, accent.b, 0.24), "LastDiscardResponseTick_0")
	for i in range(3):
		var inset = 0.055 + float(i) * 0.045
		var ripple = make_gpt_plate_rect(rect_full(inset, inset, 1.0 - inset, 1.0 - inset), Color(accent.r, accent.g, accent.b, 0.020), "ui_jade_reading_plate")
		ripple.name = "LastDiscardFocusRipple_%d" % i
		marker.add_child(ripple)
		marker.move_child(ripple, max(0, glow.get_index()))
	# During a claim window the center response window is the primary signal;
	# keep the river marker structural but quiet so the same discard is not read
	# as two competing response targets.
	if mode == "offline" and offline_phase == "pending_claim":
		glow.modulate.a = 0.42
		route.visible = false
		response_bridge.visible = false
		for ripple_node in marker.get_children():
			if ripple_node is Control and str(ripple_node.name).begins_with("LastDiscardFocusRipple_"):
				(ripple_node as Control).visible = false
	# The center console already renders the last tile outside the claim window.
	# Keep the enlarged duplicate only while a claim response needs a focal tile.
	var center_already_shows_last := true
	if not center_already_shows_last:
		var focus_tile_size = Vector2(44, 60)
		var focus_tile = make_tile_view(tile, focus_tile_size, false, Callable(), true)
		focus_tile.name = "LastDiscardFocusActualTile"
		focus_tile.z_index = 8
		marker.add_child(focus_tile)
		apply_centered_rect(focus_tile, Vector2(0.50, 0.48), focus_tile_size)
	var badge = make_badge(marker, rect_full(0.020, -0.190, 1.020, 0.060), "%s 刚打 %s" % [pending_claim_source_badge_text(seat), tile_label(tile)], 8, Color(0.018, 0.036, 0.038, 0.72), Color(0.88, 0.68, 0.32, 0.28), Color(0.96, 0.92, 0.76))
	badge.name = "LastDiscardFocusBadge"
	badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_lucide_icon(marker, "sparkles", rect_full(0.68, -0.28, 1.10, 0.22), Color(0.98, 0.86, 0.42, 0.72))
	if fx_enabled_effective():
		marker.modulate = Color(1, 1, 1, 0)
		marker.scale = Vector2(0.92, 0.92)
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(marker, "modulate:a", 1.0, 0.16).from(0.0)
		tw.tween_property(marker, "scale", Vector2(1.0, 1.0), 0.18).from(Vector2(0.92, 0.92)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tw.tween_property(route_fill, "modulate:a", 0.42, 0.36).from(0.88)
	return marker


func draw_line_edit_input_art(edit: Control, label_text: String) -> Control:
	# r213: GPT chrome conversion
	var art_id = line_edit_art_id(label_text)
	var art = Control.new()
	art.name = "LineEditInputArt_%s" % art_id
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.show_behind_parent = true
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	edit.add_child(art)
	var accent = line_edit_accent(label_text)
	var field_plate = add_optional_gpt_illustration_texture(art, "ui_online_form_field", rect_full(0.000, 0.000, 1.000, 1.000), 0.32, false)
	if field_plate == null:
		field_plate = add_optional_gpt_illustration_texture(art, "ui_chat_lane_plate", rect_full(0.000, 0.000, 1.000, 1.000), 0.28, false)
	if field_plate != null:
		field_plate.name = "LineEditGptFieldPlate_%s" % art_id
		field_plate.modulate = Color(
			clampf(0.55 + accent.r * 0.45, 0.30, 1.15),
			clampf(0.55 + accent.g * 0.45, 0.30, 1.15),
			clampf(0.55 + accent.b * 0.45, 0.30, 1.15),
			0.38
		)
	var surface = make_gpt_plate_rect(rect_full(0.006, 0.055, 0.994, 0.945), Color(0.018, 0.026, 0.024, 0.64), "ui_dark_scrim")
	surface.name = "LineEditInputSurface_%s" % art_id
	art.add_child(surface)
	var inner = make_gpt_plate_rect(rect_full(0.032, 0.210, 0.968, 0.790), Color(0.010, 0.018, 0.018, 0.46), "ui_dark_scrim")
	inner.name = "LineEditInputInner_%s" % art_id
	art.add_child(inner)
	var accent_wash = make_gpt_edge_rail(rect_full(0.020, 0.320, 0.027, 0.680), Color(accent.r, accent.g, accent.b, 0.12))
	accent_wash.name = "LineEditInputAccentWash_%s" % art_id
	art.add_child(accent_wash)
	var focus_glow = make_gpt_gate(rect_full(0.925, 0.505, 0.950, 0.516), Color(accent.r, accent.g, accent.b, 0.018))
	focus_glow.name = "LineEditInputFocusGlow_%s" % art_id
	art.add_child(focus_glow)
	var corner_seal = make_gpt_gate(rect_full(0.930, 0.275, 0.954, 0.405), Color(accent.r, accent.g, accent.b, 0.026))
	corner_seal.name = "LineEditInputCornerSeal_%s" % art_id
	art.add_child(corner_seal)
	var corner_glyph = make_label(corner_seal, line_edit_corner_glyph(art_id), 5, Color(0.98, 0.92, 0.66, 0.18), true)
	corner_glyph.name = "LineEditInputCornerGlyph_%s" % art_id
	apply_rect(corner_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		art.modulate.a = 0.0
		var intro := create_screen_tween()
		intro.tween_property(art, "modulate:a", 1.0, 0.22).from(0.0).set_ease(Tween.EASE_OUT)
	return art


func draw_loading_progress_feedback(parent: Control, progress_ratio: float = 0.72) -> Control:
	# r212: GPT chrome conversion
