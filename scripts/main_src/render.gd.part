	var autosave_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.820, 0.740), Color(0.82, 0.66, 0.36, 0.26))  # r449 warm
	autosave_fill.name = "ExitConfirmAutosaveFill"
	autosave_route.add_child(autosave_fill)
