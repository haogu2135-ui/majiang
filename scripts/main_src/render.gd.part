func draw_rule_tile_pattern_group(parent: Control, key: String, title_text: String, tiles: Array[String], rect: Rect2, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var group = make_gpt_plate_rect(rect, Color(0.018, 0.032, 0.030, 0.72), "ui_jade_reading_plate")
	group.name = "RulePatternExampleGroup_%s" % key
	parent.add_child(group)
	var label = make_label(group, title_text, 8, Color(0.96, 0.90, 0.66, 0.92), true)
	label.name = "RulePatternExampleLabel_%s" % key
	apply_rect(label, rect_full(0.020, 0.070, 0.245, 0.930))
	configure_clipped_label(label)
	var tile_count = max(1, tiles.size())
	var tile_width = min(0.160, 0.690 / float(tile_count))
	var start = 0.270 + max(0.0, (0.700 - tile_width * float(tile_count)) * 0.5)
	for i in range(tile_count):
		var tile = make_tile_view(str(tiles[i]), Vector2(10, 14), false, Callable(), false)
		tile.name = "RulePatternExampleTile_%s_%d" % [key, i]
		group.add_child(tile)
		var left = start + float(i) * tile_width
		apply_rect(tile, rect_full(left, 0.120, left + tile_width * 0.860, 0.900))


func draw_rule_tile_shape_example(parent: Control) -> void:
	draw_rule_tile_pattern_group(parent, "sequence", "顺", ["1W", "2W", "3W"], rect_full(0.010, 0.060, 0.490, 0.460), Color(0.42, 0.74, 0.62))
	draw_rule_tile_pattern_group(parent, "triplet", "刻", ["1B", "1B", "1B"], rect_full(0.510, 0.060, 0.990, 0.460), Color(0.52, 0.68, 0.86))
