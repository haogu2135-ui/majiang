	gate.name = "LoadingProgressGate"
	art.add_child(gate)
	var ready = make_gpt_gate(rect_full(0.705, 0.605, 0.870, 0.850), Color(0.40, 0.70, 0.58, 0.025))
	ready.name = "LoadingProgressReadyNode"
	art.add_child(ready)
