	apply_rect(art, rect_full(0.045, 0.690, 0.955, 0.940))
	parent.add_child(art)
	var action_backplate = parent.find_child("OnlineLobbyActionClusterBackplate", false, false)
	if action_backplate != null:
		parent.move_child(art, min(action_backplate.get_index() + 1, parent.get_child_count() - 1))
	else:
		parent.move_child(art, max(0, parent.get_child_count() - 3))
	return art

