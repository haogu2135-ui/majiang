		branch.name = "SettingsSectionRouteBranch_%s" % str(item[0])
		art.add_child(branch)
		var source = make_gpt_plate_rect(rect_full(float(item[1]) - 0.020, 0.045, float(item[1]) + 0.020, 0.115), item[3], "ui_jade_reading_plate")
		source.name = "SettingsSectionRouteSource_%s" % str(item[0])
		art.add_child(source)
		var node = make_gpt_gate(rect_full(float(item[1]) - 0.026, float(item[2]) - 0.025, float(item[1]) + 0.026, float(item[2]) + 0.025), item[3])
		node.name = "SettingsSectionRouteNode_%s" % str(item[0])
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.280, 0.020, (0.295) + float(3) * (0.120), 0.125), Color(0.78, 0.64, 0.36, 0.20), "SettingsSectionRouteTick_0")
	return art


func draw_settings_section_signal(parent: Control, title_text: String) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingsSectionSignal_%s" % title_text
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.585, 0.035, 0.965, 0.155))
	parent.add_child(art)
	var accent = settings_section_color(title_text)
	# Keep generated signal chrome below the native section icon so any baked
	# circles/slots cannot read as real controls.
	var signal_panel_key := "settings_section_signal_panel"
	var signal_panel = add_optional_gpt_illustration_texture(art, signal_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.025, false)
	if signal_panel != null:
		signal_panel.name = "SettingsSectionSignalPanelTexture_%s" % title_text
		art.move_child(signal_panel, 0)
	var icon = make_gpt_edge_rail(rect_full(0.000, 0.155, 0.115, 0.845), Color(accent.r, accent.g, accent.b, 0.22))
	icon.name = "SettingsSectionSignalIcon_%s" % title_text
	art.add_child(icon)
	var icon_name = settings_section_icon(title_text)
	if icon_name != "":
		add_lucide_icon(icon, icon_name, rect_full(0.22, 0.22, 0.78, 0.78), Color(0.96, 0.90, 0.64, 0.82))
	return art


func draw_shop_buy_button_art(button: Control, cost: int, affordable: bool) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "ShopBuyButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
