		call_deferred("sync_settings_large_text_scroll_status", settings_scroll, settings_large_text_status)
		audio_section_rect = rect_full(0.025, 0.000, 0.975, 0.275)
		play_section_rect = rect_full(0.025, 0.305, 0.975, 0.625)
