	var commit_tick = add_gpt_tick_strip(flow, rect_full(0.695, 0.565, (0.709) + float(1) * (0.055), 0.735), Color(accent.r, accent.g, accent.b, 0.20), "HandTrayTutorialCommitTick_0")
	fill.modulate = Color(1, 1, 1, 0.82)
