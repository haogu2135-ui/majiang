func draw_meld_summary_route_art(parent: Control, total_melds: int, active_seats: Array[int]) -> Control:
	# r210: GPT chrome conversion
	var art = Control.new()
	art.name = "MeldSummaryRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.285, 0.535, 0.715, 0.655))
	parent.add_child(art)
	parent.move_child(art, 0)
	var accent = Color(0.82, 0.66, 0.32)
	var jade = Color(0.42, 0.72, 0.60)
	var fill_fraction = clamp(float(total_melds) / 8.0, 0.16, 1.0)
	var spine = make_gpt_route_rail(rect_full(0.055, 0.430, 0.945, 0.565), Color(0.006, 0.014, 0.016, 0.42))
	spine.name = "MeldSummarySpine"
	art.add_child(spine)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * fill_fraction, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	fill.name = "MeldSummarySpineFill"
	spine.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.030, 0.300, 0.100, 0.700), Color(jade.r, jade.g, jade.b, 0.18))
	source.name = "MeldSummarySource"
	art.add_child(source)
	var gate = make_gpt_gate(rect_full(0.890, 0.270, 0.965, 0.730), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "MeldSummaryGate"
	art.add_child(gate)
	var glyph = make_label(gate, "%d" % min(9, total_melds), 8, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "MeldSummaryGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive = make_gpt_edge_rail(rect_full(0.735, 0.025, 0.845, 0.315), Color(accent.r, accent.g, accent.b, 0.13))
	archive.name = "MeldSummaryArchive"
	art.add_child(archive)
	var archive_glyph = make_label(archive, "副", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	archive_glyph.name = "MeldSummaryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var seat_count = min(4, active_seats.size())
	for i in range(seat_count):
		var seat = active_seats[i]
		var col = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else jade
		var left = 0.185 + float(i) * 0.170
		var branch = make_gpt_plate_rect(rect_full(left, 0.170, left + 0.120, 0.260), Color(0.006, 0.014, 0.016, 0.34), "ui_jade_reading_plate")
		branch.name = "MeldSummarySeatBranch_%d" % seat
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760, 0.750), Color(col.r, col.g, col.b, 0.20))
		branch_fill.name = "MeldSummarySeatBranchFill_%d" % seat
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(left + 0.035, 0.050, left + 0.085, 0.235), Color(col.r, col.g, col.b, 0.22))
		node.name = "MeldSummarySeatNode_%d" % seat
		art.add_child(node)
	for i in range(min(4, max(2, total_melds))):
		var left = 0.245 + float(i) * 0.105
		var tick = make_gpt_tick_strip(rect_full(left, 0.660, left + 0.018, 0.845), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		tick.name = "MeldSummaryTick_0"
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.790 + float(i) * 0.045, 0.760, 0.816 + float(i) * 0.045, 0.905), Color(jade.r, jade.g, jade.b, 0.20 - float(i) * 0.040))
		pip.name = "MeldSummaryArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.38, 0.78).from(0.86)
		tw.tween_property(fill, "modulate:a", 0.86, 0.78).from(0.38)
	return art


func seat_meld_is_vertical(seat: int) -> bool:
	# Left/right seats stack melds vertically; top/bottom seats run horizontally.
	return seat == 1 or seat == 3


func seat_meld_face_rotation(seat: int) -> float:
	# All meld faces point toward table center (same convention as table view).
	# bottom 0°, right -90°, top 180°, left +90°.
	match seat:
		0:
			return 0.0
		1:
			return -PI * 0.5
		2:
			return PI
		3:
			return PI * 0.5
		_:
			return 0.0


func draw_melds(parent: Control) -> void:
	var proxy_order := 1000
	var compact_melds := effective_viewport_size().y <= 560.0
	for layout in MELD_LAYOUTS:
		var seat = int(layout[0])
		var meld_list = get_melds(seat)
		if meld_list.is_empty():
			continue
		# Soft seat lane; melds sit next to the player plaque.
		draw_meld_lane_art(parent, seat, layout[1], meld_list.size())
		var vertical: bool = seat_meld_is_vertical(seat)
		var area: Container
		if vertical:
			var side_grid := GridContainer.new()
			side_grid.columns = 2
			area = side_grid
		else:
			area = HBoxContainer.new()
		area.name = "MeldArea_%d" % seat
		configure_passive_container(area)
		area.z_index = 10  # r453 keep meld faces above any same-pixel river fallback
		area.add_theme_constant_override("separation", 3)
		if area is BoxContainer:
			(area as BoxContainer).alignment = BoxContainer.ALIGNMENT_BEGIN
		apply_rect(area, layout[1])
		parent.add_child(area)
		var meld_tile_size := Vector2.ZERO
		if vertical and compact_melds:
			meld_tile_size = Vector2(21, 28)
		elif not vertical and compact_melds:
			meld_tile_size = Vector2(14, 21)
		elif not vertical and meld_list.size() >= 4:
			meld_tile_size = Vector2(20, 28)
		for meld_index in range(meld_list.size()):
			var meld = meld_list[meld_index]
			if typeof(meld) == TYPE_ARRAY:
				var meld_tiles := meld as Array
				# Chi/peng/gang share one lane orientation per seat — no kind-specific layout.
				var meld_group := make_meld_group_view(meld_tiles, seat, false, proxy_order, meld_tile_size)
				meld_group.name = "MeldGroup_%d_%s" % [meld_index, meld_kind_label(meld_tiles)]
				area.add_child(meld_group)
				proxy_order += meld_tiles.size() + 1

func make_soft_depth_panel(parent: Control, rect: Rect2, color: Color, radius: int, shadow_size: int = 0) -> Panel:
	# Soft depth via GPT plate host (no StyleBoxFlat paint slabs).
	return make_panel(parent, rect, color, radius, Color(0.0, 0.0, 0.0, 0.0), shadow_size)


func draw_menu_card_entry_art(button: Control, color: Color, icon_name: String = "") -> Control:
	# r213: GPT chrome conversion
	var has_menu_stage_overlay := optional_gpt_illustration_texture("menu_primary_3d_stage_overlay") != null
	var art = Control.new()
	art.name = "MenuCardEntryArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.modulate = Color(1, 1, 1, 0.96)
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var card_shadow_alpha := 0.10 if has_menu_stage_overlay else 0.18
	var card_depth_alpha := 0.22 if has_menu_stage_overlay else 0.32
	var card_sheen_alpha := 0.16 if has_menu_stage_overlay else 0.22
	var cast_shadow = make_soft_depth_panel(art, rect_full(0.020, 0.100, 0.990, 1.035), Color(0.0, 0.0, 0.0, card_shadow_alpha), 18)
	cast_shadow.name = "MenuCardCastShadow"
	art.move_child(cast_shadow, 0)
	var depth_edge = make_soft_depth_panel(art, rect_full(0.050, 0.825, 0.950, 0.985), Color(0.22, 0.14, 0.06, card_depth_alpha), 14)
	depth_edge.name = "MenuCardDepthEdge"
	# Menu cards share the same quiet reading material as rules/settings. The
	# authored dark-scrim center crop keeps the scene recognizable while removing
	# the repeated high-frequency jade plate behind every line of copy.
	var card_face = make_gpt_center_crop_plate_rect(rect_full(0.030, 0.045, 0.970, 0.955), Color(0.012, 0.024, 0.022, 0.82), "ui_dark_scrim", 0.22)
	card_face.name = "MenuCardGptFace"
	art.add_child(card_face)
	var surface = make_layout_host(rect_full(0.030, 0.045, 0.970, 0.955))
	surface.name = "MenuCardSurface"
	art.add_child(surface)
	var top_sheen = make_soft_depth_panel(art, rect_full(0.055, 0.060, 0.945, 0.185), Color(1.0, 0.92, 0.62, card_sheen_alpha), 12)
	top_sheen.name = "MenuCardTopSheen"
	var inner = make_layout_host(rect_full(0.060, 0.090, 0.940, 0.910))
	inner.name = "MenuCardInner"
	art.add_child(inner)
	var accent = make_gpt_route_rail(rect_full(0.075, 0.740, 0.925, 0.870), Color(color.r, color.g, color.b, 0.10))
	accent.name = "MenuCardAccent"
	art.add_child(accent)
	var icon_echo_left = 0.695 if icon_name != "" else 0.765
	var echo = make_layout_host(rect_full(icon_echo_left, 0.135, icon_echo_left + 0.220, 0.455))
	echo.name = "MenuCardIconEcho"
	art.add_child(echo)
	var focus = make_gpt_gate(rect_full(0.805, 0.720, 0.910, 0.925), Color(color.r, color.g, color.b, 0.13))
	focus.name = "MenuCardEntryFocus"
	art.add_child(focus)
	var arrow_icon = add_lucide_icon(focus, "chevron-right", rect_full(0.250, 0.250, 0.750, 0.750), Color(0.96, 0.90, 0.66, 0.86))
	if arrow_icon != null:
		arrow_icon.name = "MenuCardEntryArrow"
	else:
		var arrow = make_label(focus, ">", 11, Color(0.96, 0.90, 0.66, 0.86), true)
		arrow.name = "MenuCardEntryArrow"
		apply_rect(arrow, rect_full(0.0, 0.0, 1.0, 1.0))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(accent, "modulate:a", 0.46, 1.10).from(0.82)
		tw.tween_property(accent, "modulate:a", 0.82, 1.10).from(0.46)
		var focus_tw := create_screen_tween()
		focus_tw.set_loops(48)
		focus_tw.tween_property(focus, "modulate:a", 0.58, 0.82).from(1.0)
		focus_tw.tween_property(focus, "modulate:a", 1.0, 0.82).from(0.58)
	return art


func draw_menu_primary_3d_stage(parent: Control) -> Control:
	var has_stage_overlay := optional_gpt_illustration_texture("menu_primary_3d_stage_overlay") != null
	var stage_overlay = add_optional_gpt_illustration_texture(parent, "menu_primary_3d_stage_overlay", rect_full(0.0, 0.0, 1.0, 1.0), 0.38, false)
	if stage_overlay != null:
		stage_overlay.name = "MenuPrimary3DStageGPTOverlay"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			stage_overlay.modulate.a = 0.0
			var overlay_tw := create_screen_tween()
			overlay_tw.tween_property(stage_overlay, "modulate:a", 0.38, 0.36).from(0.0).set_delay(0.02).set_ease(Tween.EASE_OUT)
	var stage = Control.new()
	stage.name = "MenuPrimary3DStage"
	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(stage, rect_full(0.095, 0.300, 0.905, 0.795))
	parent.add_child(stage)
	var fallback_alpha := 0.16 if has_stage_overlay else 1.0
	stage.modulate.a = fallback_alpha
	var floor_shadow = make_soft_depth_panel(stage, rect_full(0.040, 0.200, 0.960, 0.940), Color(0.0, 0.0, 0.0, 0.14), 34)
	floor_shadow.name = "MenuPrimary3DFloorShadow"
	var back_rim = make_soft_depth_panel(stage, rect_full(0.165, 0.095, 0.835, 0.205), Color(0.96, 0.82, 0.48, 0.22), 999)
	back_rim.name = "MenuPrimary3DBackRim"
	var table_lip = make_soft_depth_panel(stage, rect_full(0.035, 0.660, 0.965, 0.930), Color(0.18, 0.115, 0.055, 0.34), 22)
	table_lip.name = "MenuPrimary3DTableLip"
	var table_highlight = make_soft_depth_panel(stage, rect_full(0.085, 0.615, 0.915, 0.725), Color(1.0, 0.90, 0.54, 0.18), 999)
	table_highlight.name = "MenuPrimary3DTableHighlight"
	for i in range(3):
		var left = 0.095 + float(i) * 0.325
		var shadow = make_soft_depth_panel(stage, rect_full(left, 0.250, left + 0.255, 0.790), Color(0.0, 0.0, 0.0, 0.08), 22)
		shadow.name = "MenuPrimary3DCardShadow_%d" % i
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		stage.modulate.a = 0.0
		stage.offset_top = 10.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(stage, "modulate:a", fallback_alpha, 0.34).from(0.0).set_delay(0.04).set_ease(Tween.EASE_OUT)
		tw.tween_property(stage, "offset_top", 0.0, 0.34).from(10.0).set_delay(0.04).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		if not has_stage_overlay:
			var breath := create_screen_tween()
			breath.set_loops(48)
			breath.tween_property(table_highlight, "modulate:a", 0.58, 1.6).from(0.86).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			breath.tween_property(table_highlight, "modulate:a", 0.86, 1.6).from(0.58).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	return stage

