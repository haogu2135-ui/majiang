func draw_rule_line_bullets(section: Control, lines: Array, section_index: int = -1) -> Control:
	# r214: bulk GPT chrome sweep
	var accent = Color(0.82, 0.66, 0.32)
	if section_index >= 0:
		var colors = [
			Color(0.86, 0.62, 0.34),
			Color(0.38, 0.70, 0.58),
			Color(0.62, 0.56, 0.86),
			Color(0.86, 0.72, 0.38),
		]
		accent = colors[clamp(section_index, 0, colors.size() - 1)]
	var guide = Control.new()
	guide.name = "RuleLineGuide_%d" % section_index
	guide.mouse_filter = Control.MOUSE_FILTER_IGNORE
	guide.set_anchors_preset(Control.PRESET_FULL_RECT)
	section.add_child(guide)
	return guide
	var rail = make_gpt_route_rail(rect_full(0.046, 0.355, 0.052, 0.850), Color(accent.r, accent.g, accent.b, 0.16))
	rail.name = "RuleLineRail_%d" % section_index
	guide.add_child(rail)
	for i in range(min(4, lines.size())):
		var top = 0.338 + float(i) * 0.155
		var bullet = make_gpt_plate_rect(rect_full(0.041, top, 0.058, top + 0.070), Color(accent.r, accent.g, accent.b, 0.34 - float(i) * 0.035), "ui_jade_reading_plate")
		bullet.name = "RuleLineBullet_%d_%d" % [section_index, i]
		guide.add_child(bullet)
		var pulse = make_gpt_tick_strip(rect_full(0.062, top + 0.022, 0.094, top + 0.048), Color(accent.r, accent.g, accent.b, 0.13))
		pulse.name = "RuleLinePulse_%d_%d" % [section_index, i]
		guide.add_child(pulse)
	var lead = make_gpt_edge_rail(rect_full(0.036, 0.210, 0.064, 0.310), Color(accent.r, accent.g, accent.b, 0.18))
	lead.name = "RuleLineLead_%d" % section_index
	guide.add_child(lead)
	return guide


func draw_rule_section_example_art(strip: Control, section_index: int, accent: Color) -> Control:
	var example = Control.new()
	example.name = "RuleSectionExampleArt_%d" % section_index
	example.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(example, rect_full(0.070, 0.545, 0.930, 0.930))
	strip.add_child(example)
	var example_texture = add_illustration_texture(example, "rules_example_table", rect_full(-0.020, -0.100, 1.020, 1.100), 0.08, false)
	if example_texture != null:
		example_texture.name = "RulesExampleTableTexture_%d" % section_index
	match section_index:
		0:
			draw_rule_goal_example(example, accent)
		1:
			draw_rule_tile_shape_example(example)
		2:
			draw_rule_special_shape_example(example, accent)
		3:
			draw_rule_action_example(example, accent)
		_:
			draw_rule_default_example(example, accent)
	draw_rule_example_completion_art(example, section_index, accent)
	return example

func draw_rule_section_path_art(section: Control, section_index: int, title_text: String) -> void:
	# r214: bulk GPT chrome sweep
	var colors = [
		Color(0.86, 0.62, 0.34),
		Color(0.38, 0.70, 0.58),
		Color(0.62, 0.56, 0.86),
		Color(0.38, 0.64, 0.82),
		Color(0.72, 0.48, 0.74),
		Color(0.86, 0.72, 0.38),
	]
	var icons = ["git-merge", "calculator", "list-checks", "layers", "sparkles", "mouse-pointer-click"]
	var accent: Color = colors[clamp(section_index, 0, colors.size() - 1)]
	var icon_name = str(icons[clamp(section_index, 0, icons.size() - 1)])
	var strip = make_gpt_ribbon(rect_full(0.835, 0.155, 0.965, 0.845), Color(accent.r, accent.g, accent.b, 0.125))
	strip.name = "RuleSectionArtStrip_%d" % section_index
	section.add_child(strip)
	# Settlement and fan sections have no matching bitmap panel yet. They keep a
	# neutral icon lane rather than borrowing the action illustration.
	var section_panel_keys = ["rules_section_goal_panel", "", "", "rules_section_meld_panel", "rules_section_special_panel", "rules_section_action_panel"]
	var panel_key = str(section_panel_keys[clamp(section_index, 0, section_panel_keys.size() - 1)])
	var strip_plate = add_optional_gpt_illustration_texture(strip, panel_key, rect_full(-0.02, -0.02, 1.02, 1.02), 0.72, false) if panel_key != "" else null
	var has_plate := strip_plate != null
	if has_plate:
		strip_plate.name = "RuleSectionArtGPTPlate_%d" % section_index
		strip.move_child(strip_plate, 0)
		# GPT plate carries the full illustration; keep only a slim gold title glyph
		# on top and skip the code-drawn badge/example clutter for a clean panel.
		var plate_glyph = make_label(strip, title_text.substr(0, 1), 20, Color(1.0, 0.94, 0.70, 0.94), true)
		plate_glyph.name = "RuleSectionPathGlyph_%d" % section_index
		apply_rect(plate_glyph, rect_full(0.620, 0.070, 0.940, 0.320))
	else:
		var example_panel = make_gpt_plate_rect(rect_full(0.045, 0.510, 0.955, 0.950), Color(0.052, 0.066, 0.052, 0.62), "ui_button_face_plate")
		example_panel.name = "RuleSectionExampleReadabilityPanel_%d" % section_index
		strip.add_child(example_panel)
		var strip_sheen = make_gpt_ribbon(rect_full(0.060, 0.070, 0.940, 0.115), Color(1.0, 0.88, 0.54, 0.070))
		strip_sheen.name = "RuleSectionArtTopSheen_%d" % section_index
		strip.add_child(strip_sheen)
		var badge = make_gpt_gate(rect_full(0.055, 0.115, 0.310, 0.400), Color(accent.r, accent.g, accent.b, 0.30))
		badge.name = "RuleSectionCategoryBadge_%d" % section_index
		strip.add_child(badge)
		add_lucide_icon(badge, icon_name, rect_full(0.220, 0.180, 0.780, 0.820), accent.lightened(0.32))
		var glyph = make_label(strip, title_text.substr(0, 1), 18, Color(0.98, 0.92, 0.66, 0.72), true)
		glyph.name = "RuleSectionPathGlyph_%d" % section_index
		apply_rect(glyph, rect_full(0.650, 0.110, 0.920, 0.440))
		draw_rule_section_example_art(strip, section_index, accent)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(strip, "modulate:a", 0.72, 1.2).from(1.0)
		tw.tween_property(strip, "modulate:a", 1.0, 1.2).from(0.72)


func draw_rule_special_shape_example(parent: Control, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var seven_pairs = make_gpt_plate_rect(rect_full(0.080, 0.205, 0.455, 0.820), Color(0.78, 0.62, 0.32, 0.18), "ui_jade_reading_plate")
	parent.add_child(seven_pairs)
