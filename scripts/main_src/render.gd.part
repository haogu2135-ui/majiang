func online_lobby_player_entries() -> Array:
	var entries: Array = []
	if lobby_connection_state_text() != "已连接" and not online_waiting_for_server:
		return entries
	var players_value = online_room.get("players", [])
	if typeof(players_value) != TYPE_ARRAY:
		return entries
	for player in players_value:
		if typeof(player) == TYPE_DICTIONARY:
			var entry := (player as Dictionary).duplicate(true)
			entry["seat"] = int(first_present(entry, ["seat", "index", "position"], entries.size()))
			entry["name"] = bounded_online_input(str(first_present(entry, ["name", "nickname", "userName"], "道友")), ONLINE_NAME_MAX_LENGTH)
			entry["ready"] = bool(first_present(entry, ["ready", "isReady"], false))
			entries.append(entry)
		else:
			entries.append({"seat": entries.size(), "name": bounded_online_input(str(player), ONLINE_NAME_MAX_LENGTH), "ready": false})
	return entries

func online_lobby_player_for_slot(entries: Array, slot: int) -> Dictionary:
	for entry_value in entries:
		if typeof(entry_value) != TYPE_DICTIONARY:
			continue
		var entry := entry_value as Dictionary
		if int(entry.get("seat", -1)) == slot:
			return entry
	if slot >= 0 and slot < entries.size() and typeof(entries[slot]) == TYPE_DICTIONARY:
		return entries[slot] as Dictionary
	return {}

func online_lobby_occupied_seat_count(entries: Array) -> int:
	var occupied := 0
	for slot in range(4):
		if not online_lobby_player_for_slot(entries, slot).is_empty():
			occupied += 1
	return occupied

func online_lobby_slot_name(entry: Dictionary) -> String:
	if entry.is_empty():
		return "待入席"
	var name := str(entry.get("name", "道友")).strip_edges()
	return name if name != "" else "道友"

func online_lobby_slot_state(entry: Dictionary, slot: int) -> String:
	if entry.is_empty():
		return "空席"
	if first_present(entry, ["connected", "online", "isConnected"], true) == false:
		return "断线"
	if bool(entry.get("bot", false)):
		return "AI · 已准备" if bool(entry.get("ready", false)) else "AI · 未准备"
	if bool(entry.get("ready", false)):
		return "已准备"
	return "房主 · 未准备" if slot == 0 else "已入席 · 未准备"


func online_lobby_slot_state_icon(entry: Dictionary, slot: int) -> String:
	if entry.is_empty():
		return "circle"
	if first_present(entry, ["connected", "online", "isConnected"], true) == false:
		return "alert-triangle"
	if bool(entry.get("bot", false)):
		return "cpu"
	if bool(entry.get("ready", false)):
		return "check"
	return "user" if slot != 0 else "crown"


func add_online_detail_touch_target(parent: Control, target_name: String, tooltip: String, callback: Callable, target_rect: Rect2 = Rect2(0.0, 0.0, 1.0, 1.0)) -> Button:
	# Use a native button for reliable screen-touch dispatch; the parent keeps the authored visual face.
	var target := Button.new()
	target.name = target_name
	target.text = ""
	target.tooltip_text = tooltip
	target.set_meta("accessible_name", tooltip)
	target.set_meta("single_action_surface", true)
	target.flat = true
	configure_touch_button(target)
	target.mouse_filter = Control.MOUSE_FILTER_STOP
	target.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	var empty_style := StyleBoxEmpty.new()
	for state in ["normal", "hover", "pressed", "focus", "disabled"]:
		target.add_theme_stylebox_override(state, empty_style)
	apply_rect(target, target_rect)
	parent.add_child(target)
	target.pressed.connect(callback)
	return target


func normalized_rect_in_parent(global_rect: Rect2, parent: Control) -> Rect2:
	var parent_rect := parent.get_global_rect()
	if parent_rect.size.x <= 0.0 or parent_rect.size.y <= 0.0:
		return rect_full(0.0, 0.0, 1.0, 1.0)
	var local_rect := Rect2(global_rect.position - parent_rect.position, global_rect.size)
	return rect_full(
		local_rect.position.x / parent_rect.size.x,
		local_rect.position.y / parent_rect.size.y,
		(local_rect.position.x + local_rect.size.x) / parent_rect.size.x,
		(local_rect.position.y + local_rect.size.y) / parent_rect.size.y
	)


func draw_online_lobby_roster_panel(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var roster = make_gpt_center_crop_plate_rect(rect_full(0.050, 0.295, 0.950, 0.620), Color(0.008, 0.016, 0.016, 0.50), "ui_dark_scrim")
	roster.name = "OnlineLobbyRosterPanel"
	roster.mouse_filter = Control.MOUSE_FILTER_IGNORE
	roster.set_meta("column_contract", "seat|name|ready|status")
	roster.set_meta("column_rects", {
		"seat": rect_full(0.020, 0.145, 0.092, 0.855),
		"name": rect_full(0.118, 0.070, 0.500, 0.930),
		"ready": rect_full(0.525, 0.205, 0.585, 0.795),
		"status": rect_full(0.610, 0.080, 0.940, 0.920),
	})
	roster.set_meta("empty_row_keeps_columns", true)
	parent.add_child(roster)
	var title = make_label(roster, "玩家席位", 13, Color(0.94, 0.94, 0.80), true)
	title.name = "OnlineLobbyRosterTitle"
	apply_rect(title, rect_full(0.035, 0.030, 0.360, 0.155))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var entries = online_lobby_player_entries()
	var roster_first_row_top := 0.185
	var roster_row_height := 0.180
	var roster_row_step := (0.930 - roster_first_row_top - roster_row_height) / 3.0
	for i in range(4):
		var entry = online_lobby_player_for_slot(entries, i)
		var active := not entry.is_empty()
		var top = roster_first_row_top + float(i) * roster_row_step
		var row_fill = Color(0.024, 0.048, 0.044, 0.92) if active else Color(0.014, 0.026, 0.026, 0.82)
		row_fill.a *= 0.82
		var row = make_gpt_center_crop_plate_rect(rect_full(0.035, top, 0.965, top + roster_row_height), row_fill, "ui_dark_scrim")
		row.name = "OnlineLobbyRosterRow_%d" % i
		row.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.set_meta("column_contract", "seat|name|ready|status")
		row.set_meta("column_baseline", 0.50)
		row.set_meta("empty_slot_status", "空席" if not active else "")
		mark_ui_optimization(row, "F-541")
		var detail_slot := i
		roster.add_child(row)
		var seal = make_gpt_gate(rect_full(0.020, 0.145, 0.092, 0.855), Color(0.42, 0.68, 0.50, 0.20 if active else 0.10))
		seal.name = "OnlineLobbyRosterSeatSeal_%d" % i
		row.add_child(seal)
		var seal_label = make_label(seal, "%d" % (i + 1), 8, Color(0.94, 0.92, 0.72, 0.94 if active else 0.62), true)
		apply_rect(seal_label, rect_full(0.0, 0.0, 1.0, 1.0))
		var name = make_label(row, online_lobby_slot_name(entry), 12, Color(0.95, 0.96, 0.84, 0.98 if active else 0.78), true)
		name.name = "OnlineLobbyRosterName_%d" % i
		apply_rect(name, rect_full(0.118, 0.070, 0.500, 0.930))
		name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		name.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.82))
		name.add_theme_constant_override("outline_size", 1)
		configure_clipped_label(name)
		name.set_meta("name_priority", "preserve_leading_identity")
		name.set_meta("full_name_route", "OnlineLobbyRosterTouchTarget_%d" % i)
		set_ui_full_text(name, online_lobby_slot_name(entry), "第%d席完整昵称" % (i + 1))
		mark_ui_optimization(name, "F-072")
		var state_icon = add_lucide_icon(row, online_lobby_slot_state_icon(entry, i), rect_full(0.635, 0.205, 0.695, 0.795), Color(0.76, 0.90, 0.70, 0.92 if active else 0.54))
		if state_icon != null:
			state_icon.name = "OnlineLobbyRosterStateIcon_%d" % i
			state_icon.set_meta("column_owner", "ready")
			state_icon.set_meta("column_rect", rect_full(0.525, 0.205, 0.585, 0.795))
		var state = make_label(row, online_lobby_slot_state(entry, i), 11, Color(0.82, 0.94, 0.74, 0.96 if active else 0.74), false)
		state.name = "OnlineLobbyRosterState_%d" % i
		apply_rect(state, rect_full(0.610, 0.080, 0.940, 0.920))
		state.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		state.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.82))
		state.add_theme_constant_override("outline_size", 1)
		configure_clipped_label(state)
		state.set_meta("state_priority", "always_visible_short_label")
		state.set_meta("column_owner", "status")
		state.set_meta("column_rect", rect_full(0.610, 0.080, 0.940, 0.920))
		set_ui_full_text(state, online_lobby_slot_state(entry, i), "第%d席状态" % (i + 1))
		mark_ui_optimization(state, "F-072")
		var roster_touch_rect := normalized_rect_in_parent(row.get_global_rect(), root_layer)
		var roster_touch_target := add_online_detail_touch_target(root_layer, "OnlineLobbyRosterTouchTarget_%d" % i, "查看完整玩家昵称", func() -> void:
			show_online_roster_detail(detail_slot)
		, roster_touch_rect)
		roster_touch_target.disabled = not active
		roster_touch_target.mouse_filter = Control.MOUSE_FILTER_STOP if active else Control.MOUSE_FILTER_IGNORE
		roster_touch_target.set_meta("detail_rect_source", row.name)
		roster_touch_target.set_meta("detail_rect_synced", true)
		roster_touch_target.set_meta("resize_sync_contract", "global_rect_recomputed_after_viewport_resize")
		mark_ui_optimization(roster_touch_target, "F-542")
		mark_ui_optimization(roster_touch_target, "F-239")
	return roster


func draw_online_lobby_log_list_panel(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var list = make_gpt_center_crop_plate_rect(rect_full(0.050, 0.632, 0.950, 0.945), Color(0.008, 0.016, 0.016, 0.50), "ui_dark_scrim")
	list.name = "OnlineLobbyLogListPanel"
	parent.add_child(list)
	list.clip_contents = true
	var title = make_label(list, "房间日志", 13, Color(0.94, 0.94, 0.80), true)
	title.name = "OnlineLobbyLogListTitle"
	apply_rect(title, rect_full(0.035, 0.025, 0.360, 0.170))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	title.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.86))
	title.add_theme_constant_override("outline_size", 1)
	var log_unread := online_lobby_log_unread_count()
	var latest_button = make_small_button("最新" if log_unread <= 0 else "最新 · %d" % log_unread, Color(0.34, 0.42, 0.34), Callable(self, "scroll_online_log_to_end"))
	latest_button.name = "OnlineLobbyLogLatestButton"
	latest_button.custom_minimum_size = Vector2(76, UI_MIN_TOUCH_TARGET)
	latest_button.add_theme_font_size_override("font_size", 10)
	set_ui_full_text(latest_button, "跳到最新房间日志", "房间日志：跳到最新")
	latest_button.set_meta("ui_button_role", "log_latest")
	latest_button.set_meta("unread_count", log_unread)
	latest_button.set_meta("unread_action", "jump_to_tail_and_mark_seen")
	mark_ui_optimization(latest_button, "F-240")
	# The header owns a full touch lane; the native log scroll starts below it.
	apply_rect(latest_button, rect_full(0.535, 0.020, 0.745, 0.350))
	list.add_child(latest_button)
	list.set_meta("range_summary_owner", "OnlineLobbyLogRangeLabel")
	mark_ui_optimization(list, "F-910")
	var unread_label = make_label(list, "未读 %d 条" % log_unread if log_unread > 0 else "已到最新", 9, Color(0.72, 0.84, 0.66, 0.86), false)
	unread_label.name = "OnlineLobbyLogUnreadLabel"
	apply_rect(unread_label, rect_full(0.385, 0.035, 0.520, 0.165))
	unread_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	unread_label.visible = log_unread > 0
	configure_clipped_label(unread_label)
	set_ui_full_text(unread_label, unread_label.text, "房间日志状态：" + unread_label.text)
	unread_label.set_meta("ui_status_role", "log_unread")
	mark_ui_optimization(unread_label, "F-240")
	var range_label := make_label(list, "日志范围 · 正在测量", 9, Color(0.76, 0.84, 0.74), false)
	range_label.name = "OnlineLobbyLogRangeLabel"
	apply_rect(range_label, rect_full(0.035, 0.180, 0.500, 0.335))
	range_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	range_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	configure_clipped_label(range_label)
	set_ui_full_text(range_label, "当前房间日志可见范围", "房间日志当前可见范围")
	range_label.set_meta("range_owner", "OnlineLobbyLogScroll")
	range_label.set_meta("range_contract", "first_last_total_and_latest_boundary")
	mark_ui_optimization(range_label, "F-901")
	mark_ui_optimization(range_label, "F-902")
	var count_value := online_lobby_retained_log_count() if lobby_connection_state_text() == "已连接" or online_waiting_for_server else 0
	var total_count := online_lobby_log_count() if lobby_connection_state_text() == "已连接" or online_waiting_for_server else 0
	var count_badge = make_badge(list, rect_full(0.760, 0.030, 0.955, 0.175), "存%d · 总%d · 未读%d" % [count_value, total_count, log_unread], 10, Color(0.036, 0.052, 0.046, 0.92), Color(0.58, 0.70, 0.42, 0.16), Color(0.90, 0.94, 0.76))
	count_badge.name = "OnlineLobbyLogCountBadge"
	count_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	set_ui_full_text(count_badge, "房间日志共%d条" % count_value, "房间日志总数")
	count_badge.set_meta("log_count", count_value)
	count_badge.set_meta("retained_count", count_value)
	count_badge.set_meta("total_count", total_count)
	count_badge.set_meta("unread_count", online_lobby_log_unread_count())
	count_badge.set_meta("log_semantics", "visible_cache_count")
	mark_ui_optimization(count_badge, "F-241")
	set_ui_full_text(count_badge, "房间日志缓存%d条；总计%d条；未读%d条" % [count_value, total_count, online_lobby_log_unread_count()], "房间日志总数")
	if count_badge.get_child_count() > 0:
		var count_label = count_badge.get_child(count_badge.get_child_count() - 1) as Label
		if count_label != null:
			count_label.name = "OnlineLobbyLogCountLabel"
			count_label.text = "存%d · 总%d · 未读%d" % [count_value, total_count, log_unread]
			set_ui_full_text(count_label, "房间日志缓存%d条；总计%d条；未读%d条" % [count_value, total_count, online_lobby_log_unread_count()], "房间日志总数")
			count_label.set_meta("retained_count", count_value)
			count_label.set_meta("total_count", total_count)
			count_label.set_meta("unread_count", online_lobby_log_unread_count())
			count_label.set_meta("log_semantics", "visible_cache_count")
			mark_ui_optimization(count_label, "F-241")
	return list


func draw_online_lobby_room_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "OnlineLobbyRoomArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.050, 0.160, 0.950, 0.285))
	parent.add_child(art)
	# Keep the decorative fan in a narrow header band; the room summary is a
	# reading surface and must not inherit the texture's high-frequency detail.
	var overlay = add_illustration_texture(art, "lobby_screen_fan", rect_full(0.640, -0.120, 1.020, 0.280), 0.010, false)
	if overlay != null:
		overlay.name = "OnlineLobbyRoomFanOverlay"
		art.move_child(overlay, 0)
	var player_entries: Array = online_lobby_player_entries()
	var player_count := online_lobby_occupied_seat_count(player_entries)
	var ready_count = 0
	# Keep the last room snapshot visible while a join/create request is waiting
	# for the server. The connection badge still reports the current state.
	var show_room_snapshot := lobby_connection_state_text() == "已连接" or online_waiting_for_server
	if show_room_snapshot:
		for slot in range(4):
			var player_entry := online_lobby_player_for_slot(player_entries, slot)
			if not player_entry.is_empty() and bool(player_entry.get("ready", false)):
				ready_count += 1
	var summary_panel = make_gpt_center_crop_plate_rect(rect_full(0.030, 0.085, 0.970, 0.610), Color(0.008, 0.020, 0.022, 0.54), "ui_dark_scrim")
	summary_panel.name = "OnlineLobbyRoomSummaryPanel"
	art.add_child(summary_panel)
	var summary_headline_text := "等待连接"
	if lobby_connection_state_text() == "已连接":
		if player_count < 4:
			summary_headline_text = "还差 %d 人入席" % (4 - player_count)
		elif ready_count < 4:
			summary_headline_text = "等待 %d 人准备" % (4 - ready_count)
		else:
			summary_headline_text = "全员已准备 · 房主可开始"
	var summary_headline = make_label(summary_panel, summary_headline_text, 10, Color(0.98, 0.92, 0.66), true)
	summary_headline.name = "OnlineLobbyRoomSummaryHeadline"
	apply_rect(summary_headline, rect_full(0.035, 0.015, 0.475, 0.145))
	summary_headline.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	summary_headline.tooltip_text = "房间下一步：" + summary_headline_text
	configure_clipped_label(summary_headline)
	var summary_context_text := "%s · %s" % [online_endpoint_summary(online_connection_endpoint_text()), online_room_code_summary(selected_room)]
	var summary_context_full := "服务器 %s · 房间 %s" % [online_connection_endpoint_text(), bounded_online_input(selected_room, ONLINE_ROOM_CODE_MAX_LENGTH) if selected_room != "" else "未创建"]
	var summary_context := make_label(summary_panel, summary_context_text, 8, Color(0.72, 0.84, 0.76), false)
	summary_context.name = "OnlineLobbyRoomSummaryContext"
	apply_rect(summary_context, rect_full(0.500, 0.015, 0.965, 0.145))
	summary_context.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	summary_context.tooltip_text = "当前房间摘要：" + summary_context_full
	summary_context.set_meta("ui_full_text", summary_context_full)
	summary_context.visible = not online_lobby_room_snapshot_is_stale()
	configure_clipped_label(summary_context)
	var snapshot_status_text := online_lobby_room_snapshot_status_text()
	var snapshot_status = make_label(summary_panel, snapshot_status_text, 9, Color(1.0, 0.80, 0.48), true)
	snapshot_status.name = "OnlineLobbyRoomSummarySnapshotStatus"
	apply_rect(snapshot_status, rect_full(0.035, 0.015, 0.965, 0.145))
	snapshot_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	snapshot_status.visible = snapshot_status_text != ""
	snapshot_status.tooltip_text = "房间数据状态：" + snapshot_status_text if snapshot_status_text != "" else ""
	snapshot_status.set_meta("ui_full_text", snapshot_status.tooltip_text)
	configure_clipped_label(snapshot_status)
	summary_panel.set_meta("snapshot_state", "stale" if snapshot_status_text != "" else "current")
	summary_panel.set_meta("snapshot_status", snapshot_status_text)
	var occupancy_chip = make_gpt_gate(rect_full(0.030, 0.140, 0.315, 0.860), Color(0.030, 0.060, 0.050, 0.72))
	occupancy_chip.name = "OnlineLobbyRoomSummaryOccupancy"
	summary_panel.add_child(occupancy_chip)
	var occupancy_label = make_label(occupancy_chip, "入席 %d/4" % min(4, player_count), 11, Color(0.94, 0.98, 0.82), true)
	occupancy_label.name = "OnlineLobbyRoomSummaryOccupancyLabel"
	apply_rect(occupancy_label, rect_full(0.220, 0.0, 0.940, 1.0))
	configure_clipped_label(occupancy_label)
	add_lucide_icon(occupancy_chip, "users", rect_full(0.045, 0.24, 0.190, 0.76), Color(0.86, 0.94, 0.80, 0.82))
	var ready_chip = make_gpt_gate(rect_full(0.358, 0.140, 0.632, 0.860), Color(0.044, 0.044, 0.026, 0.68))
	ready_chip.name = "OnlineLobbyRoomSummaryReady"
	summary_panel.add_child(ready_chip)
	var ready_label = make_label(ready_chip, "已备 %d" % ready_count, 11, Color(0.96, 0.92, 0.72), true)
	ready_label.name = "OnlineLobbyRoomSummaryReadyLabel"
	apply_rect(ready_label, rect_full(0.220, 0.0, 0.940, 1.0))
	configure_clipped_label(ready_label)
	add_lucide_icon(ready_chip, "check-circle-2", rect_full(0.045, 0.24, 0.190, 0.76), Color(0.96, 0.88, 0.60, 0.84))
	var state_chip = make_gpt_gate(rect_full(0.675, 0.140, 0.970, 0.860), Color(0.026, 0.046, 0.054, 0.70))
	state_chip.name = "OnlineLobbyRoomSummaryState"
	summary_panel.add_child(state_chip)
	var state_label = make_label(state_chip, lobby_connection_state_text(), 11, Color(0.86, 0.94, 0.92), true)
	state_label.name = "OnlineLobbyRoomSummaryStateLabel"
	apply_rect(state_label, rect_full(0.220, 0.0, 0.940, 1.0))
	configure_clipped_label(state_label)
	set_ui_full_text(state_label, state_label.text, "房间同步状态")
	add_lucide_icon(state_chip, "wifi" if lobby_connection_state_text() == "已连接" else "wifi-off", rect_full(0.045, 0.24, 0.190, 0.76), Color(0.86, 0.94, 0.92, 0.86))
	state_chip.set_meta("state_encoding", "icon_plus_text_not_color_only")
	mark_ui_optimization(state_label, "F-545")
	var simple_room_node = make_gpt_gate(rect_full(0.452, 0.655, 0.548, 0.955), Color(0.050, 0.040, 0.026, 0.42))
	simple_room_node.name = "OnlineLobbyRoomNode"
	art.add_child(simple_room_node)
	add_lucide_icon(simple_room_node, "users", rect_full(0.25, 0.22, 0.75, 0.78), GOLD_BRIGHT)
	for i in range(4):
		var seat_center = 0.115 + float(i) * 0.255
		var simple_active := not online_lobby_player_for_slot(player_entries, i).is_empty()
		var seat_fill = Color(0.34, 0.62, 0.48, 0.34) if simple_active else Color(0.22, 0.28, 0.26, 0.22)
		var slot_panel = make_gpt_plate_rect(rect_full(seat_center - 0.035, 0.675, seat_center + 0.035, 0.955), seat_fill, "ui_jade_reading_plate")
		slot_panel.name = "OnlineLobbyPlayerSeat_%d" % i
		art.add_child(slot_panel)
		var seat_label = make_label(slot_panel, str(i + 1), 8, Color(0.92, 0.96, 0.78, 0.86 if simple_active else 0.42), true)
		apply_rect(seat_label, rect_full(0.0, 0.0, 1.0, 1.0))
	return art


func draw_pending_claim_action_exit_art(parent: Control, options: Array) -> Control:
	var art = Control.new()
	art.name = "PendingClaimActionExitArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var active_count = max(1, options.size())
	var rail = make_gpt_route_rail(rect_full(0.118, 0.090, 0.920, 0.165), Color(0.006, 0.016, 0.018, 0.44))
	rail.name = "PendingClaimActionExitRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.220 + 0.160 * float(min(4, active_count)), 0.740), Color(0.88, 0.68, 0.32, 0.26))
	fill.name = "PendingClaimActionExitFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.866, 0.230, 0.920, 0.420), Color(0.96, 0.78, 0.38, 0.24))
	gate.name = "PendingClaimActionExitGate"
	art.add_child(gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.620, 0.245, (0.620) + float(2) * (0.065) + (0.020), 0.390), Color(0.88, 0.68, 0.32, 0.24), "PendingClaimActionExitTick_0")
	return art

func draw_pending_claim_flow_art(parent: Control, source_seat: int) -> Control:
	# r214: bulk GPT chrome sweep
	var flow = Control.new()
	flow.name = "PendingClaimFlowArt"
	flow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(flow, rect_full(0.150, 0.438, 0.316, 0.690))
	parent.add_child(flow)
	var accent = SEAT_ACCENT_COLORS[source_seat] if source_seat >= 0 and source_seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	for i in range(3):
		var left = 0.020 + float(i) * 0.260
		var dash = make_gpt_plate_rect(rect_full(left, 0.430, left + 0.150, 0.570), Color(accent.r, accent.g, accent.b, 0.36), "ui_jade_reading_plate")
		dash.name = "PendingClaimFlowDash_%d" % i
		flow.add_child(dash)
	var arrow = make_label(flow, ">", 16, Color(0.96, 0.82, 0.44, 0.82), true)
	arrow.name = "PendingClaimFlowArrow"
	apply_rect(arrow, rect_full(0.780, 0.080, 0.980, 0.920))
	arrow.modulate = Color(1, 1, 1, 0.82)
	var flow_label = make_label(flow, pending_claim_source_badge_text(source_seat) + " → 你的响应", 8, Color(0.86, 0.80, 0.62, 0.82), true)
	flow_label.name = "PendingClaimFlowLabel"
	apply_rect(flow_label, rect_full(0.020, 0.060, 0.790, 0.360))
	flow_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(flow_label)
	return flow


func draw_pending_claim_illustration(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var pending = pending_claim_state()
	if pending.is_empty():
		return
	var tile = str(pending.get("tile", ""))
	if tile == "":
		return
	var content_size = safe_content_pixel_size()
	var context_rect = pending_claim_context_layout_rect(content_size)
	var has_status_strip := optional_gpt_illustration_texture("pending_claim_status_strip") != null
	var panel = make_gpt_route_rail(context_rect, Color(0.026, 0.040, 0.036, 0.42 if has_status_strip else 0.70))
	panel.name = "PendingClaimIllustration"
	panel.z_index = 20
	panel.clip_contents = true
	parent.add_child(panel)
	var compact_context_layout := effective_viewport_size().x <= 1280.0
	var narrow_context_layout := effective_viewport_size().x <= 960.0
	var status_strip = add_optional_gpt_illustration_texture(panel, "pending_claim_status_strip", rect_full(0.0, 0.0, 1.0, 1.0), 0.62, false)
	if status_strip != null:
		status_strip.name = "PendingClaimStatusStripTexture"
		panel.move_child(status_strip, 0)
	var mist = make_gpt_plate_rect(rect_full(0.012, 0.620, 0.988, 0.860), Color(0.94, 0.72, 0.34, 0.06))
	mist.name = "PendingClaimMistCloud"
	panel.add_child(mist)
	var source_seat = int(pending.get("from_seat", -1))
	var source_name = pending_claim_source_name(source_seat)
	var source_badge = make_badge(panel, rect_full(0.020, 0.120, 0.155, 0.880), pending_claim_source_badge_text(source_seat), 11, Color(0.34, 0.13, 0.09, 0.68), Color(0.84, 0.58, 0.28, 0.20), Color(0.96, 0.88, 0.68))
	source_badge.name = "PendingClaimSourceBadge"
	source_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var tile_preview = make_tile_view(tile, Vector2(34, 46), false, Callable(), true)
	tile_preview.name = "PendingClaimTile"
	tile_preview.tooltip_text = "%s打出的%s · 点击下方按钮选择响应" % [source_name, tile_label(tile)]
	panel.add_child(tile_preview)
	var tile_rect := rect_full(0.030, 0.020, 0.255, 0.980) if compact_context_layout else rect_full(0.170, 0.020, 0.315, 0.980)
	if narrow_context_layout:
		tile_rect = rect_full(0.025, 0.040, 0.165, 0.960)
	apply_rect(tile_preview, tile_rect)
	var title = make_label(panel, "%s 打出" % source_name, 13, Color(0.92, 0.88, 0.72, 0.96), true)
	title.name = "PendingClaimSourceText"
	var title_rect := rect_full(0.300, 0.050, 0.965, 0.340) if compact_context_layout else rect_full(0.345, 0.060, 0.790, 0.535)
	if narrow_context_layout:
		title_rect = rect_full(0.190, 0.060, 0.560, 0.455)
	apply_rect(title, title_rect)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	title.tooltip_text = "%s打出%s，正在等待你的响应" % [source_name, tile_label(tile)]
	style_background_readable_label(title, 2)
	var tile_name = make_label(panel, tile_label(tile), 14, Color(0.98, 0.88, 0.58, 1.0), true)
	tile_name.name = "PendingClaimTileName"
	var tile_name_rect := rect_full(0.300, 0.380, 0.490, 0.620) if compact_context_layout else rect_full(0.790, 0.060, 0.970, 0.535)
	if narrow_context_layout:
		tile_name_rect = rect_full(0.585, 0.060, 0.965, 0.455)
	apply_rect(tile_name, tile_name_rect)
	tile_name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	style_background_readable_label(tile_name, 2)
	var urgency = make_label(panel, pending_claim_urgency_text(), 9, Color(0.98, 0.70, 0.42, 0.92), true)
	urgency.name = "PendingClaimUrgencyText"
	var urgency_rect := rect_full(0.500, 0.380, 0.965, 0.620) if compact_context_layout else rect_full(0.345, 0.455, 0.970, 0.535)
	if narrow_context_layout:
		urgency_rect = rect_full(0.190, 0.505, 0.560, 0.790)
	apply_rect(urgency, urgency_rect)
	urgency.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	if compact_context_layout:
		urgency.add_theme_font_size_override("font_size", 8)
	configure_clipped_label(urgency)
	urgency.tooltip_text = "响应窗口提示：" + pending_claim_urgency_text()
	var focus = make_label(panel, pending_claim_focus_text(), 11, Color(0.88, 0.86, 0.72, 0.88), true)
	focus.name = "PendingClaimFocusText"
	if narrow_context_layout:
		focus.text = pending_claim_compact_focus_text()
	var focus_rect := rect_full(0.300, 0.650, 0.965, 0.950) if compact_context_layout else rect_full(0.345, 0.550, 0.970, 0.940)
	if narrow_context_layout:
		focus_rect = rect_full(0.585, 0.505, 0.965, 0.790)
	apply_rect(focus, focus_rect)
	focus.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	if compact_context_layout:
		focus.add_theme_font_size_override("font_size", 8 if narrow_context_layout else 9)
		configure_clipped_label(focus)
	style_background_readable_label(focus, 2)
	if compact_context_layout:
		# The source text already names the discarder; reserve the narrow edge for
		# the real tile preview instead of duplicating a clipped badge.
		source_badge.visible = false
	if not narrow_context_layout:
		draw_pending_claim_flow_art(panel, source_seat)
		draw_pending_claim_priority_art(panel, pending.get("options", []))
		draw_pending_claim_response_pulse(panel, pending.get("options", []))
		draw_pending_claim_timer_art(parent)
	else:
		# The compact top context still needs a named countdown slot so the
		# final-three-second auto-pass state remains visible and testable.
		draw_pending_claim_timer_art(parent, true)
	if fx_enabled_effective():
		panel.modulate = Color(1, 1, 1, 0)
		panel.offset_top = 10.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(panel, "modulate:a", 1.0, 0.18).from(0.0)
		tw.tween_property(panel, "offset_top", 0.0, 0.18).from(10.0).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)


func draw_pending_claim_option_spark(parent: Control, left: float, color: Color, index: int) -> Control:
	# r214: bulk GPT chrome sweep
	var spark = make_gpt_gate(rect_full(left + 0.060, 0.030, left + 0.095, 0.170), Color(color.r, color.g, color.b, 0.28))
	spark.name = "PendingClaimOptionSpark_%d" % index
	parent.add_child(spark)
	spark.modulate = Color(1, 1, 1, 0.72 - float(index) * 0.08)
	return spark


func draw_pending_claim_priority_art(parent: Control, options: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "PendingClaimPriorityArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var rail = make_gpt_route_rail(rect_full(0.035, 0.760, 0.790, 0.875), Color(0.006, 0.016, 0.018, 0.54))
	rail.name = "PendingClaimPriorityRail"
	art.add_child(rail)
	var fill_ratio = clamp(float(max(1, options.size())) / 4.0, 0.18, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * fill_ratio, 0.740), Color(0.88, 0.68, 0.32, 0.30))
	fill.name = "PendingClaimPriorityFill"
	rail.add_child(fill)
	for i in range(min(4, options.size())):
		var claim_name = str(options[i])
		var color = claim_color(claim_name)
		var left = 0.075 + float(i) * 0.190
		var node = make_gpt_gate(rect_full(left, 0.640, left + 0.046, 0.940), Color(color.r, color.g, color.b, 0.26))
		node.name = "PendingClaimPriorityNode_%s" % claim_name
		art.add_child(node)
	var pass_node = make_gpt_gate(rect_full(0.845, 0.650, 0.925, 0.930), Color(0.46, 0.50, 0.48, 0.18))
	pass_node.name = "PendingClaimPriorityPassNode"
	art.add_child(pass_node)
	var tick = add_gpt_tick_strip(art, rect_full(0.705, 0.145, (0.730) + float(2) * (0.043), 0.315), Color(0.92, 0.70, 0.32, 0.22), "PendingClaimPriorityTick_0")
	var priority_label = make_label(art, pending_claim_priority_text(options), 8, Color(0.86, 0.80, 0.62, 0.88), true)
	priority_label.name = "PendingClaimPriorityText"
	apply_rect(priority_label, rect_full(0.035, 0.520, 0.790, 0.720))
	priority_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(priority_label)
	fill.modulate = Color(1, 1, 1, 0.82)
	return art


func draw_pending_claim_response_pulse(parent: Control, options: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var pulse = Control.new()
	pulse.name = "PendingClaimResponsePulse"
	pulse.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(pulse, rect_full(0.662, 0.875, 0.970, 0.965))
	parent.add_child(pulse)
	var active_count = max(1, options.size())
	var rail = make_gpt_route_rail(rect_full(0.030, 0.410, 0.930, 0.515), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "PendingClaimResponsePulseRail"
	pulse.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.275, min(0.900, 0.220 + 0.150 * float(min(4, active_count))), 0.725), Color(0.88, 0.68, 0.32, 0.28))
	fill.name = "PendingClaimResponsePulseFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.185, 0.115, 0.790), Color(0.88, 0.68, 0.32, 0.18))
	source.name = "PendingClaimResponseSource"
	pulse.add_child(source)
	var gate = make_gpt_gate(rect_full(0.870, 0.180, 0.930, 0.820), Color(0.96, 0.78, 0.38, 0.24))
	gate.name = "PendingClaimResponseGate"
	pulse.add_child(gate)
	var tick = add_gpt_tick_strip(pulse, rect_full(0.280, 0.220, (0.280) + float(2) * (0.135) + (0.026), 0.790), Color(0.88, 0.68, 0.32, 0.24), "PendingClaimResponseTick_0")
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.80)
	return pulse


func draw_pending_claim_timer_art(parent: Control, root_slot: bool = false) -> Control:
	var timer = Control.new()
	timer.name = "PendingClaimTimerArt"
	timer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var narrow_context_layout := effective_viewport_size().x <= 960.0
	apply_rect(timer, rect_full(0.640, 0.535, 0.972, 0.588) if root_slot else (rect_full(0.620, 0.800, 0.970, 0.985) if narrow_context_layout else rect_full(0.420, 0.852, 0.958, 0.962)))
	timer.set_meta("layout_role", "pending_claim_primary_countdown")
	timer.set_meta("stable_screen_slot", "root_above_action_dock" if root_slot else "pending_context_footer")
	timer.set_meta("excludes_rects", [HAND_TRAY_TILES_RECT, ACTION_BAR_RECT, PENDING_CLAIM_ACTION_BAR_RECT])
	timer.set_meta("response_summary", pending_claim_focus_text())
	timer.set_meta("timeout_result", "到0秒自动过")
	mark_ui_optimization(timer, "F-065")
	mark_ui_optimization(timer, "F-100")
	mark_ui_optimization(timer, "F-104")
	parent.add_child(timer)
	var rail = make_gpt_route_rail(rect_full(0.020, 0.365, 0.940, 0.455), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "PendingClaimTimerRail"
	timer.add_child(rail)
	var remaining_ratio := pending_claim_remaining_ratio()
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * remaining_ratio, 0.740), Color(0.92, 0.70, 0.32, 0.28))
	fill.name = "PendingClaimTimerFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.906, 0.195, 0.952, 0.650), Color(0.96, 0.78, 0.38, 0.24))
	gate.name = "PendingClaimTimerGate"
	timer.add_child(gate)
	var tick = add_gpt_tick_strip(timer, rect_full(0.165, 0.185, (0.165) + float(3) * (0.155) + (0.018), 0.670), Color(0.92, 0.70, 0.32, 0.24), "PendingClaimTimerTick_0")
	var timer_label = make_label(timer, pending_claim_timer_text(), 10 if root_slot else (8 if narrow_context_layout else 9), Color(0.98, 0.88, 0.58, 0.94), true)
	timer_label.name = "PendingClaimTimerText"
	apply_rect(timer_label, rect_full(0.040, 0.020, 0.900, 0.340))
	timer_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(timer_label)
	timer_label.set_meta("status_hierarchy", "primary_pending_window")
	timer_label.set_meta("timeout_result", "响应超时后自动过")
	set_ui_full_text(timer_label, pending_claim_timer_text(), "吃碰杠胡响应倒计时；到0秒将自动过")
	mark_ui_optimization(timer_label, "F-065")
	mark_ui_optimization(timer_label, "F-100")
	var warning_label := make_label(timer, pending_claim_auto_pass_text(), 8 if narrow_context_layout else 9, Color(1.0, 0.74, 0.42), true)
	warning_label.name = "PendingClaimAutoPassWarning"
	apply_rect(warning_label, rect_full(0.040, 0.700, 0.900, 0.985))
	warning_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	warning_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	warning_label.visible = warning_label.text != ""
	warning_label.tooltip_text = warning_label.text
	warning_label.set_meta("accessible_name", warning_label.text)
	warning_label.set_meta("timeout_result", "到0秒自动过")
	warning_label.set_meta("live_state_owner", "pending_claim_auto_pass_warning")
	mark_ui_optimization(warning_label, "F-065")
	configure_clipped_label(warning_label)
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.80)
	return timer

