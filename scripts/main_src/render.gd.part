func draw_stats_insight_convergence_art(parent: Control) -> Control:
	# r210: GPT chrome conversion
	var win_rate = clamp(float(game_stats.get("win_rate", 0.0)), 0.0, 1.0)
	var games_fill = clamp(float(int(game_stats.get("games_played", 0))) / 20.0, 0.05, 1.0)
	var best_score_strength = clamp(float(int(game_stats.get("best_score", 0))) / 12000.0, 0.08, 1.0)
	var summary_score = clamp((win_rate + games_fill + best_score_strength) / 3.0, 0.06, 1.0)
	var art = Control.new()
	art.name = "StatsInsightConvergenceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.430, 0.125, 0.915, 0.318))
	parent.add_child(art)
	return art
	var gold = Color(0.88, 0.70, 0.32)
	var jade = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.270, 0.088, 0.700), Color(jade.r, jade.g, jade.b, 0.16 + summary_score * 0.08))
	source.name = "StatsInsightSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.430, 0.870, 0.550), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "StatsInsightRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * summary_score, 0.750), Color(jade.r, jade.g, jade.b, 0.24))
	fill.name = "StatsInsightFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.835, 0.280, 0.920, 0.730), Color(gold.r, gold.g, gold.b, 0.15 + summary_score * 0.10))
	gate.name = "StatsInsightGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.700, 0.065, 0.820, 0.350), Color(gold.r, gold.g, gold.b, 0.13 + summary_score * 0.08))
	seal.name = "StatsInsightSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "析", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "StatsInsightGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_gpt_route_rail(rect_full(0.230, 0.695, 0.780, 0.825), Color(0.006, 0.016, 0.018, 0.34))
	archive_route.name = "StatsInsightArchiveRoute"
	art.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760, 0.750), Color(gold.r, gold.g, gold.b, 0.18))
	archive_fill.name = "StatsInsightArchiveFill"
	archive_route.add_child(archive_fill)
	var archive_gate = make_gpt_gate(rect_full(0.755, 0.625, 0.835, 0.905), Color(jade.r, jade.g, jade.b, 0.13 + summary_score * 0.06))
	archive_gate.name = "StatsInsightArchiveGate"
	art.add_child(archive_gate)
	var strengths = [win_rate, games_fill, best_score_strength]
	for i in range(strengths.size()):
		var strength = clamp(float(strengths[i]), 0.08, 1.0)
		var left = 0.225 + float(i) * 0.170
		var node = make_gpt_gate(rect_full(left, 0.300, left + 0.030, 0.665), Color(gold.r, gold.g, gold.b, 0.10 + strength * 0.14))
		node.name = "StatsInsightNode_%d" % i
		art.add_child(node)
		var branch = make_gpt_edge_rail(rect_full(left + 0.012, 0.120, left + 0.020, 0.315), Color(jade.r, jade.g, jade.b, 0.08 + strength * 0.10))
		branch.name = "StatsInsightBranch_%d" % i
		art.add_child(branch)
	var tick = add_gpt_tick_strip(art, rect_full(0.585, 0.180, (0.600) + float(2) * (0.060), 0.420), Color(jade.r, jade.g, jade.b, 0.22), "StatsInsightTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.36, 0.72).from(0.90)
		tw.parallel().tween_property(archive_fill, "modulate:a", 0.34, 0.72).from(0.84)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.72).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.90, 0.72).from(0.36)
		tw.parallel().tween_property(archive_fill, "modulate:a", 0.84, 0.72).from(0.34)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.72).from(0.58)
	return art


func draw_stats_mastery_route(parent: Control, win_rate: float, games_fill: float, best_score_strength: float, summary_score: float) -> Control:
	var mastery = Control.new()
	mastery.name = "StatsMasteryRoute"
	mastery.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(mastery, rect_full(0.185, 0.565, 0.665, 0.705))
