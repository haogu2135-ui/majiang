func draw_exit_confirm_choice_commit_feedback(parent: Control, route_id: String, color: Color) -> Control:
	# r213: GPT chrome conversion
	if parent == null or not is_instance_valid(parent):
		return null
	var old_feedback = parent.find_child("ExitConfirmChoiceCommitFeedback_%s" % route_id, true, false)
	if old_feedback != null:
		old_feedback.queue_free()
	var feedback = Control.new()
	feedback.name = "ExitConfirmChoiceCommitFeedback_%s" % route_id
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(feedback, rect_full(0.120, 0.635, 0.880, 0.705))
	parent.add_child(feedback)
	var source_left = 0.070 if route_id == "keep" else 0.855
	var source = make_gpt_plate_rect(rect_full(source_left, 0.365, source_left + 0.075, 0.635), Color(color.r, color.g, color.b, 0.22), "ui_jade_reading_plate")
	source.name = "ExitConfirmChoiceCommitSource_%s" % route_id
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.115, 0.775, 0.885, 0.845), Color(0.006, 0.016, 0.018, 0.48))
	route.name = "ExitConfirmChoiceCommitRoute_%s" % route_id
	feedback.add_child(route)
	var fill_left = 0.040 if route_id == "keep" else 0.520
	var fill_right = 0.480 if route_id == "keep" else 0.960
	var fill = make_gpt_meter_fill(rect_full(fill_left, 0.260, fill_right, 0.740), Color(color.r, color.g, color.b, 0.34))
	fill.name = "ExitConfirmChoiceCommitFill_%s" % route_id
	route.add_child(fill)
	var gate_left = 0.438 if route_id == "keep" else 0.512
	var gate = make_gpt_gate(rect_full(gate_left, 0.680, gate_left + 0.065, 0.960), Color(0.96, 0.82, 0.42, 0.24))
	gate.name = "ExitConfirmChoiceCommitGate_%s" % route_id
	feedback.add_child(gate)
	var archive_left = 0.332 if route_id == "keep" else 0.600
	var archive = make_gpt_plate_rect(rect_full(archive_left, 0.170, archive_left + 0.110, 0.565), Color(color.r, color.g, color.b, 0.18), "ui_jade_reading_plate")
	archive.name = "ExitConfirmChoiceCommitArchive_%s" % route_id
	feedback.add_child(archive)
	var glyph_text = "续" if route_id == "keep" else "退"
	var glyph = make_label(archive, glyph_text, 10, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "ExitConfirmChoiceCommitGlyph_%s" % route_id
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var tick_left = (0.260 + float(i) * 0.080) if route_id == "keep" else (0.690 + float(i) * 0.080)
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.675, tick_left + 0.025, 0.930), Color(color.r, color.g, color.b, 0.24 - float(i) * 0.040))
		tick.name = "ExitConfirmChoiceCommitTick_%s_%d" % [route_id, i]
		feedback.add_child(tick)
	for i in range(3):
		var pip_left = (0.145 + float(i) * 0.050) if route_id == "keep" else (0.805 - float(i) * 0.050)
		var pip = make_gpt_gate(rect_full(pip_left, 0.420, pip_left + 0.026, 0.560), Color(color.r, color.g, color.b, 0.23 - float(i) * 0.035))
		pip.name = "ExitConfirmChoiceCommitPip_%s_%d" % [route_id, i]
		feedback.add_child(pip)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_screen_tween()
		tw.bind_node(feedback)
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.08).from(0.0)
		tw.tween_property(fill, "modulate:a", 0.78, 0.14).from(0.18)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.13).from(Vector2(0.86, 0.86)).set_ease(Tween.EASE_OUT)
		tw.tween_property(archive, "scale", Vector2(1.08, 1.08), 0.13).from(Vector2(0.88, 0.88)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.08)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.94
	return feedback


func draw_flying_tile_route_art(tile: String, from_pos: Vector2, to_pos: Vector2) -> Control:
	# r214: bulk GPT chrome sweep
	if fx_layer == null or not is_instance_valid(fx_layer):
		return null
	var art = Control.new()
	art.name = "FlyingTileRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	art.z_index = FX_LAYER_Z_INDEX + 1
	fx_layer.add_child(art)
	var accent = tile_accent(tile) if tile != "" else GOLD_PRIMARY
	var viewport_size = effective_viewport_size()
	var start = Vector2(clamp(from_pos.x / viewport_size.x, 0.0, 1.0), clamp(from_pos.y / viewport_size.y, 0.0, 1.0))
	var end = Vector2(clamp(to_pos.x / viewport_size.x, 0.0, 1.0), clamp(to_pos.y / viewport_size.y, 0.0, 1.0))
	var route_left = min(start.x, end.x)
	var route_right = max(start.x, end.x)
	var route_top = min(start.y, end.y)
	var route_bottom = max(start.y, end.y)
	var arc_texture = add_illustration_texture(art, "flying_tile_arc", rect_full(route_left - 0.070, route_top - 0.180, route_right + 0.070, route_bottom + 0.120), 0.14, false)
	if arc_texture != null:
		arc_texture.name = "FlyingTileArcTexture"
	var route = make_gpt_route_rail(rect_full(route_left, (start.y + end.y) * 0.5 - 0.004, route_right, (start.y + end.y) * 0.5 + 0.004), Color(0.006, 0.016, 0.018, 0.38))
	route.name = "FlyingTileRouteRail"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.200, 0.840, 0.800), Color(accent.r, accent.g, accent.b, 0.26))
	fill.name = "FlyingTileRouteFill"
	route.add_child(fill)
	var source = make_gpt_plate_rect(rect_full(start.x - 0.014, start.y - 0.026, start.x + 0.014, start.y + 0.026), Color(accent.r, accent.g, accent.b, 0.22), "ui_jade_reading_plate")
	source.name = "FlyingTileSourceGate"
	art.add_child(source)
	var target = make_gpt_plate_rect(rect_full(end.x - 0.018, end.y - 0.032, end.x + 0.018, end.y + 0.032), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	target.name = "FlyingTileLandingGate"
	art.add_child(target)
	for i in range(3):
		var t = 0.250 + float(i) * 0.180
		var point = start.lerp(end, t)
		var tick = make_gpt_tick_strip(rect_full(point.x - 0.005, point.y - 0.020, point.x + 0.005, point.y + 0.020), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		tick.name = "FlyingTileRouteTick_0"
		art.add_child(tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if arc_texture != null:
			var arc_tw := create_screen_tween()
			arc_tw.set_loops(4)
			arc_tw.tween_property(arc_texture, "modulate:a", 0.24, 0.18).from(0.10)
			arc_tw.parallel().tween_property(arc_texture, "rotation", 0.04, 0.18).from(-0.04)
			arc_tw.tween_property(arc_texture, "modulate:a", 0.10, 0.18).from(0.24)
			arc_tw.parallel().tween_property(arc_texture, "rotation", -0.04, 0.18).from(0.04)
		var tw := create_screen_tween()
		tw.set_loops(4)
		tw.tween_property(fill, "modulate:a", 0.36, 0.18).from(0.92)
		tw.parallel().tween_property(target, "modulate:a", 0.56, 0.18).from(0.94)
		tw.tween_property(fill, "modulate:a", 0.92, 0.18).from(0.36)
		tw.parallel().tween_property(target, "modulate:a", 0.94, 0.18).from(0.56)
	return art


func draw_game_top_hud(parent: Control) -> void:
	# Keep the generated texture as a restrained header surface; status text and
	# controls remain the primary visual signal at 960x540.
	var hud = make_gpt_plate_rect(TOP_HUD_RECT, Color(0.028, 0.036, 0.032, 0.26), "ui_dark_scrim")
	hud.name = "TopHud3DShell"
	parent.add_child(hud)
	hud.clip_contents = true
	var hud_shadow = make_soft_depth_panel(hud, rect_full(0.010, 0.220, 0.990, 1.080), Color(0.0, 0.0, 0.0, 0.36), 12)
	hud_shadow.name = "TopHud3DCastShadow"
	hud.move_child(hud_shadow, 0)
	var hud_depth = make_soft_depth_panel(hud, rect_full(0.018, 0.620, 0.982, 0.980), Color(0.14, 0.084, 0.036, 0.24), 10)
	hud_depth.name = "TopHud3DDepthEdge"
	var hud_top_rim = make_soft_depth_panel(hud, rect_full(0.030, 0.015, 0.970, 0.095), Color(1.0, 0.92, 0.58, 0.12), 999)
	hud_top_rim.name = "TopHud3DTopRim"
	var hud_jade_rail = make_soft_depth_panel(hud, rect_full(0.040, 0.860, 0.960, 0.930), Color(0.42, 0.30, 0.14, 0.08), 999)
	hud_jade_rail.name = "TopHud3DJadeRail"
	var top_hud_gpt_key := "top_hud_gpt_banner"
	var gpt_top_hud_texture = add_optional_gpt_atlas_texture(hud, top_hud_gpt_key, Rect2(0.0, 0.0, 1254.0, 260.0), rect_full(0.000, 0.000, 1.000, 0.230), 0.06, false)
	if gpt_top_hud_texture != null:
		gpt_top_hud_texture.name = "TopHudGPTBannerTexture"
		# Keep the authored header material present without competing with the
		# long AI profile/status line at compact resolutions.
		gpt_top_hud_texture.modulate = Color(1.02, 1.00, 0.96, 0.018)
		hud.move_child(gpt_top_hud_texture, min(1, hud.get_child_count() - 1))

	# 模式徽章
	var mode_text := "单机 · " + rule_variant_short_label()
	var mode_tooltip := rule_variant_summary()
	if mode == "online_game":
		var server_variant := str(online_game.get("ruleVariant", "")).strip_edges().to_lower()
		if RULE_VARIANT_PROFILES.has(server_variant):
			mode_text = "联机 · " + rule_variant_short_label(server_variant)
			mode_tooltip = "服务器规则：" + rule_variant_summary(server_variant)
		else:
			mode_text = "联机 · 规则同步中"
			mode_tooltip = "等待服务器下发当前牌局规则"
	var mode_badge = make_badge(hud, TOP_HUD_MODE_BADGE_RECT, mode_text, 11, Color(0.100, 0.082, 0.058, 0.78), Color(0.52, 0.42, 0.22, 0.22), Color(0.94, 0.88, 0.72))
	mode_badge.name = "TopHudModeBadge"
	mode_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	mode_badge.tooltip_text = mode_tooltip
	draw_top_hud_status_art(hud)

	# 标题
	var dealer_wind: String = str(CENTER_WIND_LABELS[clampi(dealer_seat, 0, CENTER_WIND_LABELS.size() - 1)]) if mode == "offline" else ""
	var compact_top_hud := effective_viewport_size().x <= 960.0 or effective_viewport_size().y <= 560.0
	var room_code := str(online_game.get("roomCode", selected_room))
	var title_text = ("第%d局 · 庄%s" if compact_top_hud else "修炼场 · 第%d局 · 庄%s") % [offline_hand_number, dealer_wind] if mode == "offline" else "房间 " + online_room_code_summary(room_code)
	var title_rect := TOP_HUD_TITLE_RECT
	var status_rect := TOP_HUD_STATUS_RECT
	var wall_rect := TOP_HUD_WALL_RECT
	if mode == "offline":
		title_rect = Rect2(Vector2(0.106, 0.090), Vector2(0.260, 0.535))
		status_rect = Rect2(Vector2(0.270, 0.090), Vector2(0.610, 0.515))
		wall_rect = Rect2(Vector2(0.632, 0.140), Vector2(0.766, 0.860))
	else:
		# Reserve the info button lane before measuring the room title. The full
		# room code remains in the tooltip/detail route, while status keeps its own
		# stable lane and cannot be covered by a long server identifier.
		title_rect = Rect2(Vector2(0.106, 0.090), Vector2(0.300, 0.535))
		status_rect = Rect2(Vector2(0.338, 0.090), Vector2(0.432, 0.515))
	# r202: GPT title/status chips instead of make_panel lacquer hosts
	var title_back = make_gpt_plate_rect(rect_full(title_rect.position.x - 0.008, 0.020, title_rect.size.x + 0.006, 0.685), Color(0.90, 0.72, 0.34, 0.18), "ui_dark_scrim")
	title_back.name = "TopHudTitleBack"
	hud.add_child(title_back)
	var status_back = make_gpt_plate_rect(rect_full(status_rect.position.x - 0.008, 0.020, status_rect.size.x + 0.006, 0.685), Color(0.58, 0.74, 0.64, 0.16), "ui_dark_scrim")
	status_back.name = "TopHudStatusBack"
	hud.add_child(status_back)
	var online_title_size := 16
	if mode == "online_game":
		# Room codes are server data and must remain intact; reduce only the title
		# glyph size for unusually long codes inside the dedicated header lane.
		online_title_size = 15 if room_code.length() > 14 else 16
	var title = make_label(hud, title_text, 15 if mode == "offline" else online_title_size, Color(0.96, 0.80, 0.48), true)
	title.name = "TopHudTitle"
	apply_rect(title, title_rect)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(title)
	title.set_meta("fit_before_clip", true)
	title.set_meta("compact_lane", "mode_and_round_before_status")
	set_ui_full_text(title, title_text, "牌桌标题：" + title_text)
	if mode == "online_game" and room_code != "":
		title.tooltip_text = "完整房间号：%s" % room_code
		title.set_meta("room_code", room_code)
		var room_copy := make_icon_button("copy", Color(0.94, 0.84, 0.54), 13, Callable(self, "show_online_room_code_detail"))
		room_copy.name = "TopHudRoomCodeCopyButton"
		room_copy.tooltip_text = "复制完整房间号"
		room_copy.set_meta("accessible_name", "复制完整房间号")
		room_copy.set_meta("ui_full_text", "完整房间号：" + room_code)
		room_copy.set_meta("action_role", "copy_room_code")
		room_copy.set_meta("copy_value", room_code)
		room_copy.set_meta("ui_min_touch_target", UI_MIN_TOUCH_TARGET)
		apply_rect(room_copy, rect_full(0.305, 0.110, 0.333, 0.650))
		hud.add_child(room_copy)
		title.set_meta("room_summary_contract", "short_middle_marker_plus_full_copy_action")
		mark_ui_optimization(room_copy, "F-251")
		mark_ui_optimization(title, "F-105")

	# 状态
	var compact_disconnect_status := mode == "online_game" and online_feedback.find("连接已断开") >= 0
	var status = make_label(hud, top_hud_short_status_text(compact_top_hud), 15 if mode == "offline" else (15 if compact_disconnect_status else 16), Color(0.92, 0.94, 0.86), true)
	status.name = "TopHudStatus"
	apply_rect(status, status_rect)
	configure_clipped_label(status)
	status.set_meta("fit_before_clip", true)
	status.set_meta("compact_lane", "phase_and_connection_before_wall")
	set_ui_full_text(status, top_hud_status_tooltip_text(), "牌桌状态")
	status.set_meta("hud_slot_contract", "room_title_phase_status_wall")
	status.set_meta("status_priority", "phase_over_transient_feedback")
	mark_ui_optimization(status, "F-106")
	# Keep transient gameplay feedback connected to the visible HUD instance.
	# The shared reference is also used by set_status() for immediate errors.
	status_label = status
	if mode == "online_game":
		var connection_status := online_connection_status_text()
		var connection_color := Color(0.40, 0.78, 0.60) if connection_status == "已连接" else Color(0.92, 0.70, 0.34) if connection_status == "断线" or connection_status == "连接异常" else Color(0.52, 0.72, 0.78)
		var connection_surface := make_gpt_plate_rect(rect_full(0.106, 0.580, 0.268, 0.940), Color(0.018, 0.036, 0.034, 0.62), "ui_dark_scrim")
		connection_surface.name = "TopHudOnlineConnectionStatus"
		connection_surface.set_meta("ui_state_source", "tcp_status")
		connection_surface.set_meta("accessible_name", online_connection_status_detail())
		connection_surface.set_meta("ui_full_text", online_connection_status_detail())
		connection_surface.tooltip_text = online_connection_status_detail()
		hud.add_child(connection_surface)
		var connection_icon := add_lucide_icon(connection_surface, "wifi", rect_full(0.070, 0.180, 0.245, 0.820), connection_color)
		if connection_icon != null:
			connection_icon.name = "TopHudOnlineConnectionIcon"
		var connection_label := make_label(connection_surface, connection_status, 9, connection_color, true)
		connection_label.name = "TopHudOnlineConnectionLabel"
		apply_rect(connection_label, rect_full(0.285, 0.120, 0.950, 0.880))
		connection_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		configure_clipped_label(connection_label)
		set_ui_full_text(connection_label, connection_status, online_connection_status_detail())
		mark_ui_optimization(connection_surface, "F-560")
		mark_ui_optimization(connection_surface, "F-561")
	draw_top_hud_hand_progress(hud)

	# 离线战斗中分数已在四家座位卡常驻显示，顶部不再重复铺一整条分数面板。
	if mode != "offline":
		draw_score_strip(hud, TOP_HUD_SCORE_STRIP_RECT)

	# 余牌信息
	var wall_back = make_gpt_plate_rect(rect_full(wall_rect.position.x - 0.006, wall_rect.position.y - 0.010, wall_rect.size.x + 0.006, wall_rect.size.y + 0.010), Color(0.72, 0.56, 0.28, 0.10), "ui_dark_scrim")
	wall_back.name = "TopHudWallBack"
	hud.add_child(wall_back)
	draw_top_hud_wall_meter(hud, wall_rect)
	var wall_detail := "牌墙剩余 %d/%d 张 · %s · 上张%s" % [get_wall_count(), display_wall_total(), wall_state_text(), tile_label(get_last_discard()) if get_last_discard() != "" else "无"]
	var wall = make_label(hud, "余牌 %d/%d" % [get_wall_count(), display_wall_total()], 11, Color(0.90, 0.88, 0.74), true)
	wall.name = "TopHudWallText"
	var empty_wall := StyleBoxEmpty.new()
	empty_wall.set_content_margin_all(4)
	wall.add_theme_stylebox_override("normal", empty_wall)
	var wall_chip = add_optional_gpt_illustration_texture(wall, "ui_dark_scrim", rect_full(-0.04, -0.08, 1.04, 1.08), 0.22, false)
	if wall_chip != null:
		wall_chip.name = "WallCountGptPlate"
		wall.move_child(wall_chip, 0)
	apply_rect(wall, rect_full(wall_rect.position.x + 0.010, wall_rect.position.y + 0.070, wall_rect.size.x - 0.010, wall_rect.position.y + 0.460))
	configure_clipped_label(wall)
	set_ui_full_text(wall, wall_detail, "牌墙剩余：%d/%d" % [get_wall_count(), display_wall_total()])
	wall.set_meta("wall_count", get_wall_count())
	wall.set_meta("wall_total", display_wall_total())
	wall.set_meta("wall_state", wall_state_text())
	wall.set_meta("status_priority", "remaining_tiles_before_last_discard")
	mark_ui_optimization(wall, "F-255")
	var wall_state = make_label(hud, "状态 · %s · 上张%s" % [wall_state_text().replace("牌墙", ""), tile_label(get_last_discard()) if get_last_discard() != "" else "无"], 9, Color(0.78, 0.82, 0.72), false)
	wall_state.name = "TopHudWallState"
	apply_rect(wall_state, rect_full(wall_rect.position.x + 0.010, wall_rect.position.y + 0.500, wall_rect.size.x - 0.010, wall_rect.position.y + 0.840))
	wall_state.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	configure_clipped_label(wall_state)
	set_ui_full_text(wall_state, wall_detail, "牌墙状态：" + wall_state_text())

	# 操作按钮组
	var settings = make_top_hud_button("设置", Color(0.45, 0.34, 0.18), func() -> void:
		toggle_settings_panel()
	)
	settings.name = "TopHudSettingsButton"
	hud.add_child(settings)
	apply_rect(settings, TOP_HUD_SETTINGS_BUTTON_RECT)
	set_ui_full_text(settings, "打开牌桌设置、音频和辅助选项", "牌桌设置")
	settings.set_meta("hud_action_role", "settings")
	settings.set_meta("focus_order", 1)
	mark_ui_optimization(settings, "F-252")

	var back = make_top_hud_button("返回", Color(0.38, 0.30, 0.18), func() -> void:
		if mode == "offline":
			show_exit_confirm()
		else:
			show_online_lobby()
	)
	back.name = "TopHudBackButton"
	hud.add_child(back)
	apply_rect(back, TOP_HUD_BACK_BUTTON_RECT)
	set_ui_full_text(back, "离开当前牌桌并返回上一层", "返回上一层")
	back.set_meta("hud_action_role", "back")
	back.set_meta("focus_order", 2)
	mark_ui_optimization(back, "F-253")

	var update = make_top_hud_button("更新", Color(0.54, 0.36, 0.18), func() -> void:
		on_update_primary_pressed()
	)
	update.name = "TopHudUpdateButton"
	hud.add_child(update)
	apply_rect(update, TOP_HUD_UPDATE_BUTTON_RECT)
	set_ui_full_text(update, "检查并查看当前版本更新状态", "检查更新")
	update.set_meta("hud_action_role", "update")
	update.set_meta("focus_order", 3)
	mark_ui_optimization(update, "F-254")
	refresh_top_hud_update_button(update)


func draw_hand(parent: Control) -> void:
	# r213: GPT chrome conversion
	# 手牌托盘 - 增强视觉效果
	var hand := get_self_hand()
	normalized_hand_keyboard_selection(hand)
	var compact_hand_art := effective_viewport_size().y <= 560.0 or effective_viewport_size().x <= 1100.0
	var tray = make_gpt_center_crop_plate_rect(HAND_TRAY_RECT, Color(0.018, 0.026, 0.024, 0.97), "ui_dark_scrim", 0.20)
	tray.name = "HandTray"
	tray.set_meta("bottom_gutter_px", 8.0)
	tray.set_meta("tile_bottom_clearance_px", 8.0)
	parent.add_child(tray)
	set_ui_full_text(tray, "手牌区：点击或按 Enter 打出选中的牌；当前状态和教学提示位于上方", "玩家手牌区")
	mark_ui_optimization(tray, "F-483")
	# Keep the tile lane's one-tile gutter available for hover/focus art. The
	# stage and tile hit frames remain bounded; only the visual lift may cross the
	# tray edge by a few pixels.
	tray.clip_contents = false
	tray.set_meta("overflow_contract", "tray_allows_6px_visual_gutter_only")
	tray.set_meta("tile_stage_owner", "HandTrayTileStage")
	mark_ui_optimization(tray, "F-248")
	var tray_shadow = make_soft_depth_panel(tray, rect_full(0.010, 0.145, 0.990, 1.060), Color(0.0, 0.0, 0.0, 0.38), 18)
	tray_shadow.name = "HandTray3DCastShadow"
	tray.move_child(tray_shadow, 0)
	var tray_lip = make_soft_depth_panel(tray, rect_full(0.025, 0.025, 0.975, 0.185), Color(1.0, 0.94, 0.64, 0.28), 999)
	tray_lip.name = "HandTray3DFrontLip"
	var tray_side_bevel = make_soft_depth_panel(tray, rect_full(0.010, 0.140, 0.035, 0.900), Color(1.0, 0.94, 0.66, 0.20), 999)
	tray_side_bevel.name = "HandTray3DSideBevel"
	var hand_gpt_key := "hand_gpt_tray"
	var gpt_hand_texture = add_optional_gpt_illustration_texture(tray, hand_gpt_key, rect_full(0.000, 0.000, 1.000, 0.990), 0.28, false)
	if gpt_hand_texture != null:
		gpt_hand_texture.name = "HandGPTTrayTexture"
		# Keep the authored tray material as a quiet edge texture beneath the tiles.
		gpt_hand_texture.modulate = Color(1.20, 1.12, 1.02, 0.18)
		tray.move_child(gpt_hand_texture, min(1, tray.get_child_count() - 1))
	var tile_stage = make_gpt_plate_rect(rect_full(0.010, 0.170, 0.990, 0.955), Color(0.08, 0.06, 0.04, 0.22), "ui_button_face_plate")
	tile_stage.name = "HandTrayTileStage"
	tile_stage.clip_contents = true
	tile_stage.set_meta("visual_focus_gutter_px", 6.0)
	tile_stage.set_meta("visual_animation_boundary", "stage_clip_and_gutter")
	tray.clip_contents = false
	tray.add_child(tile_stage)
	var tile_ground_shadow = make_soft_depth_panel(tile_stage, rect_full(0.030, 0.575, 0.970, 1.060), Color(0.0, 0.0, 0.0, 0.40), 16)
	tile_ground_shadow.name = "HandTrayTileGroundShadow"
	var tile_back_rail = make_gpt_route_rail(rect_full(0.020, 0.055, 0.980, 0.155), Color(0.94, 0.76, 0.44, 0.16))
	tile_back_rail.name = "HandTrayTileBackRail"
	tile_stage.add_child(tile_back_rail)
	var tile_baseline = make_gpt_route_rail(rect_full(0.030, 0.805, 0.970, 0.900), Color(0.0, 0.0, 0.0, 0.42))
	tile_baseline.name = "HandTrayTileBaseline"
	tile_stage.add_child(tile_baseline)
	tray.move_child(tile_stage, min(2, tray.get_child_count() - 1))

	# Keep the disconnect state as one dedicated recovery line. Its old duplicate
	# shortcut row was too short at 960x540 and competed with the first tile row.
	var shortcut_hint_text := hand_shortcut_hint_text()
	var disconnected_hand_state := mode == "online_game" and online_game_disconnected()
	var tutorial_hint_visible := show_hand_hint and can_self_discard() and (tutorial_step == TUTORIAL_STEP_NEW or tutorial_step == TUTORIAL_STEP_DISCARD or tutorial_step == TUTORIAL_STEP_WIN)
	var tray_detail_text := hand_tray_text()
	var tray_text = make_label(tray, hand_tray_visible_text(), 14, Color(0.92, 0.82, 0.56), true)
	tray_text.name = "HandTrayStatusText"
	tray_text.clip_text = true
	if disconnected_hand_state:
		tray.set_meta("interaction_state", "read_only")
		tray.set_meta("disabled_reason", "牌局已断线，手牌只读；请先重连")
		tray.set_meta("tile_visual_policy", "assets_tiles_2d_untinted")
		tray.set_meta("read_only_recovery_owner", "OnlineReconnectGameButton")
		mark_ui_optimization(tray, "F-897")
		tray_text.text = "只读 · 等待重连；手牌不会提交"
		set_ui_full_text(tray_text, tray_text.text, "断线牌桌状态：手牌只读；请使用重连入口")
		# Do not tint the authored 2D tile faces to communicate transport state. The
		# state owns a text badge and the tray remains visually faithful to the tile
		# assets while its hit targets stay disabled.
		tray.modulate = Color.WHITE
		var readonly_badge := make_badge(tray, rect_full(0.755, 0.170, 0.982, 0.255), "牌局只读", 10, Color(0.22, 0.16, 0.10, 0.94), Color(0.96, 0.68, 0.34, 0.68), Color(1.0, 0.90, 0.68))
		readonly_badge.name = "OnlineHandReadOnlyBadge"
		readonly_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_ui_full_text(readonly_badge, "牌局已断线，手牌不会提交；请从行动栏重连", "手牌只读状态")
		readonly_badge.set_meta("read_only_owner", "OnlineReconnectGameButton")
		mark_ui_optimization(readonly_badge, "F-896")
	var tray_text_rect := rect_full(0.030, 0.018, 0.745, 0.082) if disconnected_hand_state else (rect_full(0.030, 0.018, 0.760, 0.082) if shortcut_hint_text != "" else HAND_TRAY_TEXT_RECT)
	apply_rect(tray_text, tray_text_rect)
	tray_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(tray_text)
	set_ui_full_text(tray_text, tray_detail_text, "手牌托盘状态：" + tray_detail_text)
	tray_text.set_meta("prompt_lane_contract", "above_tiles_and_action_dock")
	tray_text.set_meta("minimum_clearance_px", 6.0)
	mark_ui_optimization(tray_text, "F-033")
	mark_ui_optimization(tray_text, "F-095")
	mark_ui_optimization(tray_text, "F-098")
	if disconnected_hand_state:
		mark_ui_optimization(tray_text, "F-056")
	if has_pending_claim_window() or has_pending_danger_discard() or tutorial_hint_visible:
		tray_text.visible = false
	if shortcut_hint_text != "":
		var shortcut_label = make_label(tray, shortcut_hint_text, commercial_ui_font_size(11, 1), Color(0.68, 0.76, 0.70, 0.88), false)
		shortcut_label.name = "HandTrayShortcutHint"
		apply_rect(shortcut_label, rect_full(0.034, 0.090, 0.758, 0.166))
		shortcut_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		configure_clipped_label(shortcut_label)
		set_ui_full_text(shortcut_label, shortcut_hint_text, "手牌快捷操作：" + shortcut_hint_text)
		shortcut_label.set_meta("prompt_lane", "above_tiles")
		shortcut_label.set_meta("minimum_clearance_px", 6.0)
		shortcut_label.visible = not tutorial_hint_visible
		mark_ui_optimization(shortcut_label, "F-095")
		mark_ui_optimization(shortcut_label, "F-097")

	# 状态徽章
	var state_chip = add_optional_gpt_illustration_texture(tray, "ui_hand_tray_state_chip", rect_full(0.783, 0.028, 0.982, 0.157), 0.55, false)
	if state_chip != null:
		state_chip.name = "HandTrayStateChip"
	var hand_state_text := hand_tray_state_text()
	var state_badge = make_badge(tray, HAND_TRAY_STATE_BADGE_RECT, hand_state_text, 12, hand_tray_state_fill(), hand_tray_state_border(), Color(0.92, 0.92, 0.84))
	state_badge.name = "HandTrayStateBadge"
	state_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	state_badge.tooltip_text = "手牌状态：%s · %s" % [hand_state_text, hand_tray_text()]
	set_ui_full_text(state_badge, hand_tray_text(), "手牌状态：" + hand_state_text)
	state_badge.set_meta("ui_short_text", hand_state_text)
	state_badge.set_meta("state_detail", hand_tray_text())
	state_badge.set_meta("status_priority", "prompt_over_idle_state")
	mark_ui_optimization(state_badge, "F-256")
	mark_ui_optimization(state_badge, "F-417")
	if has_pending_claim_window() or tutorial_hint_visible:
		state_badge.visible = false

	# 新手提示：仅在首次出牌和收尾 checkpoint 展示；完成/跳过后永久收起。
	if tutorial_hint_visible:
		# The prompt owns the tray's top lane; it never sits above a tile hit target.
		var hint_panel = make_gpt_plate_rect(rect_full(0.02, 0.012, 0.98, 0.225), Color(0.020, 0.042, 0.048, 0.96), "ui_button_face_plate")
		hint_panel.name = "HandTrayTutorialHint"
		hint_panel.set_meta("prompt_lane", "stable_tutorial_lane_above_hand_hit_rect")
		hint_panel.set_meta("stable_height_px", 20.0)
		hint_panel.set_meta("tile_hit_rect_unchanged", true)
		tray.add_child(hint_panel)
		hint_panel.z_index = 8
		hint_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		hint_panel.clip_contents = false
		hint_panel.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.014, 1.0), Color(0.30, 0.62, 0.52, 0.56)))
		draw_hand_tutorial_hint_art(hint_panel)
		var hint_text = tutorial_hand_hint_text()
		var hint_label = make_label(hint_panel, hint_text, 10, Color(0.94, 0.96, 0.92), false)
		hint_label.name = "HandTrayTutorialHintText"
		apply_rect(hint_label, rect_full(0.155, 0.055, 0.720, 0.945))
		hint_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		hint_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		hint_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		hint_label.tooltip_text = hint_text
		hint_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		hint_label.clip_text = false
		hint_label.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
		configure_wrapped_label(hint_label, maxf(180.0, effective_viewport_size().x * 0.360), 0.0, 3.0)
		mark_ui_optimization(hint_panel, "F-416")
		mark_ui_optimization(hint_label, "F-416")
		mark_ui_optimization(hint_panel, "F-097")
		mark_ui_optimization(hint_label, "F-097")
		if tutorial_step == TUTORIAL_STEP_WIN:
			var finish_tutorial_button = make_small_button("完成", Color(0.42, 0.68, 0.52), Callable(self, "complete_tutorial"))
			finish_tutorial_button.name = "HandTutorialCompleteButton"
			finish_tutorial_button.custom_minimum_size = Vector2(58, UI_MIN_TOUCH_TARGET)
			finish_tutorial_button.add_theme_font_size_override("font_size", 9)
			finish_tutorial_button.tooltip_text = "保存教学完成状态并关闭提示"
			finish_tutorial_button.set_meta("tutorial_action", "complete")
			finish_tutorial_button.set_meta("prompt_lane_owner", "HandTrayTutorialHint")
			mark_ui_optimization(finish_tutorial_button, "F-097")
			apply_rect(finish_tutorial_button, rect_full(0.735, 0.060, 0.895, 0.940))
			hint_panel.add_child(finish_tutorial_button)
		else:
			var skip_tutorial_button = make_icon_button("x", Color(0.58, 0.38, 0.30), 14, Callable(self, "skip_tutorial"))
			skip_tutorial_button.name = "HandTutorialSkipButton"
			skip_tutorial_button.custom_minimum_size = Vector2(UI_MIN_TOUCH_TARGET, UI_MIN_TOUCH_TARGET)
			skip_tutorial_button.tooltip_text = "跳过教学；之后可从菜单入口重新开始"
			skip_tutorial_button.set_meta("tutorial_action", "skip")
			skip_tutorial_button.set_meta("prompt_lane_owner", "HandTrayTutorialHint")
			mark_ui_optimization(skip_tutorial_button, "F-097")
			apply_rect(skip_tutorial_button, rect_full(0.905, 0.060, 0.975, 0.940))
			hint_panel.add_child(skip_tutorial_button)
		# 激活交互式引导
		interactive_guide_active = true
		interactive_guide_type = "discard"

	var suit_flow = draw_hand_tray_suit_flow(tray, hand)
	if suit_flow != null:
		suit_flow.modulate = Color(1.0, 1.0, 1.0, 0.62)
	var momentum_art = draw_hand_tray_momentum_art(tray, hand)
	if momentum_art != null:
		momentum_art.visible = not compact_hand_art
		momentum_art.modulate = Color(1.0, 1.0, 1.0, 0.16)
	var completion_bus = draw_hand_tray_completion_bus_art(tray, hand)
	if completion_bus != null:
		completion_bus.visible = not compact_hand_art
		completion_bus.modulate = Color(1.0, 1.0, 1.0, 0.12)
	var hand_layout = hand_layout_metrics(hand)
	var assist_enabled = player_ai_assist_enabled()
	var suggested_tile = suggest_human_discard() if assist_enabled else ""
	var hand_reports = discard_report_map_for_hand() if assist_enabled else {}
	var pending_tile = pending_danger_discard_tile if assist_enabled and has_pending_danger_discard() else ""
	var suggested_index := discard_report_index_for_tile(hand_reports, suggested_tile) if suggested_tile != "" else -1
	if suggested_index < 0 or suggested_index >= hand.size() or str(hand[suggested_index]) != suggested_tile:
		suggested_index = -1
	var pending_index: int = pending_danger_discard_index if pending_tile != "" else -1
	if pending_index < 0 or pending_index >= hand.size() or str(hand[pending_index]) != pending_tile:
		pending_index = -1
	if interactive_guide_active and interactive_guide_type == "discard":
		if interactive_guide_target_index < 0 or interactive_guide_target_index >= hand.size() or not hand_keyboard_tile_selectable(interactive_guide_target_index, hand):
			interactive_guide_target_index = suggested_index if suggested_index >= 0 else hand_tile_index_for_advice(hand, str(hand[0])) if not hand.is_empty() else -1
	var tile_width = float(hand_layout.get("tile_width", HAND_TILE_MAX_WIDTH))
	var tile_height = float(hand_layout.get("tile_height", tile_width * HAND_TILE_ASPECT))
	var group_gap_width = maxf(4.0, float(hand_layout.get("group_gap_width", 4.0)))
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	var drawn_serial = int(offline_last_draw.get("serial", -1))
	var stable_drawn_index := int(offline_last_draw.get("hand_index", -1))
	if mode != "offline" or int(offline_last_draw.get("seat", -1)) != 0 or drawn_tile == "" or hand.size() % 3 != 2 or stable_drawn_index < 0 or stable_drawn_index >= hand.size() or str(hand[stable_drawn_index]) != drawn_tile:
		stable_drawn_index = -1
	# Consume an announced draw on the first hand render even when reduced motion
	# suppresses the visual tween; otherwise the same replacement draw is retried
	# on every subsequent render.
	var should_animate_drawn_tile = mode == "offline" and bool(offline_last_draw.get("announce", false)) and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "" and drawn_serial != fx_last_animated_draw_serial
	var draw_state_assigned := false
	# Pure 2D hand: authored assets/tiles faces via make_tile_view (no realtime 3D stage).

	var hand_box = HBoxContainer.new()
	hand_box.name = "HandTrayTiles"
	hand_box.alignment = BoxContainer.ALIGNMENT_CENTER
	configure_passive_container(hand_box)
	hand_box.clip_contents = false
	hand_box.set_meta("hover_gutter_px", 6.0)
	hand_box.set_meta("overflow_contract", "native_hit_rect_bounded_visual_gutter_6px")
	hand_box.set_meta("clip_owner", "HandTrayTileStage_metadata_boundary")
	hand_box.set_meta("layout_required_width", hand_layout_required_width(hand, hand_layout))
	hand_box.set_meta("layout_content_width", float(hand_layout.get("content_width", 0.0)))
	hand_box.set_meta("layout_fits_content", hand_layout_fits_content(hand, hand_layout))
	hand_box.set_meta("group_gap_width", group_gap_width)
	hand_box.set_meta("group_gap_min_px", HAND_MIN_GROUP_GAP)
	hand_box.set_meta("tile_texture_bleed", Vector2.ZERO)
	hand_box.set_meta("keyboard_navigation", "左右方向键选择，Enter出牌")
	hand_box.set_meta("focusable_tile_count", hand.size())
	hand_box.set_meta("interaction_state", "interactive" if can_self_discard() else "read_only")
	hand_box.set_meta("focus_restore_route", "hand_source_index")
	hand_box.set_meta("bottom_gutter_px", 8.0)
	hand_box.set_meta("tile_sampling_policy", "assets_tiles_2d_native_bounds")
	mark_ui_optimization(hand_box, "F-257")
	mark_ui_optimization(hand_box, "F-484")
	mark_ui_optimization(hand_box, "F-248")
	hand_box.add_theme_constant_override("separation", maxi(0, int(hand_layout.get("separation", 4))))
	hand_box.z_index = 4
	apply_rect(hand_box, HAND_TRAY_TILES_RECT)
	# Keep the 46px compact hit target clear of the tray's bottom lip while
	# retaining a visible separation from the tutorial lane above it.
	hand_box.offset_top = -2.5
	hand_box.offset_bottom = -8.0
	tray.add_child(hand_box)

	# 手牌滑入动画
	if ui_motion_enabled():
		tray.modulate = Color(1, 1, 1, 0)
		tray.offset_top = 24.0
		var tw := create_screen_tween()
		var slide_dur := float(HAND_SLIDE_IN_DURATION_MSEC) / 1000.0
		tw.set_parallel(true)
		tw.tween_property(tray, "modulate:a", 1.0, slide_dur).from(0.0)
		tw.tween_property(tray, "offset_top", 0.0, slide_dur).from(24.0)

	for i in range(hand.size()):
		var index = i
		var tile = str(hand[i])
		if should_insert_hand_group_gap(hand, i):
			hand_box.add_child(make_hand_group_spacer(tile_height, group_gap_width, hand_group_label(tile)))
		var clickable = can_self_discard() and not is_claim_discard_banned(0, tile)
		var keyboard_selected := clickable and i == hand_keyboard_selection
		# 新手引导高亮：可点击时添加视觉提示
		var should_highlight = clickable and (i == suggested_index or i == pending_index)
		var guide_highlight = interactive_guide_active and interactive_guide_type == "discard" and clickable and i == interactive_guide_target_index
		var highlighted = should_highlight or guide_highlight or keyboard_selected
		var report: Dictionary = hand_reports.get(i, {}) if i == suggested_index or i == pending_index else {}
		var risk = str(report.get("safety_label", report.get("risk_label", ""))) if assist_enabled and clickable else ""
		var is_drawn_tile_marker := i == stable_drawn_index
		var is_drawn_tile := should_animate_drawn_tile and stable_drawn_index >= 0 and i == stable_drawn_index
		var hint_badge := ""
		var state_tokens: Array[String] = []
		if assist_enabled and clickable:
			if i == pending_index:
				hint_badge = "确认"
				state_tokens.append("确认")
			elif i == suggested_index:
				hint_badge = "荐"
				state_tokens.append("推荐")
			elif is_drawn_tile_marker:
				hint_badge = "摸"
				state_tokens.append("刚摸")
		elif is_drawn_tile_marker:
			# The drawn state is table state, not an AI-only hint. Keep a stable
			# marker when assistance is disabled so identical tiles remain distinct.
			hint_badge = "摸"
			state_tokens.append("刚摸")
		if keyboard_selected and hint_badge == "":
			hint_badge = "选"
		if keyboard_selected:
			state_tokens.append("键盘选中")
		var online_identity := online_hand_identity_at(index, tile) if mode == "online_game" else ""
		var callback = func() -> void:
			# 玩家执行操作时关闭引导
			if interactive_guide_active:
				if interactive_guide_type == "discard" and interactive_guide_target_index >= 0 and index != interactive_guide_target_index:
					set_status("教学目标是第%d张牌，当前牌仍可正常出牌。" % (interactive_guide_target_index + 1))
				interactive_guide_active = false
				interactive_guide_type = ""
				interactive_guide_target_index = -1
			if mode == "offline":
				human_discard(index)
			else:
				send_online_discard_by_identity(online_identity, tile, "打出%s" % tile_label(tile))
		var tile_node = make_tile_view(tile, Vector2(tile_width, tile_height), clickable, callback, highlighted, risk, hint_badge)
		tile_node.name = "HandTile_%02d_%s" % [i, tile]
		tile_node.set_meta("visual_focus_gutter_px", 6.0)
		tile_node.set_meta("visual_animation_boundary", "hand_tile_stage")
		tile_node.set_meta("visual_overflow_px", 6.0)
		tile_node.set_meta("overflow_contract", "draw_sparkles_stay_within_hand_tray_gutter")
		tile_node.set_meta("hand_source_index", i)
		tile_node.set_meta("hand_identity", online_identity)
		tile_node.set_meta("hand_tile_code", tile)
		tile_node.set_meta("state_summary", "、".join(state_tokens) if not state_tokens.is_empty() else "普通可出牌")
		tile_node.set_meta("badge_priority", "确认>推荐>刚摸>键盘选中")
		tile_node.set_meta("badge_policy", "one_face_badge_plus_full_state_tooltip")
		tile_node.set_meta("drawn_tile", i == stable_drawn_index)
		tile_node.set_meta("danger_pending", i == pending_index)
		tile_node.set_meta("advisor_target", i == suggested_index)
		tile_node.set_meta("guide_target", i == interactive_guide_target_index)
		tile_node.set_meta("keyboard_selected", keyboard_selected)
		tile_node.set_meta("focus_state", "keyboard_selected" if keyboard_selected else ("available" if clickable else "read_only"))
		tile_node.set_meta("focus_hint", "Enter确认出牌；左右方向键移动" if keyboard_selected else "点击或按方向键选择")
		tile_node.tooltip_text = hand_tile_interaction_tooltip(tile, report, hint_badge, is_drawn_tile_marker)
		mark_ui_optimization(tile_node, "F-045")
		mark_ui_optimization(tile_node, "F-248")
		if mode == "online_game":
			mark_ui_optimization(tile_node, "F-046")
		if not state_tokens.is_empty():
			tile_node.tooltip_text += " · 状态：" + "、".join(state_tokens)
		if disconnected_hand_state:
			tile_node.tooltip_text = "只读手牌：%s；等待重连后才能提交" % tile_label(tile)
			tile_node.set_meta("disabled_reason", "牌局已断线，手牌只读")
		tile_node.set_meta("accessible_name", "手牌第%d张：%s" % [i + 1, tile_label(tile)])
		mark_ui_optimization(tile_node, "F-258")
		mark_ui_optimization(tile_node, "F-485")
		if keyboard_selected and hint_badge != "选":
			tile_node.tooltip_text += " · 键盘已选 · Enter确认出牌"
		if is_drawn_tile_marker:
			# The HBox owns the stable row height; this inner mount lets the drawn
			# tile rise without moving its hit frame outside the tray.
			var drawn_mount := Control.new()
			drawn_mount.name = "HandDrawnTileMount"
			drawn_mount.custom_minimum_size = Vector2(tile_width, tile_height)
			drawn_mount.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			drawn_mount.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			drawn_mount.mouse_filter = Control.MOUSE_FILTER_IGNORE
			hand_box.add_child(drawn_mount)
			drawn_mount.add_child(tile_node)
			tile_node.size = Vector2(tile_width, tile_height)
			# Keep the mount and frame stable; lift the shared visual/hit body once.
			# This moves the authored face and its native button together.
			var drawn_body := tile_node.get_child(0) as Control if tile_node.get_child_count() > 0 else null
			if drawn_body != null:
				# The draw animation provides the temporary lift; the settled face
				# remains on the shared hand baseline with neighboring tiles.
				tile_node.set_meta("drawn_visual_lift", 0.0)
				var drawn_baseline := make_gpt_route_rail(rect_full(0.04, 0.84, 0.96, 0.985), Color(0.94, 0.78, 0.38, 0.58))
				drawn_baseline.name = "HandDrawnTileBaseline"
				drawn_baseline.mouse_filter = Control.MOUSE_FILTER_IGNORE
				drawn_baseline.set_meta("stable_drawn_marker", true)
				drawn_mount.add_child(drawn_baseline)
				mark_ui_optimization(drawn_mount, "F-415")
				mark_ui_optimization(drawn_mount, "F-044")
		else:
			hand_box.add_child(tile_node)
		if is_drawn_tile:
			# Run the one-shot entry effect for normal and replacement draws.
			draw_state_assigned = true
			tile_node.set_meta("drawn_anim_pending", false)
			play_hand_draw_tile_animation(tile_node, str(offline_last_draw.get("source", "normal")))
	if draw_state_assigned:
		fx_last_animated_draw_serial = drawn_serial


func draw_hand_progress_wall_sync(parent: Control, accent: Color) -> Control:
	# r213: GPT chrome conversion
	var wall_ratio := wall_progress()
	var pressure = 1.0 - wall_ratio
	var color = wall_meter_color(wall_ratio)
	var sync = Control.new()
	sync.name = "HandProgressWallSyncRoute"
	sync.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(sync, rect_full(0.602, 0.075, 0.792, 0.585))
	parent.add_child(sync)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.270, 0.135, 0.730), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "HandProgressWallSyncSource"
	sync.add_child(source)
	var rail = make_gpt_route_rail(rect_full(0.095, 0.420, 0.895, 0.580), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "HandProgressWallSyncRail"
	sync.add_child(rail)
	var fill_width = 0.095 + 0.800 * clamp(0.18 + pressure * 0.82, 0.18, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.095, 0.440, fill_width, 0.560), Color(color.r, color.g, color.b, 0.28 + pressure * 0.18))
	fill.name = "HandProgressWallSyncFill"
	sync.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.860, 0.265, 0.995, 0.735), Color(color.r, color.g, color.b, 0.16 + pressure * 0.12))
	gate.name = "HandProgressWallSyncGate"
	sync.add_child(gate)
	var tick = add_gpt_tick_strip(sync, rect_full(0.245, 0.315, (0.285) + float(2) * (0.190), 0.685), Color(color.r, color.g, color.b, 0.18 + pressure * 0.10), "HandProgressWallSyncTick_0")
	if wall_is_low():
		var warning = make_gpt_gate(rect_full(0.790, 0.020, 0.985, 0.250), Color(0.56, 0.14, 0.08, 0.30))
		warning.name = "HandProgressWallSyncLowWarning"
		sync.add_child(warning)
	fill.modulate = Color(1, 1, 1, 0.84)
	return sync


func draw_hand_tray_action_path(parent: Control, hand: Array) -> Control:
	var path = Control.new()
	path.name = "HandTrayActionPath"
	path.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(path, rect_full(0.752, 0.835, 0.985, 0.965))
	parent.add_child(path)
	var active = can_self_discard()
	var responding = mode == "offline" and offline_phase == "pending_claim"
	var accent = hand_tray_state_fill()
	var base_alpha := 0.34 if active else 0.18
	if responding:
		base_alpha = 0.30
	# r204 GPT path chrome
	var rail = make_gpt_route_rail(rect_full(0.040, 0.420, 0.920, 0.580), Color(accent.r, accent.g, accent.b, base_alpha))
	rail.name = "HandTrayActionPathRail"
	path.add_child(rail)
	var progress = clamp(float(hand.size()) / 14.0, 0.0, 1.0)
	var fill_right = 0.080 + 0.760 * progress
	var fill = make_gpt_meter_fill(rect_full(0.080, 0.465, fill_right, 0.535), Color(0.96, 0.80, 0.38, 0.34 if active else 0.16))
	fill.name = "HandTrayActionPathFill"
	path.add_child(fill)
	var stream = make_gpt_route_rail(rect_full(0.120, 0.745, 0.855, 0.835), Color(0.006, 0.016, 0.018, 0.44))
	stream.name = "HandTrayActionPathStream"
	path.add_child(stream)
	var stream_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * max(0.12, progress), 0.740), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.12))
	stream_fill.name = "HandTrayActionPathStreamFill"
	stream.add_child(stream_fill)
	for i in range(4):
		var center = 0.080 + float(i) * 0.253
		var lit = center <= fill_right or (active and i == 3)
		var node = make_gpt_gate(rect_full(center - 0.018, 0.305, center + 0.018, 0.695), Color(accent.r, accent.g, accent.b, 0.52 if lit else 0.16))
		node.name = "HandTrayActionPathNode_%d" % i
		path.add_child(node)
	for i in range(3):
		var tick_left = 0.520 + float(i) * 0.075
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.130, tick_left + 0.030, 0.255), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.035))
		tick.name = "HandTrayActionPathTick_0"
		path.add_child(tick)
	var focus_left = 0.735 if active else 0.075
	if responding:
		focus_left = 0.455
	var focus = make_gpt_gate(rect_full(focus_left, 0.135, focus_left + 0.110, 0.865), Color(accent.r, accent.g, accent.b, 0.40))
	focus.name = "HandTrayActionPathFocus"
	path.add_child(focus)
	var glyph_text = "打" if active else ("应" if responding else "候")
	var glyph = make_label(focus, glyph_text, 10, Color(0.98, 0.90, 0.64, 0.94), true)
	glyph.name = "HandTrayActionPathGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var target = make_gpt_plate_rect(rect_full(0.880, 0.230, 0.990, 0.770), Color(0.94, 0.76, 0.34, 0.42 if active else 0.22), "ui_hand_tray_state_chip")
	target.name = "HandTrayActionPathTarget"
	path.add_child(target)
	var gate = make_gpt_gate(rect_full(0.855, 0.720, 0.960, 0.930), Color(accent.r, accent.g, accent.b, 0.18 if active else 0.08))
	gate.name = "HandTrayActionPathGate"
	path.add_child(gate)
	var delivery_route = make_gpt_route_rail(rect_full(0.685, 0.600, 0.900, 0.700), Color(0.006, 0.016, 0.018, 0.44))
	delivery_route.name = "HandTrayActionDeliveryRoute"
	path.add_child(delivery_route)
	var delivery_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.820 if active else 0.420, 0.740), Color(accent.r, accent.g, accent.b, 0.28 if active else 0.12))
	delivery_fill.name = "HandTrayActionDeliveryFill"
	delivery_route.add_child(delivery_fill)
	var delivery_gate = make_gpt_gate(rect_full(0.875, 0.530, 0.925, 0.770), Color(0.94, 0.76, 0.34, 0.18 if active else 0.08))
	delivery_gate.name = "HandTrayActionDeliveryGate"
	path.add_child(delivery_gate)
	var river_drop = make_gpt_plate_rect(rect_full(0.920, 0.120, 0.985, 0.390), Color(0.94, 0.76, 0.34, 0.34 if active else 0.18), "ui_hand_tray_state_chip")
	river_drop.name = "HandTrayActionRiverDrop"
	path.add_child(river_drop)
	var river_glyph = make_label(river_drop, "河", 8, Color(0.96, 0.88, 0.58, 0.82 if active else 0.46), true)
	river_glyph.name = "HandTrayActionRiverGlyph"
	apply_rect(river_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(2):
		var tick_2 = make_gpt_tick_strip(rect_full(0.730 + float(i) * 0.060, 0.500, 0.750 + float(i) * 0.060, 0.760), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.045 if active else 0.09))
		tick_2.name = "HandTrayActionDeliveryTick_0"
		path.add_child(tick_2)
	if active:
		add_lucide_icon(path, "chevron-right", rect_full(0.820, 0.245, 0.905, 0.755), Color(0.96, 0.86, 0.54, 0.74))
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	if mode == "offline" and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "":
		var drawn = make_label(target, tile_face_main(drawn_tile), 10, tile_accent(drawn_tile), true)
		drawn.name = "HandTrayActionPathDrawn"
		apply_rect(drawn, rect_full(0.0, 0.0, 1.0, 1.0))
	focus.modulate = Color(1, 1, 1, 0.82)
	stream_fill.modulate = Color(1, 1, 1, 0.78)
	delivery_fill.modulate = Color(1, 1, 1, 0.78)
	return path

func draw_hand_tray_completion_bus_art(parent: Control, hand: Array) -> Control:
	# r209: GPT chrome conversion
	var bus = Control.new()
	bus.name = "HandTrayCompletionBusArt"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(bus, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_completion_bus_art_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(bus, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_completion_bus_art_GptMeter"
	bus.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bus, rect_full(0.275, 0.175, 0.725, 0.330))
	parent.add_child(bus)
	var accent = hand_tray_state_fill()
	var active = can_self_discard()
	var counts := hand_group_counts(hand)
	var occupied_groups := 0
	for count in counts:
		if int(count) > 0:
			occupied_groups += 1
	var hand_progress = clamp(float(hand.size()) / 14.0, 0.08, 1.0)
	var group_progress = clamp(float(occupied_groups) / 5.0, 0.08, 1.0)
	var gpt_bus_texture = add_optional_gpt_illustration_texture(bus, "hand_completion_gpt_bus", rect_full(-0.030, -0.220, 1.030, 1.220), 0.14, false)  # r221
	if gpt_bus_texture != null:
		gpt_bus_texture.name = "HandTrayCompletionGPTTexture"
		bus.move_child(gpt_bus_texture, 0)
	var spine = make_gpt_route_rail(rect_full(0.055, 0.445, 0.945, 0.585), Color(0.006, 0.016, 0.018, 0.46))
	spine.name = "HandTrayCompletionSpine"
	bus.add_child(spine)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.280, 0.025 + 0.930 * hand_progress, 0.720), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.16))
	fill.name = "HandTrayCompletionFill"
	spine.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.250, 0.095, 0.790), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "HandTrayCompletionSource"
	bus.add_child(source)
	var source_glyph = make_label(source, "手", 9, Color(0.98, 0.90, 0.64, 0.86), true)
	source_glyph.name = "HandTrayCompletionGlyph"
	apply_rect(source_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var gate_left = 0.865 if active else 0.740
	var gate = make_gpt_gate(rect_full(gate_left, 0.205, gate_left + 0.095, 0.835), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.12))
	gate.name = "HandTrayCompletionGate"
	bus.add_child(gate)
	var archive = make_gpt_edge_rail(rect_full(0.905, 0.255, 0.990, 0.785), Color(0.030, 0.044, 0.040, 0.56))
	archive.name = "HandTrayCompletionArchive"
	bus.add_child(archive)
	var archive_glyph = make_label(archive, "型", 8, Color(0.96, 0.88, 0.58, 0.80), true)
	archive_glyph.name = "HandTrayCompletionArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(4):
		var center = 0.210 + float(i) * 0.180
		var branch_height = 0.130 + 0.210 * group_progress
		var branch = make_gpt_plate_rect(rect_full(center - 0.044, 0.170, center + 0.044, 0.170 + branch_height), Color(0.006, 0.016, 0.018, 0.38), "ui_jade_reading_plate")
		branch.name = "HandTrayCompletionBranch_%d" % i
		bus.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.300, 0.080, 0.700, 0.920), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.030))
		branch_fill.name = "HandTrayCompletionBranchFill_%d" % i
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(center - 0.026, 0.385, center + 0.026, 0.655), Color(accent.r, accent.g, accent.b, 0.46 if float(i) / 4.0 <= hand_progress else 0.16))
		node.name = "HandTrayCompletionNode_%d" % i
		bus.add_child(node)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.928 + float(i) * 0.025, 0.680, 0.946 + float(i) * 0.025, 0.795), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.040))
		pip.name = "HandTrayCompletionArchivePip_%d" % i
		bus.add_child(pip)
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.78)
	return bus


func draw_hand_tray_momentum_art(parent: Control, hand: Array, force_danger_warning: bool = false) -> Control:
	# r207: GPT chrome conversion
	var art = Control.new()
	art.name = "HandTrayMomentumArt"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_momentum_art_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_momentum_art_GptMeter"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.250, 0.835, 0.745, 0.965))
	parent.add_child(art)
	var hand_texture = add_illustration_texture(art, "hand_tray_flow", rect_full(-0.025, -0.150, 1.025, 1.150), 0.13, false)
	if hand_texture != null:
		hand_texture.name = "HandTrayFlowTexture"
		hand_texture.modulate = Color(1, 1, 1, 0.09)
	var accent = hand_tray_state_fill()
	var active = can_self_discard()
	var count = max(1, hand.size())
	var visible_pips = min(6, max(3, int(ceil(float(count) / 3.0))))
	for i in range(visible_pips):
		var center = 0.090 + (0.820 * float(i) / float(max(1, visible_pips - 1)))
		var pip = make_gpt_gate(rect_full(center - 0.014, 0.305, center + 0.014, 0.695), Color(accent.r, accent.g, accent.b, 0.48 if active else 0.18))
		pip.name = "HandTrayMomentumPip_%d" % i
		art.add_child(pip)
	var focus_left = 0.790 if active else 0.060
	var focus = make_gpt_plate_rect(rect_full(focus_left, 0.145, focus_left + 0.085, 0.855), Color(accent.r, accent.g, accent.b, 0.30), "ui_jade_reading_plate")
	focus.name = "HandTrayMomentumFocus"
	art.add_child(focus)
	var readiness_bridge = make_gpt_route_rail(rect_full(0.540, 0.680, 0.850, 0.760), Color(0.006, 0.016, 0.018, 0.44))
	readiness_bridge.name = "HandTrayDecisionBridge"
	art.add_child(readiness_bridge)
	var readiness_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.860 if active else 0.360, 0.740), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.14))
	readiness_fill.name = "HandTrayDecisionBridgeFill"
	readiness_bridge.add_child(readiness_fill)
	var readiness_gate = make_gpt_gate(rect_full(0.828, 0.610, 0.884, 0.825), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.10))
	readiness_gate.name = "HandTrayDecisionBridgeGate"
	art.add_child(readiness_gate)
	var readiness_source = make_gpt_edge_rail(rect_full(0.505, 0.615, 0.558, 0.825), Color(accent.r, accent.g, accent.b, 0.18))
	readiness_source.name = "HandTrayDecisionSourceNode"
	art.add_child(readiness_source)
	var drawn_tile = str(offline_last_draw.get("tile", ""))
	if mode == "offline" and int(offline_last_draw.get("seat", -1)) == 0 and drawn_tile != "":
		var decision_route = make_gpt_route_rail(rect_full(0.685, 0.735, 0.930, 0.840), Color(0.006, 0.016, 0.018, 0.44))
		decision_route.name = "HandTrayDrawDecisionRoute"
		art.add_child(decision_route)
		var decision_fill = make_gpt_meter_fill(rect_full(0.040, 0.260, 0.820, 0.740), Color(accent.r, accent.g, accent.b, 0.28))
		decision_fill.name = "HandTrayDrawDecisionFill"
		decision_route.add_child(decision_fill)
		var decision_gate = make_gpt_gate(rect_full(0.820, 0.640, 0.880, 0.930), Color(0.006, 0.014, 0.016, 0.54))
		decision_gate.name = "HandTrayDrawDecisionGate"
		art.add_child(decision_gate)
		var source_is_gang = str(offline_last_draw.get("source", "")) == "gang"
		var source_node = make_gpt_gate(rect_full(0.635, 0.625, 0.685, 0.895), Color(accent.r, accent.g, accent.b, 0.22 if source_is_gang else 0.14))
		source_node.name = "HandTrayDrawSourceNode"
		art.add_child(source_node)
		var replacement_gate = make_gpt_gate(rect_full(0.892, 0.610, 0.940, 0.950), Color(0.86, 0.68, 0.30, 0.24 if source_is_gang else 0.10))
		replacement_gate.name = "HandTrayReplacementGate"
		art.add_child(replacement_gate)
		var tick = add_gpt_tick_strip(art, rect_full(0.725, 0.585, (0.745) + float(1) * (0.055), 0.705), Color(accent.r, accent.g, accent.b, 0.23), "HandTrayDrawDecisionTick_0")
		var draw_badge = make_gpt_edge_rail(rect_full(0.865, 0.050, 0.990, 0.930), Color(0.030, 0.044, 0.040, 0.80))
		draw_badge.name = "HandTrayLastDrawBadge"
		art.add_child(draw_badge)
		var badge_label = "杠" if source_is_gang else "摸"
		var draw_label = make_label(draw_badge, badge_label, 11, Color(0.96, 0.86, 0.56, 0.92), true)
		draw_label.name = "HandTrayLastDrawLabel"
		draw_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		draw_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		apply_rect(draw_label, rect_full(0.0, 0.08, 1.0, 0.92))
		configure_clipped_label(draw_label)
	if force_danger_warning or has_pending_danger_discard():
		focus.modulate = Color(1, 1, 1, 0.78)
		readiness_fill.modulate = Color(1, 1, 1, 0.82)
	return art


func draw_hand_tray_state_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var state = hand_tray_state_text()
	var accent = hand_tray_state_fill()
	var art = Control.new()
	art.name = "HandTrayStateArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.760, 0.030, 0.985, 0.150))
	parent.add_child(art)
	var chip = add_optional_gpt_illustration_texture(art, "ui_hand_tray_state_chip", rect_full(0.0, 0.0, 1.0, 1.0), 0.72, false)
	if chip != null:
		chip.name = "HandTrayStateGptChip"
		chip.modulate = Color(
			clampf(0.55 + accent.r * 0.55, 0.35, 1.2),
			clampf(0.55 + accent.g * 0.55, 0.35, 1.2),
			clampf(0.55 + accent.b * 0.55, 0.35, 1.2),
			0.86
		)
	var rail = make_gpt_route_rail(rect_full(0.120, 0.70, 0.920, 0.82), Color(0.78, 0.58, 0.28, 0.16))
	rail.name = "HandTrayStateRail"
	art.add_child(rail)
	var pulse = make_gpt_tick_strip(rect_full(0.030, 0.180, 0.120, 0.620), Color(0.56, 0.18, 0.12, 0.24))
	pulse.name = "HandTrayStatePulse"
	art.add_child(pulse)
	var icon_name = hand_tray_state_icon_name(state)
	if icon_name != "":
		add_lucide_icon(art, icon_name, rect_full(0.040, 0.210, 0.105, 0.590), Color(0.96, 0.92, 0.76, 0.82))
	pulse.modulate = Color(1, 1, 1, 0.78)
	return art


func draw_hand_tray_suit_flow(parent: Control, hand: Array, force_danger_glow: bool = false) -> Control:
	# r213: GPT chrome conversion
	var flow = Control.new()
	flow.name = "HandTraySuitFlow"
	var tray_gpt_strip = add_optional_gpt_illustration_texture(flow, "ui_progress_signal_strip", rect_full(-0.02, 0.15, 1.02, 0.90), 0.26, false)
	if tray_gpt_strip != null:
		tray_gpt_strip.name = "draw_hand_tray_suit_flow_GptStrip"
	var tray_gpt_meter = add_optional_gpt_illustration_texture(flow, "ui_meter_rail_plate", rect_full(0.04, 0.35, 0.96, 0.70), 0.34, false)
	if tray_gpt_meter != null:
		tray_gpt_meter.name = "draw_hand_tray_suit_flow_GptMeter"
	flow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(flow, rect_full(0.020, 0.855, 0.235, 0.960))
	parent.add_child(flow)
	var counts := hand_group_counts(hand)
	var max_count = 1
	for value in counts:
		max_count = max(max_count, int(value))
	var labels := ["万", "条", "筒", "字", "花"]
	var colors := [
		Color(0.74, 0.46, 0.34),
		Color(0.34, 0.62, 0.46),
		Color(0.34, 0.52, 0.72),
		Color(0.66, 0.56, 0.34),
		Color(0.70, 0.42, 0.62),
	]
	var rail = make_gpt_route_rail(rect_full(0.020, 0.440, 0.980, 0.570), Color(0.88, 0.74, 0.42, 0.10))
	rail.name = "HandTraySuitRail"
	flow.add_child(rail)
	var occupied_groups := 0
	var dominant_index := 0
	var dominant_count := -1
	for i in range(counts.size()):
		var count = int(counts[i])
		if count > 0:
			occupied_groups += 1
		if count > dominant_count:
			dominant_count = count
			dominant_index = i
	var coverage = clamp(float(occupied_groups) / 5.0, 0.08, 1.0)
	var rail_fill = make_gpt_meter_fill(rect_full(0.018, 0.260, 0.018 + 0.944 * coverage, 0.740), Color(0.88, 0.74, 0.42, 0.26))
	rail_fill.name = "HandTraySuitRailFill"
	rail.add_child(rail_fill)
	var gate_center = 0.085 + float(dominant_index) * 0.205
	var gate_color: Color = colors[clamp(dominant_index, 0, colors.size() - 1)]
	var gate = make_gpt_gate(rect_full(gate_center - 0.060, 0.170, gate_center + 0.060, 0.830), Color(gate_color.r, gate_color.g, gate_color.b, 0.34))
	gate.name = "HandTraySuitDominantGate"
	flow.add_child(gate)
	for i in range(labels.size()):
		var count = int(counts[i])
		var center = 0.085 + float(i) * 0.205
		var height = 0.22 + 0.52 * float(count) / float(max_count)
		var color: Color = colors[i]
		var node = make_gpt_gate(rect_full(center - 0.035, 0.500 - height * 0.5, center + 0.035, 0.500 + height * 0.5), Color(color.r, color.g, color.b, 0.54 if count > 0 else 0.18))
		node.name = "HandTraySuitNode_%s" % labels[i]
		flow.add_child(node)
		var label = make_label(flow, labels[i], 10, Color(0.98, 0.92, 0.68, 0.98 if count > 0 else 0.58), true)
		label.name = "HandTraySuitLabel_%s" % labels[i]
		apply_rect(label, rect_full(center - 0.065, 0.660, center + 0.065, 0.985))
		configure_clipped_label(label)
	for i in range(4):
		var left = 0.185 + float(i) * 0.205
		var separator := add_optional_gpt_illustration_texture(flow, "ui_meter_rail_plate", rect_full(left - 0.012, 0.245, left + 0.012, 0.790), 0.54, false)
		if separator != null:
			separator.name = "HandTraySuitSeparator_%d" % i
			separator.set_meta("separator_width_ratio", 0.024)
	if force_danger_glow or has_pending_danger_discard():
		var danger = make_gpt_plate_rect(rect_full(0.000, 0.000, 1.000, 1.000), Color(0.92, 0.34, 0.24, 0.08), "ui_jade_reading_plate")
		danger.name = "HandTraySuitDangerGlow"
		flow.add_child(danger)
	return flow


func draw_hand_tutorial_discard_flow(parent: Control, accent: Color) -> Control:
	# r209: GPT chrome conversion
	var flow = Control.new()
	flow.name = "HandTrayTutorialDiscardFlow"
	flow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	flow.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(flow)
	var guide_texture = add_optional_gpt_illustration_texture(flow, "guide_pointing_finger", rect_full(0.018, 0.610, 0.155, 0.980), 0.34, true)
	if guide_texture != null:
		guide_texture.name = "HandTutorialPointingFingerTexture"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var guide_tw := create_screen_tween()
			guide_tw.set_loops(48)
			guide_tw.tween_property(guide_texture, "position", guide_texture.position + Vector2(7.0, -5.0), 0.54).from(guide_texture.position)
			guide_tw.parallel().tween_property(guide_texture, "modulate:a", 0.42, 0.54).from(0.20)
			guide_tw.tween_property(guide_texture, "position", guide_texture.position, 0.54).from(guide_texture.position + Vector2(7.0, -5.0))
			guide_tw.parallel().tween_property(guide_texture, "modulate:a", 0.20, 0.54).from(0.42)
	var source = make_gpt_plate_rect(rect_full(0.048, 0.755, 0.118, 0.920), Color(accent.r, accent.g, accent.b, 0.22), "ui_jade_reading_plate")
	source.name = "HandTrayTutorialDiscardSource"
	flow.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.120, 0.820, 0.735, 0.890), Color(0.006, 0.018, 0.020, 0.48))
	route.name = "HandTrayTutorialDiscardRoute"
	flow.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.860, 0.740), Color(accent.r, accent.g, accent.b, 0.34))
	fill.name = "HandTrayTutorialDiscardFill"
	route.add_child(fill)
	var river = make_gpt_gate(rect_full(0.745, 0.735, 0.900, 0.960), Color(0.020, 0.038, 0.040, 0.38))
	river.name = "HandTrayTutorialRiverNode"
	flow.add_child(river)
	var river_label = make_label(river, "河", 10, Color(0.96, 0.88, 0.58, 0.86), true)
	river_label.name = "HandTrayTutorialRiverGlyph"
	apply_rect(river_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var gate = make_gpt_gate(rect_full(0.895, 0.770, 0.940, 0.930), Color(0.96, 0.78, 0.38, 0.20))
	gate.name = "HandTrayTutorialDiscardGate"
	flow.add_child(gate)
	var tick = add_gpt_tick_strip(flow, rect_full(0.260, 0.748, (0.260) + float(2) * (0.135) + (0.018), 0.948), Color(accent.r, accent.g, accent.b, 0.24), "HandTrayTutorialDiscardTick_0")
	for i in range(2):
		var bead = make_gpt_plate_rect(rect_full(0.790 + float(i) * 0.046, 0.785, 0.822 + float(i) * 0.046, 0.910), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040), "ui_jade_reading_plate")
		bead.name = "HandTrayTutorialRiverBead_%d" % i
		flow.add_child(bead)
	var commit_route = make_gpt_route_rail(rect_full(0.600, 0.610, 0.905, 0.685), Color(0.006, 0.018, 0.020, 0.42))
	commit_route.name = "HandTrayTutorialCommitRoute"
	flow.add_child(commit_route)
	var commit_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(accent.r, accent.g, accent.b, 0.25))
	commit_fill.name = "HandTrayTutorialCommitFill"
	commit_route.add_child(commit_fill)
	var commit_gate = make_gpt_gate(rect_full(0.880, 0.555, 0.940, 0.740), Color(0.96, 0.78, 0.38, 0.18))
	commit_gate.name = "HandTrayTutorialCommitGate"
	flow.add_child(commit_gate)
	var commit_seal = make_gpt_gate(rect_full(0.690, 0.475, 0.780, 0.665), Color(accent.r, accent.g, accent.b, 0.13))
	commit_seal.name = "HandTrayTutorialCommitSeal"
	flow.add_child(commit_seal)
	var commit_glyph = make_label(commit_seal, "出", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	commit_glyph.name = "HandTrayTutorialCommitGlyph"
	apply_rect(commit_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var commit_tick = add_gpt_tick_strip(flow, rect_full(0.695, 0.565, (0.709) + float(1) * (0.055), 0.735), Color(accent.r, accent.g, accent.b, 0.20), "HandTrayTutorialCommitTick_0")
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.80)
	return flow


func draw_hand_tutorial_hint_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "HandTrayTutorialHintArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var scroll_texture = add_illustration_texture(art, "hand_tutorial_scroll", rect_full(0.0, 0.0, 1.0, 1.0), 0.14, false)
	if scroll_texture != null:
		scroll_texture.name = "HandTrayTutorialScrollTexture"
	var hand_tutorial_gpt_key := "hand_tutorial_gpt_hint"
	var hand_tutorial_gpt_texture = add_optional_gpt_illustration_texture(art, hand_tutorial_gpt_key, rect_full(0.0, 0.0, 1.0, 1.0), 0.24, false)  # r221 denser tutorial
	if hand_tutorial_gpt_texture != null:
		hand_tutorial_gpt_texture.name = "HandTutorialGPTTexture"
	var guide_texture = add_optional_gpt_illustration_texture(art, "guide_pointing_finger", rect_full(0.790, 0.120, 0.970, 0.720), 0.32, true)
	if guide_texture != null:
		guide_texture.name = "HandTutorialPointingFingerTexture"
		if hand_tutorial_gpt_texture != null:
			art.move_child(hand_tutorial_gpt_texture, min(1, art.get_child_count() - 1))
	var accent = Color(0.38, 0.76, 0.60)
	var seal = make_gpt_gate(rect_full(0.036, 0.150, 0.145, 0.700), Color(accent.r, accent.g, accent.b, 0.24))
	seal.name = "HandTrayTutorialSeal"
	art.add_child(seal)
	if add_lucide_icon(seal, "mouse-pointer-click", rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.94, 0.78, 0.90)) == null:
		var fallback = make_label(seal, "点", 12, Color(0.96, 0.94, 0.78, 0.90), true)
		fallback.name = "HandTrayTutorialSealGlyph"
		apply_rect(fallback, rect_full(0.0, 0.0, 1.0, 1.0))
	var rail = make_gpt_route_rail(rect_full(0.195, 0.600, 0.880, 0.720), Color(0.010, 0.028, 0.030, 0.62))
	rail.name = "HandTrayTutorialStepRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.680, 0.740), Color(accent.r, accent.g, accent.b, 0.48))
	fill.name = "HandTrayTutorialStepFill"
	rail.add_child(fill)
	for i in range(3):
		var center = 0.230 + float(i) * 0.205
		var node = make_gpt_gate(rect_full(center - 0.018, 0.535, center + 0.018, 0.785), Color(accent.r, accent.g, accent.b, 0.50 if i == 0 else 0.24))
		node.name = "HandTrayTutorialStepNode_%d" % i
		art.add_child(node)
	var target = make_gpt_gate(rect_full(0.770, 0.220, 0.900, 0.840), Color(0.018, 0.038, 0.040, 0.46))
	target.name = "HandTrayTutorialTargetTile"
	target.set_meta("prompt_only", true)
	target.set_meta("visual_owner", "HandTrayTutorialHint")
	target.set_meta("tile_surface", "none")
	target.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.add_child(target)
	var target_label = make_label(target, "提示", 11, Color(0.96, 0.88, 0.58, 0.92), true)
	target_label.name = "HandTrayTutorialTargetGlyph"
	apply_rect(target_label, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var ripple = make_gpt_plate_rect(rect_full(0.740 - float(i) * 0.016, 0.160 - float(i) * 0.025, 0.930 + float(i) * 0.016, 0.900 + float(i) * 0.025), Color(accent.r, accent.g, accent.b, 0.060 - float(i) * 0.010), "ui_jade_reading_plate")
		ripple.name = "HandTrayTutorialClickRipple_%d" % i
		ripple.set_meta("prompt_only", true)
		ripple.set_meta("avoids_tile_surface", true)
		art.add_child(ripple)
		art.move_child(ripple, max(0, target.get_index()))
	var arrow = make_label(art, ">", 16, Color(0.96, 0.86, 0.48, 0.82), true)
	arrow.name = "HandTrayTutorialArrow"
	apply_rect(arrow, rect_full(0.680, 0.255, 0.745, 0.710))
	draw_hand_tutorial_discard_flow(art, accent)
	fill.modulate = Color(1, 1, 1, 0.82)
	arrow.modulate = Color(1, 1, 1, 0.80)
	return art


func draw_item_toast_art(toast_bg: Control, item_id: String, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var charm_texture = add_illustration_texture(toast_bg, "item_activation_charm", rect_full(0.055, 0.010, 0.940, 0.980), 0.16, false)
	if charm_texture != null:
		charm_texture.name = "ToastItemActivationTexture"
		toast_bg.move_child(charm_texture, 0)
	var badge = make_gpt_gate(rect_full(0.820, 0.185, 0.870, 0.815), Color(accent.r, accent.g, accent.b, 0.22))
	badge.name = "ToastItemBadge"
	toast_bg.add_child(badge)
	var core = make_gpt_plate_rect(rect_full(0.220, 0.220, 0.780, 0.780), Color(accent.r, accent.g, accent.b, 0.40), "ui_jade_reading_plate")
	core.name = "ToastItemCore"
	badge.add_child(core)
	var item_mark = make_label(core, item_short_mark(item_id), 10, Color(0.98, 0.94, 0.78), true)
	apply_rect(item_mark, rect_full(0.0, 0.0, 1.0, 1.0))
	var activation_route = make_gpt_route_rail(rect_full(0.690, 0.700, 0.858, 0.780), Color(0.006, 0.016, 0.018, 0.42))
	activation_route.name = "ToastItemActivationRoute"
	toast_bg.add_child(activation_route)
	var activation_fill = make_gpt_meter_fill(rect_full(0.040, 0.250, 0.780, 0.750), Color(accent.r, accent.g, accent.b, 0.30))
	activation_fill.name = "ToastItemActivationFill"
	activation_route.add_child(activation_fill)
	var gate = make_gpt_gate(rect_full(0.800, 0.255, 0.825, 0.475), Color(0.96, 0.82, 0.42, 0.28))
	gate.name = "ToastItemActivationGate"
	toast_bg.add_child(gate)
	for i in range(3):
		var top = 0.255 + float(i) * 0.165
		var pip = make_gpt_gate(rect_full(0.878, top, 0.892, top + 0.070), Color(accent.r, accent.g, accent.b, 0.44))
		pip.name = "ToastItemPip_%d" % i
		toast_bg.add_child(pip)
	var tick = add_gpt_tick_strip(toast_bg, rect_full(0.718, 0.270, (0.718) + float(1) * (0.044) + (0.014), 0.390), Color(accent.r, accent.g, accent.b, 0.28), "ToastItemActivationTick_0")
	draw_item_toast_inventory_route(toast_bg, item_id, accent)
	draw_item_toast_effect_route(toast_bg, item_id, accent)


func draw_item_toast_denied_route(toast_bg: Control, item_id: String, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var route = Control.new()
