func draw_daily_login_streak_art(parent: Control, days: int, current_day_in_cycle: int) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "DailyLoginStreakArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.145, 0.395, 0.855, 0.465))
	parent.add_child(art)
	# r180: GPT streak meter strip instead of rail/fill ColorRect chrome.
	var streak_ratio = clamp(float(current_day_in_cycle) / 7.0, 0.08, 1.0)
	var rail = Control.new()
	rail.name = "DailyLoginStreakRail"
	rail.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(rail, rect_full(0.0, 0.10, 1.0, 0.90))
	art.add_child(rail)
	var strip = add_optional_gpt_illustration_texture(rail, "ui_progress_signal_strip", rect_full(0.0, 0.20, 1.0, 0.80), 0.42, false)
	if strip != null:
		strip.name = "DailyLoginStreakStrip"
		strip.modulate = Color(0.78, 0.64, 0.30, 0.72)
	var fill = add_optional_gpt_illustration_texture(rail, "ui_meter_rail_plate", rect_full(0.02, 0.28, 0.02 + 0.96 * streak_ratio, 0.72), 0.70, false)
	if fill != null:
		fill.name = "DailyLoginStreakFill"
		fill.set_meta("animated_role", "daily_login_progress_flow")
	for i in range(7):
		var center = 0.055 + float(i) * 0.148
		var node = make_gpt_gate(rect_full(center - 0.020, 0.215, center + 0.020, 0.785), Color(0.78, 0.64, 0.30, 0.20))
		node.name = "DailyLoginStreakNode_%d" % (i + 1)
		art.add_child(node)
		if i + 1 == current_day_in_cycle:
			var halo = make_gpt_plate_rect(rect_full(center - 0.038, 0.050, center + 0.038, 0.950), Color(0.96, 0.78, 0.34, 0.12), "ui_jade_reading_plate")
			halo.name = "DailyLoginCurrentHalo"
			art.add_child(halo)
	var seven_gate = make_gpt_gate(rect_full(0.930, 0.050, 0.995, 0.950), Color(0.92, 0.72, 0.34, 0.20))
	seven_gate.name = "DailyLoginSevenDayGate"
	art.add_child(seven_gate)
	var seven_glyph = make_label(seven_gate, "七", 8, Color(0.98, 0.92, 0.68, 0.88), true)
	seven_glyph.name = "DailyLoginSevenDayGlyph"
	apply_rect(seven_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var milestone_glow = make_gpt_gate(rect_full(0.880, -0.140, 1.040, 1.140), Color(0.96, 0.78, 0.34, 0.10))
	milestone_glow.name = "DailyLoginMilestoneGlow"
	art.add_child(milestone_glow)
	if days >= 7 and days % 7 == 0:
		var milestone_texture = add_illustration_texture(art, "daily_login_milestone_seal", rect_full(0.890, -0.130, 1.040, 1.120), 0.28, true)
		if milestone_texture != null:
			milestone_texture.name = "DailyLoginMilestoneSealTexture"
			art.move_child(milestone_texture, min(1, art.get_child_count() - 1))
			if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
				var milestone_tw := create_screen_tween()
				milestone_tw.set_loops(48)
				milestone_tw.tween_property(milestone_texture, "scale", Vector2(1.08, 1.08), 0.72).from(Vector2(0.96, 0.96)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
				milestone_tw.parallel().tween_property(milestone_texture, "modulate:a", 0.38, 0.72).from(0.20)
				milestone_tw.tween_property(milestone_texture, "scale", Vector2(0.96, 0.96), 0.72).from(Vector2(1.08, 1.08)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
				milestone_tw.parallel().tween_property(milestone_texture, "modulate:a", 0.20, 0.72).from(0.38)
	return art


func draw_danger_discard_confirmation_art(parent: Control, tile: String, report: Dictionary = {}, alternatives: Array = []) -> Control:
	# r209: GPT chrome conversion
	var dock_rect = action_bar_dock_layout_rect()
	var bar_rect = action_bar_layout_rect()
	var panel_left = dock_rect.position.x + 0.008
	var panel_top = dock_rect.position.y + 0.008
	var panel_right = maxf(bar_rect.position.x - 0.006, dock_rect.position.x + 0.114)
	var panel_bottom = dock_rect.size.y - 0.008
	var panel = make_gpt_route_rail(rect_full(panel_left, panel_top, panel_right, panel_bottom), Color(0.040, 0.018, 0.016, 0.94))
	panel.name = "DangerDiscardConfirmationArt"
	panel.z_index = 20
	panel.clip_contents = true
	parent.add_child(panel)
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var seal_texture = add_illustration_texture(panel, "danger_decision_seal", rect_full(0.015, -1.080, 0.515, 2.000), 0.16, true)
	if seal_texture != null:
		seal_texture.name = "DangerDecisionSealTexture"
		panel.move_child(seal_texture, 0)
	var danger_texture = add_illustration_texture(panel, "danger_warning", rect_full(0.014, 0.030, 0.986, 0.970), 0.16, false)
	if danger_texture != null:
		danger_texture.name = "DangerWarningTexture"
	var danger_gpt_key := "danger_gpt_discard"
	var danger_gpt_texture = add_optional_gpt_illustration_texture(panel, danger_gpt_key, rect_full(0.012, -0.080, 0.988, 1.080), 0.14, false)
	if danger_gpt_texture != null:
		danger_gpt_texture.name = "DangerGPTDiscardTexture"
		panel.move_child(danger_gpt_texture, min(1, panel.get_child_count() - 1))
	var danger_role_rail = add_optional_gpt_illustration_texture(panel, "ui_action_role_rail", rect_full(0.0, 0.0, 0.020, 1.0), 0.62, false)
	if danger_role_rail != null:
		danger_role_rail.name = "DangerDiscardGptRoleRail"
	var danger_risk_strip = add_optional_gpt_illustration_texture(panel, "ui_progress_signal_strip", rect_full(0.120, 0.430, 0.760, 0.600), 0.34, false)
	if danger_risk_strip != null:
		danger_risk_strip.name = "DangerDiscardGptRiskStrip"
		danger_risk_strip.visible = false
	panel.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.014, 1.0), Color(0.96, 0.38, 0.24, 0.64)))
	var danger_tile = make_tile_view(tile, Vector2(32, 44), false, Callable(), true, "高", "")
	danger_tile.name = "DangerDiscardTile"
	panel.add_child(danger_tile)
	apply_rect(danger_tile, rect_full(0.015, 0.035, 0.350, 0.965))
	var route = make_gpt_route_rail(rect_full(0.380, 0.810, 0.970, 0.900), Color(0.92, 0.42, 0.28, 0.24))
	route.name = "DangerDiscardRouteRail"
	panel.add_child(route)
	var risk = clamp(max(float(report.get("risk", 0.0)), float(report.get("feed_risk", 0.0))) / 60.0, 0.18, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.250, 0.020 + 0.940 * risk, 0.750), Color(0.94, 0.34, 0.24, 0.54))
	fill.name = "DangerDiscardRiskFill"
	route.add_child(fill)
	for i in range(4):
		var node_left = 0.160 + float(i) * 0.130
		var node_active = risk >= (float(i) + 1.0) / 4.0
		var node = make_gpt_gate(rect_full(node_left, 0.405, node_left + 0.026, 0.615), Color(0.96, 0.38, 0.24, 0.34 if node_active else 0.12))
		node.name = "DangerDiscardRiskNode_%d" % i
		node.visible = false
		panel.add_child(node)
	var alert = make_gpt_plate_rect(rect_full(0.532, 0.570, 0.718, 0.885), Color(0.92, 0.32, 0.24, 0.12), "ui_jade_reading_plate")
	alert.name = "DangerDiscardAlertHalo"
	alert.visible = false
	panel.add_child(alert)
	for i in range(3):
		var ring = make_gpt_plate_rect(rect_full(0.090 + float(i) * 0.085, 0.170 - float(i) * 0.015, 0.910 - float(i) * 0.085, 0.830 + float(i) * 0.015), Color(0.94, 0.34, 0.24, 0.030), "ui_jade_reading_plate")
		ring.name = "DangerDiscardAlertRing_%d" % i
		alert.add_child(ring)
	var label_text = str(report.get("risk_label", "高"))
	if label_text == "":
		label_text = "高"
	var title = make_label(panel, "%s危：%s" % [label_text, tile_label(tile)], 13, Color(0.98, 0.90, 0.72), true)
	title.name = "DangerDiscardTitleText"
	apply_rect(title, rect_full(0.380, 0.060, 0.985, 0.455))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(title)
	var seal = make_badge(panel, rect_full(0.750, 0.145, 0.855, 0.855), risk_badge_text(label_text), 11, Color(0.54, 0.16, 0.12, 0.94), Color(0.96, 0.50, 0.34, 0.34), Color(0.98, 0.90, 0.78))
	seal.name = "DangerDiscardRiskSeal"
	seal.mouse_filter = Control.MOUSE_FILTER_IGNORE
	seal.visible = false
	var compact_reason = "牌路危险"
	var danger_source = report.get("danger_source", {})
	if typeof(danger_source) == TYPE_DICTIONARY and str(danger_source.get("reason", "")) != "":
		compact_reason = str(danger_source.get("reason", ""))
	elif str(report.get("feed_text", "")) != "":
		compact_reason = str(report.get("feed_text", ""))
	var detail = make_label(panel, compact_reason, 12, Color(0.92, 0.86, 0.72), true)
	detail.name = "DangerDiscardDetailText"
	apply_rect(detail, rect_full(0.380, 0.455, 0.985, 0.800))
	detail.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(detail)
	var source_trace = make_gpt_route_rail(rect_full(0.252, 0.305, 0.560, 0.350), Color(0.006, 0.016, 0.018, 0.44))
	source_trace.name = "DangerDiscardSourceTrace"
	source_trace.visible = false
	panel.add_child(source_trace)
	var source_fill = make_gpt_meter_fill(rect_full(0.252, 0.312, 0.252 + 0.308 * risk, 0.343), Color(0.94, 0.34, 0.24, 0.28))
	source_fill.name = "DangerDiscardSourceFill"
	source_fill.visible = false
	panel.add_child(source_fill)
	var source_gate = make_gpt_gate(rect_full(0.546, 0.245, 0.580, 0.395), Color(0.98, 0.70, 0.42, 0.22))
	source_gate.name = "DangerDiscardSourceGate"
	source_gate.visible = false
	panel.add_child(source_gate)
	for i in range(3):
		var left = 0.310 + float(i) * 0.068
		var active = risk >= (float(i) + 1.0) / 4.0
		var trace_node = make_gpt_tick_strip(rect_full(left, 0.250, left + 0.016, 0.405), Color(0.94, 0.34, 0.24, 0.24 if active else 0.10))
		trace_node.name = "DangerDiscardSourceNode_%d" % i
		trace_node.visible = false
		panel.add_child(trace_node)
	var confirm = make_badge(panel, rect_full(0.875, 0.145, 0.975, 0.855), "确认", 10, Color(0.60, 0.20, 0.15, 0.94), Color(0.96, 0.54, 0.34, 0.34), Color(0.98, 0.90, 0.78))
	confirm.name = "DangerDiscardConfirmSeal"
	confirm.mouse_filter = Control.MOUSE_FILTER_IGNORE
	confirm.visible = false
	var confirm_route = make_gpt_route_rail(rect_full(0.575, 0.760, 0.735, 0.840), Color(0.006, 0.016, 0.018, 0.46))
	confirm_route.name = "DangerDiscardConfirmRoute"
	confirm_route.visible = false
	panel.add_child(confirm_route)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.040, 0.260, 0.780, 0.740), Color(0.94, 0.34, 0.24, 0.30))
	confirm_fill.name = "DangerDiscardConfirmFill"
	confirm_route.add_child(confirm_fill)
	var confirm_gate = make_gpt_gate(rect_full(0.704, 0.650, 0.735, 0.760), Color(0.98, 0.70, 0.42, 0.28))
	confirm_gate.name = "DangerDiscardConfirmGate"
	confirm_gate.visible = false
	panel.add_child(confirm_gate)
	var safe_rail = make_gpt_route_rail(rect_full(0.758, 0.145, 0.965, 0.855), Color(0.020, 0.042, 0.040, 0.74))
	safe_rail.name = "DangerDiscardSafeRail"
	safe_rail.visible = false
	panel.add_child(safe_rail)
	var lattice_texture = add_illustration_texture(safe_rail, "danger_choice_lattice", rect_full(-0.060, -0.110, 1.060, 1.110), 0.14, false)
	if lattice_texture != null:
		lattice_texture.name = "DangerChoiceLatticeTexture"
	var safe_route = make_gpt_route_rail(rect_full(0.748, 0.880, 0.965, 0.940), Color(0.006, 0.016, 0.018, 0.42))
	safe_route.name = "DangerDiscardAlternativeRoute"
	safe_route.visible = false
	panel.add_child(safe_route)
	var safe_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.720, 0.740), Color(0.42, 0.76, 0.58, 0.28))
	safe_fill.name = "DangerDiscardAlternativeFill"
	safe_route.add_child(safe_fill)
	var decision_bridge = draw_danger_discard_decision_bridge(panel, risk, alternatives)
	decision_bridge.visible = false
	var final_choice_art = draw_danger_discard_final_choice_art(panel, risk, alternatives)
	final_choice_art.visible = false
	for i in range(min(2, alternatives.size())):
		var alt_report: Dictionary = alternatives[i]
		var alt_tile = str(alt_report.get("tile", ""))
		if alt_tile == "":
			continue
		var left = 0.060 + float(i) * 0.420
		var chip = make_gpt_gate(rect_full(left, 0.170, left + 0.310, 0.830), Color(0.26, 0.58, 0.44, 0.36))
		chip.name = "DangerDiscardSafeTile_%d" % i
		safe_rail.add_child(chip)
		var chip_label = make_label(chip, tile_face_main(alt_tile), 10, tile_accent(alt_tile), true)
		chip_label.name = "DangerDiscardSafeGlyph_%d" % i
		apply_rect(chip_label, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var pulse = make_gpt_tick_strip(rect_full(0.765 + float(i) * 0.055, 0.060, 0.790 + float(i) * 0.055, 0.150), Color(0.50, 0.86, 0.60, 0.22))
		pulse.name = "DangerDiscardSafePulse_%d" % i
		pulse.visible = false
		panel.add_child(pulse)
	for i in range(2):
		var confirm_tick = make_gpt_tick_strip(rect_full(0.592 + float(i) * 0.044, 0.655, 0.606 + float(i) * 0.044, 0.745), Color(0.94, 0.34, 0.24, 0.26 - float(i) * 0.050))
		confirm_tick.name = "DangerDiscardConfirmTick_0"
		confirm_tick.visible = false
		panel.add_child(confirm_tick)
		var safe_tick = make_gpt_tick_strip(rect_full(0.822 + float(i) * 0.046, 0.065, 0.836 + float(i) * 0.046, 0.145), Color(0.50, 0.86, 0.60, 0.24 - float(i) * 0.045))
		safe_tick.name = "DangerDiscardAlternativeTick_0"
		safe_tick.visible = false
		panel.add_child(safe_tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		panel.modulate = Color(1, 1, 1, 0)
		panel.offset_top = 8.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(panel, "modulate:a", 1.0, 0.16).from(0.0)
		tw.tween_property(panel, "offset_top", 0.0, 0.16).from(8.0).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_property(fill, "modulate:a", 0.42, 0.46).from(0.92)
		if seal_texture != null:
			seal_texture.modulate.a = 0.10
	return panel


func draw_danger_discard_decision_bridge(parent: Control, risk: float, alternatives: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var bridge = Control.new()
	bridge.name = "DangerDiscardDecisionBridge"
	bridge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bridge, rect_full(0.575, 0.170, 0.965, 0.420))
	parent.add_child(bridge)
	var rail = make_gpt_route_rail(rect_full(0.035, 0.455, 0.940, 0.555), Color(0.006, 0.016, 0.018, 0.44))
	rail.name = "DangerDiscardDecisionBridgeRail"
	bridge.add_child(rail)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.035, 0.285, clamp(0.190 + 0.500 * risk, 0.260, 0.720), 0.715), Color(0.94, 0.34, 0.24, 0.25))
	confirm_fill.name = "DangerDiscardDecisionConfirmFill"
	rail.add_child(confirm_fill)
	var alt_fill_right = clamp(0.260 + 0.220 * float(min(2, alternatives.size())), 0.360, 0.840)
	var alternative_fill = make_gpt_meter_fill(rect_full(0.035, 0.650, alt_fill_right, 0.905), Color(0.42, 0.76, 0.58, 0.24))
	alternative_fill.name = "DangerDiscardDecisionAlternativeFill"
	rail.add_child(alternative_fill)
	var split_node = make_gpt_gate(rect_full(0.315, 0.240, 0.380, 0.760), Color(0.96, 0.62, 0.34, 0.22))
	split_node.name = "DangerDiscardDecisionSplitNode"
	bridge.add_child(split_node)
	var gate = make_gpt_gate(rect_full(0.895, 0.210, 0.940, 0.790), Color(0.98, 0.76, 0.42, 0.22))
	gate.name = "DangerDiscardDecisionGate"
	bridge.add_child(gate)
	var tick = add_gpt_tick_strip(bridge, rect_full(0.455, 0.180, (0.455) + float(2) * (0.105) + (0.022), 0.820), Color(0.94, 0.48, 0.30, 0.22), "DangerDiscardDecisionTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(confirm_fill, "modulate:a", 0.36, 0.58).from(0.88)
		tw.parallel().tween_property(alternative_fill, "modulate:a", 0.40, 0.58).from(0.90)
		tw.tween_property(confirm_fill, "modulate:a", 0.88, 0.58).from(0.36)
		tw.parallel().tween_property(alternative_fill, "modulate:a", 0.90, 0.58).from(0.40)
	return bridge


func draw_danger_discard_final_choice_art(parent: Control, risk: float, alternatives: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "DangerDiscardFinalChoiceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.520, 0.515, 0.965, 0.710))
	parent.add_child(art)
	var route = make_gpt_route_rail(rect_full(0.040, 0.430, 0.940, 0.560), Color(0.006, 0.016, 0.018, 0.46))
	route.name = "DangerDiscardFinalChoiceRoute"
	art.add_child(route)
	var fill_right = clamp(0.150 + 0.720 * risk, 0.300, 0.900)
	var fill = make_gpt_meter_fill(rect_full(0.040, 0.260, fill_right, 0.740), Color(0.94, 0.34, 0.24, 0.30))
	fill.name = "DangerDiscardFinalChoiceFill"
	route.add_child(fill)
	var alt_width = clamp(0.240 + 0.180 * float(min(2, alternatives.size())), 0.300, 0.760)
	var alt_bridge = make_gpt_route_rail(rect_full(0.050, 0.720, alt_width, 0.860), Color(0.42, 0.76, 0.58, 0.20))
	alt_bridge.name = "DangerDiscardFinalAlternativeBridge"
	art.add_child(alt_bridge)
	var alt_fill = make_gpt_meter_fill(rect_full(0.020, 0.190, 0.840, 0.810), Color(0.42, 0.76, 0.58, 0.25))
	alt_fill.name = "DangerDiscardFinalAlternativeFill"
	alt_bridge.add_child(alt_fill)
	var source = make_gpt_edge_rail(rect_full(0.030, 0.210, 0.132, 0.780), Color(0.54, 0.16, 0.12, 0.46))
	source.name = "DangerDiscardFinalChoiceSource"
	art.add_child(source)
	var gate = make_gpt_gate(rect_full(0.888, 0.150, 0.940, 0.850), Color(0.98, 0.72, 0.42, 0.26))
	gate.name = "DangerDiscardFinalChoiceGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.786, 0.090, 0.890, 0.910), Color(0.62, 0.20, 0.15, 0.42))
	seal.name = "DangerDiscardFinalChoiceSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "决", 12, Color(0.98, 0.88, 0.72, 0.84), true)
	glyph.name = "DangerDiscardFinalChoiceGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var center = 0.250 + float(i) * 0.165
		var active = risk >= (float(i) + 1.0) / 4.0
		var node = make_gpt_gate(rect_full(center - 0.022, 0.285, center + 0.022, 0.715), Color(0.96, 0.44, 0.28, 0.28 if active else 0.12))
		node.name = "DangerDiscardFinalChoiceNode_%d" % i
		art.add_child(node)
		var tick = make_gpt_tick_strip(rect_full(0.610 + float(i) * 0.045, 0.200, 0.626 + float(i) * 0.045, 0.800), Color(0.96, 0.56, 0.32, 0.24 - float(i) * 0.040))
		tick.name = "DangerDiscardFinalChoiceTick_0"
		art.add_child(tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.46, 0.52).from(0.82)
		tw.parallel().tween_property(alt_fill, "modulate:a", 0.38, 0.52).from(0.82)
		tw.parallel().tween_property(seal, "modulate:a", 0.72, 0.52).from(0.95)
		tw.tween_property(fill, "modulate:a", 0.82, 0.52).from(0.46)
		tw.parallel().tween_property(alt_fill, "modulate:a", 0.82, 0.52).from(0.38)
		tw.parallel().tween_property(seal, "modulate:a", 0.95, 0.52).from(0.72)
	return art


func draw_deal_cascade_completion_art(parent: Control, dealer: int, center: Vector2, accent: Color) -> Control:
	# r211: GPT chrome conversion
	var art = Control.new()
	art.name = "DealCascadeCompletionArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var viewport_size = effective_viewport_size()
	var center_px = Vector2(center.x * viewport_size.x, center.y * viewport_size.y)
	var source = make_gpt_plate_rect(Rect2(center_px + Vector2(-14.0, -14.0), Vector2(28.0, 28.0)), Color(accent.r, accent.g, accent.b, 0.16), "ui_jade_reading_plate")
	source.name = "DealCascadeCompletionSource"
	art.add_child(source)
	var source_glyph = make_label(source, "发", 7, Color(0.98, 0.92, 0.66, 0.84), true)
	source_glyph.name = "DealCascadeCompletionGlyph"
	apply_rect(source_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_gpt_route_rail(Rect2(center_px + Vector2(-120.0, 46.0), Vector2(240.0, 8.0)), Color(0.006, 0.016, 0.018, 0.42))
	archive_route.name = "DealCascadeCompletionRoute"
	art.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.020, 0.250, 0.860, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	archive_fill.name = "DealCascadeCompletionFill"
	archive_route.add_child(archive_fill)
	var ready_gate = make_gpt_gate(Rect2(center_px + Vector2(102.0, 30.0), Vector2(22.0, 40.0)), Color(accent.r, accent.g, accent.b, 0.18))
	ready_gate.name = "DealCascadeReadyGate"
	art.add_child(ready_gate)
	var ready_seal = make_gpt_gate(Rect2(center_px + Vector2(82.0, -48.0), Vector2(48.0, 34.0)), Color(0.92, 0.72, 0.34, 0.16))
	ready_seal.name = "DealCascadeReadySeal"
	art.add_child(ready_seal)
	var ready_glyph = make_label(ready_seal, "起", 8, Color(0.98, 0.92, 0.66, 0.86), true)
	ready_glyph.name = "DealCascadeReadyGlyph"
	apply_rect(ready_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(4):
		var seat = (dealer + i) % 4
		var seat_rect = fx_seat_screen_rect(seat)
		var target = (seat_rect.position + seat_rect.size) * 0.5
		var target_px = Vector2(target.x * viewport_size.x, target.y * viewport_size.y)
		var node = make_gpt_gate(Rect2(target_px + Vector2(-10.0, -10.0), Vector2(20.0, 20.0)), Color(accent.r, accent.g, accent.b, 0.16 - float(i) * 0.012))
		node.name = "DealCascadeCompletionSeatNode_%d" % seat
		art.add_child(node)
		var hand_gate = make_gpt_gate(Rect2(target_px + Vector2(-18.0, 18.0), Vector2(36.0, 8.0)), Color(accent.r, accent.g, accent.b, 0.14))
		hand_gate.name = "DealCascadeHandArchiveGate_%d" % seat
		art.add_child(hand_gate)
	for i in range(4):
		var left = center_px.x - 84.0 + float(i) * 44.0
		var tick = make_gpt_tick_strip(Rect2(Vector2(left, center_px.y + 28.0), Vector2(6.0, 24.0)), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		tick.name = "DealCascadeCompletionTick_0"
		art.add_child(tick)
	return art

# 换手时中心面板轻滑反馈 / Turn-Start Slide Feedback


func draw_deal_start_distribution_routes(parent: Control, dealer: int, center: Vector2, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "DealStartDistributionArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var viewport_size = effective_viewport_size()
	var center_px = Vector2(center.x * viewport_size.x, center.y * viewport_size.y)
	var source = make_gpt_plate_rect(Rect2(center_px + Vector2(-18.0, -18.0), Vector2(36.0, 36.0)), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	source.name = "DealStartDistributionSource"
	art.add_child(source)
	var source_glyph = make_label(source, "庄", 8, Color(0.98, 0.92, 0.66, 0.86), true)
	source_glyph.name = "DealStartDistributionGlyph"
	apply_rect(source_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(4):
		var seat = (dealer + i) % 4
		var seat_rect = fx_seat_screen_rect(seat)
		var target = (seat_rect.position + seat_rect.size) * 0.5
		var target_px = Vector2(target.x * viewport_size.x, target.y * viewport_size.y)
		var delta = target_px - center_px
		var length = max(delta.length(), 1.0)
		var route = make_gpt_route_rail(Rect2(center_px, Vector2(length, 4.0)), Color(0.006, 0.016, 0.018, 0.34))
		route.name = "DealStartDistributionRoute_%d" % seat
		route.rotation = delta.angle()
		art.add_child(route)
		var fill = make_gpt_meter_fill(Rect2(Vector2(4.0, 1.0), Vector2(length * (0.58 + float(i) * 0.08), 2.0)), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.020))
		fill.name = "DealStartDistributionFill_%d" % seat
		route.add_child(fill)
		var gate = make_gpt_gate(Rect2(target_px + Vector2(-8.0, -16.0), Vector2(16.0, 32.0)), Color(accent.r, accent.g, accent.b, 0.16))
		gate.name = "DealStartDistributionGate_%d" % seat
		art.add_child(gate)
		var tick_step = center_px.lerp(target_px, 0.48 + float(i) * 0.06)
		var tick = make_gpt_tick_strip(Rect2(tick_step + Vector2(-3.0, -9.0), Vector2(6.0, 18.0)), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.030))
		tick.name = "DealStartDistributionTick_%d" % seat
		art.add_child(tick)
	return art

# 进局发牌级联动画 - 中心牌堆向四家分发连串牌背 / Deal Cascade Animation


func draw_diagnostic_dialog_art(parent: Control, lines: Array) -> Control:
	# r206: GPT diagnostic health chrome
	var art = Control.new()
	art.name = "DiagnosticDialogArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.045, 0.035, 0.955, 0.175))
	parent.add_child(art)
	var diagnostic_texture = add_illustration_texture(art, "diagnostic_wave", rect_full(-0.012, -0.360, 1.012, 1.360), 0.13, false)
	if diagnostic_texture != null:
		diagnostic_texture.name = "DiagnosticWaveTexture"
	var signal_texture = add_illustration_texture(art, "diagnostic_signal_map", rect_full(0.455, -0.260, 1.010, 1.260), 0.12, false)
	if signal_texture != null:
		signal_texture.name = "DiagnosticSignalMapTexture"
	var ok_count := 0
	var error_count := 0
	var hint_count := 0
	for line in lines:
		var text = str(line)
		if text.begins_with("✓"):
			ok_count += 1
		elif text.begins_with("✗"):
			error_count += 1
		elif text.begins_with("•") or text.find("→") >= 0:
			hint_count += 1
	var total = max(1, ok_count + error_count + hint_count)
	var health = clamp(float(ok_count) / float(total), 0.0, 1.0)
	var accent = Color(0.42, 0.82, 0.56) if error_count == 0 else Color(0.86, 0.46, 0.34)
	var rail = make_gpt_route_rail(rect_full(0.015, 0.455, 0.985, 0.585), Color(0.010, 0.024, 0.026, 0.72))
	rail.name = "DiagnosticHealthRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.012, 0.230, 0.012 + 0.976 * max(0.08, health), 0.770), Color(accent.r, accent.g, accent.b, 0.54))
	fill.name = "DiagnosticHealthFill"
	rail.add_child(fill)
	var seal = make_gpt_gate(rect_full(0.016, 0.100, 0.078, 0.900), Color(accent.r, accent.g, accent.b, 0.28))
	seal.name = "DiagnosticStatusSeal"
	art.add_child(seal)
	var seal_label = make_label(seal, "!" if error_count > 0 else "✓", 12, Color(0.98, 0.92, 0.72, 0.94), true)
	seal_label.name = "DiagnosticStatusGlyph"
	apply_rect(seal_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var groups := [
		{"id": "ok", "value": ok_count, "color": Color(0.34, 0.74, 0.48), "label": "OK"},
		{"id": "err", "value": error_count, "color": Color(0.86, 0.42, 0.34), "label": "ERR"},
		{"id": "hint", "value": hint_count, "color": Color(0.42, 0.58, 0.82), "label": "TIP"},
	]
	for i in range(groups.size()):
		var group: Dictionary = groups[i]
		var color: Color = group.get("color", GOLD_PRIMARY)
		var left = 0.135 + float(i) * 0.182
		var active = int(group.get("value", 0)) > 0
		var node = make_gpt_gate(rect_full(left, 0.130, left + 0.092, 0.870), Color(color.r, color.g, color.b, 0.34 if active else 0.12))
		node.name = "DiagnosticStatusNode_%s" % str(group.get("id", i))
		art.add_child(node)
		var value_label = make_label(node, str(group.get("value", 0)), 10, Color(0.98, 0.92, 0.74, 0.92 if active else 0.46), true)
		value_label.name = "DiagnosticStatusValue_%s" % str(group.get("id", i))
		apply_rect(value_label, rect_full(0.0, 0.040, 1.0, 0.620))
		var caption = make_label(node, str(group.get("label", "")), 6, Color(0.80, 0.84, 0.78, 0.72 if active else 0.38), true)
		caption.name = "DiagnosticStatusCaption_%s" % str(group.get("id", i))
		apply_rect(caption, rect_full(0.0, 0.560, 1.0, 0.980))
	var status_trace_route = make_gpt_route_rail(rect_full(0.500, 0.420, 0.730, 0.550), Color(0.006, 0.016, 0.018, 0.44))
	status_trace_route.name = "DiagnosticStatusTraceRoute"
	art.add_child(status_trace_route)
	var status_trace_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.820, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	status_trace_fill.name = "DiagnosticStatusTraceFill"
	status_trace_route.add_child(status_trace_fill)
	var status_trace_gate = make_gpt_gate(rect_full(0.704, 0.330, 0.744, 0.650), Color(accent.r, accent.g, accent.b, 0.18))
	status_trace_gate.name = "DiagnosticStatusTraceGate"
	art.add_child(status_trace_gate)
	var status_trace_source = make_gpt_gate(rect_full(0.476, 0.355, 0.520, 0.625), Color(accent.r, accent.g, accent.b, 0.16))
	status_trace_source.name = "DiagnosticStatusTraceSource"
	art.add_child(status_trace_source)
	var tick = add_gpt_tick_strip(art, rect_full(0.570, 0.330, (0.584) + float(1) * (0.052), 0.640), Color(accent.r, accent.g, accent.b, 0.22), "DiagnosticStatusTraceTick_0")
	var trace = make_gpt_plate_rect(rect_full(0.720, 0.180, 0.970, 0.820), Color(0.030, 0.048, 0.050, 0.62), "ui_confirm_sheet_plate")
	trace.name = "DiagnosticTracePanel"
	art.add_child(trace)
	for i in range(4):
		var left = 0.075 + float(i) * 0.225
		var pulse = make_gpt_tick_strip(rect_full(left, 0.300, left + 0.060, 0.700), Color(accent.r, accent.g, accent.b, 0.34 - float(i) * 0.035))
		pulse.name = "DiagnosticTracePulse_%d" % i
		trace.add_child(pulse)
	var trace_lane = make_gpt_plate_rect(rect_full(0.535, 0.225, 0.690, 0.775), Color(0.016, 0.032, 0.036, 0.44), "ui_jade_reading_plate")
	trace_lane.name = "DiagnosticLineTrace"
	art.add_child(trace_lane)
	var visual_line_count = min(5, lines.size())
	for i in range(visual_line_count):
		var line_text = str(lines[i])
		var line_color = Color(0.58, 0.66, 0.66)
		if line_text.begins_with("✓"):
			line_color = Color(0.34, 0.74, 0.48)
		elif line_text.begins_with("✗"):
			line_color = Color(0.86, 0.42, 0.34)
		elif line_text.begins_with("•") or line_text.find("→") >= 0:
			line_color = Color(0.42, 0.58, 0.82)
		var top = 0.105 + float(i) * 0.165
		var lane = make_gpt_ribbon(rect_full(0.185, top + 0.055, 0.820, top + 0.085), Color(line_color.r, line_color.g, line_color.b, 0.12))
		lane.name = "DiagnosticLineLane_%d" % i
		trace_lane.add_child(lane)
		var node_2 = make_gpt_gate(rect_full(0.070, top, 0.150, top + 0.140), Color(line_color.r, line_color.g, line_color.b, 0.28))
		node_2.name = "DiagnosticLineNode_%d" % i
		trace_lane.add_child(node_2)
	var trace_dismiss_route = make_gpt_route_rail(rect_full(0.705, 0.760, 0.955, 0.825), Color(0.006, 0.016, 0.018, 0.42))
	trace_dismiss_route.name = "DiagnosticTraceDismissRoute"
	art.add_child(trace_dismiss_route)
	var trace_dismiss_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.760, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	trace_dismiss_fill.name = "DiagnosticTraceDismissFill"
	trace_dismiss_route.add_child(trace_dismiss_fill)
	var trace_dismiss_source = make_gpt_gate(rect_full(0.686, 0.700, 0.728, 0.880), Color(accent.r, accent.g, accent.b, 0.16))
	trace_dismiss_source.name = "DiagnosticTraceDismissSource"
	art.add_child(trace_dismiss_source)
	var trace_dismiss_gate = make_gpt_gate(rect_full(0.928, 0.690, 0.970, 0.890), Color(0.78, 0.70, 0.46, 0.18))
	trace_dismiss_gate.name = "DiagnosticTraceDismissGate"
	art.add_child(trace_dismiss_gate)
	var tick_2 = add_gpt_tick_strip(art, rect_full(0.765, 0.685, (0.779) + float(2) * (0.052), 0.885), Color(accent.r, accent.g, accent.b, 0.22), "DiagnosticTraceDismissTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.42, 0.60).from(0.94)
		tw.tween_property(fill, "modulate:a", 0.94, 0.60).from(0.42)
	return art


