func draw_update_status_convergence_art(parent: Control) -> Control:
	# r205: GPT status convergence chrome
	var art = Control.new()
	art.name = "UpdateStatusConvergenceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.080, 0.585, 0.920, 0.675))
	parent.add_child(art)
	var stage_index = update_stage_index()
	var ready = update_state == "ready"
	var error = update_state == "error"
	var accent = Color(0.86, 0.42, 0.34) if error else (Color(0.74, 0.88, 0.60) if ready else Color(0.78, 0.62, 0.36))
	var source = make_gpt_gate(rect_full(0.025, 0.280, 0.070, 0.700), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "UpdateStatusConvergenceSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.070, 0.430, 0.900, 0.530), Color(0.006, 0.018, 0.020, 0.46))
	route.name = "UpdateStatusConvergenceRoute"
	art.add_child(route)
	var fill_right = clamp(0.160 + float(stage_index) * 0.240, 0.160, 0.900)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, fill_right, 0.750), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "UpdateStatusConvergenceFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.875, 0.235, 0.935, 0.750), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "UpdateStatusConvergenceGate"
	art.add_child(gate)
	var archive = make_gpt_gate(rect_full(0.725, 0.075, 0.835, 0.355), Color(accent.r, accent.g, accent.b, 0.12))
	archive.name = "UpdateStatusConvergenceArchive"
	art.add_child(archive)
	var glyph_text = "错" if error else ("成" if ready else "验")
	var glyph = make_label(archive, glyph_text, 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "UpdateStatusConvergenceGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var notes_route = make_gpt_route_rail(rect_full(0.545, 0.720, 0.890, 0.815), Color(0.006, 0.018, 0.020, 0.40))
	notes_route.name = "UpdateStatusNotesRoute"
	art.add_child(notes_route)
	var notes_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820 if update_release_notes.strip_edges() != "" else 0.360, 0.750), Color(0.82, 0.70, 0.36, 0.24))
	notes_fill.name = "UpdateStatusNotesFill"
	notes_route.add_child(notes_fill)
	for i in range(4):
		var left = 0.160 + float(i) * 0.170
		var active = i <= stage_index
		var node = make_gpt_tick_strip(rect_full(left, 0.250, left + 0.028, 0.750), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.08))
		node.name = "UpdateStatusConvergenceNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.310, 0.145, (0.310) + float(2) * (0.100) + (0.014), 0.850), Color(accent.r, accent.g, accent.b, 0.23), "UpdateStatusConvergenceTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.88
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "anchor_right", 0.980, 0.82).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.41).from(0.92)
		tw.tween_property(fill, "anchor_right", fill_right, 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.41).from(0.48)
	return art


func draw_voice_button_art(button: Control, active: bool, peak: float = 0.0) -> Control:
	var art = Control.new()
	art.name = "VoiceButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.650, 0.150, 0.965, 0.850))
	button.add_child(art)
	var halo_texture = add_illustration_texture(art, "voice_channel_halo", rect_full(-0.220, -0.240, 0.520, 1.240), 0.12 if active else 0.06, true)
	if halo_texture != null:
		halo_texture.name = "VoiceChannelHaloTexture"
		art.move_child(halo_texture, 0)
	var voice_gpt_key := "voice_gpt_channel"
	var voice_gpt_texture = add_optional_gpt_illustration_texture(art, voice_gpt_key, rect_full(-0.180, -0.180, 1.060, 1.180), 0.22 if active else 0.14, false)  # r221
	if voice_gpt_texture != null:
		voice_gpt_texture.name = "VoiceGPTChannelTexture"
		art.move_child(voice_gpt_texture, min(1, art.get_child_count() - 1))
	var voice_texture = add_illustration_texture(art, "voice_wave", rect_full(-0.080, -0.080, 1.080, 1.080), 0.16, false)
	if voice_texture != null:
		voice_texture.name = "VoiceWaveTexture"
		if active and fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var voice_texture_tw := create_screen_tween()
			voice_texture_tw.set_loops(48)
			voice_texture_tw.tween_property(voice_texture, "modulate:a", 0.09, 0.72).from(0.18)
			voice_texture_tw.tween_property(voice_texture, "modulate:a", 0.18, 0.72).from(0.09)
	var accent = Color(0.42, 0.86, 0.64) if active else Color(0.70, 0.42, 0.42)
	# r204 GPT voice chrome
	var base = make_gpt_gate(rect_full(0.020, 0.120, 0.300, 0.880), Color(accent.r, accent.g, accent.b, 0.34 if active else 0.22))
	base.name = "VoiceButtonStatusDot"
	art.add_child(base)
	var pulse_alpha = clamp(0.18 + peak * 0.36, 0.18, 0.54) if active else 0.10
	var pulse = make_gpt_plate_rect(rect_full(0.000, 0.060, 0.340, 0.940), Color(accent.r, accent.g, accent.b, pulse_alpha), "ui_soft_flash")
	pulse.name = "VoiceButtonPulse"
	art.add_child(pulse)
	var listen_ring = make_gpt_plate_rect(rect_full(0.000, 0.000, 0.360, 1.000), Color(accent.r, accent.g, accent.b, 0.10 if active else 0.05), "ui_hand_tray_state_chip")
	listen_ring.name = "VoiceButtonListenRing"
	art.add_child(listen_ring)
	var meter = make_gpt_route_rail(rect_full(0.405, 0.815, 0.930, 0.900), Color(0.020, 0.036, 0.038, 0.50))
	meter.name = "VoiceButtonPeakMeter"
	art.add_child(meter)
	var meter_fill_right = 0.045 + 0.910 * (clamp(peak, 0.0, 1.0) if active else 0.10)
	var meter_fill = make_gpt_meter_fill(rect_full(0.045, 0.260, meter_fill_right, 0.740), Color(accent.r, accent.g, accent.b, 0.54 if active else 0.18))
	meter_fill.name = "VoiceButtonPeakFill"
	meter.add_child(meter_fill)
	var channel = make_gpt_route_rail(rect_full(0.365, 0.640, 0.935, 0.735), Color(0.006, 0.016, 0.018, 0.48))
	channel.name = "VoiceButtonMicChannel"
	art.add_child(channel)
	var channel_fill_right = 0.040 + 0.900 * (clamp(0.28 + peak * 0.62, 0.10, 1.0) if active else 0.18)
	var channel_fill = make_gpt_meter_fill(rect_full(0.040, 0.260, channel_fill_right, 0.740), Color(accent.r, accent.g, accent.b, 0.32 if active else 0.13))
	channel_fill.name = "VoiceButtonMicChannelFill"
	channel.add_child(channel_fill)
	var send_route = make_gpt_route_rail(rect_full(0.395, 0.205, 0.920, 0.280), Color(0.006, 0.016, 0.018, 0.44))
	send_route.name = "VoiceButtonTransmitRoute"
	art.add_child(send_route)
	var send_fill_right = 0.040 + 0.880 * (clamp(0.34 + peak * 0.56, 0.18, 1.0) if active else 0.20)
	var send_fill = make_gpt_meter_fill(rect_full(0.040, 0.250, send_fill_right, 0.750), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.12))
	send_fill.name = "VoiceButtonTransmitFill"
	send_route.add_child(send_fill)
	var send_gate = make_gpt_gate(rect_full(0.895, 0.165, 0.935, 0.395), Color(0.96, 0.82, 0.42, 0.26 if active else 0.10))
	send_gate.name = "VoiceButtonTransmitGate"
	art.add_child(send_gate)
	for i in range(3):
		var sync_left = 0.500 + float(i) * 0.115
		var sync = make_gpt_gate(rect_full(sync_left, 0.320, sync_left + 0.024, 0.430), Color(accent.r, accent.g, accent.b, (0.26 - float(i) * 0.040) if active else (0.10 - float(i) * 0.015)))
		sync.name = "VoiceButtonSyncTick_0"
		art.add_child(sync)
	var input_node = make_gpt_gate(rect_full(0.330, 0.560, 0.405, 0.815), Color(accent.r, accent.g, accent.b, 0.28 if active else 0.14))
	input_node.name = "VoiceButtonInputNode"
	art.add_child(input_node)
	for i in range(3):
		var packet_left = 0.650 + float(i) * 0.075
		var packet = make_gpt_tick_strip(rect_full(packet_left, 0.510, packet_left + 0.038, 0.610), Color(accent.r, accent.g, accent.b, (0.30 - float(i) * 0.045) if active else (0.12 - float(i) * 0.020)))
		packet.name = "VoiceButtonPacketTick_0"
		art.add_child(packet)
	for i in range(3):
		var height = (0.24 + float(i) * 0.15) * (0.72 + peak * 0.38 if active else 1.0)
		var top = 0.50 - height * 0.5
		var left = 0.430 + float(i) * 0.155
		var wave = make_gpt_meter_fill(rect_full(left, top, left + 0.080, top + height), Color(accent.r, accent.g, accent.b, 0.68 if active else 0.28))
		wave.name = "VoiceButtonWave_%d" % i
		art.add_child(wave)
		var tick = make_gpt_tick_strip(rect_full(left + 0.018, 0.080, left + 0.062, 0.155), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.12))
		tick.name = "VoiceButtonPeakTick_0"
		art.add_child(tick)
	if not active:
		var slash = make_gpt_ribbon(rect_full(0.385, 0.410, 0.930, 0.570), Color(0.90, 0.72, 0.62, 0.48))
		slash.name = "VoiceButtonMutedSlash"
		slash.rotation = -0.42
		art.add_child(slash)
		var lock = make_gpt_gate(rect_full(0.040, 0.680, 0.245, 0.920), Color(0.78, 0.48, 0.42, 0.28))
		lock.name = "VoiceButtonMutedLock"
		art.add_child(lock)
		var mute_route = make_gpt_route_rail(rect_full(0.185, 0.720, 0.545, 0.780), Color(0.006, 0.016, 0.018, 0.44))
		mute_route.name = "VoiceButtonMuteRoute"
		art.add_child(mute_route)
		var mute_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.520, 0.750), Color(0.90, 0.62, 0.54, 0.18))
		mute_fill.name = "VoiceButtonMuteFill"
		mute_route.add_child(mute_fill)
		var mute_gate = make_gpt_gate(rect_full(0.520, 0.660, 0.585, 0.835), Color(0.90, 0.62, 0.54, 0.22))
		mute_gate.name = "VoiceButtonMuteGate"
		art.add_child(mute_gate)
		for i in range(2):
			var mute_left = 0.285 + float(i) * 0.105
			add_gpt_tick_strip(art, rect_full(mute_left, 0.640, mute_left + 0.040, 0.835), Color(0.90, 0.62, 0.54, 0.18 - float(i) * 0.040), "VoiceButtonMuteTick_%d" % i)
	if active:
		if halo_texture != null:
			halo_texture.modulate = Color(1, 1, 1, 0.08)
		pulse.modulate = Color(1, 1, 1, 0.72)
		listen_ring.modulate = Color(1, 1, 1, 0.72)
		channel_fill.modulate = Color(1, 1, 1, 0.80)
	draw_voice_button_network_echo(art, accent, active, peak)
	draw_voice_button_feedback_loop(art, accent, active, peak)
	if button is Button:
		var voice_button := button as Button
		voice_button.button_down.connect(func() -> void:
			play_voice_button_press_feedback(voice_button, active, peak)
		)
	return art

func draw_voice_button_feedback_loop(parent: Control, accent: Color, active: bool, peak: float = 0.0) -> Control:
	var loop = Control.new()
	loop.name = "VoiceButtonFeedbackLoop"
	loop.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(loop, rect_full(0.300, 0.285, 0.960, 0.820))
	parent.add_child(loop)
	var strength = clamp(0.30 + peak * 0.60, 0.18, 1.0) if active else 0.22
	var rail = make_gpt_route_rail(rect_full(0.030, 0.600, 0.945, 0.705), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "VoiceButtonFeedbackRail"
	loop.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.920 * strength, 0.740), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.11))
	fill.name = "VoiceButtonFeedbackFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.475, 0.075, 0.825), Color(accent.r, accent.g, accent.b, 0.18 if active else 0.10))
	source.name = "VoiceButtonFeedbackSource"
	loop.add_child(source)
	var return_gate = make_gpt_gate(rect_full(0.900, 0.420, 0.970, 0.875), Color(0.96, 0.82, 0.42, 0.22 if active else 0.09))
	return_gate.name = "VoiceButtonFeedbackReturnGate"
	loop.add_child(return_gate)
	var confirm = make_gpt_gate(rect_full(0.635, 0.155, 0.930, 0.260), Color(accent.r, accent.g, accent.b, 0.18 if active else 0.08))
	confirm.name = "VoiceButtonFeedbackConfirmRoute"
	loop.add_child(confirm)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.000, 0.250, 0.720 if active else 0.320, 0.750), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.10))
	confirm_fill.name = "VoiceButtonFeedbackConfirmFill"
	confirm.add_child(confirm_fill)
	for i in range(3):
		var left = 0.205 + float(i) * 0.150
		var tick = make_gpt_tick_strip(rect_full(left, 0.355, left + 0.024, 0.565), Color(accent.r, accent.g, accent.b, (0.22 - float(i) * 0.040) if active else (0.10 - float(i) * 0.018)))
		tick.name = "VoiceButtonFeedbackTick_%d" % i
		loop.add_child(tick)
	if active:
		fill.modulate = Color(1, 1, 1, 0.82)
		return_gate.modulate = Color(1, 1, 1, 0.80)
	return loop

