		remote.modulate = Color(1, 1, 1, 0.80)
	return echo


func wall_visual_active_counts(progress: float) -> Array:
	var counts: Array = []
	var total_capacity := 0
	for item in WALL_LAYOUTS:
		total_capacity += int(item[2])
	var active_total = clamp(int(round(float(total_capacity) * progress)), 0, total_capacity)
	var allocated := 0
	for item in WALL_LAYOUTS:
		var capacity = int(item[2])
		var count = clamp(int(floor(float(capacity) * progress)), 0, capacity)
		counts.append(count)
		allocated += count
	var cursor := 0
	while allocated < active_total and cursor < WALL_LAYOUTS.size() * 2:
		var idx = cursor % WALL_LAYOUTS.size()
		var capacity = int(WALL_LAYOUTS[idx][2])
		if int(counts[idx]) < capacity:
			counts[idx] = int(counts[idx]) + 1
			allocated += 1
		cursor += 1
	cursor = WALL_LAYOUTS.size() - 1
	while allocated > active_total and cursor >= 0:
		if int(counts[cursor]) > 0:
			counts[cursor] = int(counts[cursor]) - 1
			allocated -= 1
		else:
			cursor -= 1
	return counts

func wall_live_feedback_rail_region(progress: float) -> Rect2:
	if progress <= 0.18:
		return Rect2(40, 352, 548, 70)
	if progress <= 0.34:
		return Rect2(40, 255, 548, 70)
	if progress <= 0.72:
		return Rect2(40, 157, 548, 70)
	return Rect2(40, 60, 548, 70)

func wall_live_feedback_badge_region(progress: float) -> Rect2:
	if progress <= 0.18:
		return Rect2(1269, 48, 188, 188)
	if progress <= 0.34:
		return Rect2(1063, 48, 188, 188)
	if progress <= 0.72:
		return Rect2(857, 48, 188, 188)
	return Rect2(651, 48, 188, 188)

func wall_live_feedback_pulse_region(progress: float, low_wall: bool) -> Rect2:
	if low_wall:
		return Rect2(1040, 330, 190, 72)
	if progress <= 0.34:
		return Rect2(846, 330, 184, 72)
	return Rect2(640, 326, 184, 72)

func wall_live_feedback_corner_region(right_corner: bool) -> Rect2:
	return Rect2(1364, 318, 94, 92) if right_corner else Rect2(1265, 314, 94, 92)

func wall_remaining_badge_state_text(wall_count: int, recent_feedback: bool) -> String:
	if recent_feedback:
		return "补岭" if str(offline_last_draw.get("source", "")) == "gang" else "摸入"
	if wall_count <= 18:
		return "荒近"
	if wall_count <= 24:
		return "低余"
	return "实时"

func draw_wall_remaining_badge(parent: Control, wall_count: int, progress: float, recent_feedback: bool) -> Control:
	# r214: bulk GPT chrome sweep
	var color = wall_meter_color(progress)
	var low_wall = wall_count <= 24
	var has_live_feedback_kit := optional_gpt_illustration_texture("wall_live_feedback_kit") != null
	var badge = make_gpt_gate(rect_full(0.758, 0.016, 0.962, 0.083), Color(0.010, 0.020, 0.020, 0.72))
	badge.name = "WallRemainingBadge"
	parent.add_child(badge)
	var badge_frame = add_optional_gpt_atlas_texture(badge, "wall_live_feedback_kit", wall_live_feedback_badge_region(progress), rect_full(0.012, -0.160, 0.190, 1.030), 0.24 if low_wall else 0.18, true)
	if badge_frame != null:
		badge_frame.name = "WallLiveFeedbackBadgeFrameTexture"
	add_lucide_icon(badge, "layers", rect_full(0.040, 0.150, 0.170, 0.680), Color(0.92, 0.82, 0.58, 0.82))
	var title = make_label(badge, "牌山", 8, Color(0.70, 0.78, 0.66, 0.78), true)
	title.name = "WallRemainingBadgeTitle"
	apply_rect(title, rect_full(0.190, 0.080, 0.430, 0.440))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(title)
	var label = make_label(badge, "余%d" % wall_count, 13, Color(0.96, 0.90, 0.70) if not low_wall else Color(1.0, 0.74, 0.50), true)
	label.name = "WallRemainingBadgeText"
	apply_rect(label, rect_full(0.440, 0.050, 0.905, 0.485))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(label)
	var state = make_label(badge, wall_remaining_badge_state_text(wall_count, recent_feedback), 8, Color(color.r, color.g, color.b, 0.86), true)
	state.name = "WallRemainingBadgeState"
	apply_rect(state, rect_full(0.190, 0.460, 0.680, 0.760))
	state.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(state)
	var delta = make_label(badge, "-1" if recent_feedback else "", 8, Color(0.96, 0.86, 0.50, 0.92), true)
	delta.name = "WallRemainingBadgeDelta"
	apply_rect(delta, rect_full(0.700, 0.455, 0.905, 0.760))
	delta.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(delta)
	var track = make_gpt_route_rail(rect_full(0.100, 0.815, 0.920, 0.900), Color(0.0, 0.0, 0.0, 0.28))
	track.name = "WallRemainingBadgeTrack"
	badge.add_child(track)
	var rail_texture = add_optional_gpt_atlas_texture(track, "wall_live_feedback_kit", wall_live_feedback_rail_region(progress), rect_full(-0.055, -1.150, 1.055, 2.150), 0.20 if has_live_feedback_kit else 0.0, false)
	if rail_texture != null:
		rail_texture.name = "WallLiveFeedbackRailTexture"
		track.move_child(rail_texture, 0)
	var fill_right = 0.035 + 0.930 * clamp(progress, 0.0, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.250, fill_right, 0.750), Color(color.r, color.g, color.b, 0.42 if not low_wall else 0.62))
	fill.name = "WallRemainingBadgeFill"
	track.add_child(fill)
	if recent_feedback or low_wall:
		var pulse = make_gpt_tick_strip(rect_full(0.914, 0.160, 0.972, 0.740), Color(color.r, color.g, color.b, 0.28))
		pulse.name = "WallRemainingBadgeFeedback"
		badge.add_child(pulse)
	return badge


func draw_wall_count_feedback_art(parent: Control, wall_count: int, progress: float, recent_feedback: bool) -> Control:
	# r214: bulk GPT chrome sweep
	if not recent_feedback and wall_count > 24:
		return null
	var color = wall_meter_color(progress)
	var low_wall = wall_count <= 24
	var has_live_feedback_kit := optional_gpt_illustration_texture("wall_live_feedback_kit") != null
	var art = Control.new()
	art.name = "WallDrawFeedbackArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var pulse_texture = add_optional_gpt_atlas_texture(art, "wall_live_feedback_kit", wall_live_feedback_pulse_region(progress, low_wall), rect_full(0.765, 0.018, 0.952, 0.091), 0.28 if has_live_feedback_kit else 0.0, false)
	if pulse_texture != null:
		pulse_texture.name = "WallLiveFeedbackPulseTexture"
	var sheen = make_gpt_plate_rect(rect_full(0.758, 0.016, 0.962, 0.083), Color(color.r, color.g, color.b, (0.044 if recent_feedback else 0.026) if has_live_feedback_kit else (0.075 if recent_feedback else 0.045)), "ui_button_face_plate")
	sheen.name = "WallDrawFeedbackSheen"
	art.add_child(sheen)
	var edge = make_gpt_plate_rect(rect_full(0.942, 0.030, 0.958, 0.070), Color(color.r, color.g, color.b, (0.13 if recent_feedback else 0.08) if has_live_feedback_kit else (0.24 if recent_feedback else 0.13)), "ui_jade_reading_plate")
	edge.name = "WallDrawFeedbackEdge"
	art.add_child(edge)
	var wash = make_gpt_plate_rect(rect_full(0.790, 0.074, 0.935, 0.080), Color(color.r, color.g, color.b, (0.12 if recent_feedback else 0.07) if has_live_feedback_kit else (0.22 if recent_feedback else 0.12)))
	wash.name = "WallDrawFeedbackWash"
	art.add_child(wash)
	if low_wall:
		var corner_left = add_optional_gpt_atlas_texture(art, "wall_live_feedback_kit", wall_live_feedback_corner_region(false), rect_full(0.958, 0.006, 0.986, 0.085), 0.36 if has_live_feedback_kit else 0.0, true)
		if corner_left != null:
			corner_left.name = "WallLiveFeedbackCornerLeftTexture"
		var corner_right = add_optional_gpt_atlas_texture(art, "wall_live_feedback_kit", wall_live_feedback_corner_region(true), rect_full(0.984, 0.006, 1.010, 0.085), 0.32 if has_live_feedback_kit else 0.0, true)
		if corner_right != null:
			corner_right.name = "WallLiveFeedbackCornerRightTexture"
		var warning = make_gpt_edge_rail(rect_full(0.982, 0.025, 0.996, 0.078), Color(0.78, 0.20, 0.10, 0.22))
		warning.name = "WallDrawLowWarningPulse"
		art.add_child(warning)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(4)
		tw.tween_property(sheen, "modulate:a", 0.42, 0.22).from(0.92)
		tw.parallel().tween_property(edge, "modulate:a", 0.56, 0.22).from(0.94)
		tw.tween_property(sheen, "modulate:a", 0.92, 0.22).from(0.42)
		tw.parallel().tween_property(edge, "modulate:a", 0.94, 0.22).from(0.56)
	return art


func draw_walls(parent: Control) -> void:
	var wall_count = get_wall_count()
	var progress = clamp(float(wall_count) / float(WALL_VISUAL_FULL_COUNT), 0.0, 1.0)
	var low_wall = wall_count <= 24
	var recent_feedback = mode == "offline" and bool(offline_last_draw.get("announce", false))
	var active_counts = wall_visual_active_counts(progress)
	# When the battle already hosts a realtime commercial 3D wall, keep 2D strips as
	# invisible layout/metadata carriers so the physical MultiMesh stacks own the look.
	for i in range(WALL_LAYOUTS.size()):
		var item = WALL_LAYOUTS[i]
		var capacity = int(item[2])
		var strip = make_wall_back_strip(int(active_counts[i]), bool(item[3]), capacity, progress, low_wall, recent_feedback)
		# Keep names unique among siblings so smoke/layout probes can find all four sides.
		strip.name = "WallBackStrip_%s_%d_%d" % ["h" if bool(item[3]) else "v", capacity, i]
		strip.anchor_left = item[0].x
		strip.anchor_top = item[0].y
		strip.anchor_right = item[1].x
		strip.anchor_bottom = item[1].y
		parent.add_child(strip)
	draw_wall_count_feedback_art(parent, wall_count, progress, recent_feedback)
	draw_wall_remaining_badge(parent, wall_count, progress, recent_feedback)

