	apply_rect(river_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var gate = make_gpt_gate(rect_full(0.895, 0.770, 0.940, 0.930), Color(0.96, 0.78, 0.38, 0.20))
	gate.name = "HandTrayTutorialDiscardGate"
	flow.add_child(gate)
	var tick = add_gpt_tick_strip(flow, rect_full(0.260, 0.748, (0.260) + float(2) * (0.135) + (0.018), 0.948), Color(accent.r, accent.g, accent.b, 0.24), "HandTrayTutorialDiscardTick_0")
	for i in range(2):
		var bead = make_gpt_plate_rect(rect_full(0.790 + float(i) * 0.046, 0.785, 0.822 + float(i) * 0.046, 0.910), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040), "ui_jade_reading_plate")
		bead.name = "HandTrayTutorialRiverBead_%d" % i
		flow.add_child(bead)
	var commit_route = make_gpt_route_rail(rect_full(0.600, 0.610, 0.905, 0.685), Color(0.006, 0.018, 0.020, 0.42))
	commit_route.name = "HandTrayTutorialCommitRoute"
	flow.add_child(commit_route)
	var commit_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.820, 0.750), Color(accent.r, accent.g, accent.b, 0.25))
	commit_fill.name = "HandTrayTutorialCommitFill"
	commit_route.add_child(commit_fill)
	var commit_gate = make_gpt_gate(rect_full(0.880, 0.555, 0.940, 0.740), Color(0.96, 0.78, 0.38, 0.18))
	commit_gate.name = "HandTrayTutorialCommitGate"
