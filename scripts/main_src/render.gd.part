	settings_section_navigation.set_meta("active_marker_contract", "exactly_one_visible_authored_marker")
	apply_rect(settings_section_navigation, rect_full(0.040, 0.175, 0.520, 0.235))
	panel.add_child(settings_section_navigation)
	for settings_section_name in ["声音", "体验", "系统"]:
		var section_name := str(settings_section_name)
		var section_nav_button := make_small_button(section_name, Color(0.28, 0.48, 0.42), func() -> void:
			focus_settings_section(settings_content_parent, settings_large_text_scroll, section_name)
		)
		section_nav_button.name = "SettingsSectionNavButton_%s" % section_name
		section_nav_button.custom_minimum_size = Vector2(82, UI_MIN_TOUCH_TARGET)
		section_nav_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		section_nav_button.tooltip_text = "跳转到%s设置" % section_name
		set_ui_full_text(section_nav_button, section_nav_button.tooltip_text, "设置分区入口：" + section_name)
		section_nav_button.set_meta("section_name", section_name)
		section_nav_button.set_meta("section_active", section_name == active_settings_section)
		section_nav_button.set_meta("native_target_contract", "44px_settings_section_navigation")
		mark_ui_optimization(section_nav_button, "F-713")
		settings_section_navigation.add_child(section_nav_button)
		if section_name == active_settings_section:
			var active_marker := make_gpt_tick_strip(rect_full(0.080, 0.875, 0.920, 0.985), Color(0.96, 0.78, 0.36, 0.82))
			active_marker.name = "SettingsSectionActiveMarker"
			active_marker.mouse_filter = Control.MOUSE_FILTER_IGNORE
			active_marker.set_meta("marker_owner", section_name)
			active_marker.set_meta("marker_contract", "one_visible_active_section")
			section_nav_button.add_child(active_marker)
	if not large_text_enabled:
		var settings_default_scroll_hint := make_label(panel, "系统设置 · 已到页面底部", 10, Color(0.74, 0.84, 0.76), true)
		settings_default_scroll_hint.name = "SettingsDefaultScrollStatus"
		apply_rect(settings_default_scroll_hint, rect_full(0.040, 0.900, 0.520, 0.945))
		settings_default_scroll_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		settings_default_scroll_hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
		settings_default_scroll_hint.tooltip_text = "默认字号下设置内容完整显示；大字模式可向下滚动"
		set_ui_full_text(settings_default_scroll_hint, settings_default_scroll_hint.tooltip_text, "设置页面边界状态")
		settings_default_scroll_hint.set_meta("scroll_contract", "default_layout_complete_large_text_scrollable")
		if compact_settings:
			# The compact system section owns the last visible lane. Merge the end
			# state into its title instead of placing a second label over its rows.
			settings_default_scroll_hint.visible = false
			settings_default_scroll_hint.set_meta("merged_into_system_section_title", true)
			var system_section := settings_content_parent.find_child("SettingsSection_系统", true, false) as Control
			if system_section != null:
				for section_child in system_section.get_children():
					if section_child is Label and (section_child as Label).text == "系统":
						(section_child as Label).text = "系统 · 已到末端"
						set_ui_full_text(section_child as Control, settings_default_scroll_hint.tooltip_text, "系统设置页面边界状态")
						break
		mark_ui_optimization(settings_default_scroll_hint, "F-048")
	var settings_default_focus := settings_focus_restore_name if settings_focus_restore_name != "" else "SettingsCloseButton"
	settings_focus_restore_name = ""
	configure_button_focus_navigation(panel, settings_default_focus)
	# Rebuilds triggered by a setting selector can finish before the new control
	# tree has resolved its compact grid geometry. Restore once more after layout
	# so the selector remains the active keyboard target.
	call_deferred("focus_named_control", settings_default_focus)
	if settings_large_text_scroll != null and settings_large_text_status != null:
		call_deferred("sync_settings_large_text_scroll_status", settings_large_text_scroll, settings_large_text_status)
	register_ui_round_681_710(parent)
	register_ui_round_801_830(parent)


func ensure_settings_control_visible(settings_scroll: ScrollContainer, control: Control) -> void:
	if settings_scroll == null or control == null or not is_instance_valid(settings_scroll) or not is_instance_valid(control):
		return
	if not settings_scroll.is_visible_in_tree() or not control.is_visible_in_tree():
		return
	settings_scroll.ensure_control_visible(control)
	settings_scroll.set_meta("ui_focus_auto_scrolled", true)
	settings_scroll.set_meta("ui_focus_child_name", str(control.name))


func focus_settings_section(settings_content_parent: Control, settings_scroll: ScrollContainer, section_name: String) -> void:
	if settings_content_parent == null or not is_instance_valid(settings_content_parent):
		return
	var section := settings_content_parent.find_child("SettingsSection_%s" % section_name, true, false) as Control
	if section == null:
		return
	section.set_meta("last_navigation_request", section_name)
	var section_navigation := root_layer.find_child("SettingsSectionNavigation", true, false) as Control if root_layer != null and is_instance_valid(root_layer) else null
	if section_navigation != null:
		section_navigation.set_meta("active_section", section_name)
		var active_marker := section_navigation.find_child("SettingsSectionActiveMarker", true, false) as Control
		for nav_node in section_navigation.get_children():
			var nav_button := nav_node as Button
			if nav_button == null:
				continue
			var is_active := str(nav_button.get_meta("section_name", "")) == section_name
			nav_button.set_meta("section_active", is_active)
			if is_active and active_marker != null and active_marker.get_parent() != nav_button:
				active_marker.get_parent().remove_child(active_marker)
				nav_button.add_child(active_marker)
			var marker := nav_button.find_child("SettingsSectionActiveMarker", true, false) as Control
			if marker != null:
				marker.visible = is_active
	if settings_scroll != null and is_instance_valid(settings_scroll):
		settings_scroll.ensure_control_visible(section)
		settings_scroll.set_meta("last_section_navigation", section_name)
		call_deferred("sync_settings_large_text_scroll_status", settings_scroll, settings_scroll.get_parent().find_child("SettingsLargeTextScrollStatus", true, false) as Label)
	else:
		show_toast("已定位到%s设置" % section_name, 1500)


func sync_settings_large_text_scroll_status(settings_scroll: ScrollContainer, status_label: Label) -> void:
	if settings_scroll == null or status_label == null or not is_current_ui_control(settings_scroll) or not is_current_ui_control(status_label):
		return
	var scrollbar := settings_scroll.get_v_scroll_bar()
	var content := settings_scroll.find_child("SettingsLargeTextContent", true, false) as Control
	if scrollbar == null or content == null:
		return
	if settings_scroll.size.y <= 1.0 or content.size.y <= 1.0:
		status_label.visible = false
		status_label.set_meta("measurement_pending", true)
		return
	var page := maxf(scrollbar.page, settings_scroll.size.y)
	var scroll_range := maxf(0.0, scrollbar.max_value - page)
	var value := clampf(scrollbar.value, 0.0, scroll_range)
	var first_section := 1
	var last_section := 1
	var section_index := 0
	var has_visible_section := false
	var visible_section_names: Array[String] = []
	for child in content.get_children():
		var section := child as Control
		if section == null or not str(section.name).begins_with("SettingsSection_"):
			continue
		section_index += 1
		var section_name := str(section.name).trim_prefix("SettingsSection_")
		var section_top := section.position.y
		var section_bottom := section_top + section.size.y
		if section_bottom > value + 1.0 and section_top < value + page - 1.0:
			if not has_visible_section:
				first_section = section_index
				has_visible_section = true
			last_section = section_index
			visible_section_names.append(section_name)
	if scroll_range <= 0.5:
		first_section = 1
		last_section = mini(3, maxi(1, section_index))
		visible_section_names = ["声音", "体验", "系统"]
	var at_end := value >= scroll_range - 0.5
	var state_text := "已到末端" if at_end else "下方还有内容"
	var detail := "当前显示第%d至%d个设置分区，共%d个" % [first_section, last_section, maxi(3, section_index)]
	if at_end:
		detail += "；已到设置末端"
	else:
		detail += "；继续向下滚动可查看未显示的设置项"
	var visible_names_text := "、".join(visible_section_names) if not visible_section_names.is_empty() else "当前分区"
	set_dynamic_label_text(status_label, "设置区 · 当前显示：%s · %s" % [visible_names_text, state_text], detail)
	status_label.visible = true
	status_label.set_meta("measurement_pending", false)
	status_label.set_meta("settings_first_section", first_section)
	status_label.set_meta("settings_last_section", last_section)
	status_label.set_meta("settings_scroll_range", scroll_range)
	status_label.set_meta("settings_visible_section_names", visible_section_names)
	status_label.set_meta("settings_section_count", maxi(3, section_index))
	settings_scroll.set_meta("footer_boundary_contract", "viewport_then_status_then_footer")
	settings_scroll.set_meta("focus_restore_updates_range", true)
	status_label.set_meta("focus_restore_contract", "ensure_visible_then_sync_range")
	mark_ui_optimization(status_label, "F-113")
	mark_ui_optimization(status_label, "F-114")
	mark_ui_optimization(settings_scroll, "F-115")
	mark_ui_optimization(status_label, "F-115")


func draw_settings_overview_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingsOverviewArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.285, 0.195, 0.715, 0.252))
	parent.add_child(art)
	var overview_texture = add_illustration_texture(art, "settings_overview_scroll", rect_full(-0.020, -0.160, 1.020, 1.160), 0.026, false)
	if overview_texture != null:
		overview_texture.name = "SettingsOverviewScrollTexture"
	var enabled_audio = int(music_enabled) + int(sfx_enabled) + int(tts_enabled)
	var enabled_play = int(fast_mode_enabled) + int(fx_enabled) + int(ai_assist_enabled)
	# The optional generated plate is only a quiet material wash; native nodes and
	# labels carry the real settings state so baked pseudo-controls stay subdued.
	var overview_panel_key := "settings_overview_panel"
	var overview_panel = add_optional_gpt_illustration_texture(art, overview_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.026, false)
	if overview_panel != null:
		overview_panel.name = "SettingsOverviewPanelTexture"
		art.move_child(overview_panel, 0)
	var rail = make_gpt_route_rail(rect_full(0.330, 0.735, 0.905, 0.855), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "SettingsOverviewRail"
	art.add_child(rail)
	var enabled_total: int = int(enabled_audio) + int(enabled_play)
	var enabled_ratio: float = 0.0 if enabled_total <= 0 else clampf(float(enabled_total) / 6.0, 0.0, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.920 * enabled_ratio, 0.740), Color(0.78, 0.62, 0.36, 0.28))
	fill.name = "SettingsOverviewFill"
	rail.add_child(fill)
	var overview_nodes := [
		["audio", "声", 0.095, Color(0.34, 0.58, 0.72)],
		["play", "玩", 0.178, Color(0.34, 0.62, 0.46)],
		["maint", "护", 0.261, Color(0.70, 0.48, 0.34)],
	]
	for item in overview_nodes:
		var node = make_gpt_gate(rect_full(float(item[2]) - 0.032, 0.160, float(item[2]) + 0.032, 0.660), item[3])
		node.name = "SettingsOverviewNode_%s" % str(item[0])
		art.add_child(node)
		var glyph = make_label(node, str(item[1]), 8, Color(0.98, 0.92, 0.66, 0.86), true)
		glyph.name = "SettingsOverviewGlyph_%s" % str(item[0])
		apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var status_light = make_gpt_gate(rect_full(0.930, 0.290, 0.965, 0.640), Color(0.78, 0.62, 0.36, 0.24))
	status_light.name = "SettingsOverviewStatusLight"
	art.add_child(status_light)
	var summary = make_label(art, "声音 %d/3    体验 %d/3" % [enabled_audio, enabled_play], 11, Color(0.88, 0.86, 0.68, 0.88), true)
	summary.name = "SettingsOverviewSummary"
	apply_rect(summary, rect_full(0.340, 0.120, 0.890, 0.685))
	summary.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	configure_clipped_label(summary)
	return art


func draw_settings_section_route_art(parent: Control) -> Control:
	# r213: GPT chrome conversion
	var art = Control.new()
	art.name = "SettingsSectionRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.075, 0.165, 0.925, 0.900))
	parent.add_child(art)
	parent.move_child(art, 2)
	var rail = make_gpt_route_rail(rect_full(0.060, 0.060, 0.940, 0.085), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "SettingsSectionRouteRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.240, 0.840, 0.760), Color(0.78, 0.64, 0.36, 0.22))
	fill.name = "SettingsSectionRouteFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.900, 0.010, 0.950, 0.135), Color(0.78, 0.64, 0.36, 0.18))
	gate.name = "SettingsSectionRouteGate"
	art.add_child(gate)
	var branches := [
		["audio", 0.180, 0.205, Color(0.34, 0.58, 0.72)],
		["play", 0.500, 0.515, Color(0.34, 0.62, 0.46)],
		["maint", 0.820, 0.805, Color(0.70, 0.48, 0.34)],
	]
	for item in branches:
		var branch = make_gpt_edge_rail(rect_full(float(item[1]) - 0.006, 0.080, float(item[1]) + 0.006, float(item[2])), item[3])
		branch.name = "SettingsSectionRouteBranch_%s" % str(item[0])
		art.add_child(branch)
		var source = make_gpt_plate_rect(rect_full(float(item[1]) - 0.020, 0.045, float(item[1]) + 0.020, 0.115), item[3], "ui_jade_reading_plate")
		source.name = "SettingsSectionRouteSource_%s" % str(item[0])
		art.add_child(source)
		var node = make_gpt_gate(rect_full(float(item[1]) - 0.026, float(item[2]) - 0.025, float(item[1]) + 0.026, float(item[2]) + 0.025), item[3])
		node.name = "SettingsSectionRouteNode_%s" % str(item[0])
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.280, 0.020, (0.295) + float(3) * (0.120), 0.125), Color(0.78, 0.64, 0.36, 0.20), "SettingsSectionRouteTick_0")
	return art


func draw_settings_section_signal(parent: Control, title_text: String) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingsSectionSignal_%s" % title_text
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.585, 0.035, 0.965, 0.155))
	parent.add_child(art)
	var accent = settings_section_color(title_text)
	# Keep generated signal chrome below the native section icon so any baked
	# circles/slots cannot read as real controls.
	var signal_panel_key := "settings_section_signal_panel"
	var signal_panel = add_optional_gpt_illustration_texture(art, signal_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.025, false)
	if signal_panel != null:
		signal_panel.name = "SettingsSectionSignalPanelTexture_%s" % title_text
		art.move_child(signal_panel, 0)
	var icon = make_gpt_edge_rail(rect_full(0.000, 0.155, 0.115, 0.845), Color(accent.r, accent.g, accent.b, 0.22))
	icon.name = "SettingsSectionSignalIcon_%s" % title_text
	art.add_child(icon)
	var icon_name = settings_section_icon(title_text)
	if icon_name != "":
		add_lucide_icon(icon, icon_name, rect_full(0.22, 0.22, 0.78, 0.78), Color(0.96, 0.90, 0.64, 0.82))
	return art


func draw_shop_buy_button_art(button: Control, cost: int, affordable: bool) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "ShopBuyButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var accent = Color(0.62, 0.52, 0.86) if affordable else Color(0.74, 0.44, 0.38)
	var depth_edge = make_gpt_plate_rect(rect_full(0.045, 0.590, 0.955, 0.930), Color(0.010, 0.010, 0.014, 0.54), "ui_button_face_plate")
	depth_edge.name = "ShopBuyButton3DDepthEdge"
	art.add_child(depth_edge)
	var button_badge = make_gpt_gate(rect_full(0.060, 0.145, 0.940, 0.855), Color(accent.r, accent.g, accent.b, 0.16 if affordable else 0.10))
	button_badge.name = "ShopBuyButtonCleanPlate"
	art.add_child(button_badge)
	var side_bevel = make_gpt_edge_rail(rect_full(0.885, 0.205, 0.955, 0.805), Color(accent.r, accent.g, accent.b, 0.13))
	side_bevel.name = "ShopBuyButton3DSideBevel"
	art.add_child(side_bevel)
	var top_sheen = make_gpt_route_rail(rect_full(0.110, 0.185, 0.840, 0.285), Color(1.0, 0.90, 0.58, 0.050 if affordable else 0.026))
	top_sheen.name = "ShopBuyButtonTopSheen"
	art.add_child(top_sheen)
	if button is Button:
		var clean_buy_button := button as Button
		clean_buy_button.button_down.connect(func() -> void:
			play_shop_buy_button_feedback(clean_buy_button, affordable)
		)
	return art


func draw_shop_currency_meter_art(parent: Control, kind: String, amount: int, accent: Color) -> Control:
	var art = Control.new()
	art.name = "ShopCurrencyMeterArt_%s" % kind
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var target = 5000 if kind == "coins" else 100
	var fill_ratio := 0.0 if amount <= 0 else clampf(float(amount) / float(target), 0.0, 1.0)
	# r202: dedicated GPT route/fill plates (no make_panel StyleBox hosts for meter chrome)
	var rail = make_gpt_route_rail(rect_full(0.040, 0.760, 0.950, 0.900), Color(0.006, 0.018, 0.020, 0.26))  # r216 quieter under GPT plate
	rail.name = "ShopCurrencyRail_%s" % kind
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.42))
	fill.name = "ShopCurrencyFill_%s" % kind
	rail.add_child(fill)
	var flow_rail = make_gpt_route_rail(rect_full(0.285, 0.575, 0.860, 0.665), Color(0.006, 0.018, 0.020, 0.22))  # r216 quieter under GPT plate
	flow_rail.name = "ShopCurrencyFlowRail_%s" % kind
	art.add_child(flow_rail)
	var flow_fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	flow_fill.name = "ShopCurrencyFlowFill_%s" % kind
	flow_rail.add_child(flow_fill)
	# The generated meter panel stays behind native value/progress layers. This
	# prevents baked coin/control details from competing with the real currency UI.
	var meter_panel_key := "shop_currency_meter_panel"
	var meter_panel = add_optional_gpt_illustration_texture(art, meter_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.12, false)  # r198: denser GPT plate more visible (smoke <=0.12)
	if meter_panel != null:
		meter_panel.name = "ShopCurrencyMeterPanelTexture_%s" % kind
		art.move_child(meter_panel, 0)
	if fill_ratio <= 0.20:
		var low_route = make_gpt_route_rail(rect_full(0.560, 0.315, 0.940, 0.390), Color(0.006, 0.016, 0.018, 0.44))
		low_route.name = "ShopCurrencyLowRoute_%s" % kind
		art.add_child(low_route)
		var low_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.540, 0.750), Color(0.92, 0.56, 0.34, 0.28))
		low_fill.name = "ShopCurrencyLowFill_%s" % kind
		low_route.add_child(low_fill)
		var low_gate = make_gpt_gate(rect_full(0.900, 0.245, 0.940, 0.495), Color(0.96, 0.76, 0.38, 0.26))
		low_gate.name = "ShopCurrencyLowGate_%s" % kind
		art.add_child(low_gate)
		for i in range(3):
			var low_left = 0.625 + float(i) * 0.062
			var low_tick = make_gpt_tick_strip(rect_full(low_left, 0.235, low_left + 0.018, 0.390), Color(0.92, 0.56, 0.34, 0.24 - float(i) * 0.040))
			low_tick.name = "ShopCurrencyLowTick_%s_%d" % [kind, i]
			art.add_child(low_tick)
	if amount <= 0:
		var empty = make_gpt_gate(rect_full(0.775, 0.180, 0.955, 0.650), Color(0.92, 0.40, 0.30, 0.28))
		empty.name = "ShopCurrencyEmptyWarning_%s" % kind
		art.add_child(empty)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.46, 0.70).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.92, 0.70).from(0.46)
		var flow_tw := create_screen_tween()
		flow_tw.set_loops(12)
		flow_tw.tween_property(flow_fill, "modulate:a", 0.38, 0.70).from(0.88)
		flow_tw.tween_property(flow_fill, "modulate:a", 0.88, 0.70).from(0.38)
	return art

func draw_shop_item_count_badge_art(parent: Control, item_color: Color, count: int) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "ShopItemCountBadgeArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	parent.move_child(art, 0)
	var count_badge_bg = make_gpt_gate(rect_full(0.030, 0.145, 0.970, 0.855), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.06))
	art.add_child(count_badge_bg)
	var rail = make_gpt_route_rail(rect_full(0.085, 0.740, 0.915, 0.830), Color(0.006, 0.016, 0.018, 0.40))
	rail.name = "ShopItemCountRail"
	art.add_child(rail)
	var fill_ratio := 0.0 if count <= 0 else clampf(float(count) / 4.0, 0.0, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_ratio, 0.740), Color(item_color.r, item_color.g, item_color.b, 0.28 if count > 0 else 0.14))
	fill.name = "ShopItemCountFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.810, 0.220, 0.865, 0.440), Color(item_color.r, item_color.g, item_color.b, 0.24 if count > 0 else 0.12))
	gate.name = "ShopItemCountGate"
	art.add_child(gate)
	for i in range(3):
		var left = 0.160 + float(i) * 0.150
		var lit = count > i
		var pip = make_gpt_tick_strip(rect_full(left, 0.255, left + 0.040, 0.440), Color(item_color.r, item_color.g, item_color.b, 0.26 if lit else 0.10))
		pip.name = "ShopItemCountPip_%d" % i
		art.add_child(pip)
	return art


func draw_shop_item_row_art(row: Control, item_color: Color, count: int, item_id: String = "") -> void:
	# The center crop of the authored dark-scrim bitmap is deliberately quiet:
	# product copy remains continuous while the dedicated shop art survives only
	# as a very faint edge texture.
	var readability_plate = make_gpt_center_crop_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.022, 0.034, 0.032, 0.58), "ui_dark_scrim", 0.22)
	readability_plate.name = "ShopItemRowLowFrequencyPlate"
	row.add_child(readability_plate)
	row.move_child(readability_plate, 0)
	var shop_row_plate = add_optional_gpt_illustration_texture(row, "ui_shop_row_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.040, false)
	if shop_row_plate != null:
		shop_row_plate.name = "ShopItemRowGptPlate"
		shop_row_plate.modulate = Color(1.0, 0.96, 0.90, 0.040)
		row.move_child(shop_row_plate, min(1, row.get_child_count() - 1))
	var shop_row_meter = add_optional_gpt_illustration_texture(row, "ui_meter_rail_plate", rect_full(0.08, 0.72, 0.92, 0.90), 0.22, false)
	if shop_row_meter != null:
		shop_row_meter.name = "ShopItemRowGptMeter"
	# r204 GPT row chrome
	var row_depth = make_gpt_plate_rect(rect_full(0.008, 0.180, 0.992, 0.985), Color(0.86, 0.72, 0.48, 0.07), "settings_overview_panel")
	row_depth.name = "ShopItem3DDepthEdge_%s" % (item_id if item_id != "" else "generic")
	row.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.085), Color(1.0, 0.88, 0.54, 0.075))
	row_top_rim.name = "ShopItem3DTopRim_%s" % (item_id if item_id != "" else "generic")
	row.add_child(row_top_rim)
	var charm_plinth = make_gpt_plate_rect(rect_full(0.018, 0.105, 0.145, 0.920), Color(0.82, 0.62, 0.30, 0.28), "ui_hand_tray_state_chip")
	charm_plinth.name = "ShopItem3DCharmPlinth_%s" % (item_id if item_id != "" else "generic")
	row.add_child(charm_plinth)
	var item_texture = add_illustration_texture(row, "shop_item_shelf", rect_full(0.010, 0.030, 0.790, 0.970), 0.035, false)
	if item_texture != null:
		item_texture.name = "ShopItemShelfTexture_%s" % (item_id if item_id != "" else "generic")
		row.move_child(item_texture, 0)
	# The charm is optional authored artwork. When it is unavailable, keep the
	# small Lucide function icon in the caller and do not synthesize a replacement.
	var charm_key = shop_charm_gpt_key(item_id)
	var charm_texture = add_optional_gpt_illustration_texture(row, charm_key, rect_full(0.016, 0.030, 0.136, 0.970), 0.52, true)
	if charm_texture != null:
		charm_texture.name = "ShopItemCharmTexture_%s" % (item_id if item_id != "" else "generic")
		row.move_child(charm_texture, min(1, row.get_child_count() - 1))
	var shelf = make_gpt_route_rail(rect_full(0.110, 0.820, 0.775, 0.885), Color(item_color.r, item_color.g, item_color.b, 0.18))
	shelf.name = "ShopItemShelfRail"
	row.add_child(shelf)
	var route = make_gpt_route_rail(rect_full(0.615, 0.365, 0.780, 0.455), Color(item_color.r, item_color.g, item_color.b, 0.12))
	route.name = "ShopItemRouteRail"
	row.add_child(route)
	var value_route = add_optional_gpt_illustration_texture(row, "ui_progress_signal_strip", rect_full(0.120, 0.530, 0.790, 0.620), 0.28, false)
	if value_route == null:
		# Preserve the child layout when an imported artifact is unavailable;
		# this host is invisible and never substitutes program-painted chrome.
		value_route = make_layout_host(rect_full(0.120, 0.530, 0.790, 0.620))
		row.add_child(value_route)
	value_route.name = "ShopItemValueRoute"
	var value_ratio := 0.0 if count <= 0 else clampf(float(count) / 4.0, 0.0, 1.0)
	var value_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.880 * value_ratio, 0.740), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	value_fill.name = "ShopItemValueFill"
	value_route.add_child(value_fill)
	var value_gate = make_gpt_gate(rect_full(0.770, 0.505, 0.805, 0.640), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	value_gate.name = "ShopItemValueGate"
	row.add_child(value_gate)
	var energy = make_gpt_route_rail(rect_full(0.120, 0.060, 0.535, 0.105), Color(item_color.r, item_color.g, item_color.b, 0.14))
	energy.name = "ShopItemEnergyRail"
	row.add_child(energy)
	var fill_right := 0.120 + 0.415 * (0.0 if count <= 0 else clampf(float(count) / 3.0, 0.0, 1.0))
	var fill = make_gpt_meter_fill(rect_full(0.120, 0.068, fill_right, 0.097), Color(item_color.r, item_color.g, item_color.b, 0.20 if count > 0 else 0.09))
	fill.name = "ShopItemEnergyFill"
	row.add_child(fill)
	var mark = make_gpt_gate(rect_full(0.772, 0.190, 0.812, 0.810), Color(item_color.r, item_color.g, item_color.b, 0.28))
	mark.name = "ShopItemTypeMark_%s" % (item_id if item_id != "" else "generic")
	row.add_child(mark)
	var mark_label = make_label(mark, item_short_mark(item_id), 13, Color(1.0, 0.96, 0.82, 1.0), true)
	mark_label.name = "ShopItemTypeGlyph"
	apply_rect(mark_label, rect_full(0.0, 0.0, 1.0, 1.0))
	mark_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	mark_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	mark_label.add_theme_color_override("font_outline_color", Color(0.05, 0.03, 0.01, 0.90))
	mark_label.add_theme_constant_override("outline_size", 4)
	var stock = Control.new()
	stock.name = "ShopItemStockPips"
	stock.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(stock, rect_full(0.620, 0.075, 0.760, 0.180))
	row.add_child(stock)
	var pip_count = min(4, max(0, count))
	for i in range(pip_count):
		var left = 0.02 + float(i) * 0.235
		var alpha = 0.58 if count > 0 else 0.16
		var pip = make_gpt_gate(rect_full(left, 0.18, left + 0.145, 0.82), Color(item_color.r, item_color.g, item_color.b, alpha))
		pip.name = "ShopItemStockPip_%d" % i
		stock.add_child(pip)
	stock.set_meta("stock_count", maxi(0, count))
	stock.set_meta("empty_state", count <= 0)
	stock.set_meta("stock_display_text", "缺货" if count <= 0 else ("库存 %d+" % count if count > 4 else "库存 %d" % count))
	stock.set_meta("numeric_stock_required", true)
	mark_ui_optimization(stock, "F-087")
	var stock_label := make_label(row, str(stock.get_meta("stock_display_text", "")), 8, Color(0.96, 0.88, 0.64), true)
	stock_label.name = "ShopItemStockText"
	apply_rect(stock_label, rect_full(0.620, 0.075, 0.760, 0.180))
	stock_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	stock_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	set_ui_full_text(stock_label, stock_label.text, "商品库存")
	mark_ui_optimization(stock_label, "F-087")
	for i in range(3):
		var left = 0.630 + float(i) * 0.050
		var lit = count > i
		var node = make_gpt_tick_strip(rect_full(left, 0.300, left + 0.024, 0.520), Color(item_color.r, item_color.g, item_color.b, 0.18 if lit else 0.07))
		node.name = "ShopItemRouteNode_%d" % i
		row.add_child(node)
	for i in range(2):
		var value_tick_left = 0.600 + float(i) * 0.058
		var value_tick = make_gpt_tick_strip(rect_full(value_tick_left, 0.493, value_tick_left + 0.016, 0.640), Color(item_color.r, item_color.g, item_color.b, 0.10 - float(i) * 0.025 if count > 0 else 0.045))
		value_tick.name = "ShopItemValueTick_0"
		row.add_child(value_tick)
	var arrow = make_gpt_ribbon(rect_full(0.742, 0.402, 0.776, 0.418), Color(item_color.r, item_color.g, item_color.b, 0.12))
	arrow.name = "ShopItemRouteArrow"
	row.add_child(arrow)
	var settlement_rail = make_gpt_route_rail(rect_full(0.340, 0.670, 0.790, 0.705), Color(0.010, 0.020, 0.022, 0.16))
	settlement_rail.name = "ShopItemSettlementRail"
	row.add_child(settlement_rail)
	var settlement_fill_right = 0.340 + 0.450 * clamp(float(count + 1) / 4.0, 0.18, 1.0)
	var settlement_fill = make_gpt_meter_fill(rect_full(0.340, 0.676, settlement_fill_right, 0.699), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.05))
	settlement_fill.name = "ShopItemSettlementFill"
	row.add_child(settlement_fill)
	var settlement_gate = make_gpt_gate(rect_full(0.775, 0.632, 0.810, 0.742), Color(item_color.r, item_color.g, item_color.b, 0.10 if count > 0 else 0.055))
	settlement_gate.name = "ShopItemSettlementGate"
	row.add_child(settlement_gate)
	for i in range(3):
		var tick_left = 0.430 + float(i) * 0.096
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.640, tick_left + 0.018, 0.728), Color(item_color.r, item_color.g, item_color.b, 0.095 - float(i) * 0.020 if count > 0 else 0.04))
		tick.name = "ShopItemSettlementTick_0"
		row.add_child(tick)
	var price_aura = make_gpt_plate_rect(rect_full(0.802, 0.120, 0.970, 0.880), Color(0.72, 0.62, 0.88, 0.10), "ui_button_face_plate")
	price_aura.name = "ShopItemPriceAura"
	row.add_child(price_aura)
	for i in range(2):
		var shine = make_gpt_tick_strip(rect_full(0.812 + float(i) * 0.030, 0.185, 0.832 + float(i) * 0.030, 0.315), Color(0.82, 0.70, 0.96, 0.14))
		shine.name = "ShopItemPriceSpark_%d" % i
		row.add_child(shine)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(price_aura, "modulate:a", 0.08, 0.90).from(0.20)
		tw.tween_property(price_aura, "modulate:a", 0.20, 0.90).from(0.08)
		if charm_texture != null:
			var charm_tw := create_screen_tween()
			charm_tw.set_loops(48)
			charm_tw.tween_property(charm_texture, "rotation", 0.035, 1.15).from(-0.025)
			charm_tw.parallel().tween_property(charm_texture, "modulate:a", 0.34, 1.15).from(0.18)
			charm_tw.tween_property(charm_texture, "rotation", -0.025, 1.15).from(0.035)
			charm_tw.parallel().tween_property(charm_texture, "modulate:a", 0.18, 1.15).from(0.34)

func shop_charm_gpt_key(item_id: String) -> String:
	match item_id:
		"swap_card":
			return "shop_charm_huan"
		"peek_card":
			return "shop_charm_kan"
		"lucky_charm":
			return "shop_charm_yun"
		"double_coins":
			return "shop_charm_bei"
	return "shop_charm_huan"

func draw_shop_purchase_inventory_commit_art(parent: Control, item_color: Color) -> Control:
	# r211: GPT chrome conversion
	var commit = Control.new()
	commit.name = "ShopPurchaseInventoryCommitArt"
