func draw_online_feedback_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	if online_feedback.strip_edges() == "" and not online_waiting_for_server:
		return null
	var accent = online_feedback_accent()
	var art = make_gpt_route_rail(rect_full(0.505, 0.886, 0.965, 0.946), Color(0.012, 0.030, 0.034, 0.31))
	art.name = "OnlineFeedbackArt"
	parent.add_child(art)
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var online_feedback_gpt_key := "online_feedback_gpt_strip"
	var online_feedback_gpt_texture = add_optional_gpt_illustration_texture(art, online_feedback_gpt_key, rect_full(-0.020, -0.300, 1.020, 1.300), 0.56, false)
	if online_feedback_gpt_texture != null:
		online_feedback_gpt_texture.name = "OnlineFeedbackGPTStripTexture"
		art.move_child(online_feedback_gpt_texture, 0)
	var seal = make_gpt_gate(rect_full(0.030, 0.235, 0.082, 0.765), Color(accent.r, accent.g, accent.b, 0.18))
	seal.name = "OnlineFeedbackStatusSeal"
	art.add_child(seal)
	var icon_name = online_feedback_icon_name()
	var status_icon = add_lucide_icon(seal, icon_name, rect_full(0.220, 0.220, 0.780, 0.780), Color(0.96, 0.94, 0.78, 0.90))
	if status_icon != null:
		status_icon.name = "OnlineFeedbackStatusGlyph"
	else:
		var fallback = make_label(seal, online_feedback_fallback_glyph(), 10, Color(0.96, 0.94, 0.78, 0.90), true)
		fallback.name = "OnlineFeedbackStatusGlyph"
		apply_rect(fallback, rect_full(0.0, 0.0, 1.0, 1.0))
	var feedback_message = online_feedback.strip_edges()
	if feedback_message == "":
		feedback_message = "等待服务器确认"
	var text_backplate = make_gpt_plate_rect(rect_full(0.118, 0.140, 0.795, 0.860), Color(0.006, 0.018, 0.020, 0.46), "ui_jade_reading_plate")
	text_backplate.name = "OnlineFeedbackTextBackplate"
	art.add_child(text_backplate)
	var feedback_label = make_label(art, feedback_message, 12, Color(0.90, 0.96, 0.86), true)
	feedback_label.name = "OnlineFeedbackText"
	apply_rect(feedback_label, rect_full(0.145, 0.210, 0.765, 0.790))
	feedback_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(feedback_label)
	return art


