	var gate = make_gpt_gate(rect_full(0.890, 0.235, 0.985, 0.800), Color(0.42, 0.72, 0.66, 0.18))
	gate.name = "MenuFooterEconomyStatsGate"
	bridge.add_child(gate)
	for i in range(3):
		var left = 0.270 + float(i) * 0.155
		var node = make_gpt_gate(rect_full(left, 0.300, left + 0.052, 0.720), Color(0.64, 0.78, 0.54, 0.20 - float(i) * 0.030))
