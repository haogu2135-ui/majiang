func action_button_width_for_available(count: int, available_width: float, separation: int = -1) -> float:
	if count <= 0:
		return ACTION_BUTTON_MAX_WIDTH
	var gap = action_button_separation_for_count(count) if separation < 0 else separation
	var layout_slack = 2.0
	var available = available_width - float(max(0, count - 1) * gap) - layout_slack
	var width: float = minf(float(ACTION_BUTTON_MAX_WIDTH), floorf(maxf(1.0, available / float(count))))
	if mode == "offline" and offline_phase == "pending_claim":
		# At compact height, 60px targets produce a stable 5+2 grouping in the
		# widened lane. Larger viewports retain the existing one-row behavior.
		var pending_min_width := 60.0 if effective_viewport_size().y <= 560.0 else float(PENDING_CLAIM_BUTTON_MIN_WIDTH)
		return maxf(pending_min_width, width)
	return width

func action_button_width_for_count(count: int, separation: int = -1) -> float:
	return action_button_width_for_available(count, action_bar_pixel_width(), separation)

func action_buttons_fit_available(count: int, available_width: float) -> bool:
	var separation = action_button_separation_for_count(count)
	var width = action_button_width_for_available(count, available_width, separation)
	var required = float(count) * width + float(max(0, count - 1) * separation)
	return required <= available_width + 0.5

func action_buttons_fit_width(count: int) -> bool:
	return action_buttons_fit_available(count, action_bar_pixel_width())

func discard_grid_fits_zone(zone_rect: Rect2, columns: int, rows: int, tile_size: Vector2) -> bool:
	return discard_grid_fits_zone_for_table_size(zone_rect, columns, rows, tile_size, game_table_pixel_size())

func discard_grid_fits_zone_for_table_size(zone_rect: Rect2, columns: int, rows: int, tile_size: Vector2, table_size: Vector2) -> bool:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var required_width = float(columns) * tile_size.x + float(max(0, columns - 1) * DISCARD_GRID_SEPARATION)
	var required_height = float(rows) * tile_size.y + float(max(0, rows - 1) * DISCARD_GRID_SEPARATION)
	return required_width <= zone_size.x + 0.5 and required_height <= zone_size.y + 0.5

func discard_ripple_rect_for_seat(seat: int) -> Rect2:
	var base_rect = root_layer_rect_to_screen_rect(CENTER_PANEL_RECT)
	for zone in DISCARD_ZONES:
		if int(zone[0]) == seat:
			var screen_rect = root_layer_rect_to_screen_rect(zone[1])
			var zone_size = screen_rect.size - screen_rect.position
			var center = (screen_rect.position + screen_rect.size) * 0.5
			var size = Vector2(
				clamp(zone_size.x * 0.46, 0.08, 0.18),
				clamp(zone_size.y * 0.70, 0.08, 0.18)
			)
			return Rect2(center - size * 0.5, center + size * 0.5)
	return base_rect

func discard_zone_pixel_size(zone_rect: Rect2) -> Vector2:
	return discard_zone_pixel_size_for_table_size(zone_rect, game_table_pixel_size())

func discard_zone_pixel_size_for_table_size(zone_rect: Rect2, table_size: Vector2) -> Vector2:
	return Vector2((zone_rect.size.x - zone_rect.position.x) * table_size.x, (zone_rect.size.y - zone_rect.position.y) * table_size.y)

func discard_zone_tile_size(zone_rect: Rect2, columns: int, rows: int) -> Vector2:
	return discard_zone_tile_size_for_table_size(zone_rect, columns, rows, game_table_pixel_size())

func discard_zone_tile_size_for_table_size(zone_rect: Rect2, columns: int, rows: int, table_size: Vector2) -> Vector2:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var safe_columns = max(1, columns)
	var safe_rows = max(1, rows)
	var available_width = max(1.0, (zone_size.x - float(DISCARD_GRID_SEPARATION * (safe_columns - 1))) / float(safe_columns))
	var available_height = max(1.0, (zone_size.y - float(DISCARD_GRID_SEPARATION * (safe_rows - 1))) / float(safe_rows))
	# r452: all rivers fill grid cells for porcelain density (closes felt gutters).
	# Mild classic-aspect clamp so faces do not go ultra-landscape.
	var width = min(DISCARD_TILE_MAX_SIZE.x, available_width)
	var height = min(DISCARD_TILE_MAX_SIZE.y, available_height)
	var min_aspect = DISCARD_TILE_ASPECT * 0.82
	var max_aspect = DISCARD_TILE_ASPECT * 1.18
	if height > 0.0 and width / height < 1.0 / max_aspect:
		width = min(available_width, height / min_aspect)
	if width > 0.0 and height / width > max_aspect:
		height = min(available_height, width * max_aspect)
	return Vector2(max(1.0, floor(width)), max(1.0, floor(height)))

func discard_zone_visible_rows(zone_rect: Rect2, columns: int) -> int:
	return discard_zone_visible_rows_for_table_size(zone_rect, columns, game_table_pixel_size())

func discard_zone_visible_rows_for_table_size(zone_rect: Rect2, columns: int, table_size: Vector2) -> int:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var max_rows = int(floor((zone_size.y + float(DISCARD_GRID_SEPARATION)) / (DISCARD_TILE_MIN_SIZE.y + float(DISCARD_GRID_SEPARATION))))
	# r500: bottom/top (8-col) prefer 2 rows; compact side rivers use 3 columns
	# so authored faces and the latest-discard marker stay readable at 960px.
	var row_cap := 2 if columns >= 8 else 4
	return clamp(max_rows, 1, row_cap)

func achievement_medal_gpt_key(key: String, unlocked: bool) -> String:
	if not unlocked:
		return "achievement_medal_bronze"
	match key:
		"thirteen_orphans", "big_three_dragons", "small_three_dragons", "big_four_winds", "small_four_winds", "all_honors", "seven_pairs", "all_triplets", "ten_wins":
			return "achievement_medal_gold"
		_:
			return "achievement_medal_jade"

func draw_achievement_row_art(parent: Control, key: String, index: int, unlocked: bool, accent: Color) -> Control:
	# r208: GPT chrome conversion
	var art = Control.new()
	art.name = "AchievementRowArt_%s" % key
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var row_depth = make_gpt_plate_rect(rect_full(0.008, 0.185, 0.992, 0.985), Color(0.0, 0.0, 0.0, 0.06), "ui_button_face_plate")
	row_depth.name = "AchievementRow3DDepthEdge_%s" % key
	art.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.080), Color(1.0, 0.92, 0.62, 0.070 if unlocked else 0.040))
	row_top_rim.name = "AchievementRow3DTopRim_%s" % key
	art.add_child(row_top_rim)
	var medal_pedestal = make_gpt_gate(rect_full(0.010, 0.110, 0.112, 0.915), Color(accent.r * 0.18, accent.g * 0.20, accent.b * 0.20, 0.68))
	medal_pedestal.name = "AchievementRow3DMedalPedestal_%s" % key
	art.add_child(medal_pedestal)
	var medal = make_gpt_gate(rect_full(0.018, 0.145, 0.100, 0.855), Color(accent.r, accent.g, accent.b, 0.10 if unlocked else 0.08))
	medal.name = "AchievementRowMedal_%s" % key
	art.add_child(medal)
	var medal_core = make_gpt_gate(rect_full(0.255, 0.245, 0.745, 0.755), Color(0.96, 0.82, 0.42, 0.08 if unlocked else 0.05))
	medal_core.name = "AchievementRowMedalCore"
	medal.add_child(medal_core)
	var medal_tex = add_optional_gpt_illustration_texture(medal, achievement_medal_gpt_key(key, unlocked), rect_full(-0.12, -0.08, 1.12, 1.12), 0.92 if unlocked else 0.58, true)
	if medal_tex != null:
		medal_tex.name = "AchievementRowMedalTexture_%s" % key
		if not unlocked:
			medal_tex.modulate = Color(0.72, 0.78, 0.76, 0.58)
		medal.move_child(medal_tex, 0)
	var progress = 1.0 if unlocked else 0.08
	var progress_rail = make_gpt_route_rail(rect_full(0.305, 0.725, 0.660, 0.835), Color(0.006, 0.016, 0.018, 0.62))
	progress_rail.name = "AchievementRowProgressRail"
	art.add_child(progress_rail)
	var progress_fill = make_gpt_meter_fill(rect_full(0.020, 0.220, 0.020 + 0.940 * progress, 0.780), Color(accent.r, accent.g, accent.b, 0.42 if unlocked else 0.20))
	progress_fill.name = "AchievementRowProgressFill"
	progress_rail.add_child(progress_fill)
	var progress_gate = make_gpt_gate(rect_full(clamp(0.020 + 0.940 * progress - 0.014, 0.020, 0.936), 0.110, clamp(0.020 + 0.940 * progress + 0.014, 0.052, 0.970), 0.890), Color(0.96, 0.84, 0.42, 0.42 if unlocked else 0.24))
	progress_gate.name = "AchievementRowProgressGate"
	progress_rail.add_child(progress_gate)
	var badge = make_gpt_gate(rect_full(0.700, 0.220, 0.952, 0.780), Color(accent.r, accent.g, accent.b, 0.28 if unlocked else 0.24))
	badge.name = "AchievementRowSeal_%s" % key
	art.add_child(badge)
	var glyph = make_label(badge, achievement_badge_title(key), 12, Color(0.98, 0.92, 0.70, 0.92) if unlocked else Color(0.86, 0.94, 0.90, 0.94), true)
	glyph.name = "AchievementRowGlyph"
	apply_rect(glyph, rect_full(0.055, 0.120, 0.500, 0.880))
	configure_clipped_label(glyph)
	var icon = make_label(badge, "·", 12, Color(0.98, 0.88, 0.56, 0.86) if unlocked else Color(0.90, 0.98, 0.94, 0.94), true)
	apply_rect(icon, rect_full(0.505, 0.160, 0.575, 0.840))
	if icon != null:
		icon.name = "AchievementRowStatusIcon_%s" % key
	if unlocked:
		var shine = make_gpt_edge_rail(rect_full(0.030, 0.170, 0.102, 0.830), Color(0.96, 0.82, 0.42, 0.14))
		shine.name = "AchievementRowUnlockedShine_%s" % key
		art.add_child(shine)
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var stamp_tw := create_screen_tween()
			stamp_tw.set_parallel(true)
			stamp_tw.tween_property(shine, "modulate:a", 0.90, 0.12).from(0.0)
			stamp_tw.tween_property(shine, "scale", Vector2(1.0, 1.0), 0.22).from(Vector2(1.36, 1.36)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			stamp_tw.tween_property(medal, "scale", Vector2(1.0, 1.0), 0.24).from(Vector2(1.16, 1.16)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	else:
		var lock = make_gpt_edge_rail(rect_full(0.030, 0.170, 0.102, 0.830), Color(0.52, 0.62, 0.60, 0.12))
		lock.name = "AchievementRowLockedRoute_%s" % key
		art.add_child(lock)
	return art


func draw_achievement_toast_art(toast_bg: Control, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var glow_texture = add_illustration_texture(toast_bg, "achievement_medal_glow", rect_full(0.055, 0.010, 0.940, 0.980), 0.16, false)
	if glow_texture != null:
		glow_texture.name = "ToastAchievementGlowTexture"
		toast_bg.move_child(glow_texture, 0)
	var medal = make_gpt_gate(rect_full(0.100, 0.185, 0.142, 0.815), Color(accent.r, accent.g, accent.b, 0.10))
	medal.name = "ToastAchievementMedal"
	toast_bg.add_child(medal)
	var core = make_gpt_plate_rect(rect_full(0.260, 0.250, 0.740, 0.750), Color(0.96, 0.82, 0.36, 0.12), "ui_jade_reading_plate")
	core.name = "ToastAchievementMedalCore"
	medal.add_child(core)
	var toast_medal_tex = add_optional_gpt_illustration_texture(medal, "achievement_medal_gold", rect_full(-0.14, -0.10, 1.14, 1.14), 0.96, true)
	if toast_medal_tex != null:
		toast_medal_tex.name = "ToastAchievementMedalTexture"
		medal.move_child(toast_medal_tex, 0)
	var toast_signal = add_optional_gpt_illustration_texture(toast_bg, "ui_progress_signal_strip", rect_full(0.160, 0.620, 0.920, 0.900), 0.34, false)
	if toast_signal != null:
		toast_signal.name = "ToastAchievementSignalStrip"
	var toast_meter = add_optional_gpt_illustration_texture(toast_bg, "ui_meter_rail_plate", rect_full(0.170, 0.700, 0.700, 0.860), 0.42, false)
	if toast_meter != null:
		toast_meter.name = "ToastAchievementMeterRail"


func draw_achievements_completion_convergence_art(parent: Control) -> Control:
	# r209: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsCompletionConvergenceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.430, 0.118, 0.935, 0.300))
	parent.add_child(art)
	var label = make_label(art, "收集进度 %d%%" % int(round(ratio * 100.0)), 13, Color(0.88, 0.84, 0.64, 0.86), true)
	apply_rect(label, rect_full(0.410, 0.090, 0.940, 0.380))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	return art
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.025, 0.250, 0.090, 0.680), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.08))
	source.name = "AchievementsCompletionSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.420, 0.885, 0.535), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "AchievementsCompletionRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * max(0.08, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.24))
	fill.name = "AchievementsCompletionFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.850, 0.275, 0.930, 0.720), Color(gold.r, gold.g, gold.b, 0.15 + ratio * 0.10))
	gate.name = "AchievementsCompletionGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.720, 0.060, 0.835, 0.340), Color(gold.r, gold.g, gold.b, 0.13 + ratio * 0.08))
	seal.name = "AchievementsCompletionSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "成", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "AchievementsCompletionGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var claim_route = make_gpt_route_rail(rect_full(0.220, 0.680, 0.775, 0.810), Color(0.006, 0.016, 0.018, 0.34))
	claim_route.name = "AchievementsCompletionClaimRoute"
	art.add_child(claim_route)
	var claim_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.720, 0.750), Color(gold.r, gold.g, gold.b, 0.18))
	claim_fill.name = "AchievementsCompletionClaimFill"
	claim_route.add_child(claim_fill)
	var archive_gate = make_gpt_gate(rect_full(0.760, 0.605, 0.835, 0.875), Color(jade.r, jade.g, jade.b, 0.13 + ratio * 0.06))
	archive_gate.name = "AchievementsCompletionArchiveGate"
	art.add_child(archive_gate)
	for i in range(4):
		var left = 0.215 + float(i) * 0.130
		var lit = ratio >= float(i + 1) / 4.0
		var node = make_gpt_gate(rect_full(left, 0.300, left + 0.028, 0.665), Color(gold.r, gold.g, gold.b, 0.22 if lit else 0.09))
		node.name = "AchievementsCompletionNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.560, 0.175, (0.574) + float(2) * (0.058), 0.400), Color(jade.r, jade.g, jade.b, 0.22), "AchievementsCompletionTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.36, 0.70).from(0.90)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.34, 0.70).from(0.84)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.70).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.90, 0.70).from(0.36)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.84, 0.70).from(0.34)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.70).from(0.58)
	return art


func draw_achievements_dashboard_art(parent: Control) -> Control:
	# r211: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = make_gpt_plate_rect(rect_full(0.055, 0.120, 0.945, 0.295), Color(0.250, 0.320, 0.270, 0.95), "ui_button_face_plate")
	art.name = "AchievementsDashboardArt"
	parent.add_child(art)
	var dash_plate = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(0.160, 0.700, 0.900, 0.940), 0.40, false)
	if dash_plate != null:
		dash_plate.name = "AchievementsDashboardSignalStrip"
	var dash_meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.180, 0.760, 0.780, 0.900), 0.55, false)
	if dash_meter != null:
		dash_meter.name = "AchievementsDashboardMeterRail"
	var dashboard_depth = make_gpt_plate_rect(rect_full(0.010, 0.705, 0.990, 0.985), Color(0.0, 0.0, 0.0, 0.18), "ui_button_face_plate")
	dashboard_depth.name = "AchievementsDashboard3DDepthEdge"
	art.add_child(dashboard_depth)
	var dashboard_top_rim = make_gpt_ribbon(rect_full(0.025, 0.020, 0.975, 0.065), Color(1.0, 0.88, 0.52, 0.055))
	dashboard_top_rim.name = "AchievementsDashboard3DTopRim"
	art.add_child(dashboard_top_rim)
	var glow_texture = add_illustration_texture(art, "achievement_medal_glow", rect_full(0.000, -0.170, 0.275, 1.170), 0.18, false)
	if glow_texture != null:
		glow_texture.name = "AchievementsDashboardGlowTexture"
		art.move_child(glow_texture, 0)
	var summary_backplate = make_gpt_plate_rect(rect_full(0.165, 0.105, 0.515, 0.845), Color(0.070, 0.105, 0.090, 0.30), "ui_jade_reading_plate")
	summary_backplate.name = "AchievementsSummaryTextBackplate"
	art.add_child(summary_backplate)
	var summary_label = make_label(art, "已解锁 %d/%d" % [unlocked, total], 18, Color(0.94, 0.88, 0.62), true)
	summary_label.name = "AchievementsProgressLabel"
	apply_rect(summary_label, rect_full(0.190, 0.130, 0.500, 0.430))
	summary_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(summary_label)
	var detail_label = make_label(art, "完成度 %d%%" % int(round(ratio * 100.0)), 15, Color(0.90, 0.94, 0.86), true)
	detail_label.name = "AchievementsProgressDetailLabel"
	apply_rect(detail_label, rect_full(0.190, 0.485, 0.500, 0.735))
	detail_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(detail_label)
	var medal_card = make_gpt_gate(rect_full(0.735, 0.185, 0.900, 0.815), Color(0.42, 0.34, 0.18, 0.10 + ratio * 0.08))
	medal_card.name = "AchievementsMedalNode"
	art.add_child(medal_card)
	var medal_pedestal = make_gpt_gate(rect_full(0.718, 0.160, 0.917, 0.860), Color(0.10, 0.075, 0.035, 0.62))
	medal_pedestal.name = "AchievementsDashboard3DMedalPedestal"
	art.add_child(medal_pedestal)
	art.move_child(medal_pedestal, max(0, medal_card.get_index()))
	var core = make_gpt_plate_rect(rect_full(0.260, 0.225, 0.740, 0.775), Color(0.96, 0.78, 0.32, 0.08 + ratio * 0.08), "ui_jade_reading_plate")
	core.name = "AchievementsMedalCore"
	medal_card.add_child(core)
	var dashboard_medal_key = "achievement_medal_gold" if ratio >= 0.45 else ("achievement_medal_jade" if ratio >= 0.15 else "achievement_medal_bronze")
	var dashboard_medal_tex = add_optional_gpt_illustration_texture(medal_card, dashboard_medal_key, rect_full(-0.08, -0.10, 1.08, 1.12), 0.94, true)
	if dashboard_medal_tex != null:
		dashboard_medal_tex.name = "AchievementsMedalTexture"
		medal_card.move_child(dashboard_medal_tex, 0)
	var medal_glyph = make_label(medal_card, "奖", 24, Color(1.0, 0.92, 0.62, 0.96), true)
	medal_glyph.name = "AchievementsMedalGlyph"
	apply_rect(medal_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	# Progress + unlock rails (GPT plates) for smoke/readability; nodes remain as soft ticks.
	var progress_rail = make_gpt_plate_rect(rect_full(0.180, 0.760, 0.700, 0.900), Color(0.16, 0.14, 0.10, 0.42), "ui_progress_signal_strip")
	progress_rail.name = "AchievementsProgressRail"
	art.add_child(progress_rail)
	var progress_fill = make_gpt_plate_rect(rect_full(0.180, 0.760, 0.180 + 0.520 * max(0.08, ratio), 0.900), Color(0.78, 0.58, 0.28, 0.34), "ui_meter_rail_plate")
	progress_fill.name = "AchievementsProgressFill"
	art.add_child(progress_fill)
	var progress_gate = make_gpt_plate_rect(rect_full(0.685, 0.735, 0.725, 0.925), Color(0.92, 0.76, 0.36, 0.28), "ui_button_face_plate")
	progress_gate.name = "AchievementsProgressGate"
	art.add_child(progress_gate)
	var unlock_route = make_gpt_plate_rect(rect_full(0.180, 0.900, 0.700, 0.955), Color(0.08, 0.12, 0.10, 0.36), "ui_meter_rail_plate")
	unlock_route.name = "AchievementsUnlockRoute"
	art.add_child(unlock_route)
	var unlock_fill = make_gpt_plate_rect(rect_full(0.180, 0.900, 0.180 + 0.520 * max(0.08, ratio), 0.955), Color(0.36, 0.58, 0.46, 0.28), "ui_meter_rail_plate")
	unlock_fill.name = "AchievementsUnlockFill"
	art.add_child(unlock_fill)
	var unlock_source = make_gpt_plate_rect(rect_full(0.150, 0.880, 0.190, 0.980), Color(0.86, 0.66, 0.30, 0.30), "ui_button_face_plate")
	unlock_source.name = "AchievementsUnlockSource"
	art.add_child(unlock_source)
	for i in range(5):
		var left = 0.240 + float(i) * 0.088
		var lit = ratio >= float(i + 1) / 5.0
		var node = make_gpt_plate_rect(rect_full(left, 0.760, left + 0.018, 0.808), Color(0.86, 0.66, 0.28, 0.17 if lit else 0.06), "ui_button_face_plate")
		node.name = "AchievementsProgressNode_%d" % i
		art.add_child(node)
	art.move_child(summary_backplate, max(0, art.get_child_count() - 3))
	art.move_child(summary_label, max(0, art.get_child_count() - 2))
	art.move_child(detail_label, max(0, art.get_child_count() - 1))
	return art


func draw_achievements_gallery_scan_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsGalleryScanArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.055, 0.112, 0.945, 0.318))
	parent.add_child(art)
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.035, 0.210, 0.082, 0.620), Color(gold.r, gold.g, gold.b, 0.18 + ratio * 0.08))
	source.name = "AchievementsGalleryScanSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.385, 0.865, 0.480), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "AchievementsGalleryScanRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * max(0.08, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.26))
	fill.name = "AchievementsGalleryScanFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.845, 0.260, 0.910, 0.620), Color(gold.r, gold.g, gold.b, 0.18 + ratio * 0.10))
	gate.name = "AchievementsGalleryScanGate"
	art.add_child(gate)
	var archive = make_gpt_gate(rect_full(0.760, 0.610, 0.890, 0.895), Color(gold.r, gold.g, gold.b, 0.12 + ratio * 0.08))
	archive.name = "AchievementsGalleryArchive"
	art.add_child(archive)
	var archive_glyph = make_label(archive, "藏", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	archive_glyph.name = "AchievementsGalleryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(5):
		var strength = clamp(ratio + float(i) * 0.035, 0.08, 1.0)
		var left = 0.175 + float(i) * 0.125
		var node = make_gpt_gate(rect_full(left, 0.260, left + 0.030, 0.625), Color(gold.r, gold.g, gold.b, 0.10 + strength * 0.16))
		node.name = "AchievementsGalleryScanNode_%d" % i
		art.add_child(node)
		var branch = make_gpt_edge_rail(rect_full(left + 0.012, 0.135, left + 0.020, 0.300), Color(jade.r, jade.g, jade.b, 0.08 + strength * 0.10))
		branch.name = "AchievementsGalleryScanBranch_%d" % i
		art.add_child(branch)
	var tick = add_gpt_tick_strip(art, rect_full(0.325, 0.180, (0.325) + float(3) * (0.105) + (0.014), 0.705), Color(jade.r, jade.g, jade.b, 0.23), "AchievementsGalleryScanTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.88
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "anchor_right", 0.975, 0.94).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.47).from(0.92)
		tw.tween_property(fill, "anchor_right", 0.025 + 0.920 * max(0.08, ratio), 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.47).from(0.48)
	return art


func draw_achievements_row_collection_bus_art(parent: Control) -> Control:
	# r208: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsRowCollectionBusArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.055, 0.325, 0.945, 0.935))
	parent.add_child(art)
	parent.move_child(art, max(0, art.get_index() - 1))
	return art
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var spine = make_gpt_edge_rail(rect_full(0.955, 0.030, 0.982, 0.900), Color(0.006, 0.016, 0.018, 0.42))
	spine.name = "AchievementsRowCollectionSpine"
	art.add_child(spine)
	var spine_fill = make_gpt_meter_fill(rect_full(0.250, 0.025, 0.750, 0.120 + 0.760 * max(0.06, ratio)), Color(gold.r, gold.g, gold.b, 0.24))
	spine_fill.name = "AchievementsRowCollectionSpineFill"
	spine.add_child(spine_fill)
	var source = make_gpt_gate(rect_full(0.925, 0.010, 0.995, 0.110), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.08))
	source.name = "AchievementsRowCollectionSource"
	art.add_child(source)
	var archive_gate = make_gpt_gate(rect_full(0.905, 0.845, 0.995, 0.960), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.10))
	archive_gate.name = "AchievementsRowCollectionArchiveGate"
	art.add_child(archive_gate)
	var archive_glyph = make_label(archive_gate, "藏", 9, Color(0.98, 0.92, 0.66, 0.86), true)
	archive_glyph.name = "AchievementsRowCollectionArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var row_count = min(8, total)
	for i in range(row_count):
		var top = 0.070 + float(i) * (0.760 / max(1, row_count - 1))
		var lit = i < int(ceil(ratio * float(row_count)))
		var branch = make_gpt_route_rail(rect_full(0.760, top + 0.032, 0.960, top + 0.062), Color(0.006, 0.016, 0.018, 0.34))
		branch.name = "AchievementsRowCollectionBranch_%d" % i
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760 if lit else 0.360, 0.750), Color(gold.r, gold.g, gold.b, 0.20 if lit else 0.10))
		branch_fill.name = "AchievementsRowCollectionBranchFill_%d" % i
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(0.736, top, 0.780, top + 0.095), Color(jade.r, jade.g, jade.b, 0.20 if lit else 0.10))
		node.name = "AchievementsRowCollectionNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.970, 0.175, 0.985, (0.175) + float(3) * (0.150) + (0.060)), Color(gold.r, gold.g, gold.b, 0.22), "AchievementsRowCollectionTick_0")
	var progress_route = make_gpt_route_rail(rect_full(0.520, 0.895, 0.925, 0.945), Color(0.006, 0.016, 0.018, 0.38))
	progress_route.name = "AchievementsRowCollectionProgressRoute"
	art.add_child(progress_route)
	var progress_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.080 + 0.760 * max(0.06, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.22))
	progress_fill.name = "AchievementsRowCollectionProgressFill"
	progress_route.add_child(progress_fill)
	var progress_gate = make_gpt_gate(rect_full(0.500, 0.855, 0.555, 0.985), Color(jade.r, jade.g, jade.b, 0.16 + ratio * 0.08))
	progress_gate.name = "AchievementsRowCollectionProgressGate"
	art.add_child(progress_gate)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.820 + float(i) * 0.040, 0.946, 0.842 + float(i) * 0.040, 0.984), Color(gold.r, gold.g, gold.b, 0.20 - float(i) * 0.040))
		pip.name = "AchievementsRowCollectionArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(spine_fill, "modulate:a", 0.38, 0.82).from(0.86)
		tw.parallel().tween_property(progress_fill, "modulate:a", 0.34, 0.82).from(0.82)
		tw.tween_property(spine_fill, "modulate:a", 0.86, 0.82).from(0.38)
		tw.parallel().tween_property(progress_fill, "modulate:a", 0.82, 0.82).from(0.34)
	return art


func draw_action_button_art(button: Button, text: String, color: Color) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "ActionButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	button.add_child(art)
	var role = action_button_visual_role(text)
	var compact_claim_mode := mode == "offline" and offline_phase == "pending_claim"
	var depth_alpha := 0.62 if compact_claim_mode and role == "pass" else (0.78 if compact_claim_mode else (0.50 if role == "pass" else 0.68))
	var cast_shadow = make_soft_depth_panel(button, rect_full(0.040, 0.120, 0.990, 1.040), Color(0.0, 0.0, 0.0, 0.18 if compact_claim_mode else 0.26), 10)
	cast_shadow.name = "ActionButton3DCastShadow"
	button.move_child(cast_shadow, 0)
	var depth_edge = make_gpt_plate_rect(rect_full(0.028, 0.640, 0.972, 0.975), Color(0.010, 0.012, 0.010, depth_alpha), "ui_button_face_plate")
	depth_edge.name = "ActionButton3DDepthEdge"
	button.add_child(depth_edge)
	button.move_child(depth_edge, min(1, button.get_child_count() - 1))
	var top_rim = make_gpt_ribbon(rect_full(0.050, 0.040, 0.950, 0.155), Color(1.0, 0.94, 0.70, 0.180 if compact_claim_mode else 0.100))
	top_rim.name = "ActionButton3DTopRim"
	button.add_child(top_rim)
	var side_bevel = make_gpt_edge_rail(rect_full(0.020, 0.180, 0.065, 0.820), Color(1.0, 0.92, 0.62, 0.075 if compact_claim_mode else 0.055))
	side_bevel.name = "ActionButton3DSideBevel"
	button.add_child(side_bevel)
	if compact_claim_mode:
		# A restrained authored right/bottom edge keeps 55px claim targets visually
		# separable without widening the wrapped lane or painting a native slab.
		var compact_right_edge = make_gpt_edge_rail(rect_full(0.935, 0.180, 0.980, 0.820), Color(color.r, color.g, color.b, 0.32 if role == "pass" else 0.52))
		compact_right_edge.name = "ActionButtonCompactRightEdge"
		button.add_child(compact_right_edge)
		var compact_bottom_edge = make_gpt_ribbon(rect_full(0.080, 0.875, 0.920, 0.945), Color(color.r, color.g, color.b, 0.24 if role == "pass" else 0.40))
		compact_bottom_edge.name = "ActionButtonCompactBottomEdge"
		button.add_child(compact_bottom_edge)
	apply_rect(art, rect_full(0.036, 0.230, 0.176, 0.770) if compact_claim_mode else rect_full(0.030, 0.120, 0.245, 0.880))
	var is_focus_action = ["win", "gang", "safe", "advice"].has(role) or text.begins_with("荐")
	var seal_alpha = 0.016 if compact_claim_mode and role == "pass" else (0.032 if compact_claim_mode and is_focus_action else (0.024 if compact_claim_mode else (0.070 if role == "pass" else (0.155 if is_focus_action else 0.105))))
	var seal_border_alpha = 0.020 if compact_claim_mode and role == "pass" else (0.038 if compact_claim_mode and is_focus_action else (0.026 if compact_claim_mode else (0.080 if role == "pass" else (0.135 if is_focus_action else 0.090))))
	var simple_seal = make_gpt_gate(rect_full(0.060, 0.165, 0.640, 0.835), Color(color.r, color.g, color.b, seal_alpha))
	simple_seal.name = "ActionButtonSeal"
	art.add_child(simple_seal)
	var simple_mark_alpha = 0.42 if compact_claim_mode and role == "pass" else (0.52 if compact_claim_mode else (0.78 if role == "pass" else 0.86))
	var simple_mark = make_label(simple_seal, action_button_fallback_icon_text(role, text), 8 if compact_claim_mode else 10, Color(0.94, 0.88, 0.70, simple_mark_alpha), true)
	simple_mark.name = "ActionButtonFallbackIcon"
	apply_rect(simple_mark, rect_full(0.0, 0.0, 1.0, 1.0))
	var sheen_alpha = 0.006 if compact_claim_mode and role == "pass" else (0.010 if compact_claim_mode else (0.026 if role == "pass" else 0.040))
	var sheen = make_gpt_route_rail(rect_full(0.060, 0.075, 0.940, 0.155), Color(1.0, 0.96, 0.76, sheen_alpha))
	sheen.name = "ActionButtonSheen"
	button.add_child(sheen)
	var priority_mark = action_button_priority_mark(role)
	if priority_mark != "":
		var priority_alpha = 0.36 if compact_claim_mode else (0.62 if role == "pass" else 0.78)
		var seal = make_label(button, priority_mark, 8 if compact_claim_mode else 10, Color(0.98, 0.90, 0.62, priority_alpha), true)
		seal.name = "ActionButtonPrioritySeal"
		apply_rect(seal, rect_full(0.740, 0.145, 0.940, 0.455))
	var response_alpha = 0.002 if compact_claim_mode and role == "pass" else (0.004 if compact_claim_mode else (0.020 if role == "pass" else 0.050))
	var response_texture = add_illustration_texture(button, "claim_response_orbit", rect_full(-0.030, -0.120, 1.030, 1.120), response_alpha, false)
	if response_texture != null:
		response_texture.name = "ActionButtonResponseTexture_%s" % role
		button.move_child(response_texture, 0)
	var rail_alpha = 0.20 if compact_claim_mode and role == "pass" else (0.28 if compact_claim_mode else (0.42 if role == "pass" else 0.58))
	var role_rail = add_optional_gpt_illustration_texture(button, "ui_action_role_rail", rect_full(0.000, 0.120, 0.034, 0.880), rail_alpha, false)
	if role_rail != null:
		role_rail.name = "ActionButtonRoleRail"
		role_rail.modulate = Color(color.r, color.g, color.b, rail_alpha)
	# Compact claims use the authored action plate as their distinct dark face.
	var panel_alpha = 0.60 if compact_claim_mode and role == "pass" else (0.70 if compact_claim_mode else (0.42 if role == "pass" else 0.70))
	var panel_key := "action_button_panel" if compact_claim_mode else "ui_button_face_plate"
	var panel_plate = add_optional_gpt_illustration_texture(button, panel_key, rect_full(-0.040, -0.040, 1.040, 1.040), panel_alpha, false)
	if panel_plate == null:
		panel_plate = add_optional_gpt_illustration_texture(button, "ui_dark_scrim", rect_full(-0.040, -0.040, 1.040, 1.040), panel_alpha, false)
	if panel_plate != null:
		panel_plate.name = "ActionButtonPanelPlate"
		var compact_panel_tint := Color(
			clampf(0.30 + color.r * 0.28, 0.18, 0.62),
			clampf(0.30 + color.g * 0.28, 0.18, 0.62),
			clampf(0.28 + color.b * 0.24, 0.16, 0.58),
			panel_alpha
		) if compact_claim_mode else Color(
			clampf(0.40 + color.r * 0.60, 0.20, 1.2),
			clampf(0.40 + color.g * 0.60, 0.20, 1.2),
			clampf(0.40 + color.b * 0.60, 0.20, 1.2),
			panel_alpha
		)
		panel_plate.modulate = Color(
			compact_panel_tint.r,
			compact_panel_tint.g,
			compact_panel_tint.b,
			compact_panel_tint.a
		)
		button.move_child(panel_plate, 0)
	if action_button_should_pulse(role):
		var pulse_strength = action_button_pulse_strength(role)
		var pulse_scale = 0.28 if compact_claim_mode else 1.0
		var pulse = make_gpt_tick_strip(rect_full(0.012, 0.090, 0.988, 0.910), Color(color.r, color.g, color.b, (0.050 + 0.020 * pulse_strength) * pulse_scale))
		pulse.name = "ActionButtonPulse"
		button.add_child(pulse)
		button.move_child(pulse, 0)
		if fx_enabled_effective():
			var peak = lerp(0.42, 0.84, pulse_strength)
			var trough = lerp(0.10, 0.25, pulse_strength)
			var pulse_tw := create_screen_tween()
			pulse_tw.set_loops(12)
			pulse_tw.tween_property(pulse, "modulate:a", trough, 0.64).from(peak)
			pulse_tw.tween_property(pulse, "modulate:a", peak, 0.64).from(trough)
	# Button native text is painted by the parent CanvasItem. Keep every authored
	# decorative child behind it so compact claim labels remain crisp in all states.
	for child in button.get_children():
		if child is CanvasItem:
			(child as CanvasItem).show_behind_parent = true
	button.button_down.connect(func() -> void:
		if not is_instance_valid(button):
			return
		var tw := button.create_tween()
		tw.tween_property(button, "scale", Vector2(0.94, 0.94), 0.04).from(button.scale)
		tw.chain().tween_property(button, "scale", Vector2(1.0, 1.0), 0.12).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		play_action_button_press_feedback(button, role, color)
	)
	return art


func draw_action_button_decision_bridge(button: Button, role: String, color: Color) -> Control:
	# 按钮内装饰碎块已替换为可选 action_button_panel 插画底板，此函数保留为空壳以兼容历史调用点。
	return null

func draw_action_button_pass_route(button: Button, color: Color) -> Control:
	# 保留为空壳；过按钮装饰碎块已并入 action_button_panel 插画底板。
	return null

func draw_action_dock(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var count = action_bar_button_count()
	if count <= 0:
		return
	var pending_claim_mode = mode == "offline" and offline_phase == "pending_claim"
	var danger_confirm_mode = mode == "offline" and has_pending_danger_discard()
	var ended_action_mode := (mode == "offline" and offline_phase == "ended") or (mode == "online_game" and str(online_game.get("phase", "")) == "ended")
	if not pending_claim_mode and not danger_confirm_mode and not ended_action_mode:
		draw_action_intent_dock(parent, count)
	# r451c: translucent lacquer shell + GPT dock plate on top (no jade program slabs).
	var dock_rect := action_dock_rect_for_count(count)
	var dock_shadow_rect := Rect2(dock_rect.position + Vector2(0.005, 0.012), dock_rect.size + Vector2(0.006, 0.010))
	var dock_shadow = make_soft_depth_panel(parent, dock_shadow_rect, Color(0.0, 0.0, 0.0, 0.18 if pending_claim_mode else 0.22), 12)
	dock_shadow.name = "ActionDock3DCastShadow"
	var dock = make_gpt_center_crop_plate_rect(dock_rect, Color(0.018, 0.026, 0.024, 0.78), "ui_dark_scrim", 0.20)
	dock.name = "ActionButtonDock"
	parent.add_child(dock)
	dock.clip_contents = true
	var action_buttons = action_bar_buttons()
	var dock_rear = make_soft_depth_panel(dock, rect_full(0.012, 0.040, 0.988, 0.980), Color(0.08, 0.055, 0.035, 0.12), 10)
	dock_rear.name = "ActionDock3DRearShell"
	dock.move_child(dock_rear, 0)
	var dock_floor = make_layout_host(rect_full(0.018, 0.620, 0.982, 0.920))
	dock_floor.name = "ActionDockPhysicalFloor"
	dock.add_child(dock_floor)
	# Gold accent only — thin rim, not mid-band occluder.
	var apron_rim = make_gpt_ribbon(rect_full(0.035, 0.705, 0.965, 0.760), Color(1.0, 0.92, 0.56, 0.22))
	apron_rim.name = "ActionDock3DFrontApron"
	dock.add_child(apron_rim)
	var jade_track = make_layout_host(rect_full(0.050, 0.250, 0.950, 0.330))
	jade_track.name = "ActionDock3DJadeTrack"
	dock.add_child(jade_track)
	var lower_reflection = make_layout_host(rect_full(0.070, 0.900, 0.930, 0.960))
	lower_reflection.name = "ActionDock3DLowerReflection"
	dock.add_child(lower_reflection)
	if pending_claim_mode:
		var pending_dock_texture = add_optional_gpt_illustration_texture(dock, "pending_claim_action_dock", rect_full(0.002, 0.010, 0.998, 0.990), 0.52, false)
		if pending_dock_texture != null:
			pending_dock_texture.name = "PendingClaimActionGPTDockTexture"
			pending_dock_texture.modulate = Color(1.0, 1.0, 1.0, 0.38)
			dock.move_child(pending_dock_texture, dock.get_child_count() - 1)
	else:
		var dock_texture = add_optional_gpt_illustration_texture(dock, "action_gpt_dock", rect_full(0.000, 0.010, 1.000, 0.990), 0.30, false)
		if dock_texture != null:
			dock_texture.name = "ActionGPTDockTexture"
			dock_texture.modulate = Color(1.0, 1.0, 1.0, 0.54)
			dock.move_child(dock_texture, dock.get_child_count() - 1)
		# r452b: GPT title plate + soft flash mid-band (no program jade).
		# r184: light mid-band only — keep action_gpt_dock micro-detail readable.
		var mid_plate = make_gpt_plate_rect(rect_full(0.018, 0.150, 0.982, 0.850), Color(0.98, 0.93, 0.80, 0.07), "ui_title_backplate")  # r189 reveal denser dock
		mid_plate.name = "ActionDockMidBandPlate"
		dock.add_child(mid_plate)
		var mid_wash = make_gpt_plate_rect(rect_full(0.030, 0.180, 0.970, 0.820), Color(1.0, 0.95, 0.80, 0.035), "ui_soft_flash")  # r189 lighter wash
		mid_wash.name = "ActionDockMidBandWash"
		dock.add_child(mid_wash)
		var track_texture = add_optional_gpt_illustration_texture(dock, "action_dock_track_panel", rect_full(0.010, 0.120, 0.990, 0.900), 0.22, false)  # r221 denser track
		if track_texture != null:
			track_texture.name = "ActionDockTrackPanelTexture"
			dock.move_child(track_texture, dock.get_child_count() - 1)
	if not pending_claim_mode and not danger_confirm_mode and not action_buttons.is_empty():
		var first_button := action_buttons[0] as Button
		var label_alpha := 0.54 if pending_claim_mode else 0.76
		var focus_label = make_label(dock, first_button.text, 10, Color(0.92, 0.90, 0.72, label_alpha), true)
		focus_label.name = "ActionDockFocusLabel"
		apply_rect(focus_label, rect_full(0.055, 0.035, 0.425, 0.225))
		focus_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		configure_clipped_label(focus_label)
	parent.move_child(dock_shadow, max(0, action_bar.get_index()))
	parent.move_child(dock, max(0, action_bar.get_index()))


