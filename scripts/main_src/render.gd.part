func draw_score_strip(parent: Control, rect: Rect2) -> void:
	# r214: bulk GPT chrome sweep
	var strip = Control.new()
	strip.name = "ScoreStrip"
	parent.add_child(strip)
	apply_rect(strip, rect)
	for seat in range(4):
		var active = get_current_seat() == seat
		var player = get_player_info(seat)
		var chip_fill = Color(0.008, 0.016, 0.018, 0.82) if active else Color(0.006, 0.014, 0.016, 0.66)
		var chip_border = Color(0.56, 0.46, 0.22, 0.44) if active else Color(0.28, 0.32, 0.30, 0.16)
		var chip = make_gpt_gate(SCORE_STRIP_CHIP_RECTS[seat], chip_fill)
		chip.name = "ScoreStripChip_%d" % seat
		strip.add_child(chip)
		var accent_bar = make_gpt_meter_fill(SCORE_STRIP_ACCENT_RECT, SEAT_ACCENT_COLORS[seat])
		accent_bar.name = "ScoreStripAccent_%d" % seat
		chip.add_child(accent_bar)
		draw_score_strip_chip_art(chip, seat, int(player.get("score", 0)), active)
		var name_text := ""
		if mode == "offline":
			name_text = "我" if seat == 0 else ai_profile_short_label(seat)
		else:
			name_text = str(player.get("name", "玩家")).strip_edges()
		if name_text == "":
			name_text = "我" if seat == 0 else ("位%d" % (seat + 1))
		if name_text.length() > 3:
			name_text = name_text.substr(0, 3)
		var name = make_label(chip, name_text, 10, Color(0.99, 0.97, 0.92), true)
		name.name = "ScoreStripName_%d" % seat
		# r180: transparent label host; GPT chip paints the name badge.
		var empty_name := StyleBoxEmpty.new()
		empty_name.set_content_margin_all(4)
		name.add_theme_stylebox_override("normal", empty_name)
		var name_chip = add_optional_gpt_illustration_texture(name, "ui_hand_tray_state_chip", rect_full(-0.08, -0.10, 1.08, 1.10), 0.70, false)
		if name_chip != null:
			name_chip.name = "SeatNameGptChip_%d" % seat
			name_chip.modulate = Color(
				clampf(0.35 + SEAT_NAME_BADGE_COLORS[seat].r * 0.65, 0.20, 1.2),
				clampf(0.35 + SEAT_NAME_BADGE_COLORS[seat].g * 0.65, 0.20, 1.2),
				clampf(0.35 + SEAT_NAME_BADGE_COLORS[seat].b * 0.65, 0.20, 1.2),
				0.78
			)
			name.move_child(name_chip, 0)
		apply_rect(name, SCORE_STRIP_NAME_RECT)
		configure_clipped_label(name)
		var score = make_label(chip, compact_score_text(int(player.get("score", 0))), 12, Color(0.96, 0.94, 0.88), true)
		score.name = "ScoreStripScore_%d" % seat
		apply_rect(score, SCORE_STRIP_SCORE_RECT)
		score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		configure_clipped_label(score)


func draw_score_strip_chip_art(parent: Control, seat: int, score: int, active: bool) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "ScoreStripChipArt_%d" % seat
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var seal_fill = Color(0.52, 0.18, 0.12, 0.28) if active else Color(0.30, 0.22, 0.14, 0.42)
	var seal = make_gpt_gate(rect_full(0.045, 0.165, 0.170, 0.835), seal_fill)
	seal.name = "ScoreStripSeatSeal_%d" % seat
	art.add_child(seal)
	var wind = make_label(seal, seat_wind_label(seat), 9, Color(0.96, 0.88, 0.62, 0.86), true)
	apply_rect(wind, rect_full(0.0, 0.0, 1.0, 1.0))
	var brush = make_gpt_ribbon(rect_full(0.210, 0.785, 0.915, 0.835), Color(0.78, 0.58, 0.28, 0.16 if active else 0.10))
	brush.name = "ScoreStripBrushLine_%d" % seat
	art.add_child(brush)
	var baseline = MATCH_START_SCORE
	var delta = score - baseline
	var momentum = clamp(abs(float(delta)) / float(max(1, baseline)), 0.08, 1.0)
	var positive = delta >= 0
	var fill_color = Color(0.34, 0.68, 0.48, 0.34) if positive else Color(0.72, 0.36, 0.30, 0.34)
	var rail = make_gpt_route_rail(rect_full(0.205, 0.695, 0.925, 0.785), Color(0.006, 0.014, 0.016, 0.28))
	rail.name = "ScoreStripMomentumRail_%d" % seat
	art.add_child(rail)
	var fill_right = 0.205 + 0.720 * momentum
	var fill = make_gpt_meter_fill(rect_full(0.205, 0.695, fill_right, 0.785), fill_color)
	fill.name = "ScoreStripMomentumFill_%d" % seat
	art.add_child(fill)
	var rank = score_strip_rank_for_score(score)
	var rank_node = make_gpt_gate(rect_full(0.845, 0.180, 0.925, 0.460), Color(accent.r, accent.g, accent.b, 0.13))
	rank_node.name = "ScoreStripRankNode_%d" % seat
	art.add_child(rank_node)
	var rank_label = make_label(rank_node, "%d" % rank, 7, Color(0.98, 0.92, 0.72, 0.76), true)
	rank_label.name = "ScoreStripRankLabel_%d" % seat
	apply_rect(rank_label, rect_full(0.0, 0.0, 1.0, 1.0))
	if rank == 1:
		var crown = make_gpt_edge_rail(rect_full(0.742, 0.205, 0.815, 0.430), Color(0.92, 0.72, 0.34, 0.12))
		crown.name = "ScoreStripLeaderCrown_%d" % seat
		art.add_child(crown)
	if active:
		var active_edge = make_gpt_edge_rail(rect_full(0.012, 0.120, 0.026, 0.880), Color(0.82, 0.58, 0.24, 0.32))
		active_edge.name = "ScoreStripActiveSealEdge_%d" % seat
		art.add_child(active_edge)
		var pulse = make_gpt_tick_strip(rect_full(0.010, 0.060, 0.990, 0.940), Color(accent.r, accent.g, accent.b, 0.050))
		pulse.name = "ScoreStripActivePulse"
		art.add_child(pulse)
		art.move_child(pulse, 0)
	return art


func seat_compact_display_name(seat: int, info: Dictionary, max_name_chars: int = 2) -> String:
	var raw_name := str(info.get("name", "玩家")).strip_edges()
	if raw_name == "":
		raw_name = "玩家"
	var max_chars := maxi(1, max_name_chars)
	if seat == 0:
		if mode == "offline":
			return "我" if max_chars <= 3 else raw_name.substr(0, min(max_chars, raw_name.length()))
		return raw_name.substr(0, min(max_chars, raw_name.length()))
	if mode == "offline":
		var profile := ai_profile_short_label(seat)
		if profile != "":
			var compact := "%s%s" % [raw_name.substr(0, 1), profile]
			return compact if compact.length() <= max_chars else compact.substr(0, max_chars)
	var short_name = raw_name.substr(0, min(max_chars, raw_name.length()))
	return short_name

func seat_hand_flower_text(info: Dictionary) -> String:
	return "%d张  花%d" % [
		int(info.get("hand_count", 0)),
		int(info.get("flowers", 0)),
	]

func seat_hand_flower_short_text(info: Dictionary) -> String:
	var hand_count = int(info.get("hand_count", 0))
	var flower_count = int(info.get("flowers", 0))
	return "手%d 花%d" % [hand_count, flower_count] if flower_count > 0 else "手%d" % hand_count

func seat_score_text(info: Dictionary) -> String:
	return compact_score_text(int(info.get("score", 0)))

func seat_recent_river_text(seat: int, max_count: int = 4) -> String:
	var discards = get_discards(seat)
	var river := join_tile_labels(discards, tail_window_start(discards.size(), max_count), max_count)
	if river == "":
		return ""
	return "弃 " + river

func seat_recent_river_count_text(seat: int) -> String:
	var discard_count = get_discards(seat).size()
	return "弃%d" % discard_count if discard_count > 0 else ""


func style_seat_readable_label(label: Label, primary: bool = true) -> void:
	# Dark lacquer outline so gold/cream seat text stays legible over bright brocade.
	var fill := Color(1.0, 0.98, 0.90, 1.0) if primary else Color(0.96, 0.94, 0.84, 0.96)
	label.add_theme_color_override("font_color", fill)
	label.add_theme_color_override("font_outline_color", Color(0.02, 0.05, 0.03, 0.92))
	label.add_theme_constant_override("outline_size", 4)
	label.add_theme_color_override("font_shadow_color", Color(0.0, 0.0, 0.0, 0.78))
	label.add_theme_constant_override("shadow_offset_x", 1)
	label.add_theme_constant_override("shadow_offset_y", 1)
	configure_clipped_label(label)


func draw_seat(parent: Control, seat: int, rect: Rect2, side: String, seat_threat_reports: Dictionary = {}) -> void:
	# r212: GPT chrome conversion
	var active = get_current_seat() == seat
	var recent_discard_source = seat == get_last_discard_seat() and get_last_discard() != ""
	var p = get_player_info(seat)
	# 座位面板 - 增强的视觉区分
	var seat_shadow_rect = rect_full(rect.position.x + 0.006, rect.position.y + 0.012, rect.size.x + 0.010, rect.size.y + 0.018)
	var seat_shadow = make_soft_depth_panel(parent, seat_shadow_rect, Color(0.0, 0.0, 0.0, 0.22 if active else 0.14), 14)
	seat_shadow.name = "SeatPanel3DCastShadow_%d" % seat
	# Lift midtones so inactive side seats still read as lacquer plaques, not black voids.
	# r449: warm lacquer seat shell — no mint/jade green program fills under brocade.
	var panel = make_gpt_center_crop_plate_rect(rect, Color(0.018, 0.026, 0.024, 0.88), "ui_dark_scrim", 0.20)
	panel.name = "SeatPanel_%d" % seat
	parent.add_child(panel)
	panel.clip_contents = true
	# Commercial lacquer shell: rear plate, jade inset, bottom contact, light-catching rims.
	var seat_rear = make_soft_depth_panel(panel, rect_full(0.010, 0.020, 0.990, 0.990), Color(0.06, 0.045, 0.030, 0.10), 11)
	seat_rear.name = "SeatPanel3DRearShell_%d" % seat
	panel.move_child(seat_rear, 0)
	var seat_depth = make_soft_depth_panel(panel, rect_full(0.020, 0.760, 0.980, 0.990), Color(0.0, 0.0, 0.0, 0.08), 10)
	seat_depth.name = "SeatPanel3DDepthEdge_%d" % seat
	var seat_top_light = make_soft_depth_panel(panel, rect_full(0.040, 0.015, 0.960, 0.160), Color(1.0, 0.97, 0.76, 0.42 if active else 0.32), 999)
	seat_top_light.name = "SeatPanelTopLight_%d" % seat
	var seat_side_bevel = make_soft_depth_panel(panel, rect_full(0.015, 0.120, 0.060, 0.880), Color(1.0, 0.94, 0.66, 0.16 if active else 0.12), 999)
	seat_side_bevel.name = "SeatPanel3DSideBevel_%d" % seat
	var seat_right_bevel = make_soft_depth_panel(panel, rect_full(0.940, 0.120, 0.985, 0.880), Color(0.22, 0.16, 0.10, 0.14 if active else 0.10), 999)
	seat_right_bevel.name = "SeatPanel3DRightBevel_%d" % seat
	var seat_info_plate = add_optional_gpt_illustration_texture(panel, "ui_seat_info_plate", rect_full(-0.010, -0.015, 1.010, 1.015), 0.22 if active else 0.16, false)
	if seat_info_plate != null:
		seat_info_plate.name = "SeatInfoPlate_%d" % seat
		panel.move_child(seat_info_plate, 0)
	var seat_texture = add_optional_gpt_illustration_texture(panel, "seat_gpt_brocade", rect_full(-0.015, -0.020, 1.015, 1.020), 1.0 if active else 0.98, false)
	if seat_texture != null:
		seat_texture.name = "SeatGPTBrocadeTexture_%d" % seat
		# Commercial lacquer midtones; extra lift on side seats which sit in darker table periphery.
		# Keep brocade present but dim enough for name/score text to remain readable.
		# r450: warm lacquer boost — do not amplify green channel (v9 jade seats).
		# r184: show denser brocade; keep text legible via name/score plates.
		var seat_mod := Color(1.20, 1.10, 0.96, minf(0.58, seat_texture.modulate.a))
		if side == "left" or side == "right":
			seat_mod = Color(1.22, 1.11, 0.96, minf(0.54, seat_texture.modulate.a))
		elif not active:
			seat_mod = Color(1.16, 1.07, 0.94, minf(0.48, seat_texture.modulate.a))
		seat_texture.modulate = seat_mod
		panel.move_child(seat_texture, min(1, panel.get_child_count() - 1))
	# Side seats get a soft fill light so inactive plaques stay lacquer, not charcoal.
	if side == "left" or side == "right":
		var side_fill_light = make_soft_depth_panel(panel, rect_full(0.020, 0.040, 0.980, 0.920), Color(1.0, 0.97, 0.76, 0.16 if active else 0.12), 999)
		side_fill_light.name = "SeatPanel3DSideFillLight_%d" % seat

	# r449: skip mint jade wash slab (was covering brocade + nearby tiles with green).
	var seat_jade_wash = make_layout_host(rect_full(0.030, 0.080, 0.970, 0.860))
	seat_jade_wash.name = "SeatPanel3DJadeWash_%d" % seat
	panel.add_child(seat_jade_wash)
	var seat_accent: Color = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var accent_rail = make_gpt_route_rail(rect_full(0.070, 0.900, 0.930, 0.975), Color(seat_accent.r, seat_accent.g, seat_accent.b, 0.68 if active else 0.48))
	accent_rail.name = "SeatPanelAccentRail_%d" % seat
	panel.add_child(accent_rail)
	var jade_lip = make_gpt_route_rail(rect_full(0.090, 0.875, 0.910, 0.905), Color(0.42, 0.30, 0.14, 0.28 if active else 0.18))
	jade_lip.name = "SeatPanel3DJadeLip_%d" % seat
	panel.add_child(jade_lip)
	if recent_discard_source and not active:
		var source_edge = make_gpt_edge_rail(rect_full(0.000, 0.000, 0.018, 1.000), Color(0.96, 0.76, 0.34, 0.34))
		source_edge.name = "SeatRecentDiscardSourceEdge_%d" % seat
		panel.add_child(source_edge)

	if side == "top":
		var top_avatar = make_avatar_view(seat, active)
		panel.add_child(top_avatar)
		apply_rect(top_avatar, rect_full(0.035, 0.175, 0.185, 0.825))
		var top_text_back = make_gpt_center_crop_plate_rect(rect_full(0.205, 0.050, 0.955, 0.945), Color(0.012, 0.020, 0.018, 0.78), "ui_dark_scrim", 0.18)
		top_text_back.name = "SeatCompactTextBack_%d" % seat
		panel.add_child(top_text_back)
		var top_name = make_label(panel, seat_compact_display_name(seat, p, 3), 12, Color(1.0, 0.98, 0.90), true)
		top_name.name = "SeatCompactName_%d" % seat
		apply_rect(top_name, rect_full(0.220, 0.070, 0.535, 0.385))
		top_name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(top_name, true)
		var top_score = make_label(panel, seat_score_text(p), 11, Color(1.0, 0.94, 0.72), true)
		top_score.name = "SeatCompactScore_%d" % seat
		apply_rect(top_score, rect_full(0.700, 0.070, 0.935, 0.385))
		top_score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		style_seat_readable_label(top_score, true)
		var top_stats = make_label(panel, seat_hand_flower_text(p), 10, Color(0.96, 0.94, 0.84), false)
		top_stats.name = "SeatCompactMeta_%d" % seat
		apply_rect(top_stats, rect_full(0.220, 0.590, 0.555, 0.915))
		top_stats.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(top_stats, false)
		var top_recent = make_label(panel, seat_recent_river_text(seat, 3), 9, Color(0.94, 0.92, 0.80), false)
		top_recent.name = "SeatCompactRiver_%d" % seat
		apply_rect(top_recent, rect_full(0.575, 0.590, 0.935, 0.915))
		top_recent.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		style_seat_readable_label(top_recent, false)
		if seat == dealer_seat:
			var top_dealer = make_badge(panel, rect_full(0.575, 0.075, 0.670, 0.355), "庄", 9, Color(0.58, 0.12, 0.08, 0.88), Color(1.0, 0.79, 0.34, 0.56), Color(0.98, 0.92, 0.74))
			top_dealer.name = "SeatCompactDealer_%d" % seat
			top_dealer.mouse_filter = Control.MOUSE_FILTER_IGNORE
		draw_compact_seat_threat_badge(panel, seat, seat_threat_reports, side)
		return

	if side == "left" or side == "right":
		var side_avatar = make_avatar_view(seat, active)
		panel.add_child(side_avatar)
		apply_rect(side_avatar, rect_full(0.040, 0.245, 0.240, 0.755))
		var side_text_back = make_gpt_center_crop_plate_rect(rect_full(0.255, 0.060, 0.960, 0.860), Color(0.012, 0.020, 0.018, 0.78), "ui_dark_scrim", 0.18)
		side_text_back.name = "SeatCompactTextBack_%d" % seat
		panel.add_child(side_text_back)
		var side_name_right := 0.590 if seat == dealer_seat else 0.620
		var side_name = make_label(panel, seat_compact_display_name(seat, p, 2), 11, Color(1.0, 0.98, 0.90), true)
		side_name.name = "SeatCompactName_%d" % seat
		apply_rect(side_name, rect_full(0.285, 0.090, side_name_right, 0.300))
		side_name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(side_name, true)
		if seat == dealer_seat:
			var side_dealer = make_badge(panel, rect_full(0.610, 0.094, 0.690, 0.292), "庄", 8, Color(0.58, 0.12, 0.08, 0.84), Color(1.0, 0.79, 0.34, 0.54), Color(0.98, 0.92, 0.74))
			side_dealer.name = "SeatCompactDealer_%d" % seat
			side_dealer.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var side_score_left := 0.715 if seat == dealer_seat else 0.640
		var side_score = make_label(panel, seat_score_text(p), 9, Color(1.0, 0.94, 0.72), true)
		side_score.name = "SeatCompactScore_%d" % seat
		apply_rect(side_score, rect_full(side_score_left, 0.090, 0.940, 0.300))
		side_score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		style_seat_readable_label(side_score, true)
		var side_stats = make_label(panel, "", 10, Color(0.96, 0.94, 0.84), false)
		side_stats.name = "SeatCompactMeta_%d" % seat
		var side_discard_count = get_discards(seat).size()
		var side_meta_text = "手%d" % int(p.get("hand_count", 0))
		if int(p.get("flowers", 0)) > 0:
			side_meta_text += " 花%d" % int(p.get("flowers", 0))
		if side_discard_count > 0:
			side_meta_text += " 弃%d" % side_discard_count
		side_stats.text = side_meta_text
		apply_rect(side_stats, rect_full(0.285, 0.340, 0.940, 0.515))
		side_stats.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(side_stats, false)
		if active:
			var side_turn = make_badge(panel, rect_full(0.785, 0.555, 0.940, 0.730), "行", 8, Color(0.72, 0.56, 0.24, 0.92), Color(1.0, 0.82, 0.38, 0.34), Color(0.16, 0.12, 0.06))
			side_turn.name = "SeatCompactTurn_%d" % seat
			side_turn.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var side_status_text = "打%s" % tile_label(get_last_discard()) if recent_discard_source else ""
		if side_status_text != "":
			var side_status = make_label(panel, side_status_text, 10, Color(1.0, 0.94, 0.74), false)
			side_status.name = "SeatCompactStatus_%d" % seat
			apply_rect(side_status, rect_full(0.285, 0.565, 0.940, 0.720))
			side_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
			style_seat_readable_label(side_status, false)
		draw_compact_seat_threat_badge(panel, seat, seat_threat_reports, side)
		return

	# 头像
	var avatar = make_avatar_view(seat, active)
	panel.add_child(avatar)
	var avatar_rect = rect_full(0.045, 0.220, 0.255, 0.805) if side == "bottom" else rect_full(0.052, 0.255, 0.245, 0.795)
	apply_rect(avatar, avatar_rect)

	var content_left := 0.295 if side == "bottom" else 0.305
	var text_back = make_gpt_center_crop_plate_rect(rect_full(content_left - 0.018, 0.052, 0.965, 0.875), Color(0.012, 0.020, 0.018, 0.78), "ui_dark_scrim", 0.18)
	text_back.name = "SeatCompactTextBack_%d" % seat
	panel.add_child(text_back)
	var simple_name = make_label(panel, seat_compact_display_name(seat, p, 2), 15 if side == "bottom" else 12, Color(1.0, 0.98, 0.90), true)
	simple_name.name = "SeatCompactName_%d" % seat
	apply_rect(simple_name, rect_full(content_left, 0.075, 0.535 if seat == dealer_seat else 0.610, 0.255))
	simple_name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	style_seat_readable_label(simple_name, true)
	var simple_score = make_label(panel, seat_score_text(p), 11, Color(1.0, 0.94, 0.72), true)
	simple_score.name = "SeatCompactScore_%d" % seat
	apply_rect(simple_score, rect_full(0.650, 0.075, 0.955, 0.255))
	simple_score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	style_seat_readable_label(simple_score, true)
	if active:
		var simple_turn = make_badge(panel, rect_full(0.800, 0.265, 0.955, 0.420), "行牌", 8, Color(0.60, 0.45, 0.20, 0.78), Color(0.90, 0.68, 0.34, 0.22), Color(0.18, 0.13, 0.08))
		simple_turn.name = "SeatCompactTurn_%d" % seat
		simple_turn.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var simple_stats = make_label(panel, seat_hand_flower_text(p), 11, Color(0.96, 0.94, 0.84), false)
	simple_stats.name = "SeatCompactMeta_%d" % seat
	apply_rect(simple_stats, rect_full(content_left, 0.300, 0.790, 0.430))
	simple_stats.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	style_seat_readable_label(simple_stats, false)
	var simple_status_text = "刚打 %s" % tile_label(get_last_discard()) if recent_discard_source else (package_preview(seat) if active else "")
	if active and simple_status_text == "":
		simple_status_text = seat_status_summary_fallback(seat)
	if simple_status_text != "":
		var simple_status = make_label(panel, simple_status_text, 9, Color(1.0, 0.94, 0.74) if recent_discard_source else Color(0.96, 0.94, 0.84), false)
		simple_status.name = "SeatCompactStatus_%d" % seat
		apply_rect(simple_status, rect_full(content_left, 0.465, 0.955, 0.585))
		simple_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(simple_status, false)
	var simple_discard_text = seat_recent_river_text(seat, 4)
	if active or simple_discard_text != "":
		var simple_river = make_label(panel, simple_discard_text, 9, Color(0.94, 0.92, 0.80), false)
		simple_river.name = "SeatDiscardPreviewRecentLabel_%d" % seat
		apply_rect(simple_river, rect_full(content_left, 0.645, 0.955, 0.845))
		simple_river.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		style_seat_readable_label(simple_river, false)
	if seat == dealer_seat:
		var simple_dealer = make_badge(panel, rect_full(0.555, 0.075, 0.635, 0.255), "庄", 9, Color(0.58, 0.12, 0.08, 0.86), Color(1.0, 0.79, 0.34, 0.56), Color(0.96, 0.90, 0.72))
		simple_dealer.name = "SeatCompactDealer_%d" % seat
		simple_dealer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	draw_compact_seat_threat_badge(panel, seat, seat_threat_reports, side)
	return

	var threat_report = seat_threat_report_from_map(seat, seat_threat_reports)
	var threat_badge_text = opponent_seat_threat_badge_text_from_report(threat_report)
	var display_name = str(p.get("name", "玩家"))
	if mode == "offline" and seat != 0:
		display_name += " · " + ai_profile_short_label(seat)
	var package_text = package_preview(seat)
	var threat_line = opponent_seat_threat_line_from_report(threat_report)
	var summary_text = package_text if package_text != "" else threat_line
	var name = make_label(panel, display_name, 15, Color(0.94, 0.86, 0.68), true)
	var name_right = 0.55 if threat_badge_text != "" else 0.75 if active else 0.96
	apply_rect(name, rect_full(0.39, 0.08, name_right, 0.285 if summary_text != "" else 0.36))
	name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(name)
	draw_seat_turn_handoff_art(panel, seat, active)

	if active:
		var turn_badge = make_badge(panel, rect_full(0.77, 0.075, 0.96, 0.255), "行牌", 11, Color(0.72, 0.60, 0.24, 0.92), Color(1.0, 0.86, 0.44, 0.42), Color(0.13, 0.12, 0.08))
		turn_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if threat_badge_text != "":
		draw_seat_threat_badge_art(panel, seat, threat_report)
		var threat_badge = make_badge(panel, rect_full(0.57, 0.075, 0.75, 0.255), threat_badge_text, 12, opponent_seat_threat_color_from_report(threat_report), Color(1.0, 0.91, 0.48, 0.56), Color(0.10, 0.11, 0.10))
		threat_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE

	# 统计信息 - 增强的视觉效果
	draw_seat_stat_pill(panel, SEAT_STAT_RECTS[0], "手", str(int(p.get("hand_count", 0))), SEAT_ACCENT_COLORS[seat])
	draw_seat_stat_pill(panel, SEAT_STAT_RECTS[1], "花", str(int(p.get("flowers", 0))), Color(0.56, 0.44, 0.28))
	draw_seat_stat_pill(panel, SEAT_STAT_RECTS[2], "分", compact_score_text(int(p.get("score", 0))), Color(0.32, 0.44, 0.46))
	var has_score_ribbon = draw_seat_score_momentum_ribbon(panel, seat)

	if summary_text == "":
		summary_text = seat_status_summary_fallback(seat)
	draw_seat_status_summary_band(panel, seat, summary_text, package_text != "")

	var river_text = discard_preview(seat)
	var flowers = flower_preview(seat)
	var has_flower_tiles = draw_seat_flower_tiles(panel, seat)
	if flowers != "" and not has_flower_tiles:
		river_text = "花 " + flowers + ("\n" + river_text if river_text != "" else "")
	var river_top = 0.835 if has_flower_tiles else 0.715 if has_score_ribbon else 0.640
	var river_rect = rect_full(0.39, river_top, 0.96, 0.925)
	draw_seat_discard_preview_art(panel, seat, river_rect)
	var river = make_label(panel, river_text, 12, UI_TEXT_MUTED, false)
	apply_rect(river, river_rect)
	river.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(river)
	if seat == dealer_seat:
		var dealer_texture = add_optional_gpt_illustration_texture(panel, "dealer_seal", rect_full(0.245, 0.020, 0.405, 0.320), 0.52, true)  # r221
		if dealer_texture != null:
			dealer_texture.name = "DealerSealTexture_%d" % seat
			if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
				var dealer_tw := create_screen_tween()
				dealer_tw.set_loops(48)
				dealer_tw.tween_property(dealer_texture, "rotation", 0.035, 0.95).from(-0.025)
				dealer_tw.parallel().tween_property(dealer_texture, "modulate:a", 0.42, 0.95).from(0.22)
				dealer_tw.tween_property(dealer_texture, "rotation", -0.025, 0.95).from(0.035)
				dealer_tw.parallel().tween_property(dealer_texture, "modulate:a", 0.22, 0.95).from(0.42)
		var dealer = make_badge(panel, rect_full(0.27, 0.06, 0.38, 0.28), "庄", 16, Color(0.58, 0.12, 0.08, 0.90), Color(1.0, 0.79, 0.34, 0.76), Color(0.96, 0.90, 0.72))
		dealer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	draw_compact_seat_threat_badge(panel, seat, seat_threat_reports, side)


func draw_compact_seat_threat_badge(parent: Control, seat: int, seat_threat_reports: Dictionary, side: String) -> void:
	var report = seat_threat_report_from_map(seat, seat_threat_reports)
	var badge_text = opponent_seat_threat_badge_text_from_report(report)
	if badge_text == "":
		return
	var art = draw_seat_threat_badge_art(parent, seat, report)
	var badge_rect := rect_full(0.560, 0.340, 0.945, 0.535)
	if side == "top":
		badge_rect = rect_full(0.560, 0.385, 0.945, 0.555)
		apply_rect(art, rect_full(0.560, 0.385, 0.945, 0.555))
	elif side == "left" or side == "right":
		badge_rect = rect_full(0.285, 0.545, 0.720, 0.735)
		apply_rect(art, rect_full(0.285, 0.545, 0.720, 0.735))
	else:
		apply_rect(art, rect_full(0.560, 0.340, 0.945, 0.535))
	var badge = make_badge(parent, badge_rect, badge_text, 8 if side == "left" or side == "right" else 9, opponent_seat_threat_color_from_report(report), Color(1.0, 0.91, 0.48, 0.46), Color(0.10, 0.11, 0.10))
	badge.name = "SeatThreatBadge_%d" % seat
	badge.mouse_filter = Control.MOUSE_FILTER_IGNORE


func seat_status_summary_fallback(seat: int) -> String:
	var discards = get_discards(seat)
	var melds = get_melds(seat)
	var parts: Array[String] = []
	if not melds.is_empty():
		parts.append("副%d" % melds.size())
	parts.append("弃%d" % discards.size())
	var last = get_last_discard_for_seat(seat)
	if last != "":
		parts.append("近" + tile_label(last))
	return " ".join(parts)

func get_last_discard_for_seat(seat: int) -> String:
	var discards = get_discards(seat)
	if discards.is_empty():
		return ""
	return str(discards[discards.size() - 1])

func draw_seat_status_summary_band(parent: Control, seat: int, text: String, package_driven: bool) -> Control:
	# r213: GPT chrome conversion
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var simple_band = make_gpt_ribbon(rect_full(0.390, 0.295, 0.960, 0.360), Color(0.070, 0.056, 0.038, 0.48))
	simple_band.name = "SeatStatusSummaryBand_%d" % seat
	parent.add_child(simple_band)
	var simple_seal = make_gpt_gate(rect_full(0.020, 0.185, 0.100, 0.815), Color(accent.r, accent.g, accent.b, 0.16))
	simple_seal.name = "SeatStatusSummarySeal_%d" % seat
	simple_band.add_child(simple_seal)
	var simple_glyph = make_label(simple_seal, "包" if package_driven else "势", 8, Color(0.90, 0.84, 0.66, 0.78), true)
	simple_glyph.name = "SeatStatusSummaryGlyph_%d" % seat
	apply_rect(simple_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var simple_label = make_label(simple_band, text, 10, Color(0.84, 0.84, 0.72, 0.84), false)
	simple_label.name = "SeatStatusSummaryLabel_%d" % seat
	apply_rect(simple_label, rect_full(0.125, 0.040, 0.940, 0.960))
	simple_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(simple_label)
	return simple_band
	var band = make_gpt_ribbon(rect_full(0.390, 0.295, 0.960, 0.360), Color(0.006, 0.016, 0.018, 0.70))
	band.name = "SeatStatusSummaryBand_%d" % seat
	parent.add_child(band)
	var route = make_gpt_route_rail(rect_full(0.075, 0.470, 0.930, 0.550), Color(0.004, 0.012, 0.014, 0.48))
	route.name = "SeatStatusSummaryRoute_%d" % seat
	band.add_child(route)
	var fill_width = 0.690 if package_driven else 0.430
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.250, fill_width, 0.750), Color(accent.r, accent.g, accent.b, 0.22))
	fill.name = "SeatStatusSummaryFill_%d" % seat
	route.add_child(fill)
	var seal = make_gpt_gate(rect_full(0.020, 0.165, 0.105, 0.835), Color(accent.r, accent.g, accent.b, 0.24))
	seal.name = "SeatStatusSummarySeal_%d" % seat
	band.add_child(seal)
	var glyph = make_label(seal, "包" if package_driven else "势", 8, Color(0.96, 0.92, 0.74, 0.92), true)
	glyph.name = "SeatStatusSummaryGlyph_%d" % seat
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var gate = make_gpt_gate(rect_full(0.885, 0.220, 0.940, 0.780), Color(accent.r, accent.g, accent.b, 0.20))
	gate.name = "SeatStatusSummaryGate_%d" % seat
	band.add_child(gate)
	var tick = add_gpt_tick_strip(band, rect_full(0.640, 0.270, (0.655) + float(1) * (0.090), 0.730), Color(accent.r, accent.g, accent.b, 0.18), "SeatStatusSummaryTick_%d_0" % [seat])
	var label = make_label(band, text, 10, Color(0.86, 0.88, 0.78), false)
	label.name = "SeatStatusSummaryLabel_%d" % seat
	apply_rect(label, rect_full(0.125, 0.040, 0.860, 0.960))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(label)
	return band


func draw_seat_discard_preview_art(parent: Control, seat: int, rect: Rect2) -> bool:
	# r211: GPT chrome conversion
	var discards = get_discards(seat)
	if discards.is_empty():
		return false
	var art = Control.new()
	art.name = "SeatDiscardPreviewArt_%d" % seat
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect)
	parent.add_child(art)
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var wash_texture = add_illustration_texture(art, "discard_preview_wash", rect_full(-0.060, -0.260, 1.040, 1.140), 0.14, false)
	if wash_texture != null:
		wash_texture.name = "SeatDiscardPreviewWash_%d" % seat
	var seat_discard_gpt_key := "seat_discard_gpt_preview"
	var seat_discard_gpt_texture = add_optional_gpt_illustration_texture(art, seat_discard_gpt_key, rect_full(-0.060, -0.260, 1.040, 1.140), 0.15, false)  # r217
	if seat_discard_gpt_texture != null:
		seat_discard_gpt_texture.name = "SeatDiscardGPTPreviewTexture_%d" % seat
		art.move_child(seat_discard_gpt_texture, min(1, art.get_child_count() - 1))
		# r196: denser GPT river pad was invisible at 0.035; keep below tile faces.
		seat_discard_gpt_texture.modulate.a = 0.13  # r217 denser river pad
	if wash_texture != null:
		wash_texture.modulate.a = 0.06
	var recent_labels: Array[String] = []
	var preview_label_start = tail_window_start(discards.size(), 3)
	for i in range(preview_label_start, discards.size()):
		recent_labels.append(tile_label(str(discards[i])))
	var recent_text = " ".join(recent_labels)
	var recent_label = make_label(art, recent_text, 9, Color(0.82, 0.80, 0.66, 0.82), false)
	recent_label.name = "SeatDiscardPreviewRecentLabel_%d" % seat
	apply_rect(recent_label, rect_full(0.050, 0.090, 0.940, 0.600))
	recent_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(recent_label)
	return true
	var rail = make_gpt_route_rail(rect_full(0.000, 0.640, 0.980, 0.810), Color(0.006, 0.014, 0.016, 0.44))
	rail.name = "SeatDiscardPreviewRail_%d" % seat
	art.add_child(rail)
	var fill_fraction = clamp(float(discards.size()) / 18.0, 0.08, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.280, 0.020 + 0.940 * fill_fraction, 0.720), Color(accent.r, accent.g, accent.b, 0.26))
	fill.name = "SeatDiscardPreviewFill_%d" % seat
	rail.add_child(fill)
	var visible_start = tail_window_start(discards.size(), 3)
	var visible_count = discards.size() - visible_start
	for i in range(visible_count):
		var tile = str(discards[visible_start + i])
		var left = 0.030 + float(i) * 0.092
		var tile_node = make_gpt_gate(rect_full(left, 0.080, left + 0.070, 0.585), Color(accent.r, accent.g, accent.b, 0.14))
		tile_node.name = "SeatDiscardPreviewTile_%d_%d" % [seat, i]
		art.add_child(tile_node)
		var glyph = make_label(tile_node, tile_face_main(tile), 7, tile_accent(tile), true)
		glyph.name = "SeatDiscardPreviewGlyph_%d_%d" % [seat, i]
		apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	if discards.size() > visible_count:
		var overflow = make_gpt_edge_rail(rect_full(0.335, 0.155, 0.390, 0.520), Color(0.80, 0.64, 0.30, 0.20))
		overflow.name = "SeatDiscardPreviewOverflow_%d" % seat
		art.add_child(overflow)
	var gate = make_gpt_gate(rect_full(0.875, 0.525, 0.935, 0.930), Color(0.006, 0.014, 0.016, 0.54))
	gate.name = "SeatDiscardPreviewGate_%d" % seat
	art.add_child(gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.505, 0.210, (0.525) + float(2) * (0.070), 0.560), Color(accent.r, accent.g, accent.b, 0.22), "SeatDiscardPreviewTick_%d_0" % [seat])
	var history_route = make_gpt_route_rail(rect_full(0.365, 0.355, 0.875, 0.425), Color(0.006, 0.014, 0.016, 0.38))
	history_route.name = "SeatDiscardPreviewHistoryRoute_%d" % seat
	art.add_child(history_route)
	var history_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.035 + 0.900 * fill_fraction, 0.740), Color(accent.r, accent.g, accent.b, 0.22))
	history_fill.name = "SeatDiscardPreviewHistoryFill_%d" % seat
	history_route.add_child(history_fill)
	var history_gate = make_gpt_gate(rect_full(0.842, 0.275, 0.895, 0.545), Color(accent.r, accent.g, accent.b, 0.16))
	history_gate.name = "SeatDiscardPreviewHistoryGate_%d" % seat
	art.add_child(history_gate)
	for i in range(2):
		var node = make_gpt_gate(rect_full(0.455 + float(i) * 0.140, 0.245, 0.488 + float(i) * 0.140, 0.535), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.035))
		node.name = "SeatDiscardPreviewHistoryNode_%d_%d" % [seat, i]
		art.add_child(node)
		var history_tick = make_gpt_tick_strip(rect_full(0.525 + float(i) * 0.135, 0.250, 0.542 + float(i) * 0.135, 0.535), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.040))
		history_tick.name = "SeatDiscardPreviewHistoryTick_%d_%d" % [seat, i]
		art.add_child(history_tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if wash_texture != null:
			var wash_tw := create_screen_tween()
			wash_tw.set_loops(48)
			wash_tw.tween_property(wash_texture, "modulate:a", 0.24, 1.30).from(0.10)
			wash_tw.tween_property(wash_texture, "modulate:a", 0.10, 1.30).from(0.24)
		var gate_tw := create_screen_tween()
		gate_tw.set_loops(48)
		gate_tw.tween_property(gate, "modulate:a", 0.46, 0.82).from(0.96)
		gate_tw.parallel().tween_property(fill, "modulate:a", 0.56, 0.82).from(0.92)
		gate_tw.tween_property(gate, "modulate:a", 0.96, 0.82).from(0.46)
		gate_tw.parallel().tween_property(fill, "modulate:a", 0.92, 0.82).from(0.56)
	return true


func draw_seat_flower_settlement_art(parent: Control, flower_count: int) -> Control:
	# r211: GPT chrome conversion
	var art = Control.new()
	art.name = "SeatFlowerSettlementArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.375, 0.520, 0.955, 0.965))
	parent.add_child(art)
	var count_ratio = clamp(float(flower_count) / 8.0, 0.12, 1.0)
	var gold = Color(0.92, 0.70, 0.34)
	var jade = Color(0.78, 0.62, 0.36)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.225, 0.085, 0.675), Color(gold.r, gold.g, gold.b, 0.16 + count_ratio * 0.08))
	source.name = "SeatFlowerSettlementSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.080, 0.390, 0.875, 0.530), Color(0.006, 0.016, 0.018, 0.38))
	route.name = "SeatFlowerSettlementRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.030 + 0.880 * count_ratio, 0.750), Color(jade.r, jade.g, jade.b, 0.22))
	fill.name = "SeatFlowerSettlementFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.820, 0.245, 0.905, 0.730), Color(gold.r, gold.g, gold.b, 0.15 + count_ratio * 0.08))
	gate.name = "SeatFlowerSettlementGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.650, 0.025, 0.780, 0.340), Color(gold.r, gold.g, gold.b, 0.13 + count_ratio * 0.07))
	seal.name = "SeatFlowerSettlementSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "补", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "SeatFlowerSettlementGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var handoff_route = make_gpt_route_rail(rect_full(0.220, 0.680, 0.790, 0.835), Color(0.006, 0.016, 0.018, 0.30))
	handoff_route.name = "SeatFlowerSettlementHandoffRoute"
	art.add_child(handoff_route)
	var handoff_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.740, 0.750), Color(gold.r, gold.g, gold.b, 0.16))
	handoff_fill.name = "SeatFlowerSettlementHandoffFill"
	handoff_route.add_child(handoff_fill)
	var handoff_gate = make_gpt_gate(rect_full(0.760, 0.605, 0.835, 0.900), Color(jade.r, jade.g, jade.b, 0.12 + count_ratio * 0.05))
	handoff_gate.name = "SeatFlowerSettlementHandoffGate"
	art.add_child(handoff_gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.245, 0.185, (0.245) + float(2) * (0.145) + (0.020), 0.625), Color(jade.r, jade.g, jade.b, 0.20), "SeatFlowerSettlementTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.36, 0.72).from(0.88)
		tw.parallel().tween_property(handoff_fill, "modulate:a", 0.32, 0.72).from(0.82)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.72).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.88, 0.72).from(0.36)
		tw.parallel().tween_property(handoff_fill, "modulate:a", 0.82, 0.72).from(0.32)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.72).from(0.58)
	return art


func draw_seat_flower_tiles(parent: Control, seat: int) -> bool:
	# r212: GPT chrome conversion
	if mode != "offline" or seat < 0 or seat >= players.size():
		return false
	var flowers: Array = players[seat].get("flower_tiles", [])
	if flowers.is_empty():
		return false
	var art = make_gpt_route_rail(rect_full(0.390, 0.705, 0.960, 0.825), Color(0.030, 0.030, 0.020, 0.52))
	art.name = "SeatFlowerTileArt"
	parent.add_child(art)
	var seat_flower_gpt_key := "seat_flower_gpt_strip"
	var seat_flower_gpt_texture = add_optional_gpt_illustration_texture(art, seat_flower_gpt_key, rect_full(-0.020, -0.180, 1.020, 1.180), 0.12, false)
	if seat_flower_gpt_texture != null:
		seat_flower_gpt_texture.name = "SeatFlowerGPTStripTexture"
		art.move_child(seat_flower_gpt_texture, 0)
	var rail = make_gpt_route_rail(rect_full(0.030, 0.720, 0.970, 0.850), Color(0.78, 0.58, 0.28, 0.18))
	rail.name = "SeatFlowerTileRail"
	art.add_child(rail)
	var collection_fill = make_gpt_meter_fill(rect_full(0.050, 0.285, min(0.950, 0.050 + 0.210 * float(min(4, flowers.size()))), 0.715), Color(0.92, 0.70, 0.34, 0.28))
	collection_fill.name = "SeatFlowerCollectionFill"
	rail.add_child(collection_fill)
	var route = make_gpt_route_rail(rect_full(0.145, 0.815, 0.930, 0.890), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "SeatFlowerCollectionRoute"
	art.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, min(0.935, 0.220 + 0.155 * float(min(4, flowers.size()))), 0.740), Color(0.92, 0.70, 0.34, 0.24))
	route_fill.name = "SeatFlowerCollectionRouteFill"
	route.add_child(route_fill)
	var seal = make_gpt_gate(rect_full(0.020, 0.160, 0.130, 0.660), Color(0.68, 0.42, 0.18, 0.26))
	seal.name = "SeatFlowerTileSeal"
	art.add_child(seal)
	var seal_label = make_label(seal, "花", 10, Color(0.96, 0.86, 0.58), true)
	apply_rect(seal_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var glow = make_gpt_gate(rect_full(0.875, 0.180, 0.945, 0.620), Color(0.92, 0.70, 0.34, 0.18))
	glow.name = "SeatFlowerTileGlow"
	art.add_child(glow)
	var gate = make_gpt_gate(rect_full(0.900, 0.660, 0.940, 0.810), Color(0.96, 0.78, 0.38, 0.26))
	gate.name = "SeatFlowerCollectionGate"
	art.add_child(gate)
	var replacement_route = make_gpt_route_rail(rect_full(0.515, 0.350, 0.925, 0.420), Color(0.006, 0.016, 0.018, 0.40))
	replacement_route.name = "SeatFlowerReplacementRoute"
	art.add_child(replacement_route)
	var replacement_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.620 + 0.070 * float(min(4, flowers.size())), 0.750), Color(0.78, 0.62, 0.36, 0.22))
	replacement_fill.name = "SeatFlowerReplacementFill"
	replacement_route.add_child(replacement_fill)
	var replacement_source = make_gpt_edge_rail(rect_full(0.480, 0.265, 0.535, 0.505), Color(0.92, 0.70, 0.34, 0.18))
	replacement_source.name = "SeatFlowerReplacementSource"
	art.add_child(replacement_source)
	var replacement_gate = make_gpt_gate(rect_full(0.890, 0.255, 0.955, 0.520), Color(0.78, 0.62, 0.36, 0.18))
	replacement_gate.name = "SeatFlowerReplacementGate"
	art.add_child(replacement_gate)
	for i in range(3):
		var left_tick = 0.650 + float(i) * 0.060
		var tick = make_gpt_tick_strip(rect_full(left_tick, 0.170, left_tick + 0.020, 0.300), Color(0.92, 0.70, 0.34, 0.24 - float(i) * 0.040))
		tick.name = "SeatFlowerCollectionTick_0"
		art.add_child(tick)
	var replace_tick = add_gpt_tick_strip(art, rect_full(0.650, 0.455, (0.668) + float(1) * (0.070), 0.620), Color(0.78, 0.62, 0.36, 0.22), "SeatFlowerReplacementTick_0")
	draw_seat_flower_settlement_art(art, flowers.size())
	var strip = HBoxContainer.new()
	strip.name = "SeatFlowerTileStrip"
	configure_passive_container(strip)
	strip.alignment = BoxContainer.ALIGNMENT_BEGIN
	strip.add_theme_constant_override("separation", 2)
	apply_rect(strip, rect_full(0.155, 0.105, 0.835, 0.790))
	art.add_child(strip)
	var visible_count = min(4, flowers.size())
	for i in range(visible_count):
		var tile_view = make_tile_view(str(flowers[i]), Vector2(22, 31), false, Callable())
		tile_view.name = "SeatFlowerTile_%d" % i
		strip.add_child(tile_view)
	if flowers.size() > visible_count:
		var more = make_label(strip, "+%d" % (flowers.size() - visible_count), 11, Color(0.96, 0.86, 0.58), true)
		more.name = "SeatFlowerMoreBadge"
		more.custom_minimum_size = Vector2(24, 31)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(glow, "modulate:a", 0.35, 0.80).from(0.88)
		tw.tween_property(glow, "modulate:a", 0.88, 0.80).from(0.35)
		var replacement_tw := create_screen_tween()
		replacement_tw.set_loops(10)
		replacement_tw.tween_property(replacement_fill, "modulate:a", 0.38, 0.82).from(0.90)
		replacement_tw.tween_property(replacement_fill, "modulate:a", 0.90, 0.82).from(0.38)
	return true


func draw_seat_score_momentum_ribbon(parent: Control, seat: int) -> bool:
	# r209: GPT chrome conversion
	var report = score_context_report(seat)
	if report.is_empty():
		return false
	var accent = score_momentum_color(report)
	var simple_ribbon = make_gpt_ribbon(rect_full(0.39, 0.600, 0.96, 0.705), Color(0.072, 0.052, 0.034, 0.46))
	simple_ribbon.name = "SeatScoreMomentumRibbon"
	parent.add_child(simple_ribbon)
	var simple_seal = make_gpt_gate(rect_full(0.025, 0.20, 0.112, 0.80), Color(accent.r, accent.g, accent.b, 0.16))
	simple_seal.name = "SeatScoreMomentumSeal"
	simple_ribbon.add_child(simple_seal)
	var simple_glyph = make_label(simple_seal, "局", 8, Color(0.92, 0.86, 0.66, 0.80), true)
	apply_rect(simple_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var simple_label = make_label(simple_ribbon, score_momentum_label(report), 10, Color(0.90, 0.86, 0.70, 0.86), true)
	simple_label.name = "SeatScoreMomentumLabel"
	apply_rect(simple_label, rect_full(0.130, 0.05, 0.940, 0.95))
	configure_clipped_label(simple_label)
	return true
	var ribbon = make_gpt_ribbon(rect_full(0.39, 0.600, 0.96, 0.705), Color(accent.r * 0.16, accent.g * 0.16, accent.b * 0.16, 0.84))
	ribbon.name = "SeatScoreMomentumRibbon"
	parent.add_child(ribbon)
	ribbon.add_child(make_gpt_edge_rail(rect_full(0.08, 0.46, 0.92, 0.54), Color(accent.r, accent.g, accent.b, 0.22)))
	var seal = make_gpt_gate(rect_full(0.025, 0.18, 0.118, 0.82), Color(accent.r, accent.g, accent.b, 0.28))
	seal.name = "SeatScoreMomentumSeal"
	ribbon.add_child(seal)
	var pulse = make_gpt_tick_strip(rect_full(0.885, 0.28, 0.948, 0.72), Color(accent.r, accent.g, accent.b, 0.32))
	pulse.name = "SeatScoreMomentumPulse"
	ribbon.add_child(pulse)
	var rank = clamp(int(report.get("rank", 0)), 1, 4)
	var rank_progress = 1.0 - float(rank - 1) / 3.0
	var route = make_gpt_route_rail(rect_full(0.145, 0.705, 0.845, 0.830), Color(0.006, 0.014, 0.016, 0.48))
	route.name = "SeatScoreMomentumRoute"
	ribbon.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * clamp(rank_progress, 0.10, 1.0), 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	route_fill.name = "SeatScoreMomentumFill"
	route.add_child(route_fill)
	var rank_node_x = 0.145 + 0.700 * clamp(rank_progress, 0.06, 0.94)
	var rank_node = make_gpt_gate(rect_full(rank_node_x - 0.018, 0.600, rank_node_x + 0.018, 0.930), Color(accent.r, accent.g, accent.b, 0.30))
	rank_node.name = "SeatScoreMomentumRankNode"
	ribbon.add_child(rank_node)
	var strategy = str(report.get("strategy", "均衡"))
	var gate_left = 0.820 if strategy == "追分" else 0.120 if strategy == "守成" else 0.470
	var gate = make_gpt_gate(rect_full(gate_left, 0.155, gate_left + 0.050, 0.465), Color(accent.r, accent.g, accent.b, 0.24))
	gate.name = "SeatScoreMomentumGate"
	ribbon.add_child(gate)
	for i in range(3):
		var tick_left = 0.315 + float(i) * 0.110
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.185, tick_left + 0.018, 0.425), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.040))
		tick.name = "SeatScoreMomentumTick_0"
		ribbon.add_child(tick)
	var label = make_label(ribbon, score_momentum_label(report), 10, Color(0.96, 0.94, 0.84), true)
	label.name = "SeatScoreMomentumLabel"
	apply_rect(label, rect_full(0.135, 0.04, 0.875, 0.670))
	configure_clipped_label(label)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(pulse, "modulate:a", 0.30, 0.72).from(0.90)
		tw.parallel().tween_property(route_fill, "modulate:a", 0.46, 0.72).from(0.94)
		tw.parallel().tween_property(gate, "modulate:a", 0.50, 0.72).from(0.96)
		tw.tween_property(pulse, "modulate:a", 0.90, 0.72).from(0.30)
		tw.parallel().tween_property(route_fill, "modulate:a", 0.94, 0.72).from(0.46)
		tw.parallel().tween_property(gate, "modulate:a", 0.96, 0.72).from(0.50)
	return true


func draw_seat_stat_pill(parent: Control, rect: Rect2, label_text: String, value_text: String, accent: Color) -> void:
	# r213: GPT chrome conversion
	var simple_pill = make_gpt_plate_rect(rect, Color(0.070, 0.056, 0.038, 0.54), "ui_jade_reading_plate")
	simple_pill.name = "SeatStatPill_%s" % label_text
	parent.add_child(simple_pill)
	simple_pill.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.040, 1.0), Color(accent.r, accent.g, accent.b, 0.24)))
	var simple_label = make_label(simple_pill, label_text, 9, Color(0.72, 0.70, 0.58, 0.84), false)
	apply_rect(simple_label, rect_full(0.090, 0.08, 0.360, 0.92))
	simple_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var simple_value = make_label(simple_pill, value_text, 10, Color(0.92, 0.88, 0.70, 0.90), true)
	apply_rect(simple_value, rect_full(0.340, 0.08, 0.940, 0.92))
	simple_value.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(simple_value)
	return
	var pill = make_gpt_plate_rect(rect, Color(0.010, 0.018, 0.022, 0.92), "ui_jade_reading_plate")
	pill.name = "SeatStatPill_%s" % label_text
	parent.add_child(pill)
	# 左侧强调色条
	pill.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.06, 1.0), accent.darkened(0.06)))
	var meter = make_gpt_route_rail(rect_full(0.105, 0.790, 0.920, 0.890), Color(0.004, 0.012, 0.014, 0.46))
	meter.name = "SeatStatMeter_%s" % label_text
	pill.add_child(meter)
	var fill_ratio = seat_stat_fill_fraction(label_text, value_text)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.920 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.32))
	fill.name = "SeatStatMeterFill_%s" % label_text
	meter.add_child(fill)
	var gate_left = 0.105 + 0.815 * fill_ratio
	var gate = make_gpt_gate(rect_full(gate_left - 0.014, 0.705, gate_left + 0.014, 0.930), Color(accent.r, accent.g, accent.b, 0.22))
	gate.name = "SeatStatMeterGate_%s" % label_text
	pill.add_child(gate)
	for i in range(2):
		var dot = make_gpt_gate(rect_full(0.760 + float(i) * 0.070, 0.145, 0.790 + float(i) * 0.070, 0.325), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.04))
		dot.name = "SeatStatMeterDot_%s_%d" % [label_text, i]
		pill.add_child(dot)
	var tick = add_gpt_tick_strip(pill, rect_full(0.565, 0.595, (0.578) + float(1) * (0.060), 0.700), Color(accent.r, accent.g, accent.b, 0.20), "SeatStatMeterTick_%s_0" % [label_text])
	var value_route = make_gpt_route_rail(rect_full(0.335, 0.410, 0.900, 0.470), Color(0.004, 0.012, 0.014, 0.38))
	value_route.name = "SeatStatValueRoute_%s" % label_text
	pill.add_child(value_route)
	var value_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.520 + 0.300 * fill_ratio, 0.750), Color(accent.r, accent.g, accent.b, 0.20))
	value_fill.name = "SeatStatValueFill_%s" % label_text
	value_route.add_child(value_fill)
	var value_gate = make_gpt_gate(rect_full(0.875, 0.340, 0.910, 0.550), Color(accent.r, accent.g, accent.b, 0.18))
	value_gate.name = "SeatStatValueGate_%s" % label_text
	pill.add_child(value_gate)
	var value_tick = add_gpt_tick_strip(pill, rect_full(0.625, 0.315, (0.640) + float(1) * (0.070), 0.570), Color(accent.r, accent.g, accent.b, 0.18), "SeatStatValueTick_%s_0" % label_text)
	var label = make_label(pill, label_text, 9, Color(0.72, 0.74, 0.66, 0.94), false)
	apply_rect(label, rect_full(0.10, 0.12, 0.42, 0.88))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(label)
	var value = make_label(pill, value_text, 12, Color(0.96, 0.94, 0.88), true)
	apply_rect(value, rect_full(0.34, 0.06, 0.94, 0.94))
	value.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(value)


func draw_seat_threat_badge_art(parent: Control, seat: int, report: Dictionary) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SeatThreatBadgeArt_%d" % seat
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.535, 0.075, 0.955, 0.365))
	parent.add_child(art)
	var accent = opponent_seat_threat_color_from_report(report)
	var score = float(report.get("score", 0.0))
	var fill_ratio = clamp(score / 28.0, 0.24, 1.0)
	var radar_texture = add_illustration_texture(art, "seat_threat_radar", rect_full(-0.080, -0.220, 1.020, 1.160), 0.18, false)
	if radar_texture != null:
		radar_texture.name = "SeatThreatRadarTexture_%d" % seat
	var source = make_gpt_edge_rail(rect_full(0.035, 0.345, 0.095, 0.695), Color(accent.r, accent.g, accent.b, 0.26))
	source.name = "SeatThreatSourceNode_%d" % seat
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.105, 0.540, 0.865, 0.625), Color(0.006, 0.014, 0.016, 0.44))
	route.name = "SeatThreatRoute_%d" % seat
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.255, 0.020 + 0.940 * fill_ratio, 0.745), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "SeatThreatFill_%d" % seat
	route.add_child(fill)
	var glow = make_gpt_meter_fill(rect_full(0.000, 0.060, fill_ratio, 0.940), Color(1.0, 0.90, 0.58, 0.10))
	glow.name = "SeatThreatGlow_%d" % seat
	fill.add_child(glow)
	var gate = make_gpt_gate(rect_full(0.850, 0.365, 0.910, 0.775), Color(accent.r, accent.g, accent.b, 0.24))
	gate.name = "SeatThreatGate_%d" % seat
	art.add_child(gate)
	var pressure_x = 0.105 + 0.760 * fill_ratio
	var pressure = make_gpt_plate_rect(rect_full(pressure_x - 0.020, 0.395, pressure_x + 0.020, 0.760), Color(accent.r, accent.g, accent.b, 0.32), "ui_jade_reading_plate")
	pressure.name = "SeatThreatPressureNode_%d" % seat
	art.add_child(pressure)
	var safe_tiles: Array = report.get("safe_tiles", [])
	var safe_count = min(3, safe_tiles.size())
	for i in range(3):
		var alpha = 0.24 if i < safe_count else 0.10
		var left = 0.245 + float(i) * 0.105
		var tick = make_gpt_tick_strip(rect_full(left, 0.225, left + 0.022, 0.455), Color(accent.r, accent.g, accent.b, alpha - float(i) * 0.035))
		tick.name = "SeatThreatSafeTick_%d_%d" % [seat, i]
		art.add_child(tick)
	if str(report.get("readiness_label", "")) != "":
		var readiness = make_gpt_edge_rail(rect_full(0.690, 0.135, 0.760, 0.435), Color(0.92, 0.76, 0.34, 0.24))
		readiness.name = "SeatThreatReadinessSeal_%d" % seat
		art.add_child(readiness)
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var readiness_tw := create_screen_tween()
			readiness_tw.set_loops(48)
			readiness_tw.tween_property(readiness, "scale", Vector2(1.120, 1.120), 0.58).from(Vector2.ONE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			readiness_tw.parallel().tween_property(readiness, "modulate:a", 0.48, 0.58).from(1.0)
			readiness_tw.tween_property(readiness, "scale", Vector2.ONE, 0.58).from(Vector2(1.120, 1.120)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			readiness_tw.parallel().tween_property(readiness, "modulate:a", 1.0, 0.58).from(0.48)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if radar_texture != null:
			var drift := create_screen_tween()
			drift.set_loops(48)
			drift.tween_property(radar_texture, "rotation", 0.10, 2.8).from(-0.10)
			drift.tween_property(radar_texture, "rotation", -0.10, 2.8).from(0.10)
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(pressure, "modulate:a", 0.38, 0.72).from(0.95)
		tw.parallel().tween_property(fill, "modulate:a", 0.46, 0.72).from(0.96)
		if radar_texture != null:
			tw.parallel().tween_property(radar_texture, "modulate:a", 0.28, 0.72).from(0.14)
		tw.tween_property(pressure, "modulate:a", 0.95, 0.72).from(0.38)
		tw.parallel().tween_property(fill, "modulate:a", 0.96, 0.72).from(0.46)
		if radar_texture != null:
			tw.parallel().tween_property(radar_texture, "modulate:a", 0.14, 0.72).from(0.28)
	return art


func draw_seat_turn_handoff_art(parent: Control, seat: int, active: bool) -> Control:
	# r211: GPT chrome conversion
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	if not active:
		return null
	var simple_art = Control.new()
	simple_art.name = "SeatTurnHandoffArt_%d" % seat
	simple_art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(simple_art, rect_full(0.800, 0.070, 0.955, 0.265))
	parent.add_child(simple_art)
	var simple_seal = make_gpt_gate(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.66, 0.52, 0.22, 0.42))
	simple_seal.name = "SeatTurnHandoffSeal_%d" % seat
	simple_art.add_child(simple_seal)
	var simple_glyph = make_label(simple_seal, "行", 10, Color(0.16, 0.13, 0.08, 0.92), true)
	apply_rect(simple_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	return simple_art
	var art = Control.new()
	art.name = "SeatTurnHandoffArt_%d" % seat
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.365, 0.335, 0.955, 0.565))
	parent.add_child(art)
	var source = make_gpt_edge_rail(rect_full(0.010, 0.260, 0.085, 0.720), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.10))
	source.name = "SeatTurnHandoffSource_%d" % seat
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.430, 0.825, 0.560), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "SeatTurnHandoffRoute_%d" % seat
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.880 if active else 0.420, 0.740), Color(accent.r, accent.g, accent.b, 0.30 if active else 0.12))
	fill.name = "SeatTurnHandoffFill_%d" % seat
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.805, 0.300, 0.875, 0.740), Color(accent.r, accent.g, accent.b, 0.24 if active else 0.10))
	gate.name = "SeatTurnHandoffGate_%d" % seat
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.875, 0.175, 0.985, 0.835), Color(accent.r, accent.g, accent.b, 0.22 if active else 0.10))
	seal.name = "SeatTurnHandoffSeal_%d" % seat
	art.add_child(seal)
	var glyph = make_label(seal, "行" if active else seat_wind_label(seat), 8, Color(0.98, 0.90, 0.64, 0.86 if active else 0.50), true)
	glyph.name = "SeatTurnHandoffGlyph_%d" % seat
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var tick = make_gpt_tick_strip(rect_full(0.255 + float(i) * 0.135, 0.250, 0.282 + float(i) * 0.135, 0.750), Color(accent.r, accent.g, accent.b, 0.23 - float(i) * 0.040 if active else 0.09))
		tick.name = "SeatTurnHandoffTick_%d_%d" % [seat, i]
		art.add_child(tick)
	if active and fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.42, 0.78).from(0.92)
		tw.parallel().tween_property(seal, "scale", Vector2(1.035, 1.035), 0.78).from(Vector2.ONE)
		tw.tween_property(fill, "modulate:a", 0.92, 0.78).from(0.42)
		tw.parallel().tween_property(seal, "scale", Vector2.ONE, 0.78).from(Vector2(1.035, 1.035))
	return art


func draw_secondary_back_button_art(button: Control, screen_id: String, color: Color) -> Control:
	# r213: GPT chrome conversion
	var back_plate = add_optional_gpt_illustration_texture(button, "ui_seat_info_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.36, false)
	if back_plate != null:
		back_plate.name = "SecondaryBackGptPlate"
		back_plate.show_behind_parent = true
	var back_rail = add_optional_gpt_illustration_texture(button, "ui_action_role_rail", rect_full(0.02, 0.10, 0.12, 0.90), 0.50, false)
	if back_rail != null:
		back_rail.name = "SecondaryBackGptRail"
		back_rail.show_behind_parent = true
	var art = Control.new()
	art.name = "SecondaryBackButtonArt_%s" % screen_id
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Button native text is drawn before ordinary children. Keep the authored
	# return chrome behind the parent so the exit label remains the top layer.
	art.show_behind_parent = true
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var back_texture = add_illustration_texture(art, "secondary_back_path", rect_full(-0.060, -0.200, 1.060, 1.160), 0.16, false)
	if back_texture != null:
		back_texture.name = "SecondaryBackTexture_%s" % screen_id
		art.move_child(back_texture, 0)
	var rail = make_gpt_route_rail(rect_full(0.250, 0.735, 0.880, 0.830), Color(0.006, 0.016, 0.018, 0.48))
	rail.name = "SecondaryBackButtonRail_%s" % screen_id
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.045, 0.260, 0.700, 0.740), Color(color.r, color.g, color.b, 0.34))
	fill.name = "SecondaryBackButtonFill_%s" % screen_id
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.075, 0.240, 0.125, 0.620), Color(0.72, 0.84, 0.72, 0.24))
	gate.name = "SecondaryBackButtonGate_%s" % screen_id
	art.add_child(gate)
	var source = make_gpt_edge_rail(rect_full(0.795, 0.675, 0.850, 0.890), Color(color.r, color.g, color.b, 0.20))
	source.name = "SecondaryBackSourceNode_%s" % screen_id
	art.add_child(source)
	var destination = make_gpt_edge_rail(rect_full(0.165, 0.680, 0.220, 0.890), Color(0.72, 0.84, 0.72, 0.20))
	destination.name = "SecondaryBackDestinationNode_%s" % screen_id
	art.add_child(destination)
	var confirm_route = make_gpt_route_rail(rect_full(0.555, 0.455, 0.910, 0.525), Color(0.006, 0.016, 0.018, 0.10))
	confirm_route.name = "SecondaryBackConfirmRoute_%s" % screen_id
	art.add_child(confirm_route)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.620, 0.750), Color(color.r, color.g, color.b, 0.055))
	confirm_fill.name = "SecondaryBackConfirmFill_%s" % screen_id
	confirm_route.add_child(confirm_fill)
	var confirm_gate = make_gpt_gate(rect_full(0.890, 0.395, 0.930, 0.610), Color(0.72, 0.84, 0.72, 0.055))
	confirm_gate.name = "SecondaryBackConfirmGate_%s" % screen_id
	art.add_child(confirm_gate)
	var return_flow = make_gpt_route_rail(rect_full(0.160, 0.115, 0.790, 0.190), Color(0.006, 0.016, 0.018, 0.36))
	return_flow.name = "SecondaryBackReturnFlow_%s" % screen_id
	art.add_child(return_flow)
	var return_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.720, 0.740), Color(color.r, color.g, color.b, 0.26))
	return_fill.name = "SecondaryBackReturnFill_%s" % screen_id
	return_flow.add_child(return_fill)
	var return_gate = make_gpt_gate(rect_full(0.130, 0.045, 0.190, 0.260), Color(0.72, 0.84, 0.72, 0.20))
	return_gate.name = "SecondaryBackReturnGate_%s" % screen_id
	art.add_child(return_gate)
	for i in range(2):
		var tick = make_gpt_tick_strip(rect_full(0.645 + float(i) * 0.060, 0.220, 0.665 + float(i) * 0.060, 0.360), Color(color.r, color.g, color.b, 0.26 - float(i) * 0.050))
		tick.name = "SecondaryBackButtonTick_%s_%d" % [screen_id, i]
		art.add_child(tick)
		var confirm_tick = make_gpt_tick_strip(rect_full(0.675 + float(i) * 0.075, 0.390, 0.692 + float(i) * 0.075, 0.625), Color(color.r, color.g, color.b, 0.050 - float(i) * 0.010))
		confirm_tick.name = "SecondaryBackConfirmTick_%s_%d" % [screen_id, i]
		art.add_child(confirm_tick)
		var node_tick = make_gpt_tick_strip(rect_full(0.315 + float(i) * 0.210, 0.670, 0.335 + float(i) * 0.210, 0.870), Color(color.r, color.g, color.b, 0.22 - float(i) * 0.045))
		node_tick.name = "SecondaryBackNodeTick_%s_%d" % [screen_id, i]
		art.add_child(node_tick)
	var return_tick = add_gpt_tick_strip(art, rect_full(0.300, 0.060, (0.318) + float(2) * (0.105), 0.240), Color(color.r, color.g, color.b, 0.22), "SecondaryBackReturnTick_%s_0" % screen_id)
	if button is Button:
		var back_button := button as Button
		back_button.button_down.connect(func() -> void:
			play_secondary_back_press_feedback(back_button, screen_id, color)
		)
	return art


func draw_secondary_screen_texture(parent: Control, texture_key: String, node_name: String, alpha: float = 0.16) -> TextureRect:
	var texture = add_illustration_texture(parent, texture_key, rect_full(0.035, 0.105, 0.965, 0.315), alpha, false)
	if texture == null:
		return null
	texture.name = node_name
	parent.move_child(texture, 0)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(texture, "modulate:a", max(0.04, alpha * 0.58), 3.2).from(alpha)
		tw.parallel().tween_property(texture, "offset_left", -5.0, 3.2).from(0.0)
		tw.parallel().tween_property(texture, "offset_right", 5.0, 3.2).from(0.0)
		tw.tween_property(texture, "modulate:a", alpha, 3.2).from(max(0.04, alpha * 0.58))
		tw.parallel().tween_property(texture, "offset_left", 0.0, 3.2).from(-5.0)
		tw.parallel().tween_property(texture, "offset_right", 0.0, 3.2).from(5.0)
	return texture

func draw_setting_row_status_art(row: Control, title: String, status: String) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingRowStatusArt_%s" % title
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	row.add_child(art)
	return art
	var accent = Color(0.54, 0.68, 0.58)
	var rail = make_gpt_route_rail(rect_full(0.050, 0.760, 0.640, 0.850), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "SettingRowStatusRail_%s" % title
	art.add_child(rail)
	var fill_ratio = clamp((float(status.length()) + float(title.length()) * 0.35) / 24.0, 0.22, 0.95)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.920 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	fill.name = "SettingRowStatusFill_%s" % title
	rail.add_child(fill)
	for i in range(3):
		var dot = make_gpt_gate(rect_full(0.055 + float(i) * 0.045, 0.555, 0.078 + float(i) * 0.045, 0.690), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.035))
		dot.name = "SettingRowStatusDot_%s_%d" % [title, i]
		art.add_child(dot)
	return art


func draw_setting_switch_art(parent: Control, enabled: bool) -> Control:
	var art = Control.new()
	art.name = "SettingSwitchArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.715, 0.230, 0.960, 0.770))
	parent.add_child(art)
	var rail_color = Color(0.16, 0.36, 0.30, 0.86) if enabled else Color(0.30, 0.22, 0.20, 0.82)
	var rail_border = Color(0.48, 0.78, 0.60, 0.42) if enabled else Color(0.66, 0.46, 0.38, 0.30)
	# r204: GPT switch chrome
	var rail = make_gpt_route_rail(rect_full(0.04, 0.20, 0.96, 0.80), Color(rail_color.r, rail_color.g, rail_color.b, rail_color.a))
	rail.name = "SettingSwitchRail"
	art.add_child(rail)
	var knob_left = 0.58 if enabled else 0.10
	var knob = make_gpt_gate(rect_full(knob_left, 0.08, knob_left + 0.32, 0.92), Color(0.96, 0.90, 0.68, 0.92))
	knob.name = "SettingSwitchKnobOn" if enabled else "SettingSwitchKnobOff"
	art.add_child(knob)
	if enabled:
		var on_light = make_gpt_gate(rect_full(0.675, 0.290, 0.805, 0.710), Color(0.56, 0.92, 0.64, 0.34))
		on_light.name = "SettingSwitchOnLight"
		art.add_child(on_light)
	else:
		var off_lock = make_gpt_gate(rect_full(0.705, 0.300, 0.840, 0.700), Color(0.76, 0.48, 0.36, 0.38))
		off_lock.name = "SettingSwitchOffLock"
		art.add_child(off_lock)
		var off_glyph = make_label(off_lock, "锁", 7, Color(0.94, 0.74, 0.58, 0.72), true)
		apply_rect(off_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var start_left = 0.10 if enabled else 0.58
		knob.anchor_left = start_left
		knob.anchor_right = start_left + 0.32
		var slide_tw := create_screen_tween()
		slide_tw.tween_property(knob, "anchor_left", knob_left, 0.22).from(start_left).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		slide_tw.parallel().tween_property(knob, "anchor_right", knob_left + 0.32, 0.22).from(start_left + 0.32).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	return art

func draw_settings_apply_sync_art(parent: Control) -> Control:
	# r211: GPT chrome conversion
	var art = Control.new()
	art.name = "SettingsApplySyncArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.090, 0.895, 0.910, 0.970))
	parent.add_child(art)
	parent.move_child(art, 2)
	var enabled_count = int(music_enabled) + int(sfx_enabled) + int(tts_enabled) + int(fast_mode_enabled) + int(fx_enabled) + int(ai_assist_enabled)
	var fill_ratio = clamp(float(enabled_count) / 6.0, 0.12, 1.0)
	var source = make_gpt_edge_rail(rect_full(0.020, 0.280, 0.075, 0.720), Color(0.78, 0.62, 0.36, 0.20))
	source.name = "SettingsApplySyncSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.075, 0.420, 0.720, 0.560), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "SettingsApplySyncRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.920 * fill_ratio, 0.740), Color(0.78, 0.62, 0.36, 0.30))
	fill.name = "SettingsApplySyncFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.695, 0.230, 0.755, 0.770), Color(0.78, 0.62, 0.36, 0.20))
	gate.name = "SettingsApplySyncGate"
	art.add_child(gate)
	var archive = make_gpt_edge_rail(rect_full(0.780, 0.170, 0.865, 0.830), Color(0.92, 0.72, 0.34, 0.16))
	archive.name = "SettingsApplySyncArchive"
	art.add_child(archive)
	var glyph = make_label(archive, "存", 8, Color(0.98, 0.92, 0.66, 0.84), true)
	glyph.name = "SettingsApplySyncGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var close_route = make_gpt_route_rail(rect_full(0.850, 0.425, 0.980, 0.555), Color(0.006, 0.016, 0.018, 0.34))
	close_route.name = "SettingsApplyCloseRoute"
	art.add_child(close_route)
	var close_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.720, 0.740), Color(0.92, 0.72, 0.34, 0.22))
	close_fill.name = "SettingsApplyCloseFill"
	close_route.add_child(close_fill)
	for i in range(3):
		var node = make_gpt_gate(rect_full(0.190 + float(i) * 0.150, 0.280, 0.215 + float(i) * 0.150, 0.720), Color(0.78, 0.62, 0.36, 0.18 - float(i) * 0.030))
		node.name = "SettingsApplySyncNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.275, 0.230, (0.292) + float(3) * (0.095), 0.770), Color(0.78, 0.62, 0.36, 0.22), "SettingsApplySyncTick_0")
	return art


func draw_settings_close_button_art(button: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingsCloseButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var silk_texture = add_illustration_texture(art, "settings_close_silk", rect_full(-0.060, -0.180, 1.060, 1.180), 0.13, false)
	if silk_texture != null:
		silk_texture.name = "SettingsCloseSilkTexture"
	var rail = make_gpt_route_rail(rect_full(0.130, 0.700, 0.860, 0.820), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "SettingsCloseRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.760, 0.740), Color(0.78, 0.64, 0.36, 0.28))
	fill.name = "SettingsCloseFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.800, 0.540, 0.880, 0.900), Color(0.78, 0.64, 0.36, 0.18))
	gate.name = "SettingsCloseGate"
	art.add_child(gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.350, 0.525, (0.372) + float(1) * (0.110), 0.840), Color(0.78, 0.64, 0.36, 0.22), "SettingsCloseTick_0")
	if button is Button:
		var close_button := button as Button
		close_button.button_down.connect(func() -> void:
			play_settings_close_button_feedback(close_button)
		)
	return art


func draw_settings_overlay(parent: Control) -> void:
	# r210: GPT chrome conversion
	if not settings_panel_open:
		return
	var compact_settings = effective_viewport_size().y <= 560.0
	var panel_rect = SETTINGS_PANEL_RECT
	var audio_section_rect = SETTINGS_AUDIO_SECTION_RECT
	var play_section_rect = SETTINGS_PLAY_SECTION_RECT
	var maint_section_rect = SETTINGS_MAINT_SECTION_RECT
	if compact_settings:
		# 540px 高度仍保留每行 48px 的点击目标：扩大模态可用高度，再让
		# 上方两区容纳完整设置行，底部系统区维持一行双列。
		panel_rect = rect_full(0.145, 0.010, 0.855, 0.990)
		audio_section_rect = rect_full(0.040, 0.250, 0.488, 0.837)
		play_section_rect = rect_full(0.512, 0.250, 0.960, 0.837)
		maint_section_rect = rect_full(0.040, 0.855, 0.960, 0.989)
	var overlay = Control.new()
	overlay.name = "SettingsOverlay"
	overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	parent.add_child(overlay)
	var scrim = make_gpt_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.004, 0.010, 0.012, 0.68), "ui_dark_scrim")
	scrim.name = "SettingsOverlayScrim"
	scrim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(scrim)

	# Keep one authored panel surface behind the modal content. The scrim and
	# primary GPT plate provide depth without a second full-page rear texture.
	var panel_shadow_rect := Rect2(panel_rect.position + Vector2(0.006, 0.014), panel_rect.size + Vector2(0.010, 0.012))
	var panel_shadow = make_soft_depth_panel(overlay, panel_shadow_rect, Color(0.0, 0.0, 0.0, 0.40), 24)
	panel_shadow.name = "SettingsConsole3DCastShadow"

	# 设置面板 - 更精致的样式
	var panel = make_gpt_plate_rect(panel_rect, Color(0.390, 0.470, 0.380, 0.76), "settings_gpt_panel_v2")
	panel.name = "SettingsPanel"
	overlay.add_child(panel)
	var left_depth_rail = make_gpt_route_rail(rect_full(0.006, 0.055, 0.020, 0.940), Color(0.0, 0.0, 0.0, 0.34))
	left_depth_rail.name = "SettingsConsole3DLeftRail"
	panel.add_child(left_depth_rail)
	var right_light_rail = make_gpt_gate(rect_full(0.980, 0.055, 0.994, 0.940), Color(0.72, 0.54, 0.26, 0.10))
	right_light_rail.name = "SettingsConsole3DRightRail"
	panel.add_child(right_light_rail)
	var inner_floor = make_gpt_route_rail(rect_full(0.025, 0.955, 0.975, 0.985), Color(0.0, 0.0, 0.0, 0.36))
	inner_floor.name = "SettingsConsole3DInnerFloor"
	panel.add_child(inner_floor)
	for corner_index in range(4):
		var corner_x := 0.018 if corner_index % 2 == 0 else 0.956
		var corner_y := 0.024 if corner_index < 2 else 0.932
		var corner_cap = make_gpt_plate_rect(rect_full(corner_x, corner_y, corner_x + 0.026, corner_y + 0.034), Color(0.58, 0.40, 0.16, 0.34), "ui_jade_reading_plate")
		corner_cap.name = "SettingsConsole3DCornerCap_%d" % corner_index
		panel.add_child(corner_cap)
	var settings_gpt_key := "settings_gpt_panel_v2"
	var gpt_settings_texture = add_optional_gpt_illustration_texture(panel, settings_gpt_key, rect_full(0.018, 0.018, 0.982, 0.982), 0.035, false)
	if gpt_settings_texture != null:
		gpt_settings_texture.name = "SettingsGPTPanelTexture"
		gpt_settings_texture.modulate = Color(1.58, 1.62, 1.30, gpt_settings_texture.modulate.a)
	# Keep the panel's dedicated clean header as the only title surface. A second
	# high-frequency rail competes with the title and rule selector at compact sizes.
	# 设置面板滑入动画
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		overlay.modulate = Color(1, 1, 1, 0)
		panel.offset_right = 20.0
		var stw := create_screen_tween()
		stw.set_parallel(true)
		stw.tween_property(overlay, "modulate:a", 1.0, 0.2).from(0.0).set_ease(Tween.EASE_OUT)
		stw.tween_property(panel, "offset_right", 0.0, 0.2).from(20.0).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)

	var title = make_label(panel, "设置", 24, Color(1.0, 0.92, 0.58), true)
	title.name = "SettingsTitleLabel"
	apply_rect(title, SETTINGS_TITLE_RECT)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	title.add_theme_color_override("font_outline_color", Color(0.02, 0.05, 0.03, 0.92))
	title.add_theme_constant_override("outline_size", 4)
	configure_clipped_label(title)
	add_lucide_icon(panel, "settings", rect_full(0.035, 0.050, 0.068, 0.125), Color(0.96, 0.84, 0.46, 0.86))
	draw_settings_overview_art(panel)

	var close = make_small_button("关闭", Color(0.30, 0.34, 0.36), func() -> void:
		close_settings_panel()
	)
	close.custom_minimum_size = Vector2(88, 42)
	close.name = "SettingsCloseButton"
	close.focus_mode = Control.FOCUS_ALL
	draw_settings_close_button_art(close)
	panel.add_child(close)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		AnimationEffects.flash(close, 0.5, 1.0, 0.8)
	apply_rect(close, SETTINGS_CLOSE_RECT)
	close.focus_neighbor_left = close.get_path()
	close.focus_neighbor_right = close.get_path()
	close.focus_neighbor_top = close.get_path()
	close.focus_neighbor_bottom = close.get_path()
	close.focus_next = close.get_path()
	close.focus_previous = close.get_path()
	close.grab_focus()
	var rule_setting_label = make_label(panel, "地方规则", 12, Color(0.84, 0.90, 0.78), true)
	rule_setting_label.name = "SettingsRuleVariantLabel"
	apply_rect(rule_setting_label, rect_full(0.550, 0.040, 0.675, 0.115))
	rule_setting_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(rule_setting_label)
	var rule_setting_button = make_setting_selector_button(rule_variant_short_label(), "地方规则", func() -> void:
		cycle_rule_variant_setting()
	)
	rule_setting_button.name = "SettingsRuleVariantButton"
	rule_setting_button.tooltip_text = rule_variant_summary(rule_variant)
	apply_rect(rule_setting_button, rect_full(0.685, 0.035, 0.815, 0.125))
	panel.add_child(rule_setting_button)
	var rule_variant_status = make_label(panel, rule_variant_activation_status_text(), 11, Color(0.82, 0.86, 0.70, 0.94), true)
	rule_variant_status.name = "SettingsRuleVariantStatus"
	apply_rect(rule_variant_status, rect_full(0.550, 0.125, 0.815, 0.165))
	rule_variant_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(rule_variant_status)

	# 声音设置
	var audio_grid = make_settings_section(panel, audio_section_rect, "声音", compact_settings)
	audio_grid.columns = 1
	make_setting_row(audio_grid, "背景音乐", "当前: %s" % ("开启" if music_enabled else "关闭"), make_setting_button("音乐", music_enabled, func() -> void:
		toggle_music_setting()
	))
	make_setting_row(audio_grid, "音效反馈", "当前: %s" % ("开启" if sfx_enabled else "关闭"), make_setting_button("音效", sfx_enabled, func() -> void:
		toggle_sfx_setting()
	))
	make_setting_row(audio_grid, "语音报牌", "当前: %s" % ("开启" if tts_enabled else "关闭"), make_setting_button("报牌", tts_enabled, func() -> void:
		toggle_tts_setting()
	))
	make_setting_row(audio_grid, "播放测试", "试听当前音量", make_audio_test_button(func() -> void:
		test_audio_setting()
	))

	# 体验设置
	var play_grid = make_settings_section(panel, play_section_rect, "体验", compact_settings)
	play_grid.columns = 1
	make_setting_row(play_grid, "AI 节奏", "当前: %s" % ("快速" if fast_mode_enabled else "标准"), make_setting_selector_button("快速" if fast_mode_enabled else "标准", "AI 节奏", func() -> void:
		toggle_fast_mode_setting()
	))
	make_setting_row(play_grid, "AI 难度", "对手强度: %s" % ai_difficulty_label(), make_setting_selector_button(ai_difficulty_label(), "AI 难度", func() -> void:
		cycle_ai_difficulty_setting()
	))
	make_setting_row(play_grid, "桌面特效", "当前: %s" % ("开启" if fx_enabled else "关闭"), make_setting_button("特效", fx_enabled, func() -> void:
		toggle_fx_setting()
	))
	make_setting_row(play_grid, "出牌辅助", "危险提示: %s" % ("开启" if ai_assist_enabled else "关闭"), make_setting_button("辅助", ai_assist_enabled, func() -> void:
		toggle_ai_assist_setting()
	))
	make_setting_row(play_grid, "播放曲目", str(BGM_TRACKS[current_bgm_index].get("name", "默认曲目")), make_bgm_switch_button(func() -> void:
		switch_bgm_track()
	))

	# 系统设置
	var system_grid = make_settings_section(panel, maint_section_rect, "系统", compact_settings)
	system_grid.columns = 2
	make_setting_row(system_grid, "3D 画质", "当前: %s" % graphics_quality_label(), make_graphics_quality_button(func() -> void:
		cycle_graphics_quality_setting()
	))
	make_setting_row(system_grid, "本地进度", "清空统计与离线记录", make_reset_progress_button(func() -> void:
		request_reset_progress_from_settings()
	))


func draw_settings_overview_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "SettingsOverviewArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.285, 0.175, 0.715, 0.232))
	parent.add_child(art)
	var overview_texture = add_illustration_texture(art, "settings_overview_scroll", rect_full(-0.020, -0.160, 1.020, 1.160), 0.026, false)
	if overview_texture != null:
		overview_texture.name = "SettingsOverviewScrollTexture"
	var enabled_audio = int(music_enabled) + int(sfx_enabled) + int(tts_enabled)
	var enabled_play = int(fast_mode_enabled) + int(fx_enabled) + int(ai_assist_enabled)
	# The optional generated plate is only a quiet material wash; native nodes and
	# labels carry the real settings state so baked pseudo-controls stay subdued.
	var overview_panel_key := "settings_overview_panel"
	var overview_panel = add_optional_gpt_illustration_texture(art, overview_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.026, false)
	if overview_panel != null:
		overview_panel.name = "SettingsOverviewPanelTexture"
		art.move_child(overview_panel, 0)
	var rail = make_gpt_route_rail(rect_full(0.330, 0.735, 0.905, 0.855), Color(0.006, 0.016, 0.018, 0.42))
	rail.name = "SettingsOverviewRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.920 * clamp(float(enabled_audio + enabled_play) / 6.0, 0.10, 1.0), 0.740), Color(0.78, 0.62, 0.36, 0.28))
	fill.name = "SettingsOverviewFill"
	rail.add_child(fill)
	var overview_nodes := [
		["audio", "声", 0.095, Color(0.34, 0.58, 0.72)],
		["play", "玩", 0.178, Color(0.34, 0.62, 0.46)],
		["maint", "护", 0.261, Color(0.70, 0.48, 0.34)],
	]
	for item in overview_nodes:
		var node = make_gpt_gate(rect_full(float(item[2]) - 0.032, 0.160, float(item[2]) + 0.032, 0.660), item[3])
		node.name = "SettingsOverviewNode_%s" % str(item[0])
		art.add_child(node)
		var glyph = make_label(node, str(item[1]), 8, Color(0.98, 0.92, 0.66, 0.86), true)
		glyph.name = "SettingsOverviewGlyph_%s" % str(item[0])
		apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var status_light = make_gpt_gate(rect_full(0.930, 0.290, 0.965, 0.640), Color(0.78, 0.62, 0.36, 0.24))
	status_light.name = "SettingsOverviewStatusLight"
	art.add_child(status_light)
	var summary = make_label(art, "声音 %d/3    体验 %d/3" % [enabled_audio, enabled_play], 11, Color(0.88, 0.86, 0.68, 0.88), true)
	summary.name = "SettingsOverviewSummary"
	apply_rect(summary, rect_full(0.340, 0.120, 0.890, 0.685))
	summary.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	configure_clipped_label(summary)
	return art


func draw_settings_section_route_art(parent: Control) -> Control:
	# r213: GPT chrome conversion
	var art = Control.new()
	art.name = "SettingsSectionRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.075, 0.165, 0.925, 0.900))
	parent.add_child(art)
	parent.move_child(art, 2)
	var rail = make_gpt_route_rail(rect_full(0.060, 0.060, 0.940, 0.085), Color(0.006, 0.016, 0.018, 0.42))
