func action_button_width_for_available(count: int, available_width: float, separation: int = -1) -> float:
	if count <= 0:
		return action_button_max_width_for_viewport()
	var gap = action_button_separation_for_count(count) if separation < 0 else separation
	var layout_slack = 2.0
	var available = available_width - float(max(0, count - 1) * gap) - layout_slack
	var width: float = minf(action_button_max_width_for_viewport(), floorf(maxf(1.0, available / float(count))))
	if has_pending_claim_window():
		# Keep authored touch targets intact; the FlowContainer supplies the second
		# row when a compact viewport cannot fit the full response set.
		var pending_min_width := PENDING_CLAIM_BUTTON_MIN_WIDTH
		return maxf(pending_min_width, width)
	return width

func action_button_max_width_for_viewport() -> float:
	var viewport_size := effective_viewport_size()
	if viewport_size.y <= 560.0 or viewport_size.x < 1100.0:
		return ACTION_BUTTON_COMPACT_MAX_WIDTH
	if viewport_size.x < 1600.0:
		return ACTION_BUTTON_MEDIUM_MAX_WIDTH
	return ACTION_BUTTON_MAX_WIDTH

func action_button_width_for_count(count: int, separation: int = -1) -> float:
	return action_button_width_for_available(count, action_bar_pixel_width(), separation)

func action_buttons_fit_available(count: int, available_width: float) -> bool:
	var separation = action_button_separation_for_count(count)
	var width = action_button_width_for_available(count, available_width, separation)
	var required = float(count) * width + float(max(0, count - 1) * separation)
	return required <= available_width + 0.5

func action_buttons_fit_width(count: int) -> bool:
	return action_buttons_fit_available(count, action_bar_pixel_width())

func discard_grid_fits_zone(zone_rect: Rect2, columns: int, rows: int, tile_size: Vector2) -> bool:
	return discard_grid_fits_zone_for_table_size(zone_rect, columns, rows, tile_size, game_table_pixel_size())

func discard_grid_fits_zone_for_table_size(zone_rect: Rect2, columns: int, rows: int, tile_size: Vector2, table_size: Vector2) -> bool:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var required_width = float(columns) * tile_size.x + float(max(0, columns - 1) * DISCARD_GRID_SEPARATION)
	var required_height = float(rows) * tile_size.y + float(max(0, rows - 1) * DISCARD_GRID_SEPARATION)
	return required_width <= zone_size.x + 0.5 and required_height <= zone_size.y + 0.5

func discard_ripple_rect_for_seat(seat: int) -> Rect2:
	var base_rect = root_layer_rect_to_screen_rect(CENTER_PANEL_RECT)
	for zone in DISCARD_ZONES:
		if int(zone[0]) == seat:
			var screen_rect = root_layer_rect_to_screen_rect(zone[1])
			var zone_size = screen_rect.size - screen_rect.position
			var center = (screen_rect.position + screen_rect.size) * 0.5
			var size = Vector2(
				clamp(zone_size.x * 0.46, 0.08, 0.18),
				clamp(zone_size.y * 0.70, 0.08, 0.18)
			)
			return Rect2(center - size * 0.5, center + size * 0.5)
	return base_rect

func discard_zone_pixel_size(zone_rect: Rect2) -> Vector2:
	return discard_zone_pixel_size_for_table_size(zone_rect, game_table_pixel_size())

func discard_zone_pixel_size_for_table_size(zone_rect: Rect2, table_size: Vector2) -> Vector2:
	return Vector2((zone_rect.size.x - zone_rect.position.x) * table_size.x, (zone_rect.size.y - zone_rect.position.y) * table_size.y)

func discard_zone_tile_size(zone_rect: Rect2, columns: int, rows: int) -> Vector2:
	return discard_zone_tile_size_for_table_size(zone_rect, columns, rows, game_table_pixel_size())

func discard_zone_tile_size_for_table_size(zone_rect: Rect2, columns: int, rows: int, table_size: Vector2) -> Vector2:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var safe_columns = max(1, columns)
	var safe_rows = max(1, rows)
	var available_width = max(1.0, (zone_size.x - float(DISCARD_GRID_SEPARATION * (safe_columns - 1))) / float(safe_columns))
	var available_height = max(1.0, (zone_size.y - float(DISCARD_GRID_SEPARATION * (safe_rows - 1))) / float(safe_rows))
	# r452: all rivers fill grid cells for porcelain density (closes felt gutters).
	# Mild classic-aspect clamp so faces do not go ultra-landscape.
	var width = min(DISCARD_TILE_MAX_SIZE.x, available_width)
	var height = min(DISCARD_TILE_MAX_SIZE.y, available_height)
	var min_aspect = DISCARD_TILE_ASPECT * 0.82
	var max_aspect = DISCARD_TILE_ASPECT * 1.18
	if height > 0.0 and width / height < 1.0 / max_aspect:
		width = min(available_width, height / min_aspect)
	if width > 0.0 and height / width > max_aspect:
		height = min(available_height, width * max_aspect)
	return Vector2(max(1.0, floor(width)), max(1.0, floor(height)))

func discard_zone_visible_rows(zone_rect: Rect2, columns: int) -> int:
	return discard_zone_visible_rows_for_table_size(zone_rect, columns, game_table_pixel_size())

func discard_zone_visible_rows_for_table_size(zone_rect: Rect2, columns: int, table_size: Vector2) -> int:
	var zone_size = discard_zone_pixel_size_for_table_size(zone_rect, table_size)
	var max_rows = int(floor((zone_size.y + float(DISCARD_GRID_SEPARATION)) / (DISCARD_TILE_MIN_SIZE.y + float(DISCARD_GRID_SEPARATION))))
	# r500: bottom/top (8-col) prefer 2 rows. On compact screens, side rivers
	# trade one visible row for a larger face so the tile glyph remains readable.
	var compact_side_river := columns <= 3 and effective_viewport_size().y <= 560.0
	var row_cap := 2 if columns >= 8 else (3 if compact_side_river else 4)
	return clamp(max_rows, 1, row_cap)

func achievement_medal_gpt_key(key: String, unlocked: bool) -> String:
	if not unlocked:
		return "achievement_medal_bronze"
	match key:
		"thirteen_orphans", "big_three_dragons", "small_three_dragons", "big_four_winds", "small_four_winds", "all_honors", "seven_pairs", "all_triplets", "ten_wins":
			return "achievement_medal_gold"
		_:
			return "achievement_medal_jade"

func draw_achievement_row_art(parent: Control, key: String, index: int, unlocked: bool, accent: Color) -> Control:
	# r208: GPT chrome conversion
	var art = Control.new()
	art.name = "AchievementRowArt_%s" % key
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var row_depth = make_gpt_plate_rect(rect_full(0.008, 0.185, 0.992, 0.985), Color(0.0, 0.0, 0.0, 0.06), "ui_button_face_plate")
	row_depth.name = "AchievementRow3DDepthEdge_%s" % key
	art.add_child(row_depth)
	var row_top_rim = make_gpt_ribbon(rect_full(0.025, 0.025, 0.975, 0.080), Color(1.0, 0.92, 0.62, 0.070 if unlocked else 0.040))
	row_top_rim.name = "AchievementRow3DTopRim_%s" % key
	art.add_child(row_top_rim)
	var medal_pedestal = make_gpt_gate(rect_full(0.010, 0.110, 0.112, 0.915), Color(accent.r * 0.18, accent.g * 0.20, accent.b * 0.20, 0.68))
	medal_pedestal.name = "AchievementRow3DMedalPedestal_%s" % key
	art.add_child(medal_pedestal)
	var medal = make_gpt_gate(rect_full(0.018, 0.145, 0.100, 0.855), Color(accent.r, accent.g, accent.b, 0.10 if unlocked else 0.08))
	medal.name = "AchievementRowMedal_%s" % key
	art.add_child(medal)
	var medal_core = make_gpt_gate(rect_full(0.255, 0.245, 0.745, 0.755), Color(0.96, 0.82, 0.42, 0.08 if unlocked else 0.05))
	medal_core.name = "AchievementRowMedalCore"
	medal.add_child(medal_core)
	var medal_tex = add_optional_gpt_illustration_texture(medal, achievement_medal_gpt_key(key, unlocked), rect_full(-0.12, -0.08, 1.12, 1.12), 0.92 if unlocked else 0.58, true)
	if medal_tex != null:
		medal_tex.name = "AchievementRowMedalTexture_%s" % key
		if not unlocked:
			medal_tex.modulate = Color(0.72, 0.78, 0.76, 0.58)
		medal.move_child(medal_tex, 0)
	var progress = 1.0 if unlocked else 0.08
	var progress_rail = make_gpt_route_rail(rect_full(0.305, 0.725, 0.660, 0.835), Color(0.006, 0.016, 0.018, 0.62))
	progress_rail.name = "AchievementRowProgressRail"
	art.add_child(progress_rail)
	var progress_fill = make_gpt_meter_fill(rect_full(0.020, 0.220, 0.020 + 0.940 * progress, 0.780), Color(accent.r, accent.g, accent.b, 0.42 if unlocked else 0.20))
	progress_fill.name = "AchievementRowProgressFill"
	progress_rail.add_child(progress_fill)
	var progress_gate = make_gpt_gate(rect_full(clamp(0.020 + 0.940 * progress - 0.014, 0.020, 0.936), 0.110, clamp(0.020 + 0.940 * progress + 0.014, 0.052, 0.970), 0.890), Color(0.96, 0.84, 0.42, 0.42 if unlocked else 0.24))
	progress_gate.name = "AchievementRowProgressGate"
	progress_rail.add_child(progress_gate)
	var badge = make_gpt_gate(rect_full(0.700, 0.220, 0.952, 0.780), Color(accent.r, accent.g, accent.b, 0.28 if unlocked else 0.24))
	badge.name = "AchievementRowSeal_%s" % key
	art.add_child(badge)
	var glyph = make_label(badge, achievement_badge_title(key), 12, Color(0.98, 0.92, 0.70, 0.92) if unlocked else Color(0.86, 0.94, 0.90, 0.94), true)
	glyph.name = "AchievementRowGlyph"
	apply_rect(glyph, rect_full(0.055, 0.120, 0.500, 0.880))
	configure_clipped_label(glyph)
	var icon = make_label(badge, "·", 12, Color(0.98, 0.88, 0.56, 0.86) if unlocked else Color(0.90, 0.98, 0.94, 0.94), true)
	apply_rect(icon, rect_full(0.505, 0.160, 0.575, 0.840))
	if icon != null:
		icon.name = "AchievementRowStatusIcon_%s" % key
	if unlocked:
		var shine = make_gpt_edge_rail(rect_full(0.030, 0.170, 0.102, 0.830), Color(0.96, 0.82, 0.42, 0.14))
		shine.name = "AchievementRowUnlockedShine_%s" % key
		art.add_child(shine)
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var stamp_tw := create_screen_tween()
			stamp_tw.set_parallel(true)
			stamp_tw.tween_property(shine, "modulate:a", 0.90, 0.12).from(0.0)
			stamp_tw.tween_property(shine, "scale", Vector2(1.0, 1.0), 0.22).from(Vector2(1.36, 1.36)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			stamp_tw.tween_property(medal, "scale", Vector2(1.0, 1.0), 0.24).from(Vector2(1.16, 1.16)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	else:
		var lock = make_gpt_edge_rail(rect_full(0.030, 0.170, 0.102, 0.830), Color(0.52, 0.62, 0.60, 0.12))
		lock.name = "AchievementRowLockedRoute_%s" % key
		art.add_child(lock)
	return art


func draw_achievement_toast_art(toast_bg: Control, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var glow_texture = add_illustration_texture(toast_bg, "achievement_medal_glow", rect_full(0.055, 0.010, 0.940, 0.980), 0.16, false)
	if glow_texture != null:
		glow_texture.name = "ToastAchievementGlowTexture"
		toast_bg.move_child(glow_texture, 0)
	var medal = make_gpt_gate(rect_full(0.100, 0.185, 0.142, 0.815), Color(accent.r, accent.g, accent.b, 0.10))
	medal.name = "ToastAchievementMedal"
	toast_bg.add_child(medal)
	var core = make_gpt_plate_rect(rect_full(0.260, 0.250, 0.740, 0.750), Color(0.96, 0.82, 0.36, 0.12), "ui_jade_reading_plate")
	core.name = "ToastAchievementMedalCore"
	medal.add_child(core)
	var toast_medal_tex = add_optional_gpt_illustration_texture(medal, "achievement_medal_gold", rect_full(-0.14, -0.10, 1.14, 1.14), 0.96, true)
	if toast_medal_tex != null:
		toast_medal_tex.name = "ToastAchievementMedalTexture"
		medal.move_child(toast_medal_tex, 0)
	var toast_signal = add_optional_gpt_illustration_texture(toast_bg, "ui_progress_signal_strip", rect_full(0.160, 0.620, 0.920, 0.900), 0.34, false)
	if toast_signal != null:
		toast_signal.name = "ToastAchievementSignalStrip"
	var toast_meter = add_optional_gpt_illustration_texture(toast_bg, "ui_meter_rail_plate", rect_full(0.170, 0.700, 0.700, 0.860), 0.42, false)
	if toast_meter != null:
		toast_meter.name = "ToastAchievementMeterRail"


func draw_achievements_completion_convergence_art(parent: Control) -> Control:
	# r209: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsCompletionConvergenceArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.430, 0.118, 0.935, 0.300))
	parent.add_child(art)
	var compact_completion_lane := effective_viewport_size().x <= 1280.0 or effective_viewport_size().y <= 560.0
	var label = make_label(art, "收集进度 %d%%" % int(round(ratio * 100.0)), 13, Color(0.88, 0.84, 0.64, 0.86), true)
	label.name = "AchievementsCompletionLabel"
	label.tooltip_text = label.text
	# Compact screens get a dedicated slot immediately left of the medal; wide
	# screens keep the progress readout to the medal's right.
	apply_rect(label, rect_full(0.020, 0.090, 0.530, 0.380) if compact_completion_lane else rect_full(0.490, 0.090, 1.000, 0.380))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	set_ui_full_text(label, label.text, "成就收集进度")
	mark_ui_optimization(art, "F-527")
	mark_ui_optimization(label, "F-528")
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.025, 0.250, 0.090, 0.680), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.08))
	source.name = "AchievementsCompletionSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.420, 0.885, 0.535), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "AchievementsCompletionRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * max(0.08, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.24))
	fill.name = "AchievementsCompletionFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.850, 0.275, 0.930, 0.720), Color(gold.r, gold.g, gold.b, 0.15 + ratio * 0.10))
	gate.name = "AchievementsCompletionGate"
	art.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.720, 0.060, 0.835, 0.340), Color(gold.r, gold.g, gold.b, 0.13 + ratio * 0.08))
	seal.name = "AchievementsCompletionSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "成", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "AchievementsCompletionGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var claim_route = make_gpt_route_rail(rect_full(0.220, 0.680, 0.775, 0.810), Color(0.006, 0.016, 0.018, 0.34))
	claim_route.name = "AchievementsCompletionClaimRoute"
	art.add_child(claim_route)
	var claim_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.720, 0.750), Color(gold.r, gold.g, gold.b, 0.18))
	claim_fill.name = "AchievementsCompletionClaimFill"
	claim_route.add_child(claim_fill)
	var archive_gate = make_gpt_gate(rect_full(0.760, 0.605, 0.835, 0.875), Color(jade.r, jade.g, jade.b, 0.13 + ratio * 0.06))
	archive_gate.name = "AchievementsCompletionArchiveGate"
	art.add_child(archive_gate)
	for i in range(4):
		var left = 0.215 + float(i) * 0.130
		var lit = ratio >= float(i + 1) / 4.0
		var node = make_gpt_gate(rect_full(left, 0.300, left + 0.028, 0.665), Color(gold.r, gold.g, gold.b, 0.22 if lit else 0.09))
		node.name = "AchievementsCompletionNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.560, 0.175, (0.574) + float(2) * (0.058), 0.400), Color(jade.r, jade.g, jade.b, 0.22), "AchievementsCompletionTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.36, 0.70).from(0.90)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.34, 0.70).from(0.84)
		tw.parallel().tween_property(seal, "modulate:a", 0.58, 0.70).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.90, 0.70).from(0.36)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.84, 0.70).from(0.34)
		tw.parallel().tween_property(seal, "modulate:a", 0.90, 0.70).from(0.58)
	return art


func draw_achievements_dashboard_art(parent: Control) -> Control:
	# r211: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = make_gpt_plate_rect(rect_full(0.055, 0.120, 0.945, 0.295), Color(0.250, 0.320, 0.270, 0.95), "ui_button_face_plate")
	art.name = "AchievementsDashboardArt"
	parent.add_child(art)
	var dash_plate = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(0.160, 0.700, 0.900, 0.940), 0.40, false)
	if dash_plate != null:
		dash_plate.name = "AchievementsDashboardSignalStrip"
	var dash_meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.180, 0.760, 0.780, 0.900), 0.55, false)
	if dash_meter != null:
		dash_meter.name = "AchievementsDashboardMeterRail"
	var dashboard_depth = make_gpt_plate_rect(rect_full(0.010, 0.705, 0.990, 0.985), Color(0.0, 0.0, 0.0, 0.18), "ui_button_face_plate")
	dashboard_depth.name = "AchievementsDashboard3DDepthEdge"
	art.add_child(dashboard_depth)
	var dashboard_top_rim = make_gpt_ribbon(rect_full(0.025, 0.020, 0.975, 0.065), Color(1.0, 0.88, 0.52, 0.055))
	dashboard_top_rim.name = "AchievementsDashboard3DTopRim"
	art.add_child(dashboard_top_rim)
	var glow_texture = add_illustration_texture(art, "achievement_medal_glow", rect_full(0.000, -0.170, 0.275, 1.170), 0.18, false)
	if glow_texture != null:
		glow_texture.name = "AchievementsDashboardGlowTexture"
		art.move_child(glow_texture, 0)
	var summary_backplate = make_gpt_plate_rect(rect_full(0.165, 0.105, 0.515, 0.845), Color(0.070, 0.105, 0.090, 0.30), "ui_jade_reading_plate")
	summary_backplate.name = "AchievementsSummaryTextBackplate"
	art.add_child(summary_backplate)
	var summary_label = make_label(art, "已解锁 %d/%d" % [unlocked, total], 18, Color(0.94, 0.88, 0.62), true)
	summary_label.name = "AchievementsProgressLabel"
	apply_rect(summary_label, rect_full(0.190, 0.130, 0.500, 0.430))
	summary_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(summary_label)
	var detail_label = make_label(art, "完成度 %d%%" % int(round(ratio * 100.0)), 15, Color(0.90, 0.94, 0.86), true)
	detail_label.name = "AchievementsProgressDetailLabel"
	apply_rect(detail_label, rect_full(0.190, 0.485, 0.500, 0.735))
	detail_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(detail_label)
	var medal_card = make_gpt_gate(rect_full(0.735, 0.185, 0.900, 0.815), Color(0.42, 0.34, 0.18, 0.10 + ratio * 0.08))
	medal_card.name = "AchievementsMedalNode"
	art.add_child(medal_card)
	var medal_pedestal = make_gpt_gate(rect_full(0.718, 0.160, 0.917, 0.860), Color(0.10, 0.075, 0.035, 0.62))
	medal_pedestal.name = "AchievementsDashboard3DMedalPedestal"
	art.add_child(medal_pedestal)
	art.move_child(medal_pedestal, max(0, medal_card.get_index()))
	var core = make_gpt_plate_rect(rect_full(0.260, 0.225, 0.740, 0.775), Color(0.96, 0.78, 0.32, 0.08 + ratio * 0.08), "ui_jade_reading_plate")
	core.name = "AchievementsMedalCore"
	medal_card.add_child(core)
	var dashboard_medal_key = "achievement_medal_gold" if ratio >= 0.45 else ("achievement_medal_jade" if ratio >= 0.15 else "achievement_medal_bronze")
	var dashboard_medal_tex = add_optional_gpt_illustration_texture(medal_card, dashboard_medal_key, rect_full(-0.08, -0.10, 1.08, 1.12), 0.94, true)
	if dashboard_medal_tex != null:
		dashboard_medal_tex.name = "AchievementsMedalTexture"
		medal_card.move_child(dashboard_medal_tex, 0)
	var medal_glyph = make_label(medal_card, "奖", 24, Color(1.0, 0.92, 0.62, 0.96), true)
	medal_glyph.name = "AchievementsMedalGlyph"
	apply_rect(medal_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	# Progress + unlock rails (GPT plates) for smoke/readability; nodes remain as soft ticks.
	var progress_rail = make_gpt_plate_rect(rect_full(0.180, 0.760, 0.700, 0.900), Color(0.16, 0.14, 0.10, 0.36), "ui_progress_signal_strip")
	progress_rail.name = "AchievementsProgressRail"
	art.add_child(progress_rail)
	var progress_fill = make_gpt_plate_rect(rect_full(0.180, 0.760, 0.180 + 0.520 * max(0.08, ratio), 0.900), Color(0.78, 0.58, 0.28, 0.54), "ui_meter_rail_plate")
	progress_fill.name = "AchievementsProgressFill"
	art.add_child(progress_fill)
	var progress_gate = make_gpt_plate_rect(rect_full(0.685, 0.735, 0.725, 0.925), Color(0.92, 0.76, 0.36, 0.28), "ui_button_face_plate")
	progress_gate.name = "AchievementsProgressGate"
	art.add_child(progress_gate)
	var unlock_route = make_gpt_plate_rect(rect_full(0.180, 0.900, 0.700, 0.955), Color(0.08, 0.12, 0.10, 0.36), "ui_meter_rail_plate")
	unlock_route.name = "AchievementsUnlockRoute"
	art.add_child(unlock_route)
	mark_ui_optimization(unlock_route, "F-529")
	var unlock_fill = make_gpt_plate_rect(rect_full(0.180, 0.900, 0.180 + 0.520 * max(0.08, ratio), 0.955), Color(0.36, 0.58, 0.46, 0.28), "ui_meter_rail_plate")
	unlock_fill.name = "AchievementsUnlockFill"
	art.add_child(unlock_fill)
	var unlock_source = make_gpt_plate_rect(rect_full(0.150, 0.880, 0.190, 0.980), Color(0.86, 0.66, 0.30, 0.30), "ui_button_face_plate")
	unlock_source.name = "AchievementsUnlockSource"
	art.add_child(unlock_source)
	for i in range(5):
		var left = 0.240 + float(i) * 0.088
		var lit = ratio >= float(i + 1) / 5.0
		var node = make_gpt_plate_rect(rect_full(left, 0.760, left + 0.018, 0.808), Color(0.86, 0.66, 0.28, 0.17 if lit else 0.06), "ui_button_face_plate")
		node.name = "AchievementsProgressNode_%d" % i
		art.add_child(node)
	art.move_child(summary_backplate, max(0, art.get_child_count() - 3))
	art.move_child(summary_label, max(0, art.get_child_count() - 2))
	art.move_child(detail_label, max(0, art.get_child_count() - 1))
	return art


func draw_achievements_gallery_scan_art(parent: Control) -> Control:
	# r212: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsGalleryScanArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.055, 0.112, 0.945, 0.318))
	parent.add_child(art)
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var source = make_gpt_edge_rail(rect_full(0.035, 0.210, 0.082, 0.620), Color(gold.r, gold.g, gold.b, 0.18 + ratio * 0.08))
	source.name = "AchievementsGalleryScanSource"
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.085, 0.385, 0.865, 0.480), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "AchievementsGalleryScanRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.920 * max(0.08, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.26))
	fill.name = "AchievementsGalleryScanFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.845, 0.260, 0.910, 0.620), Color(gold.r, gold.g, gold.b, 0.18 + ratio * 0.10))
	gate.name = "AchievementsGalleryScanGate"
	art.add_child(gate)
	var archive = make_gpt_gate(rect_full(0.760, 0.610, 0.890, 0.895), Color(gold.r, gold.g, gold.b, 0.12 + ratio * 0.08))
	archive.name = "AchievementsGalleryArchive"
	art.add_child(archive)
	var archive_glyph = make_label(archive, "藏", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	archive_glyph.name = "AchievementsGalleryArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(5):
		var strength = clamp(ratio + float(i) * 0.035, 0.08, 1.0)
		var left = 0.175 + float(i) * 0.125
		var node = make_gpt_gate(rect_full(left, 0.260, left + 0.030, 0.625), Color(gold.r, gold.g, gold.b, 0.10 + strength * 0.16))
		node.name = "AchievementsGalleryScanNode_%d" % i
		art.add_child(node)
		var branch = make_gpt_edge_rail(rect_full(left + 0.012, 0.135, left + 0.020, 0.300), Color(jade.r, jade.g, jade.b, 0.08 + strength * 0.10))
		branch.name = "AchievementsGalleryScanBranch_%d" % i
		art.add_child(branch)
	var tick = add_gpt_tick_strip(art, rect_full(0.325, 0.180, (0.325) + float(3) * (0.105) + (0.014), 0.705), Color(jade.r, jade.g, jade.b, 0.23), "AchievementsGalleryScanTick_0")
	if fx_enabled_effective():
		art.modulate.a = 0.88
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "anchor_right", 0.975, 0.94).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.47).from(0.92)
		tw.tween_property(fill, "anchor_right", 0.025 + 0.920 * max(0.08, ratio), 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.47).from(0.48)
	return art


func draw_achievements_row_collection_bus_art(parent: Control) -> Control:
	# r208: GPT chrome conversion
	var total = max(1, achievements.size())
	var unlocked = unlocked_achievement_count()
	var ratio = clamp(float(unlocked) / float(total), 0.0, 1.0)
	var art = Control.new()
	art.name = "AchievementsRowCollectionBusArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.055, 0.325, 0.945, 0.935))
	parent.add_child(art)
	parent.move_child(art, max(0, art.get_index() - 1))
	var gold = Color(0.90, 0.70, 0.30)
	var jade = Color(0.72, 0.56, 0.32)
	var spine = make_gpt_edge_rail(rect_full(0.955, 0.030, 0.982, 0.900), Color(0.006, 0.016, 0.018, 0.42))
	spine.name = "AchievementsRowCollectionSpine"
	art.add_child(spine)
	var spine_fill = make_gpt_meter_fill(rect_full(0.250, 0.025, 0.750, 0.120 + 0.760 * max(0.06, ratio)), Color(gold.r, gold.g, gold.b, 0.24))
	spine_fill.name = "AchievementsRowCollectionSpineFill"
	spine.add_child(spine_fill)
	var source = make_gpt_gate(rect_full(0.925, 0.010, 0.995, 0.110), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.08))
	source.name = "AchievementsRowCollectionSource"
	art.add_child(source)
	var archive_gate = make_gpt_gate(rect_full(0.905, 0.845, 0.995, 0.960), Color(gold.r, gold.g, gold.b, 0.16 + ratio * 0.10))
	archive_gate.name = "AchievementsRowCollectionArchiveGate"
	art.add_child(archive_gate)
	var archive_glyph = make_label(archive_gate, "藏", 9, Color(0.98, 0.92, 0.66, 0.86), true)
	archive_glyph.name = "AchievementsRowCollectionArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var row_count = min(8, total)
	for i in range(row_count):
		var top = 0.070 + float(i) * (0.760 / max(1, row_count - 1))
		var lit = i < int(ceil(ratio * float(row_count)))
		var branch = make_gpt_route_rail(rect_full(0.760, top + 0.032, 0.960, top + 0.062), Color(0.006, 0.016, 0.018, 0.34))
		branch.name = "AchievementsRowCollectionBranch_%d" % i
		art.add_child(branch)
		var branch_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760 if lit else 0.360, 0.750), Color(gold.r, gold.g, gold.b, 0.20 if lit else 0.10))
		branch_fill.name = "AchievementsRowCollectionBranchFill_%d" % i
		branch.add_child(branch_fill)
		var node = make_gpt_gate(rect_full(0.736, top, 0.780, top + 0.095), Color(jade.r, jade.g, jade.b, 0.20 if lit else 0.10))
		node.name = "AchievementsRowCollectionNode_%d" % i
		art.add_child(node)
	var tick = add_gpt_tick_strip(art, rect_full(0.970, 0.175, 0.985, (0.175) + float(3) * (0.150) + (0.060)), Color(gold.r, gold.g, gold.b, 0.22), "AchievementsRowCollectionTick_0")
	var progress_route = make_gpt_route_rail(rect_full(0.520, 0.895, 0.925, 0.945), Color(0.006, 0.016, 0.018, 0.38))
	progress_route.name = "AchievementsRowCollectionProgressRoute"
	art.add_child(progress_route)
	var progress_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.080 + 0.760 * max(0.06, ratio), 0.750), Color(jade.r, jade.g, jade.b, 0.22))
	progress_fill.name = "AchievementsRowCollectionProgressFill"
	progress_route.add_child(progress_fill)
	var progress_gate = make_gpt_gate(rect_full(0.500, 0.855, 0.555, 0.985), Color(jade.r, jade.g, jade.b, 0.16 + ratio * 0.08))
	progress_gate.name = "AchievementsRowCollectionProgressGate"
	art.add_child(progress_gate)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.820 + float(i) * 0.040, 0.946, 0.842 + float(i) * 0.040, 0.984), Color(gold.r, gold.g, gold.b, 0.20 - float(i) * 0.040))
		pip.name = "AchievementsRowCollectionArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(spine_fill, "modulate:a", 0.38, 0.82).from(0.86)
		tw.parallel().tween_property(progress_fill, "modulate:a", 0.34, 0.82).from(0.82)
		tw.tween_property(spine_fill, "modulate:a", 0.86, 0.82).from(0.38)
		tw.parallel().tween_property(progress_fill, "modulate:a", 0.82, 0.82).from(0.34)
	return art


func draw_action_button_art(button: Button, text: String, color: Color) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "ActionButtonArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	button.add_child(art)
	var role = action_button_visual_role(text)
	var compact_claim_mode := has_pending_claim_window()
	var depth_alpha := 0.62 if compact_claim_mode and role == "pass" else (0.78 if compact_claim_mode else (0.50 if role == "pass" else 0.68))
	var cast_shadow = make_soft_depth_panel(button, rect_full(0.040, 0.120, 0.990, 1.040), Color(0.0, 0.0, 0.0, 0.18 if compact_claim_mode else 0.26), 10)
	cast_shadow.name = "ActionButton3DCastShadow"
	button.move_child(cast_shadow, 0)
	var depth_edge = make_gpt_plate_rect(rect_full(0.028, 0.640, 0.972, 0.975), Color(0.010, 0.012, 0.010, depth_alpha), "ui_button_face_plate")
	depth_edge.name = "ActionButton3DDepthEdge"
	button.add_child(depth_edge)
	button.move_child(depth_edge, min(1, button.get_child_count() - 1))
	var top_rim = make_gpt_ribbon(rect_full(0.050, 0.040, 0.950, 0.155), Color(1.0, 0.94, 0.70, 0.180 if compact_claim_mode else 0.100))
	top_rim.name = "ActionButton3DTopRim"
	button.add_child(top_rim)
	var side_bevel = make_gpt_edge_rail(rect_full(0.020, 0.180, 0.065, 0.820), Color(1.0, 0.92, 0.62, 0.075 if compact_claim_mode else 0.055))
	side_bevel.name = "ActionButton3DSideBevel"
	button.add_child(side_bevel)
	if compact_claim_mode:
		# A restrained authored right/bottom edge keeps 55px claim targets visually
		# separable without widening the wrapped lane or painting a native slab.
		var compact_right_edge = make_gpt_edge_rail(rect_full(0.935, 0.180, 0.980, 0.820), Color(color.r, color.g, color.b, 0.32 if role == "pass" else 0.52))
		compact_right_edge.name = "ActionButtonCompactRightEdge"
		button.add_child(compact_right_edge)
		var compact_bottom_edge = make_gpt_ribbon(rect_full(0.080, 0.875, 0.920, 0.945), Color(color.r, color.g, color.b, 0.24 if role == "pass" else 0.40))
		compact_bottom_edge.name = "ActionButtonCompactBottomEdge"
		button.add_child(compact_bottom_edge)
	apply_rect(art, rect_full(0.036, 0.230, 0.176, 0.770) if compact_claim_mode else rect_full(0.030, 0.120, 0.245, 0.880))
	var is_focus_action = ["win", "gang", "safe", "advice", "next"].has(role) or text.begins_with("荐")
	var seal_alpha = 0.016 if compact_claim_mode and role == "pass" else (0.032 if compact_claim_mode and is_focus_action else (0.024 if compact_claim_mode else (0.070 if role == "pass" else (0.155 if is_focus_action else 0.105))))
	var seal_border_alpha = 0.020 if compact_claim_mode and role == "pass" else (0.038 if compact_claim_mode and is_focus_action else (0.026 if compact_claim_mode else (0.080 if role == "pass" else (0.135 if is_focus_action else 0.090))))
	var simple_seal = make_gpt_gate(rect_full(0.060, 0.165, 0.640, 0.835), Color(color.r, color.g, color.b, seal_alpha))
	simple_seal.name = "ActionButtonSeal"
	art.add_child(simple_seal)
	var simple_mark_alpha = 0.42 if compact_claim_mode and role == "pass" else (0.52 if compact_claim_mode else (0.78 if role == "pass" else 0.86))
	var simple_mark = make_label(simple_seal, action_button_fallback_icon_text(role, text), 8 if compact_claim_mode else 10, Color(0.94, 0.88, 0.70, simple_mark_alpha), true)
	simple_mark.name = "ActionButtonFallbackIcon"
	apply_rect(simple_mark, rect_full(0.0, 0.0, 1.0, 1.0))
	var sheen_alpha = 0.006 if compact_claim_mode and role == "pass" else (0.010 if compact_claim_mode else (0.026 if role == "pass" else 0.040))
	var sheen = make_gpt_route_rail(rect_full(0.060, 0.075, 0.940, 0.155), Color(1.0, 0.96, 0.76, sheen_alpha))
	sheen.name = "ActionButtonSheen"
	button.add_child(sheen)
	var priority_mark = action_button_priority_mark(role)
	if priority_mark != "":
		var priority_alpha = 0.36 if compact_claim_mode else (0.62 if role == "pass" else 0.78)
		var seal = make_label(button, priority_mark, 8 if compact_claim_mode else 10, Color(0.98, 0.90, 0.62, priority_alpha), true)
		seal.name = "ActionButtonPrioritySeal"
		apply_rect(seal, rect_full(0.740, 0.145, 0.940, 0.455))
	var shortcut_hint := action_button_shortcut_hint(text)
	if shortcut_hint != "":
		var shortcut_label = make_label(button, shortcut_hint, 9 if compact_claim_mode else 10, Color(0.96, 0.90, 0.68, 0.76), true)
		shortcut_label.name = "ActionButtonShortcutHint"
		shortcut_label.tooltip_text = "快捷键 %s" % shortcut_hint
		shortcut_label.set_meta("accessible_name", "快捷键：" + shortcut_hint)
		shortcut_label.set_meta("ui_shortcut_hint", shortcut_hint)
		apply_rect(shortcut_label, rect_full(0.690, 0.018, 0.965, 0.180))
		shortcut_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		configure_clipped_label(shortcut_label)
	var response_alpha = 0.002 if compact_claim_mode and role == "pass" else (0.004 if compact_claim_mode else (0.020 if role == "pass" else 0.050))
	var response_texture = add_illustration_texture(button, "claim_response_orbit", rect_full(-0.030, -0.120, 1.030, 1.120), response_alpha, false)
	if response_texture != null:
		response_texture.name = "ActionButtonResponseTexture_%s" % role
		button.move_child(response_texture, 0)
	var rail_alpha = 0.10 if compact_claim_mode and role == "pass" else (0.18 if compact_claim_mode else (0.42 if role == "pass" else 0.58))
	var role_rail = add_optional_gpt_illustration_texture(button, "ui_action_role_rail", rect_full(0.000, 0.120, 0.034, 0.880), rail_alpha, false)
	if role_rail != null:
		role_rail.name = "ActionButtonRoleRail"
		role_rail.modulate = Color(color.r, color.g, color.b, rail_alpha)
	# Compact claims use the authored action plate as their distinct dark face.
	var panel_alpha = 0.28 if compact_claim_mode and role == "pass" else (0.66 if compact_claim_mode and is_focus_action else (0.56 if compact_claim_mode else (0.42 if role == "pass" else 0.70)))
	var panel_key := "ui_button_face_plate" if compact_claim_mode and is_focus_action else ("ui_dark_scrim" if compact_claim_mode else "ui_button_face_plate")
	var panel_plate = add_optional_gpt_illustration_texture(button, panel_key, rect_full(-0.040, -0.040, 1.040, 1.040), panel_alpha, false)
	if panel_plate == null:
		panel_plate = add_optional_gpt_illustration_texture(button, "ui_dark_scrim", rect_full(-0.040, -0.040, 1.040, 1.040), panel_alpha, false)
	if panel_plate != null:
		panel_plate.name = "ActionButtonPanelPlate"
		var compact_panel_tint := Color(
			clampf(0.34 + color.r * 0.42, 0.18, 0.82),
			clampf(0.30 + color.g * 0.38, 0.18, 0.76),
			clampf(0.24 + color.b * 0.30, 0.16, 0.66),
			panel_alpha
		) if compact_claim_mode else Color(
			clampf(0.40 + color.r * 0.60, 0.20, 1.2),
			clampf(0.40 + color.g * 0.60, 0.20, 1.2),
			clampf(0.40 + color.b * 0.60, 0.20, 1.2),
			panel_alpha
		)
		panel_plate.modulate = Color(
			compact_panel_tint.r,
			compact_panel_tint.g,
			compact_panel_tint.b,
			compact_panel_tint.a
		)
		button.move_child(panel_plate, 0)
	if action_button_should_pulse(role):
		var pulse_strength = action_button_pulse_strength(role)
		var pulse_scale = 0.28 if compact_claim_mode else 1.0
		var pulse = make_gpt_tick_strip(rect_full(0.012, 0.090, 0.988, 0.910), Color(color.r, color.g, color.b, (0.050 + 0.020 * pulse_strength) * pulse_scale))
		pulse.name = "ActionButtonPulse"
		button.add_child(pulse)
		button.move_child(pulse, 0)
		if fx_enabled_effective():
			var peak = lerp(0.42, 0.84, pulse_strength)
			var trough = lerp(0.10, 0.25, pulse_strength)
			var pulse_tw := create_screen_tween()
			pulse_tw.set_loops(12)
			pulse_tw.tween_property(pulse, "modulate:a", trough, 0.64).from(peak)
			pulse_tw.tween_property(pulse, "modulate:a", peak, 0.64).from(trough)
	# Button native text is painted by the parent CanvasItem. Keep every authored
	# decorative child behind it so compact claim labels remain crisp in all states.
	for child in button.get_children():
		if child is CanvasItem:
			(child as CanvasItem).show_behind_parent = true
	button.button_down.connect(func() -> void:
		if not is_instance_valid(button):
			return
		var tw := button.create_tween()
		tw.tween_property(button, "scale", Vector2(0.94, 0.94), 0.04).from(button.scale)
		tw.chain().tween_property(button, "scale", Vector2(1.0, 1.0), 0.12).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		play_action_button_press_feedback(button, role, color)
	)
	return art


func draw_action_button_decision_bridge(button: Button, role: String, color: Color) -> Control:
	# 按钮内装饰碎块已替换为可选 action_button_panel 插画底板，此函数保留为空壳以兼容历史调用点。
	return null

func draw_action_button_pass_route(button: Button, color: Color) -> Control:
	# 保留为空壳；过按钮装饰碎块已并入 action_button_panel 插画底板。
	return null

func draw_action_dock(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var count = action_bar_button_count()
	if count <= 0:
		return
	var pending_claim_mode = has_pending_claim_window()
	var danger_confirm_mode = mode == "offline" and has_pending_danger_discard()
	var ended_action_mode := (mode == "offline" and offline_phase == "ended") or (mode == "online_game" and str(online_game.get("phase", "")) == "ended")
	if not pending_claim_mode and not danger_confirm_mode and not ended_action_mode:
		draw_action_intent_dock(parent, count)
	# r451c: translucent lacquer shell + GPT dock plate on top (no jade program slabs).
	var dock_rect := action_dock_rect_for_count(count)
	var dock_shadow_rect := Rect2(dock_rect.position + Vector2(0.005, 0.012), dock_rect.size + Vector2(0.006, 0.010))
	var dock_shadow = make_soft_depth_panel(parent, dock_shadow_rect, Color(0.0, 0.0, 0.0, 0.18 if pending_claim_mode else 0.22), 12)
	dock_shadow.name = "ActionDock3DCastShadow"
	var dock = make_gpt_center_crop_plate_rect(dock_rect, Color(0.018, 0.026, 0.024, 0.78), "ui_dark_scrim", 0.20)
	dock.name = "ActionButtonDock"
	parent.add_child(dock)
	# Action buttons have a small press/focus lift. Keep the dock as a visual host
	# so its edge cannot crop the first or last focus ring.
	dock.clip_contents = true
	dock.set_meta("focus_gutter_px", 6.0)
	dock.set_meta("hit_rect_stable", true)
	dock.set_meta("layout_rect", dock_rect)
	dock.set_meta("layout_role", "action_buttons")
	set_ui_full_text(dock, "行动区：当前可执行操作会显示在下方按钮；焦点可用方向键移动", "牌桌行动区")
	mark_ui_optimization(dock, "F-478")
	var action_buttons = action_bar_buttons()
	var dock_rear = make_soft_depth_panel(dock, rect_full(0.012, 0.040, 0.988, 0.980), Color(0.08, 0.055, 0.035, 0.12), 10)
	dock_rear.name = "ActionDock3DRearShell"
	dock.move_child(dock_rear, 0)
	var dock_floor = make_layout_host(rect_full(0.018, 0.620, 0.982, 0.920))
	dock_floor.name = "ActionDockPhysicalFloor"
	dock.add_child(dock_floor)
	# Gold accent only — thin rim, not mid-band occluder.
	var apron_rim = make_gpt_ribbon(rect_full(0.035, 0.705, 0.965, 0.760), Color(1.0, 0.92, 0.56, 0.22))
	apron_rim.name = "ActionDock3DFrontApron"
	dock.add_child(apron_rim)
	var jade_track = make_layout_host(rect_full(0.050, 0.250, 0.950, 0.330))
	jade_track.name = "ActionDock3DJadeTrack"
	dock.add_child(jade_track)
	var lower_reflection = make_layout_host(rect_full(0.070, 0.900, 0.930, 0.960))
	lower_reflection.name = "ActionDock3DLowerReflection"
	dock.add_child(lower_reflection)
	if pending_claim_mode:
		var pending_dock_texture = add_optional_gpt_illustration_texture(dock, "pending_claim_action_dock", rect_full(0.002, 0.010, 0.998, 0.990), 0.24, false)
		if pending_dock_texture != null:
			pending_dock_texture.name = "PendingClaimActionGPTDockTexture"
			pending_dock_texture.modulate = Color(1.0, 1.0, 1.0, 0.16)
			dock.move_child(pending_dock_texture, dock.get_child_count() - 1)
	else:
		var dock_texture = add_optional_gpt_illustration_texture(dock, "action_gpt_dock", rect_full(0.000, 0.010, 1.000, 0.990), 0.26, false)
		if dock_texture != null:
			dock_texture.name = "ActionGPTDockTexture"
			dock_texture.modulate = Color(1.0, 1.0, 1.0, 0.46)
			dock.move_child(dock_texture, dock.get_child_count() - 1)
		# r452b: GPT title plate + soft flash mid-band (no program jade).
		# r184: light mid-band only — keep action_gpt_dock micro-detail readable.
		var mid_plate = make_gpt_plate_rect(rect_full(0.018, 0.150, 0.982, 0.850), Color(0.98, 0.93, 0.80, 0.07), "ui_title_backplate")  # r189 reveal denser dock
		mid_plate.name = "ActionDockMidBandPlate"
		dock.add_child(mid_plate)
		var mid_wash = make_gpt_plate_rect(rect_full(0.030, 0.180, 0.970, 0.820), Color(1.0, 0.95, 0.80, 0.035), "ui_soft_flash")  # r189 lighter wash
		mid_wash.name = "ActionDockMidBandWash"
		dock.add_child(mid_wash)
		var track_texture = add_optional_gpt_illustration_texture(dock, "action_dock_track_panel", rect_full(0.010, 0.120, 0.990, 0.900), 0.22, false)  # r221 denser track
		if track_texture != null:
			track_texture.name = "ActionDockTrackPanelTexture"
			dock.move_child(track_texture, dock.get_child_count() - 1)
	if pending_claim_auto_pass_feedback != "" and pending_claim_auto_pass_feedback_until_msec > Time.get_ticks_msec():
		var auto_pass_label := make_label(dock, pending_claim_auto_pass_feedback, 10, Color(1.0, 0.84, 0.52), true)
		auto_pass_label.name = "PendingClaimAutoPassFeedback"
		apply_rect(auto_pass_label, rect_full(0.055, 0.035, 0.945, 0.225))
		auto_pass_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		auto_pass_label.tooltip_text = "响应窗口已结束，系统已提交“过”"
		auto_pass_label.set_meta("accessible_name", pending_claim_auto_pass_feedback)
		configure_clipped_label(auto_pass_label)
	for focus_button in action_buttons:
		if focus_button is Button:
			(focus_button as Button).focus_entered.connect(Callable(self, "update_action_dock_focus_label").bind((focus_button as Button).get_instance_id()))
			mark_ui_optimization(focus_button as Control, "F-479")
	var status_text := ""
	var status_tooltip := ""
	var status_color := Color(0.92, 0.90, 0.72, 0.76)
	var status_priority := false
	if mode == "online_game" and online_waiting_for_server:
		status_text = "同步中 · 等待服务器确认 · 语音/聊天可用"
		status_tooltip = "牌局动作已锁定；语音和聊天仍可用"
		status_color = Color(0.76, 0.86, 0.82, 0.86)
		status_priority = true
	elif mode == "online_game" and online_game_disconnected():
		status_text = online_recovery_status_text() + " · 牌桌只读"
		status_tooltip = online_recovery_detail_text()
		status_color = Color(0.92, 0.76, 0.46, 0.92)
		status_priority = true
	elif mode == "online_game" and online_retry_available:
		status_text = "未响应 · 可重试"
		status_tooltip = "服务器暂未响应，可以重试上一次操作"
		status_color = Color(0.90, 0.76, 0.46, 0.92)
		status_priority = true
	elif not pending_claim_mode and not danger_confirm_mode and not action_buttons.is_empty():
		var first_button := action_buttons[0] as Button
		status_text = "当前焦点 · %s" % first_button.text
		status_tooltip = "方向键按空间位置移动焦点"
	# All action-dock status variants own this one header slot. This keeps a
	# focus hint and a network recovery message mutually exclusive.
	if status_text != "":
		var status_slot := make_label(dock, status_text, 10, status_color, true)
		status_slot.name = "ActionDockStatusLabel"
		status_slot.set_meta("ui_action_status_slot", true)
		status_slot.set_meta("ui_action_status_priority", status_priority)
		status_slot.set_meta("action_dock_state", "priority" if status_priority else ("focus" if not action_buttons.is_empty() else "idle"))
		status_slot.set_meta("action_dock_action_count", action_buttons.size())
		status_slot.set_meta("action_dock_pending_claim", pending_claim_mode)
		mark_ui_optimization(status_slot, "F-620")
		apply_rect(status_slot, rect_full(0.055, 0.035, 0.945, 0.225))
		status_slot.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		status_slot.tooltip_text = status_tooltip
		set_ui_full_text(status_slot, status_text, status_tooltip if status_tooltip != "" else status_text)
		configure_clipped_label(status_slot)
	parent.move_child(dock_shadow, max(0, action_bar.get_index()))
	parent.move_child(dock, max(0, action_bar.get_index()))


func draw_action_intent_command_bridge(parent: Control, count: int, color: Color) -> Control:
	# 装饰碎块已并入 intent_panel_plate 插画底板；保留空壳兼容历史调用点。
	return null

func draw_action_intent_decision_pulse(parent: Control, count: int, color: Color) -> Control:
	# 装饰碎块已并入 intent_panel_plate 插画底板；保留空壳兼容历史调用点。
	return null

func draw_action_intent_dock(parent: Control, count: int, force_icon_fallback := false) -> Control:
	# r214: bulk GPT chrome sweep
	var intent = make_gpt_plate_rect(action_intent_rect_for_count(count), Color(0.020, 0.036, 0.038, 0.88), "ui_jade_reading_plate")
	intent.name = "ActionIntentDock"
	parent.add_child(intent)
	intent.set_meta("layout_rect", action_intent_rect_for_count(count))
	intent.set_meta("layout_role", "action_intent")
	var action_texture = add_illustration_texture(intent, "action_dock_ribbon", rect_full(0.010, 0.040, 0.990, 0.960), 0.13, false)
	if action_texture != null:
		action_texture.name = "ActionDockRibbonTexture"
		intent.move_child(action_texture, 0)
	var intent_plate = add_optional_gpt_illustration_texture(intent, "intent_panel_plate", rect_full(-0.02, 0.04, 1.02, 0.96), 0.22, false)
	if intent_plate != null:
		intent_plate.name = "IntentPanelPlate"
		intent.move_child(intent_plate, min(0, intent.get_child_count() - 1))
	var color = action_intent_color()
	var rail = make_gpt_route_rail(rect_full(0.012, 0.18, 0.028, 0.82), color)
	rail.name = "ActionIntentRail"
	intent.add_child(rail)
	var icon_name = action_intent_icon_name()
	var intent_icon = null if force_icon_fallback else add_lucide_icon(intent, icon_name, rect_full(0.045, 0.18, 0.118, 0.82), color.lightened(0.22))
	if intent_icon != null:
		intent_icon.name = "ActionIntentIcon"
	else:
		var fallback = make_label(intent, action_intent_fallback_icon_text(), 12, color.lightened(0.22), true)
		fallback.name = "ActionIntentFallbackIcon"
		apply_rect(fallback, rect_full(0.045, 0.16, 0.118, 0.84))
	var text = make_label(intent, action_intent_text(count), 11, Color(0.84, 0.90, 0.84), true)
	text.name = "ActionIntentText"
	var intent_detail := action_intent_text(count)
	if mode == "online_game" and online_game_disconnected():
		intent_detail = online_recovery_detail_text()
		text.tooltip_text = intent_detail
	apply_rect(text, rect_full(0.130, 0.10, 0.845, 0.90))
	text.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(text)
	set_ui_full_text(text, intent_detail, "当前行动提示")
	mark_ui_optimization(text, "F-448")
	var intent_count_text := "重连" if mode == "online_game" and online_game_disconnected() else "%d项" % count
	var count_badge = make_badge(intent, rect_full(0.858, 0.18, 0.982, 0.82), intent_count_text, 10, color.darkened(0.20), color.lightened(0.12), Color(0.96, 0.95, 0.84))
	count_badge.name = "ActionIntentCount"
	set_ui_full_text(count_badge, "%d 个可执行操作" % count, "可执行操作数量")
	mark_ui_optimization(count_badge, "F-449")
	rail.modulate = Color(1, 1, 1, 0.80)
	return intent


func draw_action_intent_exit_route(parent: Control, count: int, color: Color) -> Control:
	# 装饰碎块已并入 intent_panel_plate 插画底板；保留空壳兼容历史调用点。
	return null

func draw_action_intent_flow(parent: Control, count: int, color: Color) -> Control:
	# 装饰碎块已并入 intent_panel_plate 插画底板；保留空壳兼容历史调用点。
	return null

func draw_actions(parent: Control) -> void:
	var pending_claim_response_bar: Control = null
	var pending_claim_tail_bar: HBoxContainer = null
	var pending_claim_response_tail_lane: HBoxContainer = null
	var pending_claim_network_lane: HBoxContainer = null
	var pending_claim_voice_lane: HBoxContainer = null
	if mode == "online_game" and not online_game_disconnected():
		draw_chat_action_button(parent)
	if online_game_disconnected():
		var reconnecting := online_recovery_connecting()
		var recovery_state := make_label(parent, online_recovery_phase_text(), 11, Color(0.98, 0.82, 0.52), true)
		recovery_state.name = "OnlineRecoveryStateLabel"
		apply_rect(recovery_state, rect_full(0.535, 0.630, 0.970, 0.680))
		recovery_state.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		recovery_state.mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_ui_full_text(recovery_state, "%s；%s" % [online_recovery_phase_text(), online_recovery_detail_text()], "断线恢复阶段")
		recovery_state.set_meta("recovery_phase", "connecting" if reconnecting else ("cooldown" if online_next_reconnect_msec > Time.get_ticks_msec() else "retry_ready"))
		recovery_state.set_meta("recovery_attempt", maxi(online_reconnect_attempts, 1))
		recovery_state.set_meta("recovery_reason", online_recovery_reason_text())
		recovery_state.set_meta("state_owner", "online_recovery_phase_and_reason")
		mark_ui_optimization(recovery_state, "F-891")
		mark_ui_optimization(recovery_state, "F-892")
		mark_ui_optimization(recovery_state, "F-897")
		var reconnect_button := make_action_button(online_recovery_button_text(), Color(0.36, 0.62, 0.72), Callable(self, "reconnect_online_game"))
		reconnect_button.name = "OnlineReconnectGameButton"
		reconnect_button.disabled = reconnecting
		reconnect_button.tooltip_text = online_recovery_detail_text()
		reconnect_button.set_meta("focus_fallback_name", "OnlineDisconnectedLobbyButton")
		reconnect_button.set_meta("disabled_reason", "正在重新连接房间，请稍候" if reconnecting else "")
		set_ui_full_text(reconnect_button, reconnect_button.tooltip_text, "恢复当前牌局：" + reconnect_button.tooltip_text)
		reconnect_button.set_meta("action_priority", "primary")
		reconnect_button.set_meta("recovery_status", online_recovery_button_text())
		reconnect_button.set_meta("recovery_phase", "connecting" if reconnecting else ("cooldown" if online_next_reconnect_msec > Time.get_ticks_msec() else "retry_ready"))
		reconnect_button.set_meta("recovery_attempt", maxi(online_reconnect_attempts, 1))
		reconnect_button.set_meta("recovery_retry_available", not reconnecting)
		reconnect_button.set_meta("recovery_phase_text", online_recovery_phase_text())
		reconnect_button.set_meta("recovery_reason", online_recovery_reason_text())
		reconnect_button.set_meta("recovery_focus_route", "primary_reconnect_then_preserved_lobby")
		mark_ui_optimization(reconnect_button, "F-067")
		mark_ui_optimization(reconnect_button, "F-107")
		mark_ui_optimization(reconnect_button, "F-893")
		mark_ui_optimization(reconnect_button, "F-894")
		action_bar = HBoxContainer.new()
		action_bar.alignment = BoxContainer.ALIGNMENT_END
		configure_passive_container(action_bar)
		apply_rect(action_bar, action_bar_layout_rect())
		parent.add_child(action_bar)
		action_bar.add_child(reconnect_button)
		reconnect_button.set_meta("recovery_route", true)
		reconnect_button.set_meta("min_touch_size", Vector2(ACTION_BUTTON_MIN_TOUCH_WIDTH, ACTION_BUTTON_HEIGHT))
		var lobby_button := make_action_button("大厅", Color(0.46, 0.52, 0.56), Callable(self, "show_online_lobby").bind(true))
		lobby_button.name = "OnlineDisconnectedLobbyButton"
		lobby_button.tooltip_text = "返回联机大厅，保留当前牌局以便稍后重连"
		set_ui_full_text(lobby_button, lobby_button.tooltip_text, "断线恢复：返回联机大厅")
		lobby_button.set_meta("recovery_route", true)
		lobby_button.set_meta("action_priority", "secondary")
		lobby_button.set_meta("non_game_action", true)
		lobby_button.set_meta("recovery_route", "return_to_lobby_with_resume_context")
		lobby_button.text = "大厅 · 保留牌局"
		lobby_button.tooltip_text = "返回联机大厅，但保留当前牌局上下文以便稍后重连"
		mark_ui_optimization(lobby_button, "F-108")
		mark_ui_optimization(lobby_button, "F-895")
		set_ui_full_text(lobby_button, lobby_button.tooltip_text, "断线恢复：返回联机大厅并保留牌局")
		mark_ui_optimization(lobby_button, "F-898")
		lobby_button.set_meta("min_touch_size", Vector2(ACTION_BUTTON_MIN_TOUCH_WIDTH, ACTION_BUTTON_HEIGHT))
		action_bar.add_child(lobby_button)
		draw_action_dock(parent)
		finalize_action_bar_layout()
		action_bar.set_meta("layout_role", "online_recovery_actions")
		action_bar.set_meta("recovery_state_owner", "OnlineRecoveryStateLabel")
		action_bar.set_meta("recovery_focus_order", "reconnect_then_lobby")
		mark_ui_optimization(action_bar, "F-899")
		var recovery_dock := parent.find_child("ActionButtonDock", true, false) as Control
		action_bar.z_index = 20
		if recovery_dock != null:
			action_bar.z_index = max(20, recovery_dock.z_index + 1)
		configure_ordered_focus_navigation(action_bar, [reconnect_button, lobby_button], "OnlineReconnectGameButton")
		call_deferred("focus_named_control", "OnlineReconnectGameButton")
		return
	if mode == "online_game" and str(online_game.get("phase", "")) == "unknown":
		var unknown_retry := make_action_button("重试", Color(0.86, 0.48, 0.30), Callable(self, "reconnect_online_game"))
		unknown_retry.name = "OnlineUnknownPhaseRetryButton"
		unknown_retry.set_meta("action_priority", "primary")
		unknown_retry.tooltip_text = "重新同步牌局状态，当前牌局动作已锁定"
		var unknown_lobby := make_action_button("大厅", Color(0.48, 0.54, 0.56), Callable(self, "show_online_lobby"))
		unknown_lobby.name = "OnlineUnknownPhaseLobbyButton"
		unknown_lobby.tooltip_text = "返回联机大厅"
		action_bar = HBoxContainer.new()
		action_bar.name = "OnlineUnknownPhaseActions"
		action_bar.alignment = BoxContainer.ALIGNMENT_END
		configure_passive_container(action_bar)
		apply_rect(action_bar, action_bar_layout_rect())
		parent.add_child(action_bar)
		action_bar.add_child(unknown_retry)
		action_bar.add_child(unknown_lobby)
		draw_action_dock(parent)
		finalize_action_bar_layout()
		call_deferred("focus_named_control", "OnlineUnknownPhaseRetryButton")
		return
	if has_pending_claim_window():
		var pending_root := VBoxContainer.new()
		pending_root.name = "PendingClaimActionStack"
		# Keep the response stack anchored at the top of its reserved lane. The
		# remaining space becomes deliberate bottom breathing room instead of
		# pushing the tail action against the dock edge on 960x540.
		pending_root.alignment = BoxContainer.ALIGNMENT_BEGIN
		pending_root.add_theme_constant_override("separation", 4)
		pending_root.set_meta("wall_gutter_px", 8.0)
		pending_root.set_meta("context_surface", "reading_lane_outside_wall_texture")
		var grid_bar := GridContainer.new()
		grid_bar.name = "PendingClaimResponseGrid"
		grid_bar.add_theme_constant_override("h_separation", 4)
		grid_bar.add_theme_constant_override("v_separation", 4)
		grid_bar.custom_minimum_size = Vector2.ZERO
		pending_root.add_child(grid_bar)
		pending_claim_tail_bar = HBoxContainer.new()
		pending_claim_tail_bar.name = "PendingClaimSecondaryLane"
		pending_claim_tail_bar.alignment = BoxContainer.ALIGNMENT_END
		pending_claim_tail_bar.add_theme_constant_override("separation", 3)
		pending_claim_tail_bar.custom_minimum_size = Vector2(0.0, ACTION_BUTTON_HEIGHT)
		pending_claim_tail_bar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		configure_passive_container(pending_claim_tail_bar)
		pending_claim_response_tail_lane = HBoxContainer.new()
		pending_claim_response_tail_lane.name = "PendingClaimResponseTailLane"
		pending_claim_response_tail_lane.add_theme_constant_override("separation", 3)
		configure_passive_container(pending_claim_response_tail_lane)
		pending_claim_network_lane = HBoxContainer.new()
		pending_claim_network_lane.name = "PendingClaimNetworkLane"
		pending_claim_network_lane.add_theme_constant_override("separation", 3)
		configure_passive_container(pending_claim_network_lane)
		pending_claim_voice_lane = HBoxContainer.new()
		pending_claim_voice_lane.name = "PendingClaimVoiceLane"
		pending_claim_voice_lane.add_theme_constant_override("separation", 3)
		configure_passive_container(pending_claim_voice_lane)
		pending_claim_tail_bar.add_child(pending_claim_response_tail_lane)
		pending_claim_tail_bar.add_child(pending_claim_network_lane)
		pending_claim_tail_bar.add_child(pending_claim_voice_lane)
		pending_root.add_child(pending_claim_tail_bar)
		action_bar = pending_root
		pending_claim_response_bar = grid_bar
		mark_ui_optimization(pending_root, "F-480")
	else:
		var row_bar := HBoxContainer.new()
		row_bar.alignment = BoxContainer.ALIGNMENT_END
		action_bar = row_bar
	configure_passive_container(action_bar)
	if not action_bar is GridContainer:
		action_bar.add_theme_constant_override("separation", 6)
	apply_rect(action_bar, action_bar_layout_rect())
	var lane_contract := battle_ui_lane_contract()
	action_bar.set_meta("lane_contract", lane_contract.get("contract", ""))
	action_bar.set_meta("lane_exclusions", lane_contract.get("meld", []))
	action_bar.set_meta("minimum_clearance_px", lane_contract.get("minimum_clearance_px", 6.0))
	mark_ui_optimization(action_bar, "F-031")
	mark_ui_optimization(action_bar, "F-033")
	if has_pending_claim_window():
		action_bar.set_meta("response_lane", "primary_and_secondary")
		action_bar.set_meta("response_summary", pending_claim_focus_text())
		action_bar.set_meta("response_timer_slot", "root_above_action_dock")
		action_bar.set_meta("response_timeout_result", "到0秒自动过")
		mark_ui_optimization(action_bar, "F-032")
		mark_ui_optimization(action_bar, "F-035")
		mark_ui_optimization(action_bar, "F-100")
		mark_ui_optimization(action_bar, "F-101")
	var summary_action_mode := (mode == "offline" and offline_phase == "ended") or (mode == "online_game" and str(online_game.get("phase", "")) == "ended")
	action_bar.z_index = 31 if summary_action_mode else 18
	if summary_action_mode:
		action_bar.name = "RoundSummaryActionRow"
		action_bar.set_meta("layout_role", "external_settlement_action_lane")
		action_bar.set_meta("summary_clearance_px", 12.0)
		action_bar.set_meta("action_owner", "RoundSummaryPanel_external_footer")
	parent.add_child(action_bar)

	# 操作按钮淡入动画
	if fx_enabled_effective():
		action_bar.modulate = Color(1, 1, 1, 0)
		var tw := create_screen_tween()
		tw.tween_property(action_bar, "modulate:a", 1.0, 0.18).from(0.0)

	if mode == "offline":
		if offline_phase == "ended":
			var replay_code_available := round_replay_digest() != "" and validate_round_replay(round_event_history) and round_replay_share_code() != ""
			# The compact action lane cannot fit the full five-character CTA beside
			# the other settlement actions. Keep a specific three-character label on
			# narrow screens; the tooltip retains the complete copy instruction.
			var replay_label := "回放码" if effective_viewport_size().x < 1100.0 or effective_viewport_size().y <= 560.0 else "复制回放码"
			var replay_button = make_action_button(replay_label, Color(0.52, 0.62, 0.42), Callable(self, "copy_round_replay_share_code"))
			replay_button.name = "CopyReplayCodeButton"
			replay_button.set_meta("action_priority", "secondary")
			replay_button.disabled = not replay_code_available
			replay_button.tooltip_text = "复制本局回放码，便于分享或复盘 · %s" % round_replay_status_text()
			action_bar.add_child(replay_button)
			if not is_offline_match_finished():
				var next_hand_button = make_action_button("下一局", Color(0.32, 0.72, 0.60), func() -> void:
					start_next_offline_hand()
				)
				next_hand_button.name = "NextHandPrimaryButton"
				next_hand_button.set_meta("action_priority", "primary")
				next_hand_button.tooltip_text = "继续当前牌局，进入下一局"
				action_bar.add_child(next_hand_button)
			var new_match_button = make_action_button("新赛", Color(0.86, 0.42, 0.32), func() -> void:
				start_new_offline_match()
			)
			new_match_button.name = "NewMatchSecondaryButton"
			new_match_button.set_meta("action_priority", "primary" if is_offline_match_finished() else "secondary")
			action_bar.add_child(new_match_button)
			var summary_menu_button = make_action_button("菜单", Color(0.48, 0.54, 0.56), func() -> void:
				show_menu()
			)
			summary_menu_button.name = "SummaryMenuSecondaryButton"
			summary_menu_button.set_meta("action_priority", "secondary")
			summary_menu_button.mouse_filter = Control.MOUSE_FILTER_STOP
			summary_menu_button.z_index = 2
			action_bar.add_child(summary_menu_button)
			prepare_ended_action_overflow(parent)
			draw_action_dock(parent)
			finalize_action_bar_layout()
			return
		if offline_phase == "pending_claim":
			# 新手引导：吃碰杠提示
			if interactive_guide_active and interactive_guide_type == "claim":
				show_toast("💡 对手打出了一张牌，你可以选择吃/碰/杠/胡或过")
			var claim_recommendation = recommended_claim_report() if player_ai_assist_enabled() else {}
			for claim in ordered_pending_claim_options(offline_pending_claim.get("options", []), claim_recommendation):
				var claim_name = str(claim)
				if claim_name == "chi":
					var chi_choices: Array = ordered_pending_chi_choices(offline_pending_claim.get("chi_choices", []), claim_recommendation)
					if chi_choices.is_empty():
						var is_recommended_claim = is_recommended_claim_action(claim_name, {}, claim_recommendation)
						pending_claim_response_bar.add_child(make_action_button(compact_pending_claim_action_text(claim_name, {}, claim_recommendation), claim_action_button_color(claim_name, is_recommended_claim), func() -> void:
							human_claim(claim_name)
						))
					else:
						for choice in chi_choices:
							var selected_choice: Dictionary = choice
							var is_recommended_choice = is_recommended_claim_action(claim_name, selected_choice, claim_recommendation)
							pending_claim_response_bar.add_child(make_action_button(compact_pending_claim_action_text(claim_name, selected_choice, claim_recommendation), claim_action_button_color(claim_name, is_recommended_choice), func() -> void:
								human_claim("chi", selected_choice)
							))
				else:
					var is_recommended_claim = is_recommended_claim_action(claim_name, {}, claim_recommendation)
					pending_claim_response_bar.add_child(make_action_button(compact_pending_claim_action_text(claim_name, {}, claim_recommendation), claim_action_button_color(claim_name, is_recommended_claim), func() -> void:
						human_claim(claim_name)
					))
			var offline_pass_button := make_action_button(compact_pass_claim_button_text(claim_recommendation), pass_claim_button_color(claim_recommendation), func() -> void:
				human_claim("pass")
			)
			if offline_pass_button != null:
				offline_pass_button.set_meta("pending_tail", true)
				pending_claim_response_tail_lane.add_child(offline_pass_button)
			draw_pending_claim_illustration(parent)
			draw_action_dock(parent)
			finalize_action_bar_layout()
			return
		if player_ai_assist_enabled() and has_pending_danger_discard():
			var selected_danger_tile = pending_danger_discard_tile
			var danger_alternatives = safe_discard_alternative_reports(selected_danger_tile, 2)
			var confirm_danger_button = make_action_button("确认打%s" % tile_label(selected_danger_tile), Color(0.86, 0.34, 0.24), func() -> void:
				human_discard_by_tile(selected_danger_tile)
			)
			confirm_danger_button.name = "DangerDiscardConfirmButton"
			confirm_danger_button.tooltip_text = "确认打出%s · Enter" % tile_label(selected_danger_tile)
			confirm_danger_button.set_meta("danger_action", "confirm")
			confirm_danger_button.set_meta("shortcut_state", "Enter")
			confirm_danger_button.set_meta("shortcut_visibility", "independent_state_field_and_tooltip")
			confirm_danger_button.set_meta("danger_prompt_lane", "dedicated_confirmation_lane")
			set_ui_full_text(confirm_danger_button, confirm_danger_button.tooltip_text, "危险弃牌确认")
			mark_ui_optimization(confirm_danger_button, "F-096")
			mark_ui_optimization(confirm_danger_button, "F-099")
			action_bar.add_child(confirm_danger_button)
			for report in danger_alternatives:
				var alternative_tile = str(report.get("tile", ""))
				if alternative_tile == "":
					continue
				var selected_alternative_tile = alternative_tile
				action_bar.add_child(make_action_button("改打%s" % tile_label(selected_alternative_tile), safe_discard_button_color(report), func() -> void:
					human_discard_by_tile(selected_alternative_tile)
				))
			var cancel_danger_button := make_action_button("取消", Color(0.52, 0.56, 0.58), func() -> void:
				clear_pending_danger_discard()
				set_status(current_status_text())
				render_game()
			)
			cancel_danger_button.name = "DangerDiscardCancelButton"
			cancel_danger_button.tooltip_text = "取消危险弃牌确认 · Esc"
			cancel_danger_button.set_meta("danger_action", "cancel")
			cancel_danger_button.set_meta("shortcut_state", "Esc")
			cancel_danger_button.set_meta("shortcut_visibility", "independent_state_field_and_tooltip")
			cancel_danger_button.set_meta("danger_prompt_lane", "dedicated_confirmation_lane")
			set_ui_full_text(cancel_danger_button, cancel_danger_button.tooltip_text, "危险弃牌取消")
			mark_ui_optimization(cancel_danger_button, "F-096")
			mark_ui_optimization(cancel_danger_button, "F-099")
			action_bar.add_child(cancel_danger_button)
			action_bar.set_meta("danger_confirmation_lane", "dedicated_confirmation_panel_above_action_dock")
			action_bar.set_meta("danger_shortcut_state", {"confirm": "Enter", "cancel": "Esc"})
			draw_action_dock(parent)
			draw_danger_discard_confirmation_art(parent, selected_danger_tile, pending_danger_discard_report, danger_alternatives)
			finalize_action_bar_layout()
			return
		if can_self_discard() and can_win_for_seat(0):
			action_bar.add_child(make_action_button("自摸", Color(0.94, 0.42, 0.32), func() -> void:
				human_self_win()
			))
		var gang_tile = first_concealed_gang_tile(0)
		if can_self_discard() and gang_tile != "":
			action_bar.add_child(make_action_button("暗杠", Color(0.62, 0.54, 0.88), func() -> void:
				human_concealed_gang(gang_tile)
			))
		var added_gang_tile = first_added_gang_tile(0)
		if can_self_discard() and added_gang_tile != "":
			action_bar.add_child(make_action_button("补杠", Color(0.66, 0.58, 0.92), func() -> void:
				human_added_gang(added_gang_tile)
			))
		if player_ai_assist_enabled() and can_self_discard() and not has_pending_danger_discard():
			var recommended_report = recommended_discard_report()
			var recommended_tile = str(recommended_report.get("tile", ""))
			var safest_report = safest_discard_report()
			var safest_tile = str(safest_report.get("tile", ""))
			var offer_safest = should_offer_safest_discard_button(recommended_report, safest_report)
			var excluded_action_tiles: Array[String] = []
			if recommended_tile != "":
				var selected_recommended_tile = recommended_tile
				excluded_action_tiles.append(selected_recommended_tile)
				if offer_safest and safest_tile != "" and safest_tile != recommended_tile:
					var selected_safest_tile = safest_tile
					excluded_action_tiles.append(selected_safest_tile)
					var safest_button = make_action_button(safest_discard_button_text(safest_report), safe_discard_button_color(safest_report), func() -> void:
						human_discard_by_tile(selected_safest_tile)
					)
					safest_button.name = "SafestDiscardButton"
					safest_button.tooltip_text = ai_discard_brief(safest_report)
					action_bar.add_child(safest_button)
				var recommended_button_text = safest_discard_button_text(recommended_report) if offer_safest and safest_tile == recommended_tile else recommended_discard_button_text(selected_recommended_tile)
				var recommended_button = make_action_button(recommended_button_text, recommended_discard_button_color(recommended_report), func() -> void:
					human_discard_by_tile(selected_recommended_tile)
				)
				recommended_button.name = "RecommendedDiscardButton"
				recommended_button.tooltip_text = ai_discard_brief(recommended_report)
				action_bar.add_child(recommended_button)
				var alternative_limit = 1 if offer_safest and safest_tile != "" and safest_tile != recommended_tile else 2
				for report in discard_action_alternative_reports(excluded_action_tiles, alternative_limit):
					var alternative_tile = str(report.get("tile", ""))
					if alternative_tile == "":
						continue
					var selected_action_tile = alternative_tile
					var alternative_button = make_action_button(alternative_discard_button_text(report), alternative_discard_button_color(report), func() -> void:
						human_discard_by_tile(selected_action_tile)
					)
					alternative_button.name = "AlternativeDiscardButton_%s" % alternative_tile
					alternative_button.tooltip_text = ai_discard_brief(report)
					action_bar.add_child(alternative_button)
		if offline_restart_confirming:
			var confirm_restart := make_action_button("确认重开", Color(0.86, 0.40, 0.24), Callable(self, "request_offline_restart"))
			confirm_restart.name = "OfflineRestartConfirmButton"
			confirm_restart.tooltip_text = "确认重新开始当前单机牌局；当前进度不会保留"
			confirm_restart.set_meta("restart_action", "confirm")
			set_ui_full_text(confirm_restart, confirm_restart.tooltip_text, "确认重开当前牌局")
			action_bar.add_child(confirm_restart)
			var cancel_restart := make_action_button("取消", Color(0.50, 0.54, 0.54), func() -> void:
				offline_restart_confirming = false
				offline_restart_confirm_deadline_msec = 0
				set_status(current_status_text())
				request_game_render()
			)
			cancel_restart.name = "OfflineRestartCancelButton"
			cancel_restart.tooltip_text = "取消重开确认 · Esc"
			cancel_restart.set_meta("restart_action", "cancel")
			set_ui_full_text(cancel_restart, cancel_restart.tooltip_text, "取消重开当前牌局")
			action_bar.add_child(cancel_restart)
			action_bar.set_meta("restart_confirmation_lane", "confirm_then_cancel")
		else:
			var restart_button := make_action_button("重开", Color(0.70, 0.32, 0.22), Callable(self, "request_offline_restart"))
			restart_button.name = "OfflineRestartButton"
			restart_button.tooltip_text = "重新开始当前单机牌局；首次点击会先确认"
			restart_button.set_meta("restart_action", "request")
			set_ui_full_text(restart_button, restart_button.tooltip_text, "请求重开当前牌局")
			action_bar.add_child(restart_button)
		if player_ai_assist_enabled():
			action_bar.add_child(make_action_button("提示", Color(0.25, 0.58, 0.48), func() -> void:
				set_status(human_hint_text())
			))
	if mode == "online_game":
		var pending = pending_claim_state()
		if not pending.is_empty():
			for claim in ordered_pending_claim_options(pending.get("options", [])):
				var claim_name = str(claim)
				if claim_name == "chi":
					var chi_choices: Array = ordered_pending_chi_choices(pending.get("chi_choices", []))
					if chi_choices.is_empty():
						pending_claim_response_bar.add_child(make_action_button(claim_label(claim_name), claim_color(claim_name), func() -> void:
							send_online_action(online_claim_payload(claim_name), claim_label(claim_name))
						))
					else:
						for choice in chi_choices:
							var selected_choice: Dictionary = choice
							var selected_choice_label = compact_chi_choice_button_label(selected_choice)
							pending_claim_response_bar.add_child(make_action_button(selected_choice_label, claim_color(claim_name), func() -> void:
								send_online_action(online_claim_payload("chi", selected_choice), selected_choice_label)
							))
				else:
					pending_claim_response_bar.add_child(make_action_button(claim_label(claim_name), claim_color(claim_name), func() -> void:
						send_online_action(online_claim_payload(claim_name), claim_label(claim_name))
					))
			if pending.get("options", []).size() > 0:
				var online_pass_button := make_action_button("过", Color(0.38, 0.43, 0.44), func() -> void:
					send_online_action(online_claim_payload("pass"), "过")
				)
				if online_pass_button != null:
					online_pass_button.set_meta("pending_tail", true)
					pending_claim_response_tail_lane.add_child(online_pass_button)
				var network_menu_button := make_action_button("网络", Color(0.42, 0.50, 0.54), Callable(self, "open_pending_network_menu"))
				network_menu_button.name = "PendingClaimNetworkMenuButton"
				network_menu_button.set_meta("pending_tail", true)
				network_menu_button.set_meta("pending_lane", "network")
				network_menu_button.tooltip_text = "网络控制：打开取消等待或重试菜单"
				set_ui_full_text(network_menu_button, network_menu_button.tooltip_text, "网络控制")
				pending_claim_network_lane.add_child(network_menu_button)
			draw_pending_claim_illustration(parent)
		if mode == "online_game":
			var voice = make_action_button("闭麦" if voice_enabled else "麦克风", Color(0.74, 0.24, 0.24) if voice_enabled else Color(0.24, 0.52, 0.72), func() -> void:
				toggle_voice_chat()
			)
			voice.name = "VoiceActionButton"
			draw_voice_button_art(voice, voice_enabled, voice_peak)
			if has_pending_claim_window():
				voice.set_meta("pending_tail", true)
				voice.set_meta("pending_lane", "voice")
				pending_claim_voice_lane.add_child(voice)
			else:
				action_bar.add_child(voice)
	if mode == "online_game" and online_waiting_for_server:
		var cancel_sync_button := make_action_button("取消等待", Color(0.46, 0.50, 0.52), Callable(self, "cancel_online_pending_action"))
		cancel_sync_button.name = "OnlineCancelSyncButton"
		cancel_sync_button.tooltip_text = "停止本地等待并恢复操作入口"
		cancel_sync_button.set_meta("pending_tail", true)
		cancel_sync_button.set_meta("pending_lane", "network")
		if pending_claim_network_lane != null:
			pending_claim_network_lane.add_child(cancel_sync_button)
		else:
			action_bar.add_child(cancel_sync_button)
	elif mode == "online_game" and online_retry_available:
		var retry_sync_button := make_action_button("重试", Color(0.36, 0.62, 0.72), Callable(self, "retry_online_last_action"))
		retry_sync_button.name = "OnlineRetrySyncButton"
		retry_sync_button.tooltip_text = "重新提交上一次操作"
		retry_sync_button.set_meta("pending_tail", true)
		retry_sync_button.set_meta("pending_lane", "network")
		if pending_claim_network_lane != null:
			pending_claim_network_lane.add_child(retry_sync_button)
		else:
			action_bar.add_child(retry_sync_button)
	prepare_ended_action_overflow(parent)
	draw_action_dock(parent)
	finalize_action_bar_layout()

func open_pending_network_menu(anchor: Control = null) -> void:
	var menu := PopupMenu.new()
	menu.name = "PendingClaimNetworkMenu"
	menu.set_meta("layout_role", "pending_network_controls")
	menu.add_item("网络控制", 0)
	menu.set_item_disabled(0, true)
	if online_waiting_for_server:
		menu.add_item("取消等待", 1)
	if online_retry_available:
		menu.add_item("重试上一次操作", 2)
	if not online_waiting_for_server and not online_retry_available:
		menu.add_item("当前无需网络恢复", 3)
		menu.set_item_disabled(menu.item_count - 1, true)
	menu.id_pressed.connect(func(item_id: int) -> void:
		match item_id:
			1:
				cancel_online_pending_action()
			2:
				retry_online_last_action()
		menu.queue_free()
	)
	root_layer.add_child(menu)
	if anchor != null and is_instance_valid(anchor):
		menu.position = anchor.get_global_rect().position
	menu.popup()

func prepare_ended_action_overflow(parent: Control) -> void:
	var ended_action_mode := (mode == "offline" and offline_phase == "ended") or (mode == "online_game" and str(online_game.get("phase", "")) == "ended")
	if not ended_action_mode or action_bar == null or not is_instance_valid(action_bar):
		return
	var all_buttons: Array[Button] = []
	collect_action_bar_buttons(action_bar, all_buttons)
	var visible_buttons: Array[Button] = []
	for button in all_buttons:
		if button != null and is_instance_valid(button) and not bool(button.get_meta("overflow_hidden", false)):
			visible_buttons.append(button)
	var max_visible := ended_action_max_visible_button_count()
	if visible_buttons.size() <= max_visible:
		return
	var keep_count := maxi(1, max_visible - 1) # reserve one slot for the More menu
	var hidden_buttons: Array[Button] = []
	while visible_buttons.size() > keep_count:
		var candidate_index := visible_buttons.size() - 1
		for i in range(visible_buttons.size() - 1, -1, -1):
			if str(visible_buttons[i].get_meta("action_priority", "secondary")) != "primary":
				candidate_index = i
				break
		var candidate := visible_buttons[candidate_index]
		candidate.visible = false
		candidate.set_meta("overflow_hidden", true)
		hidden_buttons.push_front(candidate)
		visible_buttons.remove_at(candidate_index)
	if hidden_buttons.is_empty():
		return
	var popup := PopupMenu.new()
	popup.name = "EndedActionOverflowMenu"
	popup.set_meta("ui_action_name", "更多结算操作")
	popup.set_meta("overflow_count", hidden_buttons.size())
	parent.add_child(popup)
	for index in range(hidden_buttons.size()):
		var hidden := hidden_buttons[index]
		popup.add_item(hidden.text, index)
		popup.set_item_tooltip(index, hidden.tooltip_text)
		popup.set_item_disabled(index, hidden.disabled)
	popup.id_pressed.connect(func(index: int) -> void:
		if index >= 0 and index < hidden_buttons.size() and is_instance_valid(hidden_buttons[index]) and not hidden_buttons[index].disabled:
			hidden_buttons[index].pressed.emit()
	)
	var overflow := make_action_button("更多", Color(0.52, 0.56, 0.58), func() -> void:
		if is_instance_valid(popup):
			popup.popup_centered()
	)
	overflow.name = "EndedActionOverflowButton"
	overflow.tooltip_text = "打开更多结算操作 · %d项" % hidden_buttons.size()
	overflow.set_meta("action_priority", "secondary")
	overflow.set_meta("overflow_menu", true)
	action_bar.add_child(overflow)

func draw_chat_action_button(parent: Control) -> void:
	var chat_button := make_action_button("聊天", Color(0.30, 0.58, 0.54), func() -> void:
		toggle_chat_panel()
	)
	chat_button.name = "ChatActionButton"
	chat_button.tooltip_text = "打开或关闭房间聊天 · 快捷键 Esc关闭"
	set_ui_full_text(chat_button, chat_button.tooltip_text, "房间聊天开关")
	chat_button.set_meta("ui_action_role", "chat_toggle")
	chat_button.custom_minimum_size = Vector2(82, 44)
	chat_button.add_theme_font_size_override("font_size", 14)
	chat_button.z_index = 18
	if chat_panel_open:
		chat_button.modulate = Color(0.78, 0.92, 0.82, 0.92)
	apply_rect(chat_button, CHAT_ACTION_BUTTON_RECT)
	parent.add_child(chat_button)

func draw_advisor_card_meter(parent: Control, heading: String, main_text: String, sub_text: String, accent: Color) -> Control:
	# r213: GPT chrome conversion
	var meter = make_gpt_plate_rect(rect_full(0.595, 0.075, 0.925, 0.255), Color(accent.r, accent.g, accent.b, 0.075), "ui_button_face_plate")
	meter.name = "AdvisorCardMeter_%s" % heading
	parent.add_child(meter)
	var rail = make_gpt_route_rail(rect_full(0.080, 0.395, 0.920, 0.605), Color(0.010, 0.020, 0.022, 0.48))
	rail.name = "AdvisorCardMeterRail_%s" % heading
	meter.add_child(rail)
	var signal_ratio = clamp((float(main_text.length()) + float(sub_text.length()) * 0.42) / 24.0, 0.24, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.220, 0.035 + 0.930 * signal_ratio, 0.780), Color(accent.r, accent.g, accent.b, 0.44))
	fill.name = "AdvisorCardMeterFill_%s" % heading
	rail.add_child(fill)
	for i in range(3):
		var left = 0.165 + float(i) * 0.275
		var lit = signal_ratio >= 0.30 + float(i) * 0.24
		var pip = make_gpt_gate(rect_full(left, 0.205, left + 0.080, 0.795), Color(accent.r, accent.g, accent.b, 0.30 if lit else 0.10))
		pip.name = "AdvisorCardMeterPip_%s_%d" % [heading, i]
		meter.add_child(pip)
	var focus = make_gpt_gate(rect_full(0.780, 0.185, 0.910, 0.815), Color(accent.r, accent.g, accent.b, 0.12))
	focus.name = "AdvisorCardMeterFocus_%s" % heading
	meter.add_child(focus)
	# r180: GPT decision strip instead of route/fill/gate/tick ColorRect chrome.
	var decision = Control.new()
	decision.name = "AdvisorCardDecisionChrome_%s" % heading
	decision.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(decision, rect_full(0.110, 0.680, 0.930, 0.900))
	parent.add_child(decision)
	var decision_strip = add_optional_gpt_illustration_texture(decision, "ui_progress_signal_strip", rect_full(0.0, 0.15, 1.0, 0.85), 0.40, false)
	if decision_strip != null:
		decision_strip.name = "AdvisorCardDecisionStrip_%s" % heading
		decision_strip.modulate = Color(accent.r, accent.g, accent.b, 0.62)
	var decision_meter = add_optional_gpt_illustration_texture(decision, "ui_meter_rail_plate", rect_full(0.02, 0.28, 0.02 + 0.90 * signal_ratio, 0.72), 0.70, false)
	if decision_meter != null:
		decision_meter.name = "AdvisorCardDecisionMeter_%s" % heading
	if fx_enabled_effective():
		var tw := create_screen_tween()
		tw.set_loops(8)
		tw.tween_property(focus, "modulate:a", 0.42, 0.64).from(0.92).set_ease(Tween.EASE_OUT)
		tw.tween_property(focus, "modulate:a", 0.92, 0.64).from(0.42).set_ease(Tween.EASE_IN)
	return meter


func draw_advisor_card_signal_route(parent: Control, heading: String, main_text: String, sub_text: String, accent: Color) -> Control:
	# r180: GPT meter strip instead of multi-rect signal route chrome.
	var signal_ratio = clamp((float(main_text.length()) + float(sub_text.length()) * 0.36) / 22.0, 0.24, 1.0)
	var route = Control.new()
	route.name = "AdvisorCardSignalRoute_%s" % heading
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(route, rect_full(0.070, 0.160, 0.610, 0.335))
	parent.add_child(route)
	var strip = add_optional_gpt_illustration_texture(route, "ui_progress_signal_strip", rect_full(-0.02, 0.10, 1.02, 0.90), 0.40, false)
	if strip != null:
		strip.name = "AdvisorCardSignalStrip_%s" % heading
		strip.modulate = Color(accent.r, accent.g, accent.b, 0.64)
	var fill = add_optional_gpt_illustration_texture(route, "ui_meter_rail_plate", rect_full(0.03, 0.26, 0.03 + 0.90 * signal_ratio, 0.74), 0.70, false)
	if fill != null:
		fill.name = "AdvisorCardSignalFill_%s" % heading
	var gate = add_optional_gpt_illustration_texture(route, "ui_hand_tray_state_chip", rect_full(0.88, 0.12, 0.995, 0.88), 0.55, false)
	if gate != null:
		gate.name = "AdvisorCardSignalGate_%s" % heading
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and fill != null:
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.44, 0.78).from(0.96)
		if gate != null:
			tw.parallel().tween_property(gate, "modulate:a", 0.50, 0.78).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.96, 0.78).from(0.44)
		if gate != null:
			tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.78).from(0.50)
	return route

func draw_advisor_info_card(parent: Control, rect: Rect2, heading: String, main_text: String, sub_text: String, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var card = make_gpt_plate_rect(rect, Color(0.028, 0.048, 0.050, 0.78), "ui_jade_reading_plate")
	card.name = "AdvisorInfoCard_%s" % heading
	card.set_meta("advisor_reading_contract", "conclusion_then_structured_detail")
	card.set_meta("advisor_reading_role", "conclusion" if heading == "荐" or heading == "响应" else ("evidence" if heading == "势" or heading == "牌局" else "risk"))
	card.set_meta("compact_priority", "heading_primary_secondary_detail")
	parent.add_child(card)
	var card_texture = add_illustration_texture(card, "advisor_map", rect_full(0.015, 0.050, 0.985, 0.950), 0.080, false)
	if card_texture != null:
		card_texture.name = "AdvisorCardMapTexture_%s" % heading
		card.move_child(card_texture, 0)
	draw_advisor_signal_strip(card, heading, accent)
	draw_advisor_card_signal_route(card, heading, main_text, sub_text, accent)
	draw_advisor_card_meter(card, heading, main_text, sub_text, accent)
	var label = make_label(card, heading, 10, accent, true)
	label.name = "AdvisorCardHeading_%s" % heading
	label.set_meta("advisor_text_role", "heading")
	apply_rect(label, rect_full(0.13, 0.07, 0.93, 0.26))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(label)
	var primary = make_label(card, main_text if main_text != "" else "--", 12, Color(0.86, 0.91, 0.84), true)
	primary.name = "AdvisorCardPrimary_%s" % heading
	primary.set_meta("advisor_text_role", "primary")
	set_ui_full_text(primary, primary.text, "牌势%s主结论" % heading)
	apply_rect(primary, rect_full(0.13, 0.30, 0.93, 0.56))
	primary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(primary)
	var secondary = make_label(card, sub_text if sub_text != "" else "暂无", 10, Color(0.66, 0.74, 0.70), false)
	secondary.name = "AdvisorCardSecondary_%s" % heading
	secondary.set_meta("advisor_text_role", "secondary")
	secondary.set_meta("advisor_detail_route", "AdvisorDetailButton")
	set_ui_full_text(secondary, secondary.text, "牌势%s完整说明；可打开详解" % heading)
	var full_secondary: String = str(secondary.text)
	# Preserve complete clauses first so the compact card retains risk/source
	# tokens instead of cutting a sentence in the middle.
	var summary_parts: PackedStringArray = full_secondary.split("；", false)
	var summary_chunks: Array[String] = []
	for part in summary_parts:
		var clean_part := str(part).strip_edges()
		if clean_part != "":
			summary_chunks.append(clean_part)
		if summary_chunks.size() >= 2:
			break
	var secondary_summary := " · ".join(summary_chunks) if not summary_chunks.is_empty() else "暂无"
	if secondary_summary.length() > 42:
		secondary_summary = secondary_summary.left(40).strip_edges() + "…"
	secondary.text = secondary_summary
	secondary.set_meta("ui_visual_summary", secondary_summary)
	secondary.set_meta("ui_visual_summary_source", "structured_first_two_clauses")
	secondary.set_meta("ui_full_text", full_secondary)
	mark_ui_optimization(secondary, "F-037")
	mark_ui_optimization(secondary, "F-122")
	apply_rect(secondary, rect_full(0.13, 0.58, 0.93, 0.92))
	secondary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	secondary.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	secondary.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	secondary.clip_text = false
	secondary.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
	configure_wrapped_label(secondary, maxf(76.0, safe_content_pixel_size().x * 0.095), 0.0, 2.0)


func draw_advisor_panel(parent: Control, force_visible: bool = false) -> void:
	# r214: bulk GPT chrome sweep
	# A pending claim already has one focused response surface. Hiding the general
	# advisor here prevents a second reading lane from competing with the claim or
	# danger decision surfaces and keeps keyboard focus within the active action.
	if not force_visible and (mode != "offline" or offline_phase == "ended" or offline_phase == "pending_claim" or has_pending_danger_discard() or not player_ai_assist_enabled()):
		return
	# The advisor owns an authored side channel selected against the live table
	# geometry. It must not cover the center wind, wall count, last discard, or a
	# seat-facing river/meld lane just because the viewport is compact.
	var advisor_rect := advisor_panel_layout_rect()
	var panel = make_gpt_plate_rect(advisor_rect, Color(0.014, 0.034, 0.040, 0.90), "ui_button_face_plate")
	panel.set_name("AdvisorPanel")
	panel.set_meta("layout_rect", advisor_rect)
	panel.set_meta("layout_role", "advisor_safe_side_channel")
	panel.set_meta("center_occlusion_policy", "never")
	panel.set_meta("center_facts_preserved", "wind,wall_count,last_discard,round")
	panel.set_meta("minimum_clearance_px", 6.0)
	panel.set_meta("reading_order", "结论 > 依据 > 风险")
	panel.set_meta("compact_card_contract", "three_roles_same_height")
	mark_ui_optimization(panel, "F-036")
	mark_ui_optimization(panel, "F-122")
	parent.add_child(panel)
	var advisor_texture = add_illustration_texture(panel, "advisor_map", rect_full(0.010, 0.035, 0.990, 0.965), 0.12, false)
	if advisor_texture != null:
		advisor_texture.name = "AdvisorMapTexture"
		panel.move_child(advisor_texture, 0)
	var advisor_gpt_key := "advisor_gpt_panel"
	var gpt_advisor_texture = add_optional_gpt_illustration_texture(panel, advisor_gpt_key, rect_full(0.006, 0.020, 0.994, 0.980), 0.14, false)
	if gpt_advisor_texture != null:
		gpt_advisor_texture.name = "AdvisorGPTPanelTexture"
		panel.move_child(gpt_advisor_texture, min(1, panel.get_child_count() - 1))
	var _gpt_panel_host = make_gpt_route_rail(rect_full(0.0, 0.0, 1.0, 0.14), Color(0.044, 0.056, 0.058, 0.72))
	_gpt_panel_host.name = "GptPanelHost"
	panel.add_child(_gpt_panel_host)
	var title = make_label(panel, "牌势", 13, Color(0.86, 0.78, 0.56), true)
	apply_rect(title, rect_full(0.03, 0.04, 0.16, 0.22))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var context = make_label(panel, advisor_context_line(), 11, Color(0.62, 0.72, 0.68), false)
	apply_rect(context, rect_full(0.17, 0.04, 0.52, 0.22))
	context.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(context)
	var detail_button := make_small_button("详解", Color(0.48, 0.56, 0.40), Callable(self, "toggle_advisor_detail_panel"))
	detail_button.name = "AdvisorDetailButton"
	detail_button.custom_minimum_size = Vector2(58, 44)
	detail_button.add_theme_font_size_override("font_size", 10)
	detail_button.tooltip_text = "展开牌势详解 · Esc收起"
	apply_rect(detail_button, rect_full(0.54, 0.015, 0.97, 0.265))
	panel.add_child(detail_button)
	draw_advisor_panel_context_route(panel)
	draw_advisor_panel_priority_sweep(panel)
	draw_advisor_panel_decision_bridge(panel)
	draw_advisor_panel_analysis_scan(panel)
	# Three horizontal reading lanes keep recommendation, shape and defense visible
	# together at compact widths; the panel remains between the river and action dock.
	var advisor_card_rect_a := rect_full(0.025, 0.255, 0.325, 0.955)
	var advisor_card_rect_b := rect_full(0.340, 0.255, 0.660, 0.955)
	var advisor_card_rect_c := rect_full(0.675, 0.255, 0.975, 0.955)
	if offline_phase == "pending_claim":
		draw_advisor_info_card(panel, advisor_card_rect_a, "响应", "%s" % tile_label(str(offline_pending_claim.get("tile", ""))), "%s" % claim_options_text(offline_pending_claim), Color(0.86, 0.78, 0.56))
		draw_advisor_info_card(panel, advisor_card_rect_b, "牌局", advisor_turn_line(), current_status_text(), Color(0.62, 0.78, 0.82))
		draw_advisor_info_card(panel, advisor_card_rect_c, "防守", advisor_defense_text(0), opponent_threat_summary(0), Color(0.84, 0.62, 0.54))
		return
	if can_self_discard():
		var reports = current_human_advice if not current_human_advice.is_empty() else get_ai_discard_reports(0)
		if reports.is_empty():
			draw_advisor_info_card(panel, advisor_card_rect_a, "荐", "整理", "待出牌", Color(0.86, 0.78, 0.56))
			draw_advisor_info_card(panel, advisor_card_rect_b, "势", "等待", advisor_turn_line(), Color(0.62, 0.78, 0.82))
			draw_advisor_info_card(panel, advisor_card_rect_c, "守", "观测", opponent_threat_summary(0), Color(0.84, 0.62, 0.54))
			return
		var best: Dictionary = reports[0]
		var narrow_advisor_layout := effective_viewport_size().x <= 960.0
		var reason_text := advisor_compact_reason_text(best) if narrow_advisor_layout else advisor_recommendation_reason_text(best)
		var value_text := advisor_compact_value_text(best) if narrow_advisor_layout else advisor_value_short_text(best)
		var threat_text := advisor_compact_threat_text(0) if narrow_advisor_layout else opponent_threat_summary(0)
		draw_advisor_info_card(panel, advisor_card_rect_a, "荐", "打%s · %s" % [tile_label(str(best.get("tile", ""))), advisor_confidence_text(reports)], reason_text, Color(0.86, 0.78, 0.56))
		draw_advisor_info_card(panel, advisor_card_rect_b, "势", advisor_progress_text(best), value_text, Color(0.62, 0.78, 0.82))
		draw_advisor_info_card(panel, advisor_card_rect_c, "守", discard_safety_short_text(best), threat_text, Color(0.84, 0.62, 0.54))
		return
	draw_advisor_info_card(panel, advisor_card_rect_a, "局", advisor_turn_line(), current_status_text(), Color(0.86, 0.78, 0.56))
	draw_advisor_info_card(panel, advisor_card_rect_b, "势", score_strategy_text(0), "余牌%d" % get_wall_count(), Color(0.62, 0.78, 0.82))
	draw_advisor_info_card(panel, advisor_card_rect_c, "守", advisor_defense_text(0), opponent_threat_summary(0), Color(0.84, 0.62, 0.54))


func draw_advisor_detail_panel(parent: Control) -> void:
	if not advisor_detail_open or mode != "offline" or not player_ai_assist_enabled() or has_pending_danger_discard():
		return
	# Advisor details are an inspect surface. Consume pointer input across the
	# table so a player cannot accidentally discard while reading a recommendation.
	var input_shield := Control.new()
	input_shield.name = "AdvisorDetailModalShield"
	input_shield.set_anchors_preset(Control.PRESET_FULL_RECT)
	input_shield.mouse_filter = Control.MOUSE_FILTER_STOP
	input_shield.z_index = 43
	input_shield.set_meta("layout_role", "advisor_read_only_inspect_shield")
	parent.add_child(input_shield)
	var panel = make_gpt_plate_rect(rect_full(0.160, 0.130, 0.840, 0.545), Color(0.014, 0.034, 0.040, 0.96), "ui_jade_reading_plate")
	panel.name = "AdvisorDetailPanel"
	panel.z_index = 44
	panel.mouse_filter = Control.MOUSE_FILTER_STOP
	panel.clip_contents = true
	parent.add_child(panel)
	var map_texture = add_illustration_texture(panel, "advisor_map", rect_full(0.010, 0.035, 0.990, 0.965), 0.075, false)
	if map_texture != null:
		map_texture.name = "AdvisorDetailMapTexture"
		panel.move_child(map_texture, 0)
	var title = make_label(panel, "牌势详解", 16, Color(0.90, 0.80, 0.56), true)
	title.name = "AdvisorDetailTitle"
	apply_rect(title, rect_full(0.055, 0.045, 0.58, 0.145))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var context = make_label(panel, advisor_context_line(), 11, Color(0.66, 0.76, 0.70), false)
	context.name = "AdvisorDetailContext"
	apply_rect(context, rect_full(0.060, 0.145, 0.560, 0.235))
	context.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(context)
	var read_only_badge := make_label(panel, "只读分析", 10, Color(0.72, 0.88, 0.78), true)
	read_only_badge.name = "AdvisorDetailReadOnlyBadge"
	apply_rect(read_only_badge, rect_full(0.600, 0.055, 0.855, 0.135))
	read_only_badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	read_only_badge.tooltip_text = "分析层已锁定牌桌操作；关闭后恢复出牌焦点"
	read_only_badge.set_meta("accessible_name", "牌势详解只读分析")
	configure_clipped_label(read_only_badge)
	var recommended_tile := ""
	var recommended_index := -1
	if can_self_discard():
		var reports := current_human_advice if not current_human_advice.is_empty() else get_ai_discard_reports(0)
		if not reports.is_empty() and typeof(reports[0]) == TYPE_DICTIONARY:
			recommended_tile = str((reports[0] as Dictionary).get("tile", ""))
			recommended_index = hand_tile_index_for_advice(get_self_hand(), recommended_tile)
	var recommended_button := make_small_button("定位推荐牌" if recommended_tile != "" else "暂无推荐", Color(0.40, 0.60, 0.48), func() -> void:
		if recommended_index >= 0:
			set_hand_keyboard_selection(recommended_index, false)
			focus_hand_tile_control(recommended_index)
			show_toast("已定位推荐牌：%s" % tile_label(recommended_tile), 1800)
	)
	recommended_button.name = "AdvisorDetailRecommendedTileButton"
	recommended_button.custom_minimum_size = Vector2(120, 44)
	recommended_button.add_theme_font_size_override("font_size", 10)
	recommended_button.disabled = recommended_index < 0
	recommended_button.tooltip_text = "定位到手牌中的推荐%s；分析仍保持只读" % tile_label(recommended_tile) if recommended_tile != "" else "当前没有可定位的推荐牌"
	recommended_button.set_meta("accessible_name", recommended_button.tooltip_text)
	apply_rect(recommended_button, rect_full(0.555, 0.145, 0.855, 0.235))
	panel.add_child(recommended_button)
	var close_button := make_icon_button("x", Color(0.92, 0.82, 0.58), 16, Callable(self, "close_advisor_detail_panel"))
	close_button.name = "AdvisorDetailCloseButton"
	close_button.custom_minimum_size = Vector2(UI_MIN_TOUCH_TARGET, UI_MIN_TOUCH_TARGET)
	close_button.tooltip_text = "收起牌势详解 · Esc"
	apply_rect(close_button, rect_full(0.895, 0.020, 0.985, 0.225))
	panel.add_child(close_button)
	var detail_route = make_gpt_route_rail(rect_full(0.060, 0.255, 0.940, 0.275), Color(0.006, 0.016, 0.018, 0.48))
	detail_route.name = "AdvisorDetailRoute"
	panel.add_child(detail_route)
	var detail_fill = make_gpt_meter_fill(rect_full(0.020, 0.250, 0.720, 0.750), Color(0.74, 0.64, 0.38, 0.30))
	detail_fill.name = "AdvisorDetailRouteFill"
	detail_route.add_child(detail_fill)
	var detail_scroll := ScrollContainer.new()
	detail_scroll.name = "AdvisorDetailScroll"
	configure_scroll_container(detail_scroll, "上下滚动查看完整牌势详解")
	detail_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	detail_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	detail_scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	apply_rect(detail_scroll, rect_full(0.070, 0.315, 0.930, 0.875))
	panel.add_child(detail_scroll)
	var detail_text = make_label(detail_scroll, advisor_detail_text(), 13, Color(0.86, 0.90, 0.84), false)
	detail_text.name = "AdvisorDetailText"
	detail_text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	detail_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_wrapped_label(detail_text, maxf(220.0, effective_viewport_size().x * 0.700), 0.0, 5.0)
	detail_text.clip_text = false
	detail_text.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
	detail_text.tooltip_text = detail_text.text
	var hint = make_label(panel, "", 10, Color(0.66, 0.72, 0.64), false)
	hint.name = "AdvisorDetailHint"
	apply_rect(hint, rect_full(0.070, 0.900, 0.760, 0.955))
	configure_clipped_label(hint)
func draw_advisor_panel_analysis_scan(parent: Control) -> Control:
	# r209: GPT chrome conversion
	var accent = hand_tray_state_fill()
	var scan = Control.new()
	scan.name = "AdvisorPanelAnalysisScan"
	scan.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(scan, rect_full(0.035, 0.132, 0.965, 0.330))
	parent.add_child(scan)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.470, 0.045, 0.730), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "AdvisorPanelAnalysisSource"
	scan.add_child(source)
	var intake = make_gpt_plate_rect(rect_full(0.045, 0.550, 0.335, 0.635), Color(0.006, 0.016, 0.018, 0.42), "ui_button_face_plate")
	intake.name = "AdvisorPanelAnalysisIntakeRoute"
	scan.add_child(intake)
	var intake_fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.860, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	intake_fill.name = "AdvisorPanelAnalysisIntakeFill"
	intake.add_child(intake_fill)
	var risk = make_gpt_plate_rect(rect_full(0.355, 0.170, 0.645, 0.255), Color(0.006, 0.016, 0.018, 0.42), "ui_button_face_plate")
	risk.name = "AdvisorPanelRiskRoute"
	scan.add_child(risk)
	var risk_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.780, 0.750), Color(0.84, 0.62, 0.54, 0.22))
	risk_fill.name = "AdvisorPanelRiskFill"
	risk.add_child(risk_fill)
	var output = make_gpt_plate_rect(rect_full(0.655, 0.550, 0.955, 0.635), Color(0.006, 0.016, 0.018, 0.42), "ui_button_face_plate")
	output.name = "AdvisorPanelOutputRoute"
	scan.add_child(output)
	var output_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.830, 0.750), Color(0.86, 0.78, 0.56, 0.24))
	output_fill.name = "AdvisorPanelOutputFill"
	output.add_child(output_fill)
	var gate = make_gpt_gate(rect_full(0.930, 0.440, 0.985, 0.760), Color(0.96, 0.82, 0.42, 0.18))
	gate.name = "AdvisorPanelAnalysisGate"
	scan.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.470, 0.370, 0.530, 0.710), Color(accent.r, accent.g, accent.b, 0.15))
	seal.name = "AdvisorPanelAnalysisSeal"
	scan.add_child(seal)
	var glyph = make_label(seal, "策", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "AdvisorPanelAnalysisGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var left = 0.160 + float(i) * 0.330
		var node = make_gpt_gate(rect_full(left, 0.400, left + 0.035, 0.790), Color(accent.r, accent.g, accent.b, 0.17 + float(i) * 0.025))
		node.name = "AdvisorPanelAnalysisNode_%d" % i
		scan.add_child(node)
	var tick = add_gpt_tick_strip(scan, rect_full(0.235, 0.315, (0.235) + float(3) * (0.135) + (0.014), 0.815), Color(accent.r, accent.g, accent.b, 0.22), "AdvisorPanelAnalysisTick_0")
	if fx_enabled_effective():
		scan.modulate.a = 0.86
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(intake_fill, "anchor_right", 0.980, 0.72).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(risk_fill, "anchor_right", 0.940, 0.72).from(0.100).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(output_fill, "anchor_right", 0.970, 0.72).from(0.100).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.36).from(0.92)
		tw.tween_property(intake_fill, "anchor_right", 0.860, 0.01)
		tw.parallel().tween_property(risk_fill, "anchor_right", 0.780, 0.01)
		tw.parallel().tween_property(output_fill, "anchor_right", 0.830, 0.01)
		tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.36).from(0.48)
	return scan


