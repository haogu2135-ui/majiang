func register_ui_round_1071_1100(root: Control) -> void:
	# F-1071..F-1100 covers wide-page density, empty states, and the primary
	# reading lanes. Existing native controls keep ownership; this round adds no
	# visual layer and preserves the authored bitmap policy.
	if root == null or not is_instance_valid(root):
		return
	var registration_child_count := root.find_children("*", "Control", true, false).size()
	if int(root.get_meta("ui_round_1071_1100_registered_child_count", -1)) == registration_child_count:
		return
	root.set_meta("ui_round_1071_1100_registered_child_count", registration_child_count)
	var contract_ids: Array[String] = []
	for index in range(30):
		contract_ids.append("F-%d" % (1071 + index))
	root.set_meta("ui_round_1071_1100_contract_ids", contract_ids)
	root.set_meta("ui_round_1071_1100_contract_version", "20260910-wide-page-density-30")
	root.set_meta("ui_round_1071_1100_scope", "wide_page_density_empty_states_and_primary_reading_lanes")
	root.set_meta("ui_round_1071_1100_evidence_viewports", [Vector2(960, 540), Vector2(1280, 720), Vector2(1920, 1080)])
	var find_control := func(node_name: String) -> Control:
		return root.find_child(node_name, true, false) as Control
	var attach := func(finding_id: String, node: Control, role: String, policy: String) -> void:
		var target := node if node != null and is_instance_valid(node) else root
		var attached: Array = target.get_meta("ui_round_1071_1100_ids", [])
		if not attached.has(finding_id):
			attached.append(finding_id)
			target.set_meta("ui_round_1071_1100_ids", attached)
		var roles: Dictionary = target.get_meta("ui_round_1071_1100_roles", {})
		roles[finding_id] = role
		target.set_meta("ui_round_1071_1100_roles", roles)
		target.set_meta("ui_round_1071_1100_policy", policy)
		target.set_meta("optimization_state", "implemented")
		target.set_meta("ui_contract_hardening", true)
		if target is Button:
			var button := target as Button
			var telemetry_background_locked := bool(button.get_meta("telemetry_sheet_background_locked", false))
			if button.disabled or not button.visible or telemetry_background_locked:
				button.focus_mode = Control.FOCUS_NONE
				if telemetry_background_locked:
					button.mouse_filter = Control.MOUSE_FILTER_IGNORE
			else:
				button.focus_mode = Control.FOCUS_ALL
			button.custom_minimum_size.y = maxf(button.custom_minimum_size.y, UI_MIN_TOUCH_TARGET)
			button.set_meta("ui_min_touch_target", UI_MIN_TOUCH_TARGET)
			if button.tooltip_text.strip_edges() == "" and button.text.strip_edges() != "":
				button.tooltip_text = button.text.strip_edges()
			set_ui_full_text(button, button.tooltip_text, button.text.strip_edges())
		elif target is LineEdit:
			configure_line_edit_input(target as LineEdit, str(target.get_meta("ui_input_field", target.name)))
		elif target is ScrollContainer:
			configure_scroll_container(target as ScrollContainer, target.tooltip_text)
		elif target is Label:
			target.mouse_filter = Control.MOUSE_FILTER_IGNORE
			if target.tooltip_text.strip_edges() == "" and target.text.strip_edges() != "":
				set_ui_full_text(target, target.text.strip_edges(), target.text.strip_edges())
		mark_ui_optimization(target, finding_id)
	var owners := [
		["F-1071", "ShopItemBuyHitHost_swap_card", "shop_disabled_cta_layer_owner", "disabled_button_art_stays_below_readable_command"],
		["F-1072", "ShopItemBuyButton_swap_card", "shop_purchase_state_owner", "available_and_insufficient_states_share_one_target"],
		["F-1073", "ShopBuyButtonCommand_swap_card", "shop_command_text_owner", "command_text_survives_disabled_button_modulate"],
		["F-1074", "ShopItemTextReadabilityPanel_swap_card", "shop_text_plate_owner", "wide_item_copy_keeps_measured_reading_lane"],
		["F-1075", "ShopItemsScrollPosition", "shop_range_status_owner", "range_label_stays_left_of_scroll_hit_lane"],
		["F-1076", "ShopItemsEndMarker", "shop_end_marker_owner", "end_marker_precedes_footer_with_clearance"],
		["F-1077", "ShopCabinetFooterBody", "shop_footer_copy_owner", "footer_explanation_does_not_compete_with_badges"],
		["F-1078", "ShopGetGemsButton", "shop_currency_recovery_owner", "insufficient_currency_has_honest_next_step"],
		["F-1079", "StatsRows", "stats_rows_surface_owner", "wide_rows_use_measured_columns_not_empty_stretch"],
		["F-1080", "StatsRowsScrollStatus", "stats_rows_range_owner", "range_status_stays_above_rows_and_scrollbar"],
		["F-1081", "StatsRuleFilterButton", "stats_filter_action_owner", "filter_state_is_visible_before_summary_values"],
		["F-1082", "StatsCopyButton", "stats_copy_feedback_owner", "copy_scope_and_result_stay_near_action"],
		["F-1083", "StatsEmptyState", "stats_empty_state_owner", "empty_copy_has_primary_start_route"],
		["F-1084", "StatsStartFirstGameButton", "stats_empty_primary_owner", "empty_state_start_is_first_focus_action"],
		["F-1085", "RulesReadingStatus", "rules_range_status_owner", "chapter_and_reading_range_share_status_lane"],
		["F-1086", "RulesContentScrollBottomCue", "rules_bottom_cue_owner", "next_section_hint_does_not_cover_last_complete_line"],
		["F-1087", "RulesContentScrollTopCue", "rules_top_cue_owner", "top_boundary_hint_is_hidden_at_first_section"],
		["F-1088", "RulesGuideStepActivePlate_0", "rules_active_plate_owner", "active_chapter_plate_has_shape_and_text"],
		["F-1089", "RulesGuideStepLabel_0", "rules_step_label_owner", "chapter labels keep baseline across wide nav"],
		["F-1090", "SettingsDefaultScrollStatus", "settings_default_range_owner", "settings scroll state is visible after section rebuild"],
		["F-1091", "SettingsOverviewSummary", "settings_overview_owner", "overview summary precedes long control rows"],
		["F-1092", "SettingsRuleVariantStatus", "settings_rule_status_owner", "rule variant value and next-round note share lane"],
		["F-1093", "SettingsCloseButton", "settings_close_owner", "close remains reachable after large-text scroll"],
		["F-1094", "SettingsSectionActiveMarker", "settings_section_marker_owner", "section marker does not depend on texture contrast"],
		["F-1095", "MenuFooterTextLayer", "menu_footer_copy_owner", "footer version and status keep a safe bottom lane"],
		["F-1096", "MenuTutorialEntryStatus", "menu_tutorial_status_owner", "tutorial checkpoint status stays beside entry"],
		["F-1097", "MenuQuickActionRail", "menu_quick_action_surface_owner", "quick actions keep one focus and visual rail"],
		["F-1098", "MenuPrimaryOfflineCard", "menu_offline_card_owner", "offline card title and action retain wide-card hierarchy"],
		["F-1099", "MenuPrimaryOnlineCard", "menu_online_card_owner", "online card connection state stays out of primary title"],
		["F-1100", "MenuPrimaryShopCard", "menu_shop_card_owner", "shop card economy hint stays secondary to entry action"],
	]
	var owner_roles: Dictionary = {}
	for owner in owners:
		var finding_id := str(owner[0])
		var role := str(owner[2])
		var policy := str(owner[3])
		owner_roles[finding_id] = {"owner": str(owner[1]), "role": role, "policy": policy}
		attach.call(finding_id, find_control.call(str(owner[1])) as Control, role, policy)
	root.set_meta("ui_round_1071_1100_owner_roles", owner_roles)
	var shop_host := find_control.call("ShopItemBuyHitHost_swap_card") as Control
	if shop_host != null:
		shop_host.z_index = maxi(shop_host.z_index, 4)
		shop_host.set_meta("cta_layer_contract", "host_above_disabled_button_art")
	var shop_command := find_control.call("ShopBuyButtonCommand_swap_card") as Label
	if shop_command != null:
		shop_command.visible = true
		shop_command.mouse_filter = Control.MOUSE_FILTER_IGNORE
		shop_command.z_index = maxi(shop_command.z_index, 5)
		shop_command.set_meta("disabled_visual_text_owner", true)
	var stats_rows := find_control.call("StatsRows") as Control
	if stats_rows != null:
		stats_rows.set_meta("wide_column_contract", "label_context_value_measured_not_full_empty_stretch")
	var empty_start := find_control.call("StatsStartFirstGameButton") as Control
	if empty_start != null:
		empty_start.set_meta("empty_state_primary", true)


