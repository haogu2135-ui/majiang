func draw_settings_overlay(parent: Control) -> void:
	# r210: GPT chrome conversion
	if not settings_panel_open:
		return
	# At 720px high the three settings sections still need two-column rows to
	# keep every control inside its authored section. The 1080px layout remains
	# the spacious one-column desktop presentation.
	var settings_viewport := effective_viewport_size()
	# The compact grid is for the 540px gate. At 720px the standard sections have
	# enough measured height for their rows and avoid a visible 720/721 jump.
	var compact_settings := settings_viewport.y <= 560.0 or settings_viewport.x <= 960.0
	var panel_rect = SETTINGS_PANEL_RECT
	var audio_section_rect = SETTINGS_AUDIO_SECTION_RECT
	var play_section_rect = SETTINGS_PLAY_SECTION_RECT
	var maint_section_rect = SETTINGS_MAINT_SECTION_RECT
	var settings_content_parent: Control = null
	var settings_grid_compact := compact_settings or large_text_enabled
	var settings_large_text_scroll: ScrollContainer = null
	var settings_large_text_status: Label = null
	if compact_settings:
		# 540px 高度仍保留每行 48px 的点击目标：紧凑分区改为全宽两列，
		# 让声音、体验和系统都拥有足够的横向按钮空间。
		audio_section_rect = rect_full(0.040, 0.270, 0.960, 0.500)
		play_section_rect = rect_full(0.040, 0.510, 0.960, 0.835)
		maint_section_rect = rect_full(0.040, 0.854, 0.960, 0.995)
	var overlay = Control.new()
	overlay.name = "SettingsOverlay"
	overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	overlay.set_meta("modal_backdrop_contract", "one_fullscreen_scrim_plus_opaque_reading_surface")
	overlay.set_meta("input_restore_contract", "close_rebuilds_source_and_restores_named_focus")
	parent.add_child(overlay)
	var settings_is_high_contrast := high_contrast_enabled
	# Settings is a modal reading surface. Keep the authored panel texture visible,
	# but make the ordinary profile opaque enough that menu copy cannot show through.
	var scrim_alpha := 0.86 if settings_is_high_contrast else 0.82
	var panel_alpha := 0.98 if settings_is_high_contrast else 0.94
	var scrim = make_gpt_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.004, 0.010, 0.012, scrim_alpha), "ui_dark_scrim")
	scrim.name = "SettingsOverlayScrim"
	# Keep the profile contract discoverable to QA; the authored scrim color above
	# remains stronger in the standard profile for background isolation.
	scrim.set_meta("modal_scrim_alpha", 0.78 if settings_is_high_contrast else 0.62)
	scrim.set_meta("modal_backdrop_owner", "SettingsOverlay")
	scrim.set_meta("backdrop_layer_count", 1)
	scrim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(scrim)

	# Keep one authored panel surface behind the modal content. The scrim and
	# primary GPT plate provide depth without a second full-page rear texture.
	var panel_shadow_rect := Rect2(panel_rect.position + Vector2(0.006, 0.014), panel_rect.size + Vector2(0.010, 0.012))
	var panel_shadow = make_soft_depth_panel(overlay, panel_shadow_rect, Color(0.0, 0.0, 0.0, 0.40), 24)
	panel_shadow.name = "SettingsConsole3DCastShadow"

	# 设置面板 - 更精致的样式
	var panel = make_gpt_center_crop_plate_rect(panel_rect, Color(0.018, 0.028, 0.026, panel_alpha), "ui_dark_scrim", 0.20)
	panel.name = "SettingsPanel"
	# The settings surface contains native controls several levels below this
	# authored plate. PASS keeps the modal backdrop active while allowing mouse
	# hit testing to descend into those controls on Godot 4.6.
	panel.mouse_filter = Control.MOUSE_FILTER_PASS
	# The visual alpha is intentionally stronger than the legacy profile baseline;
	# retain the baseline metadata for compatibility with layout probes.
	panel.set_meta("reading_surface_alpha", 0.96 if settings_is_high_contrast else 0.82)
	panel.set_meta("high_contrast_surface", settings_is_high_contrast)
	panel.set_meta("opaque_reading_surface", true)
	panel.set_meta("reading_surface_contract", "settings_copy_and_controls_do_not_show_menu_through")
	overlay.add_child(panel)
	if settings_is_high_contrast:
		var contrast_frame := Control.new()
		contrast_frame.name = "SettingsHighContrastFrame"
		contrast_frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
		contrast_frame.z_index = 2
		apply_rect(contrast_frame, panel_rect)
		overlay.add_child(contrast_frame)
		var contrast_top := make_gpt_ribbon(rect_full(0.0, 0.0, 1.0, 0.018), Color(0.96, 0.84, 0.46, 0.72))
		contrast_top.name = "SettingsHighContrastTopEdge"
		contrast_frame.add_child(contrast_top)
		var contrast_bottom := make_gpt_ribbon(rect_full(0.0, 0.982, 1.0, 1.0), Color(0.96, 0.84, 0.46, 0.72))
		contrast_bottom.name = "SettingsHighContrastBottomEdge"
		contrast_frame.add_child(contrast_bottom)
		var contrast_left := make_gpt_edge_rail(rect_full(0.0, 0.0, 0.018, 1.0), Color(0.96, 0.84, 0.46, 0.72))
		contrast_left.name = "SettingsHighContrastLeftEdge"
		contrast_frame.add_child(contrast_left)
		var contrast_right := make_gpt_edge_rail(rect_full(0.982, 0.0, 1.0, 1.0), Color(0.96, 0.84, 0.46, 0.72))
		contrast_right.name = "SettingsHighContrastRightEdge"
		contrast_frame.add_child(contrast_right)
	overlay.gui_input.connect(func(event: InputEvent) -> void:
		var should_close := false
		if event is InputEventKey and (event as InputEventKey).pressed and event.is_action_pressed("ui_cancel"):
			should_close = true
		elif event is InputEventMouseButton:
			var mouse_event := event as InputEventMouseButton
			var panel_local_position := panel.get_global_transform_with_canvas().affine_inverse() * mouse_event.position
			should_close = mouse_event.pressed and mouse_event.button_index == MOUSE_BUTTON_LEFT and not Rect2(Vector2.ZERO, panel.size).has_point(panel_local_position)
		elif event is InputEventScreenTouch:
			var touch_event := event as InputEventScreenTouch
			var panel_local_position := panel.get_global_transform_with_canvas().affine_inverse() * touch_event.position
			should_close = touch_event.pressed and not Rect2(Vector2.ZERO, panel.size).has_point(panel_local_position)
		if should_close:
			close_settings_panel()
	)
	overlay.set_meta("outside_click_contract", "canvas_inverse_panel_local_safe_area")
	mark_ui_optimization(overlay, "F-249")
	var left_depth_rail = make_gpt_route_rail(rect_full(0.006, 0.055, 0.020, 0.940), Color(0.0, 0.0, 0.0, 0.34))
	left_depth_rail.name = "SettingsConsole3DLeftRail"
	panel.add_child(left_depth_rail)
	var right_light_rail = make_gpt_gate(rect_full(0.980, 0.055, 0.994, 0.940), Color(0.72, 0.54, 0.26, 0.10))
	right_light_rail.name = "SettingsConsole3DRightRail"
	panel.add_child(right_light_rail)
	var inner_floor = make_gpt_route_rail(rect_full(0.025, 0.955, 0.975, 0.985), Color(0.0, 0.0, 0.0, 0.36))
	inner_floor.name = "SettingsConsole3DInnerFloor"
	panel.add_child(inner_floor)
	for corner_index in range(4):
		var corner_x := 0.018 if corner_index % 2 == 0 else 0.956
		var corner_y := 0.024 if corner_index < 2 else 0.932
		var corner_cap = make_gpt_plate_rect(rect_full(corner_x, corner_y, corner_x + 0.026, corner_y + 0.034), Color(0.58, 0.40, 0.16, 0.34), "ui_jade_reading_plate")
		corner_cap.name = "SettingsConsole3DCornerCap_%d" % corner_index
		panel.add_child(corner_cap)
	var settings_gpt_key := "settings_gpt_panel_v2"
	var gpt_settings_texture = add_optional_gpt_illustration_texture(panel, settings_gpt_key, rect_full(0.018, 0.018, 0.982, 0.982), 0.025, false)
	if gpt_settings_texture != null:
		gpt_settings_texture.name = "SettingsGPTPanelTexture"
		gpt_settings_texture.modulate = Color(1.20, 1.22, 1.08, gpt_settings_texture.modulate.a)
	# Keep the panel's dedicated clean header as the only title surface. A second
	# high-frequency rail competes with the title and rule selector at compact sizes.
	# 设置面板滑入动画
	if ui_motion_enabled() and DisplayServer.get_name().to_lower() != "headless":
		overlay.modulate = Color(1, 1, 1, 0)
		panel.offset_right = 20.0
		var stw := create_screen_tween()
		stw.set_parallel(true)
		stw.tween_property(overlay, "modulate:a", 1.0, 0.2).from(0.0).set_ease(Tween.EASE_OUT)
		stw.tween_property(panel, "offset_right", 0.0, 0.2).from(20.0).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)

	var title = make_label(panel, "设置", 24, Color(1.0, 0.92, 0.58), true)
	title.name = "SettingsTitleLabel"
	apply_rect(title, SETTINGS_TITLE_RECT)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	title.add_theme_color_override("font_outline_color", Color(0.02, 0.05, 0.03, 0.92))
	title.add_theme_constant_override("outline_size", 4)
	configure_clipped_label(title)
	add_lucide_icon(panel, "settings", rect_full(0.035, 0.050, 0.068, 0.125), Color(0.96, 0.84, 0.46, 0.86))
