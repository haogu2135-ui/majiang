func round_summary_compact_body_text() -> String:
	if last_win_score.is_empty():
		return round_summary
	var winner := clampi(int(last_win_score.get("winner", offline_last_winner)), 0, players.size() - 1)
	var win_tile := str(last_win_score.get("win_tile", ""))
	var action_text := "自摸" if bool(last_win_score.get("self_draw", false)) else "胡"
	var limit_name := str(last_win_score.get("limit_name", ""))
	var result := "%s%s%s · %d番%s %d分 · %s" % [
		str(players[winner].get("name", "玩家")),
		action_text,
		tile_label(win_tile) if win_tile != "" else "",
		int(last_win_score.get("fan", 0)),
		(" " + limit_name) if limit_name != "" else "",
		int(last_win_score.get("points", 0)),
		"庄家连庄" if offline_dealer_repeat else "庄家下庄",
	]
	var settlement_lines: Array[String] = []
	for package_line in active_package_lines():
		settlement_lines.append(str(package_line).trim_suffix("。"))
	if is_offline_match_finished() or round_summary.contains("全场结束"):
		settlement_lines.append("全场结束")
	if not settlement_lines.is_empty():
		result += "\n" + " · ".join(settlement_lines)
	return result


func draw_round_summary(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	if mode != "offline" or offline_phase != "ended":
		return
	var content_size = safe_content_pixel_size()
	var panel_width_px = clampf(content_size.x * 0.500, 480.0, 720.0)
	var panel_height_px = clampf(content_size.y * 0.500, 270.0, 420.0)
	var panel_gap_px = clampf(content_size.y * 0.012, 8.0, 12.0)
	var panel_bottom = action_bar_dock_layout_rect().position.y - panel_gap_px / maxf(1.0, content_size.y)
	var panel_top = panel_bottom - panel_height_px / maxf(1.0, content_size.y)
	var panel_left = 0.5 - panel_width_px / maxf(2.0, content_size.x * 2.0)
	var panel_right = 0.5 + panel_width_px / maxf(2.0, content_size.x * 2.0)
	var panel = make_gpt_plate_rect(rect_full(panel_left, panel_top, panel_right, panel_bottom), Color(0.006, 0.012, 0.010, 1.0), "ui_dark_scrim")
	panel.name = "RoundSummaryPanel"
	panel.z_index = 30
	panel.clip_contents = true
	parent.add_child(panel)
	# 标题栏
	var _gpt_panel_host = make_gpt_plate_rect(ROUND_SUMMARY_HEADER_RECT, Color(0.018, 0.026, 0.022, 0.96), "ui_dark_scrim")
	_gpt_panel_host.name = "GptPanelHost"
	panel.add_child(_gpt_panel_host)
	# 左侧金色装饰
	panel.add_child(make_gpt_edge_rail(rect_full(0.006, 0.04, 0.012, 0.96), Color(0.90, 0.76, 0.36, 0.68)))
	draw_round_summary_ambience(panel)

	# 标题 - 始终显示
	var title = make_label(panel, "本局结算" if not is_offline_match_finished() else "全场结算", 26, Color(0.94, 0.86, 0.48), true)
	title.name = "RoundSummaryTitle"
	apply_rect(title, ROUND_SUMMARY_TITLE_RECT)

	# 胜利丝带和星光 - 始终显示
	draw_summary_victory_ribbon(panel)
	draw_animation_preview(panel, rect_full(0.705, 0.035, 0.785, 0.145), "victory_sparkle")

	# 结算面板弹出动画
	if fx_enabled_effective():
		panel.modulate = Color(1, 1, 1, 0)
		panel.scale = Vector2(0.88, 0.88)
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(panel, "modulate:a", 1.0, 0.22).from(0.0)
		tw.tween_property(panel, "scale", Vector2(1.0, 1.0), 0.22).from(Vector2(0.88, 0.88)).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
	# UIEnhancements: 胜利星光粒子
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and ui_enhancements != null:
		ui_enhancements.create_enhanced_starlight(panel, Rect2(Vector2(0, 0), Vector2(panel.size.x if panel.size.x > 0 else 500, panel.size.y if panel.size.y > 0 else 300)), 8)
		if offline_last_winner == 0:
			ui_enhancements.create_enhanced_particle_burst(panel, Vector2(panel.size.x * 0.5 if panel.size.x > 0 else 250, 40), "gold", 16, 120.0)

	# 胡牌详情展示（如果有）
	if not last_win_score.is_empty() and int(last_win_score.get("fan", 0)) > 0:
		draw_win_detail_section(panel, last_win_score)

	var lines: Array[String] = [round_summary]
	var package_lines = active_package_lines()
	if not package_lines.is_empty():
		lines.append("")
		lines.append_array(package_lines)
	var full_summary_text := "\n".join(lines)
	var compact_summary := effective_viewport_size().y <= 560.0
	var body = make_label(panel, round_summary_compact_body_text(), 12 if compact_summary else 14, Color(0.94, 0.96, 0.90), false)
	body.name = "RoundSummaryBody"
	apply_rect(body, rect_full(0.06, 0.410, 0.94, 0.558))
	body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	body.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	body.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.92))
	body.add_theme_constant_override("outline_size", 2)
	body.clip_text = true
	body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	body.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	body.tooltip_text = full_summary_text
	var rank = 1
	for seat in ranked_seats_by_score():
		draw_round_summary_rank_row(panel, seat, rank)
		rank += 1
	if not is_offline_match_finished():
		var next_dealer = dealer_seat if offline_dealer_repeat else (dealer_seat + 1) % 4
		var next = make_badge(panel, ROUND_SUMMARY_NEXT_DEALER_RECT, "下一局庄家  %s" % players[next_dealer]["name"], 13, Color(0.030, 0.046, 0.048, 0.90), Color(0.46, 0.40, 0.24, 0.36), Color(0.82, 0.86, 0.76))
		next.mouse_filter = Control.MOUSE_FILTER_IGNORE


func draw_round_summary_ambience(parent: Control) -> Control:
	# r206: GPT round summary ambience
	var art = Control.new()
	art.name = "RoundSummaryAmbience"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.0, 0.0, 1.0, 1.0))
	parent.add_child(art)
	var win_stage_key := "win_result_stage"
	var gpt_stage_texture = add_optional_gpt_illustration_texture(art, win_stage_key, rect_full(-0.020, -0.040, 1.020, 1.020), 0.08, false)
	if gpt_stage_texture != null:
		gpt_stage_texture.name = "RoundSummaryGPTWinStageTexture"
		art.move_child(gpt_stage_texture, 0)
	var settlement_wave = add_illustration_texture(art, "summary_settlement_wave", rect_full(0.025, 0.610, 0.975, 0.965), 0.07, false)
	if settlement_wave != null:
		settlement_wave.name = "RoundSummarySettlementWave"
		art.move_child(settlement_wave, 0)
	var laurel = add_illustration_texture(art, "summary_laurel", rect_full(0.040, 0.015, 0.960, 0.250), 0.10, false)
	if laurel != null:
		laurel.name = "RoundSummaryLaurelTexture"
		art.move_child(laurel, 0)
	var victory_texture = add_illustration_texture(art, "victory_badge", rect_full(0.790, 0.010, 0.980, 0.190), 0.30, true)
	if victory_texture != null:
		# Apply gold foil shimmer for premium victory badge feel
		if shader_materials.has("gold_foil_shimmer"):
			var gold_overlay = make_fullrect_overlay(Color(0.92, 0.78, 0.38, 0.20), "ui_soft_flash")
			gold_overlay.name = "VictoryBadgeGoldFoil"
			gold_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
			gold_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
			apply_gold_foil_shader(gold_overlay, 0.7, 0.6)
			victory_texture.add_child(gold_overlay)
		victory_texture.name = "RoundSummaryVictoryBadgeTexture"
		art.move_child(victory_texture, 0)
	var wash = make_gpt_plate_rect(rect_full(0.018, 0.170, 0.982, 0.960), Color(0.82, 0.66, 0.30, 0.032))
	wash.name = "RoundSummaryAmbienceWash"
	art.add_child(wash)
	var orbit = make_gpt_ribbon(rect_full(0.070, 0.720, 0.930, 0.755), Color(0.82, 0.70, 0.36, 0.13))
	orbit.name = "RoundSummaryScoreOrbit"
	art.add_child(orbit)
	var ranked = ranked_seats_by_score()
	var spark_index = 0
	for i in range(ranked.size()):
		var seat = int(ranked[i])
		var center = 0.095 + float(i) * 0.270
		var delta = round_summary_score_delta(seat)
		var accent = round_summary_delta_color(delta, i + 1)
		var node = make_gpt_gate(rect_full(center - 0.020, 0.688, center + 0.020, 0.788), Color(accent.r, accent.g, accent.b, 0.42))
		node.name = "RoundSummaryScoreNode_%d" % seat
		art.add_child(node)
		if delta != 0:
			var spark = make_gpt_tick_strip(rect_full(center - 0.034, 0.662, center + 0.034, 0.814), Color(accent.r, accent.g, accent.b, 0.10))
			spark.name = "RoundSummaryDeltaSpark_%d" % spark_index
			art.add_child(spark)
			spark_index += 1
	draw_round_summary_score_flow_bus(art, ranked)
	if offline_last_winner >= 0 and offline_last_winner < players.size():
		var winner_accent = SEAT_ACCENT_COLORS[offline_last_winner]
		var beacon = make_gpt_plate_rect(rect_full(0.790, 0.035, 0.965, 0.160), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.22), "ui_button_face_plate")
		beacon.name = "RoundSummaryWinnerBeacon"
		art.add_child(beacon)
		var seal = make_seal_stamp(beacon, rect_full(0.070, 0.180, 0.300, 0.820), "胜", "round")
		seal.name = "RoundSummaryWinnerBeaconSeal"
		var ray = make_gpt_ribbon(rect_full(0.320, 0.470, 0.900, 0.530), Color(0.96, 0.82, 0.42, 0.24))
		ray.name = "RoundSummaryWinnerBeaconRay"
		beacon.add_child(ray)
		var settle_route = make_gpt_route_rail(rect_full(0.615, 0.150, 0.885, 0.195), Color(0.006, 0.016, 0.018, 0.44))
		settle_route.name = "RoundSummarySettlementRoute"
		art.add_child(settle_route)
		var settle_fill = make_gpt_meter_fill(rect_full(0.615, 0.158, 0.850, 0.187), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.30))
		settle_fill.name = "RoundSummarySettlementFill"
		art.add_child(settle_fill)
		var settle_gate = make_gpt_gate(rect_full(0.865, 0.105, 0.902, 0.240), Color(0.96, 0.82, 0.42, 0.24))
		settle_gate.name = "RoundSummarySettlementGate"
		art.add_child(settle_gate)
		var tick = add_gpt_tick_strip(art, rect_full(0.660, 0.120, (0.660) + float(2) * (0.066) + (0.018), 0.228), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.26), "RoundSummarySettlementTick_0")
		var winner_bridge = make_gpt_ribbon(rect_full(0.585, 0.235, 0.925, 0.310), Color(0.006, 0.016, 0.018, 0.46))
		winner_bridge.name = "RoundSummaryWinnerSettlementBridge"
		art.add_child(winner_bridge)
		var winner_bridge_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.840, 0.740), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.30))
		winner_bridge_fill.name = "RoundSummaryWinnerSettlementFill"
		winner_bridge.add_child(winner_bridge_fill)
		var winner_source = make_gpt_plate_rect(rect_full(0.555, 0.190, 0.625, 0.355), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.22), "ui_jade_reading_plate")
		winner_source.name = "RoundSummaryWinnerSettlementSource"
		art.add_child(winner_source)
		var winner_gate = make_gpt_gate(rect_full(0.895, 0.170, 0.955, 0.375), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.20))
		winner_gate.name = "RoundSummaryWinnerSettlementGate"
		art.add_child(winner_gate)
		var bridge_tick = add_gpt_tick_strip(art, rect_full(0.675, 0.170, (0.696) + float(2) * (0.072), 0.365), Color(winner_accent.r, winner_accent.g, winner_accent.b, 0.24), "RoundSummaryWinnerSettlementTick_0")
		draw_round_summary_settlement_commit_art(art, offline_last_winner, winner_accent)
	if not is_offline_match_finished():
		var next_route = make_gpt_route_rail(rect_full(0.500, 0.835, 0.865, 0.890), Color(0.006, 0.016, 0.018, 0.44))
		next_route.name = "RoundSummaryNextActionRoute"
		art.add_child(next_route)
		var next_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.820, 0.740), Color(0.80, 0.70, 0.38, 0.28))
		next_fill.name = "RoundSummaryNextActionFill"
		next_route.add_child(next_fill)
		var next_source = make_gpt_plate_rect(rect_full(0.465, 0.805, 0.525, 0.920), Color(0.80, 0.70, 0.38, 0.20), "ui_jade_reading_plate")
		next_source.name = "RoundSummaryNextActionSource"
		art.add_child(next_source)
		var next_action_gate = make_gpt_gate(rect_full(0.845, 0.795, 0.900, 0.930), Color(0.80, 0.70, 0.38, 0.20))
		next_action_gate.name = "RoundSummaryNextActionGate"
		art.add_child(next_action_gate)
		var tick_2 = add_gpt_tick_strip(art, rect_full(0.610, 0.785, (0.630) + float(1) * (0.080), 0.920), Color(0.80, 0.70, 0.38, 0.22), "RoundSummaryNextActionTick_0")
		var gate = make_gpt_gate(rect_full(0.700, 0.880, 0.940, 0.950), Color(0.020, 0.040, 0.040, 0.56))
		gate.name = "RoundSummaryNextHandGate"
		art.add_child(gate)
		for i in range(3):
			var left = 0.060 + float(i) * 0.300
			var pip = make_gpt_plate_rect(rect_full(left, 0.310, left + 0.070, 0.690), Color(0.90, 0.76, 0.34, 0.46), "ui_title_backplate")
			pip.name = "RoundSummaryNextHandPip_%d" % i
			gate.add_child(pip)
	else:
		draw_round_summary_match_complete_art(art, ranked)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.tween_property(orbit, "modulate:a", 0.52, 0.72).from(1.0).set_ease(Tween.EASE_OUT)
		tw.tween_property(orbit, "modulate:a", 1.0, 0.72).from(0.52).set_ease(Tween.EASE_IN)
		if laurel != null:
			var laurel_tw := create_screen_tween()
			laurel_tw.set_loops(48)
			laurel_tw.tween_property(laurel, "modulate:a", 0.10, 2.2).from(0.16)
			laurel_tw.parallel().tween_property(laurel, "offset_left", -8.0, 2.2).from(0.0)
			laurel_tw.parallel().tween_property(laurel, "offset_right", 8.0, 2.2).from(0.0)
			laurel_tw.tween_property(laurel, "modulate:a", 0.16, 2.2).from(0.10)
			laurel_tw.parallel().tween_property(laurel, "offset_left", 0.0, 2.2).from(-8.0)
			laurel_tw.parallel().tween_property(laurel, "offset_right", 0.0, 2.2).from(8.0)
		if victory_texture != null:
			var badge_tw := create_screen_tween()
			badge_tw.set_loops(48)
			badge_tw.tween_property(victory_texture, "modulate:a", 0.18, 1.5).from(0.30)
			badge_tw.parallel().tween_property(victory_texture, "rotation", 0.035, 1.5).from(-0.025)
			badge_tw.tween_property(victory_texture, "modulate:a", 0.34, 1.5).from(0.18)
			badge_tw.parallel().tween_property(victory_texture, "rotation", -0.025, 1.5).from(0.035)
		if settlement_wave != null:
			var wave_tw := create_screen_tween()
			wave_tw.set_loops(48)
			wave_tw.tween_property(settlement_wave, "modulate:a", 0.22, 2.0).from(0.10)
			wave_tw.parallel().tween_property(settlement_wave, "position:y", settlement_wave.position.y - 3.0, 2.0).from(settlement_wave.position.y + 2.0)
			wave_tw.tween_property(settlement_wave, "modulate:a", 0.10, 2.0).from(0.22)
			wave_tw.parallel().tween_property(settlement_wave, "position:y", settlement_wave.position.y + 2.0, 2.0).from(settlement_wave.position.y - 3.0)
	return art


func draw_round_summary_score_flow_bus(parent: Control, ranked: Array) -> Control:
	# r211: GPT chrome conversion
	var bus = Control.new()
	bus.name = "RoundSummaryScoreFlowBus"
	bus.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bus.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(bus)
	var flow_texture = add_optional_gpt_illustration_texture(bus, "round_summary_score_flow_bus", rect_full(0.052, 0.742, 0.948, 0.958), 0.18, false)
	if flow_texture != null:
		flow_texture.name = "RoundSummaryScoreFlowGPTTexture"
		bus.move_child(flow_texture, 0)
	if ranked.is_empty() or last_score_deltas.is_empty():
		return bus
	var winner = offline_last_winner
	var winner_index = ranked.find(winner)
	if winner_index < 0:
		winner_index = 0
	var winner_x = 0.095 + float(winner_index) * 0.270
	var spine = make_gpt_route_rail(rect_full(0.080, 0.792, 0.920, 0.828), Color(0.006, 0.016, 0.018, 0.42))
	spine.name = "RoundSummaryScoreFlowSpine"
	bus.add_child(spine)
	var total_positive = 0
	var total_negative = 0
	for delta in last_score_deltas:
		if int(delta) > 0:
			total_positive += int(delta)
		elif int(delta) < 0:
			total_negative += abs(int(delta))
	var total_flow = max(1, max(total_positive, total_negative))
	var flow_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * clamp(float(total_flow) / 10800.0, 0.24, 1.0), 0.740), Color(0.86, 0.70, 0.36, 0.28))
	flow_fill.name = "RoundSummaryScoreFlowSpineFill"
	spine.add_child(flow_fill)
	var winner_gate = make_gpt_gate(rect_full(winner_x - 0.026, 0.760, winner_x + 0.026, 0.862), Color(0.82, 0.66, 0.28, 0.30))
	winner_gate.name = "RoundSummaryScoreFlowWinnerGate"
	bus.add_child(winner_gate)
	var winner_glyph = make_label(winner_gate, "收", 7, Color(0.98, 0.92, 0.66, 0.86), true)
	winner_glyph.name = "RoundSummaryScoreFlowWinnerGlyph"
	apply_rect(winner_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var payer_count := 0
	for i in range(ranked.size()):
		var seat = int(ranked[i])
		var delta = round_summary_score_delta(seat)
		var seat_x = 0.095 + float(i) * 0.270
		var magnitude = clamp(abs(float(delta)) / float(total_flow), 0.16, 1.0)
		var accent = round_summary_delta_color(delta, i + 1)
		var node = make_gpt_gate(rect_full(seat_x - 0.032, 0.835, seat_x + 0.032, 0.925), Color(accent.r, accent.g, accent.b, 0.18))
		node.name = "RoundSummaryScoreFlowNode_%d" % seat
		bus.add_child(node)
		var amount = make_label(node, compact_score_text(abs(delta)), 6, Color(0.96, 0.92, 0.72, 0.82), true)
		amount.name = "RoundSummaryScoreFlowAmount_%d" % seat
		apply_rect(amount, rect_full(0.0, 0.0, 1.0, 1.0))
		if delta < 0:
			var left = min(seat_x, winner_x)
			var right = max(seat_x, winner_x)
			var route = make_gpt_route_rail(rect_full(left, 0.848, right, 0.882), Color(0.006, 0.016, 0.018, 0.40))
			route.name = "RoundSummaryScoreFlowPayerRoute_%d" % seat
			bus.add_child(route)
			var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.900 * magnitude, 0.740), Color(0.74, 0.38, 0.30, 0.26))
			fill.name = "RoundSummaryScoreFlowPayerFill_%d" % seat
			route.add_child(fill)
			var gate_x = winner_x if seat_x < winner_x else winner_x - 0.010
			var gate = make_gpt_gate(rect_full(gate_x - 0.010, 0.820, gate_x + 0.010, 0.910), Color(0.96, 0.72, 0.38, 0.24))
			gate.name = "RoundSummaryScoreFlowPayerGate_%d" % seat
			bus.add_child(gate)
			for tick_i in range(2):
				var t = 0.34 + float(tick_i) * 0.22
				var tick_x = lerp(seat_x, winner_x, t)
				var tick = make_gpt_tick_strip(rect_full(tick_x - 0.006, 0.815, tick_x + 0.008, 0.902), Color(0.74, 0.38, 0.30, 0.22 - float(tick_i) * 0.045))
				tick.name = "RoundSummaryScoreFlowPayerTick_%d_%d" % [seat, tick_i]
				bus.add_child(tick)
			payer_count += 1
	var archive = make_gpt_gate(rect_full(0.835, 0.774, 0.910, 0.916), Color(0.82, 0.66, 0.28, 0.16))
	archive.name = "RoundSummaryScoreFlowArchive"
	bus.add_child(archive)
	var archive_glyph = make_label(archive, "%d" % payer_count, 8, Color(0.98, 0.92, 0.66, 0.84), true)
	archive_glyph.name = "RoundSummaryScoreFlowArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tick_2 = add_gpt_tick_strip(bus, rect_full(0.640, 0.770, (0.660) + float(2) * (0.056), 0.898), Color(0.86, 0.70, 0.36, 0.22), "RoundSummaryScoreFlowTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		bus.modulate.a = 0.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(bus, "modulate:a", 1.0, 0.16).from(0.0).set_delay(0.16)
		tw.tween_property(flow_fill, "anchor_right", 0.980, 0.28).from(0.060).set_delay(0.20).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_property(winner_gate, "scale", Vector2(1.10, 1.10), 0.18).from(Vector2(0.84, 0.84)).set_delay(0.24).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	return bus


func draw_round_summary_delta_bar(row: Control, delta: int) -> Control:
	# r214: bulk GPT chrome sweep
	var bar_root = Control.new()
	bar_root.name = "RoundSummaryDeltaBar"
	bar_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bar_root, rect_full(0.185, 0.785, 0.970, 0.910))
	row.add_child(bar_root)
	var _gpt_panel_host = make_gpt_plate_rect(rect_full(0.0, 0.22, 1.0, 0.78), Color(0.006, 0.014, 0.016, 0.72), "ui_button_face_plate")
	_gpt_panel_host.name = "GptPanelHost"
	bar_root.add_child(_gpt_panel_host)
	var fraction = round_summary_delta_bar_fraction(delta)
	var center = 0.5
	var accent = Color(0.30, 0.64, 0.46, 0.78) if delta >= 0 else Color(0.68, 0.34, 0.30, 0.78)
	var left = center if delta >= 0 else center - fraction * 0.48
	var right = center + fraction * 0.48 if delta >= 0 else center
	var fill = make_gpt_meter_fill(rect_full(left, 0.18, right, 0.82), accent)
	fill.name = "RoundSummaryDeltaBarFill"
	bar_root.add_child(fill)
	var center_gate = make_gpt_gate(rect_full(0.492, 0.02, 0.508, 0.98), Color(0.88, 0.78, 0.50, 0.34))
	center_gate.name = "RoundSummaryDeltaCenterGate"
	bar_root.add_child(center_gate)
	for i in range(3):
		var tick_left = (0.545 + float(i) * 0.050) if delta >= 0 else (0.435 - float(i) * 0.050)
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.000, tick_left + 0.018, 0.200), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040))
		tick.name = "RoundSummaryDeltaTick_0"
		bar_root.add_child(tick)
	return bar_root


func draw_round_summary_match_complete_art(parent: Control, ranked: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var art = Control.new()
	art.name = "RoundSummaryMatchCompleteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.075, 0.840, 0.940, 0.975))
	parent.add_child(art)
	var laurel = add_illustration_texture(art, "summary_laurel", rect_full(-0.025, -1.980, 1.025, 0.520), 0.14, false)
	if laurel != null:
		laurel.name = "RoundSummaryMatchCompleteLaurel"
		art.move_child(laurel, 0)
	var champion = int(ranked[0]) if not ranked.is_empty() else 0
	var accent = round_summary_delta_color(round_summary_score_delta(champion), 1)
	var rail = make_gpt_route_rail(rect_full(0.085, 0.455, 0.930, 0.545), Color(0.006, 0.016, 0.018, 0.48))
	rail.name = "RoundSummaryMatchCompleteRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.925, 0.740), Color(0.86, 0.66, 0.28, 0.28))
	fill.name = "RoundSummaryMatchCompleteFill"
	rail.add_child(fill)
	var champion_node = make_gpt_gate(rect_full(0.020, 0.135, 0.105, 0.865), Color(accent.r, accent.g, accent.b, 0.24))
	champion_node.name = "RoundSummaryChampionNode"
	art.add_child(champion_node)
	var champion_glyph = make_label(champion_node, "冠", 10, Color(0.98, 0.92, 0.68, 0.92), true)
	champion_glyph.name = "RoundSummaryChampionGlyph"
	apply_rect(champion_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_gate = make_gpt_gate(rect_full(0.900, 0.190, 0.965, 0.810), Color(0.86, 0.66, 0.28, 0.22))
	archive_gate.name = "RoundSummaryMatchArchiveGate"
	art.add_child(archive_gate)
	var archive_glyph = make_label(archive_gate, "终", 9, Color(0.98, 0.92, 0.68, 0.90), true)
	archive_glyph.name = "RoundSummaryMatchArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var final_route = make_gpt_route_rail(rect_full(0.150, 0.180, 0.865, 0.255), Color(0.006, 0.016, 0.018, 0.40))
	final_route.name = "RoundSummaryFinalRankRoute"
	art.add_child(final_route)
	var final_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.900, 0.740), Color(0.72, 0.56, 0.32, 0.22))
	final_fill.name = "RoundSummaryFinalRankFill"
	final_route.add_child(final_fill)
	for i in range(min(4, ranked.size())):
		var seat = int(ranked[i])
		var center = 0.205 + float(i) * 0.185
		var seat_accent = round_summary_delta_color(round_summary_score_delta(seat), i + 1)
		var node = make_gpt_gate(rect_full(center - 0.024, 0.055, center + 0.024, 0.380), Color(seat_accent.r, seat_accent.g, seat_accent.b, 0.28 if i == 0 else 0.18))
		node.name = "RoundSummaryFinalRankNode_%d" % seat
		art.add_child(node)
		var drop = make_gpt_plate_rect(rect_full(center - 0.006, 0.350, center + 0.006, 0.565), Color(seat_accent.r, seat_accent.g, seat_accent.b, 0.18))
		drop.name = "RoundSummaryFinalRankDrop_%d" % seat
		art.add_child(drop)
	var tick = add_gpt_tick_strip(art, rect_full(0.365, 0.620, (0.365) + float(3) * (0.088) + (0.016), 0.830), Color(0.86, 0.66, 0.28, 0.24), "RoundSummaryMatchCompleteTick_0")
	var seal = make_gpt_gate(rect_full(0.805, 0.590, 0.850, 0.850), Color(0.96, 0.82, 0.42, 0.20))
	seal.name = "RoundSummaryFinalSeal"
	art.add_child(seal)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.42, 0.82).from(0.94)
		tw.parallel().tween_property(archive_gate, "modulate:a", 0.50, 0.82).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.94, 0.82).from(0.42)
		tw.parallel().tween_property(archive_gate, "modulate:a", 0.92, 0.82).from(0.50)
		if laurel != null:
			var laurel_tw := create_screen_tween()
			laurel_tw.set_loops(12)
			laurel_tw.tween_property(laurel, "modulate:a", 0.08, 1.6).from(0.14)
			laurel_tw.parallel().tween_property(laurel, "offset_top", -6.0, 1.6).from(0.0)
			laurel_tw.tween_property(laurel, "modulate:a", 0.14, 1.6).from(0.08)
			laurel_tw.parallel().tween_property(laurel, "offset_top", 0.0, 1.6).from(-6.0)
	return art


func draw_round_summary_rank_route_art(row: Control, rank: int, delta: int, accent: Color) -> Control:
	# r213: GPT chrome conversion
	var art = Control.new()
	art.name = "RoundSummaryRankRouteArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.035, 0.060, 0.975, 0.955))
	row.add_child(art)
	var rail = make_gpt_route_rail(rect_full(0.165, 0.170, 0.965, 0.265), Color(0.006, 0.014, 0.016, 0.46))
	rail.name = "RoundSummaryRankRouteRail"
	art.add_child(rail)
	var fill_end = 0.080 + 0.880 * clamp((5.0 - float(rank)) / 4.0, 0.12, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, fill_end, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "RoundSummaryRankRouteFill"
	rail.add_child(fill)
	for i in range(4):
		var left = 0.195 + float(i) * 0.205
		var node_alpha = 0.32 if i <= 4 - rank else 0.13
		var node = make_gpt_gate(rect_full(left, 0.120, left + 0.030, 0.315), Color(accent.r, accent.g, accent.b, node_alpha))
		node.name = "RoundSummaryRankRouteNode_%d" % i
		art.add_child(node)
	var trend_color = Color(0.34, 0.72, 0.50) if delta >= 0 else Color(0.78, 0.38, 0.34)
	var trend_left = 0.700 if delta >= 0 else 0.615
	var trend = make_gpt_plate_rect(rect_full(trend_left, 0.370, trend_left + 0.185, 0.680), Color(trend_color.r, trend_color.g, trend_color.b, 0.14), "ui_jade_reading_plate")
	trend.name = "RoundSummaryRankTrendGlow"
	art.add_child(trend)
	for i in range(3):
		var spark_left = trend_left + 0.030 + float(i) * 0.048
		var spark_top = 0.475 - float(sign(delta)) * float(i) * 0.030
		var spark = make_gpt_gate(rect_full(spark_left, spark_top, spark_left + 0.024, spark_top + 0.110), Color(trend_color.r, trend_color.g, trend_color.b, 0.26 - float(i) * 0.035))
		spark.name = "RoundSummaryRankTrendSpark_%d" % i
		art.add_child(spark)
	fill.modulate = Color(1, 1, 1, 0.82)
	return art


func draw_round_summary_rank_row(parent: Control, seat: int, rank: int) -> void:
	# r214: bulk GPT chrome sweep
	var top = ROUND_SUMMARY_RANK_START_Y + float(rank - 1) * (ROUND_SUMMARY_RANK_ROW_HEIGHT + ROUND_SUMMARY_RANK_ROW_GAP)
	var row_rect = Rect2(Vector2(0.08, top), Vector2(0.92, top + ROUND_SUMMARY_RANK_ROW_HEIGHT))
	var delta = round_summary_score_delta(seat)
	var accent = round_summary_delta_color(delta, rank)
	var row = make_gpt_plate_rect(row_rect, Color(0.006, 0.012, 0.010, 0.98), "ui_dark_scrim")
	row.name = "RoundSummaryRankRow_%d" % seat
	parent.add_child(row)
	var rank_texture = add_illustration_texture(row, "rank_row_ribbon", rect_full(0.010, 0.040, 0.990, 0.960), 0.11, false)
	if rank_texture != null:
		rank_texture.name = "RankRowRibbonTexture_%d" % seat
		row.move_child(rank_texture, 0)
	var rank_key = "rank_ribbon_gold" if rank == 1 else "rank_ribbon_silver" if rank == 2 else "rank_ribbon_bronze" if rank == 3 else ""
	if rank_key != "":
		var tier_ribbon = add_optional_gpt_illustration_texture(row, rank_key, rect_full(0.020, 0.080, 0.185, 0.920), 0.58, true)
		if tier_ribbon != null:
			tier_ribbon.name = "RankTierRibbonTexture_%d" % rank
			row.move_child(tier_ribbon, min(1, row.get_child_count() - 1))
	row.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.026, 1.0), accent))
	draw_round_summary_rank_route_art(row, rank, delta, accent)
	var rank_badge = make_badge(row, rect_full(0.045, 0.18, 0.155, 0.82), "第%d" % rank, 13, accent.darkened(0.12), accent.lightened(0.10), Color(0.98, 0.96, 0.88))
	rank_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if seat == offline_last_winner:
		var winner_seal = make_seal_stamp(row, rect_full(0.020, 0.080, 0.060, 0.480), "胜", "round")
		winner_seal.name = "RoundSummaryWinnerSeal"
	var name = make_label(row, str(players[seat]["name"]), 15, Color(0.96, 0.97, 0.92), true)
	apply_rect(name, rect_full(0.185, 0.12, 0.500, 0.88))
	name.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(name)
	var score = make_label(row, compact_score_text(int(players[seat].get("score", 0))), 15, Color(0.96, 0.97, 0.92), true)
	apply_rect(score, rect_full(0.500, 0.12, 0.675, 0.88))
	score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(score)
	var delta_label = make_label(row, round_summary_delta_text(delta), 14, accent.lightened(0.36), true)
	apply_rect(delta_label, rect_full(0.700, 0.12, 0.835, 0.88))
	delta_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(delta_label)
	# Animate score delta number roll
	if fx_enabled_effective() and delta != 0 and DisplayServer.get_name().to_lower() != "headless":
		var delay_for_roll = 0.28 + float(rank - 1) * 0.072
		delta_label.text = "0"
		var delta_label_id := delta_label.get_instance_id()
		var roll_tw := create_screen_tween()
		roll_tw.tween_callback(func() -> void:
			var roll_label := instance_from_id(delta_label_id) as Label
			if roll_label == null:
				return
			AnimationEffects.animate_number(roll_label, delta, 0.4)
		).set_delay(delay_for_roll)
	var flowers = make_label(row, "花%d" % int(players[seat].get("flowers", 0)), 13, Color(0.86, 0.90, 0.84), false)
	apply_rect(flowers, rect_full(0.860, 0.12, 0.970, 0.88))
	flowers.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(flowers)
	draw_round_summary_delta_bar(row, delta)
	if fx_enabled_effective():
		row.modulate = Color(1, 1, 1, 0)
		row.offset_left = -10.0
		row.offset_right = -10.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		var delay = 0.14 + float(rank - 1) * 0.072
		tw.tween_property(row, "modulate:a", 1.0, 0.22).from(0.0).set_delay(delay).set_ease(Tween.EASE_OUT)
		tw.tween_property(row, "offset_left", 0.0, 0.22).from(-18.0).set_delay(delay).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_property(row, "offset_right", 0.0, 0.22).from(-18.0).set_delay(delay).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		# 分数变化从右侧飞入 / Score delta fly-in
		var delta_bar = row.get_node_or_null("RoundSummaryDeltaBar")
		if delta_bar != null and is_instance_valid(delta_bar):
			delta_bar.modulate.a = 0.0
			var d_tw := create_screen_tween()
			d_tw.tween_property(delta_bar, "modulate:a", 1.0, 0.18).from(0.0).set_delay(delay + 0.12).set_ease(Tween.EASE_OUT)


func draw_round_summary_settlement_commit_art(parent: Control, winner: int, accent: Color) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "RoundSummarySettlementCommitArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var winner_rank_index = max(0, ranked_seats_by_score().find(winner))
	var source_x = clamp(0.095 + float(winner_rank_index) * 0.270, 0.095, 0.905)
	var source = make_gpt_plate_rect(rect_full(source_x - 0.028, 0.648, source_x + 0.028, 0.805), Color(accent.r, accent.g, accent.b, 0.20), "ui_jade_reading_plate")
	source.name = "RoundSummarySettlementCommitSource"
	art.add_child(source)
	var route_left = min(source_x + 0.018, 0.500)
	var route_right = max(source_x + 0.018, 0.500)
	var route = make_gpt_route_rail(rect_full(route_left, 0.755, route_right, 0.820), Color(0.006, 0.016, 0.018, 0.44))
	route.name = "RoundSummarySettlementCommitRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.240, 0.820, 0.760), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "RoundSummarySettlementCommitFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.470, 0.690, 0.530, 0.865), Color(accent.r, accent.g, accent.b, 0.22))
	gate.name = "RoundSummarySettlementCommitGate"
	art.add_child(gate)
	var archive = make_gpt_gate(rect_full(0.540, 0.710, 0.635, 0.865), Color(0.92, 0.72, 0.34, 0.14))
	archive.name = "RoundSummarySettlementArchiveNode"
	art.add_child(archive)
	var glyph = make_label(archive, "账", 8, Color(0.98, 0.92, 0.66, 0.84), true)
	glyph.name = "RoundSummarySettlementArchiveGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var t = 0.280 + float(i) * 0.180
		var tick_x = lerp(source_x, 0.500, t)
		var tick = make_gpt_tick_strip(rect_full(tick_x - 0.006, 0.678, tick_x + 0.008, 0.852), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040))
		tick.name = "RoundSummarySettlementCommitTick_0"
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.575 + float(i) * 0.026, 0.655, 0.590 + float(i) * 0.026, 0.705), Color(accent.r, accent.g, accent.b, 0.26 - float(i) * 0.050))
		pip.name = "RoundSummarySettlementArchivePip_%d" % i
		art.add_child(pip)
	if fx_enabled_effective():
		art.modulate.a = 0.0
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(art, "modulate:a", 1.0, 0.08).from(0.0)
		tw.tween_property(fill, "anchor_right", 0.980, 0.20).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.16).from(Vector2(0.84, 0.84)).set_ease(Tween.EASE_OUT)
		tw.tween_property(archive, "modulate:a", 1.0, 0.12).from(0.42)
	else:
		art.modulate.a = 0.88
	return art


