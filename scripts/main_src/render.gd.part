func draw_menu_hero_wind_path(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var path = Control.new()
	path.name = "MenuHeroWindPath"
	path.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(path, rect_full(0.075, 0.305, 0.925, 0.705))
	parent.add_child(path)
	var rail = add_optional_gpt_illustration_texture(path, "ui_progress_signal_strip", rect_full(0.050, 0.430, 0.950, 0.570), 0.42, false)
	if rail == null:
		rail = make_gpt_route_rail(rect_full(0.060, 0.485, 0.940, 0.515), Color(0.72, 0.80, 0.72, 0.105))
		path.add_child(rail)
	rail.name = "MenuHeroWindGptRail"
	var fill = add_optional_gpt_illustration_texture(path, "ui_meter_rail_plate", rect_full(0.060, 0.470, 0.710, 0.530), 0.55, false)
	if fill == null:
		fill = make_gpt_meter_fill(rect_full(0.060, 0.492, 0.710, 0.508), Color(0.92, 0.78, 0.38, 0.245))
		path.add_child(fill)
	fill.name = "MenuHeroWindGptFill"
	var gate = make_gpt_gate(rect_full(0.800, 0.410, 0.865, 0.590), Color(0.92, 0.78, 0.38, 0.145))
	gate.name = "MenuHeroWindPathGate"
	path.add_child(gate)
	for i in range(4):
		var t = 0.180 + float(i) * 0.185
		var tick = make_gpt_tick_strip(rect_full(t, 0.430, t + 0.014, 0.570), Color(0.92, 0.78, 0.38, 0.195 - float(i) * 0.026))
		tick.name = "MenuHeroWindPathTick_0"
		path.add_child(tick)
	for i in range(3):
		var leaf = make_gpt_edge_rail(rect_full(0.220 + float(i) * 0.190, 0.270 + float(i % 2) * 0.255, 0.260 + float(i) * 0.190, 0.360 + float(i % 2) * 0.255), Color(0.38, 0.66, 0.52, 0.18))
		leaf.name = "MenuHeroWindLeaf_%d" % i
		path.add_child(leaf)
		leaf.rotation = -0.45 + float(i) * 0.22
	fill.modulate = Color(1, 1, 1, 0.84)
	for i in range(3):
		var leaf_node = path.get_node_or_null("MenuHeroWindLeaf_%d" % i)
		if leaf_node != null:
			leaf_node.modulate = Color(1, 1, 1, 0.76)
	return path


