	return route


func draw_tile_flip_signal_art(tile_view: Control, from_face_up: bool) -> Control:
	if tile_view == null or not is_instance_valid(tile_view):
		return null
	var art = Control.new()
	art.name = "TileFlipSignalArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	tile_view.add_child(art)
	var accent = Color(0.84, 0.68, 0.30) if from_face_up else Color(0.42, 0.72, 0.62)
	var halo = add_illustration_texture(art, "tile_flip_halo", rect_full(-0.180, -0.180, 1.180, 1.180), 0.20, true)
	if halo != null:
		halo.name = "TileFlipHalo"
	var axis = make_gpt_plate_rect(rect_full(0.470, 0.095, 0.530, 0.905), Color(accent.r, accent.g, accent.b, 0.30))
	axis.name = "TileFlipAxis"
	art.add_child(axis)
	var axis_core = make_gpt_plate_rect(rect_full(0.492, 0.140, 0.508, 0.860), Color(1.0, 0.92, 0.56, 0.34))
	axis_core.name = "TileFlipAxisCore"
	art.add_child(axis_core)
	var source_gate = make_gpt_gate(rect_full(0.120, 0.430, 0.270, 0.570), Color(accent.r, accent.g, accent.b, 0.18))
	source_gate.name = "TileFlipSourceGate"
	art.add_child(source_gate)
	var reveal_gate = make_gpt_gate(rect_full(0.730, 0.430, 0.880, 0.570), Color(0.96, 0.84, 0.48, 0.20))
	reveal_gate.name = "TileFlipRevealGate"
	art.add_child(reveal_gate)
	var route = make_gpt_route_rail(rect_full(0.185, 0.815, 0.815, 0.860), Color(0.006, 0.016, 0.018, 0.38))
	route.name = "TileFlipRoute"
	art.add_child(route)
	var fill_right = 0.680 if from_face_up else 0.840
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.230, fill_right, 0.770), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "TileFlipRouteFill"
	route.add_child(fill)
	var tick = add_gpt_tick_strip(art, rect_full(0.305, 0.180, (0.305) + float(2) * (0.190) + (0.036), 0.330), Color(accent.r, accent.g, accent.b, 0.26), "TileFlipRhythmTick_0")
	var face_badge = make_gpt_gate(rect_full(0.405, 0.035, 0.595, 0.115), Color(accent.r, accent.g, accent.b, 0.18))
	face_badge.name = "TileFlipFaceBadge_front" if from_face_up else "TileFlipFaceBadge_back"
	art.add_child(face_badge)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if halo != null:
			var halo_tw := create_screen_tween()
			halo_tw.set_loops(2)
			halo_tw.tween_property(halo, "rotation", 0.16, 0.16).from(-0.16)
			halo_tw.parallel().tween_property(halo, "modulate:a", 0.30, 0.16).from(0.12)
			halo_tw.tween_property(halo, "rotation", -0.16, 0.16).from(0.16)
			halo_tw.parallel().tween_property(halo, "modulate:a", 0.12, 0.16).from(0.30)
		var tw := create_screen_tween()
		tw.set_loops(2)
		tw.tween_property(axis, "modulate:a", 0.42, 0.16).from(1.0)
		tw.parallel().tween_property(route, "modulate:a", 0.56, 0.16).from(0.96)
		tw.tween_property(axis, "modulate:a", 1.0, 0.16).from(0.42)
		tw.parallel().tween_property(route, "modulate:a", 0.96, 0.16).from(0.56)
	return art

func draw_tile_status_route_art(parent: Control, risk: String, hint_badge: String) -> Control:
	# r214: bulk GPT chrome sweep
	var accent = tile_hint_badge_color(hint_badge) if hint_badge != "" else tile_risk_color(risk)
	var route = make_gpt_route_rail(rect_full(0.120, 0.825, 0.880, 0.900), Color(0.006, 0.014, 0.016, 0.36))
	route.name = "TileStatusRoute"
	parent.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.050, 0.280, 0.780 if hint_badge != "" else 0.620, 0.720), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "TileStatusFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.755, 0.730, 0.870, 0.945), Color(accent.r, accent.g, accent.b, 0.16))
	gate.name = "TileStatusGate"
	parent.add_child(gate)
	var tick = add_gpt_tick_strip(parent, rect_full(0.410, 0.735, (0.445) + float(1) * (0.100), 0.805), Color(accent.r, accent.g, accent.b, 0.22), "TileStatusTick_0")
	# 商用反馈：风险/提示状态轻微呼吸，避免静态仪表盘感
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var peak := 0.96 if hint_badge != "" else 0.88
		var trough := 0.48 if hint_badge != "" else 0.56
		var pulse_tw := create_screen_tween()
		pulse_tw.set_loops(48)
		pulse_tw.tween_property(fill, "modulate:a", trough, 0.70).from(peak)
		pulse_tw.parallel().tween_property(gate, "modulate:a", trough * 0.85, 0.70).from(peak * 0.90)
		pulse_tw.tween_property(fill, "modulate:a", peak, 0.70).from(trough)
		pulse_tw.parallel().tween_property(gate, "modulate:a", peak * 0.90, 0.70).from(trough * 0.85)
	return route


func draw_toast_illustration(toast_bg: Control, text: String) -> void:
	# r210: GPT chrome conversion
	var accent = toast_accent_color(text)
	var toast_gpt_key := "toast_gpt_banner"
	var toast_gpt_texture = add_optional_gpt_illustration_texture(toast_bg, toast_gpt_key, rect_full(0.018, -0.080, 0.982, 1.080), 0.42, false)
	if toast_gpt_texture != null:
		toast_gpt_texture.name = "ToastGPTBannerTexture"
		toast_bg.move_child(toast_gpt_texture, 0)
	var ribbon = add_illustration_texture(toast_bg, "toast_ribbon", rect_full(0.035, 0.055, 0.965, 0.945), 0.18, false)
	if ribbon != null:
		ribbon.name = "ToastRibbonTexture"
		toast_bg.move_child(ribbon, 0)
	var notice_wave = add_illustration_texture(toast_bg, "toast_notice_wave", rect_full(0.060, -0.100, 0.960, 1.100), 0.13, false)
	if notice_wave != null:
		notice_wave.name = "ToastNoticeWaveTexture"
	var seal = make_gpt_gate(rect_full(0.035, 0.18, 0.095, 0.82), Color(accent.r, accent.g, accent.b, 0.28))
	seal.name = "ToastIconSeal"
	toast_bg.add_child(seal)
	var icon_name = toast_icon_name(text)
	if icon_name != "":
		add_lucide_icon(seal, icon_name, rect_full(0.24, 0.24, 0.76, 0.76), Color(0.96, 0.92, 0.72, 0.92))
	var sheen = make_gpt_ribbon(rect_full(0.115, 0.18, 0.910, 0.28), Color(1.0, 0.90, 0.48, 0.12))
	sheen.name = "ToastSheen"
	toast_bg.add_child(sheen)
	var route = make_gpt_route_rail(rect_full(0.145, 0.525, 0.695, 0.625), Color(0.006, 0.016, 0.018, 0.42))
	route.name = "ToastMessageRoute"
	toast_bg.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.760, 0.740), Color(accent.r, accent.g, accent.b, 0.26))
	route_fill.name = "ToastMessageRouteFill"
	route.add_child(route_fill)
	for i in range(3):
		var left = 0.190 + float(i) * 0.155
		var node = make_gpt_gate(rect_full(left, 0.470, left + 0.022, 0.665), Color(accent.r, accent.g, accent.b, 0.28 - float(i) * 0.030))
		node.name = "ToastMessageRouteNode_%d" % i
		toast_bg.add_child(node)
	var type_node = make_gpt_gate(rect_full(0.805, 0.315, 0.850, 0.675), Color(accent.r, accent.g, accent.b, 0.18))
	type_node.name = "ToastTypeNode"
	toast_bg.add_child(type_node)
	var life_rail = make_gpt_route_rail(rect_full(0.140, 0.760, 0.780, 0.860), Color(0.006, 0.016, 0.018, 0.54))
	life_rail.name = "ToastLifeRail"
	toast_bg.add_child(life_rail)
	var life_fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.840, 0.740), Color(accent.r, accent.g, accent.b, 0.36))
	life_fill.name = "ToastLifeFill"
	life_rail.add_child(life_fill)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if ribbon != null:
			ribbon.modulate.a = 0.14
		life_fill.modulate = Color(1, 1, 1, 0.82)
	var confirm_route = make_gpt_route_rail(rect_full(0.545, 0.665, 0.780, 0.725), Color(0.006, 0.016, 0.018, 0.42))
	confirm_route.name = "ToastConfirmRoute"
	toast_bg.add_child(confirm_route)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.780, 0.750), Color(accent.r, accent.g, accent.b, 0.26))
	confirm_fill.name = "ToastConfirmFill"
	confirm_route.add_child(confirm_fill)
	var confirm_gate = make_gpt_gate(rect_full(0.752, 0.555, 0.785, 0.760), Color(0.96, 0.82, 0.42, 0.24))
	confirm_gate.name = "ToastConfirmGate"
	toast_bg.add_child(confirm_gate)
	var ack_bridge = make_gpt_route_rail(rect_full(0.675, 0.600, 0.755, 0.660), Color(0.006, 0.016, 0.018, 0.34))
	ack_bridge.name = "ToastAckBridge"
	toast_bg.add_child(ack_bridge)
	var ack_fill = make_gpt_meter_fill(rect_full(0.000, 0.000, 0.720, 1.000), Color(accent.r, accent.g, accent.b, 0.22))
	ack_fill.name = "ToastAckBridgeFill"
	ack_bridge.add_child(ack_fill)
	var ack_gate = make_gpt_gate(rect_full(0.732, 0.590, 0.760, 0.685), Color(accent.r, accent.g, accent.b, 0.20))
	ack_gate.name = "ToastAckBridgeGate"
	toast_bg.add_child(ack_gate)
	for i in range(2):
		var confirm_tick_left = 0.610 + float(i) * 0.046
		var confirm_tick = make_gpt_tick_strip(rect_full(confirm_tick_left, 0.555, confirm_tick_left + 0.014, 0.760), Color(accent.r, accent.g, accent.b, 0.25 - float(i) * 0.045))
		confirm_tick.name = "ToastConfirmTick_0"
		toast_bg.add_child(confirm_tick)
	for i in range(2):
		var ack_tick_left = 0.690 + float(i) * 0.030
		var ack_tick = make_gpt_tick_strip(rect_full(ack_tick_left, 0.675, ack_tick_left + 0.010, 0.745), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.035))
		ack_tick.name = "ToastAckBridgeTick_0"
		toast_bg.add_child(ack_tick)
	for i in range(3):
		var left = 0.730 + float(i) * 0.035
		var dot = make_gpt_gate(rect_full(left, 0.315 + float(i % 2) * 0.190, left + 0.016, 0.425 + float(i % 2) * 0.190), Color(accent.r, accent.g, accent.b, 0.30 - float(i) * 0.045))
		dot.name = "ToastStatusDot_%d" % i
		toast_bg.add_child(dot)
	play_toast_entry_feedback(toast_bg, accent)
	var spark_count = 3 if text.find("成功") >= 0 or text.find("完成") >= 0 else 2
	for i in range(spark_count):
		var left = 0.900 + float(i) * 0.026
		var spark = make_gpt_gate(rect_full(left, 0.26 + float(i % 2) * 0.22, left + 0.014, 0.40 + float(i % 2) * 0.22), Color(accent.r, accent.g, accent.b, 0.48))
		spark.name = "ToastSpark_%d" % i
		toast_bg.add_child(spark)
	if text.find("成就") >= 0:
		draw_achievement_toast_art(toast_bg, accent)
	var item_key = toast_item_key_for_text(text)
	if item_key != "":
		draw_item_toast_art(toast_bg, item_key, accent)
		if text.find("不足") >= 0 or text.find("失败") >= 0:
			draw_item_toast_denied_route(toast_bg, item_key, accent)
	if toast_is_reward_text(text):
		draw_toast_reward_bridge(toast_bg, text, accent)
	if toast_is_chat_send_text(text):
		draw_chat_send_toast_art(toast_bg, accent)


func draw_toast_reward_bridge(toast_bg: Control, text: String, accent: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var bridge = Control.new()
	bridge.name = "ToastRewardBridge"
	bridge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(bridge, rect_full(0.115, 0.215, 0.935, 0.805))
	toast_bg.add_child(bridge)
	var rail = make_gpt_route_rail(rect_full(0.055, 0.500, 0.945, 0.565), Color(0.006, 0.016, 0.018, 0.34))
	rail.name = "ToastRewardBridgeRail"
	bridge.add_child(rail)
	var fill_width = 0.880 if text.find("成功") >= 0 or text.find("完成") >= 0 or text.find("成就") >= 0 else 0.650
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.250, fill_width, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	fill.name = "ToastRewardBridgeFill"
	rail.add_child(fill)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.330, 0.075, 0.735), Color(accent.r, accent.g, accent.b, 0.16))
	source.name = "ToastRewardSourceNode"
	bridge.add_child(source)
	var gate = make_gpt_gate(rect_full(0.880, 0.280, 0.965, 0.780), Color(accent.r, accent.g, accent.b, 0.18))
	gate.name = "ToastRewardGate"
	bridge.add_child(gate)
	for i in range(3):
		var left = 0.220 + float(i) * 0.175
		var pip = make_gpt_gate(rect_full(left, 0.395, left + 0.035, 0.670), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.030))
		pip.name = "ToastRewardPip_%d" % i
		bridge.add_child(pip)
	var tick = add_gpt_tick_strip(bridge, rect_full(0.680, 0.260, (0.696) + float(1) * (0.060), 0.430), Color(accent.r, accent.g, accent.b, 0.22), "ToastRewardTick_0")
	fill.modulate = Color(1, 1, 1, 0.82)
	gate.modulate = Color(1, 1, 1, 0.82)
	return bridge


func draw_top_hud_hand_progress(parent: Control) -> Control:
	# r211: GPT chrome conversion
	var progress = Control.new()
	progress.name = "TopHudHandProgress"
	progress.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(progress, TOP_HUD_HAND_PROGRESS_RECT)
	parent.add_child(progress)
	var fill = Color(0.012, 0.024, 0.026, 0.72)
	var accent = SEAT_ACCENT_COLORS[dealer_seat] if dealer_seat >= 0 and dealer_seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var rail_panel = make_gpt_route_rail(rect_full(0.010, 0.160, 0.990, 0.840), fill)
	rail_panel.name = "HandProgressRail"
	progress.add_child(rail_panel)
	var hand_count = MATCH_MAX_HANDS if mode == "offline" else 4
	var current_hand = clamp(offline_hand_number if mode == "offline" else 1, 1, hand_count)
	var progress_ratio = clamp(float(current_hand) / float(max(1, hand_count)), 0.08, 1.0)
	var route_fill = make_gpt_meter_fill(rect_full(0.038, 0.675, 0.038 + 0.720 * progress_ratio, 0.760), Color(accent.r, accent.g, accent.b, 0.26))
	route_fill.name = "HandProgressRouteFill"
	progress.add_child(route_fill)
	var ink_rail = make_gpt_route_rail(rect_full(0.040, 0.735, 0.760, 0.795), Color(0.72, 0.54, 0.28, 0.12))
	ink_rail.name = "HandProgressInkRail"
	progress.add_child(ink_rail)
	var ink_fill = make_gpt_meter_fill(rect_full(0.020, 0.250, 0.020 + 0.940 * progress_ratio, 0.750), Color(0.88, 0.66, 0.32, 0.20))
	ink_fill.name = "HandProgressInkFill"
	ink_rail.add_child(ink_fill)
	for i in range(hand_count):
		var center = 0.070 + float(i) * (0.700 / float(max(1, hand_count - 1)))
		var reached = i < current_hand
		var active = i == current_hand - 1
		var pip_color = Color(accent.r, accent.g, accent.b, 0.74 if reached else 0.20)
		var pip_border = Color(0.98, 0.86, 0.46, 0.42 if active else 0.16)
		var pip = make_gpt_gate(rect_full(center - 0.015, 0.310, center + 0.015, 0.690), pip_color)
		pip.name = "HandProgressPip_%d" % (i + 1)
		progress.add_child(pip)
		if active:
			var glow = make_gpt_gate(rect_full(center - 0.029, 0.150, center + 0.029, 0.850), Color(accent.r, accent.g, accent.b, 0.14))
			glow.name = "HandProgressActiveGlow"
			progress.add_child(glow)
			progress.move_child(glow, max(0, pip.get_index()))
			var cursor = make_gpt_plate_rect(rect_full(center - 0.040, 0.070, center + 0.040, 0.930), Color(accent.r, accent.g, accent.b, 0.080), "ui_jade_reading_plate")
			cursor.name = "HandProgressCurrentCursor"
			progress.add_child(cursor)
			progress.move_child(cursor, max(0, glow.get_index()))
	for i in range(3):
		var tick_left = 0.650 + float(i) * 0.038
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.250, tick_left + 0.016, 0.410), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040))
		tick.name = "HandProgressRhythmTick_0"
		progress.add_child(tick)
	var label = make_label(progress, "%d/%d局" % [current_hand, hand_count], 10, Color(0.90, 0.88, 0.74), true)
	label.name = "HandProgressLabel"
	apply_rect(label, rect_full(0.785, 0.100, 0.920, 0.900))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	var dealer_route = make_gpt_route_rail(rect_full(0.735, 0.585, 0.930, 0.645), Color(0.006, 0.016, 0.018, 0.42))
	dealer_route.name = "HandProgressDealerRoute"
	progress.add_child(dealer_route)
	var dealer_route_fill = make_gpt_meter_fill(rect_full(0.735, 0.596, 0.735 + 0.195 * progress_ratio, 0.634), Color(accent.r, accent.g, accent.b, 0.26))
	dealer_route_fill.name = "HandProgressDealerRouteFill"
	progress.add_child(dealer_route_fill)
	var dealer_route_gate = make_gpt_route_rail(rect_full(0.905, 0.510, 0.935, 0.690), Color(0.96, 0.78, 0.38, 0.22))
	dealer_route_gate.name = "HandProgressDealerRouteGate"
	progress.add_child(dealer_route_gate)
	var dealer_tick = add_gpt_tick_strip(progress, rect_full(0.805, 0.520, (0.819) + float(1) * (0.040), 0.690), Color(accent.r, accent.g, accent.b, 0.23), "HandProgressDealerRouteTick_0")
	var dealer_badge = make_badge(progress, rect_full(0.925, 0.160, 0.995, 0.840), CENTER_WIND_LABELS[dealer_seat] if dealer_seat >= 0 and dealer_seat < CENTER_WIND_LABELS.size() else "庄", 9, Color(accent.r, accent.g, accent.b, 0.42), Color(0.96, 0.78, 0.38, 0.28), Color(0.98, 0.92, 0.72))
	dealer_badge.name = "HandProgressDealerBadge"
	dealer_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if mode == "offline" and offline_dealer_repeat:
		var repeat_ring = add_optional_gpt_illustration_texture(progress, "dealer_repeat_ring", rect_full(0.780, -0.240, 0.950, 0.360), 0.34, true)  # r221
		if repeat_ring != null:
			repeat_ring.name = "HandProgressDealerRepeatRing"
			if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
				var repeat_tw := create_screen_tween()
				repeat_tw.set_loops(48)
				repeat_tw.tween_property(repeat_ring, "rotation", TAU, 2.4).from(0.0)
				repeat_tw.parallel().tween_property(repeat_ring, "modulate:a", 0.42, 1.2).from(0.18)
				repeat_tw.parallel().tween_property(repeat_ring, "modulate:a", 0.18, 1.2).from(0.42).set_delay(1.2)
		var repeat_badge = make_badge(progress, rect_full(0.805, -0.160, 0.930, 0.300), "连庄", 8, Color(0.50, 0.12, 0.08, 0.94), Color(0.96, 0.62, 0.34, 0.32), Color(0.98, 0.90, 0.72))
		repeat_badge.name = "HandProgressRepeatBadge"
		repeat_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	draw_hand_progress_wall_sync(progress, accent)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(rail_panel, "modulate:a", 0.58, 0.72).from(0.94)
		tw.tween_property(rail_panel, "modulate:a", 0.94, 0.72).from(0.58)
		var route_tw := create_screen_tween()
		route_tw.set_loops(12)
		route_tw.tween_property(route_fill, "modulate:a", 0.38, 0.76).from(0.88)
		route_tw.tween_property(route_fill, "modulate:a", 0.88, 0.76).from(0.38)
	return progress


func draw_top_hud_status_art(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var hud_texture = add_illustration_texture(parent, "hud_status_banner", rect_full(0.090, 0.055, 0.445, 0.930), 0.025, false)
	if hud_texture != null:
		hud_texture.name = "TopHudBannerTexture"
		parent.move_child(hud_texture, 0)
		hud_texture.modulate = Color(1, 1, 1, 0.020)
	var halo_texture = add_illustration_texture(parent, "hud_phase_ring", rect_full(0.060, 0.045, 0.192, 0.955), 0.04, true)
	if halo_texture != null:
		halo_texture.name = "TopHudPhaseRingTexture"
		parent.move_child(halo_texture, 0)
	var art = Control.new()
	art.name = "TopHudStatusArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.104, 0.120, 0.132, 0.880))
	parent.add_child(art)
	var color = center_phase_color(center_phase_key())
	var icon_back = make_gpt_plate_rect(rect_full(0.08, 0.18, 0.92, 0.82), Color(color.r, color.g, color.b, 0.07), "ui_dark_scrim")
	icon_back.name = "TopHudStatusIconBack"
	art.add_child(icon_back)
	var icon_name = top_hud_status_icon_name()
	if icon_name != "":
		add_lucide_icon(art, icon_name, rect_full(0.24, 0.30, 0.76, 0.70), Color(0.96, 0.92, 0.76, 0.86))
	var pulse = make_gpt_tick_strip(rect_full(0.010, 0.080, 0.990, 0.920), Color(color.r, color.g, color.b, 0.025))
	pulse.name = "TopHudStatusPulse"
	art.add_child(pulse)
	art.move_child(pulse, 0)
	var rail = make_gpt_route_rail(rect_full(0.106, 0.820, 0.425, 0.870), Color(color.r, color.g, color.b, 0.05))
	rail.name = "TopHudStatusRail"
	parent.add_child(rail)
	var route = make_gpt_route_rail(rect_full(0.138, 0.690, 0.425, 0.735), Color(0.006, 0.016, 0.018, 0.15))
	route.name = "TopHudStatusRoute"
	parent.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.760, 0.740), Color(color.r, color.g, color.b, 0.08))
	route_fill.name = "TopHudStatusRouteFill"
	route.add_child(route_fill)
	var gate = make_gpt_gate(rect_full(0.404, 0.635, 0.428, 0.785), Color(0.96, 0.82, 0.42, 0.07))
	gate.name = "TopHudStatusRouteGate"
	parent.add_child(gate)
	for i in range(3):
		var left = 0.118 + float(i) * 0.018
		var pip = make_gpt_gate(rect_full(left, 0.180, left + 0.008, 0.300), Color(color.r, color.g, color.b, 0.14))
		pip.name = "TopHudStatusPip_%d" % i
		parent.add_child(pip)
	var tick = add_gpt_tick_strip(parent, rect_full(0.210, 0.625, (0.210) + float(2) * (0.052) + (0.010), 0.790), Color(color.r, color.g, color.b, 0.08), "TopHudStatusRouteTick_0")
	if halo_texture != null:
		halo_texture.modulate.a = 0.12
	pulse.modulate = Color(1, 1, 1, 0.38)
	route_fill.modulate = Color(1, 1, 1, 0.62)
	gate.modulate = Color(1, 1, 1, 0.65)
	return art


func draw_top_hud_wall_meter(parent: Control, meter_rect: Rect2 = TOP_HUD_WALL_RECT) -> Control:
	var simple_meter = Control.new()
	simple_meter.name = "TopHudWallMeter"
	simple_meter.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(simple_meter, meter_rect)
	parent.add_child(simple_meter)
	var wall_progress = clamp(float(get_wall_count()) / 144.0, 0.0, 1.0)
	var meter_color = wall_meter_color(wall_progress)
	# r199: wire densified GPT plate (was registry-only / WallBackStrip fallback)
	var top_wall_gpt = add_optional_gpt_illustration_texture(simple_meter, "top_hud_wall_gpt_warning", rect_full(-0.04, -0.06, 1.04, 1.06), 0.28, false)  # r220 denser visibility
	if top_wall_gpt != null:
		top_wall_gpt.name = "TopHudWallGPTWarningTexture"
		simple_meter.move_child(top_wall_gpt, 0)
	var seal = make_gpt_gate(rect_full(0.055, 0.180, 0.190, 0.460), Color(0.86, 0.68, 0.34, 0.48))
	seal.name = "TopHudWallSeal"
	simple_meter.add_child(seal)
	var seal_text = make_label(seal, "余", 8, Color(0.92, 0.84, 0.62), true)
	apply_rect(seal_text, rect_full(0.0, 0.0, 1.0, 1.0))
	configure_clipped_label(seal_text)
	var ink_bar = make_gpt_route_rail(rect_full(0.210, 0.710, 0.905, 0.835), Color(0.034, 0.030, 0.022, 0.40))
	ink_bar.name = "TopHudWallInkBar"
	simple_meter.add_child(ink_bar)
	var ink_fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.025 + 0.930 * wall_progress, 0.750), Color(meter_color.r, meter_color.g, meter_color.b, 0.36))
	ink_fill.name = "TopHudWallInkFill"
	ink_bar.add_child(ink_fill)
	if get_last_discard() != "":
		var last_seal = make_gpt_gate(rect_full(0.620, 0.155, 0.735, 0.455), Color(0.86, 0.52, 0.28, 0.34))
		last_seal.name = "TopHudWallLastSeal"
		simple_meter.add_child(last_seal)
		var last_label = make_label(last_seal, tile_face_main(get_last_discard()), 8, tile_accent(get_last_discard()), true)
		apply_rect(last_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var count_label = make_label(simple_meter, "%d" % get_wall_count(), 12, Color(0.94, 0.88, 0.68) if get_wall_count() > 24 else Color(1.0, 0.70, 0.48), true)
	count_label.name = "TopHudWallCount"
	apply_rect(count_label, rect_full(0.245, 0.115, 0.560, 0.520))
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	if get_wall_count() <= 24:
		var low_pulse_simple = make_gpt_gate(rect_full(0.755, 0.155, 0.935, 0.455), Color(0.96, 0.40, 0.22, 0.28))
		low_pulse_simple.name = "TopHudWallLowPulseSimple"
		simple_meter.add_child(low_pulse_simple)
	return simple_meter

func draw_turn_switch_action_ready_art(parent: Control, seat: int, target_center: Vector2, accent: Color) -> Control:
	# r212: GPT chrome conversion
	var art = Control.new()
	art.name = "TurnSwitchActionReadyArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var source = make_gpt_plate_rect(rect_full(target_center.x - 0.036, target_center.y - 0.045, target_center.x - 0.012, target_center.y - 0.010), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	source.name = "TurnSwitchActionSource_%d" % seat
	art.add_child(source)
	var route = make_gpt_route_rail(rect_full(target_center.x - 0.010, target_center.y - 0.036, target_center.x + 0.092, target_center.y - 0.026), Color(0.006, 0.016, 0.018, 0.46))
	route.name = "TurnSwitchActionRoute_%d" % seat
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.820, 0.750), Color(accent.r, accent.g, accent.b, 0.28))
	fill.name = "TurnSwitchActionFill_%d" % seat
	route.add_child(fill)
	var decision_gate = make_gpt_gate(rect_full(target_center.x + 0.076, target_center.y - 0.052, target_center.x + 0.108, target_center.y + 0.002), Color(accent.r, accent.g, accent.b, 0.18))
	decision_gate.name = "TurnSwitchActionGate_%d" % seat
	art.add_child(decision_gate)
	var seal = make_gpt_gate(rect_full(target_center.x + 0.038, target_center.y + 0.006, target_center.x + 0.090, target_center.y + 0.060), Color(0.92, 0.72, 0.34, 0.16))
	seal.name = "TurnSwitchActionSeal_%d" % seat
	art.add_child(seal)
	var glyph = make_label(seal, "行", 8, Color(0.98, 0.92, 0.66, 0.86), true)
	glyph.name = "TurnSwitchActionGlyph_%d" % seat
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_gpt_route_rail(rect_full(target_center.x - 0.034, target_center.y + 0.052, target_center.x + 0.072, target_center.y + 0.063), Color(0.006, 0.016, 0.018, 0.38))
	archive_route.name = "TurnSwitchActionArchiveRoute_%d" % seat
	art.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.760, 0.750), Color(0.92, 0.72, 0.34, 0.22))
	archive_fill.name = "TurnSwitchActionArchiveFill_%d" % seat
	archive_route.add_child(archive_fill)
	var tick = add_gpt_tick_strip(art, rect_full(target_center.x + 0.014, target_center.y - 0.058, (target_center.x + 0.014) + float(2) * (0.020) + (0.006), target_center.y - 0.006), Color(accent.r, accent.g, accent.b, 0.22), "TurnSwitchActionTick_%d_0" % [seat])
	# 入场过渡：整组「行牌」标记由透明弹入并轻微放大，避免出牌后即时被销毁的静态突现。
	# 与 play_fx_turn_switch_slide 的 halo 呼吸同节奏（~dur），整体淡入 + 印章盖章感缩放。
	if fx_enabled_effective():
		art.modulate = Color(1, 1, 1, 0)
		seal.pivot_offset = seal.size * 0.5
		seal.scale = Vector2(0.70, 0.70)
		var enter := create_screen_tween()
		enter.set_parallel(true)
		enter.tween_property(art, "modulate:a", 1.0, 0.20).from(0.0).set_ease(Tween.EASE_OUT)
		enter.tween_property(seal, "scale", Vector2(1.0, 1.0), 0.26).from(Vector2(0.70, 0.70)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	return art


func draw_update_dialog_art(parent: Control) -> Control:
	# r205: GPT-only update progress chrome
	var art = Control.new()
	art.name = "UpdateDialogArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.070, 0.420, 0.930, 0.585))
	parent.add_child(art)
	var rail = make_gpt_route_rail(rect_full(0.045, 0.380, 0.955, 0.620), Color(0.014, 0.034, 0.038, 0.90))
	rail.name = "UpdateDialogArtRail"
	art.add_child(rail)
	update_art_fill = make_gpt_meter_fill(rect_full(0.018, 0.260, 0.018, 0.740), Color(0.28, 0.68, 0.50, 0.58))
	update_art_fill.name = "UpdateDialogArtFill"
	rail.add_child(update_art_fill)
	var channel = make_gpt_ribbon(rect_full(0.145, 0.690, 0.855, 0.800), Color(0.18, 0.40, 0.36, 0.12))
	channel.name = "UpdateDialogDownloadChannel"
	art.add_child(channel)
	var pack = make_gpt_plate_rect(rect_full(0.012, 0.170, 0.120, 0.830), Color(0.050, 0.040, 0.026, 0.72), "ui_button_face_plate")
	pack.name = "UpdateDialogPackageIcon"
	art.add_child(pack)
	add_lucide_icon(pack, "download", rect_full(0.24, 0.22, 0.76, 0.78), GOLD_BRIGHT)
	var verify = make_gpt_gate(rect_full(0.785, 0.155, 0.870, 0.845), Color(0.28, 0.48, 0.42, 0.22))
	verify.name = "UpdateDialogVerifyNode"
	art.add_child(verify)
	add_lucide_icon(verify, "shield-check", rect_full(0.250, 0.250, 0.750, 0.750), Color(0.82, 0.96, 0.74, 0.78))
	var verify_stamp = add_optional_gpt_illustration_texture(art, "update_verify_stamp", rect_full(0.752, 0.020, 0.900, 0.980), 0.24, true)
	if verify_stamp != null:
		verify_stamp.name = "UpdateVerifyStampTexture"
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var verify_tw := create_screen_tween()
			verify_tw.set_loops(48)
			verify_tw.tween_property(verify_stamp, "scale", Vector2(1.06, 1.06), 0.80).from(Vector2(0.96, 0.96))
			verify_tw.parallel().tween_property(verify_stamp, "modulate:a", 0.34, 0.80).from(0.16)
			verify_tw.tween_property(verify_stamp, "scale", Vector2(0.96, 0.96), 0.80).from(Vector2(1.06, 1.06))
			verify_tw.parallel().tween_property(verify_stamp, "modulate:a", 0.16, 0.80).from(0.34)
	var verify_rail = make_gpt_route_rail(rect_full(0.610, 0.220, 0.770, 0.315), Color(0.006, 0.018, 0.020, 0.44))
	verify_rail.name = "UpdateDialogVerifyRail"
	art.add_child(verify_rail)
	var verify_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.780, 0.740), Color(0.54, 0.82, 0.62, 0.28))
	verify_fill.name = "UpdateDialogVerifyFill"
	verify_rail.add_child(verify_fill)
	for i in range(2):
		var verify_step = make_gpt_tick_strip(rect_full(0.640 + float(i) * 0.065, 0.125, 0.680 + float(i) * 0.065, 0.405), Color(0.54, 0.82, 0.62, 0.22))
		verify_step.name = "UpdateDialogVerifyStep_%d" % i
		art.add_child(verify_step)
	update_art_status_light = make_gpt_gate(rect_full(0.890, 0.240, 0.956, 0.760), Color(0.42, 0.58, 0.52, 0.36))
	update_art_status_light.name = "UpdateDialogStatusLight"
	art.add_child(update_art_status_light)
	for i in range(3):
		var left = 0.230 + float(i) * 0.190
		var packet = make_gpt_tick_strip(rect_full(left, 0.650, left + 0.030, 0.840), Color(0.54, 0.82, 0.62, 0.24))
		packet.name = "UpdateDialogMovingPacket_%d" % i
		art.add_child(packet)
	for i in range(4):
		var left = 0.170 + float(i) * 0.160
		var pip = make_gpt_gate(rect_full(left, 0.240, left + 0.050, 0.760), Color(0.70, 0.60, 0.34, 0.20))
		pip.name = "UpdateDialogPacketPip_%d" % i
		art.add_child(pip)
	var tick = add_gpt_tick_strip(art, rect_full(0.685, 0.520, (0.707) + float(2) * (0.042), 0.650), Color(0.54, 0.82, 0.62, 0.24), "UpdateDialogVerifyTick_0")
	var install_route = make_gpt_route_rail(rect_full(0.870, 0.380, 0.982, 0.620), Color(0.006, 0.018, 0.020, 0.44))
	install_route.name = "UpdateDialogInstallRoute"
	art.add_child(install_route)
	var install_fill = make_gpt_meter_fill(rect_full(0.080, 0.260, 0.080, 0.740), Color(0.82, 0.70, 0.36, 0.28))
	install_fill.name = "UpdateDialogInstallFill"
	install_route.add_child(install_fill)
	var install_gate = make_gpt_gate(rect_full(0.952, 0.300, 0.988, 0.700), Color(0.82, 0.70, 0.36, 0.16))
	install_gate.name = "UpdateDialogInstallGate"
	art.add_child(install_gate)
	var install_glyph = make_label(install_gate, "装", 7, Color(0.98, 0.92, 0.68, 0.82), true)
	install_glyph.name = "UpdateDialogInstallGlyph"
	apply_rect(install_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var install_source = make_gpt_gate(rect_full(0.842, 0.428, 0.882, 0.572), Color(0.54, 0.82, 0.62, 0.18))
	install_source.name = "UpdateDialogInstallSource"
	art.add_child(install_source)
	var install_tick = add_gpt_tick_strip(art, rect_full(0.900, 0.205, (0.916) + float(1) * (0.028), 0.345), Color(0.82, 0.70, 0.36, 0.20), "UpdateDialogInstallTick_0")
	draw_update_dialog_stage_map(parent)
	return art


func draw_update_dialog_button_art(button: Control, role: String, color: Color) -> Control:
	var art = Control.new()
	art.name = "UpdateDialogButtonArt_%s" % role
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(art)
	var button_texture = add_illustration_texture(art, "update_notes_strip", rect_full(-0.060, -0.160, 1.060, 1.160), 0.13, false)
	if button_texture != null:
		button_texture.name = "UpdateDialogButtonTexture_%s" % role
		art.move_child(button_texture, 0)
	var rail = make_gpt_route_rail(rect_full(0.115, 0.735, 0.885, 0.830), Color(0.006, 0.016, 0.018, 0.50))
	rail.name = "UpdateDialogButtonRail_%s" % role
	art.add_child(rail)
	var fill_right = 0.860 if role == "primary" else 0.560
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.260, fill_right, 0.740), Color(color.r, color.g, color.b, 0.34))
	fill.name = "UpdateDialogButtonFill_%s" % role
	rail.add_child(fill)
	var gate_left = 0.790 if role == "primary" else 0.115
	var gate = make_gpt_gate(rect_full(gate_left, 0.230, gate_left + 0.050, 0.590), Color(color.r, color.g, color.b, 0.28))
	gate.name = "UpdateDialogButtonGate_%s" % role
	art.add_child(gate)
	for i in range(2):
		var left = 0.645 + float(i) * 0.060 if role == "primary" else 0.235 + float(i) * 0.060
		var tick = make_gpt_tick_strip(rect_full(left, 0.205, left + 0.020, 0.345), Color(color.r, color.g, color.b, 0.26 - float(i) * 0.050))
		tick.name = "UpdateDialogButtonTick_%s_%d" % [role, i]
		art.add_child(tick)
	if button is Button:
		var update_button := button as Button
		update_button.button_down.connect(func() -> void:
			play_update_dialog_button_feedback(update_button, role, color)
		)
	return art

func draw_update_dialog_stage_map(parent: Control) -> Control:
	var map = Control.new()
	map.name = "UpdateDialogStageMap"
	map.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(map, rect_full(0.120, 0.720, 0.880, 0.815))
	parent.add_child(map)
	var canopy_texture = add_illustration_texture(map, "update_stage_canopy", rect_full(-0.020, -0.620, 1.020, 1.360), 0.13, false)
	if canopy_texture != null:
		canopy_texture.name = "UpdateStageCanopyTexture"
	var rail = make_gpt_route_rail(rect_full(0.040, 0.480, 0.960, 0.540), Color(0.82, 0.72, 0.42, 0.16))
	rail.name = "UpdateDialogStageRail"
	map.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.000, 0.000, 0.020, 1.000), Color(0.72, 0.88, 0.62, 0.26))
	fill.name = "UpdateDialogStageFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.057, 0.105, 0.103, 0.895), Color(0.72, 0.88, 0.62, 0.18))
	gate.name = "UpdateDialogStageGate"
	map.add_child(gate)
	var stages := [
		["checking", "查"],
		["downloading", "下"],
		["ready", "验"],
		["install", "装"],
	]
	for i in range(stages.size()):
		var stage_id = str(stages[i][0])
		var label_text = str(stages[i][1])
		var center = 0.080 + float(i) * 0.280
		var node = make_gpt_gate(rect_full(center - 0.035, 0.180, center + 0.035, 0.820), Color(0.26, 0.36, 0.36, 0.42))
		node.name = "UpdateDialogStageNode_%s" % stage_id
		map.add_child(node)
		var label = make_label(node, label_text, 9, Color(0.92, 0.88, 0.70, 0.82), true)
		label.name = "UpdateDialogStageGlyph_%s" % stage_id
		apply_rect(label, rect_full(0.0, 0.0, 1.0, 1.0))
	var tick = add_gpt_tick_strip(map, rect_full(0.190, 0.275, (0.190) + float(2) * (0.280) + (0.022), 0.405), Color(0.82, 0.72, 0.42, 0.18), "UpdateDialogStageTick_0")
	return map


