	var target = make_gpt_plate_rect(rect_full(0.455, 0.590, 0.545, 0.815), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	target.name = "CenterLastTileTargetNode"
	trace.add_child(target)
	var claim_route = make_gpt_route_rail(rect_full(0.315, 0.675, 0.815, 0.755), Color(0.006, 0.014, 0.016, 0.42))
	claim_route.name = "CenterLastTileClaimRoute"
	trace.add_child(claim_route)
	var claim_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.720, 0.740), Color(accent.r, accent.g, accent.b, 0.26))
	claim_fill.name = "CenterLastTileClaimFill"
	claim_route.add_child(claim_fill)
	var claim_gate = make_gpt_gate(rect_full(0.775, 0.602, 0.855, 0.840), Color(accent.r, accent.g, accent.b, 0.20))
	claim_gate.name = "CenterLastTileClaimGate"
	trace.add_child(claim_gate)
	var tick = add_gpt_tick_strip(trace, rect_full(0.365, 0.180, (0.388) + float(2) * (0.095), 0.500), Color(accent.r, accent.g, accent.b, 0.24), "CenterLastTileTick_0")
	var claim_tick = add_gpt_tick_strip(trace, rect_full(0.545, 0.615, (0.568) + float(1) * (0.085), 0.855), Color(accent.r, accent.g, accent.b, 0.22), "CenterLastTileClaimTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.40, 0.72).from(0.88)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.38, 0.72).from(0.84)
		tw.tween_property(fill, "modulate:a", 0.88, 0.72).from(0.40)
		tw.parallel().tween_property(claim_fill, "modulate:a", 0.84, 0.72).from(0.38)
	return trace


func draw_center_low_wall_warning(parent: Control, wall_count: int, meter_color: Color) -> Control:
	# r214: bulk GPT chrome sweep
	var warning = make_gpt_plate_rect(rect_full(0.28, 0.34, 0.72, 0.66), Color(0.16, 0.040, 0.026, 0.30), "ui_button_face_plate")
	warning.name = "CenterWallLowWarning"
	parent.add_child(warning)
	var low_pulse = make_gpt_tick_strip(rect_full(-0.045, -0.100, 1.045, 1.100), Color(0.96, 0.28, 0.12, 0.08))
	low_pulse.name = "CenterWallLowPulse"
	warning.add_child(low_pulse)
	var badge_text = "荒庄临近" if wall_count <= 18 else "余牌偏低"
	var badge = make_badge(warning, rect_full(0.10, 0.26, 0.90, 0.74), badge_text, 9, Color(0.20, 0.058, 0.038, 0.94), Color(0.96, 0.54, 0.32, 0.42), Color(0.98, 0.84, 0.64))
	badge.name = "CenterWallLowWarningBadge"
	badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# r180: GPT danger meter strip instead of route/fill/gate/tick chrome.
	var fill_ratio = clamp(float(wall_count) / 26.0, 0.10, 0.86)
	var danger = Control.new()
	danger.name = "CenterWallLowDangerChrome"
	danger.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(danger, rect_full(0.120, 0.100, 0.880, 0.900))
	warning.add_child(danger)
	var strip = add_optional_gpt_illustration_texture(danger, "ui_progress_signal_strip", rect_full(0.0, 0.62, 1.0, 0.92), 0.48, false)
	if strip != null:
		strip.name = "CenterWallLowDangerStrip"
		strip.modulate = Color(0.96, 0.56, 0.30, 0.72)
	var fill = add_optional_gpt_illustration_texture(danger, "ui_meter_rail_plate", rect_full(0.04, 0.68, 0.04 + 0.88 * fill_ratio, 0.88), 0.70, false)
	if fill != null:
		fill.name = "CenterWallLowDangerFill"
	var gate = add_optional_gpt_illustration_texture(danger, "ui_hand_tray_state_chip", rect_full(0.78, 0.08, 0.96, 0.34), 0.55, false)
	if gate != null:
		gate.name = "CenterWallLowDangerGate"
	for i in range(5):
		var left = 0.12 + float(i) * 0.19
		var spark = make_gpt_gate(rect_full(left, 0.08, left + 0.038, 0.15), Color(0.96, 0.62, 0.28, 0.56))
		spark.name = "CenterWallLowSpark"
		parent.add_child(spark)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(warning, "modulate:a", 0.35, 0.45).from(0.85)
		tw.tween_property(warning, "modulate:a", 0.85, 0.45).from(0.35)
	return warning


func draw_center_phase_flow_art(parent: Control, phase_key: String, accent: Color) -> Control:
	# r209: GPT chrome conversion
	var art = Control.new()
	art.name = "CenterPhaseFlowArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var index = center_phase_flow_index(phase_key)
	var rail = make_gpt_route_rail(rect_full(0.150, 0.705, 0.845, 0.800), Color(0.006, 0.016, 0.018, 0.48))
	rail.name = "CenterPhaseFlowRail"
	art.add_child(rail)
	var fill_ratio = clamp(float(index + 1) / 4.0, 0.16, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.940 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "CenterPhaseFlowFill"
	rail.add_child(fill)
	var confirm_left = 0.198 + float(index) * 0.190
	var confirm_route = make_gpt_route_rail(rect_full(0.190, 0.360, clamp(confirm_left + 0.072, 0.262, 0.835), 0.440), Color(accent.r, accent.g, accent.b, 0.10))
	confirm_route.name = "CenterPhaseConfirmRoute"
	art.add_child(confirm_route)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.035, 0.260, 0.965, 0.740), Color(accent.r, accent.g, accent.b, 0.30))
	confirm_fill.name = "CenterPhaseConfirmFill"
	confirm_route.add_child(confirm_fill)
	var source_node = make_gpt_gate(rect_full(0.160, 0.305, 0.205, 0.495), Color(accent.r, accent.g, accent.b, 0.26))
	source_node.name = "CenterPhaseSourceNode"
	art.add_child(source_node)
	var gate = make_gpt_gate(rect_full(confirm_left + 0.046, 0.300, confirm_left + 0.104, 0.505), Color(accent.r, accent.g, accent.b, 0.30))
	gate.name = "CenterPhaseConfirmGate"
	art.add_child(gate)
	for i in range(2):
		var tick_left = 0.270 + float(i) * 0.075 + float(index) * 0.018
		var tick = make_gpt_tick_strip(rect_full(tick_left, 0.332, tick_left + 0.018, 0.468), Color(1.0, 0.86, 0.46, 0.22))
		tick.name = "CenterPhaseConfirmTick_0"
		art.add_child(tick)
	for i in range(4):
		var left = 0.180 + float(i) * 0.190
		var active = i == index
		var node = make_gpt_gate(rect_full(left, 0.620, left + 0.040, 0.880), Color(accent.r, accent.g, accent.b, 0.40 if active else 0.16))
		node.name = "CenterPhaseFlowNode_%d" % i
		art.add_child(node)
	var cursor_left = 0.166 + float(index) * 0.190
	var cursor = make_gpt_plate_rect(rect_full(cursor_left, 0.570, cursor_left + 0.068, 0.930), Color(accent.r, accent.g, accent.b, 0.14), "ui_jade_reading_plate")
	cursor.name = "CenterPhaseFlowCursor"
	art.add_child(cursor)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.40, 0.74).from(0.88)
		tw.tween_property(fill, "modulate:a", 0.88, 0.74).from(0.40)
		tw.parallel().tween_property(confirm_fill, "modulate:a", 0.42, 0.68).from(0.86)
		tw.tween_property(confirm_fill, "modulate:a", 0.86, 0.68).from(0.42)
	return art


func draw_center_phase_ribbon(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var phase_key = center_phase_key()
	var accent = center_phase_color(phase_key)
	var ribbon = make_gpt_ribbon(CENTER_PHASE_RIBBON_RECT, Color(accent.r * 0.18, accent.g * 0.18, accent.b * 0.18, 0.88))
	ribbon.name = "CenterPhaseRibbon"
	parent.add_child(ribbon)
	var halo = add_illustration_texture(ribbon, "center_focus_mandala", rect_full(0.660, -0.900, 1.240, 1.520), 0.07, true)
	if halo != null:
		halo.name = "CenterPhaseRibbonHalo"
		ribbon.move_child(halo, 0)
	draw_center_phase_flow_art(ribbon, phase_key, accent)
	var left_seal = make_gpt_gate(rect_full(0.035, 0.18, 0.125, 0.82), Color(accent.r, accent.g, accent.b, 0.28))
	left_seal.name = "CenterPhaseSeal"
	ribbon.add_child(left_seal)
	var pulse = make_gpt_tick_strip(rect_full(0.865, 0.28, 0.935, 0.72), Color(accent.r, accent.g, accent.b, 0.32))
	pulse.name = "CenterPhasePulse"
	ribbon.add_child(pulse)
	var label = make_label(ribbon, center_phase_label(phase_key), 11, Color(0.96, 0.94, 0.82), true)
	label.name = "CenterPhaseLabel"
	apply_rect(label, rect_full(0.14, 0.05, 0.85, 0.95))
	configure_clipped_label(label)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if halo != null:
			var halo_tw := create_screen_tween()
			halo_tw.set_loops(48)
			halo_tw.tween_property(halo, "rotation", -TAU, 10.0).from(0.0)
			halo_tw.parallel().tween_property(halo, "modulate:a", 0.03, 5.0).from(0.07)
			halo_tw.tween_property(halo, "modulate:a", 0.07, 5.0).from(0.03)
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(pulse, "modulate:a", 0.30, 0.58).from(0.95)
		tw.tween_property(pulse, "modulate:a", 0.95, 0.58).from(0.30)
	return ribbon


func draw_center_pulse_network(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	return null
	var art = Control.new()
	art.name = "CenterPulseNetwork"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var phase_key = center_phase_key()
	var accent = center_phase_color(phase_key)
	var wall_progress = clamp(float(get_wall_count()) / 144.0, 0.0, 1.0)
	var route = make_gpt_route_rail(rect_full(0.180, 0.500, 0.820, 0.528), Color(0.006, 0.016, 0.018, 0.36))
	route.name = "CenterPulseNetworkRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.240, 0.030 + 0.900 * max(0.10, wall_progress), 0.760), Color(accent.r, accent.g, accent.b, 0.22))
	fill.name = "CenterPulseNetworkFill"
	route.add_child(fill)
	var vertical = make_gpt_route_rail(rect_full(0.486, 0.220, 0.514, 0.795), Color(0.006, 0.016, 0.018, 0.30))
	vertical.name = "CenterPulseNetworkVerticalRoute"
	art.add_child(vertical)
	var vertical_fill = make_gpt_meter_fill(rect_full(0.240, 0.060, 0.760, 0.740), Color(accent.r, accent.g, accent.b, 0.16))
	vertical_fill.name = "CenterPulseNetworkVerticalFill"
	vertical.add_child(vertical_fill)
	var nodes := [
		["phase", Vector2(0.500, 0.205), 0.90],
		["wind", Vector2(0.500, 0.500), 0.72],
		["wall", Vector2(0.805, 0.515), wall_progress],
		["last", Vector2(0.500, 0.800), 0.70 if get_last_discard() != "" else 0.22],
	]
	for entry in nodes:
		var id = str(entry[0])
		var pos: Vector2 = entry[1]
		var strength = clamp(float(entry[2]), 0.12, 1.0)
		var node = make_gpt_gate(rect_full(pos.x - 0.026, pos.y - 0.040, pos.x + 0.026, pos.y + 0.040), Color(accent.r, accent.g, accent.b, 0.10 + 0.18 * strength))
		node.name = "CenterPulseNetworkNode_%s" % id
		art.add_child(node)
	var gate = make_gpt_gate(rect_full(0.790, 0.455, 0.850, 0.575), Color(accent.r, accent.g, accent.b, 0.15))
	gate.name = "CenterPulseNetworkGate"
	art.add_child(gate)
	var tick = add_gpt_tick_strip(art, rect_full(0.310, 0.465, (0.326) + float(3) * (0.105), 0.570), Color(accent.r, accent.g, accent.b, 0.20), "CenterPulseNetworkTick_0")
	for i in range(3):
		var y = 0.315 + float(i) * 0.155
		var pulse = make_gpt_tick_strip(rect_full(0.462, y, 0.538, y + 0.040), Color(accent.r, accent.g, accent.b, 0.08 + float(i) * 0.018))
		pulse.name = "CenterPulseNetworkPulse_%d" % i
		art.add_child(pulse)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.38, 0.86).from(0.92)
		tw.parallel().tween_property(gate, "modulate:a", 0.48, 0.86).from(0.96)
		tw.tween_property(fill, "modulate:a", 0.92, 0.86).from(0.38)
		tw.parallel().tween_property(gate, "modulate:a", 0.96, 0.86).from(0.48)
	return art


func draw_center_wall_flow_art(parent: Control, progress: float, meter_color: Color) -> Control:
	# r208: GPT chrome conversion
	var art = Control.new()
	art.name = "CenterWallFlowArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var mandala = add_illustration_texture(art, "center_focus_mandala", rect_full(0.210, 0.210, 0.790, 0.790), 0.08, true)
	if mandala != null:
		mandala.name = "CenterWallFlowMandalaTexture"
		art.move_child(mandala, 0)
	var core = make_gpt_gate(rect_full(0.360, 0.360, 0.640, 0.640), Color(0.006, 0.016, 0.018, 0.44))
	core.name = "CenterWallFlowCore"
	art.add_child(core)
	var fill = make_gpt_meter_fill(rect_full(0.120, 0.420, 0.120 + 0.760 * max(0.08, progress), 0.580), Color(meter_color.r, meter_color.g, meter_color.b, 0.34))
	fill.name = "CenterWallFlowFill"
	core.add_child(fill)
	var pressure = clamp(1.0 - progress, 0.0, 1.0)
	var pulse = make_gpt_tick_strip(rect_full(0.305, 0.305, 0.695, 0.695), Color(0.0, 0.0, 0.0, 0.0))
	pulse.name = "CenterWallPressurePulse"
	art.add_child(pulse)
	var pulse_fill = make_gpt_meter_fill(rect_full(0.120, 0.455, 0.120 + 0.760 * max(0.10, pressure), 0.545), Color(meter_color.r, meter_color.g, meter_color.b, 0.16 + pressure * 0.22))
	pulse_fill.name = "CenterWallPressureFill"
	pulse.add_child(pulse_fill)
	var draw_route = make_gpt_route_rail(rect_full(0.565, 0.615, 0.870, 0.705), Color(0.006, 0.016, 0.018, 0.42))
	draw_route.name = "CenterWallDrawRoute"
	art.add_child(draw_route)
	var draw_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.860 if progress > 0.0 else 0.120, 0.740), Color(meter_color.r, meter_color.g, meter_color.b, 0.28 if progress > 0.0 else 0.10))
	draw_fill.name = "CenterWallDrawFill"
	draw_route.add_child(draw_fill)
	var draw_source = make_gpt_edge_rail(rect_full(0.520, 0.555, 0.580, 0.760), Color(meter_color.r, meter_color.g, meter_color.b, 0.18 + pressure * 0.12))
	draw_source.name = "CenterWallDrawSource"
	art.add_child(draw_source)
	var draw_gate = make_gpt_gate(rect_full(0.845, 0.540, 0.905, 0.780), Color(meter_color.r, meter_color.g, meter_color.b, 0.20 if progress > 0.0 else 0.08))
	draw_gate.name = "CenterWallDrawGate"
	art.add_child(draw_gate)
	var draw_tick = add_gpt_tick_strip(art, rect_full(0.650, 0.545, (0.672) + float(1) * (0.070), 0.750), Color(meter_color.r, meter_color.g, meter_color.b, 0.22), "CenterWallDrawTick_0")
	for i in range(4):
		var angle = -PI * 0.5 + float(i) * TAU / 4.0
		var p = Vector2(0.5 + cos(angle) * 0.245, 0.5 + sin(angle) * 0.245)
		var tick = make_gpt_tick_strip(rect_full(p.x - 0.015, p.y - 0.042, p.x + 0.015, p.y + 0.042), Color(meter_color.r, meter_color.g, meter_color.b, 0.18 + pressure * 0.18))
		tick.name = "CenterWallPressureTick_0"
		art.add_child(tick)
		tick.rotation = angle + PI * 0.5
	if progress <= 0.18:
		var danger_core = make_gpt_gate(rect_full(0.425, 0.425, 0.575, 0.575), Color(0.62, 0.12, 0.06, 0.18))
		danger_core.name = "CenterWallPressureDangerCore"
		art.add_child(danger_core)
	var anchors := [
		Vector2(0.500, 0.085),
		Vector2(0.915, 0.500),
		Vector2(0.500, 0.915),
		Vector2(0.085, 0.500),
	]
	for i in range(anchors.size()):
		var center: Vector2 = anchors[i]
		var active = progress >= float(i) * 0.25
		var node = make_gpt_gate(rect_full(center.x - 0.026, center.y - 0.046, center.x + 0.026, center.y + 0.046), Color(meter_color.r, meter_color.g, meter_color.b, 0.34 if active else 0.12))
		node.name = "CenterWallFlowNode_%d" % i
		art.add_child(node)
	var tick_2 = add_gpt_tick_strip(art, rect_full(0.680, 0.450, (0.680) + float(2) * (0.055) + (0.024), 0.550), Color(meter_color.r, meter_color.g, meter_color.b, 0.24), "CenterWallFlowTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if mandala != null:
			var mandala_tw := create_screen_tween()
			mandala_tw.set_loops(48)
			mandala_tw.tween_property(mandala, "rotation", TAU, 12.0).from(0.0)
			mandala_tw.parallel().tween_property(mandala, "modulate:a", 0.04, 4.8).from(0.08)
			mandala_tw.tween_property(mandala, "modulate:a", 0.08, 4.8).from(0.04)
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.38, 0.74).from(0.88)
		tw.parallel().tween_property(draw_fill, "modulate:a", 0.40, 0.74).from(0.88)
		tw.tween_property(fill, "modulate:a", 0.88, 0.74).from(0.38)
		tw.parallel().tween_property(draw_fill, "modulate:a", 0.88, 0.74).from(0.40)
		var pulse_tw := create_screen_tween()
		pulse_tw.set_loops(48)
		pulse_tw.tween_property(pulse, "scale", Vector2(1.08, 1.08), 0.72).from(Vector2(0.98, 0.98)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		pulse_tw.parallel().tween_property(pulse, "modulate:a", 0.48 + pressure * 0.26, 0.72).from(0.86)
		pulse_tw.tween_property(pulse, "scale", Vector2(0.98, 0.98), 0.72).from(Vector2(1.08, 1.08)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		pulse_tw.parallel().tween_property(pulse, "modulate:a", 0.86, 0.72).from(0.48 + pressure * 0.26)
	return art


func draw_center_wall_meter(parent: Control, wall_count: int) -> void:
	var progress = clamp(float(wall_count) / 144.0, 0.0, 1.0)
	var meter_color = wall_meter_color(progress)
	var meter = Control.new()
	meter.name = "CenterWallMeter"
	meter.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(meter, rect_full(0.23, 0.30, 0.77, 0.74))
	parent.add_child(meter)
	var center_wall_gpt_key := "center_wall_gpt_warning"
	var center_wall_gpt_texture = add_optional_gpt_illustration_texture(meter, center_wall_gpt_key, rect_full(-0.030, -0.030, 1.030, 1.030), 0.26, true)  # r221 denser after API mega
	if center_wall_gpt_texture != null:
		center_wall_gpt_texture.name = "CenterWallGPTWarningTexture"
	var segments := [
		[rect_full(0.18, 0.00, 0.82, 0.035), 0.00],
		[rect_full(0.965, 0.17, 1.00, 0.83), 0.25],
		[rect_full(0.18, 0.965, 0.82, 1.00), 0.50],
		[rect_full(0.00, 0.17, 0.035, 0.83), 0.75],
	]
	for segment in segments:
		var lit = progress >= float(segment[1])
		var fill = Color(meter_color.r, meter_color.g, meter_color.b, 0.50 if lit else 0.10)
		# r203: GPT meter/rail plates for center wall segments
		var bar = make_gpt_route_rail(segment[0], Color(fill.r * 0.2, fill.g * 0.2, fill.b * 0.2, 0.28 if lit else 0.12))
		if lit:
			var lit_fill = make_gpt_meter_fill(rect_full(0.05, 0.15, 0.95, 0.85), fill)
			lit_fill.name = "CenterWallMeterSegmentFill"
			bar.add_child(lit_fill)
		bar.name = "CenterWallMeterSegment"
		meter.add_child(bar)
	draw_center_wall_flow_art(meter, progress, meter_color)
	if progress <= 0.18:
		draw_center_low_wall_warning(meter, wall_count, meter_color)

func draw_center_wind_compass(parent: Control) -> Control:
	# r213: GPT chrome conversion
	var compass = Control.new()
	compass.name = "CenterWindCompass"
	compass.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(compass, rect_full(0.08, 0.08, 0.92, 0.92))
	parent.add_child(compass)
	var simple_current = get_current_seat()
	var simple_seal_texture = add_illustration_texture(compass, "center_wind_seal", rect_full(0.15, 0.15, 0.85, 0.85), 0.055, true)
	if simple_seal_texture != null:
		simple_seal_texture.name = "CenterWindSimpleSealTexture"
	var simple_marks := [
		[rect_full(0.455, 0.040, 0.545, 0.155), "东", 0],
		[rect_full(0.845, 0.455, 0.960, 0.545), "南", 1],
		[rect_full(0.455, 0.845, 0.545, 0.960), "西", 2],
		[rect_full(0.040, 0.455, 0.155, 0.545), "北", 3],
	]
	for mark in simple_marks:
		var simple_seat = int(mark[2])
		var simple_active = simple_seat == simple_current
		var simple_badge = make_gpt_gate(mark[0], Color(0.88, 0.70, 0.34, 0.40 if simple_active else 0.16))
		simple_badge.name = "CenterWindSimpleMark_%s" % str(mark[1])
		compass.add_child(simple_badge)
		var simple_label = make_label(simple_badge, str(mark[1]), 12, Color(0.94, 0.82, 0.54, 0.88 if simple_active else 0.46), true)
		apply_rect(simple_label, rect_full(0.0, 0.0, 1.0, 1.0))
	var seal_texture = add_illustration_texture(compass, "center_wind_seal", rect_full(0.02, 0.02, 0.98, 0.98), 0.16, true)
	if seal_texture != null:
		seal_texture.name = "CenterWindSealTexture"
	var center_wind_gpt_key := "center_wind_gpt_compass"
	var center_wind_gpt_texture = add_optional_gpt_illustration_texture(compass, center_wind_gpt_key, rect_full(-0.020, -0.020, 1.020, 1.020), 0.14, true)
	if center_wind_gpt_texture != null:
		center_wind_gpt_texture.name = "CenterWindGPTCompassTexture"
		compass.move_child(center_wind_gpt_texture, min(1, compass.get_child_count() - 1))
	var current = get_current_seat()
	var pointer_texture = add_optional_gpt_illustration_texture(compass, "center_wind_pointer", rect_full(0.360, 0.050, 0.640, 0.950), 0.38, true)  # r221
	if pointer_texture != null:
		pointer_texture.name = "CenterWindPointerTexture"
		pointer_texture.pivot_offset = pointer_texture.size * 0.5
		pointer_texture.rotation = float(current) * TAU / 4.0
		if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
			var pointer_tw := create_screen_tween()
			pointer_tw.set_loops(48)
			pointer_tw.tween_property(pointer_texture, "modulate:a", 0.50, 0.85).from(0.24)
			pointer_tw.tween_property(pointer_texture, "modulate:a", 0.24, 0.85).from(0.50)
	# r203: concentric GPT rings (no program panel lacquer)
	var ring_a = make_gpt_plate_rect(rect_full(0.22, 0.22, 0.78, 0.78), Color(0.88, 0.76, 0.42, 0.18), "ui_jade_reading_plate")
	ring_a.name = "CenterWindRingOuter"
	compass.add_child(ring_a)
	var ring_b = make_gpt_plate_rect(rect_full(0.28, 0.28, 0.72, 0.72), Color(0.86, 0.72, 0.38, 0.14), "ui_hand_tray_state_chip")
	ring_b.name = "CenterWindRingMid"
	compass.add_child(ring_b)
	var ring_c = make_gpt_plate_rect(rect_full(0.34, 0.34, 0.66, 0.66), Color(0.96, 0.82, 0.44, 0.16), "dealer_seal")
	ring_c.name = "CenterWindRingInner"
	compass.add_child(ring_c)
	var next = (current + 1) % 4
	var turn_track = make_gpt_plate_rect(rect_full(0.405, 0.405, 0.595, 0.595), Color(0.88, 0.72, 0.34, 0.20), "ui_hand_tray_state_chip")
	turn_track.name = "CenterWindTurnTrack"
	compass.add_child(turn_track)
	draw_center_wind_direction_beads(compass, current)
	var wind_marks := [
		[rect_full(0.45, 0.00, 0.55, 0.15), "东", 0],
		[rect_full(0.85, 0.45, 1.00, 0.55), "南", 1],
		[rect_full(0.45, 0.85, 0.55, 1.00), "西", 2],
		[rect_full(0.00, 0.45, 0.15, 0.55), "北", 3],
	]
	for mark in wind_marks:
		var seat = int(mark[2])
		var active = seat == current
		var upcoming = seat == next
		var badge = make_gpt_gate(mark[0], Color(0.52, 0.42, 0.16, 0.36 if active else 0.16))
		badge.name = "CenterWindCompass_%s" % str(mark[1])
		compass.add_child(badge)
		if active:
			# 双层脉冲光圈
			var halo = make_gpt_plate_rect(rect_full(-0.18, -0.18, 1.18, 1.18), Color(0.96, 0.80, 0.34, 0.12), "ui_jade_reading_plate")
			halo.name = "CenterWindActiveHalo"
			badge.add_child(halo)
			var halo_outer = make_gpt_plate_rect(rect_full(-0.32, -0.32, 1.32, 1.32), Color(0.96, 0.80, 0.34, 0.06), "ui_jade_reading_plate")
			halo_outer.name = "CenterWindActiveHaloOuter"
			badge.add_child(halo_outer)
			var pointer = make_gpt_plate_rect(rect_full(0.360, -0.430, 0.640, -0.150), Color(0.96, 0.78, 0.32, 0.62), "ui_jade_reading_plate")
			pointer.name = "CenterWindCurrentPointer"
			badge.add_child(pointer)
		if seat == dealer_seat:
			var dealer_badge = make_badge(badge, rect_full(-0.20, 0.76, 0.48, 1.22), "庄", 8, Color(0.52, 0.12, 0.08, 0.94), Color(0.96, 0.62, 0.34, 0.42), Color(0.98, 0.90, 0.72))
			dealer_badge.name = "CenterWindDealerBadge"
			dealer_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if upcoming:
			var next_badge = make_badge(badge, rect_full(0.62, -0.20, 1.22, 0.24), "次", 8, Color(0.028, 0.048, 0.050, 0.94), Color(0.78, 0.66, 0.34, 0.34), Color(0.90, 0.86, 0.66))
			next_badge.name = "CenterWindNextBadge"
			next_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
			# 指向箭头脉冲
		var label = make_label(badge, str(mark[1]), 12, GOLD_LIGHT if active else Color(0.64, 0.62, 0.46, 0.72), true)
		apply_rect(label, rect_full(0.0, 0.0, 1.0, 1.0))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and seal_texture != null:
		seal_texture.modulate.a = 0.14
	return compass


func draw_center_wind_direction_beads(parent: Control, current: int) -> void:
	# r214: bulk GPT chrome sweep
	var bead_positions := [
		Vector2(0.50, 0.205),
		Vector2(0.795, 0.50),
		Vector2(0.50, 0.795),
		Vector2(0.205, 0.50),
	]
	for i in range(bead_positions.size()):
		var turn_distance = (i - current + 4) % 4
		var pos: Vector2 = bead_positions[i]
		var alpha = 0.58 if turn_distance == 0 else 0.34 if turn_distance == 1 else 0.18
		var bead = make_gpt_plate_rect(rect_full(pos.x - 0.018, pos.y - 0.018, pos.x + 0.018, pos.y + 0.018), Color(0.88, 0.72, 0.34, alpha), "ui_jade_reading_plate")
		bead.name = "CenterWindDirectionBead_%d" % i
		parent.add_child(bead)


func draw_chat_empty_state_art(parent: Control) -> Control:
	# r180: GPT plates only — no program route/fill/gate ColorRect chrome.
	var art = Control.new()
	art.name = "ChatEmptyStateArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.08, 0.28, 0.92, 0.78))
	parent.add_child(art)
	var plate = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(0.05, 0.35, 0.95, 0.70), 0.36, false)
	if plate != null:
		plate.name = "ChatEmptySignalStrip"
	var meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.12, 0.42, 0.88, 0.62), 0.40, false)
	if meter != null:
		meter.name = "ChatEmptyMeterRail"
	var label = make_label(art, "暂无消息", 14, Color(0.86, 0.82, 0.66, 0.78), true)
	apply_rect(label, rect_full(0.10, 0.15, 0.90, 0.40))
	return art


func draw_chat_panel_art(parent: Control) -> Control:
	# r209: GPT chrome conversion
	var art = Control.new()
	art.name = "ChatPanelArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.0, 0.0, 1.0, 1.0))
	var brocade = add_illustration_texture(art, "chat_panel_brocade", rect_full(0.000, 0.000, 1.000, 1.000), 0.10, false)
	if brocade != null:
		brocade.name = "ChatPanelBrocadeTexture"
		art.move_child(brocade, 0)
	var chat_texture = add_illustration_texture(art, "chat_stream", rect_full(0.018, 0.010, 0.982, 0.985), 0.14, false)
	if chat_texture != null:
		chat_texture.name = "ChatStreamTexture"
	var chat_gpt_key := "chat_gpt_panel"
	var gpt_chat_texture = add_optional_gpt_illustration_texture(art, chat_gpt_key, rect_full(0.006, 0.010, 0.994, 0.990), 0.14, false)
	if gpt_chat_texture != null:
		gpt_chat_texture.name = "ChatGPTPanelTexture"
		art.move_child(gpt_chat_texture, min(1, art.get_child_count() - 1))
	# 笔触分隔线
	make_brush_stroke_divider(art, rect_full(0.10, 0.12, 0.90, 0.15))
	parent.add_child(art)
	var chat_role_rail = add_optional_gpt_illustration_texture(art, "ui_action_role_rail", rect_full(0.0, 0.0, 0.030, 1.0), 0.55, false)
	if chat_role_rail != null:
		chat_role_rail.name = "ChatPanelGptRoleRail"
	var chat_header_strip = add_optional_gpt_illustration_texture(art, "ui_progress_signal_strip", rect_full(0.040, 0.040, 0.960, 0.210), 0.34, false)
	if chat_header_strip != null:
		chat_header_strip.name = "ChatPanelGptHeaderStrip"
	var chat_meter = add_optional_gpt_illustration_texture(art, "ui_meter_rail_plate", rect_full(0.070, 0.215, 0.250, 0.265), 0.42, false)
	if chat_meter != null:
		chat_meter.name = "ChatPanelGptHeaderMeter"
	art.add_child(make_gpt_edge_rail(rect_full(0.0, 0.0, 0.014, 1.0), Color(0.38, 0.70, 0.62, 0.50)))
	art.add_child(make_gpt_edge_rail(rect_full(0.045, 0.205, 0.955, 0.220), Color(0.86, 0.74, 0.42, 0.12)))
	var header = make_gpt_route_rail(rect_full(0.055, 0.055, 0.945, 0.190), Color(0.020, 0.044, 0.050, 0.78))
	header.name = "ChatPanelHeader"
	art.add_child(header)
	add_lucide_icon(header, "users", rect_full(0.035, 0.190, 0.155, 0.810), Color(0.76, 0.88, 0.72, 0.86))
	var title = make_label(header, "房间消息", 12, Color(0.88, 0.92, 0.80), true)
	apply_rect(title, rect_full(0.170, 0.080, 0.575, 0.920))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var count_badge = make_badge(header, rect_full(0.620, 0.170, 0.925, 0.830), "%d条" % min(99, chat_messages.size()), 10, Color(0.42, 0.32, 0.18, 0.92), Color(0.86, 0.68, 0.36, 0.34), Color(0.96, 0.92, 0.78))  # r449 no mint badge
	count_badge.name = "ChatPanelCountBadge"
	count_badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# r180: GPT header meter strip instead of bridge route/fill/gate ticks.
	var header_bridge = Control.new()
	header_bridge.name = "ChatPanelHeaderBridge"
	header_bridge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(header_bridge, rect_full(0.060, 0.185, 0.280, 0.340))
	art.add_child(header_bridge)
	var header_strip = add_optional_gpt_illustration_texture(header_bridge, "ui_progress_signal_strip", rect_full(0.0, 0.15, 1.0, 0.85), 0.38, false)
	if header_strip != null:
		header_strip.name = "ChatPanelHeaderBridgeStrip"
		header_strip.modulate = Color(0.48, 0.78, 0.64, 0.70)
	var header_ratio = clamp(float(chat_messages.size()) / 5.0, 0.20, 1.0)
	var header_meter = add_optional_gpt_illustration_texture(header_bridge, "ui_meter_rail_plate", rect_full(0.04, 0.30, 0.04 + 0.88 * header_ratio, 0.72), 0.55, false)
	if header_meter != null:
		header_meter.name = "ChatPanelHeaderBridgeMeter"
	var rail = add_optional_gpt_illustration_texture(art, "ui_action_role_rail", rect_full(0.050, 0.285, 0.078, 0.900), 0.40, false)
	if rail == null:
		rail = make_gpt_edge_rail(rect_full(0.058, 0.285, 0.070, 0.900), Color(0.60, 0.76, 0.64, 0.20))
		rail.name = "ChatPanelActivityRail"
		art.add_child(rail)
	else:
		rail.name = "ChatPanelActivityRail"
	var visible_count = min(5, chat_messages.size())
	if visible_count == 0:
		draw_chat_empty_state_art(art)
	for i in range(visible_count):
		var top = 0.320 + float(i) * 0.112
		var message_text = str(chat_messages[chat_messages.size() - visible_count + i])
		var is_self_message = message_text.begins_with("你:")
		var lane = add_optional_gpt_illustration_texture(art, "ui_chat_lane_plate", rect_full(0.170, top + 0.010, 0.860, top + 0.055), 0.34 if is_self_message else 0.22, false)
		if lane == null:
			lane = make_gpt_ribbon(rect_full(0.178, top + 0.028, 0.850, top + 0.040), Color(0.42, 0.74, 0.62, 0.10 if is_self_message else 0.055))
			art.add_child(lane)
		lane.name = "ChatPanelGptLane_%d" % i
		var node = make_gpt_gate(rect_full(0.044, top, 0.084, top + 0.048), Color(0.48, 0.78, 0.64, 0.46))
		node.name = "ChatPanelMessageNode_%d" % i
		art.add_child(node)
		var sender_chip = make_gpt_gate(rect_full(0.100, top - 0.008, 0.158, top + 0.056), Color(0.76, 0.62, 0.34, 0.36 if is_self_message else 0.18))
		sender_chip.name = "ChatPanelSenderChip_%d" % i
		art.add_child(sender_chip)
		var tick = make_gpt_tick_strip(rect_full(0.818, top + 0.012, 0.846, top + 0.054), Color(0.62, 0.84, 0.70, 0.22 if is_self_message else 0.12))
		tick.name = "ChatPanelFlowTick_0"
		art.add_child(tick)
		if is_self_message:
			var ribbon = make_gpt_ribbon(rect_full(0.168, top + 0.018, 0.305, top + 0.034), Color(0.86, 0.72, 0.36, 0.28))
			ribbon.name = "ChatPanelOutgoingRibbon_%d" % i
			art.add_child(ribbon)
		var bead = make_gpt_gate(rect_full(0.895, top - 0.002, 0.915, top + 0.046), Color(0.42, 0.74, 0.62, 0.38))
		bead.name = "ChatPanelUnreadBead_%d" % i
		art.add_child(bead)
	var latest_top = 0.320 + float(max(0, visible_count - 1)) * 0.112
	var latest_glow = make_gpt_gate(rect_full(0.036, latest_top - 0.020, 0.092, latest_top + 0.068), Color(0.92, 0.76, 0.34, 0.20))
	latest_glow.name = "ChatPanelLatestGlow"
	art.add_child(latest_glow)
	var latest_cursor = make_gpt_gate(rect_full(0.858, latest_top + 0.002, 0.884, latest_top + 0.058), Color(0.92, 0.76, 0.34, 0.18))
	latest_cursor.name = "ChatPanelLatestCursor"
	art.add_child(latest_cursor)
	# r180: GPT meter strips instead of sync/delivery route/fill/gate/tick chrome.
	var sync_host = Control.new()
	sync_host.name = "ChatPanelSyncChrome"
	sync_host.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(sync_host, rect_full(0.160, latest_top + 0.040, 0.900, latest_top + 0.120))
	art.add_child(sync_host)
	var sync_strip = add_optional_gpt_illustration_texture(sync_host, "ui_progress_signal_strip", rect_full(0.0, 0.10, 1.0, 0.90), 0.36, false)
	if sync_strip != null:
		sync_strip.name = "ChatPanelSyncStrip"
		sync_strip.modulate = Color(0.42, 0.74, 0.62, 0.70)
	var sync_ratio = clamp(float(visible_count) / 5.0, 0.20, 1.0)
	var sync_meter = add_optional_gpt_illustration_texture(sync_host, "ui_meter_rail_plate", rect_full(0.02, 0.28, 0.02 + 0.88 * sync_ratio, 0.72), 0.58, false)
	if sync_meter != null:
		sync_meter.name = "ChatPanelSyncMeter"
	var delivery_host = Control.new()
	delivery_host.name = "ChatPanelDeliveryChrome"
	delivery_host.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(delivery_host, rect_full(0.520, 0.720, 0.940, 0.900))
	art.add_child(delivery_host)
	var delivery_strip = add_optional_gpt_illustration_texture(delivery_host, "ui_progress_signal_strip", rect_full(0.0, 0.08, 1.0, 0.70), 0.40, false)
	if delivery_strip != null:
		delivery_strip.name = "ChatPanelDeliveryStrip"
		delivery_strip.modulate = Color(0.42, 0.74, 0.62, 0.68)
	var delivery_meter = add_optional_gpt_illustration_texture(delivery_host, "ui_meter_rail_plate", rect_full(0.03, 0.22, 0.22 + 0.14 * float(max(1, visible_count)), 0.68), 0.62, false)
	if delivery_meter != null:
		delivery_meter.name = "ChatPanelDeliveryMeter"
	var input_pulse = make_gpt_tick_strip(rect_full(0.760, 0.825, 0.940, 0.905), Color(0.42, 0.72, 0.62, 0.10))
	input_pulse.name = "ChatPanelInputPulse"
	art.add_child(input_pulse)
	var input_chip = add_optional_gpt_illustration_texture(art, "ui_hand_tray_state_chip", rect_full(0.780, 0.830, 0.930, 0.900), 0.42, false)
	if input_chip != null:
		input_chip.name = "ChatPanelInputChip"
	add_lucide_icon(art, "sparkles", rect_full(0.835, 0.058, 0.930, 0.176), Color(0.94, 0.82, 0.46, 0.50))
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if brocade != null:
			brocade.modulate = Color(1, 1, 1, 0.07)
		latest_glow.modulate = Color(1, 1, 1, 0.74)
		input_pulse.modulate = Color(1, 1, 1, 0.72)
	return art


func draw_chat_send_sync_bridge(parent: Control, accent: Color) -> Control:
	# r210: GPT chrome conversion
	var bridge = Control.new()
	bridge.name = "ChatSendSyncBridge"
	bridge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bridge.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(bridge)
	var source = make_gpt_edge_rail(rect_full(0.715, 0.700, 0.760, 0.850), Color(accent.r, accent.g, accent.b, 0.18))
	source.name = "ChatSendSyncSource"
	bridge.add_child(source)
	var stream_route = make_gpt_route_rail(rect_full(0.250, 0.635, 0.735, 0.710), Color(0.006, 0.016, 0.018, 0.44))
	stream_route.name = "ChatSendSyncStreamRoute"
	bridge.add_child(stream_route)
	var stream_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.890, 0.750), Color(accent.r, accent.g, accent.b, 0.24))
	stream_fill.name = "ChatSendSyncStreamFill"
	stream_route.add_child(stream_fill)
	var confirm_route = make_gpt_route_rail(rect_full(0.555, 0.565, 0.860, 0.630), Color(0.006, 0.016, 0.018, 0.42))
	confirm_route.name = "ChatSendSyncConfirmRoute"
	bridge.add_child(confirm_route)
	var confirm_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.760, 0.750), Color(accent.r, accent.g, accent.b, 0.22))
	confirm_fill.name = "ChatSendSyncConfirmFill"
	confirm_route.add_child(confirm_fill)
	var stream_gate = make_gpt_gate(rect_full(0.230, 0.585, 0.285, 0.755), Color(accent.r, accent.g, accent.b, 0.18))
	stream_gate.name = "ChatSendSyncStreamGate"
	bridge.add_child(stream_gate)
	var archive = make_gpt_plate_rect(rect_full(0.835, 0.520, 0.905, 0.680), Color(0.92, 0.72, 0.34, 0.14), "ui_jade_reading_plate")
	archive.name = "ChatSendSyncArchive"
	bridge.add_child(archive)
	var seal_texture = add_optional_gpt_illustration_texture(archive, "chat_send_seal", rect_full(-0.155, -0.205, 1.155, 1.205), 0.86, true)
	if seal_texture != null:
		seal_texture.name = "ChatSendSealTexture"
		seal_texture.pivot_offset = Vector2(8.0, 8.0)
	var archive_glyph = make_label(archive, "达", 8, Color(0.98, 0.94, 0.74, 0.84), true)
	archive_glyph.name = "ChatSendSyncArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tick = add_gpt_tick_strip(bridge, rect_full(0.410, 0.575, (0.428) + float(2) * (0.085), 0.740), Color(accent.r, accent.g, accent.b, 0.21), "ChatSendSyncTick_0")
	for i in range(2):
		var pip = make_gpt_gate(rect_full(0.775 + float(i) * 0.036, 0.470, 0.794 + float(i) * 0.036, 0.585), Color(accent.r, accent.g, accent.b, 0.18 - float(i) * 0.035))
		pip.name = "ChatSendSyncPip_%d" % i
		bridge.add_child(pip)
	stream_fill.modulate = Color(1, 1, 1, 0.78)
	confirm_fill.modulate = Color(1, 1, 1, 0.72)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and seal_texture != null:
		var seal_tw := create_screen_tween()
		seal_tw.set_loops(3)
		seal_tw.tween_property(seal_texture, "scale", Vector2(1.180, 1.180), 0.16).from(Vector2(0.720, 0.720)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		seal_tw.parallel().tween_property(seal_texture, "rotation", -0.08, 0.16).from(0.12)
		seal_tw.tween_property(seal_texture, "scale", Vector2.ONE, 0.26).from(Vector2(1.180, 1.180)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	return bridge

# 牌面动画系统、增强胜利特效、国风装饰元素等新增函数
