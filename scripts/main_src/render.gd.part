	depth_edge.name = "ShopBuyButton3DDepthEdge"
	art.add_child(depth_edge)
	var button_badge = make_gpt_gate(rect_full(0.060, 0.145, 0.940, 0.855), Color(accent.r, accent.g, accent.b, 0.16 if affordable else 0.10))
	button_badge.name = "ShopBuyButtonCleanPlate"
	art.add_child(button_badge)
	var side_bevel = make_gpt_edge_rail(rect_full(0.885, 0.205, 0.955, 0.805), Color(accent.r, accent.g, accent.b, 0.13))
	side_bevel.name = "ShopBuyButton3DSideBevel"
	art.add_child(side_bevel)
	var top_sheen = make_gpt_route_rail(rect_full(0.110, 0.185, 0.840, 0.285), Color(1.0, 0.90, 0.58, 0.050 if affordable else 0.026))
	top_sheen.name = "ShopBuyButtonTopSheen"
	art.add_child(top_sheen)
	if button is Button:
		var clean_buy_button := button as Button
		clean_buy_button.button_down.connect(func() -> void:
			play_shop_buy_button_feedback(clean_buy_button, affordable)
		)
	return art


func draw_shop_currency_meter_art(parent: Control, kind: String, amount: int, accent: Color) -> Control:
	var art = Control.new()
	art.name = "ShopCurrencyMeterArt_%s" % kind
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(art)
	var target = 5000 if kind == "coins" else 100
	var fill_ratio = clamp(float(amount) / float(target), 0.08, 1.0)
	# r202: dedicated GPT route/fill plates (no make_panel StyleBox hosts for meter chrome)
	var rail = make_gpt_route_rail(rect_full(0.040, 0.760, 0.950, 0.900), Color(0.006, 0.018, 0.020, 0.26))  # r216 quieter under GPT plate
	rail.name = "ShopCurrencyRail_%s" % kind
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.42))
	fill.name = "ShopCurrencyFill_%s" % kind
	rail.add_child(fill)
	var flow_rail = make_gpt_route_rail(rect_full(0.285, 0.575, 0.860, 0.665), Color(0.006, 0.018, 0.020, 0.22))  # r216 quieter under GPT plate
	flow_rail.name = "ShopCurrencyFlowRail_%s" % kind
	art.add_child(flow_rail)
	var flow_fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * fill_ratio, 0.740), Color(accent.r, accent.g, accent.b, 0.24))
	flow_fill.name = "ShopCurrencyFlowFill_%s" % kind
	flow_rail.add_child(flow_fill)
	# The generated meter panel stays behind native value/progress layers. This
	# prevents baked coin/control details from competing with the real currency UI.
	var meter_panel_key := "shop_currency_meter_panel"
	var meter_panel = add_optional_gpt_illustration_texture(art, meter_panel_key, rect_full(-0.02, 0.0, 1.02, 1.0), 0.12, false)  # r198: denser GPT plate more visible (smoke <=0.12)
	if meter_panel != null:
		meter_panel.name = "ShopCurrencyMeterPanelTexture_%s" % kind
		art.move_child(meter_panel, 0)
	if fill_ratio <= 0.20:
		var low_route = make_gpt_route_rail(rect_full(0.560, 0.315, 0.940, 0.390), Color(0.006, 0.016, 0.018, 0.44))
		low_route.name = "ShopCurrencyLowRoute_%s" % kind
		art.add_child(low_route)
		var low_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.540, 0.750), Color(0.92, 0.56, 0.34, 0.28))
		low_fill.name = "ShopCurrencyLowFill_%s" % kind
		low_route.add_child(low_fill)
		var low_gate = make_gpt_gate(rect_full(0.900, 0.245, 0.940, 0.495), Color(0.96, 0.76, 0.38, 0.26))
		low_gate.name = "ShopCurrencyLowGate_%s" % kind
		art.add_child(low_gate)
		for i in range(3):
			var low_left = 0.625 + float(i) * 0.062
			var low_tick = make_gpt_tick_strip(rect_full(low_left, 0.235, low_left + 0.018, 0.390), Color(0.92, 0.56, 0.34, 0.24 - float(i) * 0.040))
			low_tick.name = "ShopCurrencyLowTick_%s_%d" % [kind, i]
			art.add_child(low_tick)
	if amount <= 0:
		var empty = make_gpt_gate(rect_full(0.775, 0.180, 0.955, 0.650), Color(0.92, 0.40, 0.30, 0.28))
		empty.name = "ShopCurrencyEmptyWarning_%s" % kind
		art.add_child(empty)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(12)
		tw.tween_property(fill, "modulate:a", 0.46, 0.70).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.92, 0.70).from(0.46)
		var flow_tw := create_screen_tween()
		flow_tw.set_loops(12)
		flow_tw.tween_property(flow_fill, "modulate:a", 0.38, 0.70).from(0.88)
		flow_tw.tween_property(flow_fill, "modulate:a", 0.88, 0.70).from(0.38)
	return art

func draw_shop_item_count_badge_art(parent: Control, item_color: Color, count: int) -> Control:
