		tw.set_parallel(true)
		tw.tween_property(panel, "modulate:a", 1.0, 0.18).from(0.0)
		tw.tween_property(panel, "offset_top", 0.0, 0.18).from(10.0).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)


