	focus.name = "PendingClaimFocusText"
	apply_rect(focus, rect_full(0.345, 0.535, 0.970, 0.940))
	focus.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(focus)
