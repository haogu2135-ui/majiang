func draw_menu_daily_task_art(parent: Control) -> Control:
	# r209: GPT chrome conversion
	var art = Control.new()
	art.name = "MenuDailyTaskArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.040, 0.760, 0.840, 0.965))
	parent.add_child(art)
	var daily_texture = add_illustration_texture(art, "menu_daily_ledger", rect_full(-0.020, -0.200, 1.020, 1.200), 0.11, false)
	if daily_texture != null:
		daily_texture.name = "MenuDailyLedgerTexture"
		daily_texture.modulate = Color(1, 1, 1, 0.09)
	var task_count = max(1, DAILY_TASKS.size())
	var completed = 0
	var best_index = 0
	var best_fraction = -1.0
	for i in range(DAILY_TASKS.size()):
		var task: Dictionary = DAILY_TASKS[i]
		var progress = int(task_progress.get(str(task.get("id", "")), 0))
		var target = max(1, int(task.get("target", 1)))
		var fraction = clamp(float(progress) / float(target), 0.0, 1.0)
		if fraction >= 1.0:
			completed += 1
		if fraction > best_fraction and fraction < 1.0:
			best_fraction = fraction
			best_index = i
	if completed >= DAILY_TASKS.size() and DAILY_TASKS.size() > 0:
		best_index = DAILY_TASKS.size() - 1
	var rail = make_gpt_route_rail(rect_full(0.160, 0.420, 0.980, 0.620), Color(0.026, 0.044, 0.042, 0.74))
	rail.name = "MenuDailyTaskRail"
	art.add_child(rail)
	var fill_fraction = clamp(float(completed) / float(task_count), 0.035, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.280, 0.020 + 0.960 * fill_fraction, 0.720), Color(0.42, 0.74, 0.56, 0.58))
	fill.name = "MenuDailyTaskFill"
	rail.add_child(fill)
	var label = make_label(art, "每日任务 %d/%d" % [completed, DAILY_TASKS.size()], 10, Color(0.78, 0.88, 0.76), true)
	apply_rect(label, rect_full(0.000, 0.060, 0.150, 0.920))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	for i in range(DAILY_TASKS.size()):
		var center = 0.175 + float(i) * (0.780 / float(max(1, DAILY_TASKS.size() - 1)))
		var task: Dictionary = DAILY_TASKS[i]
		var progress = int(task_progress.get(str(task.get("id", "")), 0))
		var target = max(1, int(task.get("target", 1)))
		var done = progress >= target
		var node_color = Color(0.56, 0.84, 0.60, 0.70) if done else Color(0.78, 0.66, 0.34, 0.30)
		var node = make_gpt_gate(rect_full(center - 0.012, 0.300, center + 0.012, 0.740), node_color)
		node.name = "MenuDailyTaskNode_%d" % i
		art.add_child(node)
		if done:
			var claim = make_gpt_plate_rect(rect_full(center - 0.020, 0.080, center + 0.020, 0.260), Color(0.62, 0.88, 0.58, 0.34), "ui_jade_reading_plate")
			claim.name = "MenuDailyTaskClaimMark_%d" % i
			art.add_child(claim)
	var focus_center = 0.175 + float(best_index) * (0.780 / float(max(1, DAILY_TASKS.size() - 1)))
	var focus = make_gpt_plate_rect(rect_full(focus_center - 0.020, 0.200, focus_center + 0.020, 0.840), Color(0.92, 0.76, 0.34, 0.22), "ui_jade_reading_plate")
	focus.name = "MenuDailyTaskFocusGlow"
	art.add_child(focus)
	var focus_pulse = make_gpt_tick_strip(rect_full(focus_center - 0.034, 0.135, focus_center + 0.034, 0.905), Color(0.92, 0.76, 0.34, 0.10))
	focus_pulse.name = "MenuDailyTaskFocusPulse"
	art.add_child(focus_pulse)
	var reward_rail = make_gpt_route_rail(rect_full(0.665, 0.700, 0.980, 0.815), Color(0.006, 0.018, 0.020, 0.46))
	reward_rail.name = "MenuDailyTaskRewardRail"
	art.add_child(reward_rail)
	var reward_fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.030 + 0.940 * fill_fraction, 0.740), Color(0.58, 0.82, 0.48, 0.28))
	reward_fill.name = "MenuDailyTaskRewardFill"
	reward_rail.add_child(reward_fill)
	for i in range(2):
		var reward_node = make_gpt_gate(rect_full(0.690 + float(i) * 0.075, 0.595, 0.730 + float(i) * 0.075, 0.900), Color(0.58, 0.82, 0.48, 0.24))
		reward_node.name = "MenuDailyTaskRewardNode_%d" % i
		art.add_child(reward_node)
	var reward_tick = add_gpt_tick_strip(art, rect_full(0.870, 0.565, (0.890) + float(2) * (0.032), 0.690), Color(0.58, 0.82, 0.48, 0.24), "MenuDailyTaskRewardTick_0")
	for i in range(3):
		var progress_pip = make_gpt_gate(rect_full(0.055 + float(i) * 0.032, 0.690, 0.075 + float(i) * 0.032, 0.815), Color(0.48, 0.78, 0.58, 0.26))
		progress_pip.name = "MenuDailyTaskProgressPip_%d" % i
		art.add_child(progress_pip)
	var completion_route = make_gpt_route_rail(rect_full(0.410, 0.705, 0.665, 0.765), Color(0.006, 0.018, 0.020, 0.42))
	completion_route.name = "MenuDailyTaskCompletionRoute"
	art.add_child(completion_route)
	var completion_fill = make_gpt_meter_fill(rect_full(0.410, 0.716, 0.410 + 0.255 * fill_fraction, 0.754), Color(0.58, 0.82, 0.48, 0.26))
	completion_fill.name = "MenuDailyTaskCompletionFill"
	art.add_child(completion_fill)
	var completion_gate = make_gpt_gate(rect_full(0.642, 0.640, 0.675, 0.815), Color(0.86, 0.96, 0.62, 0.20 + 0.10 * fill_fraction))
	completion_gate.name = "MenuDailyTaskCompletionGate"
	art.add_child(completion_gate)
	var completion_tick = add_gpt_tick_strip(art, rect_full(0.485, 0.655, (0.503) + float(1) * (0.058), 0.815), Color(0.58, 0.82, 0.48, 0.24), "MenuDailyTaskCompletionTick_0")
	focus.modulate = Color(1, 1, 1, 0.82)
	focus_pulse.modulate = Color(1, 1, 1, 0.50)
	reward_fill.modulate = Color(1, 1, 1, 0.80)
	return art


func draw_menu_footer_economy_stats_bridge(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var bridge = Control.new()
	bridge.name = "MenuFooterEconomyStatsBridge"
