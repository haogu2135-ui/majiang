		tw.parallel().tween_property(seal, "scale", Vector2(1.015, 1.015), 1.15).from(Vector2.ONE).set_ease(Tween.EASE_IN_OUT)
		tw.tween_property(glow, "modulate:a", 0.46, 1.15).from(0.26)
		tw.parallel().tween_property(seal, "scale", Vector2.ONE, 1.15).from(Vector2(1.015, 1.015)).set_ease(Tween.EASE_IN_OUT)
