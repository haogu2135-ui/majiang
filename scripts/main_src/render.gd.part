	if reconnect != null:
		reconnect.set_meta("recovery_focus_priority", "primary")
		reconnect.set_meta("recovery_board_preserved", true)
	if lobby != null:
		lobby.set_meta("recovery_focus_priority", "secondary")
		lobby.set_meta("recovery_board_preserved", true)
