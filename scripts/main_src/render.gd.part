func draw_table_log_latest_sync(parent: Control, latest_text: String, row_count: int) -> Control:
	# r210: GPT chrome conversion
	var tag = table_log_tag(latest_text)
	var tag_color = table_log_tag_color(tag)
	var latest_y = 0.330 + float(max(0, row_count - 1)) * 0.215
	var sync = Control.new()
	sync.name = "TableLogLatestSyncRoute"
	sync.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(sync, rect_full(0.070, latest_y - 0.035, 0.955, latest_y + 0.150))
	parent.add_child(sync)
	var source = make_gpt_edge_rail(rect_full(0.000, 0.245, 0.056, 0.755), Color(tag_color.r, tag_color.g, tag_color.b, 0.22))
	source.name = "TableLogLatestSyncSource"
	sync.add_child(source)
	var rail = make_gpt_route_rail(rect_full(0.050, 0.450, 0.940, 0.575), Color(0.006, 0.016, 0.018, 0.46))
	rail.name = "TableLogLatestSyncRail"
	sync.add_child(rail)
	var fill_ratio = clamp(float(table_logs.size()) / 8.0, 0.34, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.018, 0.260, 0.018 + 0.945 * fill_ratio, 0.740), Color(tag_color.r, tag_color.g, tag_color.b, 0.26))
	fill.name = "TableLogLatestSyncFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.895, 0.250, 0.965, 0.765), Color(tag_color.r, tag_color.g, tag_color.b, 0.18))
	gate.name = "TableLogLatestSyncGate"
	sync.add_child(gate)
	var row_signal_count = min(3, max(1, row_count))
	for i in range(row_signal_count):
		var left = 0.205 + float(i) * 0.185
		var node = make_gpt_gate(rect_full(left, 0.305, left + 0.030, 0.710), Color(tag_color.r, tag_color.g, tag_color.b, 0.20 - float(i) * 0.030))
		node.name = "TableLogLatestSyncNode_%d" % i
		sync.add_child(node)
	var tick = add_gpt_tick_strip(sync, rect_full(0.600, 0.160, (0.600) + float(2) * (0.060) + (0.016), 0.405), Color(tag_color.r, tag_color.g, tag_color.b, 0.22), "TableLogLatestSyncTick_0")
	var archive_route = make_gpt_route_rail(rect_full(0.710, 0.675, 0.965, 0.825), Color(0.006, 0.016, 0.018, 0.40))
	archive_route.name = "TableLogCountArchiveRoute"
	sync.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.035, 0.250, 0.820, 0.750), Color(tag_color.r, tag_color.g, tag_color.b, 0.22))
	archive_fill.name = "TableLogCountArchiveFill"
	archive_route.add_child(archive_fill)
	var archive_source = make_gpt_edge_rail(rect_full(0.672, 0.610, 0.724, 0.890), Color(tag_color.r, tag_color.g, tag_color.b, 0.16))
	archive_source.name = "TableLogCountArchiveSource"
	sync.add_child(archive_source)
	var archive_gate = make_gpt_gate(rect_full(0.936, 0.590, 0.992, 0.905), Color(tag_color.r, tag_color.g, tag_color.b, 0.16))
	archive_gate.name = "TableLogCountArchiveGate"
	sync.add_child(archive_gate)
	var archive_glyph = make_label(archive_gate, "%d" % table_logs.size(), 7, Color(0.96, 0.92, 0.72, 0.82), true)
	archive_glyph.name = "TableLogCountArchiveGlyph"
	apply_rect(archive_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_tick = add_gpt_tick_strip(sync, rect_full(0.790, 0.595, (0.804) + float(1) * (0.050), 0.890), Color(tag_color.r, tag_color.g, tag_color.b, 0.18), "TableLogCountArchiveTick_0")
	draw_table_log_archive_commit(sync, tag_color)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		var tw := create_screen_tween()
		tw.set_loops(10)
		tw.tween_property(fill, "modulate:a", 0.40, 0.72).from(0.92)
		tw.parallel().tween_property(gate, "modulate:a", 0.46, 0.72).from(0.90)
		tw.tween_property(fill, "modulate:a", 0.92, 0.72).from(0.40)
		tw.parallel().tween_property(gate, "modulate:a", 0.90, 0.72).from(0.46)
	return sync


func draw_table_log_row(parent: Control, index: int, text: String, latest: bool = false) -> void:
	# r212: GPT chrome conversion
	var top = 0.30 + float(index) * 0.215
	var row = make_gpt_plate_rect(rect_full(0.045, top, 0.955, top + 0.175), Color(0.026, 0.044, 0.044, 0.76), "ui_jade_reading_plate")
	row.name = "TableLogRow_%d" % index
	parent.add_child(row)
	var tag = table_log_tag(text)
	var tag_color = table_log_tag_color(tag)
	var lane = make_gpt_ribbon(rect_full(0.210, 0.790, 0.930, 0.830), Color(tag_color.r, tag_color.g, tag_color.b, 0.105))
	lane.name = "TableLogEventLane"
	row.add_child(lane)
	var node = make_gpt_gate(rect_full(0.006, 0.34, 0.034, 0.66), Color(tag_color.r, tag_color.g, tag_color.b, 0.30))
	node.name = "TableLogTimelineNode"
	row.add_child(node)
	var connector = make_gpt_ribbon(rect_full(0.034, 0.49, 0.058, 0.54), Color(tag_color.r, tag_color.g, tag_color.b, 0.22))
	connector.name = "TableLogTimelineConnector"
	row.add_child(connector)
	var tag_route = make_gpt_route_rail(rect_full(0.058, 0.585, 0.205, 0.635), Color(0.006, 0.016, 0.018, 0.34))
	tag_route.name = "TableLogTagRoute"
	row.add_child(tag_route)
	var tag_fill = make_gpt_meter_fill(rect_full(0.000, 0.000, 0.740, 1.000), Color(tag_color.r, tag_color.g, tag_color.b, 0.22))
	tag_fill.name = "TableLogTagRouteFill"
	tag_route.add_child(tag_fill)
	var tag_gate = make_gpt_gate(rect_full(0.188, 0.520, 0.212, 0.705), Color(tag_color.r, tag_color.g, tag_color.b, 0.22))
	tag_gate.name = "TableLogTagRouteGate"
	row.add_child(tag_gate)
	var tick = add_gpt_tick_strip(row, rect_full(0.088, 0.675, (0.088) + float(1) * (0.042) + (0.012), 0.760), Color(tag_color.r, tag_color.g, tag_color.b, 0.20), "TableLogTagRouteTick_%d_0" % [index])
	for i in range(2):
		var pulse_left = 0.865 + float(i) * 0.035
		var pulse = make_gpt_tick_strip(rect_full(pulse_left, 0.250 + float(i) * 0.090, pulse_left + 0.026, 0.385 + float(i) * 0.090), Color(tag_color.r, tag_color.g, tag_color.b, 0.20 - float(i) * 0.04))
		pulse.name = "TableLogEventPulse_%d_%d" % [index, i]
		row.add_child(pulse)
	if latest:
		var glow = make_gpt_gate(rect_full(0.000, 0.26, 0.044, 0.74), Color(tag_color.r, tag_color.g, tag_color.b, 0.12))
		glow.name = "TableLogLatestGlow"
		row.add_child(glow)
		var cursor = make_gpt_edge_rail(rect_full(0.905, 0.205, 0.972, 0.795), Color(tag_color.r, tag_color.g, tag_color.b, 0.12))
		cursor.name = "TableLogLatestCursor"
		row.add_child(cursor)
	var badge = make_gpt_gate(rect_full(0.035, 0.22, 0.205, 0.78), tag_color.darkened(0.16))
	badge.name = "TableLogTagBadge"
	row.add_child(badge)
	var badge_text = make_label(badge, tag, 10, Color(0.98, 0.96, 0.86), true)
	apply_rect(badge_text, rect_full(0.0, 0.0, 1.0, 1.0))
	var body = make_label(row, table_log_display_text(text), 11, Color(0.76, 0.84, 0.78), false)
	apply_rect(body, rect_full(0.24, 0.10, 0.96, 0.90))
	body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(body)


func draw_table_log_timeline(parent: Control, row_count: int) -> Control:
	# r214: bulk GPT chrome sweep
	var rail_bottom = 0.340 + float(max(0, row_count - 1)) * 0.215
	var rail = make_gpt_route_rail(rect_full(0.092, 0.342, 0.112, rail_bottom + 0.085), Color(0.78, 0.66, 0.34, 0.16))
	rail.name = "TableLogTimelineRail"
	parent.add_child(rail)
	var flow = make_gpt_plate_rect(rect_full(0.072, 0.320, 0.132, rail_bottom + 0.110), Color(0.78, 0.66, 0.34, 0.055), "ui_jade_reading_plate")
	flow.name = "TableLogTimelineFlow"
	parent.add_child(flow)
	return rail


func draw_table_ornaments(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	for edge_index in range(TABLE_ORNAMENT_EDGES.size()):
		var item = TABLE_ORNAMENT_EDGES[edge_index]
		var _gpt_panel_host = make_gpt_plate_rect(item[0], item[1], "ui_jade_reading_plate")
		_gpt_panel_host.name = "GptPanelHost_%d" % edge_index
		parent.add_child(_gpt_panel_host)
	for corner_index in range(TABLE_CORNER_RECTS.size()):
		draw_table_corner(parent, TABLE_CORNER_RECTS[corner_index], corner_index)


func draw_table_round_tempo(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var tempo = Control.new()
	tempo.name = "TableRoundTempoArt"
	tempo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tempo.set_anchors_preset(Control.PRESET_FULL_RECT)
	parent.add_child(tempo)
	var progress = clamp(float(max(offline_hand_number, 1)) / float(MATCH_MAX_HANDS), 0.0, 1.0)
	var tempo_texture = add_illustration_texture(tempo, "round_tempo_scroll", rect_full(0.312, 0.886, 0.688, 1.000), 0.13, false)
	if tempo_texture != null:
		tempo_texture.name = "TableRoundTempoTexture"
	var rail = make_gpt_route_rail(rect_full(0.365, 0.942, 0.635, 0.966), Color(0.006, 0.014, 0.016, 0.34))
	rail.name = "TableRoundTempoRail"
	tempo.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.020, 0.260, 0.020 + 0.780 * progress, 0.740), Color(0.90, 0.76, 0.36, 0.28))
	fill.name = "TableRoundTempoFill"
	rail.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.642, 0.925, 0.682, 0.982), Color(0.90, 0.76, 0.36, 0.16))
	gate.name = "TableRoundTempoGate"
	tempo.add_child(gate)
	for i in range(MATCH_MAX_HANDS):
		var x = 0.372 + float(i) * 0.032
		var active = i < offline_hand_number
		var node = make_gpt_gate(rect_full(x, 0.927, x + 0.012, 0.982), Color(0.90, 0.76, 0.36, 0.22 if active else 0.075))
		node.name = "TableRoundTempoNode_%d" % i
		tempo.add_child(node)
	var cursor_x = 0.372 + float(clamp(offline_hand_number - 1, 0, MATCH_MAX_HANDS - 1)) * 0.032
	var cursor = make_gpt_edge_rail(rect_full(cursor_x - 0.008, 0.912, cursor_x + 0.020, 0.996), Color(0.96, 0.82, 0.40, 0.16))
	cursor.name = "TableRoundTempoCursor"
	tempo.add_child(cursor)
	var tick = add_gpt_tick_strip(tempo, rect_full(0.442, 0.902, (0.452) + float(2) * (0.066), 0.923), Color(0.90, 0.76, 0.36, 0.18), "TableRoundTempoTick_0")
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if tempo_texture != null:
			tempo_texture.modulate.a = 0.10
		cursor.modulate.a = 0.82
	return tempo


func draw_table_turn_flow(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	var positions := [
		Vector2(0.500, 0.815),
		Vector2(0.812, 0.505),
		Vector2(0.500, 0.205),
		Vector2(0.188, 0.505),
	]
	var seat = clamp(get_current_seat(), 0, 3)
	var pos: Vector2 = positions[seat]
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY
	var trail = add_illustration_texture(parent, "turn_flow_trail", rect_full(0.180, 0.180, 0.820, 0.820), 0.10, true)
	if trail != null:
		trail.name = "TableTurnFlowTrail"
	var table_turn_gpt_key := "table_turn_gpt_flow"
	var table_turn_gpt_texture = add_optional_gpt_illustration_texture(parent, table_turn_gpt_key, rect_full(0.160, 0.160, 0.840, 0.840), 0.18, true)  # r221
	if table_turn_gpt_texture != null:
		table_turn_gpt_texture.name = "TableTurnGPTFlowTexture"
	var halo = make_gpt_plate_rect(rect_full(pos.x - 0.060, pos.y - 0.060, pos.x + 0.060, pos.y + 0.060), Color(accent.r, accent.g, accent.b, 0.10), "ui_jade_reading_plate")
	halo.name = "TableTurnFlowHalo"
	parent.add_child(halo)
	var seal = make_gpt_gate(rect_full(pos.x - 0.030, pos.y - 0.030, pos.x + 0.030, pos.y + 0.030), Color(accent.r, accent.g, accent.b, 0.30))
	seal.name = "TableTurnFlowSeal"
	parent.add_child(seal)
	var label = make_label(seal, CENTER_WIND_LABELS[seat], 13, Color(0.96, 0.90, 0.66), true)
	apply_rect(label, rect_full(0.0, 0.0, 1.0, 1.0))
	var flow = make_gpt_route_rail(rect_full(0.380, 0.482, 0.620, 0.518), Color(accent.r, accent.g, accent.b, 0.11))
	flow.name = "TableTurnFlowRibbon"
	parent.add_child(flow)
	var center := Vector2(0.500, 0.500)
	var route = Control.new()
	route.name = "TableTurnFlowRoute"
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if abs(pos.x - center.x) >= abs(pos.y - center.y):
		apply_rect(route, rect_full(min(center.x, pos.x), center.y - 0.006, max(center.x, pos.x), center.y + 0.006))
	else:
		apply_rect(route, rect_full(center.x - 0.006, min(center.y, pos.y), center.x + 0.006, max(center.y, pos.y)))
	parent.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.020, 0.200, 0.820, 0.800), Color(accent.r, accent.g, accent.b, 0.26))
	route_fill.name = "TableTurnFlowRouteFill"
	route.add_child(route_fill)
	var gate = make_gpt_gate(rect_full(pos.x - 0.016, pos.y - 0.040, pos.x + 0.016, pos.y + 0.040), Color(accent.r, accent.g, accent.b, 0.16))
	gate.name = "TableTurnFlowGate"
	parent.add_child(gate)
	for i in range(3):
		var t = 0.280 + float(i) * 0.180
		var tick_x = lerp(center.x, pos.x, t)
		var tick_y = lerp(center.y, pos.y, t)
		var tick = make_gpt_tick_strip(rect_full(tick_x - 0.006, tick_y - 0.026, tick_x + 0.006, tick_y + 0.026), Color(accent.r, accent.g, accent.b, 0.20 - float(i) * 0.035))
		tick.name = "TableTurnFlowTick_0"
		parent.add_child(tick)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if trail != null:
			trail.modulate.a = 0.06
		halo.modulate.a = 0.54


func draw_table_wall_lanterns(parent: Control) -> void:
	# r214: bulk GPT chrome sweep
	if get_wall_count() > 24:
		return
	var wall_progress = clamp(float(get_wall_count()) / 144.0, 0.0, 1.0)
	var lantern_positions := [
		Vector2(0.500, 0.075),
		Vector2(0.912, 0.505),
		Vector2(0.500, 0.905),
		Vector2(0.088, 0.505),
	]
	for i in range(lantern_positions.size()):
		var pos: Vector2 = lantern_positions[i]
		var active_alpha = 0.070 + (1.0 - wall_progress) * 0.075
		var lantern = make_gpt_plate_rect(rect_full(pos.x - 0.020, pos.y - 0.020, pos.x + 0.020, pos.y + 0.020), Color(0.62, 0.40, 0.18, active_alpha), "ui_jade_reading_plate")
		lantern.name = "TableWallLantern_%d" % i
		parent.add_child(lantern)
		var core = make_gpt_plate_rect(rect_full(0.34, 0.30, 0.66, 0.70), Color(0.92, 0.46, 0.24, 0.12 + (1.0 - wall_progress) * 0.12), "ui_jade_reading_plate")
		core.name = "TableWallLanternCore_%d" % i
		lantern.add_child(core)
		var warning = make_gpt_plate_rect(rect_full(0.08, 0.08, 0.92, 0.92), Color(0.86, 0.28, 0.16, 0.12), "ui_jade_reading_plate")
		warning.name = "TableWallLanternLowWarning_%d" % i
		lantern.add_child(warning)
		core.modulate = Color(1, 1, 1, 0.78)


