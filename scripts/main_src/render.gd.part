func draw_menu_quick_action_rail(parent: Control) -> Control:
	# r214: bulk GPT chrome sweep
	var rail = Control.new()
	rail.name = "MenuQuickActionRail"
	rail.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(rail, rect_full(0.250, 0.704, 0.750, 0.804))
	parent.add_child(rail)
	var items := [
		["rules", "规则", "help-circle", Color(0.30, 0.58, 0.50), Callable(self, "show_rules_screen")],
		["stats", "战绩", "trophy", Color(0.56, 0.46, 0.72), Callable(self, "show_stats_screen")],
		["achievements", "成就", "medal", Color(0.70, 0.54, 0.28), Callable(self, "show_achievements_screen")],
		["shop", "商店", "gift", Color(0.62, 0.38, 0.30), Callable(self, "show_shop_screen")],
	]
	var surface = make_gpt_plate_rect(rect_full(0.015, 0.050, 0.985, 0.750), Color(0.010, 0.020, 0.022, 0.64), "ui_button_face_plate")
	surface.name = "MenuQuickActionSurface"
	rail.add_child(surface)
	rail.move_child(surface, 0)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		surface.modulate.a = 0.72
		var surface_tw := create_screen_tween()
		surface_tw.set_loops(48)
		surface_tw.tween_property(surface, "modulate:a", 0.48, 1.35).from(0.72).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		surface_tw.tween_property(surface, "modulate:a", 0.72, 1.35).from(0.48).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	var start_x := 0.025
	var end_x := 0.975
	var gap := 0.018
	var button_width := (end_x - start_x - gap * float(max(0, items.size() - 1))) / float(max(1, items.size()))
	for i in range(items.size()):
		var item: Array = items[i]
		var quick_id := str(item[0])
		var quick_color: Color = item[3]
		var button = make_small_button(str(item[1]), item[3], item[4])
		button.name = "MenuQuick%sButton" % quick_id.capitalize()
		button.custom_minimum_size = Vector2(96, 44)
		button.button_down.connect(Callable(self, "play_menu_quick_button_press_feedback").bind(button, quick_id, quick_color))
		rail.add_child(button)
		var left = start_x + float(i) * (button_width + gap)
		apply_rect(button, rect_full(left, 0.060, left + button_width, 0.940))
		add_lucide_icon(button, str(item[2]), rect_full(0.100, 0.255, 0.225, 0.575), Color(0.94, 0.92, 0.76, 0.88))
		configure_menu_button_motion(button, 0.12 + float(i) * 0.045, 1.060, 0.0)
	return rail


func draw_menu_season_progress_art(parent: Control) -> Control:
	# r207: GPT chrome conversion
	var art = Control.new()
	art.name = "MenuSeasonProgressArt"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(art, rect_full(0.520, 0.150, 0.660, 0.880))
	parent.add_child(art)
	var season_texture = add_illustration_texture(art, "menu_season_scroll", rect_full(-0.080, -0.045, 1.080, 1.045), 0.12, false)
	if season_texture != null:
		season_texture.name = "MenuSeasonScrollTexture"
	var trophy_texture = add_optional_gpt_illustration_texture(art, "season_trophy_loop", rect_full(0.265, 0.035, 0.735, 0.405), 0.86, true)
	if trophy_texture != null:
		trophy_texture.name = "MenuSeasonTrophyLoopTexture"
		trophy_texture.pivot_offset = Vector2(36.0, 36.0)
	var points = int(season_data.get("points", 0))
	var rank = get_current_rank()
	var next_index = min(rank + 1, SEASON_RANK_POINTS.size() - 1)
	var current_points = int(SEASON_RANK_POINTS[rank])
	var next_points = int(SEASON_RANK_POINTS[next_index])
	var progress = 1.0 if next_index == rank else clamp(float(points - current_points) / float(max(1, next_points - current_points)), 0.0, 1.0)
	var rail = make_gpt_route_rail(rect_full(0.080, 0.760, 0.920, 0.900), Color(0.028, 0.046, 0.048, 0.78))
	rail.name = "MenuSeasonProgressRail"
	art.add_child(rail)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.280, 0.030 + 0.940 * progress, 0.720), Color(0.78, 0.64, 0.30, 0.64))
	fill.name = "MenuSeasonProgressFill"
	rail.add_child(fill)
	if progress > 0.0 and fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		fill.anchor_right = 0.030
		var fill_tw := create_screen_tween()
		fill_tw.tween_property(fill, "anchor_right", 0.030 + 0.940 * progress, 0.5).set_delay(0.2).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	var route = make_gpt_route_rail(rect_full(0.105, 0.505, 0.880, 0.605), Color(0.010, 0.020, 0.022, 0.48))
	route.name = "MenuSeasonRouteRail"
	art.add_child(route)
	var route_fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * progress, 0.740), Color(0.92, 0.74, 0.34, 0.30))
	route_fill.name = "MenuSeasonRouteFill"
	route.add_child(route_fill)
	if progress > 0.0 and fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		route_fill.anchor_right = 0.025
		var rf_tw := create_screen_tween()
		rf_tw.tween_property(route_fill, "anchor_right", 0.025 + 0.950 * progress, 0.5).set_delay(0.35).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	var route_gate_left = 0.105 + 0.775 * progress
	var route_gate = make_gpt_gate(rect_full(route_gate_left - 0.018, 0.455, route_gate_left + 0.018, 0.655), Color(0.92, 0.74, 0.34, 0.20))
	route_gate.name = "MenuSeasonRouteGate"
	art.add_child(route_gate)
	for i in range(SEASON_RANKS.size()):
		var center = 0.08 + float(i) * (0.84 / float(max(1, SEASON_RANKS.size() - 1)))
		var active = i <= rank
		var node = make_gpt_gate(rect_full(center - 0.025, 0.690, center + 0.025, 0.970), Color(0.86, 0.70, 0.34, 0.72 if active else 0.20))
		node.name = "MenuSeasonRankNode_%d" % i
		art.add_child(node)
	var current_center = 0.08 + float(rank) * (0.84 / float(max(1, SEASON_RANKS.size() - 1)))
	var rank_halo = make_gpt_plate_rect(rect_full(current_center - 0.040, 0.620, current_center + 0.040, 1.000), Color(0.92, 0.74, 0.34, 0.16), "ui_jade_reading_plate")
	rank_halo.name = "MenuSeasonCurrentRankHalo"
	art.add_child(rank_halo)
	var current_pulse = make_gpt_tick_strip(rect_full(current_center - 0.056, 0.580, current_center + 0.056, 1.000), Color(0.92, 0.74, 0.34, 0.10))
	current_pulse.name = "MenuSeasonCurrentRankPulse"
	art.add_child(current_pulse)
	var current_glyph = make_label(current_pulse, "段", 8, Color(0.98, 0.90, 0.62, 0.62), true)
	current_glyph.name = "MenuSeasonCurrentRankGlyph"
	apply_rect(current_glyph, rect_full(0.000, 0.070, 1.000, 0.430))
	if next_index != rank:
		var next_center = 0.08 + float(next_index) * (0.84 / float(max(1, SEASON_RANKS.size() - 1)))
		var arrow_left = min(current_center, next_center) + 0.030
		var arrow_right = max(current_center, next_center) - 0.030
		var arrow = make_gpt_ribbon(rect_full(arrow_left, 0.595, arrow_right, 0.635), Color(0.92, 0.78, 0.42, 0.22))
		arrow.name = "MenuSeasonNextRankArrow"
		art.add_child(arrow)
		var bridge = make_gpt_route_rail(rect_full(arrow_left, 0.365, arrow_right, 0.415), Color(0.006, 0.016, 0.018, 0.32))
		bridge.name = "MenuSeasonNextRankBridge"
		art.add_child(bridge)
		var bridge_fill = make_gpt_meter_fill(rect_full(0.000, 0.000, max(0.120, progress), 1.000), Color(0.92, 0.74, 0.34, 0.22))
		bridge_fill.name = "MenuSeasonNextRankBridgeFill"
		bridge.add_child(bridge_fill)
		var bridge_gate = make_gpt_gate(rect_full(arrow_right - 0.012, 0.330, arrow_right + 0.012, 0.470), Color(0.92, 0.74, 0.34, 0.20))
		bridge_gate.name = "MenuSeasonNextRankBridgeGate"
		art.add_child(bridge_gate)
		var goal_marker = make_gpt_gate(rect_full(next_center - 0.034, 0.610, next_center + 0.034, 0.945), Color(0.78, 0.86, 0.52, 0.14))
		goal_marker.name = "MenuSeasonPromotionGoalMarker"
		art.add_child(goal_marker)
		var goal_glyph = make_label(goal_marker, "升", 8, Color(0.98, 0.92, 0.66, 0.72), true)
		goal_glyph.name = "MenuSeasonPromotionGoalGlyph"
		apply_rect(goal_glyph, rect_full(0.000, 0.000, 1.000, 1.000))
		for i in range(3):
			var step_left = arrow_left + (arrow_right - arrow_left) * (0.260 + float(i) * 0.210)
			var pulse_step = make_gpt_tick_strip(rect_full(step_left - 0.012, 0.520, step_left + 0.012, 0.670), Color(0.92, 0.76, 0.34, 0.22 - float(i) * 0.040))
			pulse_step.name = "MenuSeasonPromotionPulseStep_%d" % i
			art.add_child(pulse_step)
	for i in range(2):
		var node_left = 0.465 + float(i) * 0.090
		var route_node = make_gpt_gate(rect_full(node_left, 0.425, node_left + 0.045, 0.675), Color(0.92, 0.74, 0.34, 0.22))
		route_node.name = "MenuSeasonRouteNode_%d" % i
		art.add_child(route_node)
	for i in range(3):
		var left = 0.125 + float(i) * 0.055
		var spark = make_gpt_gate(rect_full(left, 0.160 + float(i % 2) * 0.085, left + 0.022, 0.300 + float(i % 2) * 0.085), Color(0.92, 0.76, 0.34, 0.30))
		spark.name = "MenuSeasonPointSpark_%d" % i
		art.add_child(spark)
	var tick = add_gpt_tick_strip(art, rect_full(0.720, 0.315, (0.742) + float(2) * (0.045), 0.450), Color(0.92, 0.76, 0.34, 0.24), "MenuSeasonEnergyTick_0")
	var tick_2 = add_gpt_tick_strip(art, rect_full(0.520, 0.325, (0.536) + float(1) * (0.060), 0.425), Color(0.92, 0.76, 0.34, 0.20), "MenuSeasonBridgeTick_0")
	fill.modulate = Color(1, 1, 1, 0.82)
	route_fill.modulate = Color(1, 1, 1, 0.80)
	rank_halo.modulate = Color(1, 1, 1, 0.72)
	current_pulse.modulate = Color(1, 1, 1, 0.82)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless":
		if trophy_texture != null:
			trophy_texture.modulate.a = 0.78
			var trophy_tw := create_screen_tween()
			trophy_tw.set_loops(48)
			trophy_tw.tween_property(trophy_texture, "rotation", 0.055, 1.15).from(-0.055).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			trophy_tw.parallel().tween_property(trophy_texture, "scale", Vector2(1.060, 1.060), 1.15).from(Vector2(0.960, 0.960)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			trophy_tw.parallel().tween_property(trophy_texture, "modulate:a", 0.96, 1.15).from(0.72).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			trophy_tw.tween_property(trophy_texture, "rotation", -0.055, 1.15).from(0.055).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			trophy_tw.parallel().tween_property(trophy_texture, "scale", Vector2(0.960, 0.960), 1.15).from(Vector2(1.060, 1.060)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			trophy_tw.parallel().tween_property(trophy_texture, "modulate:a", 0.72, 1.15).from(0.96).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		var pulse_tw := create_screen_tween()
		pulse_tw.set_loops(48)
		pulse_tw.tween_property(current_pulse, "modulate:a", 0.36, 0.80).from(0.82).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		pulse_tw.parallel().tween_property(current_pulse, "scale", Vector2(1.040, 1.040), 0.80).from(Vector2.ONE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		pulse_tw.tween_property(current_pulse, "modulate:a", 0.82, 0.80).from(0.36).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		pulse_tw.parallel().tween_property(current_pulse, "scale", Vector2.ONE, 0.80).from(Vector2(1.040, 1.040)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	return art


