func play_shop_buy_button_feedback(button: Button, affordable: bool) -> void:
	# r215: GPT chrome conversion
	if button == null or not is_instance_valid(button):
		return
	var accent = Color(0.62, 0.52, 0.86) if affordable else Color(0.74, 0.44, 0.38)
	var role = "available" if affordable else "blocked"
	var feedback = Control.new()
	feedback.name = "ShopBuyButtonPressFeedback_%s" % role
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(feedback)
	var source = make_gpt_edge_rail(rect_full(0.090, 0.520, 0.155, 0.760), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "ShopBuyButtonPressSource_%s" % role
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.155, 0.610, 0.860, 0.705), Color(0.006, 0.016, 0.018, 0.48))
	route.name = "ShopBuyButtonPressRoute_%s" % role
	feedback.add_child(route)
	var fill_right = 0.900 if affordable else 0.380
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.250, fill_right, 0.750), Color(accent.r, accent.g, accent.b, 0.34 if affordable else 0.22))
	fill.name = "ShopBuyButtonPressFill_%s" % role
	route.add_child(fill)
	var gate_left = 0.805 if affordable else 0.220
	var gate = make_gpt_gate(rect_full(gate_left, 0.500, gate_left + 0.070, 0.790), Color(1.0, 0.82, 0.42, 0.22 if affordable else 0.14))
	gate.name = "ShopBuyButtonPressGate_%s" % role
	feedback.add_child(gate)
	var seal = make_gpt_gate(rect_full(0.690, 0.155, 0.835, 0.505), Color(accent.r, accent.g, accent.b, 0.16))
	seal.name = "ShopBuyButtonPressSeal_%s" % role
	feedback.add_child(seal)
	var glyph = make_label(seal, "购" if affordable else "锁", 9, Color(0.98, 0.92, 0.66, 0.88), true)
	glyph.name = "ShopBuyButtonPressGlyph_%s" % role
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var tick = make_gpt_tick_strip(rect_full(0.405 + float(i) * 0.075, 0.445, 0.430 + float(i) * 0.075, 0.650), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.045 if affordable else 0.13))
		tick.name = "ShopBuyButtonPressTick_%s_%d" % [role, i]
		feedback.add_child(tick)
	if not affordable:
		var lock = make_gpt_plate_rect(rect_full(0.055, 0.165, 0.190, 0.500), Color(accent.r, accent.g, accent.b, 0.20), "ui_jade_reading_plate")
		lock.name = "ShopBuyButtonPressLock"
		feedback.add_child(lock)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.06).from(0.0)
		tw.tween_property(fill, "anchor_right", 1.0 if affordable else 0.520, 0.15).from(0.120).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.12).from(Vector2(0.84, 0.84)).set_ease(Tween.EASE_OUT)
		tw.tween_property(seal, "scale", Vector2(1.08, 1.08), 0.12).from(Vector2(0.88, 0.88)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.06)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.92


func _play_purchase_success_animation(row: Control, item_color: Color) -> void:
	# r215: GPT chrome conversion
	"""播放购买成功动画 - 增强版：物品闪光 + 金币粒子飞溅"""
	if row == null or not is_instance_valid(row):
		return
	var feedback = Control.new()
	feedback.name = "ShopPurchaseSuccessFeedback"
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback.set_anchors_preset(Control.PRESET_FULL_RECT)
	row.add_child(feedback)
	var source = make_gpt_edge_rail(rect_full(0.750, 0.250, 0.805, 0.735), Color(0.62, 0.52, 0.86, 0.22))
	source.name = "ShopPurchaseSuccessSource"
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.565, 0.590, 0.900, 0.675), Color(0.006, 0.016, 0.018, 0.50))
	route.name = "ShopPurchaseSuccessRoute"
	feedback.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.030, 0.260, 0.860, 0.740), Color(item_color.r, item_color.g, item_color.b, 0.34))
	fill.name = "ShopPurchaseSuccessFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.535, 0.515, 0.590, 0.755), Color(item_color.r, item_color.g, item_color.b, 0.24))
	gate.name = "ShopPurchaseSuccessInventoryGate"
	feedback.add_child(gate)
	draw_shop_purchase_inventory_commit_art(feedback, item_color)
	for i in range(3):
		var tick = make_gpt_tick_strip(rect_full(0.645 + float(i) * 0.070, 0.475, 0.666 + float(i) * 0.070, 0.745), Color(item_color.r, item_color.g, item_color.b, 0.26 - float(i) * 0.040))
		tick.name = "ShopPurchaseSuccessTick_%d" % i
		feedback.add_child(tick)
	# 闪光效果
	var flash = make_fullrect_overlay(Color(item_color.r, item_color.g, item_color.b, 0.0), "ui_soft_flash")
	flash.name = "ShopPurchaseSuccessFlash"
	feedback.add_child(flash)

	var flash_tween := create_tween()
	flash_tween.tween_property(flash, "modulate:a", 0.3, 0.15)
	flash_tween.tween_property(flash, "modulate:a", 0.0, 0.3)
	flash_tween.tween_callback(Callable(self, "queue_free_node_by_id").bind(flash.get_instance_id()))

	# 边框高亮 - 增强为更明显的发光
	var highlight_tween := create_tween()
	highlight_tween.tween_property(row, "modulate", Color(1.25, 1.22, 1.18, 1.0), 0.15)
	highlight_tween.tween_property(row, "modulate", Color(1.0, 1.0, 1.0, 1.0), 0.3)

	# 金币粒子飞溅 - 从行中心向四周散开
	if fx_enabled_effective() and is_instance_valid(row):
		var route_tw := create_tween()
		route_tw.set_parallel(true)
		route_tw.tween_property(fill, "anchor_right", 1.0, 0.24).from(0.12).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		route_tw.tween_property(gate, "scale", Vector2(1.12, 1.12), 0.18).from(Vector2(0.86, 0.86)).set_ease(Tween.EASE_OUT)
		route_tw.set_parallel(false)
		route_tw.tween_property(feedback, "modulate:a", 0.0, 0.22).from(1.0).set_delay(0.36)
		route_tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
		var row_size = row.size
		var center = Vector2(row_size.x * 0.5, row_size.y * 0.5)
		for i in range(10):
			var gold_tone = GOLD_PRIMARY if i % 2 == 0 else GOLD_BRIGHT
			var psize = 4.0 + randf() * 5.0
			var particle = make_gpt_spark(Vector2(psize, psize), Color(gold_tone.r, gold_tone.g, gold_tone.b, 0.92))
			particle.name = "ShopPurchaseSuccessParticle_%d" % i
			particle.position = center - Vector2(psize * 0.5, psize * 0.5)
			row.add_child(particle)
			var angle := float(i) * TAU / 10.0 + randf() * 0.3
			var dist := 40.0 + randf() * 50.0
			var target_pos: Vector2 = center + Vector2(cos(angle), sin(angle)) * dist - Vector2(psize * 0.5, psize * 0.5)
			var p_tw := create_tween()
			p_tw.set_parallel(true)
			p_tw.tween_property(particle, "position", target_pos, 0.6).set_ease(Tween.EASE_OUT)
			p_tw.tween_property(particle, "modulate:a", 0.0, 0.6).set_ease(Tween.EASE_IN)
			p_tw.tween_property(particle, "scale", Vector2(0.3, 0.3), 0.6).set_ease(Tween.EASE_IN)
			p_tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(particle.get_instance_id())).set_delay(0.65)


var chat_messages: Array = []
var chat_input: LineEdit = null


func add_chat_message(text: String) -> void:
	chat_messages.append(text)
	if chat_messages.size() > 50:
		chat_messages = chat_messages.slice(-30)

func send_quick_chat(message: String) -> void:
	if mode != "online_lobby" and mode != "online_game":
		return
	add_chat_message("你: %s" % message)
	play_chat_send_panel_feedback(message)
	send_online_action({"type": "chat", "message": message}, "发送消息")
	show_toast("已发送: %s" % message, 1500)

func play_chat_send_panel_feedback(message: String = "") -> Control:
	# r215: GPT chrome conversion
	var panel = find_child("ChatPanel", true, false) as Control
	if panel == null or not is_instance_valid(panel):
		return null
	var feedback = Control.new()
	feedback.name = "ChatSendPanelFeedback"
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback.set_anchors_preset(Control.PRESET_FULL_RECT)
	panel.add_child(feedback)
	var accent = Color(0.42, 0.78, 0.62)
	var source = make_gpt_gate(rect_full(0.095, 0.805, 0.170, 0.900), Color(accent.r, accent.g, accent.b, 0.22))
	source.name = "ChatSendPanelSource"
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.165, 0.838, 0.900, 0.878), Color(0.006, 0.016, 0.018, 0.50))
	route.name = "ChatSendPanelRoute"
	feedback.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.026, 0.260, 0.820, 0.740), Color(accent.r, accent.g, accent.b, 0.36))
	fill.name = "ChatSendPanelFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.872, 0.785, 0.930, 0.928), Color(0.92, 0.74, 0.34, 0.24))
	gate.name = "ChatSendPanelGate"
	feedback.add_child(gate)
	var receipt = make_gpt_gate(rect_full(0.745, 0.742, 0.820, 0.832), Color(accent.r, accent.g, accent.b, 0.18))
	receipt.name = "ChatSendPanelReceiptNode"
	feedback.add_child(receipt)
	var glyph = make_label(receipt, str(message).substr(0, 1) if str(message).strip_edges() != "" else "发", 8, Color(0.96, 0.92, 0.72, 0.86), true)
	glyph.name = "ChatSendPanelReceiptGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	draw_chat_send_sync_bridge(feedback, accent)
	for i in range(3):
		var tick = make_gpt_tick_strip(rect_full(0.320 + float(i) * 0.130, 0.770, 0.342 + float(i) * 0.130, 0.910), Color(accent.r, accent.g, accent.b, 0.24 - float(i) * 0.040))
		tick.name = "ChatSendPanelTick_%d" % i
		feedback.add_child(tick)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.08).from(0.0)
		tw.tween_property(fill, "anchor_right", 1.0, 0.20).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.14).from(Vector2(0.88, 0.88)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.24).from(1.0).set_delay(0.16)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.92
	return feedback


func human_discard_fly_start_position(index: int, hand_size: int) -> Vector2:
	var screen_rect = root_layer_rect_to_screen_rect(HAND_TRAY_RECT)
	var viewport_size = effective_viewport_size()
	var left = screen_rect.position.x * viewport_size.x
	var top = screen_rect.position.y * viewport_size.y
	var width = (screen_rect.size.x - screen_rect.position.x) * viewport_size.x
	var height = (screen_rect.size.y - screen_rect.position.y) * viewport_size.y
	var safe_count = max(1, hand_size)
	var slot = clamp(index, 0, safe_count - 1)
	var x = left + width * (0.10 + 0.80 * (float(slot) + 0.5) / float(safe_count))
	var y = top + height * 0.64
	return Vector2(x, y)

func human_discard_fly_target_position() -> Vector2:
	return rect_center_screen_position(seat_discard_rect(0))

func ai_discard_fly_start_position(seat: int) -> Vector2:
	return rect_center_screen_position(fx_seat_screen_rect(seat))

func ai_discard_fly_target_position(seat: int) -> Vector2:
	return rect_center_screen_position(seat_discard_rect(seat))

func ai_draw_fly_start_position() -> Vector2:
	return rect_center_screen_position(CENTER_PANEL_RECT)

func ai_draw_fly_target_position(seat: int) -> Vector2:
	return rect_center_screen_position(fx_seat_screen_rect(seat))

func play_human_discard_fly_animation(tile: String, index: int, hand_size: int) -> void:
	if not fx_enabled_effective() or tile == "":
		return
	var from_pos = human_discard_fly_start_position(index, hand_size)
	var to_pos = human_discard_fly_target_position()
	play_tile_claim_burst(from_pos, Color(0.82, 0.64, 0.30), "打")
	play_tile_fly_animation(tile, from_pos, to_pos, 260, 52.0)
	# 弃牌落水溅射 - 落点处水花扩散 / Discard splash on landing
	call_deferred("play_discard_splash", to_pos, tile)
	# 墨溅效果 / Ink splash on discard
	call_deferred("_play_ink_splash_on_discard", to_pos, tile_accent(tile) if tile != "" else GOLD_PRIMARY)


func pending_claim_choice_source_position(from_seat: int) -> Vector2:
	if from_seat >= 0 and from_seat < 4:
		return rect_center_screen_position(seat_discard_rect(from_seat))
	return rect_center_screen_position(CENTER_PANEL_RECT)

func pending_claim_choice_target_position() -> Vector2:
	return rect_center_screen_position(fx_seat_screen_rect(0))

func play_pending_claim_choice_confirmation_fx(claim: String, from_seat: int, tile: String) -> Control:
	# r215: GPT chrome conversion
	if not fx_enabled_effective() or tile == "":
		return null
	ensure_fx_layer()
	var source_pos = pending_claim_choice_source_position(from_seat)
	var target_pos = pending_claim_choice_target_position()
	var is_pass = claim == "pass"
	var accent = Color(0.46, 0.50, 0.48) if is_pass else claim_color(claim)
	var label_text = "过" if is_pass else claim_label(claim)
	play_tile_claim_burst(target_pos, accent, label_text)
	var art = Control.new()
	art.name = "PendingClaimChoiceConfirmFx_%s" % claim
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	fx_layer.add_child(art)
	var delta = target_pos - source_pos
	var length = max(delta.length(), 1.0)
	var route = make_gpt_plate_rect(Rect2(source_pos, Vector2(length, 5.0)), Color(0.006, 0.016, 0.018, 0.48))
	route.name = "PendingClaimChoiceRoute_%s" % claim
	route.rotation = delta.angle()
	art.add_child(route)
	var fill_width = length * (0.48 if is_pass else 0.78)
	var route_fill = make_layout_host(Rect2(Vector2(4.0, 1.0), Vector2(fill_width, 3.0)))
	route_fill.name = "PendingClaimChoiceFill_%s" % claim
	route.add_child(route_fill)
	var source = make_gpt_plate_rect(Rect2(source_pos + Vector2(-12.0, -12.0), Vector2(24.0, 24.0)), Color(accent.r, accent.g, accent.b, 0.18), "ui_jade_reading_plate")
	source.name = "PendingClaimChoiceSource_%s" % claim
	art.add_child(source)
	var gate = make_gpt_gate(Rect2(target_pos + Vector2(-18.0, -14.0), Vector2(36.0, 28.0)), Color(accent.r, accent.g, accent.b, 0.20))
	gate.name = "PendingClaimChoiceGate_%s" % claim
	art.add_child(gate)
	var seal = make_gpt_gate(Rect2(target_pos + Vector2(18.0, -34.0), Vector2(38.0, 30.0)), Color(accent.r, accent.g, accent.b, 0.22))
	seal.name = "PendingClaimChoiceSeal_%s" % claim
	art.add_child(seal)
	var glyph = make_label(seal, label_text, 10, Color(0.98, 0.92, 0.66, 0.90), true)
	glyph.name = "PendingClaimChoiceGlyph_%s" % claim
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tile_badge = make_gpt_gate(Rect2(source_pos.lerp(target_pos, 0.62) + Vector2(-16.0, -22.0), Vector2(32.0, 30.0)), Color(0.018, 0.034, 0.036, 0.86))
	tile_badge.name = "PendingClaimChoiceTileBadge_%s" % claim
	art.add_child(tile_badge)
	var tile_glyph = make_label(tile_badge, tile_label(tile), 8, Color(0.98, 0.90, 0.66, 0.86), true)
	tile_glyph.name = "PendingClaimChoiceTileGlyph_%s" % claim
	apply_rect(tile_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_layout_host(Rect2(target_pos + Vector2(-32.0, 20.0), Vector2(64.0, 5.0)))
	archive_route.name = "PendingClaimChoiceArchiveRoute_%s" % claim
	art.add_child(archive_route)
	var archive_fill = make_layout_host(Rect2(Vector2(4.0, 1.0), Vector2(42.0 if is_pass else 54.0, 3.0)))
	archive_fill.name = "PendingClaimChoiceArchiveFill_%s" % claim
	archive_route.add_child(archive_fill)
	for i in range(3):
		var step = 0.240 + float(i) * 0.200
		var pos = source_pos.lerp(target_pos, step)
		var tick = make_layout_host(Rect2(pos + Vector2(-3.0, -10.0), Vector2(6.0, 20.0)))
		tick.name = "PendingClaimChoiceTick_%s_%d" % [claim, i]
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(Rect2(target_pos + Vector2(-26.0 + float(i) * 18.0, 30.0), Vector2(9.0, 9.0)), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.040))
		pip.name = "PendingClaimChoiceArchivePip_%s_%d" % [claim, i]
		art.add_child(pip)
	if DisplayServer.get_name().to_lower() != "headless":
		var art_id := art.get_instance_id()
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(route_fill, "scale:x", 1.0, 0.18).from(0.12).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.08, 1.08), 0.16).from(Vector2(0.82, 0.82)).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
		tw.tween_property(seal, "modulate:a", 1.0, 0.12).from(0.0)
		tw.set_parallel(false)
		tw.tween_property(art, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.30)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(art_id))
	return art


func play_human_action_choice_confirmation_fx(action: String, tile: String) -> Control:
	# r215: GPT chrome conversion
	if not fx_enabled_effective() or tile == "":
		return null
	ensure_fx_layer()
	var from_pos = human_discard_fly_start_position(max(0, players[0]["hand"].find(tile)), max(1, players[0]["hand"].size()))
	var to_pos = human_action_choice_target_position(action)
