func play_after_gang_replacement_draw_fx(seat: int, tile: String = "") -> Control:
	# r215: GPT chrome conversion
	if not fx_enabled_effective() or fx_burst_root == null or not is_instance_valid(fx_burst_root):
		return null
	var accent = SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else Color(0.62, 0.54, 0.88)
	var previous = fx_burst_root.find_child("AfterGangReplacementFx", false, false)
	if previous != null and is_instance_valid(previous):
		previous.queue_free()
	apply_rect(fx_burst_root, rect_full(0.18, 0.24, 0.82, 0.76))
	var art = Control.new()
	art.name = "AfterGangReplacementFx"
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	fx_burst_root.add_child(art)
	var wall_source = make_gpt_gate(rect_full(0.150, 0.405, 0.245, 0.610), Color(accent.r, accent.g, accent.b, 0.18))
	wall_source.name = "AfterGangReplacementWallSource"
	art.add_child(wall_source)
	var wall_glyph = make_label(wall_source, "墙", 9, Color(0.98, 0.92, 0.66, 0.86), true)
	wall_glyph.name = "AfterGangReplacementWallGlyph"
	apply_rect(wall_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var route = make_gpt_route_rail(rect_full(0.235, 0.480, 0.780, 0.550), Color(0.006, 0.016, 0.018, 0.50))
	route.name = "AfterGangReplacementRoute"
	art.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.250, 0.860, 0.750), Color(accent.r, accent.g, accent.b, 0.32))
	fill.name = "AfterGangReplacementFill"
	route.add_child(fill)
	var hand_gate = make_gpt_gate(rect_full(0.750, 0.410, 0.835, 0.625), Color(accent.r, accent.g, accent.b, 0.20))
	hand_gate.name = "AfterGangReplacementHandGate"
	art.add_child(hand_gate)
	var seal = make_gpt_gate(rect_full(0.640, 0.245, 0.765, 0.435), Color(0.92, 0.72, 0.34, 0.18))
	seal.name = "AfterGangReplacementSeal"
	art.add_child(seal)
	var glyph = make_label(seal, "补", 9, Color(0.98, 0.92, 0.66, 0.88), true)
	glyph.name = "AfterGangReplacementGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tile_node = make_gpt_gate(rect_full(0.468, 0.335, 0.532, 0.660), Color(accent.r, accent.g, accent.b, 0.18))
	tile_node.name = "AfterGangReplacementTileNode"
	art.add_child(tile_node)
	var replacement_tile_glyph = make_label(tile_node, tile_label(tile) if tile != "" else "牌", 7, Color(0.96, 0.92, 0.78, 0.82), true)
	replacement_tile_glyph.name = "AfterGangReplacementTileGlyph"
	apply_rect(replacement_tile_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var archive_route = make_gpt_route_rail(rect_full(0.535, 0.660, 0.805, 0.740), Color(0.006, 0.016, 0.018, 0.42))
	archive_route.name = "AfterGangReplacementArchiveRoute"
	art.add_child(archive_route)
	var archive_fill = make_gpt_meter_fill(rect_full(0.030, 0.250, 0.780, 0.750), Color(0.92, 0.72, 0.34, 0.24))
	archive_fill.name = "AfterGangReplacementArchiveFill"
	archive_route.add_child(archive_fill)
	var archive_gate = make_gpt_gate(rect_full(0.775, 0.600, 0.835, 0.795), Color(0.92, 0.72, 0.34, 0.18))
	archive_gate.name = "AfterGangReplacementArchiveGate"
	art.add_child(archive_gate)
	for i in range(3):
		var left = 0.335 + float(i) * 0.105
		var tick = make_layout_host(rect_full(left, 0.365, left + 0.018, 0.640))
		tick.name = "AfterGangReplacementTick_%d" % i
		art.add_child(tick)
	for i in range(2):
		var left = 0.610 + float(i) * 0.060
		var pip = make_gpt_gate(rect_full(left, 0.610, left + 0.022, 0.790), Color(0.92, 0.72, 0.34, 0.22 - float(i) * 0.040))
		pip.name = "AfterGangReplacementArchivePip_%d" % i
		art.add_child(pip)
	fx_burst_root.visible = true
	if DisplayServer.get_name().to_lower() != "headless":
		art.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(art, "modulate:a", 1.0, 0.08).from(0.0)
		tw.tween_property(fill, "anchor_right", 0.980, 0.22).from(0.060).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(tile_node, "scale", Vector2(1.10, 1.10), 0.14).from(Vector2(0.72, 0.72)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(art, "modulate:a", 0.0, 0.20).from(1.0).set_delay(0.34)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(art.get_instance_id()))
	return art


