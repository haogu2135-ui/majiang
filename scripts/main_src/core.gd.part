	apply_rect(tile_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var intercept = make_gpt_plate_rect(Rect2(source_pos.lerp(target_pos, 0.72) + Vector2(-10.0, -10.0), Vector2(20.0, 20.0)), Color(1.0, 0.70, 0.36, 0.22), "ui_jade_reading_plate")
	intercept.name = "RobGangWarningIntercept_%d_%d" % [gang_seat, winner_seat]
	art.add_child(intercept)
	var archive_route = make_gpt_plate_rect(Rect2(target_pos + Vector2(-36.0, 24.0), Vector2(72.0, 5.0)), Color(0.040, 0.010, 0.010, 0.42))
	archive_route.name = "RobGangWarningArchiveRoute_%d_%d" % [gang_seat, winner_seat]
	art.add_child(archive_route)
	var archive_fill = make_layout_host(Rect2(Vector2(4.0, 1.0), Vector2(58.0, 3.0)))
	archive_fill.name = "RobGangWarningArchiveFill_%d_%d" % [gang_seat, winner_seat]
	archive_route.add_child(archive_fill)
