	var gate = make_gpt_gate(Rect2(target_pos + Vector2(-20.0, -16.0), Vector2(40.0, 32.0)), Color(accent.r, accent.g, accent.b, 0.22))
	gate.name = "RobGangWarningWinGate_%d_%d" % [gang_seat, winner_seat]
	art.add_child(gate)
	var seal = make_gpt_gate(Rect2(target_pos + Vector2(22.0, -38.0), Vector2(46.0, 32.0)), Color(accent.r, accent.g, accent.b, 0.24))
	seal.name = "RobGangWarningSeal_%d_%d" % [gang_seat, winner_seat]
	art.add_child(seal)
	var glyph = make_label(seal, "抢杠", 9, Color(0.98, 0.92, 0.66, 0.92), true)
