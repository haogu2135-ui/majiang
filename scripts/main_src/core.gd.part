	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tile_badge = make_gpt_gate(Rect2(source_pos.lerp(target_pos, 0.56) + Vector2(-17.0, -24.0), Vector2(34.0, 30.0)), Color(0.018, 0.034, 0.036, 0.88))
	tile_badge.name = "RobGangWarningTileBadge_%d_%d" % [gang_seat, winner_seat]
	art.add_child(tile_badge)
	var tile_glyph = make_label(tile_badge, tile_label(tile), 8, Color(0.98, 0.90, 0.66, 0.88), true)
