	var glyph = make_label(seal, label_text, 9, Color(0.98, 0.92, 0.66, 0.90), true)
	glyph.name = "HumanActionChoiceGlyph_%s" % action
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tile_badge = make_gpt_gate(Rect2(from_pos.lerp(to_pos, 0.58) + Vector2(-17.0, -22.0), Vector2(34.0, 30.0)), Color(0.018, 0.034, 0.036, 0.86))
	tile_badge.name = "HumanActionChoiceTileBadge_%s" % action
	art.add_child(tile_badge)
	var tile_glyph = make_label(tile_badge, tile_label(tile), 8, Color(0.98, 0.90, 0.66, 0.86), true)
