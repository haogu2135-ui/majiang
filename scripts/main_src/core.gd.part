	for i in range(3):
		var pip = make_gpt_gate(Rect2(target_pos + Vector2(-30.0 + float(i) * 18.0, 35.0), Vector2(9.0, 9.0)), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.035))
		pip.name = "RobGangWarningPip_%d_%d_%d" % [gang_seat, winner_seat, i]
		art.add_child(pip)
	if DisplayServer.get_name().to_lower() != "headless":
