	glyph.name = "AIClaimChoiceGlyph_%d_%s" % [seat, claim]
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var seat_seal = make_gpt_gate(Rect2(target_pos + Vector2(-54.0, -30.0), Vector2(34.0, 26.0)), Color(SEAT_ACCENT_COLORS[seat].r, SEAT_ACCENT_COLORS[seat].g, SEAT_ACCENT_COLORS[seat].b, 0.18))
