	match title_text:
		"声音":
			return Color(0.42, 0.58, 0.72)
		"体验":
			return Color(0.72, 0.54, 0.32)  # r391 warm amber, not jade
		"系统":
			return Color(0.70, 0.48, 0.34)
	return Color(0.62, 0.54, 0.34)

func settings_section_icon(title_text: String) -> String:
	match title_text:
		"声音":
			return "volume-2"
		"体验":
			return "sparkles"
		"系统":
			return "settings"
	return "settings"


