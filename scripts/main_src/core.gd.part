	art.add_child(archive_route)
	var archive_fill = make_layout_host(Rect2(Vector2(4.0, 1.0), Vector2(52.0, 3.0)))
	archive_fill.name = "AIClaimChoiceArchiveFill_%d_%s" % [seat, claim]
	archive_route.add_child(archive_fill)
	for i in range(3):
		var step = 0.240 + float(i) * 0.200
		var pos = source_pos.lerp(target_pos, step)
		var tick = make_layout_host(Rect2(pos + Vector2(-3.0, -10.0), Vector2(6.0, 20.0)))
		tick.name = "AIClaimChoiceTick_%d_%s_%d" % [seat, claim, i]
		art.add_child(tick)
	for i in range(2):
		var pip = make_gpt_gate(Rect2(target_pos + Vector2(-26.0 + float(i) * 18.0, 32.0), Vector2(9.0, 9.0)), Color(accent.r, accent.g, accent.b, 0.22 - float(i) * 0.040))
		pip.name = "AIClaimChoiceArchivePip_%d_%s_%d" % [seat, claim, i]
		art.add_child(pip)
	if DisplayServer.get_name().to_lower() != "headless":
		var art_id := art.get_instance_id()
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(fill, "scale:x", 1.0, 0.18).from(0.12).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.08, 1.08), 0.16).from(Vector2(0.82, 0.82)).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
		tw.tween_property(seal, "modulate:a", 1.0, 0.12).from(0.0)
		tw.set_parallel(false)
		tw.tween_property(art, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.30)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(art_id))
	return art


func play_rob_gang_warning_fx(gang_seat: int, winner_seat: int, tile: String) -> Control:
	# r215: GPT chrome conversion
	if not fx_enabled_effective() or tile == "" or gang_seat < 0 or gang_seat >= 4 or winner_seat < 0 or winner_seat >= 4:
		return null
	ensure_fx_layer()
	var source_pos = rect_center_screen_position(seat_meld_rect(gang_seat))
	var target_pos = rect_center_screen_position(fx_seat_screen_rect(winner_seat))
	var accent = Color(0.82, 0.28, 0.22)
	var tile_color = tile_accent(tile)
	play_tile_claim_burst(target_pos, accent, "抢")
	var art = Control.new()
	art.name = "RobGangWarningFx_%d_%d" % [gang_seat, winner_seat]
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	art.set_anchors_preset(Control.PRESET_FULL_RECT)
	fx_layer.add_child(art)
	var delta = target_pos - source_pos
	var length = max(delta.length(), 1.0)
	var route = make_gpt_plate_rect(Rect2(source_pos, Vector2(length, 6.0)), Color(0.040, 0.010, 0.010, 0.54))
	route.name = "RobGangWarningRoute_%d_%d" % [gang_seat, winner_seat]
	route.rotation = delta.angle()
	art.add_child(route)
	var fill = make_layout_host(Rect2(Vector2(4.0, 1.0), Vector2(length * 0.820, 4.0)))
	fill.name = "RobGangWarningFill_%d_%d" % [gang_seat, winner_seat]
	route.add_child(fill)
	var source = make_gpt_plate_rect(Rect2(source_pos + Vector2(-16.0, -16.0), Vector2(32.0, 32.0)), Color(0.54, 0.20, 0.18, 0.24), "ui_jade_reading_plate")
	source.name = "RobGangWarningGangSource_%d_%d" % [gang_seat, winner_seat]
	art.add_child(source)
	var source_glyph = make_label(source, "杠", 10, Color(0.98, 0.86, 0.58, 0.88), true)
	source_glyph.name = "RobGangWarningGangGlyph_%d_%d" % [gang_seat, winner_seat]
