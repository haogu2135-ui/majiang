	seat_glyph.name = "AIClaimChoiceSeatGlyph_%d_%s" % [seat, claim]
	apply_rect(seat_glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	var tile_badge = make_gpt_gate(Rect2(source_pos.lerp(target_pos, 0.58) + Vector2(-16.0, -22.0), Vector2(32.0, 30.0)), Color(0.018, 0.034, 0.036, 0.86))
	tile_badge.name = "AIClaimChoiceTileBadge_%d_%s" % [seat, claim]
