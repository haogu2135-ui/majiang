		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(art.get_instance_id()))
	return art

# ============================================================
# Toast提示系统
# ============================================================


func _build_fx_toast() -> void:
	toast_container = Control.new()
	toast_container.name = "ToastContainer"
	toast_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	toast_container.set_anchors_preset(Control.PRESET_FULL_RECT)
	toast_container.visible = false
	fx_layer.add_child(toast_container)


func play_toast_entry_feedback(toast_bg: Control, accent: Color) -> Control:
	# r215: GPT chrome conversion
	if toast_bg == null or not is_instance_valid(toast_bg):
		return null
	var previous = toast_bg.find_child("ToastEntryFeedback", false, false)
	if previous != null and is_instance_valid(previous):
		previous.queue_free()
	var feedback = Control.new()
	feedback.name = "ToastEntryFeedback"
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback.set_anchors_preset(Control.PRESET_FULL_RECT)
	toast_bg.add_child(feedback)
	var source = make_gpt_edge_rail(rect_full(0.040, 0.255, 0.098, 0.745), Color(accent.r, accent.g, accent.b, 0.20))
	source.name = "ToastEntrySource"
	feedback.add_child(source)
	var route = make_gpt_route_rail(rect_full(0.105, 0.360, 0.795, 0.475), Color(0.006, 0.014, 0.016, 0.44))
	route.name = "ToastEntryRoute"
	feedback.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.025, 0.240, 0.780, 0.760), Color(accent.r, accent.g, accent.b, 0.30))
	fill.name = "ToastEntryFill"
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.770, 0.275, 0.830, 0.575), Color(accent.r, accent.g, accent.b, 0.22))
	gate.name = "ToastEntryGate"
	feedback.add_child(gate)
	var ack = make_gpt_edge_rail(rect_full(0.825, 0.440, 0.895, 0.720), Color(0.92, 0.72, 0.34, 0.14))
	ack.name = "ToastEntryAckNode"
	feedback.add_child(ack)
	var glyph = make_label(ack, "达", 8, Color(0.98, 0.92, 0.66, 0.82), true)
	glyph.name = "ToastEntryAckGlyph"
	apply_rect(glyph, rect_full(0.0, 0.0, 1.0, 1.0))
	for i in range(3):
		var left = 0.260 + float(i) * 0.130
		var tick = make_layout_host(rect_full(left, 0.250, left + 0.014, 0.545))
		tick.name = "ToastEntryTick_%d" % i
		feedback.add_child(tick)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.06).from(0.0)
		tw.tween_property(fill, "anchor_right", 0.980, 0.16).from(0.080).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.10, 1.10), 0.12).from(Vector2(0.84, 0.84)).set_ease(Tween.EASE_OUT)
		tw.tween_property(ack, "modulate:a", 1.0, 0.10).from(0.38)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.20).from(1.0).set_delay(0.12)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.88
	return feedback


func toast_is_reward_text(text: String) -> bool:
	return text.find("任务完成") >= 0 or text.find("购买成功") >= 0 or text.find("成就") >= 0 or text.find("金币") >= 0 or text.find("宝石") >= 0 or text.find("+") >= 0

func toast_is_chat_send_text(text: String) -> bool:
	return text.begins_with("已发送:")


func toast_item_effect_strength(item_id: String) -> float:
	match item_id:
		"swap_card":
			return 0.72
		"peek_card":
			return 0.62
		"lucky_charm":
			return 0.88
		"double_coins":
			return 1.0
	return 0.58

func toast_item_key_for_text(text: String) -> String:
	for item_id in ITEM_TYPES.keys():
		if text.find(item_display_name(str(item_id))) >= 0:
			return str(item_id)
	return ""

func item_short_mark(item_id: String) -> String:
	match item_id:
		"swap_card":
			return "换"
		"peek_card":
			return "看"
		"lucky_charm":
			return "运"
		"double_coins":
			return "倍"
	return "具"

func shop_item_identity_text(item_id: String) -> String:
	match item_id:
		"swap_card":
			return "换牌"
		"peek_card":
			return "窥牌"
		"lucky_charm":
			return "加运"
		"double_coins":
			return "金币"
	return "道具"

func toast_icon_name(text: String) -> String:
	if text.find("成就") >= 0:
		return "sparkles"
	if toast_is_chat_send_text(text):
		return "message-check"
	if toast_item_key_for_text(text) != "":
		return "gift"
	if text.find("成功") >= 0 or text.find("完成") >= 0:
		return "sparkles"
	if text.find("不足") >= 0 or text.find("失败") >= 0:
		return "triangle-alert"
	if text.find("更新") >= 0 or text.find("下载") >= 0:
		return "download"
	return "info"

func toast_accent_color(text: String) -> Color:
	if text.find("不足") >= 0 or text.find("失败") >= 0:
		return Color(0.86, 0.36, 0.26, 1.0)
	if text.find("成就") >= 0:
		return Color(0.92, 0.70, 0.30, 1.0)
	if toast_item_key_for_text(text) != "":
		return Color(0.62, 0.54, 0.86, 1.0)
	if text.find("成功") >= 0 or text.find("完成") >= 0:
		return Color(0.84, 0.68, 0.30, 1.0)
	return Color(0.40, 0.72, 0.58, 1.0)


func play_secondary_back_press_feedback(button: Button, screen_id: String, color: Color) -> void:
	# r215: GPT chrome conversion
	if button == null or not is_instance_valid(button):
		return
	var feedback = Control.new()
	feedback.name = "SecondaryBackPressFeedback_%s" % screen_id
	feedback.mouse_filter = Control.MOUSE_FILTER_IGNORE
	feedback.set_anchors_preset(Control.PRESET_FULL_RECT)
	button.add_child(feedback)
	var route = make_gpt_route_rail(rect_full(0.105, 0.620, 0.860, 0.725), Color(0.006, 0.016, 0.018, 0.46))
	route.name = "SecondaryBackPressRoute_%s" % screen_id
	feedback.add_child(route)
	var fill = make_gpt_meter_fill(rect_full(0.040, 0.250, 0.840, 0.750), Color(color.r, color.g, color.b, 0.34))
	fill.name = "SecondaryBackPressFill_%s" % screen_id
	route.add_child(fill)
	var gate = make_gpt_gate(rect_full(0.080, 0.545, 0.145, 0.820), Color(0.72, 0.84, 0.72, 0.24))
	gate.name = "SecondaryBackPressGate_%s" % screen_id
	feedback.add_child(gate)
	for i in range(3):
		var tick = make_gpt_tick_strip(rect_full(0.405 + float(i) * 0.080, 0.500, 0.430 + float(i) * 0.080, 0.690), Color(color.r, color.g, color.b, 0.24 - float(i) * 0.045))
		tick.name = "SecondaryBackPressTick_%s_%d" % [screen_id, i]
		feedback.add_child(tick)
	if fx_enabled_effective():
		feedback.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(feedback, "modulate:a", 1.0, 0.06).from(0.0)
		tw.tween_property(fill, "anchor_right", 0.980, 0.15).from(0.150).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(gate, "scale", Vector2(1.08, 1.08), 0.12).from(Vector2(0.86, 0.86)).set_ease(Tween.EASE_OUT)
		tw.set_parallel(false)
		tw.tween_property(feedback, "modulate:a", 0.0, 0.18).from(1.0).set_delay(0.06)
		tw.tween_callback(Callable(self, "queue_free_node_by_id").bind(feedback.get_instance_id()))
	else:
		feedback.modulate.a = 0.92


func current_status_text() -> String:
	if mode == "offline":
		if offline_phase == "ended":
			if is_offline_match_finished():
				return "全场结束"
			return round_summary if round_summary != "" else "牌局结束"
		if has_pending_danger_discard():
			return pending_danger_discard_text()
		if offline_phase == "pending_claim":
			return "等待你响应%s" % tile_label(str(offline_pending_claim.get("tile", "")))
		if wall.is_empty() and offline_turn_needs_draw:
			return "牌墙已空"
		if current_seat == 0:
			return "轮到你出牌"
		return "%s行牌" % players[current_seat]["name"]
	var phase = str(online_game.get("phase", ""))
	if online_feedback != "":
		return online_feedback
	if phase == "ended":
		return str(online_game.get("winnerText", "牌局结束"))
	if phase == "pendingClaim":
		return "等待吃碰杠胡响应"
	return "轮到你出牌" if can_self_discard() else "等待对家行牌"


# 顶部栏状态：以「事件」视角描述局势，避免与手牌托盘的「行动」提示重复同一句话。
func top_hud_status_text() -> String:
	if mode == "offline":
		if offline_phase == "pending_claim":
			var claim_seat = int(offline_pending_claim.get("from_seat", -1))
			var claim_tile = tile_label(str(offline_pending_claim.get("tile", "")))
			if claim_seat >= 0 and claim_seat < players.size():
				return "%s打出%s" % [players[claim_seat]["name"], claim_tile]
			return "响应%s" % claim_tile
		if offline_phase != "ended" and not (wall.is_empty() and offline_turn_needs_draw):
			var last_tile = get_last_discard()
			if last_tile != "":
				var last_seat = get_last_discard_seat()
				if last_seat >= 0 and last_seat < players.size():
					return "%s · 上张%s" % [current_status_text(), tile_label(last_tile)]
	return current_status_text()


func add_rule_section(parent: VBoxContainer, title_text: String, lines: Array, section_index: int = -1) -> void:
	# r215: GPT chrome conversion
	var section_colors = [
		Color(0.86, 0.62, 0.34),
		Color(0.38, 0.70, 0.58),
		Color(0.62, 0.56, 0.86),
		Color(0.38, 0.64, 0.82),
		Color(0.72, 0.48, 0.74),
		Color(0.86, 0.72, 0.38),
	]
	var accent = section_colors[clamp(section_index, 0, section_colors.size() - 1)] if section_index >= 0 else Color(0.62, 0.58, 0.42)
	# Keep the decorative texture behind the content. A TextureRect parent would
	# multiply its tint and alpha into the text, weakening the reading contrast.
	var section = make_layout_host(rect_full(0.0, 0.0, 1.0, 0.22))
	section.name = "RuleSection_%d" % section_index if section_index >= 0 else "RuleSection"
	parent.add_child(section)
	section.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var section_plate = make_gpt_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.345, 0.425, 0.355, 0.16), "ui_button_face_plate")
	section_plate.name = "RuleSectionPlate_%d" % section_index if section_index >= 0 else "RuleSectionPlate"
	section.add_child(section_plate)
	var line_count := int(lines.size())
	var required_text_height := 24.0 + float(line_count) * 22.0 + float(line_count) * 5.0 + 34.0
	section.custom_minimum_size.y = max(136.0, required_text_height)
	var section_depth = make_gpt_plate_rect(rect_full(0.006, 0.190, 0.994, 0.988), Color(0.0, 0.0, 0.0, 0.06), "ui_button_face_plate")
	section_depth.name = "RuleSection3DDepthEdge_%d" % section_index if section_index >= 0 else "RuleSection3DDepthEdge"
	section.add_child(section_depth)
	var section_top_rim = make_gpt_ribbon(rect_full(0.025, 0.018, 0.975, 0.070), Color(1.0, 0.90, 0.58, 0.042))
	section_top_rim.name = "RuleSection3DTopRim_%d" % section_index if section_index >= 0 else "RuleSection3DTopRim"
	section.add_child(section_top_rim)
	var example_plinth = make_gpt_edge_rail(rect_full(0.820, 0.080, 0.982, 0.920), Color(accent.r * 0.16, accent.g * 0.18, accent.b * 0.18, 0.62))
	example_plinth.name = "RuleSection3DExamplePlinth_%d" % section_index if section_index >= 0 else "RuleSection3DExamplePlinth"
	section.add_child(example_plinth)
	if section_index >= 0:
		var marker = make_gpt_gate(rect_full(0.012, 0.190, 0.022, 0.810), Color(accent.r, accent.g, accent.b, 0.42))
		marker.name = "RuleSectionMarker"
		section.add_child(marker)
		draw_rule_section_path_art(section, section_index, title_text)

	var text_backplate = make_gpt_plate_rect(rect_full(0.030, 0.030, 0.818 if section_index >= 0 else 0.970, 0.990), Color(0.205, 0.275, 0.230, 0.12), "ui_jade_reading_plate")
	text_backplate.name = "RuleSectionTextBackplate_%d" % section_index if section_index >= 0 else "RuleSectionTextBackplate"
	section.add_child(text_backplate)

	var vbox = VBoxContainer.new()
	vbox.anchor_left = 0.058
	vbox.anchor_top = 0.040
	vbox.anchor_right = 0.792 if section_index >= 0 else 0.96
	vbox.anchor_bottom = 0.970
	vbox.add_theme_constant_override("separation", 5)
	section.add_child(vbox)

	var title_label = make_label(vbox, title_text, 18, Color(1.00, 0.91, 0.60), true)
	title_label.name = "RuleSectionTitle_%d" % section_index if section_index >= 0 else "RuleSectionTitle"
	title_label.custom_minimum_size = Vector2(0, 24)
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(title_label)

	for line in lines:
		var line_label = make_label(vbox, str(line), 15, Color(0.94, 0.96, 0.88), false)
		line_label.name = "RuleSectionLine_%d" % section_index if section_index >= 0 else "RuleSectionLine"
		line_label.custom_minimum_size = Vector2(0, 22)
		line_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		configure_clipped_label(line_label)
		line_label.clip_contents = true


func add_stat_row(parent: VBoxContainer, label_text: String, value_text: String, row_height: float = 52.0) -> void:
	# r215: GPT chrome conversion
	var row = Panel.new()
	row.name = "StatsRow_%s" % label_text
	row.custom_minimum_size = Vector2(0, row_height)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var accent = stat_row_accent(label_text)
	row.add_theme_stylebox_override("panel", StyleBoxEmpty.new())  # GPT plates from draw_stat_row_art
	parent.add_child(row)
	var stats_row_plate = add_optional_gpt_illustration_texture(row, "ui_shop_row_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.72, false)
	if stats_row_plate == null:
		stats_row_plate = add_optional_gpt_illustration_texture(row, "ui_settings_section_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.70, false)
	if stats_row_plate != null:
		stats_row_plate.name = "StatsRowGptPlate"
		stats_row_plate.modulate = Color(
			clampf(0.45 + accent.r * 0.55, 0.20, 1.20),
			clampf(0.45 + accent.g * 0.55, 0.20, 1.20),
			clampf(0.45 + accent.b * 0.55, 0.20, 1.20),
			0.78
		)
	draw_stat_row_art(row, label_text, value_text)
	var value_plate = make_gpt_plate_rect(rect_full(0.545, 0.090, 0.955, 0.910), Color(0.10, 0.07, 0.05, 0.28), "ui_jade_reading_plate")
	value_plate.name = "StatsRowValuePanel_%s" % label_text
	row.add_child(value_plate)
	var value_sheen = make_layout_host(rect_full(0.035, 0.075, 0.965, 0.185))
	value_sheen.name = "StatsRowValueSheen_%s" % label_text
	value_plate.add_child(value_sheen)

	var compact_row := row_height < 48.0
	var label_font_size := 16 if compact_row else 18
	var value_font_size := 19 if compact_row else 21
	var label = make_label(row, label_text, label_font_size, Color(0.96, 0.92, 0.80), true)  # r392
	label.name = "StatsRowLabel_%s" % label_text
	apply_rect(label, rect_full(0.080, 0.120, 0.480, 0.880))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(label)

	var value = make_label(row, value_text, value_font_size, Color(1.00, 0.94, 0.68), true)
	value.name = "StatsRowValueLabel_%s" % label_text
	apply_rect(value, rect_full(0.575, 0.120, 0.925, 0.880))
	value.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(value)


func stat_row_accent(label_text: String) -> Color:
	match label_text:
		"总场次", "总手牌数":
			return Color(0.72, 0.58, 0.36, 1.0)  # r392 warm
		"胜场", "胜率":
			return Color(0.82, 0.62, 0.32, 1.0)  # r392 amber
		"累计净分", "单局最佳":
			return Color(0.86, 0.68, 0.34, 1.0)
	return Color(0.74, 0.60, 0.40, 1.0)

func stat_row_metric_fraction(label_text: String, value_text: String) -> float:
	var numeric = stat_row_numeric_value(value_text)
	match label_text:
		"胜率":
			return clamp(numeric / 100.0, 0.06, 1.0)
		"总场次":
			return clamp(numeric / 30.0, 0.06, 1.0)
		"胜场":
			return clamp(numeric / 20.0, 0.06, 1.0)
		"累计净分":
			return clamp(numeric / 30000.0, 0.06, 1.0)
		"单局最佳":
			return clamp(numeric / 12000.0, 0.06, 1.0)
		"总手牌数":
			return clamp(numeric / 80.0, 0.06, 1.0)
	return clamp(numeric / 100.0, 0.06, 1.0)

func stat_row_numeric_value(value_text: String) -> float:
	var cleaned = ""
	for i in range(value_text.length()):
		var ch = value_text.substr(i, 1)
		if (ch >= "0" and ch <= "9") or ch == ".":
			cleaned += ch
	if cleaned == "":
		return 0.0
	return float(cleaned)

