	schedule_ui_qa_page_ready("replay_import", ["ReplayImportPanel", "ReplayImportCodeInput", "ReplayImportButton", "ReplayImportTimeline"])


func replay_import_code_summary_text(value: String) -> String:
	var max_chars := REPLAY_SHARE_MAX_BYTES * 2
	var code := value.strip_edges()
	if code == "":
		return "回放码 0/%d 字符 · 等待粘贴" % max_chars
	if code.length() <= 16:
		return "回放码 %d/%d 字符 · 完整值" % [code.length(), max_chars]
	return "回放码 %d/%d 字符 · %s / %s" % [code.length(), max_chars, code.left(8), code.right(8)]


func set_replay_import_input_text(value: String) -> void:
	if replay_import_input == null or not is_instance_valid(replay_import_input):
		return
	replay_import_code_draft = value
	replay_import_input.text = value
	# LineEdit.text assignment is intentionally silent in Godot 4.4. Keep
	# programmatic archive/fixture loads on the same live summary path as typing.
	update_replay_import_input_feedback(replay_import_input)


func update_replay_import_input_feedback(input: LineEdit) -> void:
	if input == null or not is_instance_valid(input):
		return
	var summary := root_layer.find_child("ReplayImportCodeSummary", true, false) as Label if root_layer != null and is_instance_valid(root_layer) else null
	var code := input.text.strip_edges()
	mark_ui_optimization(input, "F-410")
	var max_chars := REPLAY_SHARE_MAX_BYTES * 2
	var detail := "当前已输入 %d 个字符，上限 %d" % [code.length(), max_chars]
	if code != "":
		detail += "；首尾摘要：%s / %s" % [code.left(8), code.right(8)] if code.length() > 16 else "；当前内容未超过摘要长度"
	if summary != null:
		set_dynamic_label_text(summary, replay_import_code_summary_text(input.text), detail)
	var status := root_layer.find_child("ReplayImportStatus", true, false) as Label if root_layer != null and is_instance_valid(root_layer) else null
	var import_button := root_layer.find_child("ReplayImportButton", true, false) as Button if root_layer != null and is_instance_valid(root_layer) else null
	var validation := ""
	var valid_shape := not code.is_empty() and code.length() <= max_chars and is_valid_replay_base64_shape(code)
	if code.is_empty():
		validation = "等待粘贴回放码"
	elif code.length() > max_chars:
		validation = "回放码过长 · 请删除多余字符"
	elif not is_valid_replay_base64_shape(code):
		validation = replay_import_shape_error_text(code)
	else:
		validation = "格式可用 · 点击导入进行完整校验"
	if status != null and replay_import_payload.is_empty():
		status.text = validation
		status.tooltip_text = validation
		status.set_meta("ui_full_text", validation)
		status.modulate = Color(0.96, 0.52, 0.38) if not valid_shape and not code.is_empty() else Color(0.76, 0.86, 0.76)
	if import_button != null:
		import_button.disabled = not valid_shape
		import_button.tooltip_text = "请输入有效格式的回放码后校验并导入" if not valid_shape else "校验并打开回放时间线"
		import_button.set_meta("replay_input_valid", valid_shape)
	var copy_code_button := root_layer.find_child("ReplayImportCopyCodeButton", true, false) as Button if root_layer != null and is_instance_valid(root_layer) else null
	if copy_code_button != null:
		copy_code_button.disabled = code == ""
		copy_code_button.tooltip_text = "复制输入框中的完整回放码，不使用首尾摘要" if code != "" else "输入回放码后可复制完整值"


func replay_import_shape_error_text(value: String) -> String:
	var code := value.strip_edges()
	if code.length() % 4 == 1:
		return "格式不正确 · 第%d个字符后长度无法组成 Base64" % code.length()
	var padding_start := code.length()
	for index in range(code.length()):
		var codepoint := code.unicode_at(index)
		var is_alphabet := (codepoint >= 65 and codepoint <= 90) or (codepoint >= 97 and codepoint <= 122) or (codepoint >= 48 and codepoint <= 57) or codepoint == 43 or codepoint == 47
		if codepoint == 61:
			if padding_start == code.length():
				padding_start = index
		elif padding_start != code.length() or not is_alphabet:
			return "格式不正确 · 第%d个字符不是 Base64 字符" % (index + 1)
	var padding_count := code.length() - padding_start
	if padding_count > 2:
		return "格式不正确 · 结尾最多允许两个补位字符"
	if padding_count > 0 and code.length() % 4 != 0:
		return "格式不正确 · 补位字符必须位于末尾"
	return "格式不正确 · 仅支持 Base64 字符"


func refresh_replay_archive_view() -> void:
	var pane := root_layer.find_child("ReplayArchivePane", true, false) as Control if root_layer != null and is_instance_valid(root_layer) else null
	if pane == null:
		return
	var search := pane.find_child("ReplayArchiveSearchInput", true, false) as LineEdit
	if search != null and search.text != replay_search_query:
		search.text = replay_search_query
	render_replay_archive_list()


func render_replay_archive_list() -> void:
	if root_layer == null or not is_instance_valid(root_layer):
		return
	var list := root_layer.find_child("ReplayArchiveList", true, false) as VBoxContainer
	var count := root_layer.find_child("ReplayArchiveCount", true, false) as Label
	if list == null:
		return
	var archive_scroll := root_layer.find_child("ReplayArchiveScroll", true, false) as ScrollContainer
	var previous_scroll_value := float(archive_scroll.scroll_vertical) if archive_scroll != null else -1.0
	var previous_focus_name := ""
	var focus_owner := get_viewport().gui_get_focus_owner()
	var archive_pane := root_layer.find_child("ReplayArchivePane", true, false) as Control
	if focus_owner != null and archive_pane != null and archive_pane.is_ancestor_of(focus_owner):
		previous_focus_name = str(focus_owner.name)
	for child in list.get_children():
		list.remove_child(child)
		child.queue_free()
	var entries := replay_archive_entries(replay_search_query)
	if count != null:
		set_ui_full_text(count, "本地归档共 %d 条" % entries.size(), "本地归档数量：%d 条" % entries.size())
		count.text = "%d 条" % entries.size()
	if entries.is_empty():
		var empty_text := "暂无本地归档 · 可从上方粘贴回放码" if replay_search_query == "" else "暂无匹配回放 · 可清空搜索"
		var empty := make_label(list, empty_text, 12, Color(0.62, 0.72, 0.68), false)
		empty.name = "ReplayArchiveEmpty"
		empty.custom_minimum_size = Vector2(0, 44)
		if previous_focus_name != "":
			previous_focus_name = "ReplayArchiveSearchInput"
		configure_button_focus_navigation(archive_pane, "", false)
		call_deferred("restore_replay_archive_view_state", previous_scroll_value, previous_focus_name)
		return
	for entry_variant in entries:
		if typeof(entry_variant) == TYPE_DICTIONARY:
			list.add_child(make_replay_archive_row(entry_variant as Dictionary))
	configure_button_focus_navigation(archive_pane, "", false)
	call_deferred("restore_replay_archive_view_state", previous_scroll_value, previous_focus_name)


func restore_replay_archive_view_state(scroll_value: float, focus_name: String) -> void:
	# Wait for the VBoxContainer and ScrollContainer to recalculate their ranges
	# before restoring the user's reading position after an archive refresh.
	await get_tree().process_frame
	if root_layer == null or not is_instance_valid(root_layer) or mode != "replay_import":
		return
	var archive_scroll := root_layer.find_child("ReplayArchiveScroll", true, false) as ScrollContainer
	if archive_scroll != null and scroll_value >= 0.0:
		var scrollbar := archive_scroll.get_v_scroll_bar()
		if scrollbar != null:
			var scroll_range := maxf(0.0, scrollbar.max_value - scrollbar.page)
			archive_scroll.scroll_vertical = int(round(clampf(scroll_value, 0.0, scroll_range)))
	if focus_name != "":
		var focus_target := root_layer.find_child(focus_name, true, false) as Control
		var focus_button := focus_target as Button if focus_target != null else null
		var focus_is_enabled := focus_button == null or not focus_button.disabled
		if focus_target != null and focus_target.visible and focus_is_enabled and focus_target.focus_mode != Control.FOCUS_NONE:
			focus_target.grab_focus()
		else:
			focus_named_control("ReplayArchiveSearchInput")


func make_replay_archive_row(entry: Dictionary) -> Control:
	var archive_id := str(entry.get("archive_id", ""))
	var row := Control.new()
	row.name = "ReplayArchiveRow_%s" % archive_id.left(12)
	# Keep metadata and a compact 44px action lane in one scan-friendly row. The
	# visible labels make favorite state discoverable without relying on a glyph.
	row.custom_minimum_size = Vector2(0, 84)
	row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var plate := make_gpt_plate_rect(rect_full(0.0, 0.0, 1.0, 1.0), Color(0.012, 0.026, 0.024, 0.44), "ui_button_face_plate")
	plate.name = "ReplayArchiveRowPlate"
	row.add_child(plate)
	var result_label := replay_archive_result_label(entry)
	var primary := make_label(row, replay_archive_display_date_text(entry), 11, Color(0.92, 0.88, 0.74), true)
	primary.name = "ReplayArchiveRowPrimary"
	apply_rect(primary, rect_full(0.035, 0.040, 0.520, 0.260))
	primary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(primary)
	primary.tooltip_text = replay_archive_date_text(entry)
	set_ui_full_text(primary, replay_archive_date_text(entry), "回放日期")
	var result := make_label(row, result_label, 11, Color(0.72, 0.90, 0.68), true)
	result.name = "ReplayArchiveRowResult"
	apply_rect(result, rect_full(0.520, 0.040, 0.965, 0.260))
	result.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(result)
	result.tooltip_text = result_label
	set_ui_full_text(result, result_label, "回放结果")
	var secondary := make_label(row, "%s · %s" % [rule_variant_short_label(str(entry.get("rule_variant", ""))), str(entry.get("replay_digest", "")).left(8).to_upper()], 10, Color(0.70, 0.80, 0.72), false)
	secondary.name = "ReplayArchiveRowSecondary"
	apply_rect(secondary, rect_full(0.035, 0.265, 0.965, 0.390))
	secondary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(secondary)
	set_ui_full_text(secondary, str(entry.get("rule_variant", "")) + " · " + str(entry.get("replay_digest", "")).to_upper(), "回放规则与摘要")
	var action_top := 0.435
	var action_bottom := 0.970
	var action_slot_width := 0.238
	var action_step := 0.245
	var is_favorite := bool(entry.get("favorite", false))
	var favorite := make_small_button("", Color(0.60, 0.48, 0.22) if is_favorite else Color(0.30, 0.48, 0.42), func() -> void:
		toggle_replay_archive_favorite(archive_id)
	)
	favorite.name = "ReplayArchiveFavoriteButton_%s" % archive_id.left(8)
	favorite.tooltip_text = "取消收藏" if is_favorite else "收藏此回放"
	favorite.set_meta("accessible_name", favorite.tooltip_text)
	favorite.custom_minimum_size = Vector2(58, UI_MIN_TOUCH_TARGET)
	favorite.add_theme_font_size_override("font_size", accessibility_font_size(11))
	apply_rect(favorite, rect_full(0.006, action_top, 0.006 + action_slot_width, action_bottom))
	row.add_child(favorite)
	add_lucide_icon(favorite, "star", rect_full(0.290, 0.220, 0.710, 0.780), Color(0.98, 0.88, 0.56) if is_favorite else Color(0.88, 0.94, 0.84))
	var open := make_small_button("", Color(0.34, 0.56, 0.52), func() -> void:
		open_replay_archive(archive_id)
	)
	open.name = "ReplayArchiveOpenButton_%s" % archive_id.left(8)
	open.tooltip_text = "打开这条已验证回放"
	open.custom_minimum_size = Vector2(52, UI_MIN_TOUCH_TARGET)
	open.add_theme_font_size_override("font_size", accessibility_font_size(12))
	apply_rect(open, rect_full(0.006 + action_step, action_top, 0.006 + action_step + action_slot_width, action_bottom))
	row.add_child(open)
	add_lucide_icon(open, "eye", rect_full(0.290, 0.220, 0.710, 0.780), Color(0.88, 0.96, 0.88))
	var copy := make_small_button("", Color(0.30, 0.52, 0.54), func() -> void:
		copy_replay_archive_share_code(archive_id)
	)
	copy.name = "ReplayArchiveCopyButton_%s" % archive_id.left(8)
	copy.tooltip_text = "复制已验证回放码"
	copy.custom_minimum_size = Vector2(58, UI_MIN_TOUCH_TARGET)
	copy.add_theme_font_size_override("font_size", accessibility_font_size(12))
	apply_rect(copy, rect_full(0.006 + action_step * 2.0, action_top, 0.006 + action_step * 2.0 + action_slot_width, action_bottom))
	row.add_child(copy)
	add_lucide_icon(copy, "copy", rect_full(0.290, 0.220, 0.710, 0.780), Color(0.88, 0.96, 0.92))
	var delete_confirming := replay_delete_confirming and replay_delete_target_id == archive_id
	var delete := make_small_button("确认" if delete_confirming else "删除", Color(0.76, 0.36, 0.24) if delete_confirming else Color(0.60, 0.32, 0.26), func() -> void:
		request_delete_replay_archive(archive_id)
	)
	delete.name = "ReplayArchiveDeleteButton_%s" % archive_id.left(8)
	delete.custom_minimum_size = Vector2(58, UI_MIN_TOUCH_TARGET)
	delete.add_theme_font_size_override("font_size", accessibility_font_size(11))
	delete.tooltip_text = "再次点击确认删除此回放" if delete_confirming else "删除此回放"
	delete.set_meta("delete_confirming", delete_confirming)
	apply_rect(delete, rect_full(0.006 + action_step * 3.0, action_top, 0.006 + action_step * 3.0 + action_slot_width, action_bottom))
	row.add_child(delete)
	if delete_confirming:
		# The row keeps its fixed height. The confirmation instruction owns the
		# metadata lane above the stable action targets, with Esc as a clear cancel.
		var confirm_label := make_label(row, "确认删除 · Esc取消", 10, Color(1.0, 0.78, 0.60), true)
		confirm_label.name = "ReplayArchiveDeleteConfirmLabel"
		apply_rect(confirm_label, rect_full(0.035, 0.285, 0.965, 0.420))
		confirm_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		confirm_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		confirm_label.tooltip_text = "再次点击“确认”删除这条回放；按 Esc 取消，不会删除"
		set_ui_full_text(confirm_label, confirm_label.text, confirm_label.tooltip_text)
		configure_clipped_label(confirm_label)
	return row


func open_replay_archive(archive_id: String) -> void:
	var entry := replay_archive_entry(archive_id)
	var payload := replay_archive_payload_from_entry(entry)
	if payload.is_empty():
		show_toast("该回放已损坏或不兼容")
		return
	replay_import_payload = payload.duplicate(true)
	var input := root_layer.find_child("ReplayImportCodeInput", true, false) as LineEdit
	var status := root_layer.find_child("ReplayImportStatus", true, false) as Label
	var empty := root_layer.find_child("ReplayImportTimelineEmpty", true, false) as Label
	if input != null:
		set_replay_import_input_text(replay_archive_share_code(archive_id))
	if status != null:
		status.text = "归档已打开 · 校验通过 · %d 条事件 · %s" % [(payload.get("events", []) as Array).size(), str(payload.get("digest", "")).left(12).to_upper()]
		status.modulate = Color(0.64, 0.90, 0.70)
	if empty != null:
		empty.visible = false
	var event_scroll := root_layer.find_child("ReplayImportTimelineScroll", true, false) as ScrollContainer
	if event_scroll != null:
		event_scroll.scroll_vertical = 0
		render_replay_timeline_events(payload, true)
		configure_replay_timeline_focus_navigation(true)
		update_replay_timeline_status(event_scroll)
	show_toast("已打开归档回放")


func replay_event_line_text(event: Dictionary) -> String:
	var kind := str(event.get("type", "事件"))
	var sequence := int(event.get("sequence", 0))
	var detail := ""
	var display_kind := replay_event_display_name(kind, event)
	if kind == "discard":
		detail = " · " + tile_label(str(event.get("tile", "")))
	elif kind == "draw" or kind == "draw_flower":
		detail = " · 座位%d" % int(event.get("seat", -1))
	elif kind == "claim":
		detail = " · " + claim_display_label(str(event.get("claim", "")))
	elif kind == "win":
		detail = " · " + str(event.get("points", 0)) + "分"
	return "%03d  %s%s" % [sequence, display_kind, detail]


func replay_import_event_text(payload: Dictionary) -> String:
	var events = payload.get("events", [])
	if typeof(events) != TYPE_ARRAY or (events as Array).is_empty():
		return "暂无事件"
	var lines: Array[String] = []
	for raw_event in events:
		if typeof(raw_event) == TYPE_DICTIONARY:
			lines.append(replay_event_line_text(raw_event as Dictionary))
	return "\n".join(lines)


func replay_event_display_name(kind: String, event: Dictionary = {}) -> String:
	match kind:
		"round_start":
			return "开局"
		"draw":
			return "摸牌"
		"draw_flower":
			return "补花"
		"discard":
			return "弃牌"
		"claim":
			var claim := claim_display_label(str(event.get("claim", "")))
			return "响应%s" % (claim if claim != "" else "动作")
		"win":
			return "胡牌"
		"wall_draw":
			return "荒庄"
	return "事件"


func render_replay_timeline_events(payload: Dictionary, focus_first: bool = false) -> void:
	if root_layer == null or not is_instance_valid(root_layer):
		return
	var event_list := root_layer.find_child("ReplayImportEventList", true, false) as VBoxContainer
	if event_list == null:
		return
	for child in event_list.get_children():
		event_list.remove_child(child)
		child.queue_free()
	var events_value = payload.get("events", [])
	var events: Array = events_value as Array if typeof(events_value) == TYPE_ARRAY else []
	if events.is_empty():
		replay_timeline_selected_index = -1
		configure_replay_timeline_focus_navigation(false)
		return
	for index in range(events.size()):
		if typeof(events[index]) != TYPE_DICTIONARY:
			continue
		var event: Dictionary = events[index] as Dictionary
		var event_text := replay_event_line_text(event)
		var selected_index := index
		var event_button := make_small_button(event_text, Color(0.28, 0.48, 0.42), Callable(self, "select_replay_timeline_event").bind(selected_index))
		event_button.name = "ReplayImportEventRow_%03d" % index
		event_button.custom_minimum_size = Vector2(0.0, 44.0)
		event_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		event_button.add_theme_font_size_override("font_size", accessibility_font_size(11))
		event_button.alignment = HORIZONTAL_ALIGNMENT_LEFT
		event_button.tooltip_text = "第%d条事件：%s · 点击选择，方向键逐条移动" % [index + 1, event_text]
		event_button.set_meta("timeline_event_index", index)
		event_button.set_meta("timeline_sequence", int(event.get("sequence", index + 1)))
		event_button.set_meta("accessible_name", "回放第%d条：%s" % [index + 1, event_text])
		event_button.set_meta("ui_full_text", event_text)
		mark_ui_optimization(event_button, "F-411")
		event_button.focus_entered.connect(func() -> void:
			set_replay_timeline_selection(selected_index, false)
		)
		event_list.add_child(event_button)
	event_list.custom_minimum_size = Vector2(0.0, maxf(44.0, float(event_list.get_child_count() * 47)))
	if replay_timeline_selected_index < 0 or replay_timeline_selected_index >= event_list.get_child_count():
		replay_timeline_selected_index = 0
	configure_replay_timeline_focus_navigation(focus_first)
	set_replay_timeline_selection(replay_timeline_selected_index, false)


func configure_replay_timeline_focus_navigation(focus_first: bool = false) -> void:
	if root_layer == null or not is_instance_valid(root_layer):
		return
	var event_list := root_layer.find_child("ReplayImportEventList", true, false) as VBoxContainer
	var input := root_layer.find_child("ReplayImportCodeInput", true, false) as LineEdit
	if event_list == null:
		return
	var rows: Array[Control] = []
	for child in event_list.get_children():
		var row := child as Control
		if row != null and row.focus_mode != Control.FOCUS_NONE and row.visible:
			rows.append(row)
	if rows.is_empty():
		return
	configure_ordered_focus_navigation(event_list, rows, "", false)
	for index in range(rows.size()):
		var previous: Control = input if index == 0 and input != null else rows[index - 1]
		var next: Control = input if index == rows.size() - 1 and input != null else rows[(index + 1) % rows.size()]
		rows[index].focus_previous = previous.get_path()
		rows[index].focus_next = next.get_path()
	if input != null:
		input.focus_next = rows[0].get_path()
		input.focus_neighbor_bottom = rows[0].get_path()
	if focus_first:
		call_deferred("focus_named_control", rows[0].name)


func set_replay_timeline_selection(index: int, ensure_visible: bool = false) -> void:
	if root_layer == null or not is_instance_valid(root_layer):
		return
	var event_list := root_layer.find_child("ReplayImportEventList", true, false) as VBoxContainer
	if event_list == null:
		return
	replay_timeline_selected_index = clampi(index, 0, maxi(0, event_list.get_child_count() - 1))
	for child_index in range(event_list.get_child_count()):
		var row := event_list.get_child(child_index) as Button
		if row == null:
			continue
		var selected := child_index == replay_timeline_selected_index
		row.set_meta("timeline_selected", selected)
		row.modulate = Color(1.08, 1.02, 0.78, 1.0) if selected else Color.WHITE
	if ensure_visible and replay_timeline_selected_index >= 0 and replay_timeline_selected_index < event_list.get_child_count():
		var event_scroll := root_layer.find_child("ReplayImportTimelineScroll", true, false) as ScrollContainer
		if event_scroll != null:
			event_scroll.ensure_control_visible(event_list.get_child(replay_timeline_selected_index) as Control)


func select_replay_timeline_event(index: int) -> void:
	set_replay_timeline_selection(index, true)
	var event_list := root_layer.find_child("ReplayImportEventList", true, false) as VBoxContainer if root_layer != null and is_instance_valid(root_layer) else null
	if event_list != null and index >= 0 and index < event_list.get_child_count():
		var selected_row := event_list.get_child(index) as Control
		if selected_row != null:
			selected_row.grab_focus()
	var event_scroll := root_layer.find_child("ReplayImportTimelineScroll", true, false) as ScrollContainer if root_layer != null and is_instance_valid(root_layer) else null
	if event_scroll != null:
		update_replay_timeline_status(event_scroll)


func update_replay_timeline_status(event_scroll: ScrollContainer) -> void:
	if event_scroll == null or not is_instance_valid(event_scroll):
		return
	var timeline := event_scroll.get_parent() as Control
	if timeline == null:
		return
	var status := timeline.find_child("ReplayImportTimelinePosition", true, false) as Label
	if status == null:
		return
	var events_value = replay_import_payload.get("events", [])
	if typeof(events_value) != TYPE_ARRAY or (events_value as Array).is_empty():
		status.text = "0 / 0 条事件"
		return
	var total := (events_value as Array).size()
	var scrollbar := event_scroll.get_v_scroll_bar()
	var event_list := event_scroll.find_child("ReplayImportEventList", true, false) as VBoxContainer
	var viewport_rect := event_scroll.get_global_rect()
	var first_event := total
	var last_event := 1
	if event_list != null:
		for child_index in range(event_list.get_child_count()):
			var row := event_list.get_child(child_index) as Control
			if row == null or not row.get_global_rect().intersects(viewport_rect, true):
				continue
			first_event = mini(first_event, child_index + 1)
			last_event = maxi(last_event, child_index + 1)
	if first_event > last_event:
		first_event = 1
		last_event = 1
	first_event = clampi(first_event, 1, total)
	last_event = clampi(maxi(first_event, last_event), first_event, total)
	# Manual scrolling changes the visible window, not the user's selected event.
	# Keep selection stable and report whether it is currently outside the window.
	if replay_timeline_selected_index < 0 or replay_timeline_selected_index >= total:
		replay_timeline_selected_index = first_event - 1
	var selected_event := clampi(replay_timeline_selected_index + 1, 1, total)
	status.text = "当前 %d · 显示 %d-%d / %d 条事件" % [selected_event, first_event, last_event, total]
	status.tooltip_text = "当前第%d条；可见第%d至%d条，共%d条事件" % [selected_event, first_event, last_event, total]
	event_scroll.set_meta("timeline_selected_visible", replay_timeline_selected_index >= first_event - 1 and replay_timeline_selected_index <= last_event - 1)
	event_scroll.set_meta("timeline_selected_index", replay_timeline_selected_index)
	mark_ui_optimization(event_scroll, "F-412")


func import_replay_from_input() -> void:
	var input := replay_import_input
	if input == null or not is_instance_valid(input):
		return
	var payload := import_round_replay_share_code(input.text)
	var status := root_layer.find_child("ReplayImportStatus", true, false) as Label
	var empty := root_layer.find_child("ReplayImportTimelineEmpty", true, false) as Label
	if payload.is_empty():
		replay_import_payload = {}
		render_replay_timeline_events(replay_import_payload, false)
		if status != null:
			status.text = "回放码无效或校验失败"
			status.modulate = Color(0.96, 0.48, 0.36)
		if empty != null:
			empty.visible = true
		return
	replay_import_payload = payload.duplicate(true)
	archive_imported_replay(payload)
	refresh_replay_archive_view()
	var events: Array = payload.get("events", [])
	var digest := str(payload.get("digest", ""))
	if status != null:
		status.text = "校验通过 · %d 条事件 · %s" % [events.size(), digest.left(12).to_upper()]
		status.modulate = Color(0.64, 0.90, 0.70)
	if empty != null:
		empty.visible = false
	var event_scroll := root_layer.find_child("ReplayImportTimelineScroll", true, false) as ScrollContainer
	if event_scroll != null:
		event_scroll.scroll_vertical = 0
		render_replay_timeline_events(payload, true)
		update_replay_timeline_status(event_scroll)

func toast_needs_minimum_dwell(text: String) -> bool:
	var normalized := text.to_lower()
	return normalized.contains("失败") or normalized.contains("错误") or normalized.contains("不足") or normalized.contains("无法") or normalized.contains("清除") or normalized.contains("清空") or normalized.contains("删除")


func show_toast(text: String, duration_msec: int = TOAST_DEFAULT_DURATION_MSEC) -> void:
	"""显示临时Toast提示"""
	if fx_layer == null or not is_instance_valid(fx_layer):
		return
	var safe_text := text.strip_edges().left(TOAST_MAX_TEXT_LENGTH)
	if safe_text == "":
		return
	duration_msec = clampi(duration_msec, 1, TOAST_MAX_DURATION_MSEC)
	if toast_container == null or not is_instance_valid(toast_container):
		_build_fx_toast()
	if toast_current != null and is_instance_valid(toast_current) and str(toast_current.get_meta("toast_text", "")) == safe_text:
		return
	var minimum_dwell := 2600 if toast_needs_minimum_dwell(safe_text) else 0
	if minimum_dwell > 0:
		duration_msec = maxi(duration_msec, minimum_dwell)
	if toast_current != null and is_instance_valid(toast_current):
		for queued in toast_queue:
			if typeof(queued) == TYPE_DICTIONARY and str((queued as Dictionary).get("text", "")) == safe_text:
				(queued as Dictionary)["duration_msec"] = maxi(int((queued as Dictionary).get("duration_msec", duration_msec)), duration_msec)
				return
		toast_queue.append({"text": safe_text, "duration_msec": duration_msec})
		while toast_queue.size() > 8:
			toast_queue.pop_front()
		return
	# 创建toast节点
	var toast_bg = Panel.new()
	toast_bg.name = "Toast"
	toast_bg.set_meta("toast_text", safe_text)
	toast_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var toast_left := 0.18
	var toast_right := 0.82
	toast_bg.anchor_left = toast_left
	toast_bg.anchor_right = toast_right
	var toast_top := 0.06
	var toast_bottom := 0.12
	# Keep menu notices out of the title and tutorial entry lanes. The first-run
	# banner is a real menu node rather than tutorial_panel, so reserve a separate
	# top slot whenever it is present.
	if mode == "menu":
		var menu_tutorial_banner := root_layer.find_child("MenuTutorialEntryBanner", true, false) if root_layer != null and is_instance_valid(root_layer) else null
		if menu_tutorial_banner != null and is_instance_valid(menu_tutorial_banner):
			# The banner occupies the left side below the title. Use the empty
			# upper-right header lane so the toast keeps its full touch-sized height.
			toast_left = 0.640
			toast_right = 0.980
			toast_bg.anchor_left = toast_left
			toast_bg.anchor_right = toast_right
			toast_top = 0.075
			toast_bottom = 0.160
		elif tutorial_panel == null or not is_instance_valid(tutorial_panel):
			toast_top = 0.190
			toast_bottom = 0.235
	if root_layer != null and is_instance_valid(root_layer):
		var modal_present := root_layer.find_child("DiagnosticDialogPanel", true, false) != null or root_layer.find_child("TelemetryDataSheetCard", true, false) != null or root_layer.find_child("ExitConfirmDialog", true, false) != null
		if modal_present:
			# Modal cards own the middle of the screen. Keep transient feedback in
			# the top safety band so it never masks a title, close action, or body.
			toast_top = 0.020
			toast_bottom = 0.070
	toast_bg.anchor_top = toast_top
	toast_bg.anchor_bottom = toast_bottom
	toast_bg.offset_left = 0
	toast_bg.offset_top = 0
	toast_bg.offset_right = 0
	# Keep two-line feedback inside a stable touch-sized lane even when the
	# top safety slot is only a few dozen pixels tall at 960x540.
	var anchor_height := effective_viewport_size().y * (toast_bottom - toast_top)
	toast_bg.offset_bottom = maxf(0.0, UI_MIN_TOUCH_TARGET - anchor_height)
	# Host style transparent; GPT toast banner is the visual face.
	var toast_host := StyleBoxEmpty.new()
	toast_host.set_content_margin_all(8)
	toast_bg.add_theme_stylebox_override("panel", toast_host)
	var toast_face = add_optional_gpt_illustration_texture(toast_bg, "toast_gpt_banner", rect_full(0.0, 0.0, 1.0, 1.0), 0.92, false)
	if toast_face == null:
		toast_face = add_optional_gpt_illustration_texture(toast_bg, "ui_button_face_plate", rect_full(0.0, 0.0, 1.0, 1.0), 0.88, false)
	if toast_face != null:
		toast_face.name = "ToastGptFacePlate"
		toast_bg.move_child(toast_face, 0)
	toast_bg.add_child(make_gpt_plate_rect(rect_full(0.0, 0.0, 0.018, 1.0), Color(0.90, 0.76, 0.36, 0.55), "ui_action_role_rail"))
	draw_toast_illustration(toast_bg, safe_text)
	var label = make_label(toast_bg, safe_text, 16, Color(0.96, 0.96, 0.92), true)
	apply_rect(label, rect_full(0.12, 0.04, 0.94, 0.96))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.clip_text = false
	label.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
	toast_bg.modulate = Color(1, 1, 1, 0)
	toast_bg.offset_top = -28.0
	toast_container.add_child(toast_bg)
	toast_container.visible = true
	toast_current = toast_bg
	toast_mode = mode
	toast_active_minimum_dwell_msec = minimum_dwell
	# 动画：弹跳滑入 → 停留 → 下滑淡出
	var slide_dur := float(TOAST_SLIDE_DURATION_MSEC) / 1000.0
	var stay_dur := float(maxi(duration_msec, toast_active_minimum_dwell_msec)) / 1000.0
	var fade_dur := 0.28
	var tw := create_screen_tween(true)
	toast_tween = tw
	if reduce_motion_enabled:
		# Reduced motion removes movement and fade, but keeps the message readable
		# for its full dwell time so feedback is not effectively skipped.
		toast_bg.modulate = Color(1.0, 1.0, 1.0, 1.0)
		toast_bg.offset_top = 0.0
		toast_bg.scale = Vector2.ONE
		tw.tween_interval(stay_dur)
		tw.tween_callback(Callable(self, "cleanup_toast_by_id").bind(toast_bg.get_instance_id(), toast_container.get_instance_id()))
		return
	# 入场 - 从上方弹出 + 缩放弹跳
	tw.tween_property(toast_bg, "modulate:a", 1.0, slide_dur).from(0.0)
	tw.parallel().tween_property(toast_bg, "offset_top", 0.0, slide_dur).from(-28.0).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.parallel().tween_property(toast_bg, "scale", Vector2(1.0, 1.0), slide_dur).from(Vector2(0.90, 0.90)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(toast_bg, "modulate:a", 0.0, fade_dur).set_delay(stay_dur)
	# 退出 - 下滑
	tw.parallel().tween_property(toast_bg, "offset_top", 14.0, fade_dur).set_delay(stay_dur)
	tw.tween_callback(Callable(self, "cleanup_toast_by_id").bind(toast_bg.get_instance_id(), toast_container.get_instance_id())).set_delay(stay_dur + fade_dur + 0.02)

func cleanup_toast_by_id(toast_id: int, container_id: int) -> void:
	var is_current := toast_current != null and is_instance_valid(toast_current) and toast_current.get_instance_id() == toast_id
	queue_free_node_by_id(toast_id)
	if not is_current:
		return
	var container = node_from_instance_id(container_id) as Control
	if container != null:
		container.visible = false
	toast_current = null
	toast_tween = null
	toast_mode = ""
	toast_active_minimum_dwell_msec = 0
	if not toast_queue.is_empty():
		var next_toast = toast_queue.pop_front()
		if typeof(next_toast) == TYPE_DICTIONARY:
			show_toast(str((next_toast as Dictionary).get("text", "")), int((next_toast as Dictionary).get("duration_msec", TOAST_DEFAULT_DURATION_MSEC)))

func dismiss_active_toast() -> void:
	if toast_tween != null and is_instance_valid(toast_tween):
		toast_tween.kill()
	toast_tween = null
	if toast_current != null and is_instance_valid(toast_current):
		toast_current.queue_free()
	toast_current = null
	if toast_container != null and is_instance_valid(toast_container):
		toast_container.visible = false
	toast_mode = ""
	toast_queue.clear()
	toast_active_minimum_dwell_msec = 0

func clear_toast_on_mode_change() -> void:
	if toast_mode != "" and toast_mode != mode:
		dismiss_active_toast()

func toggle_ai_assist_setting() -> void:
	ai_assist_enabled = not ai_assist_enabled
	save_settings()
	show_toast("出牌辅助已%s" % ("开启" if ai_assist_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_出牌辅助"
	refresh_current_screen()

func toggle_fast_mode_setting() -> void:
	fast_mode_enabled = not fast_mode_enabled
	save_settings()
	show_toast("快节奏模式已%s" % ("开启" if fast_mode_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_AI 节奏"
	refresh_current_screen()

func ai_difficulty_label(short: bool = false) -> String:
	var idx = clampi(ai_difficulty, AI_DIFFICULTY_EASY, AI_DIFFICULTY_HARD)
	var label = str(AI_DIFFICULTY_LABELS[idx]) if idx < AI_DIFFICULTY_LABELS.size() else "标准"
	return label if not short else label.substr(0, 1)

func cycle_ai_difficulty_setting() -> void:
	ai_difficulty = (clampi(ai_difficulty, AI_DIFFICULTY_EASY, AI_DIFFICULTY_HARD) + 1) % 3
	save_settings()
	show_toast("AI难度: %s" % ai_difficulty_label())
	settings_focus_restore_name = "SettingRowButton_AI 难度"
	refresh_current_screen()

func cycle_rule_variant_setting() -> void:
	var current_index := RULE_VARIANT_ORDER.find(normalized_rule_variant(rule_variant))
	if current_index < 0:
		current_index = RULE_VARIANT_ORDER.size() - 1
	rule_variant = str(RULE_VARIANT_ORDER[(current_index + 1) % RULE_VARIANT_ORDER.size()])
	save_settings()
	refresh_rule_variant_controls()
	show_toast("地方规则：%s · 下一局生效" % rule_variant_label(rule_variant))
	settings_focus_restore_name = "SettingsRuleVariantButton"
	refresh_current_screen()

func refresh_rule_variant_controls() -> void:
	var selector = find_child("SettingsRuleVariantButton", true, false) as Button
	if selector != null:
		selector.text = rule_variant_short_label()
		selector.tooltip_text = rule_variant_summary(rule_variant)
		selector.set_meta("setting_state", rule_variant_short_label())
	var status = find_child("SettingsRuleVariantStatus", true, false) as Label
	if status != null:
		status.text = rule_variant_activation_status_text()

func toggle_fx_setting() -> void:
	fx_enabled = not fx_enabled
	save_settings()
	if not fx_enabled:
		clear_fx_overlays()
	show_toast("桌面动效已%s" % ("开启" if fx_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_桌面特效"
	refresh_current_screen()

func cycle_accessibility_profile_setting() -> void:
	var current := accessibility_profile_label()
	var next := "标准"
	match current:
		"标准":
			next = "大字"
			large_text_enabled = true
			high_contrast_enabled = false
			reduce_motion_enabled = false
		"大字":
			next = "高对比"
			large_text_enabled = false
			high_contrast_enabled = true
			reduce_motion_enabled = false
		"高对比":
			next = "减动效"
			large_text_enabled = false
			high_contrast_enabled = false
			reduce_motion_enabled = true
		"减动效":
			next = "专注"
			large_text_enabled = true
			high_contrast_enabled = true
			reduce_motion_enabled = true
		"专注":
			next = "清晰"
			large_text_enabled = true
			high_contrast_enabled = true
			reduce_motion_enabled = false
		"清晰":
			next = "标准"
			large_text_enabled = false
			high_contrast_enabled = false
			reduce_motion_enabled = false
		_:
			large_text_enabled = false
			high_contrast_enabled = false
			reduce_motion_enabled = false
	settings_focus_restore_name = "SettingRowButton_阅读辅助"
	save_settings()
	if reduce_motion_enabled:
		stop_ambient_animation()
	show_toast("阅读辅助：%s" % next)
	refresh_current_screen()

func graphics_quality_label(short: bool = false) -> String:
	match graphics_quality:
		Commercial3DStage.QUALITY_LOW:
			return "省电" if short else "省电模式"
		Commercial3DStage.QUALITY_STANDARD:
			return "标准"
		Commercial3DStage.QUALITY_HIGH:
			return "精细"
		_:
			return "自动"

func cycle_graphics_quality_setting() -> void:
	graphics_quality += 1
	if graphics_quality > Commercial3DStage.QUALITY_HIGH:
		graphics_quality = Commercial3DStage.QUALITY_AUTO
	save_settings()
	show_toast("画面质量已切换为%s" % graphics_quality_label())
	settings_focus_restore_name = "SettingRowButton_画面质量"
	refresh_current_screen()

func toggle_music_setting() -> void:
	music_enabled = not music_enabled
	apply_audio_settings()
	save_settings()
	show_toast("背景音乐已%s" % ("开启" if music_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_背景音乐"
	refresh_current_screen()

func toggle_settings_panel() -> void:
	settings_panel_open = not settings_panel_open
	emit_ui_qa_marker("settings|%s" % ("open" if settings_panel_open else "closed"))
	reset_progress_confirming = false
	reset_progress_confirm_deadline_msec = 0
	if settings_panel_open:
		settings_focus_restore_name = ""
	refresh_current_screen()

func toggle_sfx_setting() -> void:
	sfx_enabled = not sfx_enabled
	save_settings()
	show_toast("操作音效已%s" % ("开启" if sfx_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_音效反馈"
	refresh_current_screen()

func toggle_tts_setting() -> void:
	tts_enabled = not tts_enabled
	save_settings()
	show_toast("语音播报已%s" % ("开启" if tts_enabled else "关闭"))
	settings_focus_restore_name = "SettingRowButton_语音报牌"
	refresh_current_screen()

func toggle_voice_chat() -> void:
	if mode != "online_game" and mode != "online_lobby":
		set_status("语音需要进入联机房间后使用。")
		return
	if tcp.get_status() != StreamPeerTCP.STATUS_CONNECTED:
		set_status("语音需要先连接服务器。")
		return
	if voice_enabled:
		stop_voice_chat(true)
	else:
		start_voice_chat()
	if mode == "online_game":
		render_game()
	else:
		refresh_current_screen()

func update_manifest_detail_text() -> String:
	var parts: Array[String] = []
	if update_remote_size > 0:
		parts.append(format_bytes(update_remote_size))
	if update_remote_sha256 != "":
		parts.append("SHA-256 " + update_remote_sha256.substr(0, 12))
	if parts.is_empty():
		return ""
	return "\n" + "  ".join(parts)
