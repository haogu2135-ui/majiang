func tile_hint_badge_color(hint_badge: String) -> Color:
	return HINT_BADGE_COLORS.get(hint_badge, DEFAULT_HINT_BADGE_COLOR)

func should_use_lightweight_static_tile(clickable: bool, size: Vector2) -> bool:
	return not clickable and size.x < 56.0  # r431 more river faces use compact porcelain body

func static_tile_shadow_size(size: Vector2) -> int:
	if size.x < 50.0:
		return 0
	if size.x < 60.0:
		return 3
	return 8

func tile_art_alpha(tile: String, size: Vector2) -> float:
	# Authored assets/tiles already carry their intended alpha. Preserve it at
	# every size so compact rivers do not lose ink density at runtime.
	return 1.0

func tile_texture_bleed(size: Vector2, lightweight_static_tile: bool) -> Vector2:
	# r453: keep compact river faces close to their authored porcelain edge while
	# leaving a small dark gutter between adjacent grid cells. The same bounded
	# expansion is used by hand cells so a large face cannot bleed into its hit
	# neighbor; assets/tiles remain untouched.
	var expand_ratio := 0.118
	if lightweight_static_tile:
		expand_ratio = 0.090 if size.x >= 52.0 else 0.070
	var expand := Vector2(max(1.5, size.x * expand_ratio), max(1.5, size.y * expand_ratio))
	return expand

