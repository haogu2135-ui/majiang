	var fill = make_gpt_meter_fill(rect_full(0.035, 0.245, fill_right, 0.755), Color(accent.r, accent.g, accent.b, 0.34 if active else 0.20))
	fill.name = "VoiceButtonPressFill"
	route.add_child(fill)
