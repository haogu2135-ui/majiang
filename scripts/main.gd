func play_fx_win_burst_enhanced(text: String, color: Color, win_type: String = "normal", force_ephemeral_art: bool = false) -> void:
	# Create ripple ring effect for win celebration
	if ui_enhancements != null and is_instance_valid(ui_enhancements) and fx_enabled_effective() and (force_ephemeral_art or DisplayServer.get_name().to_lower() != "headless"):
		var center = get_viewport().size * 0.5
		for ring_i in range(3):
			var ring_colors = [
				Color(1.0, 0.88, 0.44, 0.7),
				Color(0.76, 0.90, 0.96, 0.5),
				Color(0.92, 0.78, 0.36, 0.6),
			]
			ui_enhancements.create_ripple_ring(fx_layer, center, ring_colors[ring_i % ring_colors.size()], 2)

		# Light beam effect - radiating beams from center
		for beam_i in range(6):
			var beam_angle = float(beam_i) * TAU / 6.0 + randf_range(-0.15, 0.15)
			var beam = make_gpt_plate_rect(Rect2(center, Vector2(3.0, 1.0)), Color(1.0, 0.92, 0.56, 0.0), "ui_soft_flash")
			beam.name = "WinLightBeam_%d" % beam_i
			beam.mouse_filter = Control.MOUSE_FILTER_IGNORE
			beam.pivot_offset = Vector2(0, 0)
			beam.rotation = beam_angle
			beam.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_KEEP_SIZE, 0)
			beam.position = center
			beam.size = Vector2(3.0, 0.0)
			fx_layer.add_child(beam)
			var beam_tw := create_screen_tween()
			beam_tw.tween_property(beam, "size:y", randf_range(160.0, 280.0), 0.5).from(0.0).set_delay(randf_range(0.0, 0.2)).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			beam_tw.parallel().tween_property(beam, "modulate:a", randf_range(0.15, 0.30), 0.3).from(0.0).set_delay(randf_range(0.0, 0.15))
			beam_tw.tween_property(beam, "modulate:a", 0.0, 0.4).set_delay(0.5)
			var beam_id := beam.get_instance_id()
			beam_tw.tween_callback(func() -> void:
				var beam_node := instance_from_id(beam_id) as Node
				if beam_node != null:
					beam_node.queue_free()
			).set_delay(1.0)

		# Floating golden sparkle rain around center
		var spark_count = 24
		for si in range(spark_count):
			var s_size = randf_range(2.0, 5.0)
			var sx = center.x + randf_range(-200.0, 200.0)
			var sy = center.y + randf_range(-120.0, 100.0)
			var spark = make_gpt_plate_rect(Rect2(Vector2(sx, sy), Vector2(s_size, s_size)), Color(1.0, 0.9, 0.5, randf_range(0.5, 0.9)), "ui_soft_flash")
			spark.name = "WinSparkRain_%d" % si
			spark.mouse_filter = Control.MOUSE_FILTER_IGNORE
			fx_layer.add_child(spark)
			var s_tw := create_screen_tween()
			s_tw.tween_property(spark, "position:y", sy - randf_range(40.0, 100.0), randf_range(1.0, 2.0)).set_delay(randf_range(0.0, 0.6)).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			s_tw.parallel().tween_property(spark, "modulate:a", 0.0, randf_range(0.8, 1.5)).set_delay(randf_range(0.2, 0.8))
			var spark_id := spark.get_instance_id()
			s_tw.tween_callback(func() -> void:
				var spark_node := instance_from_id(spark_id) as Node
				if spark_node != null:
					spark_node.queue_free()
			).set_delay(2.5)

	"""增强版胜利特效 - 带粒子、光效、震动"""
	if not fx_enabled_effective() or fx_burst_root == null or not is_instance_valid(fx_burst_root):
		return

	if fx_burst_tween != null and is_instance_valid(fx_burst_tween):
		fx_burst_tween.kill()
	clear_win_burst_dynamic_art()

	apply_rect(fx_burst_root, rect_full(0.18, 0.24, 0.82, 0.76))

	# 根据胜利类型调整效果参数
	var particle_count := FX_WIN_PARTICLE_COUNT
	var duration := FX_WIN_DURATION_ENHANCED_MSEC
	var flash_intensity := 0.12

	match win_type:
		"self_draw":
			particle_count = int(particle_count * 1.5)
			duration = int(duration * 1.3)
			flash_intensity = 0.18
		"special":
			particle_count = int(particle_count * 2.2)
			duration = int(duration * 1.6)
			flash_intensity = 0.25

	# 背景闪烁
	fx_burst_flash.modulate = Color(color.r, color.g, color.b, 0.0)

	# 创建粒子系统（使用Control节点模拟）
	var particles_root = Control.new()
	particles_root.name = "WinParticles"
	particles_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	particles_root.set_anchors_preset(Control.PRESET_FULL_RECT)
	fx_burst_root.add_child(particles_root)

	# 生成粒子 (原有粒子系统保留)
	var particles: Array[Control] = []
	for i in range(particle_count):
		var particle = _create_win_particle(color, i, particle_count)
		particles_root.add_child(particle)
		particles.append(particle)

	# 调用新增强粒子系统
	if ui_enhancements != null and ui_enhancements is UIEnhancements:
		var theme_color = "gold"
		if win_type == "self_draw":
			theme_color = "jade"
		elif win_type == "special":
			theme_color = "cinnabar"
		ui_enhancements.create_enhanced_particle_burst(fx_burst_root, Vector2(fx_burst_root.size.x * 0.5, fx_burst_root.size.y * 0.5), theme_color, particle_count, 180.0)

	# 配置原有圆环 - 增强扩散效果
	for ring in fx_burst_rings:
		ring.modulate.a = 0.0
		ensure_fx_ring_gpt_plate(ring, color, 0.48)
		ring.offset_left = -42.0
		ring.offset_top = -42.0
		ring.offset_right = 42.0
		ring.offset_bottom = 42.0

	# 设置标签 - 增强文字效果
	fx_burst_label.text = text
	fx_burst_label.add_theme_color_override("font_color", color.lightened(0.30))
	fx_burst_label.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.85))
	fx_burst_label.modulate.a = 0.0
	fx_burst_label.offset_top = 28.0
	fx_burst_label.offset_bottom = 28.0

	# 添加印章装饰 - 增强印章效果
	var seal_text = "胡" if win_type != "self_draw" else "摸"
	var seal = make_seal_stamp(fx_burst_root, rect_full(0.42, 0.62, 0.58, 0.82), seal_text, "square")
	seal.name = "WinCelebrationSeal"
	seal.modulate.a = 0.0
	seal.scale = Vector2(0.4, 0.4)
	var celebration_win_type = "draw_game" if text == "荒庄" else win_type
	var celebration_art = draw_win_celebration_art(fx_burst_root, color, celebration_win_type)

	fx_burst_root.visible = true

	var half := float(duration) / 2000.0

	# 创建主动画
	var tw := create_screen_tween()
	fx_burst_tween = tw
	tw.set_parallel(true)

	# 背景闪烁动画
	tw.tween_property(fx_burst_flash, "modulate:a", flash_intensity, 0.18).from(0.0)
	tw.tween_property(fx_burst_flash, "modulate:a", 0.0, 0.65).set_delay(max(0.0, half - 0.65))

	# 标签动画
	tw.tween_property(fx_burst_label, "modulate:a", 1.0, 0.22).from(0.0)
	tw.tween_property(fx_burst_label, "modulate:a", 0.0, 0.55).set_delay(max(0.0, half - 0.55))
	tw.tween_property(fx_burst_label, "offset_top", -16.0, half).from(28.0)
	tw.tween_property(fx_burst_label, "offset_bottom", -16.0, half).from(28.0)

	# 印章动画 - 更强的弹出效果
	tw.tween_property(seal, "modulate:a", 1.0, 0.32).from(0.0).set_delay(0.12)
	tw.tween_property(seal, "scale", Vector2(1.15, 1.15), 0.32).from(Vector2(0.4, 0.4)).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK).set_delay(0.12)
	tw.tween_property(seal, "scale", Vector2(1.0, 1.0), 0.15).from(Vector2(1.15, 1.15)).set_delay(0.44)
	tw.tween_property(seal, "modulate:a", 0.0, 0.40).set_delay(half - 0.15)

	# 圆环扩散动画 - 更大的扩散范围和更强的效果
	for i in range(fx_burst_rings.size()):
		var ring = fx_burst_rings[i]
		var delay = float(i) * 0.08
		var span = max(0.35, half - delay)
		tw.tween_property(ring, "modulate:a", 0.0, span).from(0.85).set_delay(delay)
		tw.tween_property(ring, "offset_left", -280.0, span).from(-42.0).set_delay(delay)
		tw.tween_property(ring, "offset_top", -280.0, span).from(-42.0).set_delay(delay)
		tw.tween_property(ring, "offset_right", 280.0, span).from(42.0).set_delay(delay)
		tw.tween_property(ring, "offset_bottom", 280.0, span).from(42.0).set_delay(delay)

	# 粒子动画
	for i in range(particles.size()):
		var particle = particles[i]
		var delay = fmod(float(i) * 0.015, 0.4)
		_animate_win_particle(particle, tw, delay, half)

	# 屏幕震动效果
	_play_screen_shake(FX_WIN_SHAKE_AMPLITUDE, FX_WIN_SHAKE_FREQUENCY, 0.25)

	# 金雨特效
	_play_golden_rain(fx_burst_root, half * 2.0, 1.0 if win_type == "normal" else 1.5)

	# 书法笔触揭示
	var calligraphy = _play_calligraphy_reveal(fx_burst_root, text, color.lightened(0.2), Rect2(fx_burst_root.size * Vector2(0.2, 0.08), fx_burst_root.size * Vector2(0.6, 0.18)))

	# 结束清理
	tw.tween_callback(func() -> void:
		_hide_fx_burst()
		if particles_root != null and is_instance_valid(particles_root):
			particles_root.queue_free()
		if seal != null and is_instance_valid(seal):
			seal.queue_free()
		if celebration_art != null and is_instance_valid(celebration_art):
			celebration_art.queue_free()
		if calligraphy != null and is_instance_valid(calligraphy):
			calligraphy.queue_free()
	).set_delay(half + 0.05)

