func shutdown_runtime_tweens() -> void:
	var tree := get_tree()
	if tree == null:
		return
	for candidate in tree.get_processed_tweens():
		var tween := candidate as Tween
		if tween != null and is_instance_valid(tween):
			tween.kill()


func queue_free_runtime_node(node: Node) -> void:
	if node == null or not is_instance_valid(node) or node.is_queued_for_deletion():
		return
	node.queue_free()


func shutdown_runtime_audio() -> void:
	shutdown_android_tts()
	stop_current_speech()
	speech_queue_generation += 1
	speech_queue.clear()
	if speech_delay_timer != null and is_instance_valid(speech_delay_timer):
		speech_delay_timer.stop()
		speech_delay_timer.timeout.emit()
		if is_instance_valid(speech_delay_timer) and not speech_delay_timer.is_queued_for_deletion():
			speech_delay_timer.queue_free()
	speech_delay_timer = null
	speech_queue_active = false
	var players: Array[AudioStreamPlayer] = []
	for candidate in [bgm_player, sfx_player, action_sfx_player, voice_mic_player]:
		var player := candidate as AudioStreamPlayer
		if player != null and is_instance_valid(player):
			players.append(player)
	if audio_layer != null and is_instance_valid(audio_layer):
		for child in audio_layer.get_children():
			var one_shot := child as AudioStreamPlayer
			if one_shot != null and not players.has(one_shot):
				players.append(one_shot)
	for player in players:
		player.stop()
		player.stream = null
	voice_capture_effect = null
	audio_streams.clear()
	voice_streams.clear()
	bgm_player = null
	sfx_player = null
	action_sfx_player = null
	voice_mic_player = null

func apply_audio_settings() -> void:
