	var has_number = false
	var has_honor = false
	for tile in all_scoring_tiles(seat, tiles):
		var code = str(tile)
		if is_honor_tile(code):
			has_honor = true
			continue
		has_number = true
		var current = code.right(1)
		if suit == "":
			suit = current
		elif suit != current:
			return false
	return has_number and has_honor

