func wall_meter_color(progress: float) -> Color:
	# r427: warm lacquer meter only — never mint/jade green on battle chrome.
	if progress <= 0.18:
		return Color(0.90, 0.40, 0.24, 1.0)
	if progress <= 0.42:
		return Color(0.86, 0.66, 0.30, 1.0)
