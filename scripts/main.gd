func _call_ui_enhancement(method_name: String, arg1 = null, arg2 = null, arg3 = null) -> Variant:
	if ui_enhancements == null or not is_instance_valid(ui_enhancements):
		return null
	if not ui_enhancements.has_method(method_name):
		return null
	if ambient_layer == null or not is_instance_valid(ambient_layer):
		return null
	var args: Array = [ambient_layer]
	if arg1 != null:
		args.append(arg1)
	if arg2 != null:
		args.append(arg2)
	if arg3 != null:
		args.append(arg3)
	return ui_enhancements.callv(method_name, args)

func start_ambient_animation(theme: String = "default", force_headless: bool = false) -> void:
	"""启动环境氛围动画 - 支持四季自动主题"""
	if not ui_motion_enabled() or (DisplayServer.get_name().to_lower() == "headless" and not force_headless):
		return

	stop_ambient_animation()

	ambient_layer = Control.new()
	ambient_layer.name = "AmbientLayer"
	ambient_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ambient_layer.z_index = -1
	ambient_layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(ambient_layer)

	# 四季自动主题 - 根据月份选择
	var resolved_theme: String = theme
	if theme == "default":
		var month: int = int(Time.get_datetime_dict_from_system().get("month", 1))
		match month:
			3, 4, 5:
				resolved_theme = "spring"
			6, 7, 8:
				resolved_theme = "summer"
			9, 10, 11:
				resolved_theme = "autumn"
			12, 1, 2:
				resolved_theme = "winter"
			_:
				resolved_theme = "default"

	# 应用时间色温
	var time_tint := _apply_time_color_temperature()
	if ambient_layer != null:
		ambient_layer.modulate = time_tint

	match resolved_theme:
		"spring":
			_start_petal_fall()
			_start_depth_layered_dust()
			_call_ui_enhancement("create_falling_plum_blossoms", ambient_layer.get_rect() if ambient_layer != null else Rect2(Vector2.ZERO, get_viewport().size))
			if ui_enhancements != null and is_instance_valid(ui_enhancements) and ambient_layer != null and is_instance_valid(ambient_layer):
				ui_enhancements.create_gold_dust(ambient_layer, ambient_layer.get_rect(), 4)
		"summer":
			_start_firefly_particles()
			_start_depth_layered_dust()
			_call_ui_enhancement("create_floating_cloud", Rect2(Vector2.ZERO, get_viewport().size), 20.0)
		"autumn":
			_start_leaf_fall()
			_start_depth_layered_dust()
		"festival":
			_start_firework_particles()
			_start_depth_layered_dust()
			if ui_enhancements != null and is_instance_valid(ui_enhancements) and ambient_layer != null and is_instance_valid(ambient_layer):
				ui_enhancements.create_gold_dust(ambient_layer, ambient_layer.get_rect(), 6)
		"winter":
			_start_snow_fall()
			_start_depth_layered_dust()
		_:
			_start_default_ambient()
			_start_depth_layered_dust()
			_call_ui_enhancement("create_floating_cloud", Rect2(Vector2.ZERO, get_viewport().size), 15.0)

func stop_ambient_animation() -> void:
	"""停止环境氛围动画"""
	if ambient_tween != null and is_instance_valid(ambient_tween):
		ambient_tween.kill()

	for petal in ambient_petals:
		if petal != null and is_instance_valid(petal):
			petal.queue_free()
	ambient_petals.clear()

	for cloud in ambient_clouds:
		if cloud != null and is_instance_valid(cloud):
			cloud.queue_free()
	ambient_clouds.clear()

	for particle in ambient_particles:
		if particle != null and is_instance_valid(particle):
			particle.queue_free()
	ambient_particles.clear()

	if ambient_layer != null and is_instance_valid(ambient_layer):
		ambient_layer.queue_free()
	ambient_layer = null

