func draw_win_detail_yaku_track(parent: Control, reasons: Array) -> Control:
	# r214: bulk GPT chrome sweep
	var track = Control.new()
	track.name = "WinDetailYakuTrack"
	track.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(track, rect_full(0.04, 0.595, 0.70, 0.700))
	parent.add_child(track)
	var count = min(5, max(1, reasons.size()))
	var rail = make_gpt_route_rail(rect_full(0.04, 0.44, 0.96, 0.56), Color(0.82, 0.70, 0.36, 0.18))
	rail.name = "WinDetailYakuRail"
	track.add_child(rail)
	var fill_ratio = clamp(float(count) / 5.0, 0.20, 1.0)
	var rail_fill = make_gpt_meter_fill(rect_full(0.025, 0.260, 0.025 + 0.950 * fill_ratio, 0.740), Color(0.90, 0.72, 0.34, 0.26))
	rail_fill.name = "WinDetailYakuRailFill"
