func play_voice_button_press_feedback(button: Button, active: bool, peak: float = 0.0) -> void:
	# r215: GPT chrome conversion
	if button == null or not is_instance_valid(button):
		return
	var previous = button.find_child("VoiceButtonPressFeedback", false, false)
	if previous != null and is_instance_valid(previous):
		previous.queue_free()
