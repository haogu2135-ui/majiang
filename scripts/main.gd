		inner_ring.modulate = Color(0.92, 0.76, 0.34, 0.12)
		inner_ring.pivot_offset = Vector2(40, 40)
	# 星光点 - 三层不同大小
	for i in range(8):
		var angle = float(i) * TAU / 8.0
		var radius = 0.38 if i % 3 == 0 else (0.28 if i % 3 == 1 else 0.18)
