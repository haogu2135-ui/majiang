func flower_petal_gpt_key(tile: String, index: int) -> String:
	var keys := ["petals_spring", "petals_summer", "petals_autumn", "petals_winter"]
	# 8 张花牌按季节归组：H1-H4 春夏秋冬，H5-H8 梅兰竹菊按传统季节对应
	# （梅→冬 / 兰→春 / 竹→夏 / 菊→秋），保证四季花瓣都能用上。
	var season_by_flower := {
		"H1": 0, "H2": 1, "H3": 2, "H4": 3,
		"H5": 3, "H6": 0, "H7": 1, "H8": 2,
	}
	if is_flower_tile(tile):
		if season_by_flower.has(tile):
			return keys[season_by_flower[tile]]
		return keys[index % keys.size()]
	return keys[index % keys.size()]

