	var gate = make_gpt_gate(rect_full(0.915, 0.300, 0.950, 0.700), Color(0.96, 0.78, 0.34, 0.22))
	gate.name = "WinDetailYakuGate"
	track.add_child(gate)
	for i in range(count):
		var reason = str(reasons[i])
		var accent = fan_badge_color(reason)
		var center = 0.10 + float(i) * (0.80 / float(max(1, count - 1))) if count > 1 else 0.50
		var node = make_gpt_gate(rect_full(center - 0.030, 0.24, center + 0.030, 0.76), Color(accent.r, accent.g, accent.b, 0.30))
		node.name = "WinDetailYakuNode_%d" % i
		track.add_child(node)
		if i == 0:
			var glow = make_gpt_gate(rect_full(center - 0.046, 0.12, center + 0.046, 0.88), Color(accent.r, accent.g, accent.b, 0.12))
			glow.name = "WinDetailYakuLeadGlow"
			track.add_child(glow)
	var tick = add_gpt_tick_strip(track, rect_full(0.560, 0.710, (0.560) + float(2) * (0.060) + (0.018), 0.870), Color(0.96, 0.78, 0.34, 0.22), "WinDetailYakuTick_0")
	return track


