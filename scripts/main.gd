	gift_glow.offset_right = 6.0
	gift_glow.offset_bottom = 6.0
	panel.add_child(gift_glow)
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and shader_materials.has("glow_bloom"):
		apply_glow_shader(gift_glow, Color(1.0, 0.88, 0.55, 0.6), 0.5, 1.2)

	# 连续签到天数 - 更醒目
	var days = int(login_result.get("consecutive_days", 1))
	var claimed_today = bool(login_result.get("claimed_today", false))
	var days_text = "已连续签到 %d 天" % days
	var days_label = make_label(panel, days_text, 26, Color(0.98, 0.97, 0.92), true)
	apply_rect(days_label, rect_full(0.10, 0.18, 0.90, 0.28))
	days_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	days_label.add_theme_color_override("font_outline_color", Color(0.02, 0.05, 0.03, 0.88))
	days_label.add_theme_constant_override("outline_size", 3)

	# 7天签到指示器 - 使用短卡片，避免程序点线装饰
	var day_indicators_container = Control.new()
	day_indicators_container.name = "DailyLoginDayIndicators"
	day_indicators_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(day_indicators_container, rect_full(0.105, 0.305, 0.895, 0.425))
	panel.add_child(day_indicators_container)

	var current_day_in_cycle = days % 7
	if current_day_in_cycle == 0:
		current_day_in_cycle = 7

	for i in range(7):
		var day_num = i + 1
		var is_claimed = day_num < current_day_in_cycle or (day_num == current_day_in_cycle and claimed_today)
		var is_current = day_num == current_day_in_cycle
		var is_milestone = day_num == 7

		var x_pos = 0.012 + float(i) * 0.141
		var indicator_rect = rect_full(x_pos, 0.050, x_pos + 0.110, 0.950)

		# 选择颜色
		var fill_color: Color
		var border_color: Color
		var text_color: Color
		if is_claimed:
			fill_color = Color(0.28, 0.20, 0.12, 0.92)
			border_color = Color(0.42, 0.72, 0.62, 0.88)
			text_color = Color(0.96, 0.96, 0.92)
		elif is_current:
			fill_color = Color(0.88, 0.72, 0.28, 0.92)
			border_color = GOLD_BRIGHT
			# Keep the current-day text dark on the gold card in standard mode,
			# while leaving enough source luminance for high-contrast mode to
			# promote it above the readable threshold instead of landing in the
			# low-contrast middle range.
			text_color = Color(0.22, 0.19, 0.16)
		else:
			fill_color = Color(0.16, 0.22, 0.20, 0.92)
			border_color = Color(0.52, 0.58, 0.48, 0.68)
			text_color = Color(0.92, 0.94, 0.86, 0.98)

		var indicator = make_gpt_plate_rect(indicator_rect, fill_color, "ui_jade_reading_plate")
		indicator.name = "DailyLoginDayNode_%d" % day_num
		day_indicators_container.add_child(indicator)
		var text_back = make_gpt_plate_rect(rect_full(0.070, 0.080, 0.930, 0.920), Color(0.006, 0.014, 0.016, 0.32 if is_current else 0.54), "ui_jade_reading_plate")
		text_back.name = "DailyLoginDayTextBack_%d" % day_num
		indicator.add_child(text_back)

		var day_label = make_label(indicator, "第%d天" % day_num, 11, text_color, true)
		day_label.name = "DailyLoginDayLabel_%d" % day_num
		apply_rect(day_label, rect_full(0.070, 0.110, 0.930, 0.520))
		configure_clipped_label(day_label)

		var reward_icon = "双倍" if is_milestone else "+100"
		var reward_color = text_color.darkened(0.18) if is_current else text_color.lightened(0.06)
		var icon_label = make_label(indicator, reward_icon, 11, reward_color, true)
		icon_label.name = "DailyLoginRewardLabel_%d" % day_num
		apply_rect(icon_label, rect_full(0.070, 0.510, 0.930, 0.900))
		configure_clipped_label(icon_label)

		# 已签到的天数添加对勾
		if is_claimed:
			var claimed_check = add_lucide_icon(indicator, "check", rect_full(0.735, 0.075, 0.930, 0.300), text_color)
			if claimed_check != null:
				claimed_check.name = "DailyLoginClaimCheck_%d" % day_num

		if is_current:
			indicator.modulate = Color(1, 1, 1, 0.96)
	draw_daily_login_streak_art(panel, days, current_day_in_cycle)

	# 奖励说明 - 增强视觉效果
	var reward_text = "今日奖励已入账：" if claimed_today else "今日奖励："
	var reward_icon_name = "gift"
	if current_day_in_cycle == 7:
		reward_text += "双倍金币卡 ×1"
		reward_icon_name = "sparkles"
	else:
		reward_text += "金币 +100"
		reward_icon_name = "coin"

	var reward_panel = make_gpt_route_rail(rect_full(0.14, 0.430, 0.86, 0.542), Color(0.018, 0.030, 0.034, 0.92))
	reward_panel.name = "DailyLoginRewardPanel"
	panel.add_child(reward_panel)
	var reward_text_back = make_gpt_plate_rect(rect_full(0.135, 0.120, 0.905, 0.880), Color(0.006, 0.014, 0.016, 0.46), "ui_jade_reading_plate")
	reward_text_back.name = "DailyLoginRewardTextBack"
	reward_panel.add_child(reward_text_back)
	var reward_icon_back = make_gpt_edge_rail(rect_full(0.035, 0.180, 0.125, 0.820), Color(0.86, 0.66, 0.26, 0.18))
	reward_icon_back.name = "DailyLoginRewardIconBack"
	reward_panel.add_child(reward_icon_back)

	var reward_label = make_label(reward_panel, reward_text, 20, Color(0.96, 0.92, 0.68), true)
	reward_label.name = "DailyLoginRewardTextLabel"
	apply_rect(reward_label, rect_full(0.180, 0.150, 0.880, 0.850))
	reward_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	configure_clipped_label(reward_label)
	add_lucide_icon(reward_icon_back, reward_icon_name, rect_full(0.180, 0.180, 0.820, 0.820), Color(0.96, 0.84, 0.46, 0.92))
	draw_daily_login_reward_art(reward_panel, days)

	# 签到进度条 - 增强版
	var progress = days % 7
	if progress == 0:
		progress = 7
	var progress_panel = make_gpt_route_rail(rect_full(0.14, 0.560, 0.86, 0.650), Color(0.018, 0.030, 0.034, 0.92))
	progress_panel.name = "DailyLoginProgressPanel"
	panel.add_child(progress_panel)
	var progress_rail = make_gpt_plate_rect(rect_full(0.120, 0.680, 0.880, 0.800), Color(0.006, 0.016, 0.018, 0.46))
	progress_rail.name = "DailyLoginProgressRail"
	progress_panel.add_child(progress_rail)
	var progress_fill = make_gpt_plate_rect(rect_full(0.025, 0.250, 0.025 + 0.950 * clamp(float(progress) / 7.0, 0.08, 1.0), 0.750), Color(0.42, 0.72, 0.58, 0.34))
	progress_fill.name = "DailyLoginProgressFill"
	progress_fill.set_meta("animated_role", "daily_login_progress_flow")
	progress_rail.add_child(progress_fill)

	# 进度文字
	var progress_text = make_label(progress_panel, "%d/7 天" % progress, 14, Color(0.96, 0.96, 0.92), true)
	progress_text.name = "DailyLoginProgressText"
	apply_rect(progress_text, rect_full(0.0, 0.0, 1.0, 0.66))
	progress_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	draw_daily_login_progress_confirm_art(panel, progress)

	# 确认按钮 - 一次性入账，领取后保留页面并明确显示已领取。
	var claim_state := {"claimed": claimed_today}
	var confirm_button_ref := {"button": null}
	var confirm_btn: Button
	confirm_btn = make_small_button("已领取" if claimed_today else "领取奖励", Color(0.78, 0.56, 0.28), func() -> void:
		if bool(claim_state.get("claimed", false)):
			show_toast("今日奖励已领取。", 1800)
			return
		var claim_result = claim_daily_login_reward()
		if not bool(claim_result.get("claimed", false)):
			show_toast(str(claim_result.get("reason", "签到奖励领取失败")), 2200)
			return
		claim_state["claimed"] = true
		if fx_enabled_effective():
			_play_reward_claim_animation(panel, "今日奖励：" + str(claim_result.get("detail", "")))
		var claimed_reward_label := panel.find_child("DailyLoginRewardTextLabel", true, false) as Label
		if claimed_reward_label != null:
			claimed_reward_label.text = "今日奖励已入账：%s" % str(claim_result.get("detail", ""))
		var claimed_button := confirm_button_ref.get("button") as Button
		if claimed_button != null and is_instance_valid(claimed_button):
			claimed_button.text = "已领取"
			claimed_button.disabled = true
			claimed_button.modulate = Color(0.72, 0.76, 0.68, 0.72)
		configure_button_focus_navigation(panel, "DailyLoginBackButton")
		call_deferred("focus_named_control", "DailyLoginBackButton")
		var current_indicator = day_indicators_container.find_child("DailyLoginDayNode_%d" % current_day_in_cycle, true, false) as Control
		if current_indicator != null:
			var current_reward_label = current_indicator.find_child("DailyLoginRewardLabel_%d" % current_day_in_cycle, true, false) as Label
			if current_reward_label != null:
				current_reward_label.text = "已领"
			if current_indicator.find_child("DailyLoginCurrentClaimCheck", true, false) == null:
				var check_icon = add_lucide_icon(current_indicator, "check", rect_full(0.735, 0.075, 0.930, 0.300), Color(0.96, 0.96, 0.92))
				if check_icon != null:
					check_icon.name = "DailyLoginCurrentClaimCheck"
		var forecast_badge_node = panel.find_child("DailyLoginForecastBadge", true, false) as Label
		if forecast_badge_node != null:
			forecast_badge_node.text = "已领取"
		var forecast_body_node = panel.find_child("DailyLoginForecastBody", true, false) as Label
		if forecast_body_node != null:
			forecast_body_node.text = "奖励已入账，明日可继续签到"
		show_toast("签到成功！%s" % str(claim_result.get("detail", "")), 2500)
	)
	confirm_btn.custom_minimum_size = Vector2(220, 50)
	confirm_btn.name = "DailyLoginClaimButton"
	confirm_button_ref["button"] = confirm_btn
	draw_daily_login_claim_button_art(confirm_btn)
	panel.add_child(confirm_btn)
	apply_rect(confirm_btn, rect_full(0.315, 0.675, 0.685, 0.790))
	add_lucide_icon(confirm_btn, "check", rect_full(0.08, 0.22, 0.22, 0.78), Color(0.96, 0.96, 0.92))
	if claimed_today:
		confirm_btn.disabled = true
		confirm_btn.modulate = Color(0.72, 0.76, 0.68, 0.72)
	draw_daily_login_claim_flow_art(panel, progress)
	# 七日奖励预告
	var days_to_bonus = max(0, 7 - progress)
	var forecast_badge_text = "已领取" if claimed_today else ("今日可领" if progress >= 7 else "还差 %d 天" % days_to_bonus)
	var forecast_body_text = "奖励已入账，明日可继续签到" if claimed_today else ("今日可领取双倍金币卡" if progress >= 7 else "第7天领取双倍金币卡")
	var forecast_panel = make_gpt_route_rail(rect_full(0.160, 0.820, 0.840, 0.955), Color(0.010, 0.022, 0.025, 0.64))
	forecast_panel.name = "DailyLoginForecastPanel"
	panel.add_child(forecast_panel)
	var forecast_rail = make_layout_host(rect_full(0.035, 0.180, 0.047, 0.820))
	forecast_rail.name = "DailyLoginForecastRail"
	forecast_panel.add_child(forecast_rail)
	var forecast_title = make_label(forecast_panel, "七日奖励预告", 12, Color(0.96, 0.88, 0.58, 0.92), true)
	forecast_title.name = "DailyLoginForecastTitle"
	apply_rect(forecast_title, rect_full(0.080, 0.135, 0.560, 0.430))
	configure_clipped_label(forecast_title)
	var forecast_badge = make_label(forecast_panel, forecast_badge_text, 11, Color(0.96, 0.92, 0.72, 0.92), true)
	forecast_badge.name = "DailyLoginForecastBadge"
	forecast_badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	apply_rect(forecast_badge, rect_full(0.765, 0.155, 0.925, 0.420))
	configure_clipped_label(forecast_badge)
	var forecast_badge_back = make_gpt_gate(rect_full(0.745, 0.125, 0.945, 0.450), Color(0.82, 0.62, 0.24, 0.13))
	forecast_badge_back.name = "DailyLoginForecastBadgeBack"
	forecast_panel.add_child(forecast_badge_back)
	forecast_panel.move_child(forecast_badge_back, forecast_badge.get_index())
	var forecast_body = make_label(forecast_panel, forecast_body_text, 12, Color(0.84, 0.88, 0.78, 0.90), true)
	forecast_body.name = "DailyLoginForecastBody"
	apply_rect(forecast_body, rect_full(0.105, 0.520, 0.920, 0.820))
	forecast_body.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(forecast_body)
	var tip_back = make_gpt_plate_rect(rect_full(0.085, 0.485, 0.940, 0.850), Color(0.006, 0.014, 0.016, 0.28), "ui_button_face_plate")
	tip_back.name = "DailyLoginTipBack"
	forecast_panel.add_child(tip_back)
	forecast_panel.move_child(tip_back, forecast_body.get_index())
	var tip_label = make_label(forecast_panel, forecast_body_text, 12, Color(0.82, 0.86, 0.76, 0.0), true)
	tip_label.name = "DailyLoginTipLabel"
	apply_rect(tip_label, rect_full(0.105, 0.520, 0.920, 0.820))
	tip_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(tip_label)
	configure_button_focus_navigation(panel, "DailyLoginClaimButton")

	# 面板弹出动画
	if ui_motion_enabled():
		panel.modulate = Color(1, 1, 1, 0)
		panel.scale = Vector2(0.85, 0.85)
		var tw := create_screen_tween()
		tw.set_parallel(true)
		tw.tween_property(panel, "modulate:a", 1.0, 0.3).from(0.0)
		tw.tween_property(panel, "scale", Vector2(1.0, 1.0), 0.3).from(Vector2(0.85, 0.85)).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)


func show_diagnostic_dialog(lines: Array) -> void:
	# r215: GPT chrome conversion
	# 清除当前屏幕
	clear_screen()

	# 创建半透明背景
	var bg = make_fullrect_overlay(Color(0, 0, 0, 0.72), "ui_dark_scrim")
	bg.name = "DiagnosticDismissOverlay"
	root_layer.add_child(bg)
	apply_rect(bg, rect_full(0, 0, 1, 1))
	draw_diagnostic_dismiss_art(bg)

	# 创建诊断信息面板
	var panel = make_gpt_plate_rect(rect_full(0.1, 0.15, 0.9, 0.85), Color(0.026, 0.058, 0.060, 0.95), "ui_jade_reading_plate")
	panel.name = "DiagnosticDialogPanel"
	# The GPT plate is normally an input-ignoring visual host. Make this modal
	# surface an explicit input boundary so its child actions receive mouse input.
	panel.mouse_filter = Control.MOUSE_FILTER_STOP
	root_layer.add_child(panel)
	var diagnostic_gpt_key := "diagnostic_gpt_panel"
	var diagnostic_gpt_texture = add_optional_gpt_illustration_texture(panel, diagnostic_gpt_key, rect_full(0.018, 0.018, 0.982, 0.982), 0.14, false)
	if diagnostic_gpt_texture != null:
		diagnostic_gpt_texture.name = "DiagnosticGPTPanelTexture"
		panel.move_child(diagnostic_gpt_texture, 0)
	var diagnostic_wave_hero = add_optional_gpt_illustration_texture(panel, "diagnostic_wave_hero", rect_full(0.080, 0.085, 0.920, 0.210), 0.20, false)
	if diagnostic_wave_hero != null:
		diagnostic_wave_hero.name = "DiagnosticWaveHeroTexture"
		panel.move_child(diagnostic_wave_hero, min(1, panel.get_child_count() - 1))
	draw_diagnostic_dialog_art(panel, lines)
	draw_diagnostic_result_sync_art(panel, lines)

	# Keep the detailed report scrollable while the close action remains fixed.
	var content_scroll = ScrollContainer.new()
	content_scroll.name = "DiagnosticContentScroll"
	configure_scroll_container(content_scroll, "上下滚动查看完整诊断信息")
	content_scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	content_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	content_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	content_scroll.scroll_deadzone = 8
	content_scroll.clip_contents = true
	panel.add_child(content_scroll)
	# Leave a visual buffer before the fixed action so the first visible row is
	# never clipped by the scroll viewport or the close button.
	apply_rect(content_scroll, rect_full(0.05, 0.215, 0.95, 0.760))
	var diagnostic_scrollbar := content_scroll.get_v_scroll_bar()
	if diagnostic_scrollbar != null:
		diagnostic_scrollbar.name = "DiagnosticContentScrollBar"

	var vbox = VBoxContainer.new()
	vbox.name = "DiagnosticContentList"
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_theme_constant_override("separation", 10 if large_text_enabled else 8)
	content_scroll.add_child(vbox)

	# 添加每一行文本
	for line_index in range(lines.size()):
		var line = str(lines[line_index])
		var label = Label.new()
		label.name = "DiagnosticContentLine_%02d" % line_index
		label.text = line
		label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		label.add_theme_font_override("font", ui_cjk_font())
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		label.clip_text = false
		label.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
		label.custom_minimum_size.y = 12.0 if line == "" else (42.0 if large_text_enabled else 30.0)
		label.add_theme_font_size_override("font_size", accessibility_font_size(20))
		if line.begins_with("【"):
			label.add_theme_color_override("font_color", Color(0.94, 0.86, 0.44))
			label.add_theme_font_size_override("font_size", accessibility_font_size(26))
			label.custom_minimum_size.y = 50.0 if large_text_enabled else 38.0
			label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		elif line.begins_with("✓"):
			label.add_theme_color_override("font_color", Color(0.42, 0.82, 0.56))
		elif line.begins_with("✗"):
			label.add_theme_color_override("font_color", Color(0.84, 0.42, 0.38))
		elif line.begins_with("•"):
			label.add_theme_color_override("font_color", Color(0.76, 0.78, 0.84))
		else:
			label.add_theme_color_override("font_color", Color(0.88, 0.90, 0.91))
		if line == "":
			label.custom_minimum_size.y = 12.0
		else:
			var diagnostic_font_size := accessibility_font_size(26 if line.begins_with("【") else 20)
			var diagnostic_width := maxf(260.0, effective_viewport_size().x * 0.720)
			var diagnostic_height := estimate_wrapped_text_height(line, diagnostic_width, diagnostic_font_size, 6.0)
			configure_wrapped_label(label, diagnostic_width, diagnostic_height, 6.0)
		vbox.add_child(label)
	var content_status = make_label(panel, "诊断内容 1-%d / %d · 可继续滚动" % [mini(5, lines.size()), lines.size()], 11, Color(0.86, 0.92, 0.84), true)
	content_status.name = "DiagnosticContentStatusLabel"
	apply_rect(content_status, rect_full(0.05, 0.785, 0.95, 0.820))
	content_status.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	content_status.add_theme_color_override("font_outline_color", Color(0.02, 0.05, 0.05, 0.94))
	content_status.add_theme_constant_override("outline_size", 2)
	configure_clipped_label(content_status)

	var copy_button = make_small_button("复制报告", Color(0.30, 0.52, 0.54), Callable(self, "copy_diagnostic_report").bind(lines))
	copy_button.name = "DiagnosticCopyButton"
	copy_button.focus_mode = Control.FOCUS_ALL
	copy_button.custom_minimum_size = Vector2(128, 44)
	copy_button.tooltip_text = "复制完整诊断报告到剪贴板"
	panel.add_child(copy_button)
	apply_rect(copy_button, rect_full(0.190, 0.835, 0.470, 0.940))
	var close_button = make_small_button("关闭", Color(0.30, 0.42, 0.38), Callable(self, "dismiss_diagnostic_dialog"))
	close_button.name = "DiagnosticCloseButton"
	close_button.focus_mode = Control.FOCUS_ALL
	close_button.custom_minimum_size = Vector2(128, 44)
	panel.add_child(close_button)
	apply_rect(close_button, rect_full(0.530, 0.835, 0.810, 0.940))
	var cancel_shortcut = Shortcut.new()
	cancel_shortcut.events = InputMap.action_get_events("ui_cancel")
	close_button.shortcut = cancel_shortcut
	copy_button.focus_neighbor_left = copy_button.get_path()
	copy_button.focus_neighbor_right = close_button.get_path()
	copy_button.focus_next = close_button.get_path()
	copy_button.focus_previous = copy_button.get_path()
	close_button.focus_neighbor_left = copy_button.get_path()
	close_button.focus_neighbor_right = close_button.get_path()
	close_button.focus_next = copy_button.get_path()
	close_button.focus_previous = copy_button.get_path()
	close_button.grab_focus()
	content_scroll.resized.connect(func() -> void:
		normalize_diagnostic_scroll_viewport(content_scroll, vbox)
		sync_diagnostic_scroll_status(content_scroll, content_status, lines.size())
	)
	vbox.resized.connect(func() -> void:
		normalize_diagnostic_scroll_viewport(content_scroll, vbox)
		sync_diagnostic_scroll_status(content_scroll, content_status, lines.size())
	)
	if diagnostic_scrollbar != null:
		diagnostic_scrollbar.value_changed.connect(func(_value: float) -> void:
			sync_diagnostic_scroll_status(content_scroll, content_status, lines.size())
		)
	# Give the first rendered frame a complete-row boundary before container
	# layout emits its deferred resize signals. The next-frame helper refines it.
	var initial_viewport_height := effective_viewport_size().y
	var initial_scroll_height := 192.0 if initial_viewport_height <= 560.0 else (374.0 if initial_viewport_height >= 1000.0 else 260.0)
	content_scroll.anchor_bottom = content_scroll.anchor_top
	content_scroll.offset_bottom = initial_scroll_height
	call_deferred("normalize_diagnostic_scroll_viewport", content_scroll, vbox)
	call_deferred("sync_diagnostic_scroll_status", content_scroll, content_status, lines.size())

	# 面板入场动画 - 滑入 + 淡入
	if ui_motion_enabled():
		bg.modulate = Color(1, 1, 1, 0)
		panel.offset_top = 20.0
		panel.modulate = Color(1, 1, 1, 0)
		var bg_tw := create_screen_tween()
		bg_tw.tween_property(bg, "modulate:a", 1.0, 0.18).from(0.0)
		var p_tw := create_screen_tween()
		p_tw.set_parallel(true)
		p_tw.tween_property(panel, "modulate:a", 1.0, 0.22).from(0.0).set_delay(0.06)
		p_tw.tween_property(panel, "offset_top", 0.0, 0.22).from(20.0).set_delay(0.06).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		# Stagger labels in
		var label_nodes: Array[Node] = []
		for child in vbox.get_children():
			if child is Label:
				label_nodes.append(child)
		if not label_nodes.is_empty():
			for i in range(label_nodes.size()):
				var lbl = label_nodes[i]
				lbl.modulate.a = 0.0
				var l_tw := create_screen_tween()
				l_tw.tween_property(lbl, "modulate:a", 1.0, 0.15).from(0.0).set_delay(0.12 + float(i) * 0.04).set_ease(Tween.EASE_OUT)

	# 添加点击关闭功能
	bg.mouse_filter = Control.MOUSE_FILTER_STOP
	bg.gui_input.connect(func(event: InputEvent) -> void:
		var dismiss := false
		if event is InputEventScreenTouch:
			dismiss = (event as InputEventScreenTouch).pressed
		elif event is InputEventMouseButton:
			var mouse_event := event as InputEventMouseButton
			dismiss = mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed
		if dismiss:
			bg.accept_event()
			dismiss_diagnostic_dialog()
	)


func normalize_diagnostic_scroll_viewport(content_scroll: ScrollContainer, content_list: Control) -> void:
	if content_scroll == null or not is_instance_valid(content_scroll) or content_list == null or not is_instance_valid(content_list):
		return
	var panel := content_scroll.get_parent() as Control
	if panel == null or panel.size.y <= 1.0:
		return
	# Snap the viewport to a complete row while keeping a fixed visual buffer
	# before the close lane. This prevents the first frame from bisecting text.
	# The list starts at 21.5% and the status lane starts at 78.5%. Keep the
	# complete-row viewport eight pixels above that status lane at every size.
	var maximum_height := maxf(44.0, panel.size.y * 0.570 - 8.0)
	var complete_height := 0.0
	for child in content_list.get_children():
		if not child is Control:
			continue
		var child_control := child as Control
		var child_end := child_control.position.y + child_control.size.y
		if child_end > maximum_height:
			break
		complete_height = child_end
	if complete_height <= 1.0:
		queue_diagnostic_layout_retry(content_scroll, content_list)
		return
	content_scroll.anchor_bottom = content_scroll.anchor_top
	# Leave a small rasterization tolerance so the last included label is not
	# reported as one pixel clipped after the ScrollContainer rounds its size.
	content_scroll.offset_bottom = complete_height + 2.0
	queue_diagnostic_layout_retry(content_scroll, content_list)


func queue_diagnostic_layout_retry(content_scroll: ScrollContainer, content_list: Control) -> void:
	if content_scroll == null or not is_instance_valid(content_scroll) or content_list == null or not is_instance_valid(content_list):
		return
	if bool(content_scroll.get_meta("diagnostic_layout_retry_pending", false)):
		return
	var retry_count := int(content_scroll.get_meta("diagnostic_layout_passes", 0))
	if retry_count >= 4:
		return
	content_scroll.set_meta("diagnostic_layout_passes", retry_count + 1)
	content_scroll.set_meta("diagnostic_layout_retry_pending", true)
	var content_scroll_id := content_scroll.get_instance_id()
	var content_list_id := content_list.get_instance_id()
	get_tree().create_timer(0.01).timeout.connect(func() -> void:
		var retry_scroll := instance_from_id(content_scroll_id) as ScrollContainer
		var retry_list := instance_from_id(content_list_id) as Control
		if retry_scroll != null and is_instance_valid(retry_scroll) and retry_list != null and is_instance_valid(retry_list):
			retry_diagnostic_layout(retry_scroll, retry_list)
	, CONNECT_ONE_SHOT)


func retry_diagnostic_layout(content_scroll: ScrollContainer, content_list: Control) -> void:
	if content_scroll == null or not is_instance_valid(content_scroll):
		return
	content_scroll.set_meta("diagnostic_layout_retry_pending", false)
	normalize_diagnostic_scroll_viewport(content_scroll, content_list)


func sync_diagnostic_scroll_status(content_scroll: ScrollContainer, status_label: Label, total_count: int) -> void:
	if content_scroll == null or status_label == null or not is_instance_valid(content_scroll) or not is_instance_valid(status_label):
		return
	var scrollbar := content_scroll.get_v_scroll_bar()
	var content_list := content_scroll.find_child("DiagnosticContentList", true, false) as Control
	if scrollbar == null or content_list == null:
		return
	var total := maxi(0, total_count)
	if total == 0:
		set_dynamic_label_text(status_label, "诊断内容 0-0 / 0 · 无内容", "当前诊断报告没有内容")
		return
	var viewport_top := scrollbar.value
	var viewport_height := maxf(scrollbar.page, content_scroll.size.y)
	var viewport_bottom := viewport_top + viewport_height
	var first_visible := -1
	var last_visible := -1
	var line_index := 0
	for child in content_list.get_children():
		if not child is Label:
			continue
		line_index += 1
		var line := child as Label
		var line_top := line.position.y
		var line_bottom := line_top + line.size.y
		if line_bottom > viewport_top + 1.0 and line_top < viewport_bottom - 1.0:
			if first_visible < 0:
				first_visible = line_index
			last_visible = line_index
	if first_visible < 0:
		var fallback_line_height := 38.0 if large_text_enabled else 30.0
		first_visible = clampi(int(floor(viewport_top / fallback_line_height)) + 1, 1, total)
		last_visible = mini(total, first_visible + maxi(1, int(ceil(viewport_height / fallback_line_height))) - 1)
	first_visible = clampi(first_visible, 1, total)
	last_visible = clampi(maxi(first_visible, last_visible), first_visible, total)
	var remaining := maxi(0, total - last_visible)
	var tail := "余 0 · 已到末尾" if remaining == 0 else "可继续滚动 · 余 %d" % remaining
	set_dynamic_label_text(status_label, "诊断内容 %d-%d / %d · %s" % [first_visible, last_visible, total, tail], "当前诊断报告范围")
	status_label.tooltip_text = "当前显示第%d至%d行，共%d行；%s" % [first_visible, last_visible, total, ("已到报告末尾" if remaining == 0 else "可继续滚动查看完整报告")]


func dismiss_diagnostic_dialog() -> void:
	if root_layer == null or not is_instance_valid(root_layer):
		return
	if root_layer.find_child("DiagnosticDialogPanel", true, false) == null:
		return
	clear_screen()
	refresh_current_screen()


func copy_diagnostic_report(lines: Array) -> void:
	var report_lines: Array[String] = []
	for line in lines:
		report_lines.append(str(line))
	DisplayServer.clipboard_set("\n".join(report_lines))
	show_toast("诊断报告已复制")


