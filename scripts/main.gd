func score_strip_rank_for_score(score: int) -> int:
	var rank = 1
	for player in players:
		if typeof(player) != TYPE_DICTIONARY:
			continue
		if int(player.get("score", 0)) > score:
			rank += 1
	return clamp(rank, 1, 4)

func score_strip_leader_score() -> int:
	var leader = -2147483648
	for player in players:
		if typeof(player) == TYPE_DICTIONARY:
			leader = max(leader, int(player.get("score", MATCH_START_SCORE)))
	return MATCH_START_SCORE if leader == -2147483648 else leader


