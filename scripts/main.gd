func compact_score_text(value: int) -> String:
	var sign = "-" if value < 0 else ""
	var amount = abs(value)
	if amount >= 100000:
		return "%s%d万" % [sign, int(round(float(amount) / 10000.0))]
	if amount >= 10000:
		return "%s%.1f万" % [sign, float(amount) / 10000.0]
	return "%s%d" % [sign, amount]


