func mark_table_tile_3d_proxy(proxy: Control, tile: String, seat: int, role: String, highlighted: bool, raised: bool, order: int) -> void:
	if proxy == null:
		return
	# 2D mode: keep proxy visible; metadata retained for optional tooling only.
	proxy.modulate.a = 1.0
	proxy.set_meta("is_3d_layout_proxy", false)
	proxy.set_meta("table_3d_tile", tile)
	proxy.set_meta("table_3d_seat", seat)
	proxy.set_meta("table_3d_role", role)
	proxy.set_meta("table_3d_highlighted", highlighted)
	proxy.set_meta("table_3d_raised", raised)
	proxy.set_meta("table_3d_order", order)


func table_3d_entry_from_proxy(proxy: Control, parent: Control) -> Dictionary:
	if proxy == null or parent == null or not proxy.is_inside_tree() or not parent.is_inside_tree():
		return {}
	var parent_rect := parent.get_global_rect()
	var proxy_rect := proxy.get_global_rect()
	if parent_rect.size.x <= 1.0 or parent_rect.size.y <= 1.0 or proxy_rect.size.x <= 1.0 or proxy_rect.size.y <= 1.0:
		return {}
	var tile := str(proxy.get_meta("table_3d_tile", ""))
	if tile == "":
		return {}
	var seat := int(proxy.get_meta("table_3d_seat", 0))
	var role := str(proxy.get_meta("table_3d_role", "discard"))
	var order := int(proxy.get_meta("table_3d_order", 0))
	var relative_center := proxy_rect.position + proxy_rect.size * 0.5 - parent_rect.position
	var tilt_step := 0.12 if role == "meld" else 0.28
	var deterministic_tilt := (float((order * 17 + seat * 7) % 5) - 2.0) * deg_to_rad(tilt_step)
	return {
		"texture": tile_textures.get(tile, tile_decal_textures.get(tile, null)) as Texture2D,
		"center": Vector2(relative_center.x / parent_rect.size.x, relative_center.y / parent_rect.size.y),
		"size": Vector2(proxy_rect.size.x / parent_rect.size.x, proxy_rect.size.y / parent_rect.size.y),
		"rotation": deterministic_tilt,
		"highlighted": bool(proxy.get_meta("table_3d_highlighted", false)),
		"raised": bool(proxy.get_meta("table_3d_raised", false)),
		"role": role,
		"accent": SEAT_ACCENT_COLORS[seat] if seat >= 0 and seat < SEAT_ACCENT_COLORS.size() else GOLD_PRIMARY,
	}


func collect_table_3d_entries_from_proxies(parent: Control) -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	var proxies: Array[Control] = []
	for node in parent.find_children("*", "Control", true, false):
		var proxy := node as Control
		if proxy != null and bool(proxy.get_meta("is_3d_layout_proxy", false)):
			proxies.append(proxy)
	proxies.sort_custom(func(a: Control, b: Control) -> bool:
		return int(a.get_meta("table_3d_order", 0)) < int(b.get_meta("table_3d_order", 0))
	)
	for proxy in proxies:
		var entry := table_3d_entry_from_proxy(proxy, parent)
		if not entry.is_empty():
			entries.append(entry)
	return entries


