		chat_button.modulate = Color(0.78, 0.92, 0.82, 0.92)
	apply_rect(chat_button, CHAT_ACTION_BUTTON_RECT)
	parent.add_child(chat_button)

func draw_advisor_card_meter(parent: Control, heading: String, main_text: String, sub_text: String, accent: Color) -> Control:
	# r213: GPT chrome conversion
	var meter = make_gpt_plate_rect(rect_full(0.595, 0.075, 0.925, 0.255), Color(accent.r, accent.g, accent.b, 0.075), "ui_button_face_plate")
	meter.name = "AdvisorCardMeter_%s" % heading
	parent.add_child(meter)
	var rail = make_gpt_route_rail(rect_full(0.080, 0.395, 0.920, 0.605), Color(0.010, 0.020, 0.022, 0.48))
	rail.name = "AdvisorCardMeterRail_%s" % heading
	meter.add_child(rail)
	var signal_ratio = clamp((float(main_text.length()) + float(sub_text.length()) * 0.42) / 24.0, 0.24, 1.0)
	var fill = make_gpt_meter_fill(rect_full(0.035, 0.220, 0.035 + 0.930 * signal_ratio, 0.780), Color(accent.r, accent.g, accent.b, 0.44))
	fill.name = "AdvisorCardMeterFill_%s" % heading
	rail.add_child(fill)
	for i in range(3):
		var left = 0.165 + float(i) * 0.275
		var lit = signal_ratio >= 0.30 + float(i) * 0.24
		var pip = make_gpt_gate(rect_full(left, 0.205, left + 0.080, 0.795), Color(accent.r, accent.g, accent.b, 0.30 if lit else 0.10))
		pip.name = "AdvisorCardMeterPip_%s_%d" % [heading, i]
		meter.add_child(pip)
	var focus = make_gpt_gate(rect_full(0.780, 0.185, 0.910, 0.815), Color(accent.r, accent.g, accent.b, 0.12))
	focus.name = "AdvisorCardMeterFocus_%s" % heading
	meter.add_child(focus)
	# r180: GPT decision strip instead of route/fill/gate/tick ColorRect chrome.
	var decision = Control.new()
	decision.name = "AdvisorCardDecisionChrome_%s" % heading
	decision.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(decision, rect_full(0.110, 0.680, 0.930, 0.900))
	parent.add_child(decision)
	var decision_strip = add_optional_gpt_illustration_texture(decision, "ui_progress_signal_strip", rect_full(0.0, 0.15, 1.0, 0.85), 0.40, false)
	if decision_strip != null:
		decision_strip.name = "AdvisorCardDecisionStrip_%s" % heading
		decision_strip.modulate = Color(accent.r, accent.g, accent.b, 0.62)
	var decision_meter = add_optional_gpt_illustration_texture(decision, "ui_meter_rail_plate", rect_full(0.02, 0.28, 0.02 + 0.90 * signal_ratio, 0.72), 0.70, false)
	if decision_meter != null:
		decision_meter.name = "AdvisorCardDecisionMeter_%s" % heading
	if fx_enabled_effective():
		var tw := create_screen_tween()
		tw.set_loops(8)
		tw.tween_property(focus, "modulate:a", 0.42, 0.64).from(0.92).set_ease(Tween.EASE_OUT)
		tw.tween_property(focus, "modulate:a", 0.92, 0.64).from(0.42).set_ease(Tween.EASE_IN)
	return meter


func draw_advisor_card_signal_route(parent: Control, heading: String, main_text: String, sub_text: String, accent: Color) -> Control:
	# r180: GPT meter strip instead of multi-rect signal route chrome.
	var signal_ratio = clamp((float(main_text.length()) + float(sub_text.length()) * 0.36) / 22.0, 0.24, 1.0)
	var route = Control.new()
	route.name = "AdvisorCardSignalRoute_%s" % heading
	route.mouse_filter = Control.MOUSE_FILTER_IGNORE
	apply_rect(route, rect_full(0.070, 0.160, 0.610, 0.335))
	parent.add_child(route)
	var strip = add_optional_gpt_illustration_texture(route, "ui_progress_signal_strip", rect_full(-0.02, 0.10, 1.02, 0.90), 0.40, false)
	if strip != null:
		strip.name = "AdvisorCardSignalStrip_%s" % heading
		strip.modulate = Color(accent.r, accent.g, accent.b, 0.64)
	var fill = add_optional_gpt_illustration_texture(route, "ui_meter_rail_plate", rect_full(0.03, 0.26, 0.03 + 0.90 * signal_ratio, 0.74), 0.70, false)
	if fill != null:
		fill.name = "AdvisorCardSignalFill_%s" % heading
	var gate = add_optional_gpt_illustration_texture(route, "ui_hand_tray_state_chip", rect_full(0.88, 0.12, 0.995, 0.88), 0.55, false)
	if gate != null:
		gate.name = "AdvisorCardSignalGate_%s" % heading
	if fx_enabled_effective() and DisplayServer.get_name().to_lower() != "headless" and fill != null:
		var tw := create_screen_tween()
		tw.set_loops(48)
		tw.tween_property(fill, "modulate:a", 0.44, 0.78).from(0.96)
		if gate != null:
			tw.parallel().tween_property(gate, "modulate:a", 0.50, 0.78).from(0.92)
		tw.tween_property(fill, "modulate:a", 0.96, 0.78).from(0.44)
		if gate != null:
			tw.parallel().tween_property(gate, "modulate:a", 0.92, 0.78).from(0.50)
	return route

func draw_advisor_info_card(parent: Control, rect: Rect2, heading: String, main_text: String, sub_text: String, accent: Color) -> void:
	# r214: bulk GPT chrome sweep
	var card = make_gpt_plate_rect(rect, Color(0.028, 0.048, 0.050, 0.78), "ui_jade_reading_plate")
	card.name = "AdvisorInfoCard_%s" % heading
	parent.add_child(card)
	var card_texture = add_illustration_texture(card, "advisor_map", rect_full(0.015, 0.050, 0.985, 0.950), 0.080, false)
	if card_texture != null:
		card_texture.name = "AdvisorCardMapTexture_%s" % heading
		card.move_child(card_texture, 0)
	draw_advisor_signal_strip(card, heading, accent)
	draw_advisor_card_signal_route(card, heading, main_text, sub_text, accent)
	draw_advisor_card_meter(card, heading, main_text, sub_text, accent)
	var label = make_label(card, heading, 10, accent, true)
	apply_rect(label, rect_full(0.13, 0.07, 0.93, 0.26))
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(label)
	var primary = make_label(card, main_text if main_text != "" else "--", 12, Color(0.86, 0.91, 0.84), true)
	apply_rect(primary, rect_full(0.13, 0.30, 0.93, 0.56))
	primary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	configure_clipped_label(primary)
	var secondary = make_label(card, sub_text if sub_text != "" else "暂无", 10, Color(0.66, 0.74, 0.70), false)
	apply_rect(secondary, rect_full(0.13, 0.58, 0.93, 0.92))
	secondary.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	secondary.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	secondary.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	secondary.clip_text = true
	secondary.tooltip_text = secondary.text


func draw_advisor_panel(parent: Control, force_visible: bool = false) -> void:
	# r214: bulk GPT chrome sweep
	# A pending claim already has one focused response surface. Hiding the general
	# advisor here prevents a second reading lane from competing with the claim or
	# danger decision surfaces and keeps keyboard focus within the active action.
	if not force_visible and (mode != "offline" or offline_phase == "ended" or offline_phase == "pending_claim" or has_pending_danger_discard() or not player_ai_assist_enabled()):
		return
	# The narrow center-left HUD slot sits between the left river and the center
	# surface, above the player river. During a response window the action dock
	# moves left, so reserve a dedicated right-side gap for it.
	var advisor_right := 0.620 if has_pending_claim_window() else 0.690
	var panel = make_gpt_plate_rect(rect_full(0.285, 0.330, advisor_right, 0.635), Color(0.014, 0.034, 0.040, 0.90), "ui_button_face_plate")
	panel.set_name("AdvisorPanel")
	parent.add_child(panel)
	var advisor_texture = add_illustration_texture(panel, "advisor_map", rect_full(0.010, 0.035, 0.990, 0.965), 0.12, false)
	if advisor_texture != null:
		advisor_texture.name = "AdvisorMapTexture"
		panel.move_child(advisor_texture, 0)
	var advisor_gpt_key := "advisor_gpt_panel"
	var gpt_advisor_texture = add_optional_gpt_illustration_texture(panel, advisor_gpt_key, rect_full(0.006, 0.020, 0.994, 0.980), 0.14, false)
	if gpt_advisor_texture != null:
		gpt_advisor_texture.name = "AdvisorGPTPanelTexture"
		panel.move_child(gpt_advisor_texture, min(1, panel.get_child_count() - 1))
	var _gpt_panel_host = make_gpt_route_rail(rect_full(0.0, 0.0, 1.0, 0.14), Color(0.044, 0.056, 0.058, 0.72))
	_gpt_panel_host.name = "GptPanelHost"
	panel.add_child(_gpt_panel_host)
	var title = make_label(panel, "牌势", 13, Color(0.86, 0.78, 0.56), true)
	apply_rect(title, rect_full(0.03, 0.04, 0.16, 0.22))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	var context = make_label(panel, advisor_context_line(), 11, Color(0.62, 0.72, 0.68), false)
	apply_rect(context, rect_full(0.17, 0.04, 0.52, 0.22))
	context.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	configure_clipped_label(context)
	var detail_button := make_small_button("详解", Color(0.48, 0.56, 0.40), Callable(self, "toggle_advisor_detail_panel"))
	detail_button.name = "AdvisorDetailButton"
	detail_button.custom_minimum_size = Vector2(58, 44)
	detail_button.add_theme_font_size_override("font_size", 10)
	detail_button.tooltip_text = "展开牌势详解 · Esc收起"
	apply_rect(detail_button, rect_full(0.54, 0.015, 0.97, 0.265))
	panel.add_child(detail_button)
	draw_advisor_panel_context_route(panel)
	draw_advisor_panel_priority_sweep(panel)
	draw_advisor_panel_decision_bridge(panel)
	draw_advisor_panel_analysis_scan(panel)
	# Three horizontal reading lanes keep recommendation, shape and defense visible
	# together at compact widths; the panel remains between the river and action dock.
	var advisor_card_rect_a := rect_full(0.025, 0.255, 0.325, 0.955)
	var advisor_card_rect_b := rect_full(0.340, 0.255, 0.660, 0.955)
	var advisor_card_rect_c := rect_full(0.675, 0.255, 0.975, 0.955)
	if offline_phase == "pending_claim":
		draw_advisor_info_card(panel, advisor_card_rect_a, "响应", "%s" % tile_label(str(offline_pending_claim.get("tile", ""))), "%s" % claim_options_text(offline_pending_claim), Color(0.86, 0.78, 0.56))
		draw_advisor_info_card(panel, advisor_card_rect_b, "牌局", advisor_turn_line(), current_status_text(), Color(0.62, 0.78, 0.82))
		draw_advisor_info_card(panel, advisor_card_rect_c, "防守", advisor_defense_text(0), opponent_threat_summary(0), Color(0.84, 0.62, 0.54))
		return
	if can_self_discard():
		var reports = current_human_advice if not current_human_advice.is_empty() else get_ai_discard_reports(0)
		if reports.is_empty():
			draw_advisor_info_card(panel, advisor_card_rect_a, "荐", "整理", "待出牌", Color(0.86, 0.78, 0.56))
			draw_advisor_info_card(panel, advisor_card_rect_b, "势", "等待", advisor_turn_line(), Color(0.62, 0.78, 0.82))
			draw_advisor_info_card(panel, advisor_card_rect_c, "守", "观测", opponent_threat_summary(0), Color(0.84, 0.62, 0.54))
			return
		var best: Dictionary = reports[0]
		var narrow_advisor_layout := effective_viewport_size().x <= 960.0
		var reason_text := advisor_compact_reason_text(best) if narrow_advisor_layout else advisor_recommendation_reason_text(best)
		var value_text := advisor_compact_value_text(best) if narrow_advisor_layout else advisor_value_short_text(best)
		var threat_text := advisor_compact_threat_text(0) if narrow_advisor_layout else opponent_threat_summary(0)
		draw_advisor_info_card(panel, advisor_card_rect_a, "荐", "打%s · %s" % [tile_label(str(best.get("tile", ""))), advisor_confidence_text(reports)], reason_text, Color(0.86, 0.78, 0.56))
		draw_advisor_info_card(panel, advisor_card_rect_b, "势", advisor_progress_text(best), value_text, Color(0.62, 0.78, 0.82))
		draw_advisor_info_card(panel, advisor_card_rect_c, "守", discard_safety_short_text(best), threat_text, Color(0.84, 0.62, 0.54))
		return
	draw_advisor_info_card(panel, advisor_card_rect_a, "局", advisor_turn_line(), current_status_text(), Color(0.86, 0.78, 0.56))
	draw_advisor_info_card(panel, advisor_card_rect_b, "势", score_strategy_text(0), "余牌%d" % get_wall_count(), Color(0.62, 0.78, 0.82))
	draw_advisor_info_card(panel, advisor_card_rect_c, "守", advisor_defense_text(0), opponent_threat_summary(0), Color(0.84, 0.62, 0.54))


