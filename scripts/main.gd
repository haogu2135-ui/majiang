func update_menu_parallax(mouse_pos: Vector2) -> void:
	"""根据鼠标位置驱动主菜单Hero插画的视差位移 - 远近层不同幅度"""
	if menu_hero_art == null or not is_instance_valid(menu_hero_art):
		return
	var viewport_size = get_viewport().size
	if viewport_size.x <= 0.0 or viewport_size.y <= 0.0:
		return
	# 鼠标相对视口中心的归一化偏移 [-1, 1]
	var nx: float = clamp((mouse_pos.x / viewport_size.x) * 2.0 - 1.0, -1.0, 1.0)
	var ny: float = clamp((mouse_pos.y / viewport_size.y) * 2.0 - 1.0, -1.0, 1.0)
	# 视差层：远景小幅度、中景中等、近景大幅度（营造纵深）
	var layers := [
		["MenuHeroGPTBackdropTexture", -1.4, -0.8],
		["MenuHeroPaintedBackdrop", -2.0, -1.2],
		["MenuHeroFarMountain", -3.0, -1.8],     # 远山：最小位移
		["MenuHeroMoon", -4.5, -3.0],            # 月亮：略大
		["MenuHeroMistCloud1", -6.0, -2.4],
		["MenuHeroMistCloud2", -5.4, -2.0],
		["MenuHeroGoldCloud", 6.0, 2.4],
		["MenuHeroWater", -7.0, -3.2],           # 水面：中等
		["MenuHeroPineLeft", 9.0, 4.5],          # 松枝：较大
		["MenuHeroBambooRight", -9.0, 4.5],      # 竹子：较大
		["MenuHeroPlumBlossom", 11.0, 5.4],      # 梅花：近景
		["MenuHeroRoundTable", 13.0, 6.0],       # 牌桌：最近景
		["MenuHeroSeal", -12.0, -5.5],           # 印章：近景反向
		["MenuHeroKoiGold", 8.0, 4.0],           # 锦鲤金
		["MenuHeroKoiJade", -8.0, 3.5],          # 锦鲤翠
		["MenuHeroDustLayer", 2.0, 1.0],         # 金粉：微弱跟随
	]
	for entry in layers:
		var node = menu_hero_art.get_node_or_null(str(entry[0]))
		if node == null or not is_instance_valid(node):
			continue
		var dx: float = float(entry[1]) * nx
		var dy: float = float(entry[2]) * ny
		# 用offset而非直接改position，避免与布局冲突，平滑跟随
		node.offset_left = lerp(node.offset_left, -dx, 0.18)
		node.offset_top = lerp(node.offset_top, -dy, 0.18)
		node.offset_right = lerp(node.offset_right, dx, 0.18)
		node.offset_bottom = lerp(node.offset_bottom, dy, 0.18)
	if menu_realtime_3d_stage != null and is_instance_valid(menu_realtime_3d_stage) and menu_realtime_3d_stage.has_method("set_pointer_normalized"):
		menu_realtime_3d_stage.set_pointer_normalized(Vector2(nx, ny))


